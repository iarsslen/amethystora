[Default Applications]
# The viewers of what "Send to Phone" (amethystora-phone-send.desktop) is offered for, with Firefox, which the image
# has from the start, as their second name: before their Flatpaks come (the first boot with a network) the launcher
# would otherwise be the only app for these types, and so their default. It is an Open With choice and no more.
application/pdf=org.gnome.Papers.desktop;org.mozilla.firefox.desktop;
audio/flac=org.gnome.Decibels.desktop;org.mozilla.firefox.desktop;
audio/mp4=org.gnome.Decibels.desktop;org.mozilla.firefox.desktop;
