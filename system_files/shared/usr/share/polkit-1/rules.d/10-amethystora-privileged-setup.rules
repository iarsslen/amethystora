// The privileged setup helper runs the first-login hooks in /usr/share/amethystora/privileged-setup.hooks.d
// as root. Never for a session that is not at the machine, whoever it belongs to: rules are read in name
// order, so this one decides before 20-privileged-user-setup.rules beside it. pkexec checks the helper's
// own action, which its policy names with the exec.path annotation, not org.freedesktop.policykit.exec.
polkit.addRule(function (action, subject) {
    if (action.id == "org.amethystora.policykit.privileged.user.setup" &&
        !(subject.local && subject.active)) {
        return polkit.Result.NO;
    }
    return polkit.Result.NOT_HANDLED;
});
