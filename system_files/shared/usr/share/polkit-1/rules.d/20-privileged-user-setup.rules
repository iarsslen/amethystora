// An administrator sitting at the machine runs the first-login hooks without a password; anyone else is
// asked for an administrator's, and the hook that starts them (99-privileged.sh) does not ask for them.
polkit.addRule(function (action, subject) {
    if (action.id == "org.amethystora.policykit.privileged.user.setup" &&
        action.lookup("program") == "/usr/bin/amethystora-privileged-setup" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
