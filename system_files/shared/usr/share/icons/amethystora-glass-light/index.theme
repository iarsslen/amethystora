[Icon Theme]
Name=Amethystora Glass for light
Comment=Glass with every colour deepened until it reads on a light ground
Inherits=Adwaita,hicolor
Example=folder
Directories=apps/scalable,places/scalable,mimetypes/scalable,devices/scalable,status/scalable,categories/scalable

[apps/scalable]
Context=Applications
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[places/scalable]
Context=Places
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[devices/scalable]
Context=Devices
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[status/scalable]
Context=Status
Size=128
MinSize=8
MaxSize=512
Type=Scalable

[categories/scalable]
Context=Categories
Size=128
MinSize=8
MaxSize=512
Type=Scalable
