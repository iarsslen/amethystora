# The image's own entries for the credential tripwires (CREDENTIALS in /etc/amethystora/security.conf): the
# programs that read where secrets are kept as a matter of course, each with what it reads. The machine's own
# are in /etc/amethystora/allow.d/credentials (ame security allow credentials "PROGRAM FILE"). A glob each;
# ~/ is every home folder. An allowed program can still be run by malware: that is the price of not saying
# every backup and every SSH login.
#
# SSH and git, with their credential helpers, and GitHub's command
/usr/bin/ssh ~/.ssh/*
/usr/bin/ssh-add ~/.ssh/*
/usr/bin/ssh-keygen ~/.ssh/*
/usr/bin/scp ~/.ssh/*
/usr/bin/sftp ~/.ssh/*
/usr/bin/git ~/.git-credentials
/usr/libexec/git-core/* ~/.git-credentials
/usr/bin/gh ~/.config/gh/*
/home/linuxbrew/.linuxbrew/Cellar/gh/* ~/.config/gh/*
# npm and its Node, pip's tools, the clouds' and the containers' commands
/usr/bin/node* ~/.npmrc
/home/linuxbrew/.linuxbrew/Cellar/node*/* ~/.npmrc
/usr/bin/python3* ~/.pypirc
/usr/bin/aws ~/.aws/*
/usr/bin/podman ~/.docker/*
/usr/bin/docker ~/.docker/*
/usr/bin/kubectl ~/.kube/*
/usr/bin/oc ~/.kube/*
# The keyring, and each browser its own passwords and cookies, packaged or from Flathub
/usr/bin/gnome-keyring-daemon ~/.local/share/keyrings/*
/usr/libexec/oo7-daemon ~/.local/share/keyrings/*
/usr/libexec/oo7-daemon-login ~/.local/share/keyrings/*
/usr/lib64/firefox/firefox ~/.mozilla/firefox/*
/app/lib/firefox/* ~/.var/app/org.mozilla.firefox/*
/opt/google/chrome/* ~/.config/google-chrome/*
/app/extra/chrome* ~/.var/app/com.google.Chrome/*
/usr/lib64/chromium-browser/* ~/.config/chromium/*
/app/chromium/* ~/.var/app/org.chromium.Chromium/*
/opt/brave.com/brave/* ~/.config/BraveSoftware/*
/app/brave/* ~/.var/app/com.brave.Browser/*
/opt/microsoft/msedge/* ~/.config/microsoft-edge/*
/app/extra/edge/* ~/.var/app/com.microsoft.Edge/*
# Each AI agent its own token, where its maker's installer puts it
~/.local/share/claude/versions/* ~/.claude/*
~/.codex/packages/* ~/.codex/*
/home/linuxbrew/.linuxbrew/Cellar/node*/* ~/.gemini/*
~/.local/bin/agy* ~/.gemini/antigravity-cli/*
/home/linuxbrew/.linuxbrew/Caskroom/antigravity-cli/* ~/.gemini/antigravity-cli/*
~/.opencode/bin/opencode ~/.local/share/opencode/*
~/.local/share/cursor-agent/versions/* ~/.config/cursor/*
# Every file, for the backup, the virus scans and the file indexer, which read the whole home
/usr/bin/restic *
/usr/bin/clamscan *
/usr/bin/clamdscan *
/usr/libexec/localsearch-* *
