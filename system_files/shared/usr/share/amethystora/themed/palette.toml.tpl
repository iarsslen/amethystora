# What the Amethystora apps take from {{ theme_name }} beyond its palette (apps/common/src/palette.rs): the colours an
# interface needs, worked out from colors.toml by /usr/lib/amethystora/theme/palette.awk, each at the contrast WCAG asks.
# The windows read it as they read colors.toml, and follow it as the theme changes.

accent_bg = "{{ accent_bg }}"
accent_fg = "{{ accent_fg }}"
accent_text = "{{ accent_text }}"
destructive_bg = "{{ destructive_bg }}"
destructive_fg = "{{ destructive_fg }}"
success_text = "{{ success_text }}"
warning_text = "{{ warning_text }}"
error_text = "{{ error_text }}"
