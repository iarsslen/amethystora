{
  "_comment": "The colours of {{ theme_name }} for VSCodium, which 10-vscodium.sh merges into the user's settings over Default Dark Modern or Default Light Modern: no extension to install, and a colour of the user's own that this does not name is kept.",
  "workbench.colorCustomizations": {
    "foreground": "{{ foreground }}",
    "focusBorder": "{{ accent_text }}",
    "selection.background": "{{ selection_background }}",
    "descriptionForeground": "{{ foreground }}b3",
    "errorForeground": "{{ error_text }}",
    "editor.background": "{{ view_bg }}",
    "editor.foreground": "{{ foreground }}",
    "editor.selectionBackground": "{{ selection_background }}",
    "editor.lineHighlightBackground": "{{ foreground }}12",
    "editorCursor.foreground": "{{ cursor }}",
    "editorLineNumber.foreground": "{{ outline }}",
    "editorLineNumber.activeForeground": "{{ foreground }}",
    "editorWidget.background": "{{ popover_bg }}",
    "editorGroupHeader.tabsBackground": "{{ headerbar_bg }}",
    "tab.activeBackground": "{{ view_bg }}",
    "tab.activeForeground": "{{ foreground }}",
    "tab.inactiveBackground": "{{ headerbar_bg }}",
    "tab.inactiveForeground": "{{ foreground }}b3",
    "tab.activeBorderTop": "{{ accent_bg }}",
    "titleBar.activeBackground": "{{ headerbar_bg }}",
    "titleBar.activeForeground": "{{ foreground }}",
    "titleBar.inactiveBackground": "{{ window_bg }}",
    "activityBar.background": "{{ sidebar_bg }}",
    "activityBar.foreground": "{{ foreground }}",
    "activityBar.inactiveForeground": "{{ foreground }}99",
    "activityBarBadge.background": "{{ accent_bg }}",
    "activityBarBadge.foreground": "{{ accent_fg }}",
    "sideBar.background": "{{ sidebar_bg }}",
    "sideBar.foreground": "{{ foreground }}",
    "sideBarSectionHeader.background": "{{ window_bg }}",
    "panel.background": "{{ view_bg }}",
    "panel.border": "{{ outline }}",
    "statusBar.background": "{{ accent_bg }}",
    "statusBar.foreground": "{{ accent_fg }}",
    "statusBar.noFolderBackground": "{{ headerbar_bg }}",
    "button.background": "{{ accent_bg }}",
    "button.foreground": "{{ accent_fg }}",
    "button.secondaryBackground": "{{ card_bg }}",
    "button.secondaryForeground": "{{ foreground }}",
    "badge.background": "{{ accent_bg }}",
    "badge.foreground": "{{ accent_fg }}",
    "input.background": "{{ card_bg }}",
    "input.foreground": "{{ foreground }}",
    "input.border": "{{ outline }}",
    "dropdown.background": "{{ popover_bg }}",
    "dropdown.foreground": "{{ foreground }}",
    "list.activeSelectionBackground": "{{ selection_background }}",
    "list.activeSelectionForeground": "{{ selection_foreground }}",
    "list.hoverBackground": "{{ foreground }}14",
    "list.inactiveSelectionBackground": "{{ card_bg }}",
    "textLink.foreground": "{{ accent_text }}",
    "terminal.background": "{{ background }}",
    "terminal.foreground": "{{ foreground }}",
    "terminalCursor.foreground": "{{ cursor }}",
    "terminal.ansiBlack": "{{ color0 }}",
    "terminal.ansiRed": "{{ color1 }}",
    "terminal.ansiGreen": "{{ color2 }}",
    "terminal.ansiYellow": "{{ color3 }}",
    "terminal.ansiBlue": "{{ color4 }}",
    "terminal.ansiMagenta": "{{ color5 }}",
    "terminal.ansiCyan": "{{ color6 }}",
    "terminal.ansiWhite": "{{ color7 }}",
    "terminal.ansiBrightBlack": "{{ color8 }}",
    "terminal.ansiBrightRed": "{{ color9 }}",
    "terminal.ansiBrightGreen": "{{ color10 }}",
    "terminal.ansiBrightYellow": "{{ color11 }}",
    "terminal.ansiBrightBlue": "{{ color12 }}",
    "terminal.ansiBrightMagenta": "{{ color13 }}",
    "terminal.ansiBrightCyan": "{{ color14 }}",
    "terminal.ansiBrightWhite": "{{ color15 }}"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {"scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": "{{ color8 }}", "fontStyle": "italic"}},
      {"scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": {"foreground": "{{ color5 }}"}},
      {"scope": ["string", "string.quoted"], "settings": {"foreground": "{{ color2 }}"}},
      {"scope": ["constant.numeric", "constant.language", "constant.character"], "settings": {"foreground": "{{ color3 }}"}},
      {"scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": {"foreground": "{{ color4 }}"}},
      {"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": {"foreground": "{{ color6 }}"}},
      {"scope": ["variable.parameter", "entity.other.attribute-name"], "settings": {"foreground": "{{ color9 }}"}},
      {"scope": ["invalid", "invalid.illegal"], "settings": {"foreground": "{{ color1 }}"}}
    ]
  }
}
