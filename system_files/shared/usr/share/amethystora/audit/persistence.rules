## Amethystora audit rules, key persistence. amethystora-audit-home-rules copies this into
## /etc/audit/rules.d/60-amethystora.rules at every boot, before auditd starts, unless PERSISTENCE=off in
## /etc/amethystora/security.conf: a key that is off loads no rule and costs nothing. A watch on a path that
## is not there is left out, since it would stop auditctl loading every rule after it.
##
## Read what these caught with: sudo ausearch -i -k persistence

## Anything that starts itself, in the writable parts of the system. Quadlets are containers systemd
## starts at boot.
-w /etc/systemd/system/ -p wa -k persistence
-w /etc/xdg/autostart/ -p wa -k persistence
-w /etc/profile.d/ -p wa -k persistence
-w /etc/containers/systemd/ -p wa -k persistence
