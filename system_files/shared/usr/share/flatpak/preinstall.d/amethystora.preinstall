# The apps every machine comes with, installed from Flathub by flatpak-preinstall.service on the first
# boot that has a network: the installer ISO carries none. Bazaar, Flatseal and DistroShelf have files
# of their own. No browser (Firefox is in the image), and Amethystora Logs in place of GNOME Logs.
#
# An app a user uninstalls stays uninstalled. An app taken off this list is uninstalled from every
# machine that got it from here. Branch is required: Flatpak assumes "master" without it.

[Flatpak Preinstall be.alexandervanhee.gradia]
Branch=stable
IsRuntime=false

[Flatpak Preinstall com.github.PintaProject.Pinta]
Branch=stable
IsRuntime=false

# The Logo Menu's "Extensions": the image removes GNOME's own Extensions app
[Flatpak Preinstall com.mattjakeman.ExtensionManager]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.github.flattool.Ignition]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.github.flattool.Warehouse]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.gitlab.adhami3310.Impression]
Branch=stable
IsRuntime=false

# Takes what a file says about you out of it before you share it (manual: security.md)
[Flatpak Preinstall io.gitlab.metadatacleaner.metadatacleaner]
Branch=stable
IsRuntime=false

[Flatpak Preinstall io.missioncenter.MissionCenter]
Branch=stable
IsRuntime=false

[Flatpak Preinstall it.mijorus.smile]
Branch=stable
IsRuntime=false

[Flatpak Preinstall org.gnome.Calculator]
Branch=stable
IsRuntime=false

