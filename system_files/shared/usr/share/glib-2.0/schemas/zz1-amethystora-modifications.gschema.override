# Amethystora overrides, applied on top of the base defaults in zz0-amethystora-modifications.
#
# Only schemas installed in /usr/share/glib-2.0/schemas can be overridden here. Relocatable schemas
# (custom keybindings, Ptyxis profiles) and extensions that keep their schema in their own directory
# are set in /etc/dconf/db/distro.d instead.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/amethystora/amethystora-facets-l.png'
picture-uri-dark='file:///usr/share/backgrounds/amethystora/amethystora-facets-d.png'
picture-options='zoom'
primary-color='2a0f4a'
secondary-color='2a0f4a'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/amethystora/amethystora-facets-d.png'

# The logo under the user list on the login screen. GDM reads it from a fixed path, which Fedora
# fills with fedora-gdm-logo.png; 06-branding.sh puts this same file at that path too, so the
# greeter is right whichever of the two GDM reads.
# The wordmark in white, not the dark one: the greeter's background is dark, and the dark lettering
# vanishes into it, leaving the gem on its own. This is the variant whose stone is lit, the way the
# boot splash leaves it, which the ordinary white wordmark is not.
[org.gnome.login-screen]
logo='/usr/share/pixmaps/amethystora-wordmark-glow.png'

[org.gnome.desktop.interface]
accent-color='purple'
# The Glass icon pack, drawn by branding/icons.mjs. amethystora-theme writes the same value on every
# switch to a dark theme, from DEFAULT_ICON_THEME in /usr/lib/amethystora/theme/lib.sh; this is what an
# account sees before it has applied a theme. An account that applied one before the pack existed holds
# an explicit value that wins over this default, which is what the 11-theme.sh setup hook's versions are for.
icon-theme='amethystora-glass'
# Halo, the pointer of the dark themes (branding/cursors.mjs, DEFAULT_POINTER in the theme library): the login screen's
# and an account's before its first theme
cursor-theme='amethystora-pointer-halo'

#-------------- FILES --------------#
# The grid, at a size that shows what the icon packs draw: their folders are full-colour artwork, and
# the list view reduces them to a 16px row. The sidebar stays monochrome whatever is set here,
# because GTK asks for the -symbolic names there.

[org.gnome.nautilus.preferences]
default-folder-viewer='icon-view'

[org.gnome.nautilus.icon-view]
default-zoom-level='large'

#-------------- TILING --------------#
# The tiling is a module of Amethystora UI (modules/tiling.js): its one setting and its keys are in its own schemas,
# whose defaults are the image's, so there is nothing to override here. While it runs it takes a GNOME binding's
# combination only where one of its own collides with it, and gives it back when it is turned off (ame desktop
# layout classic), so the maximize, move-to-monitor and workspace bindings below stay GNOME's for that case.
# 20-tests.sh holds its keys apart from the ones the image keeps.

#-------------- WORKSPACES AND WINDOWS --------------#
# Six fixed workspaces on Super+1..6, so the number keys always mean the same workspace. That takes
# Super+N away from the dash, so switching to a pinned app moves to Alt+N.

[org.gnome.mutter]
dynamic-workspaces=false

# GNOME Shell's own override sets dynamic workspaces for the GNOME desktop alone ([org.gnome.mutter:GNOME]), which
# wins over the plain section in every session: without this, GNOME had two workspaces, and a third screen none
[org.gnome.mutter:GNOME]
dynamic-workspaces=false

[org.gnome.desktop.wm.preferences]
num-workspaces=6
# Minimise, maximise and close, on the right, close last: the three lights that
# themed/window-controls-gtk*.css.tpl draws. Stated here rather than left to the base image, so that the
# theme's own index.theme is not the only thing asking for it.
button-layout=':minimize,maximize,close'

[org.gnome.desktop.wm.keybindings]
close=['<Super>w']
maximize=['<Super>Up']
unmaximize=['<Super>Down']
begin-resize=['<Super>BackSpace']
toggle-fullscreen=['<Shift>F11']
switch-to-workspace-1=['<Super>1']
switch-to-workspace-2=['<Super>2']
switch-to-workspace-3=['<Super>3']
switch-to-workspace-4=['<Super>4']
switch-to-workspace-5=['<Super>5']
switch-to-workspace-6=['<Super>6']
move-to-workspace-1=['<Super><Shift>1']
move-to-workspace-2=['<Super><Shift>2']
move-to-workspace-3=['<Super><Shift>3']
move-to-workspace-4=['<Super><Shift>4']
move-to-workspace-5=['<Super><Shift>5']
move-to-workspace-6=['<Super><Shift>6']
move-to-monitor-left=['<Super><Shift>Left']
move-to-monitor-right=['<Super><Shift>Right']

# Amethystora Clipboard, Clipboard Indicator's copy that seals its history. Clipboard Indicator's own
# shortcuts are Ctrl+F8 to Ctrl+F12, which IDEs use for building and debugging, so only the menu has a key,
# on Super+Shift+V (Super+V is the notifications). How long the history is kept is keep-history, which
# Control sets (ame desktop clipboard). Nothing copied in a password manager is recorded: these are their
# window classes and Flatpak ids.
[org.gnome.shell.extensions.amethystora-clipboard]
toggle-menu=['<Super><Shift>v']
clear-history=@as []
prev-entry=@as []
next-entry=@as []
private-mode-binding=@as []
excluded-apps=['org.keepassxc.KeePassXC', 'KeePassXC', 'org.gnome.World.Secrets', 'com.bitwarden.desktop', 'Bitwarden', '1Password', 'com.onepassword.OnePassword', 'me.proton.Pass', 'Proton Pass']

# The trash empties itself of what was deleted more than 30 days ago (GNOME's housekeeping, as the person
# who turns it on in Settings > Privacy gets; ame desktop privacy trash changes it). What was deleted is
# still in the snapshots and the backup. remove-old-temp-files does nothing on a systemd system (systemd's
# tmp.conf ages /tmp and /var/tmp); it is set only so that Settings shows the one switch on
[org.gnome.desktop.privacy]
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 30

[org.gnome.shell.keybindings]
switch-to-application-1=['<Alt>1']
switch-to-application-2=['<Alt>2']
switch-to-application-3=['<Alt>3']
switch-to-application-4=['<Alt>4']
switch-to-application-5=['<Alt>5']
switch-to-application-6=['<Alt>6']
switch-to-application-7=['<Alt>7']
switch-to-application-8=['<Alt>8']
switch-to-application-9=['<Alt>9']
