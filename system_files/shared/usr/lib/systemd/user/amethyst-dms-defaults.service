[Unit]
Description=Apply the Amethyst wallpaper to DankMaterialShell on first login
PartOf=graphical-session.target
After=dms.service
Wants=dms.service
ConditionPathExists=!%S/amethyst/dms-defaults-applied

[Service]
Type=oneshot
ExecStart=/usr/libexec/amethyst-dms-defaults

[Install]
WantedBy=graphical-session.target
