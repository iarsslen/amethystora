[Unit]
Description=OpenTabletDriver, the drawing tablet driver from Flathub
Documentation=https://opentabletdriver.net
# Enabled only by `ame apps opentabletdriver on`, for the account that ran it. Once the Flatpak is gone
# there is nothing to start, rather than a failed start every three seconds.
ConditionPathExists=/var/lib/flatpak/app/net.opentabletdriver.OpenTabletDriver
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/flatpak run net.opentabletdriver.OpenTabletDriver -d
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
