[Unit]
Description=Configure system for current user
Wants=network-online.target
After=network-online.target
ConditionUser=!@system
# GNOME's first-run setup runs as an account of its own, numbered above the system's range: the manual's
# welcome page opened behind it
ConditionUser=!gnome-initial-setup

[Service]
Type=simple
ExecStart=/usr/bin/amethystora-user-setup

[Install]
WantedBy=graphical-session.target
