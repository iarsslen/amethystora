[Unit]
Description=Network protection: download the rules when they are due

[Timer]
# Hourly, and the service downloads only when due (amethystora-ips due): every hour with
# NETWORK_FEEDS=hourly, otherwise once a day, at once after a setting changed, and not on a metered connection
OnCalendar=hourly
# A machine that was off still gets them when it comes back
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
