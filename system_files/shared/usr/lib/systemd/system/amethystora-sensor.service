[Unit]
Description=Amethystora file-watch sensor
Documentation=file:///usr/share/amethystora/manual/security.md
# It watches the same files and operations the audit rules watch, where they happen rather than at every
# system call, and writes them as audit records of its own for the security watcher to read. See
# plans/done/PLAN-audit-cost.md. It runs only while the plan gives it at least one key (--check).
#
# Early, like the audit rules it stands in for, and after them so their plan (which keys are the sensor's)
# is written first. local-fs.target is all it needs, for /etc, /var and the homes it registers.
# Nobody logs in until it is watching (READY=1, once every watch is registered, about a second), so that
# nothing an account does goes unrecorded; the rest of the boot goes on beside it. It never holds the logins
# past 30 s (LOGIN_WAIT in run.rs), and one that keeps failing lets them in once systemd stops restarting it.
DefaultDependencies=no
After=local-fs.target amethystora-audit-rules.service
Before=systemd-user-sessions.service shutdown.target
Conflicts=shutdown.target
# Stopping it is itself worth recording: a stop from a console takes a reboot, as the locked audit rules do.
RefuseManualStop=yes

[Service]
Type=notify
# Wanted only while the audit log and the watcher are on and the plan gave it a key (see amethystora-sensor
# --check); off, it is skipped, not failed, like the audit rules.
ExecCondition=/usr/libexec/amethystora-sensor --check
ExecStart=/usr/libexec/amethystora-sensor
Restart=always
RestartSec=1

# It runs as root to load BPF and to open every watched folder, but reaches nothing it does not need: the
# system read-only, the homes read-only (it only reads them), and only its own log and its run directory to
# write (the readiness marker; the generator owns the directory, this only writes within it).
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/run/amethystora/sensor
LogsDirectory=amethystora-sensor
LogsDirectoryMode=0700
# No PrivateTmp: it registers /tmp and /var/tmp by opening them, and private ones would be its own, not the
# folders programs are run from (ProtectSystem=strict keeps both read-only to it all the same)
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
NoNewPrivileges=yes
# It holds one open descriptor per watched folder to pin its inode (up to tens of thousands across /etc and
# every home), far past the default soft limit, so raise it or registration would stop at EMFILE.
LimitNOFILE=524288
# Loading tracing BPF and reading kernel memory from it, and opening any folder to register it. The exact
# set is to be tightened once the lab confirms what the load needs; CAP_SYS_ADMIN covers older kernels.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH
# Steady-state is ~11 MB, and the load peaks at ~12 MB with every key on: the verifier's work is charged here,
# 136 MB while it walked the paths again for every caller (see walk_path in sensor.bpf.c). MemoryHigh
# throttles — not just caps — so it stays well clear of a machine with tens of thousands of watched folders,
# each a held descriptor and a map entry, or the daemon stalls mid-registration.
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
