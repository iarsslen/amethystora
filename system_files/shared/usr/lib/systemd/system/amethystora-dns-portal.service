[Unit]
Description=Offer to pause encrypted DNS on a network that wants a login first
Documentation=file:///usr/share/amethystora/manual/security.md

# Started by NetworkManager's dispatcher (60-amethystora-dns-portal), which must not wait for an answer
[Service]
Type=oneshot
ExecStart=/usr/libexec/amethystora-dns portal
# It waits for the notification to be answered, which can take as long as a person likes
TimeoutStartSec=infinity
