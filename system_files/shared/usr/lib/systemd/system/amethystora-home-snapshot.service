[Unit]
Description=Read-only snapshot of the home folders, for ransomware protection
Documentation=man:btrfs-subvolume(8)

[Service]
Type=oneshot
# Takes this hour's snapshot of /var/home and thins out the old ones. Turned on and off with
# `ame security ransomware`, which enables the timer; the report says when the latest is old.
ExecStart=/usr/libexec/amethystora-home-snapshot
Nice=19
IOSchedulingClass=idle
# The timer is what runs this, so the service itself is never enabled and needs no [Install] section
