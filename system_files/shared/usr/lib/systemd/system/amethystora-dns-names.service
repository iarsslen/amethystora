[Unit]
Description=Odd names in DNS (security watcher)
Documentation=man:resolvectl(1)
After=systemd-resolved.service
Requisite=systemd-resolved.service

[Service]
Type=exec
# Off as the image ships: DNS_NAMES in /etc/amethystora/security.conf, and the watcher that reads what it finds
ExecCondition=/usr/libexec/amethystora-security-config --is DNS_NAMES record on
ExecCondition=/usr/libexec/amethystora-security-config --is WATCHER on
ExecStart=/usr/libexec/amethystora-dns-names
Restart=on-failure
RestartSec=30
# Within its budget, and able to write nowhere but the file the watcher reads, and to reach nothing but
# resolved's socket
CPUWeight=20
IOWeight=20
MemoryHigh=30M
MemoryMax=60M
ProtectSystem=strict
ReadWritePaths=/var/lib/amethystora/security
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
