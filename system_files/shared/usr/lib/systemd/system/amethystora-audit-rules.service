[Unit]
Description=Audit watches for each user's home directory
Documentation=man:auditctl(8)
# The rules name paths inside home directories, so they can only be written once those exist, and they
# are written into /etc/audit/rules.d rather than shipped with the image.
#
# Before the rules are loaded, not after: 99-amethystora-finalize.rules closes the rule set with -e 2, so
# the one load at boot is the only chance these have to reach the kernel. Since audit 4.2 (Fedora 44),
# audit-rules.service makes it with `augenrules --load` once auditd has started; before that, auditd
# loaded them itself as it started. This comes before both, by name, so that it does even when auditd
# is not started. A load afterwards would be refused, and the home directories would go unwatched.
#
# auditd runs in early boot, before sysinit.target. With the default dependencies this would come after
# sysinit.target and so after auditd as well, and systemd breaks that cycle by dropping auditd's start
# job: auditd stayed off at every boot. local-fs.target is all this needs, for /etc and /var/home.
DefaultDependencies=no
After=local-fs.target
Before=auditd.service audit-rules.service sysinit.target shutdown.target
Conflicts=shutdown.target
Wants=auditd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Nothing to write while AUDIT_LOG=off in /etc/amethystora/security.conf: auditd and its rules stay off
ExecCondition=/usr/libexec/amethystora-security-config --is AUDIT_LOG on
ExecStart=/usr/libexec/amethystora-audit-home-rules
# auditd and the rules' load wait on this, so it may not sit there: a handful of lines per account takes
# moments
TimeoutStartSec=30
# It runs as root in every home, so whatever an account puts there, it can write nowhere but the audit
# rules and the homes themselves. systemd-resolved runs this early with the same sandbox. augenrules, for
# a run by hand, makes its temporary file in /tmp; /var/home is missing only on a machine with no homes.
ProtectSystem=strict
ReadWritePaths=/etc/audit -/var/home
PrivateTmp=disconnected
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
