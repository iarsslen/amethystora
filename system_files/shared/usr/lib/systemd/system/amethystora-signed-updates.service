[Unit]
Description=Keep this machine's updates signature-checked
Documentation=man:bootc-switch(8)
# Only a booted bootc system has an image whose updates can be checked
ConditionPathExists=/run/ostree-booted
# A sealed image has no origin to switch: every pull it makes is checked against policy.json itself
ConditionPathExists=!/usr/share/amethystora/sealed
# Staging the switch fetches the image's signature from the registry. Nothing waits on this unit, so
# waiting for the network here delays nothing else.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Skipped while the owner turned it off (ame security signed-updates off): then it no longer switches the
# machine back to the signed origin, and switches nothing the other way either
ExecCondition=/usr/libexec/amethystora-hardening is-on signed-updates
ExecStart=/usr/libexec/amethystora-signed-updates

[Install]
WantedBy=multi-user.target
