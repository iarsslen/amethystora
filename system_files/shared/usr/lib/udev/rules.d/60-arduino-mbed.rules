# Source: https://github.com/arduino/ArduinoCore-mbed/blob/main/post_install.sh
# Amethystora: the boards' USB and serial devices, for the user at the seat (uaccess), instead of
# upstream's MODE 0666 on every device under these vendor IDs, which are shared by many hobby devices
# (the Raspberry Pi's, and the Linux USB gadget's): a keyboard built on one of them was open to every
# account, keys and all.
SUBSYSTEM=="usb|tty", ATTRS{idVendor}=="2e8a|2341|1fc9|0525", MODE="0660", TAG+="uaccess"

# Arduino Nano clone, @vfosnar owns one
SUBSYSTEM=="usb|tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0660", TAG+="uaccess"
