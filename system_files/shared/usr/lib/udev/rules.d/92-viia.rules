# Keychron keyboard hardware enablement
# Created on https://github.com/ublue-os/config/pull/153
# Written by https://github.com/atimeofday
# Amethystora: the keyboards VIA and Vial configure, for the user at the seat (uaccess), instead of
# upstream's MODE 0666 on every hidraw device. A keyboard's hidraw device carries every key typed on it,
# so that rule let any account, a remote session or a Flatpak with --device=all read them.
# Keychron's and Lemokey's (VIA, Keychron Launcher), and any keyboard running Vial, which puts its magic
# number in the USB serial
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434|362d", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{serial}=="*vial:f64c2b3c*", MODE="0660", TAG+="uaccess"
