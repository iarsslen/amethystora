#!/usr/bin/bash
# Ransomware protection (amethystora-home-snapshot.timer, turned on with `ujust
# setup-ransomware-protection`): a read-only btrfs snapshot of the home folders, every hour.
#
# Ransomware running as a user encrypts everything that user can write, and a read-only snapshot is not
# something any user can write: changing one or deleting one takes root. Each snapshot keeps the
# permissions it copied, so a user can read their own files in it and nobody else's, and copy them back
# without a password.
#
# Kept: every snapshot from the last day, and the first of each day for two weeks. Never fewer because
# the disk is filling up: ransomware that rewrites every file doubles what the home folders take, and
# making room would delete exactly the snapshots from before it. A full disk stops the encryption too.
#
# What this does not survive is ransomware that has root, which can delete snapshots like anything
# else. That is what an append-only backup somewhere else is for (ujust setup-backup).

set -euo pipefail

HOMES=/var/home
SNAPSHOTS="${HOMES}/.snapshots"
KEEP_DAYS=14

# Only a btrfs subvolume can be snapshotted, and the root directory of one is always inode 256
if [[ "$(stat -f -c %T "${HOMES}")" != btrfs || "$(stat -c %i "${HOMES}")" != 256 ]]; then
    echo "${HOMES} is not a btrfs subvolume of its own, so it cannot be snapshotted." >&2
    exit 1
fi

# Readable by everyone, as /var/home is: each home inside a snapshot keeps its own permissions
mkdir -p -m 0755 "${SNAPSHOTS}"

NOW="$(date +%s)"
NAME="$(date -d "@${NOW}" +%Y-%m-%d_%H%M)"
[[ -e "${SNAPSHOTS}/${NAME}" ]] || btrfs subvolume snapshot -r "${HOMES}" "${SNAPSHOTS}/${NAME}"

# Oldest first, as the names sort, so the first one met of each day is the one that day keeps
declare -A DAY_KEPT=()
for dir in "${SNAPSHOTS}"/*; do
    [[ "${dir##*/}" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})_([0-9]{2})([0-9]{2})$ ]] || continue
    day="${BASH_REMATCH[1]}"
    taken="$(date -d "${day} ${BASH_REMATCH[2]}:${BASH_REMATCH[3]}" +%s)" || continue
    age=$((NOW - taken))
    if [[ "${age}" -lt 86400 ]]; then
        continue
    elif [[ "${age}" -lt $((KEEP_DAYS * 86400)) && -z "${DAY_KEPT[${day}]+set}" ]]; then
        DAY_KEPT["${day}"]=1
        continue
    fi
    btrfs subvolume delete "${dir}"
done
