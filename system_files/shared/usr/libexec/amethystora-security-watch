#!/usr/bin/bash
# The security watcher (amethystora-security-watch.timer: every 15 minutes, and at once while real-time
# watching is on). What Wazuh's agent does for a server, cut down to what one desktop with a read-only
# /usr needs, and with nothing sent anywhere:
#
#   - The audit log. The rules in /etc/audit/rules.d record writes to what would let something survive a
#     reboot or reach root, kernel modules loaded from a login, and programs opening input devices.
#     Each run reads what is new since the last, one checkpoint per key.
#   - The journal: accounts locked by faillock, wrong sudo and administrator passwords, and USB devices
#     USBGuard blocked. A few of those are someone typing badly; more is someone guessing.
#   - Network protection's alerts (amethystora-ips.service): each connection Suricata blocked, and what
#     it recognised without blocking. Kept for `ame security connections` and the Security app.
#   - What only root can see, written to status.json for the report: /etc compared with the image's own
#     copy of it in /usr/etc, setuid programs outside /usr (once a day), and which programs accept
#     connections from other machines.
#   - What each account's session finds first: a command in ~/.local/bin, ~/bin or Homebrew's prefix
#     named like one of the system's, and a launcher in the app grid that no container export made.
#     And a place in a home the audit rules watch that a link takes out of it, where they cannot.
#   - The report. Its checks live in /usr/libexec/amethystora-security-status and nowhere else. This runs
#     it and speaks up when a check it watches goes from fine to not, or changes while it is not fine,
#     the way Wazuh's configuration checks report a result only when it changes.
#   - What looks for new threats by what they do, each off until its switch is on, alone or with a profile:
#     odd processes, SELinux's denials, ransomware in the hourly snapshots, AI agents run with their checks
#     off, secrets read and the decoy key, programs run from the download folders, programs loaded into the
#     kernel's BPF, odd names in DNS, the behaviour sensor (Falco), hash reputation, what each account's
#     own reader finds (amethystora-security-reader, run as that account): apps that gain permissions,
#     agents' settings, developer tools' startup hooks, and what the app integrity check found
#     (amethystora-integrity). Chains of steps put what they find together.
#
# The first run only records where things stand. After it, anything new is written to the history and,
# unless it is routine, to the unread list `ame security events` shows, with one notification a run.
#
# Each part is a switch of its own in /etc/amethystora/security.conf (`ame security settings` lists them):
# off, record (to the history, without a notification) or on. The watcher as a whole is WATCHER.
#
#   amethystora-security-watch           one run (amethystora-security-watch.service)
#   amethystora-security-watch --show    what is unread, then the end of the history
#   amethystora-security-watch --seen    mark everything read
#   amethystora-security-watch --keys    the audit keys it reads, for `ame security events`
#
# A finding carries its facts: when, its level, the part of the watcher that found it (an audit key, journal,
# listeners, user-paths, network, report, settings), the account it is about or "-", the ATT&CK tactic it
# belongs to or "-", and its sentence. The history keeps them as JSON lines (amethystora-security-events.jsonl,
# root's alone, the last 5000), and events.json the last 500 for the Security app's Events page, which the
# members of wheel can read. What somebody else wrote (a file name, a program's, a command line, a launcher's
# Exec= line) goes through amethystora-security-text before it is kept, said or shown anywhere.

set -uo pipefail

# AMETHYSTORA_WATCH_ROOT is for build_files/shared/test-security-watch.sh, which runs this against a stand-in
# /etc/passwd, /var/home, state and logs; a build must not write /var/lib or /var/log. AMETHYSTORA_WATCH_NOTIFY
# names a stand-in for amethystora-notify-users then, and is read only with a stand-in root.
ROOT="${AMETHYSTORA_WATCH_ROOT:-}"
NOTIFY=/usr/libexec/amethystora-notify-users
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_NOTIFY:-}" ]] && NOTIFY="${AMETHYSTORA_WATCH_NOTIFY}"
STATE="${ROOT}/var/lib/amethystora/security"
STATUS="${STATE}/status.json"
EVENTS="${STATE}/events.json"
EVENTS_KEPT=500
UNREAD="${ROOT}/var/log/amethystora-security-events.new"
HISTORY="${ROOT}/var/log/amethystora-security-events.jsonl"
# The history before it held facts, one "date time  text" a line: shown once more, then left as it is
OLD_HISTORY="${ROOT}/var/log/amethystora-security-events.log"
HISTORY_KEPT=5000
# The setuid sweep reads every file under /etc and /var, home directories included
SWEEP_EVERY=$((24 * 3600))
AUDIT_KEYS=(identity privilege persistence hardening modules input-capture user-programs exec-watch agent-clis credentials decoy injection)
# ...of which these are read by parts of their own, from the kernel's raw records, rather than as sentences
AUDIT_OWN=" exec-watch agent-clis credentials decoy injection "
TEXT=/usr/libexec/amethystora-security-text

[[ "${EUID}" -eq 0 || "${1:-}" == --keys ]] || { echo "${0##*/} needs root." >&2; exit 77; }

case "${1:-}" in
    --show)
        if [[ -s "${UNREAD}" ]]; then
            echo "New since you last looked:"
            "${TEXT}" --lines <"${UNREAD}" | sed 's/^/  /'
        else
            echo "Nothing new since you last looked."
        fi
        if [[ -s "${HISTORY}" ]]; then
            echo
            echo "The last 20 in the history (${HISTORY}):"
            tail -n 20 "${HISTORY}" | jq -r '[(.time | strftime("%F %T")), .level, .text] | join("  ")' 2>/dev/null |
                "${TEXT}" --lines | sed 's/^/  /'
        elif [[ -s "${OLD_HISTORY}" ]]; then
            echo
            echo "The last 20 in the history (${OLD_HISTORY}):"
            tail -n 20 "${OLD_HISTORY}" | "${TEXT}" --lines | sed 's/^/  /'
        fi
        exit 0
        ;;
    --seen)
        [[ -e "${UNREAD}" ]] && : >"${UNREAD}"
        exit 0
        ;;
    --keys)
        (IFS='|'; echo "${AUDIT_KEYS[*]}")
        exit 0
        ;;
    "") ;;
    *)
        echo "usage: ${0##*/} [--show | --seen | --keys]" >&2
        exit 64
        ;;
esac

# Everything written here is root's alone, apart from status.json, which says so where it is written
umask 077
mkdir -p -m 0755 "${STATE}"
NOW="$(date +%s)"
LAST_RUN="$(cat "${STATE}/last-run" 2>/dev/null || true)"
[[ "${LAST_RUN}" =~ ^[0-9]+$ ]] || LAST_RUN=""

# Every part of this is a switch in /etc/amethystora/security.conf, read once: off, it is not read at all;
# record, what it finds goes to the history without a notification; on, it is said. WATCHER=off stops the
# whole run before it starts (ExecCondition= in the unit).
declare -A SETTING=()
while IFS='=' read -r key value; do
    SETTING["${key}"]="${value}"
done < <(/usr/libexec/amethystora-security-config --all)

# What this run found, one JSON object each: add LEVEL KEY ACCOUNT TACTIC TEXT [FACT=VALUE]... critical and
# normal are said out loud; quiet only goes to the history, for what is worth a record and not an
# interruption. While the part that found it is set to record, everything it finds is quiet. The text is made
# safe to show here, once, for the history, the unread list, events.json and the notification alike.
#
# The facts a finding may carry besides, each for a button on the Events page or for who is told:
#   allow=ENTRY  what `ame security allow KEY ENTRY` would add for it to stop being said
#   at=POINT     the snapshot to go back to, which Backups opens
#   tell=NAME    said to that account's sessions alone, since it is about that account's own things
# Each finding has an id, which is all the page ever sends back.
FINDINGS=()
MODE=on
ALLOWED_HIT=0
add() {
    local level="$1" key="$2" account="$3" tactic="$4" text fact facts=()
    [[ "${MODE}" == record ]] && level=quiet
    [[ "${account}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ && "${account}" != unset ]] || account=-
    text="$("${TEXT}" "$5")"
    shift 5
    for fact in "$@"; do
        # A fact that would not be shown as it is, is not kept: an entry has to be one the allowlist takes
        [[ "${fact}" =~ ^(allow|at|tell)=([^[:cntrl:]]{1,1024})$ ]] || continue
        [[ "${BASH_REMATCH[1]}" != allow ]] || allowlist_feature "${key}" || continue
        facts+=(--arg "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")
    done
    # What the owner allowed is kept, marked, and builds no chain of steps (CHAINS)
    [[ "${ALLOWED_HIT}" == 1 ]] && facts+=(--arg allowed yes)
    ALLOWED_HIT=0
    FINDINGS+=("$(jq -nc --arg id "${NOW}-${#FINDINGS[@]}" --argjson time "${NOW}" --arg level "${level}" \
        --arg key "${key}" --arg account "${account}" --arg tactic "${tactic}" --arg text "${text}" "${facts[@]}" \
        '{$id, $time, $level, $key, $account, $tactic, $text} + ($ARGS.named | del(.id, .time, .level, .key, .account, .tactic, .text))')")
}

# --- What the machine's owner said is fine ---------------------------------------------------------------

# The allowlists (amethystora-security-allow): the image's entries in /usr/share, the machine's in /etc. An
# entry is a glob, against a path or a program as the feature reads it, or the exact words the feature gave;
# ~/ at its start stands for every home.
ALLOW_SHIPPED=/usr/share/amethystora/allow.d
ALLOW_MACHINE="${ROOT}/etc/amethystora/allow.d"
declare -A ALLOWLIST=()
ALLOW_FEATURES=" $(/usr/libexec/amethystora-security-allow --features | tr '\n' ' ') "
allowlist_feature() { [[ "${ALLOW_FEATURES}" == *" $1 "* ]]; }
allowed() {
    local feature="$1" entry="$2" pattern
    if [[ -z "${ALLOWLIST[${feature}]+set}" ]]; then
        ALLOWLIST["${feature}"]="$(cat "${ALLOW_SHIPPED}/${feature}" "${ALLOW_MACHINE}/${feature}" 2>/dev/null |
            grep -vE '^[[:space:]]*(#|$)' | sed 's#^~/#/var/home/*/#; s# ~/# /var/home/*/#g')"
    fi
    while IFS= read -r pattern; do
        [[ -n "${pattern}" ]] || continue
        # shellcheck disable=SC2053 # the entry is a glob
        [[ "${entry}" == ${pattern} ]] && return 0
    done <<<"${ALLOWLIST[${feature}]}"
    return 1
}

# Runs a part of the watcher unless its switch is off, with what it finds quiet while the switch is record
switched() {
    MODE="${SETTING[$1]:-on}"
    shift
    [[ "${MODE}" == off ]] || "$@"
    MODE=on ALLOWED_HIT=0
}

# When a switch's own command changed something (amethystora-security-config note), what root's processes
# did around then, as the audit log recorded it, is that change: recorded, and not said. Two minutes from each
# note. What an account's own programs wrote in that time is said as ever: a switch changes nothing as them.
NOTED="$(cut -f1 "${STATE}/notes" 2>/dev/null | grep -E '^[0-9]+$' | tr '\n' ' ')"

# --- The audit log ------------------------------------------------------------------------------------

# The ATT&CK tactic a change under each key belongs to
declare -A AUDIT_TACTIC=(
    [identity]=Persistence [privilege]="Privilege Escalation" [persistence]=Persistence
    [hardening]="Defense Evasion" [modules]=Persistence [input-capture]=Collection [user-programs]=Persistence
)
declare -A AUDIT_WHAT=(
    [identity]="Accounts changed"
    [privilege]="Who may become root changed"
    [persistence]="What starts by itself changed"
    [hardening]="A security setting changed"
    [modules]="A kernel module was loaded or removed"
    [input-capture]="A program read the keyboard or another input device directly"
    [user-programs]="A command or launcher in a home folder changed"
)
# Changing accounts is these programs' job: a new password is not news
ACCOUNT_TOOLS=" /usr/bin/passwd /usr/sbin/useradd /usr/sbin/usermod /usr/sbin/userdel /usr/sbin/groupadd \
/usr/sbin/groupmod /usr/sbin/groupdel /usr/bin/gpasswd /usr/sbin/chpasswd /usr/bin/chage \
/usr/libexec/accounts-daemon /usr/bin/systemd-sysusers "
# Programs already seen opening input devices: the first time is news, the hundredth is a game
INPUT_SEEN="${STATE}/input-programs"

# ausearch --format text writes one sentence an event: "At 10:02:03 09/26/2026 alice, acting as root,
# successfully opened-file /etc/sudoers using /usr/bin/vim". Its dates are in the locale's %x, so every
# call runs in the C locale and every date passed to it is written in that locale too.
#
# Only SYSCALL events, which is what every rule here records. The kernel also notes each rule it loads
# as a CONFIG_CHANGE carrying that rule's key, and those would read as "add_rule identity using
# auditctl", once per rule at every boot: auditctl's own call is in the same event, so -m SYSCALL keeps
# them, and their lines are left out by what they say. The rules cannot change after that: -e 2 locks
# them, and a try is unsuccessful, which is said.
# Where the file-watch sensor (amethystora-sensor) writes its records, and which keys it covers, from the
# plan the boot-time generator wrote (plans/done/PLAN-audit-cost.md). A key the plan gives the sensor is
# read from the sensor's log, by a checkpoint of its own, so a change of source never confuses a checkpoint;
# every other key, and the AVCs, stay on auditd's log exactly as before. With a stand-in root the tests name
# a stand-in sensor log (AMETHYSTORA_WATCH_SENSOR) and plan (AMETHYSTORA_SENSOR_RUN).
SENSOR_LOG=/var/log/amethystora-sensor/audit.log
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_SENSOR:-}" ]] && SENSOR_LOG="${AMETHYSTORA_WATCH_SENSOR}"
# The sensor's unit is asked through systemctl, or a stand-in the tests name (AMETHYSTORA_WATCH_SYSTEMCTL)
SYSTEMCTL=systemctl
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_SYSTEMCTL:-}" ]] && SYSTEMCTL="${AMETHYSTORA_WATCH_SYSTEMCTL}"
SENSOR_RUN="${AMETHYSTORA_SENSOR_RUN:-${ROOT}/run/amethystora/sensor}"
SENSOR_COVERS=" "
if [[ -r "${SENSOR_RUN}/plan" ]]; then
    while read -r _skey _swhere _; do
        [[ "${_swhere}" == sensor ]] && SENSOR_COVERS+="${_skey} "
    done <"${SENSOR_RUN}/plan"
fi

# What is new since the last read of NAME, one checkpoint each: audit_since NAME AUSEARCH-ARGUMENT... The
# source is the sensor's log for a key the plan gives it, auditd's otherwise. With a stand-in root,
# AMETHYSTORA_WATCH_AUDIT names a stand-in audit log, in the raw form the kernel writes, which the tests plant.
AUDIT_INPUT=()
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_AUDIT:-}" ]] && AUDIT_INPUT=(-if "${AMETHYSTORA_WATCH_AUDIT}")
audit_since() {
    local name="$1" output status day time src input checkpoint
    shift
    # "sensor" is what was done to the sensor itself, which only its own log holds
    if [[ "${name}" == sensor || "${SENSOR_COVERS}" == *" ${name} "* ]]; then
        src=sensor
        input=(-if "${SENSOR_LOG}")
    else
        src=audit
        input=("${AUDIT_INPUT[@]}")
    fi
    checkpoint="${STATE}/${src}-${name}.checkpoint"
    if [[ -s "${checkpoint}" ]]; then
        output="$(LC_ALL=C ausearch "${input[@]}" --checkpoint "${checkpoint}" "$@" 2>/dev/null)"
        status=$?
        # The event the checkpoint names has rotated out of the log: carry on from its time instead
        if [[ ${status} -ge 10 && ${status} -le 12 ]]; then
            output="$(LC_ALL=C ausearch "${input[@]}" --checkpoint "${checkpoint}" --start checkpoint "$@" 2>/dev/null)"
        fi
    else
        # Nothing read under this name yet: everything since the last run, which also makes the checkpoint
        read -r day time <<<"$(LC_ALL=C date -d "@${LAST_RUN:-${NOW}}" '+%x %T')"
        output="$(LC_ALL=C ausearch "${input[@]}" --checkpoint "${checkpoint}" --start "${day}" "${time}" "$@" 2>/dev/null)"
    fi
    chmod 0600 "${checkpoint}" 2>/dev/null
    printf '%s\n' "${output}"
}

audit_events() {
    local key="$1" output
    output="$(audit_since "${key}" -m SYSCALL -k "${key}" --format text)"
    # One line for each different thing that happened, however many times it did, each marked "noted"
    # when it happened within two minutes of a switch's own command and "-" otherwise. The times are the
    # local ones ausearch writes, which mktime reads as local too.
    awk -v noted="${NOTED}" '
        BEGIN { count = split(noted, times, " ") }
        /^At [0-9:]+ [0-9\/]+ / {
            split($2, t, ":")
            split($3, d, "/")
            year = d[3] < 100 ? d[3] + 2000 : d[3]
            when = mktime(year " " d[1] " " d[2] " " t[1] " " t[2] " " t[3])
            mark = "-"
            for (i = 1; i <= count; i++) {
                if (when >= times[i] - 5 && when <= times[i] + 120) mark = "noted"
            }
            line = $0
            sub(/^At [^ ]+ [^ ]+ /, "", line)
            if (line ~ / successfully (add|remove)_rule [^ ]+ using [^ ]*auditctl$/) next
            print mark " " line
        }' <<<"${output}" | sort | uniq -c
}

read_audit() {
    local key count mark event exe level text object
    for key in "${AUDIT_KEYS[@]}"; do
        [[ "${AUDIT_OWN}" == *" ${key} "* ]] && continue
        MODE="${SETTING[$(tr 'a-z-' 'A-Z_' <<<"${key}")]:-on}"
        if [[ "${MODE}" == off ]]; then
            # Turned on again, it starts from that run rather than reading everything since it went off,
            # whichever source it was reading from
            rm -f "${STATE}/audit-${key}.checkpoint" "${STATE}/sensor-${key}.checkpoint"
            continue
        fi
        while read -r count mark event; do
            [[ -n "${event}" ]] || continue
            exe=""
            [[ "${event}" == *" using "* ]] && exe="${event##* using }"
            case "${key}" in
                identity) [[ -n "${exe}" && "${ACCOUNT_TOOLS}" == *" ${exe} "* ]] && level=quiet || level=normal ;;
                privilege | modules) level=critical ;;
                # Installing anything with pip or a container export writes here. What matters among it,
                # a name the system's own commands have, read_user_paths below says out loud.
                user-programs) level=quiet ;;
                input-capture)
                    level=quiet
                    if [[ -n "${exe}" ]] && ! grep -qxF -- "${exe}" "${INPUT_SEEN}" 2>/dev/null; then
                        echo "${exe}" >>"${INPUT_SEEN}"
                        level=normal
                    fi
                    ;;
                *) level=normal ;;
            esac
            # "tester, acting as root, ..." for sudo, "system, acting as root, ..." for a service, "root ..." for root's
            # own login; "tester ..." is a program of the account's own
            [[ "${mark}" == noted && ( "${event}" == *", acting as root, "* || "${event}" == "root "* ) ]] && level=quiet
            # A write or a removal that failed changed nothing: GNOME Shell's GSConnect takes away copies of its
            # files that are not there at every login. A module the kernel refused, and a try at the locked
            # rules, are still said.
            [[ "${key}" != modules && "${event}" == *" unsuccessfully "* && "${event}" != *" unsuccessfully "*_rule" "* ]] &&
                level=quiet
            # What it was done to: "..., successfully opened-file /etc/sudoers using /usr/bin/vim". A path the
            # owner allowed, or a program, is recorded and not said.
            object=""
            [[ "${event}" =~ successfully\ [a-z-]+\ (/.+)\ using\  ]] && object="${BASH_REMATCH[1]}"
            # ...of a change of mode or owner, the file alone: "to 0750" is what it became, and a mode set through
            # a relative path (chmod -R) comes out as a number that is different every time
            [[ "${event}" =~ successfully\ changed-file-(permissions|ownership)-of\ (/.+)\ to\ [^\ ]+\ using\  ]] &&
                object="${BASH_REMATCH[2]}"
            if { [[ -n "${object}" ]] && allowed "${key}" "${object}"; } || { [[ -n "${exe}" ]] && allowed "${key}" "${exe}"; }; then
                level=quiet ALLOWED_HIT=1
            fi
            text="${AUDIT_WHAT[${key}]}: ${event}"
            [[ "${count}" -gt 1 ]] && text+=" (${count} times)"
            # The first run has no "since": it only makes the checkpoints
            # The account is the sentence's first word: "alice, acting as root, ..."
            [[ -n "${LAST_RUN}" ]] && add "${level}" "${key}" "${event%%,*}" "${AUDIT_TACTIC[${key}]}" "${text}" \
                ${object:+"allow=${object}"}
        done < <(audit_events "${key}")
    done
    MODE=on
}

# What the kernel recorded of each event under NAME's key, one line each, its fields apart by the unit
# separator: time, process, parent, login uid, terminal, program, the path the call named (item 0, made whole
# with the working folder), whether the call succeeded (yes or no), and the arguments a program was started
# with, apart by the record separator.
# The kernel writes a value that holds a space, a quote or a control character in hex; it is read back, and
# what is still a control character in it becomes "?".
audit_records() {
    audit_since "$1" -m SYSCALL,EXECVE,CWD,PATH -k "$1" -r | awk '
        BEGIN { for (i = 0; i < 256; i++) byte[sprintf("%02X", i)] = sprintf("%c", i) }
        function value(record, name, text,   m, i, out) {
            if (match(record, " " name "=\"[^\"]*\"")) m = substr(record, RSTART + length(name) + 3, RLENGTH - length(name) - 4)
            else if (match(record, " " name "=[^ ]+")) {
                m = substr(record, RSTART + length(name) + 2, RLENGTH - length(name) - 2)
                if (text && m ~ /^([0-9A-F][0-9A-F])+$/) {
                    out = ""
                    for (i = 1; i < length(m); i += 2) out = out byte[substr(m, i, 2)]
                    m = out
                }
            } else return ""
            gsub(/[\000-\037\177]/, "?", m)
            return m
        }
        function flush() {
            if (event == "") return
            if (path != "" && path !~ /^\//) path = cwd "/" path
            printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", time, pid, ppid, auid, tty, exe, path, ok, args
        }
        match($0, /msg=audit\([0-9]+\.[0-9]+:[0-9]+\)/) {
            id = substr($0, RSTART + 10, RLENGTH - 11)
            if (id != event) {
                flush()
                event = id
                time = int(id)
                pid = ppid = auid = tty = exe = cwd = path = ok = args = ""
            }
            if ($0 ~ /^type=SYSCALL /) {
                pid = value($0, "pid", 0); ppid = value($0, "ppid", 0); auid = value($0, "auid", 0)
                tty = value($0, "tty", 0); exe = value($0, "exe", 1); ok = value($0, "success", 0)
            } else if ($0 ~ /^type=EXECVE /) {
                argc = value($0, "argc", 0) + 0
                for (i = 0; i < argc && i < 64; i++) args = args (i ? "\036" : "") value($0, "a" i, 1)
            } else if ($0 ~ /^type=CWD /) {
                cwd = value($0, "cwd", 1)
            } else if ($0 ~ /^type=PATH / && value($0, "item", 0) == "0") {
                path = value($0, "name", 1)
            }
        }
        END { flush() }'
}

# --- Programs run from writable folders --------------------------------------------------------------------

# A program run for the first time from /tmp, /var/tmp, /dev/shm, a home's cache or download folder: a
# download or a dropped file starting. The audit rules record every such run (EXEC_WATCH, from the next boot);
# each program is said once, by the SHA-256 of what is in it, and one gone by the time this looks by its path.
# Hashing a file an account owns, as root: read-only, never through a link, and for no longer than ten seconds.
# A run the system refused (a noexec folder, no execute permission, SELinux) is said too, once, by the program
# it tried, which is the path the call named: its exe is the program that tried.
EXEC_SEEN_KEPT=5000
read_exec() {
    local seen="${STATE}/exec-seen" time pid ppid auid tty exe path ok args program sum user level text
    local -A said=()
    touch "${seen}"
    while IFS=$'\x1f' read -r time pid ppid auid tty exe path ok args; do
        program="${exe}"
        [[ "${ok}" == no ]] && program="${path}"
        [[ -n "${program}" && -z "${said[${ok}:${program}]+set}" ]] || continue
        said["${ok}:${program}"]=1
        if [[ -f "${program}" && ! -L "${program}" ]]; then
            sum="$(timeout 10 head -c 104857600 -- "${program}" 2>/dev/null | sha256sum | cut -d' ' -f1)"
        else
            sum="gone:${program}"
        fi
        [[ "${ok}" == no ]] && sum="refused:${sum}"
        grep -qxF -- "${sum}" "${seen}" && continue
        echo "${sum}" >>"${seen}"
        user="$(id -nu "${auid}" 2>/dev/null || echo "${auid}")"
        if [[ "${ok}" == no ]]; then
            text="A program was kept from running where downloads and temporary files land: ${program}, as ${user}"
        else
            queue_hash "${sum}" "${exe}"
            text="A program ran for the first time from where downloads and temporary files land: ${program}, as ${user}"
        fi
        level=normal
        allowed exec-watch "${program}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] && add "${level}" exec-watch "${user}" Execution "${text}" "allow=${program}"
    done < <(audit_records exec-watch)
    tail -n "${EXEC_SEEN_KEPT}" "${seen}" >"${seen}.new" && mv "${seen}.new" "${seen}"
}

# --- AI agents run with their checks off -------------------------------------------------------------------

# An agent run with a flag from agent-cli-flags, as the audit rules on the folders it runs from record it
# (AGENT_CLIS, from the next boot): said when no terminal started it, which is how an npm install script ran
# one in the Nx attack, and recorded when one did, which is most likely its user. One line for each agent,
# flag and starter in a run, however often. Allowed by what started it, or by the agent itself.
read_agent_clis() {
    local time pid ppid auid tty exe path ok args flag parent user key level how subject
    local -a argv
    local -A count=() line=()
    while IFS=$'\x1f' read -r time pid ppid auid tty exe path ok args; do
        # An agent the system kept from running ran with nothing turned off
        [[ "${ok}" == no ]] && continue
        IFS=$'\x1e' read -ra argv <<<"${args}"
        agent_of "${exe}" "${argv[0]:-}" "${argv[1]:-}"
        [[ -n "${AGENT}" ]] || continue
        flag="$(printf '%s\n' "${argv[@]:1}" | agent_flag "${AGENT}" "")"
        [[ -n "${flag}" ]] || continue
        # What started it, while it is still there to ask
        parent=""
        [[ "${ppid}" =~ ^[0-9]+$ ]] && parent="$(readlink "/proc/${ppid}/exe" 2>/dev/null)"
        parent="${parent% (deleted)}"
        user="$(id -nu "${auid}" 2>/dev/null || echo "${auid}")"
        key="${AGENT}"$'\x1f'"${flag}"$'\x1f'"${parent:-${AGENT_PATH}}"$'\x1f'"${tty}"$'\x1f'"${user}"
        count["${key}"]=$((${count[${key}]:-0} + 1))
        line["${key}"]="${parent}"
    done < <(audit_records agent-clis)
    for key in "${!count[@]}"; do
        IFS=$'\x1f' read -r AGENT flag subject tty user <<<"${key}"
        parent="${line[${key}]}"
        level=normal how="with no terminal"
        [[ "${tty}" != "(none)" ]] && { level=quiet; how="at a terminal"; }
        allowed agent-clis "${subject}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] &&
            add "${level}" agent-clis "${user}" Execution "An AI agent ran with its own checks turned off: ${AGENT} ${flag}, started by ${parent:-a process that is gone} ${how}$([[ "${count[${key}]}" -gt 1 ]] && echo " (${count[${key}]} times)")" \
                "allow=${subject}"
    done
}

# --- Where secrets are kept --------------------------------------------------------------------------------

# Password stealers, and the npm and PyPI packages that carried one (Shai-Hulud, the Nx attack), read keys
# and tokens, send them out and exit: no signature, nothing left behind. The audit rules record each read of
# the files that hold them (CREDENTIALS, from the next boot). A program reading a file that is not its own is
# said, and one process reading two kinds of secret or more is critical: Shai-Hulud ran inside node, which
# reads ~/.npmrc as a matter of course, and it was its sweep over ~/.ssh and ~/.aws that gave it away. What
# reads is matched with the file in the allowlist ("PROGRAM FILE"), and an allowed read is not kept at all:
# browsers read their cookies all day. It records which programs read secrets, never what they read.
store_of() {
    case "$1" in
        */.ssh/*) STORE="SSH keys" ;;
        */.npmrc) STORE="npm's token" ;;
        */.pypirc) STORE="PyPI's token" ;;
        */.git-credentials) STORE="git's passwords" ;;
        */.config/gh/*) STORE="GitHub's token" ;;
        */.aws/*) STORE="AWS keys" ;;
        */.docker/*) STORE="container registry passwords" ;;
        */.kube/*) STORE="Kubernetes credentials" ;;
        */keyrings/*) STORE="the keyring" ;;
        */firefox/*) STORE="Firefox's passwords and cookies" ;;
        */Cookies) STORE="a browser's cookies" ;;
        */"Login Data" | */"Login Data For Account") STORE="a browser's passwords" ;;
        */.claude/* | */.codex/* | */.gemini/* | */opencode/* | */cursor/*) STORE="an AI agent's token" ;;
        *) STORE="the backup's password" ;;
    esac
}

read_credentials() {
    local time pid ppid auid tty exe path ok args user key what
    local -A said=() kinds=() who=()
    while IFS=$'\x1f' read -r time pid ppid auid tty exe path ok args; do
        [[ -n "${exe}" && "${path}" == /* ]] || continue
        allowed credentials "${exe} ${path}" && continue
        user="$(id -nu "${auid}" 2>/dev/null || echo "${auid}")"
        store_of "${path}"
        [[ "${kinds[${pid}]:-}" == *"|${STORE}|"* ]] || kinds["${pid}"]+="|${STORE}|"
        who["${pid}"]="${exe}"$'\x1f'"${user}"
        key="${exe}"$'\x1f'"${path}"
        [[ -z "${said[${key}]+set}" ]] || continue
        said["${key}"]=1
        [[ -n "${LAST_RUN}" ]] &&
            add normal credentials "${user}" "Credential Access" "${exe} read ${path} (${STORE}), as ${user}" \
                "allow=${exe} ${path}"
    done < <(audit_records credentials)
    for pid in "${!kinds[@]}"; do
        what="${kinds[${pid}]//||/, }"
        what="${what//|/}"
        [[ "${kinds[${pid}]}" == *"||"* && -n "${LAST_RUN}" ]] || continue
        IFS=$'\x1f' read -r exe user <<<"${who[${pid}]}"
        add critical credentials "${user}" "Credential Access" "One process read one kind of secret after another, as a password stealer does: ${exe} (process ${pid}, as ${user}) read ${what}" \
            "allow=${exe} *"
    done
}

# The decoy key (DECOY): nothing legitimate reads it, so any read but a backup's or a virus scan's is critical
read_decoy() {
    local time pid ppid auid tty exe path ok args user level
    local -A said=()
    while IFS=$'\x1f' read -r time pid ppid auid tty exe path ok args; do
        [[ -n "${exe}" && -z "${said[${exe}]+set}" ]] || continue
        said["${exe}"]=1
        user="$(id -nu "${auid}" 2>/dev/null || echo "${auid}")"
        level=critical
        allowed decoy "${exe}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] &&
            add "${level}" decoy "${user}" "Credential Access" "${exe} read the decoy key ${path} (process ${pid}, as ${user}). Nothing legitimate reads it: this is what a password stealer looks like" \
                "allow=${exe}"
    done < <(audit_records decoy)
}

# --- Reaching into another program's memory ------------------------------------------------------------------

# A program that attached to another, or read or wrote its memory (INJECTION, from the next boot): ptrace's
# attach and seize, process_vm_readv and process_vm_writev, pidfd_getfd and /proc/PID/mem opened. The file-watch
# sensor records each at the kernel's own permission check, with the program reached and both mount namespaces;
# the audit rules, where it does not run, record the calls alone, and the program reached is looked up while it
# still runs. A program's own business is recorded and not said: the same program, one in the same folder that
# is not a folder every program shares, or one in the same Flatpak or container that is not the host. So is what
# a debugger does (/usr/share/amethystora/debuggers). The rest is said: a write into another program (ATT&CK
# T1055), a read of its memory (T1003.007), and a try the kernel refused. One line for each program, program
# reached, kind and result in a run, however often. Allowed by the program that reached, alone or with the
# program it reached.
DEBUGGERS=/usr/share/amethystora/debuggers
SHARED_FOLDERS=" /usr/bin /usr/sbin /usr/libexec /usr/local/bin /home/linuxbrew/.linuxbrew/bin "

# Each event under the key, one line, its fields apart by the unit separator: time, process, login uid,
# terminal, program, system call, its first three arguments (hex), whether it succeeded, and what OBJ_PID and
# PATH item 0 say of the process reached: its pid, name, mount namespace, the acting task's, and its program
injection_records() {
    audit_since injection -m SYSCALL,OBJ_PID,PATH -k injection -r | awk '
        BEGIN { for (i = 0; i < 256; i++) byte[sprintf("%02X", i)] = sprintf("%c", i) }
        function value(record, name, text,   m, i, out) {
            if (match(record, " " name "=\"[^\"]*\"")) m = substr(record, RSTART + length(name) + 3, RLENGTH - length(name) - 4)
            else if (match(record, " " name "=[^ ]+")) {
                m = substr(record, RSTART + length(name) + 2, RLENGTH - length(name) - 2)
                if (text && m ~ /^([0-9A-F][0-9A-F])+$/) {
                    out = ""
                    for (i = 1; i < length(m); i += 2) out = out byte[substr(m, i, 2)]
                    m = out
                }
            } else return ""
            gsub(/[\000-\037\177]/, "?", m)
            return m
        }
        function flush() {
            if (event == "") return
            printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", time, pid, auid,
                tty, exe, sc, a0, a1, a2, ok, opid, ocomm, omnt, mnt, path
        }
        match($0, /msg=audit\([0-9]+\.[0-9]+:[0-9]+\)/) {
            id = substr($0, RSTART + 10, RLENGTH - 11)
            if (id != event) {
                flush()
                event = id
                time = int(id)
                pid = auid = tty = exe = sc = a0 = a1 = a2 = ok = opid = ocomm = omnt = mnt = path = ""
            }
            if ($0 ~ /^type=SYSCALL /) {
                pid = value($0, "pid", 0); auid = value($0, "auid", 0); tty = value($0, "tty", 0)
                exe = value($0, "exe", 1); sc = value($0, "syscall", 0); ok = value($0, "success", 0)
                a0 = value($0, "a0", 0); a1 = value($0, "a1", 0); a2 = value($0, "a2", 0)
            } else if ($0 ~ /^type=OBJ_PID /) {
                opid = value($0, "opid", 0); ocomm = value($0, "ocomm", 1)
                omnt = value($0, "omnt", 0); mnt = value($0, "mnt", 0)
            } else if ($0 ~ /^type=PATH / && value($0, "item", 0) == "0") {
                path = value($0, "name", 1)
            }
        }
        END { flush() }'
}

read_injection() {
    local time pid auid tty exe syscall a0 a1 a2 ok opid ocomm omnt mnt target how class flags own user key level
    local tactic text host_mnt reached
    local -A count=()
    host_mnt="$(stat -L -c %i /proc/1/ns/mnt 2>/dev/null)"
    while IFS=$'\x1f' read -r time pid auid tty exe syscall a0 a1 a2 ok opid ocomm omnt mnt target; do
        [[ -n "${exe}" && "${syscall}" =~ ^[0-9]+$ ]] || continue
        [[ "${a0}" =~ ^[0-9a-f]+$ ]] || a0=0
        [[ "${a1}" =~ ^[0-9a-f]+$ ]] || a1=0
        [[ "${a2}" =~ ^[0-9a-f]+$ ]] || a2=0
        # The process reached: the sensor names it, and the audit rules give its pid among the call's arguments
        if [[ ! "${opid}" =~ ^[0-9]+$ ]]; then
            opid=""
            case "${syscall}" in
                101) opid="$((16#${a1}))" ;;
                310 | 311) opid="$((16#${a0}))" ;;
            esac
        fi
        [[ -z "${target}" && "${opid:-0}" -gt 0 ]] && target="$(readlink "/proc/${opid}/exe" 2>/dev/null)"
        target="${target% (deleted)}"
        # What it did: ptrace's attach or seize, the two process_vm calls, pidfd_getfd, an open of /proc/PID/mem
        # by its flags (open's second argument, openat's third), and what shows no call, an io_uring open
        case "${syscall}" in
            101) how="attached to" class=write ;;
            310) how="read the memory of" class=read ;;
            311) how="wrote into the memory of" class=write ;;
            438) how="took a descriptor of" class=write ;;
            2 | 257)
                flags=$((16#$([[ "${syscall}" == 2 ]] && echo "${a1}" || echo "${a2}")))
                if ((flags & 3)); then how="opened for writing the memory of" class=write; else how="read the memory of" class=read; fi
                ;;
            *) how="reached into the memory of" class=write ;;
        esac
        reached="${target:-${ocomm:-a process}}${opid:+ (process ${opid})}"
        # Its own business: the same program, a neighbour in a folder of its own, the same sandbox
        own=false
        if [[ -n "${target}" ]]; then
            [[ "${target}" == "${exe}" ]] && own=true
            [[ "${target%/*}" == "${exe%/*}" && "${SHARED_FOLDERS}" != *" ${exe%/*} "* && "${exe%/*}" != */.local/bin ]] && own=true
        fi
        [[ "${mnt}" =~ ^[1-9][0-9]*$ && "${mnt}" == "${omnt}" && "${mnt}" != "${host_mnt}" ]] && own=true
        grep -qxF -- "${exe}" "${DEBUGGERS}" 2>/dev/null && own=true
        user="$(id -nu "${auid}" 2>/dev/null || echo "${auid}")"
        key="${exe}"$'\x1f'"${target}"$'\x1f'"${how}"$'\x1f'"${ok}"$'\x1f'"${user}"$'\x1f'"${own}"$'\x1f'"${class}"$'\x1f'"${reached}"
        count["${key}"]=$((${count[${key}]:-0} + 1))
    done < <(injection_records)
    for key in "${!count[@]}"; do
        IFS=$'\x1f' read -r exe target how ok user own class reached <<<"${key}"
        level=normal tactic="Defense Evasion"
        [[ "${own}" == true ]] && level=quiet
        if [[ "${ok}" == no ]]; then
            text="${exe} tried to reach into ${reached} and the kernel refused it, as ${user}"
        else
            [[ "${class}" == read ]] && tactic="Credential Access"
            text="${exe} ${how} ${reached}, as ${user}"
        fi
        [[ "${count[${key}]}" -gt 1 ]] && text+=" (${count[${key}]} times)"
        if allowed injection "${exe}" || { [[ -n "${target}" ]] && allowed injection "${exe} ${target}"; }; then
            level=quiet ALLOWED_HIT=1
        fi
        [[ -n "${LAST_RUN}" ]] && add "${level}" injection "${user}" "${tactic}" "${text}" "allow=${exe}${target:+ ${target}}"
    done
}

# --- Ransomware behaviour ----------------------------------------------------------------------------------

# Ransomware and wipers, whatever their family, rewrite or delete many files at once. After each hourly
# snapshot of the home folders (ransomware protection), what changed since the one before is listed from the
# snapshots' metadata alone (btrfs send --no-data), per account. When more than a few hundred files of one
# account changed, up to a hundred of them are sampled, the first 4 KiB of each in both snapshots: a file
# that went from readable to random is what encryption looks like, and files already compressed do not jump.
# A mass deletion is said the same way. Each finding names the snapshot to go back to, which the Events page
# opens in Backups. It reads the snapshots, never the live files, and the snapshots are read-only.
SNAPSHOTS="${ROOT}/var/home/.snapshots"
SNAPSHOT_NAME='^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$'
SNAPSHOT_MANY=300
SNAPSHOT_SAMPLE=100
BTRFS=btrfs
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_BTRFS:-}" ]] && BTRFS="${AMETHYSTORA_WATCH_BTRFS}"
# Already compressed or random by nature: they cannot jump
DENSE='\.(zip|gz|tgz|xz|zst|bz2|7z|rar|jpe?g|png|webp|gif|heic|avif|mp[34]|m4a|mkv|webm|ogg|opus|flac|pdf|docx|xlsx|pptx|odt|ods|odp|epub|jar|apk|deb|rpm|iso|gpg|age|kdbx)$'

# The entropy of the first 4 KiB of a file, in bits a byte, or nothing for one that is not a plain file
entropy() {
    [[ -f "$1" && ! -L "$1" ]] || return 0
    timeout 5 head -c 4096 -- "$1" 2>/dev/null | od -An -v -tu1 |
        awk '{ for (i = 1; i <= NF; i++) { count[$i]++; total++ } }
            END { if (total < 256) exit; for (b in count) { p = count[b] / total; e -= p * log(p) / log(2) }; printf "%.2f\n", e }'
}

# What changed between two snapshots: "account<US>changed<US>deleted" a line, then "account<US>path" for up to
# a hundred changed paths of each account. Paths come escaped (a space as "\ ", others as "\ooo"), and a file
# made under a temporary name (o<inode>-<gen>-<n>) gets its own when renamed.
snapshot_changes() {
    timeout 300 "${BTRFS}" send --no-data -q -p "${SNAPSHOTS}/$1" "${SNAPSHOTS}/$2" 2>/dev/null |
        timeout 300 "${BTRFS}" receive --dump 2>/dev/null | awk -v snap="$2" -v sample="${SNAPSHOT_SAMPLE}" '
        function unescape(path,   out, i, c) {
            out = ""
            for (i = 1; i <= length(path); i++) {
                c = substr(path, i, 1)
                if (c == "\\" && substr(path, i + 1, 3) ~ /^[0-7][0-7][0-7]$/) {
                    out = out sprintf("%c", (substr(path, i + 1, 1) * 64) + (substr(path, i + 2, 1) * 8) + substr(path, i + 3, 1)); i += 3
                } else if (c == "\\") { out = out substr(path, i + 1, 1); i++ }
                else out = out c
            }
            return out
        }
        # The operation, then the path padded to 32 columns, then key=value pairs, each path escaped
        {
            op = $1
            line = $0
            sub(/^[^ ]+ +/, "", line)
            match(line, /^(\\.|[^ \\])+/)
            path = unescape(substr(line, RSTART, RLENGTH))
            sub("^\\./" snap "/", "", path)
            dest = ""
            if (match(line, / dest=(\\.|[^ \\])+/)) { dest = unescape(substr(line, RSTART + 6, RLENGTH - 6)); sub("^\\./" snap "/", "", dest) }
            if (op == "rename") { if (path in written) { written[dest] = 1; delete written[path] }; next }
            if (op == "update_extent" || op == "truncate" || op == "write") written[path] = 1
            else if (op == "unlink") deleted[path] = 1
        }
        # Caches, build output and dependencies change by the thousand as a matter of course, and a temporary
        # name never renamed was a file made and gone within the hour
        function counts(p) {
            return p !~ /(^|\/)o[0-9]+-[0-9]+-[0-9]+$/ &&
                p !~ /\/(\.cache|[Cc]ache|node_modules|\.git|\.npm|\.cargo|\.rustup|target|build|dist|\.venv|venv|__pycache__|\.gradle|\.m2|go\/pkg|\.local\/share\/(containers|flatpak|Trash|Steam))\//
        }
        END {
            for (p in written) { if (!counts(p)) continue; gsub(/[\037\n]/, "?", p); split(p, part, "/"); changed[part[1]]++; if (shown[part[1]]++ < sample) list[part[1]] = list[part[1]] p "\n" }
            for (p in deleted) { if (!counts(p)) continue; split(p, part, "/"); gone[part[1]]++ }
            for (a in changed) seen[a] = 1
            for (a in gone) seen[a] = 1
            for (a in seen) printf "%s\037%d\037%d\n", a, changed[a], gone[a]
            for (a in list) { n = split(list[a], lines, "\n"); for (i = 1; i < n; i++) printf "%s\037%s\n", a, lines[i] }
        }'
}

read_snapshots() {
    local last="${STATE}/snapshot-last" previous name account changed deleted path old new jumped tried level user
    local -a names
    command -v "${BTRFS}" >/dev/null && [[ -d "${SNAPSHOTS}" ]] || return 0
    mapfile -t names < <(find "${SNAPSHOTS}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null |
        grep -E "${SNAPSHOT_NAME}" | sort)
    [[ ${#names[@]} -gt 0 ]] || return 0
    previous="$(cat "${last}" 2>/dev/null)"
    echo "${names[-1]}" >"${last}"
    # The first time, or after the one compared last was let go, only where things stand is kept
    [[ -n "${previous}" && -d "${SNAPSHOTS}/${previous}" ]] || return 0
    for name in "${names[@]}"; do
        [[ "${name}" > "${previous}" ]] || continue
        declare -A many=() samples=()
        while IFS=$'\x1f' read -r account changed deleted; do
            [[ -n "${deleted}" ]] || { samples["${account}"]+="${changed}"$'\n'; continue; }
            many["${account}"]="${changed} ${deleted}"
        done < <(snapshot_changes "${previous}" "${name}")
        for account in "${!many[@]}"; do
            read -r changed deleted <<<"${many[${account}]}"
            # A home is named after its account; one that is a link or odd is not an account's
            [[ "${account}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ ]] || continue
            user="${account}"
            if [[ "${changed}" -gt "${SNAPSHOT_MANY}" ]]; then
                jumped=0 tried=0
                while IFS= read -r path; do
                    [[ -n "${path}" && ! "${path,,}" =~ ${DENSE} ]] || continue
                    allowed snapshot-watch "/var/home/${path}" && continue
                    old="$(entropy "${SNAPSHOTS}/${previous}/${path}")"
                    new="$(entropy "${SNAPSHOTS}/${name}/${path}")"
                    [[ -n "${old}" && -n "${new}" ]] || continue
                    tried=$((tried + 1))
                    # From readable to random: below 6 bits a byte before, above 7.5 after
                    awk -v old="${old}" -v new="${new}" 'BEGIN { exit !(old < 6 && new > 7.5) }' && jumped=$((jumped + 1))
                done <<<"${samples[${account}]:-}"
                # Many files changed is a busy hour, recorded; a fifth of those looked at turned random is encryption
                if [[ "${tried}" -gt 0 && $((jumped * 5)) -ge "${tried}" ]]; then
                    add critical snapshot-watch "${user}" Impact "${changed} files in ${user}'s home folder changed within the hour before ${name}, and ${jumped} of the ${tried} looked at went from readable to random, which is what encryption by ransomware looks like. The snapshot ${previous} has them as they were: open it in Backups" \
                        "at=${previous}"
                else
                    add quiet snapshot-watch "${user}" Impact "${changed} files in ${user}'s home folder changed within the hour before ${name}; none of the ${tried} looked at turned random" \
                        "at=${previous}"
                fi
            fi
            if [[ "${deleted}" -gt "${SNAPSHOT_MANY}" ]]; then
                add critical snapshot-watch "${user}" Impact "${deleted} files were deleted from ${user}'s home folder within the hour before ${name}, as a wiper does. The snapshot ${previous} still has them: open it in Backups" \
                    "at=${previous}"
            fi
        done
        unset many samples
        previous="${name}"
    done
}

# --- SELinux's denials ----------------------------------------------------------------------------------

# A confined service doing what its policy never let it is often what an exploit looks like from outside.
# Each different denial (source type, target type, class, permissions and program) is said the first time;
# one SELinux let through in permissive mode is only recorded. Read from the audit log, so only while it is on.
SELINUX_SEEN_KEPT=5000
# One "permissive<US>source<US>target<US>class<US>permissions<US>program" line for each denial
selinux_denials() {
    audit_since selinux -m AVC,USER_AVC -r | awk '
        BEGIN { for (i = 0; i < 256; i++) byte[sprintf("%02X", i)] = sprintf("%c", i) }
        # A value the kernel quoted, or wrote in hex because it holds a space, a quote or a control character
        function field(name,   m, out, i) {
            if (match($0, " " name "=\"[^\"]*\"")) return substr($0, RSTART + length(name) + 3, RLENGTH - length(name) - 4)
            if (!match($0, " " name "=[^ \x27]+")) return ""
            m = substr($0, RSTART + length(name) + 2, RLENGTH - length(name) - 2)
            if (m !~ /^([0-9A-F][0-9A-F])+$/ || name !~ /^(comm|exe|name)$/) return m
            out = ""
            for (i = 1; i < length(m); i += 2) out = out byte[substr(m, i, 2)]
            return out
        }
        function type_of(context,   part) { split(context, part, ":"); return part[3] }
        /avc: +denied/ {
            perms = ""
            if (match($0, /\{ [^}]* \}/)) { perms = substr($0, RSTART + 2, RLENGTH - 4); gsub(/ +/, ",", perms) }
            program = field("comm")
            if (program == "") program = field("exe")
            # A process names itself: only plain characters of it are kept
            gsub(/[^A-Za-z0-9._\/+-]/, "?", program)
            printf "%s\037%s\037%s\037%s\037%s\037%s\n", field("permissive"), type_of(field("scontext")),
                type_of(field("tcontext")), field("tclass"), perms, program
        }' | sort -u
}

read_selinux() {
    local seen="${STATE}/selinux-seen" permissive source target class perms program key level
    touch "${seen}"
    while IFS=$'\x1f' read -r permissive source target class perms program; do
        [[ "${source}" =~ ^[a-z0-9_]+$ && "${target}" =~ ^[a-z0-9_]+$ && "${class}" =~ ^[a-z0-9_]+$ &&
            "${perms}" =~ ^[a-z0-9_,]+$ ]] || continue
        key="${source} ${target} ${class} ${perms} ${program}"
        grep -qxF -- "${key}" "${seen}" && continue
        echo "${key}" >>"${seen}"
        level=normal
        [[ "${permissive}" == 1 ]] && level=quiet
        allowed selinux-denials "${source} ${target} ${class} ${perms}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] &&
            add "${level}" selinux-denials - Execution "SELinux kept ${program:-a program} (${source}) from ${perms//,/, } on a ${class} of type ${target}$([[ "${permissive}" == 1 ]] && echo ", and let it through: that domain is permissive")" \
                "allow=${source} ${target} ${class} ${perms}"
    done < <(selinux_denials)
    tail -n "${SELINUX_SEEN_KEPT}" "${seen}" >"${seen}.new" && mv "${seen}.new" "${seen}"
}

# --- What runs ------------------------------------------------------------------------------------------

# Malware that leaves no file, or runs from where downloads land, is seen running before it is seen
# anywhere else. Each run reads every process's program and command line, and for a few the environment:
#   - a program whose file was deleted, or that lives in memory alone (memfd)
#   - a program in a temporary folder, ~/.cache or the download folder
#   - a process named like a kernel thread, [kworker/0:1], that runs a program: kernel threads have none
#   - a network tool, an AI agent or a secret scanner started by an npm package's install script
#   - an AI agent running with its own checks turned off (agent-cli-flags)
#   - a library from outside /usr loaded into a program by LD_PRELOAD or LD_AUDIT, which is how malware gets
#     inside the program a password is typed into without changing its file
#   - a session whose own environment has every program it starts load code from outside /usr
# Each is said the first time for that program, by the SHA-256 of what runs, never of the path it claims.
# Processes in a container or a sandbox of their own see other files under the same paths, so there only
# the two that need no path count: a disguised thread and memory alone. What a process says of itself, its
# name, command line and environment, is matched as plain text, and never used as a path or a pattern.
# /proc is read in a few passes, each bounded in time: a process can keep a read of its own command line
# waiting, and must not keep the watcher waiting with it.
AGENT_FLAGS=/usr/share/amethystora/agent-cli-flags
CODE_VARIABLES=/usr/share/amethystora/code-variables
NETWORK_TOOLS=" curl wget nc ncat netcat socat ssh scp sftp rsync "
SECRET_SCANNERS=" trufflehog gitleaks detect-secrets noseyparker "

# Which agent a process is, into AGENT, from its program and its first two arguments: the command, or the
# script node or bash runs; and AGENT_PATH, the path that said so. Set rather than printed: it is asked of
# every process, and a subshell each would cost.
agent_of() {
    local exe="$1" first="$2" second="$3" name
    AGENT="" AGENT_PATH=""
    for name in "${first}" "${second}"; do
        case "${name##*/}" in
            claude | codex | copilot | opencode | cursor-agent) AGENT="${name##*/}" ;;
            gemini | gemini.js) AGENT=gemini ;;
            # Antigravity CLI keeps the copy it updated from as agy.N.old
            agy | agy.*.old) AGENT=agy ;;
            *) continue ;;
        esac
        # A command found in PATH names no folder: then the program is the agent
        AGENT_PATH="${name}"
        [[ "${name}" == /* ]] || AGENT_PATH="${exe}"
        return
    done
    if [[ "${exe}" == */cursor-agent/versions/* ]]; then
        AGENT=cursor-agent AGENT_PATH="${exe}"
    elif [[ "${second}" == */cursor-agent/* ]]; then
        AGENT=cursor-agent AGENT_PATH="${second}"
    elif [[ "${second}" == */gemini-cli/* ]]; then
        AGENT=gemini AGENT_PATH="${second}"
    fi
}

# The first of AGENT's flags that the arguments (one a line on stdin) or the environment (one variable a
# line) carry. An option's value is matched whether it was given as "--option value" or "--option=value".
agent_flag() {
    local agent="$1" environment="$2" args name flag variable glob entry
    args=" $(sed -E 's/^(--[a-z-]+)=/\1 /' | tr '\n' ' ') "
    while IFS=$'\t' read -r name flag; do
        [[ "${name}" == "${agent}" ]] || continue
        if [[ "${flag}" == env:*=* ]]; then
            variable="${flag#env:}"
            glob="${variable#*=}"
            variable="${variable%%=*}"
            while IFS= read -r entry; do
                # shellcheck disable=SC2053 # the glob is the image's own, from agent-cli-flags
                [[ "${entry%%=*}" == "${variable}" && "${entry#*=}" == ${glob} ]] && { echo "${variable}"; return; }
            done <<<"${environment}"
        elif [[ "${args}" == *" ${flag} "* ]]; then
            echo "${flag}"
            return
        fi
    done < <(grep -v '^#' "${AGENT_FLAGS}" 2>/dev/null)
}

# Under /usr, which only an update writes: not a path that climbs out of it again
under_usr() { [[ ( "$1" == /usr || "$1" == /usr/* ) && "$1" != *..* ]]; }

# The first library LD_PRELOAD or LD_AUDIT loads into a process from outside /usr, into LIBRARY, from what of its
# environment was read (the variables apart by the unit separator); empty when each one is under /usr. ld.so
# expands /usr/$LIB/... under /usr. A bare name is looked for in LD_LIBRARY_PATH first, so it counts only when
# that names a folder outside /usr, an empty part of it being the working folder. A relative path is the
# process's working folder's. Set rather than printed, as agent_of is.
preloaded_outside() {
    local pid="$1" variable value entry dir=""
    local -a variables entries
    LIBRARY=""
    IFS=$'\x1f' read -ra variables <<<"$2"
    for variable in "${variables[@]}"; do
        [[ "${variable}" == LD_LIBRARY_PATH=?* ]] || continue
        value="${variable#*=}"
        value="${value//;/:}"
        IFS=: read -ra entries <<<"${value}"
        [[ ":${value}:" == *::* ]] && entries+=("")
        for entry in "${entries[@]}"; do
            under_usr "${entry}" && continue
            dir="${entry:-.}"
            break
        done
    done
    for variable in "${variables[@]}"; do
        [[ "${variable}" == LD_PRELOAD=?* || "${variable}" == LD_AUDIT=?* ]] || continue
        # Spaces or colons between libraries, as ld.so reads them
        value="${variable#*=}"
        IFS=: read -ra entries <<<"${value// /:}"
        for entry in "${entries[@]}"; do
            [[ -n "${entry}" ]] || continue
            if [[ "${entry}" == */* ]]; then
                under_usr "${entry}" && continue
                LIBRARY="${entry}"
            elif [[ -n "${dir}" ]]; then
                LIBRARY="${dir%/}/${entry}"
            else
                continue
            fi
            [[ "${LIBRARY}" == /* ]] || LIBRARY="$(readlink "/proc/${pid}/cwd" 2>/dev/null)/${LIBRARY#./}"
            return
        done
    done
}

# The first path a value of one of the code variables names outside /usr: path lists and options alike, apart
# by colons, semicolons, commas, equals signs and spaces (-javaagent:/x.jar, --require=/x.js)
path_outside() {
    local part
    local -a parts
    IFS=$' \t:;,=' read -ra parts <<<"$1"
    for part in "${parts[@]}"; do
        part="${part#\$\'}"
        part="${part%\'}"
        [[ "${part}" == /* || "${part}" == "~"* ]] || continue
        under_usr "${part}" && continue
        echo "${part}"
        return 0
    done
    return 1
}

read_processes() {
    local seen="${STATE}/processes-seen" first=false pid target exe host_ns uid user name what level tactic sum
    local reason event agent flag environment tty how home dir line subject ppid hashed variable path logged
    local -a argv writable=(/tmp/ /var/tmp/ /dev/shm/)
    local -A program=() owner=() namespace=() command=() preload=() code=()
    [[ -e "${seen}" ]] || first=true
    touch "${seen}"
    # Each home's cache and download folders; the download folder's name follows the session's language
    while IFS=: read -r _ _ uid _ _ home _; do
        [[ "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue
        writable+=("${home}/.cache/" "${home}/Downloads/")
        dir="${home}/.config/user-dirs.dirs"
        if [[ -f "${dir}" && ! -L "${dir}" ]]; then
            dir="$(timeout 5 head -c 8192 -- "${dir}" | sed -n 's/^XDG_DOWNLOAD_DIR="\$HOME\/\([^"]*\)"$/\1/p' | head -n1)"
            [[ -n "${dir}" && "${dir}" != *..* ]] && writable+=("${home}/${dir%/}/")
        fi
    done < <(accounts)
    # Each process's program (none for a kernel thread), its owner and its mount namespace
    while IFS=$'\t' read -r pid target; do
        program["${pid}"]="${target}"
    done < <(timeout 20 find /proc -mindepth 2 -maxdepth 2 -regex '/proc/[0-9]+/exe' -printf '%h\t%l\n' 2>/dev/null |
        sed 's#^/proc/##')
    while read -r pid uid; do
        owner["${pid}"]="${uid}"
    done < <(timeout 20 find /proc -mindepth 1 -maxdepth 1 -regex '/proc/[0-9]+' -printf '%f %U\n' 2>/dev/null)
    while IFS=$'\t' read -r pid target; do
        namespace["${pid%/ns}"]="${target}"
    done < <(timeout 20 find /proc -mindepth 3 -maxdepth 3 -regex '/proc/[0-9]+/ns/mnt' -printf '%h\t%l\n' 2>/dev/null |
        sed 's#^/proc/##')
    # ...and its command line, the arguments apart by the unit separator, each newline in one a space
    while IFS= read -r line; do
        command["${line%%$'\x1f'*}"]="${line#*$'\x1f'}"
    done < <(timeout 20 gawk 'BEGIN { RS = "\0" }
        BEGINFILE { if (ERRNO != "") nextfile; if (pid != "") print pid "\037" out; split(FILENAME, part, "/"); pid = part[3]; out = "" }
        { gsub(/[\n\037]/, " "); out = out (out == "" ? "" : "\037") $0 }
        END { if (pid != "") print pid "\037" out }' /proc/[0-9]*/cmdline 2>/dev/null)
    # ...and what of its environment loads libraries into it, for the processes that set LD_PRELOAD or LD_AUDIT:
    # those two and LD_LIBRARY_PATH, apart by the unit separator, from no more than the first 64 KiB of each
    while IFS= read -r line; do
        preload["${line%%$'\x1f'*}"]="${line#*$'\x1f'}"
    done < <(timeout 20 gawk 'BEGIN { RS = "\0" }
        function flush() { if (pid != "" && loads) print pid "\037" out }
        BEGINFILE { flush(); pid = out = ""; loads = size = 0; if (ERRNO != "") nextfile; split(FILENAME, part, "/"); pid = part[3] }
        { size += length($0) + 1; if (size > 65536) nextfile }
        /^LD_(PRELOAD|AUDIT|LIBRARY_PATH)=/ {
            gsub(/[\n\037]/, " ")
            out = out (out == "" ? "" : "\037") $0
            if (/^LD_(PRELOAD|AUDIT)=./) loads = 1
        }
        END { flush() }' /proc/[0-9]*/environ 2>/dev/null)
    host_ns="${namespace[1]:-}"
    for pid in "${!program[@]}"; do
        target="${program[${pid}]}"
        exe="${target% (deleted)}"
        IFS=$'\x1f' read -ra argv <<<"${command[${pid}]:-}"
        reason="" what="" level=normal tactic=Execution subject="${exe}"
        if [[ "${argv[0]:-}" == "["* && ${#argv[@]} -eq 1 ]]; then
            reason=kthread level=critical tactic="Defense Evasion"
            what="A process names itself like a kernel thread, ${argv[0]}, but runs a program, ${exe}"
        elif [[ "${exe}" == /memfd:* ]]; then
            reason=memfd
            what="A program runs from memory alone, with no file: ${exe}"
        elif [[ "${namespace[${pid}]:-}" == "${host_ns}" && "${target}" == *" (deleted)" ]]; then
            reason=deleted
            what="A program runs from a file that was deleted since: ${exe}"
        elif [[ "${namespace[${pid}]:-}" == "${host_ns}" ]]; then
            for dir in "${writable[@]}"; do
                [[ "${exe}" == "${dir}"* ]] || continue
                reason=writable
                what="A program runs from a folder where downloads and temporary files land: ${exe}"
                break
            done
        fi
        if [[ -z "${reason}" && -n "${preload[${pid}]:-}" && "${namespace[${pid}]:-}" == "${host_ns}" ]]; then
            preloaded_outside "${pid}" "${preload[${pid}]}"
            if [[ -n "${LIBRARY}" ]]; then
                reason="preload:${LIBRARY}" tactic="Defense Evasion" subject="${LIBRARY}"
                what="A library from outside the system is loaded into ${exe}: ${LIBRARY}"
            fi
        fi
        name="${argv[0]:-}"
        name="${name##*/}"
        agent_of "${exe}" "${argv[0]:-}" "${argv[1]:-}"
        agent="${AGENT}"
        # The environment, read only for what it can tell about: an agent, a network tool, a secret scanner
        environment=""
        if [[ -n "${agent}" || "${NETWORK_TOOLS}${SECRET_SCANNERS}" == *" ${name} "* ]]; then
            environment="$(timeout 2 head -c 65536 "/proc/${pid}/environ" 2>/dev/null | tr '\0' '\n')"
        fi
        event=""
        [[ -z "${reason}" && "${environment}" == *npm_lifecycle_event=* ]] &&
            event="$(sed -n 's/^npm_lifecycle_event=//p' <<<"${environment}" | head -n1)"
        if [[ -n "${event}" ]]; then
            reason="npm:${agent:-${name}}"
            what="An npm package's ${event//[^A-Za-z0-9:_-]/?} script started ${agent:-${name}}: ${exe}"
        fi
        if [[ -z "${reason}" && -n "${agent}" ]]; then
            flag="$(printf '%s\n' "${argv[@]:1}" | agent_flag "${agent}" "${environment}")"
            if [[ -n "${flag}" ]]; then
                reason="agent:${agent}:${flag// /=}"
                # Started at a terminal, it is most likely the person typing it: recorded, not said
                # stat's second field is the process's name in parentheses, which may hold spaces: the
                # parent is the second field after it, and the terminal the fifth
                tty="$(cat "/proc/${pid}/stat" 2>/dev/null)"
                read -r _ ppid _ _ tty _ <<<"${tty##*) }"
                # Copilot starts a detached session of its own with --yolo: itself starting itself
                [[ "${agent}" == copilot && -n "${program[${ppid:-0}]:-}" && "${program[${ppid}]}" == "${target}" ]] && continue
                how=", started without a terminal"
                [[ "${tty}" =~ ^[1-9][0-9]*$ ]] && { level=quiet; how=", at a terminal"; }
                # The agent itself, not the node or bash it may run in: allowing that would allow everything
                [[ "${AGENT_PATH}" == /* ]] && subject="${AGENT_PATH}"
                what="An AI agent runs with its own checks turned off: ${agent} ${flag} (${subject})${how}"
            fi
        fi
        [[ -n "${reason}" ]] || continue
        # What runs, not what it claims to be: the file behind the process, there even when deleted. For a
        # library, the library, whichever programs load it, read as a plain file and never through a link.
        if [[ "${reason}" == preload:* ]]; then
            hashed="${subject}" sum="gone"
            [[ -f "${subject}" && ! -L "${subject}" ]] &&
                sum="$(timeout 10 head -c 104857600 -- "${subject}" 2>/dev/null | sha256sum | cut -d' ' -f1)"
        else
            hashed="${exe}"
            sum="$(timeout 10 head -c 104857600 "/proc/${pid}/exe" 2>/dev/null | sha256sum | cut -d' ' -f1)"
        fi
        grep -qxF -- "${reason} ${sum}" "${seen}" && continue
        echo "${reason} ${sum}" >>"${seen}"
        queue_hash "${sum}" "${hashed}"
        [[ "${first}" == false && -n "${LAST_RUN}" ]] || continue
        uid="${owner[${pid}]:-}"
        user="$(id -nu "${uid}" 2>/dev/null || echo "${uid:--}")"
        allowed processes "${subject}" && { level=quiet; ALLOWED_HIT=1; }
        add "${level}" processes "${user}" "${tactic}" "${what} (process ${pid}, as ${user})" "allow=${subject}"
    done
    # A session's own environment, which every program it starts from then on is given: what `systemctl --user
    # set-environment` and dbus-update-activation-environment leave, and no file shows. Asked of the user manager
    # of each account logged in now; each variable and value said once.
    while IFS= read -r variable; do
        code["${variable}"]=1
    done < <(grep -v '^#' "${CODE_VARIABLES}" 2>/dev/null)
    logged=" $(logged_in | tr '\n' ' ') "
    while IFS=: read -r user _ uid _; do
        [[ "${uid}" =~ ^[0-9]+$ && "${logged}" == *" ${uid} "* && "${user}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || continue
        while IFS= read -r line; do
            variable="${line%%=*}"
            [[ "${variable}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n "${code[${variable}]:-}" ]] &&
                path="$(path_outside "${line#*=}")" || continue
            sum="$(sha256sum <<<"${line}" | cut -c1-16)"
            grep -qxF -- "session:${user}:${variable} ${sum}" "${seen}" && continue
            echo "session:${user}:${variable} ${sum}" >>"${seen}"
            [[ "${first}" == false && -n "${LAST_RUN}" ]] || continue
            level=normal
            allowed processes "${variable} ${path}" && { level=quiet; ALLOWED_HIT=1; }
            add "${level}" processes "${user}" Persistence "Every program started in ${user}'s session now loads ${path} (${variable})" \
                "allow=${variable} ${path}"
        done < <(timeout 10 "${SYSTEMCTL}" --user -M "${user}@.host" show-environment 2>/dev/null)
    done < <(accounts)
}

# --- Programs in the kernel's BPF -------------------------------------------------------------------------

# eBPF rootkits (LinkPro, October 2025) load programs into the kernel that hide files, processes and
# connections, and integrity lockdown allows them. systemd and the firewall load a stable set. A program new
# since the last run is recorded; one loaded by a program outside /usr, or of a kind that watches or changes
# what the kernel does (probes, tracepoints, LSM hooks, packet filters) with no process left holding it, is
# said. A rootkit that hides its own programs from bpftool defeats this; most do not. With a stand-in root,
# AMETHYSTORA_WATCH_BPFTOOL names a stand-in for bpftool.
BPFTOOL=bpftool
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_BPFTOOL:-}" ]] && BPFTOOL="${AMETHYSTORA_WATCH_BPFTOOL}"
BPF_SEEN_KEPT=2000
BPF_HOOKS=" kprobe tracepoint raw_tracepoint raw_tracepoint_writable tracing lsm perf_event xdp sched_cls sched_act socket_filter sk_msg sk_skb "

read_bpf() {
    local seen="${STATE}/bpf-seen" first=false type name tag pids comm key pid loader level by
    [[ -e "${seen}" ]] || first=true
    touch "${seen}"
    command -v "${BPFTOOL}" >/dev/null || return 0
    while IFS=$'\x1f' read -r type name tag pids comm; do
        [[ "${type}" =~ ^[a-z_]+$ && "${tag}" =~ ^[0-9a-f]+$ ]] || continue
        # A program's name is the loader's choice: only plain characters of it count
        name="${name//[^A-Za-z0-9_.]/?}"
        key="${type} ${name:-unnamed} ${tag}"
        grep -qxF -- "${key}" "${seen}" && continue
        echo "${key}" >>"${seen}"
        [[ "${first}" == false && -n "${LAST_RUN}" ]] || continue
        loader=""
        for pid in ${pids//,/ }; do
            [[ "${pid}" =~ ^[0-9]+$ ]] && loader="$(readlink "/proc/${pid}/exe" 2>/dev/null)" && break
        done
        level=quiet
        if [[ -n "${loader}" ]]; then
            by="by ${loader}"
            [[ "${loader}" == /usr/* ]] || level=normal
        else
            by="by ${comm:+${comm//[^A-Za-z0-9_.\/+-]/?}, }a process that is gone"
            [[ "${BPF_HOOKS}" == *" ${type} "* ]] && level=normal
        fi
        allowed bpf-programs "${name:-unnamed} ${loader:-unknown}" && { level=quiet; ALLOWED_HIT=1; }
        add "${level}" bpf-programs - "Defense Evasion" \
            "A program was loaded into the kernel: ${name:-with no name} (${type}, tag ${tag}), ${by}" \
            "allow=${name:-unnamed} ${loader:-unknown}"
    done < <(timeout 20 "${BPFTOOL}" prog list --json 2>/dev/null | jq -r '.[]
        | [.type, (.name // ""), .tag, ((.pids // []) | map(.pid | tostring) | join(",")), ((.pids // [])[0].comm // "")]
        | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' 2>/dev/null)
    tail -n "${BPF_SEEN_KEPT}" "${seen}" >"${seen}.new" && mv "${seen}.new" "${seen}"
}

# --- The journal --------------------------------------------------------------------------------------

read_journal() {
    local cursor="${STATE}/journal.cursor" line user
    local -A locked=() wrong=()
    local polkit=0 usb=0
    if [[ ! -s "${cursor}" ]]; then
        journalctl -q -n1 --cursor-file="${cursor}" >/dev/null 2>&1
        chmod 0600 "${cursor}" 2>/dev/null
        return
    fi
    # auth and authpriv (sudo, and pam_faillock in whichever program asked for the password), polkitd,
    # and the kernel (USB devices refused)
    while IFS= read -r line; do
        if [[ "${line}" =~ pam_faillock\(([^:\)]+)[^\)]*\):\ Consecutive\ login\ failures\ for\ user\ ([^ ]+) ]]; then
            locked["${BASH_REMATCH[2]}"]="${BASH_REMATCH[1]}"
        elif [[ "${line}" =~ sudo\[[0-9]+\]:\ +([^ ]+)\ :\ ([0-9]+)\ incorrect\ password\ attempt ]]; then
            user="${BASH_REMATCH[1]}"
            wrong["${user}"]=$((${wrong[${user}]:-0} + BASH_REMATCH[2]))
        elif [[ "${line}" == *"FAILED to authenticate to gain authorization"* ]]; then
            polkit=$((polkit + 1))
        elif [[ "${line}" == *"Device is not authorized for usage"* ]]; then
            usb=$((usb + 1))
        fi
    done < <(journalctl -q --no-pager -o short-iso --cursor-file="${cursor}" \
        SYSLOG_FACILITY=4 SYSLOG_FACILITY=10 + SYSLOG_IDENTIFIER=polkitd + _TRANSPORT=kernel 2>/dev/null)

    for user in "${!locked[@]}"; do
        # The name is whatever was typed at a login prompt, an SSH one included, and anyone can write such a
        # line to the journal: a command to paste is offered only for a name that is nothing but a name
        if [[ "${user}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ ]]; then
            add critical journal "${user}" "Credential Access" "The account ${user} was locked after too many wrong passwords in a row (${locked[${user}]}). Unlock it early with: sudo faillock --user ${user} --reset"
        else
            add critical journal - "Credential Access" "An account was locked after too many wrong passwords in a row (${locked[${user}]}), under a name no account here could have: ${user}"
        fi
    done
    for user in "${!wrong[@]}"; do
        [[ "${wrong[${user}]}" -ge 3 ]] && level=normal || level=quiet
        add "${level}" journal "${user}" "Credential Access" "${wrong[${user}]} wrong password(s) for sudo, as ${user}"
    done
    [[ "${polkit}" -ge 3 ]] && add normal journal - "Credential Access" "${polkit} administrator password prompts were answered wrongly"
    [[ "${usb}" -gt 0 ]] && add normal journal - "Initial Access" "USB protection blocked ${usb} USB device(s). Allow one with: ame security usb allow"
}

# --- /etc against the image ---------------------------------------------------------------------------

# Where the settings that decide this machine's security live. ostree keeps /etc as the image shipped it
# in /usr/etc, so what differs is exactly what changed on this machine.
DRIFT_PATHS=(amethystora audit authselect brave/policies chromium/policies clamd.d containers/policy.json
    containers/registries.d containers/systemd environment fail2ban firefox/policies firewalld
    flatpak/overrides ld.so.conf ld.so.conf.d opt/chrome/policies opt/edge/policies
    ld.so.preload modprobe.d modules-load.d pam.d pki/akmods/certs pki/ca-trust/source pki/containers
    polkit-1/rules.d profile profile.d rc.d/rc.local security ssh/sshd_config ssh/sshd_config.d sudoers
    sudoers.d sysctl.conf sysctl.d tmpfiles.d udev/rules.d usbguard xdg/autostart)
# ...less what the image's own recipes and services write there as a matter of course
EXPECTED_DRIFT=" amethystora/security.conf amethystora/agent.conf amethystora/ips-allowed amethystora/browser-extensions \
amethystora/hardening-off amethystora/hardening-on amethystora/firewall-home amethystora/vscodium-extensions \
amethystora/abusech.key \
audit/audit.rules audit/audit.rules.prev audit/rules.d/60-amethystora.rules audit/rules.d/61-amethystora-home.rules \
brave/policies/managed/10-amethystora.json chromium/policies/managed/10-amethystora.json \
firefox/policies/policies.json modprobe.d/tuned.conf opt/chrome/policies/managed/10-amethystora.json \
opt/edge/policies/managed/10-amethystora.json security/opasswd usbguard/rules.conf \
usbguard/usbguard-daemon.conf "
# A file in /etc takes the place of the one of the same name in /usr/lib entirely
SHADOWED=(sysctl.d:/usr/lib/sysctl.d modprobe.d:/usr/lib/modprobe.d modules-load.d:/usr/lib/modules-load.d
    tmpfiles.d:/usr/lib/tmpfiles.d udev/rules.d:/usr/lib/udev/rules.d firewalld/zones:/usr/lib/firewalld/zones
    polkit-1/rules.d:/usr/share/polkit-1/rules.d systemd/system:/usr/lib/systemd/system)
# ...and for systemd, only the units the security of the machine rests on
SECURITY_UNITS='^(auditd|fail2ban|firewalld|clamd@.*|clamav-.*|amethystora-.*|uupd.*|usbguard|rpm-ostreed.*|bootc-.*|polkit|systemd-journald)\.(service|timer|socket)$'

# One "change<TAB>path<TAB>detail" a line: added, changed, removed, replaces, overrides or masks
drift() {
    local pair dir lib etc name rel usr unit kind domain=false duress=false
    local -A shadows=() masks=() files=()
    # A machine that joined a domain has authselect's sssd or winbind profile with every feature of the
    # image's, which realmd set through amethystora-domain-logins, and pam_winbind's settings realmd
    # writes. That is the image's setup for a domain: a feature turned off, or a file edited by hand, is not.
    /usr/libexec/amethystora-domain-logins check && domain=true
    # The duress finger's feature added last to the image's own, every file as authselect wrote it
    /usr/libexec/amethystora-duress authselect && duress=true
    # What the owner turned off with the prevention switches (ame security kernel, firewall, lockout...):
    # exactly the files the switch writes, which amethystora-hardening names, and nothing in between
    while IFS=$'\t' read -r rel kind; do
        [[ "${kind}" == mask ]] && masks["${rel}"]=1
        [[ "${kind}" == file ]] && files["${rel}"]=1
    done < <(/usr/libexec/amethystora-hardening managed 2>/dev/null)
    for pair in "${SHADOWED[@]}"; do
        dir="/etc/${pair%%:*}"
        lib="${pair#*:}"
        for etc in "${dir}"/*; do
            name="${etc##*/}"
            [[ -e "${lib}/${name}" && ! ( -d "${etc}" && ! -L "${etc}" ) ]] || continue
            [[ "${pair}" == systemd/system:* && ! "${name}" =~ ${SECURITY_UNITS} ]] && continue
            # What the image itself ships there is its own choice
            [[ -e "/usr/etc/${etc#/etc/}" ]] && cmp -s "${etc}" "/usr/etc/${etc#/etc/}" && continue
            if [[ -n "${masks[${etc#/etc/}]+set}" && "$(readlink "${etc}")" == /dev/null ]]; then
                shadows["${etc}"]=1
                continue
            fi
            if [[ "$(readlink "${etc}")" == /dev/null ]]; then
                printf 'masks\t%s\t%s\n' "${etc}" "${name}"
            else
                printf 'replaces\t%s\t%s\n' "${etc}" "${lib}/${name}"
            fi
            shadows["${etc}"]=1
        done
    done
    # Drop-ins change a unit without replacing it: `systemctl edit auditd` is one
    for etc in /etc/systemd/system/*.d/*.conf; do
        [[ -e "${etc}" ]] || continue
        unit="$(basename "$(dirname "${etc}")")"
        unit="${unit%.d}"
        [[ "${unit}" =~ ${SECURITY_UNITS} ]] || continue
        [[ -e "/usr/etc/${etc#/etc/}" ]] && cmp -s "${etc}" "/usr/etc/${etc#/etc/}" && continue
        printf 'overrides\t%s\t%s\n' "${etc}" "${unit}"
    done

    for rel in "${DRIFT_PATHS[@]}"; do
        find "/etc/${rel}" "/usr/etc/${rel}" \( -type f -o -type l \) 2>/dev/null
    done | sed 's#^/usr/etc/#/etc/#' | sort -u | while IFS= read -r etc; do
        rel="${etc#/etc/}"
        usr="/usr/etc/${rel}"
        [[ "${EXPECTED_DRIFT}" == *" ${rel} "* || -n "${shadows[${etc}]+set}" ]] && continue
        # The allowlists the owner adds to through amethystora-security-allow, which notes each change
        [[ "${rel}" == amethystora/allow.d/* ]] && continue
        [[ "${domain}" == true && ( "${rel}" =~ ^authselect/[^/]+$ || "${rel}" == security/pam_winbind.conf ) ]] &&
            continue
        [[ "${duress}" == true && "${rel}" =~ ^authselect/[^/]+$ ]] && continue
        # The duress finger's own folder, whose sums duress_status checks: a line here would name the files
        # in it to everyone who reads the report
        [[ "${rel}" == amethystora/duress.d/* ]] && continue
        # One-time codes for SSH exactly as amethystora-ssh-codes sets them, and nothing in between
        [[ "${rel}" == pam.d/sshd && -f "${usr}" ]] &&
            cmp -s "${etc}" <(/usr/libexec/amethystora-ssh-codes pam <"${usr}") && continue
        [[ "${rel}" == ssh/sshd_config.d/30-amethystora-ssh-codes.conf ]] &&
            cmp -s "${etc}" "/usr/share/amethystora/ssh-codes/${rel##*/}" && continue
        [[ -n "${files[${rel}]+set}" ]] &&
            cmp -s "${etc}" <(/usr/libexec/amethystora-hardening expected "${rel}") && continue
        if [[ ! -e "${usr}" && ! -L "${usr}" ]]; then
            printf 'added\t%s\t\n' "${etc}"
        elif [[ ! -e "${etc}" && ! -L "${etc}" ]]; then
            printf 'removed\t%s\t\n' "${etc}"
        elif [[ -L "${etc}" || -L "${usr}" ]]; then
            [[ "$(readlink "${etc}")" == "$(readlink "${usr}")" ]] || printf 'changed\t%s\t\n' "${etc}"
        elif ! cmp -s "${etc}" "${usr}"; then
            printf 'changed\t%s\t\n' "${etc}"
        fi
    done
}

# --- setuid programs outside the image ----------------------------------------------------------------

# /usr is the image's, and every setuid program the image has is there. One anywhere else was put there
# on this machine. Container storage is left out: it holds other distributions' sudo and su, which only
# ever run inside their containers.
# Bounded inside the unit's ten minutes: a home of millions of files must not keep every run from
# finishing. A sweep cut short keeps what it found, and the next is a day later, as for any other.
sweep_setuid() {
    timeout 420 find /etc /var -xdev \
        \( -path /var/lib/containers -o -path /var/lib/docker -o -path /var/lib/flatpak \
        -o -path '/var/home/*/.local/share/containers' -o -path '/var/home/*/.local/share/flatpak' \) -prune -o \
        -type f \( -perm -4000 -o -perm -2000 \) -print 2>/dev/null | sort
}
sweep_to_list() { sweep_setuid >"${STATE}/setuid.list"; }
drift_to_json() { DRIFT="$(drift | jq -R 'split("\t") | {change: .[0], path: .[1], detail: .[2]}' | jq -s .)"; }

# --- Programs that accept connections -----------------------------------------------------------------

# TCP listeners on anything but the loopback address, one "port<TAB>address<TAB>program" a line. The
# tailnet is trusted by the firewall, so every one of these can be reached from every device on it.
# UDP is left out: most of what shows there is programs' own outgoing sockets, on new ports each time.
listeners() {
    ss -Htlnp 2>/dev/null | awk '
        {
            port = $4; sub(/.*:/, "", port)
            address = $4; sub(/:[^:]*$/, "", address)
            if (address ~ /^(127\.|\[::1\]|\[::ffff:127\.)/ || address ~ /%lo$/) next
            program = "?"
            if (match($0, /users:\(\("[^"]+"/)) program = substr($0, RSTART + 9, RLENGTH - 10)
            print port "\t" address "\t" program
        }' | sort -u -t$'\t' -k1,1n -k3,3
}

# A program listening on a port for the first time is news. Ports from the ephemeral range are chosen
# anew at every start, so for those the program is what is remembered, not the number. What the image's own
# programs listen on (fwupd's passim, started when firmware is looked for), or the owner allowed, is
# recorded, not said: "program port" in the allowlist.
read_listeners() {
    local seen="${STATE}/listeners-seen" low high port address program key level
    read -r low high </proc/sys/net/ipv4/ip_local_port_range 2>/dev/null || { low=32768; high=60999; }
    while IFS=$'\t' read -r port address program; do
        [[ "${port}" =~ ^[0-9]+$ ]] || continue
        key="${program} ${port}"
        [[ "${port}" -ge "${low}" && "${port}" -le "${high}" ]] && key="${program} ephemeral"
        grep -qxF -- "${key}" "${seen}" 2>/dev/null && continue
        echo "${key}" >>"${seen}"
        level=normal
        allowed listeners "${key}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] &&
            add "${level}" listeners - "Command and Control" "${program} accepts connections on port ${port} (${address}), which every device on your tailnet can reach" \
                "allow=${key}"
        ALLOWED_HIT=0
    done <<<"${LISTENERS}"
}

# --- What a session finds first -----------------------------------------------------------------------

# A shell looks in ~/.local/bin and ~/bin before /usr/bin, so a program called sudo there runs in place
# of the real one, and asks for the password the real one would: the oldest way to catch it. A command
# with a system command's name is said when it appears and whenever it changes, out loud when the name
# is one that asks for a password or a key. Homebrew's prefix comes before /usr/bin too, and whoever set
# Homebrew up can write to it, but there a name like the system's is mostly what was installed on
# purpose (git, curl, Python), so only those that ask for a password or a key are said.
#
# A launcher in the app grid's folder of an account is said once when no container export made it:
# distrobox writes those, as amethystora-pkg asks it to, and the image's own web apps are there too.
PASSWORD_COMMANDS=" sudo su pkexec run0 doas passwd login ssh scp sftp ssh-add ssh-agent ssh-keygen gpg gpg2 \
gpg-agent pinentry secret-tool "

# Every account with a home here, as passwd lines: those in /etc/passwd, and those of a domain (SSSD or
# winbind), which are not in it, by their home folders in /var/home. As amethystora-audit-home-rules
# finds them, which runs before anything could look them up.
accounts() {
    {
        cat "${ROOT}/etc/passwd"
        for home in "${ROOT}"/var/home/*/; do
            [[ -d "${home}" ]] && printf '%s:x:%s:::%s:\n' "$(basename "${home}")" "$(stat -c %u "${home}")" "${home%/}"
        done
    } | awk -F: '!seen[$3]++'
}

# The accounts with a session now, by UID. With a stand-in root, AMETHYSTORA_WATCH_ACCOUNTS names them.
logged_in() {
    if [[ -z "${ROOT}" ]]; then
        loginctl list-users --no-legend --no-pager 2>/dev/null | awk '{ print $1 }'
    else
        printf '%s\n' ${AMETHYSTORA_WATCH_ACCOUNTS:-}
    fi
}

read_user_paths() {
    local seen="${STATE}/user-paths-seen" first=false user uid home dir file name level key line where
    local path part component target shown odd='[^[:alnum:]._/@+-]'
    local -a parts home_paths
    mapfile -t home_paths < <(/usr/libexec/amethystora-audit-home-rules --paths 2>/dev/null)
    # The first run of this check only records where things stand, on a machine with years of them
    [[ -e "${seen}" ]] || first=true
    touch "${seen}"
    remember() {
        grep -qxF -- "$1" "${seen}" && return 1
        echo "$1" >>"${seen}"
        [[ "${first}" != true ]]
    }
    # Root reads what an account put in its home: only a plain file, never through a link, and never for long
    # or much. A launcher made a link to /proc/kmsg, which says it is a regular file, kept an earlier
    # version waiting until the next boot.
    plain() { [[ -f "$1" && ! -L "$1" ]]; }
    head_of() { timeout 5 head -c "${2:-65536}" -- "$1" 2>/dev/null; }
    hash_of() { head_of "$1" 16777216 | sha256sum | cut -c1-16; }
    while IFS=: read -r user _ uid _ _ home _; do
        # Not system accounts, nor nobody. A domain's are numbered from far above nobody's 65534.
        [[ "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue
        for dir in "${home}/.local/bin" "${home}/bin"; do
            # A folder a link takes out of the home is said below, not read
            [[ "$(realpath -e -- "${dir}" 2>/dev/null)" == "${home}"/* ]] || continue
            for file in "${dir}"/*; do
                plain "${file}" && [[ -x "${file}" ]] || continue
                name="${file##*/}"
                [[ -e "/usr/bin/${name}" || -e "/usr/sbin/${name}" ]] || continue
                remember "${file} $(hash_of "${file}")" || continue
                [[ "${PASSWORD_COMMANDS}" == *" ${name} "* ]] && level=critical || level=normal
                where=""
                grep -qx '# distrobox_binary' <<<"$(head_of "${file}")" && where=", exported from a container"
                add "${level}" user-paths "${user}" Persistence "~${user}${file#"${home}"} is run in place of the system's ${name} by ${user}${where}"
            done
        done
        [[ "$(realpath -e -- "${home}/.local/share/applications" 2>/dev/null)" == "${home}"/* ]] &&
        for file in "${home}/.local/share/applications"/*.desktop; do
            plain "${file}" || continue
            # Every Exec line, not the first: GLib reads the last of a key written twice, and each action
            # has its own, so one a container export or web app would write vouches for nothing else
            line="$(head_of "${file}" | grep -E '^Exec[[:space:]]*=' |
                grep -vE '^Exec[[:space:]]*=[[:space:]]*((/usr/bin/)?(distrobox-enter|distrobox enter) |amethystora-webapp )' | head -n1)"
            [[ -n "${line}" ]] || continue
            remember "${file} $(sha256sum <<<"${line}" | cut -c1-16)" || continue
            add normal user-paths "${user}" Persistence "A launcher no container export made is in ${user}'s app grid: ~${user}${file#"${home}"}, which runs ${line#*=}"
        done
        # A place the per-home audit rules watch, taken out of the home by a link: they write no watch
        # through one, so what starts from there goes unseen. Only lstat and readlink, never a read.
        for path in "${home_paths[@]}"; do
            part="${home}"
            IFS=/ read -ra parts <<<"${path}"
            for component in "${parts[@]}"; do
                part+="/${component}"
                [[ -L "${part}" ]] || continue
                target="$(realpath -m -- "${part}" 2>/dev/null)"
                [[ "${target}" == "${home}"/* && ! "${target}" =~ ${odd} ]] && continue
                # The account chose where it leads: only plain characters of it reach a notification
                shown="${target//${odd}/?}"
                remember "${part} -> ${target}" &&
                    add normal user-paths "${user}" "Defense Evasion" "~${user}${part#"${home}"} is a link out of ${user}'s home folder, to ${shown:-nowhere}: the audit log no longer watches what is put there"
                break
            done
        done
    done < <(accounts)
    for dir in /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin; do
        for file in "${dir}"/*; do
            name="${file##*/}"
            [[ "${PASSWORD_COMMANDS}" == *" ${name} "* && -x "${file}" ]] || continue
            # Homebrew's commands are links into its Cellar, so a link is read here, but only for so long
            remember "${file} $(hash_of "${file}")" || continue
            add critical user-paths - Persistence "${file} is run in place of the system's ${name} by everyone whose shell loads Homebrew"
        done
    done
}

# --- Network protection -------------------------------------------------------------------------------

# Suricata writes its alerts to eve.json and nowhere else (amethystora-ips.service): what it blocked, and
# what it recognised on a rule that only alerts. Each run reads what is new since the last. The newest
# are kept in network.json, one entry for each rule and pair of addresses, for `ame security connections`
# and the Security app. They name the sites this machine talked to, so wheel can read them, as it can the
# journal, and nobody else. A log rotated between two runs loses what the first did not read of it,
# which real-time watching, following eve.json while network protection is on, keeps to seconds.
EVE="${ROOT}/var/log/suricata/eve.json"
NETWORK_EVENTS="${STATE}/network.json"
NETWORK_KEPT=200
# One alert, as network.json keeps it. Suricata writes local times: 2026-09-27T10:02:03.123456+0200.
ALERT_FILTER='
def seconds: capture("^(?<t>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
    | (.t + "Z" | fromdateiso8601) - (if .s == "+" then 1 else -1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60);
fromjson? | select(.event_type == "alert") | {
    time: ((.timestamp | try seconds catch null) // now | floor),
    action: (.alert.action // "allowed"),
    sid: .alert.signature_id,
    signature: (.alert.signature // "an unnamed rule"),
    category: (.alert.category // ""),
    severity: (.alert.severity // 3),
    proto: (.proto // ""),
    src: .src_ip,
    dest: .dest_ip,
    port: .dest_port,
    host: ([(.tls.sni), (.http.hostname), ((.dns.query? // .dns.queries?) | arrays | .[0].rrname?)]
        | map(select(type == "string" and . != "")) | first)
}'

read_network() {
    local position="${STATE}/eve.position" chunk="${STATE}/eve.chunk" inode size last="" offset=0
    [[ -f "${EVE}" ]] || return 0
    inode="$(stat -c %i "${EVE}")"
    size="$(stat -c %s "${EVE}")"
    { read -r last offset <"${position}"; } 2>/dev/null
    # A log rotated away, or cut short, is read from its beginning
    [[ "${last}" == "${inode}" && "${offset}" =~ ^[0-9]+$ && "${offset}" -le "${size}" ]] || offset=0
    tail -c "+$((offset + 1))" "${EVE}" | head -c "$((size - offset))" >"${chunk}"
    # Whole lines only: the last one may still be being written, and is read next time
    if [[ -s "${chunk}" && "$(tail -c 1 "${chunk}" | od -An -tx1 | tr -d ' ')" != 0a ]]; then
        sed -i '$d' "${chunk}"
    fi
    echo "${inode} $((offset + $(stat -c %s "${chunk}")))" >"${position}"
    jq -cR "${ALERT_FILTER}" "${chunk}" >"${chunk}.alerts" 2>/dev/null
    rm -f "${chunk}"

    # One line for each rule, however many times and between however many addresses it went off. A
    # block is said out loud with the way to undo it; an alert that let something through only when
    # the rule rates it serious.
    [[ -n "${LAST_RUN}" ]] && while IFS=$'\t' read -r level text; do
        add "${level}" network - "Command and Control" "${text}"
    done < <(jq -rs '
        group_by([.action, .sid]) | .[]
        | (map(.host // "\(.src) and \(.dest)") | unique) as $peers | .[0] as $a | length as $times
        # ET HUNTING rules (NETWORK_HUNTING=record) are suspicious, not sure: recorded for the chains, never said
        | [(if ($a.signature | startswith("ET HUNTING ")) then "quiet"
            elif $a.action == "blocked" then (if $a.severity == 1 then "critical" else "normal" end)
            elif $a.severity == 1 then "normal" else "quiet" end),
           ((if $a.action == "blocked" then "Network protection blocked " else "Network protection noticed " end)
            + $a.signature + " (" + $peers[0]
            + (if ($peers | length) > 1 then " and \(($peers | length) - 1) more" else "" end)
            + (if $times > 1 then ", \($times) times" else "" end) + ")"
            + (if $a.action == "blocked"
               then ". If that was yours and wanted, allow it again with: ame security connections allow \($a.sid)"
               else ", and let it through" end))]
        | @tsv' "${chunk}.alerts")

    if jq -s --slurpfile kept <(cat "${NETWORK_EVENTS}" 2>/dev/null || echo '[]') --argjson most "${NETWORK_KEPT}" '
        (($kept[0] // []) + map(. + {count: 1, first: .time}))
        | group_by([.action, .sid, .src, .dest, .port])
        | map(reduce .[1:][] as $e (.[0];
            .count += $e.count | .first = ([.first, $e.first] | min) | .time = ([.time, $e.time] | max)
            | .host //= $e.host))
        | sort_by(-.time) | .[:$most]' "${chunk}.alerts" >"${NETWORK_EVENTS}.new"; then
        chgrp wheel "${NETWORK_EVENTS}.new" && chmod 0640 "${NETWORK_EVENTS}.new" &&
            mv "${NETWORK_EVENTS}.new" "${NETWORK_EVENTS}"
    fi
    rm -f "${chunk}.alerts" "${NETWORK_EVENTS}.new"
}

# What the report says about network protection and cannot see for itself: whether the table that sends
# Suricata the traffic is there, when the rules were last built, and how much it blocked in a week
network_status() {
    local blocked=0 rules table=false
    [[ -s "${NETWORK_EVENTS}" ]] && blocked="$(jq --argjson since "$((NOW - 7 * 86400))" \
        '[.[] | select(.action == "blocked" and .time >= $since) | .count] | add // 0' "${NETWORK_EVENTS}" 2>/dev/null)"
    rules="$(stat -c %Y /var/lib/suricata/rules/suricata.rules 2>/dev/null)"
    nft list table inet amethystora-ips >/dev/null 2>&1 && table=true
    jq -n --argjson blocked "${blocked:-0}" --argjson rules "${rules:-null}" --argjson table "${table}" \
        '{$blocked, $rules, $table}'
}

# --- The report ---------------------------------------------------------------------------------------

# The checks this speaks up about: the ones that say something was turned off or tampered with. Those
# that only age (signatures, the image), and those that already raise their own alarm, are left out.
# The security watcher's own check counts only when it is "check" (a run that failed or stalled, said by the
# next one that does not); "off" there means what it found is unread, which it has said already.
WATCHED_CHECKS='["signed-updates","lockdown","automatic-updates","audit-log","audit-rules","fail2ban",
"firewall","network","image-settings","rootkit","virus-scan-schedule","settings-audit","security-watcher","selinux",
"duress-finger","duress-password"]'

# Whether a switch's own command made a change since the last run (amethystora-security-config note), for any
# of the names given: then that change was the person at the machine, and is recorded rather than said
noted() {
    local since="${LAST_RUN:-$((NOW - 1800))}" name
    for name in "$@"; do
        awk -F'\t' -v since="$((since - 5))" -v name="${name}" '$1 >= since && ($2 == name || index($2, name ":") == 1) { found = 1 }
            END { exit !found }' "${STATE}/notes" 2>/dev/null && return 0
    done
    return 1
}

read_report() {
    local report now before tiles was id state title level
    report="$(/usr/libexec/amethystora-security-status --json 2>/dev/null)" || return
    now="$(jq -c '[.checks[] | select(.group != "optional") | {id, state, text, details}]' <<<"${report}" 2>/dev/null)"
    tiles="$(jq -c '[.checks[] | select(.group == "optional") | {id, state, title}]' <<<"${report}" 2>/dev/null)"
    [[ -n "${now}" ]] || return
    # A protection turned off with no switch of the image's own, such as encrypted DNS or USB protection, is
    # said once, unless its own command did it; one turned on is only recorded
    was="$(cat "${STATE}/tiles.json" 2>/dev/null)"
    printf '%s\n' "${tiles:-[]}" >"${STATE}/tiles.json"
    if [[ -n "${was}" ]]; then
        while IFS=$'\t' read -r id state title; do
            level=normal
            noted "${id}" "${id%-protection}" "${id}-scan" "${id}-watch" && level=quiet
            [[ "${state}" == on ]] && level=quiet
            add "${level}" report - "Defense Evasion" "${title} was turned ${state}"
        done < <(jq -r --argjson was "${was}" '
            (reduce $was[] as $tile ({}; .[$tile.id] = $tile.state)) as $before
            | .[] | select($before[.id] != null and $before[.id] != .state and (.state | IN("on", "off"))
                and ($before[.id] | IN("on", "off")))
            | [.id, .state, .title] | @tsv' <<<"${tiles:-[]}")
    fi
    before="$(cat "${STATE}/report.json" 2>/dev/null)"
    printf '%s\n' "${now}" >"${STATE}/report.json"
    [[ -n "${before}" ]] || return
    while IFS=$'\t' read -r state text details; do
        [[ "${state}" == off ]] && level=critical || level=normal
        add "${level}" report - "Defense Evasion" "${text}${details:+. ${details}}"
    # A list that grows (another setuid program, another changed file) is news while the check is
    # already failing. A count of days going up is not, so the others count only when their state does.
    done < <(jq -r --argjson before "${before}" --argjson watched "${WATCHED_CHECKS}" '
        (reduce $before[] as $check ({}; .[$check.id] = $check)) as $was
        | .[]
        | select(.id | IN($watched[]))
        | select(.state == "check" or .state == "off")
        | select(.id != "security-watcher" or .state == "check")
        | select($was[.id] == null or $was[.id].state != .state
            or ((.id | IN("image-settings", "rootkit")) and $was[.id].details != .details))
        | [.state, .text, (.details | join(" "))] | @tsv' <<<"${now}")
}

# --- The switches themselves --------------------------------------------------------------------------

# A security setting changed in /etc/amethystora/security.conf, one of what the image enforces turned off
# (/etc/amethystora/hardening-off) or a stricter setting turned off again (hardening-on), named with what it
# changed to. The audit log says which program wrote the file; this says what it now means. A change its own
# switch made is recorded, not said.
read_settings() {
    local now was key value old
    now="$(/usr/libexec/amethystora-security-config --all | sort)"
    was="$(cat "${STATE}/settings.seen" 2>/dev/null)"
    printf '%s\n' "${now}" >"${STATE}/settings.seen"
    if [[ -n "${was}" ]]; then
        while IFS='=' read -r key value; do
            old="$(sed -n "s/^${key}=//p" <<<"${was}")"
            [[ -n "${old}" && "${old}" != "${value}" ]] || continue
            level=normal
            noted "$(tr 'A-Z_' 'a-z-' <<<"${key}")" profile realtime && level=quiet
            add "${level}" settings - "Defense Evasion" "The security setting ${key} changed from ${old} to ${value} (/etc/amethystora/security.conf)"
        done <<<"${now}"
    fi
    now="$(sort "${ROOT}/etc/amethystora/hardening-off" 2>/dev/null)"
    [[ -e "${STATE}/hardening.seen" ]] || { printf '%s\n' "${now}" >"${STATE}/hardening.seen"; return; }
    was="$(cat "${STATE}/hardening.seen")"
    printf '%s\n' "${now}" >"${STATE}/hardening.seen"
    while IFS= read -r key; do
        [[ -n "${key}" ]] || continue
        level=normal
        noted "${key%% *}" && level=quiet
        add "${level}" settings - "Defense Evasion" "${key} was turned off, of what the image enforces (ame security ${key%% *})"
    done < <(comm -13 <(printf '%s\n' "${was}" | sed '/^$/d') <(printf '%s\n' "${now}" | sed '/^$/d'))
    now="$(sort "${ROOT}/etc/amethystora/hardening-on" 2>/dev/null)"
    [[ -e "${STATE}/hardening-on.seen" ]] || { printf '%s\n' "${now}" >"${STATE}/hardening-on.seen"; return; }
    was="$(cat "${STATE}/hardening-on.seen")"
    printf '%s\n' "${now}" >"${STATE}/hardening-on.seen"
    while IFS= read -r key; do
        [[ -n "${key}" ]] || continue
        level=normal
        noted "${key%% *}" && level=quiet
        add "${level}" settings - "Defense Evasion" "${key}, a stricter setting, was turned off (ame security ${key%% *})"
    done < <(comm -23 <(printf '%s\n' "${was}" | sed '/^$/d') <(printf '%s\n' "${now}" | sed '/^$/d'))
}

# --- What the audit log lost ---------------------------------------------------------------------------

# The kernel drops an audit event rather than make anything wait when its backlog is full
# (--backlog_wait_time 0, 99-amethystora-finalize.rules), and counts what it dropped. Only root can ask, so
# the drops of the last week go into status.json for the report's "Audit rules" check, which says them. The
# count starts again at every boot.
audit_status() {
    # previous starts at 0: the first run has no audit-lost to read, and set -u ended this there before it
    # wrote one, so the report never had the drops
    local status enabled lost previous=0 since drops="${STATE}/audit-drops"
    status="$(auditctl -s 2>/dev/null)" || { echo null; return; }
    enabled="$(awk '$1 == "enabled" { print $2 }' <<<"${status}")"
    lost="$(awk '$1 == "lost" { print $2 }' <<<"${status}")"
    [[ "${enabled}" =~ ^[0-9]+$ && "${lost}" =~ ^[0-9]+$ ]] || { echo null; return; }
    { read -r previous since <"${STATE}/audit-lost"; } 2>/dev/null
    [[ "${previous}" =~ ^[0-9]+$ && "${previous}" -le "${lost}" ]] || previous=0
    [[ "${lost}" -gt "${previous}" ]] && echo "${NOW} $((lost - previous))" >>"${drops}"
    echo "${lost} ${NOW}" >"${STATE}/audit-lost"
    # A week of them, one "time count" a line
    awk -v since="$((NOW - 7 * 86400))" '$1 >= since' "${drops}" 2>/dev/null >"${drops}.new"
    mv "${drops}.new" "${drops}" 2>/dev/null
    jq -n --argjson enabled "${enabled}" --argjson drops "$(jq -R 'split(" ") | {time: (.[0] | tonumber), count: (.[1] | tonumber)}' "${drops}" | jq -s .)" \
        '{$enabled, $drops}'
}

# The file-watch sensor's state for the report: the keys the plan gives it, whether it is running, and the
# events its BPF could not write since it started (the ring buffer full in a burst), which it keeps in its
# run directory, as audit's lost events are counted
sensor_status() {
    local covered active=false drops
    covered="$(tr ' ' '\n' <<<"${SENSOR_COVERS}" | grep . | jq -R . | jq -sc . 2>/dev/null)"
    "${SYSTEMCTL}" is-active --quiet amethystora-sensor.service 2>/dev/null && active=true
    drops="$(cat "${SENSOR_RUN}/dropped" 2>/dev/null)"
    [[ "${drops}" =~ ^[0-9]+$ ]] || drops=0
    jq -nc --argjson covered "${covered:-[]}" --argjson active "${active}" --argjson drops "${drops}" \
        '{$covered, $active, $drops}'
}

# A stop worth saying: the plan gives the sensor keys, yet it is not running, so the kernel records nothing
# for them (the audit rules are off in its place). A stop takes a reboot to be the normal state, as the
# locked audit rules do. A kill is undone within a second (Restart=always), so every restart since the last
# look is said as well, counted per boot since a shutdown is none; and so is what the sensor recorded done to
# itself, a signal or a bpf() call at its links, but systemd's own (a shutdown, or a kill a restart says).
# Silent when the sensor covers nothing (a fallback boot, or a stand-in in the tests).
sensor_watch() {
    local boot restarts last_boot="" last_restarts="" count mark event times
    [[ "${SENSOR_COVERS}" =~ [a-z] ]] || return 0
    if ! "${SYSTEMCTL}" is-active --quiet amethystora-sensor.service 2>/dev/null; then
        add critical hardening - "Defense Evasion" \
            "The file-watch sensor is not running, and the audit rules are off in its place: changes to accounts, sudo, what starts by itself and the security settings are not being recorded. Start amethystora-sensor, or keep the audit rules with: ame security audit-locked on"
        return 0
    fi
    boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
    restarts="$("${SYSTEMCTL}" show -p NRestarts --value amethystora-sensor.service 2>/dev/null)"
    [[ -r "${STATE}/sensor-restarts" ]] && read -r last_boot last_restarts <"${STATE}/sensor-restarts"
    [[ "${last_boot}" == "${boot}" && "${last_restarts}" =~ ^[0-9]+$ ]] || last_restarts=0
    if [[ "${restarts}" =~ ^[0-9]+$ ]]; then
        if [[ "${restarts}" -gt "${last_restarts}" ]]; then
            times=""
            [[ $((restarts - last_restarts)) -gt 1 ]] && times=" ($((restarts - last_restarts)) times)"
            add critical hardening - "Defense Evasion" \
                "The file-watch sensor stopped and was started again since the last check${times}: what happened while it was down was not recorded. A kill does this, and so does a crash, which its journal names: journalctl -u amethystora-sensor"
        fi
        echo "${boot} ${restarts}" >"${STATE}/sensor-restarts"
    fi
    while read -r count mark event; do
        [[ -n "${event}" && "${event}" != *" using /usr/lib/systemd/systemd" ]] || continue
        times=""
        [[ "${count}" -gt 1 ]] && times=" (${count} times)"
        add "$([[ "${mark}" == noted ]] && echo quiet || echo critical)" hardening - "Defense Evasion" \
            "Something reached for the file-watch sensor itself: ${event}${times}"
    done < <(audit_events sensor)
}

# --- The TPM's disk key ----------------------------------------------------------------------------------

# Whether the TPM holds a key to the system's disk, and whether every such key asks for a PIN, is in the
# LUKS header, which only root can read. systemd-cryptenroll marks a key that takes a PIN "tpm2-pin".
disk_unlock_status() {
    local device header tpm=false pin=true
    while read -r device; do
        header="$(cryptsetup luksDump --dump-json-metadata "${device}" 2>/dev/null)" || continue
        jq -e '[.tokens[] | select(.type == "systemd-tpm2")] | length > 0' <<<"${header}" >/dev/null || continue
        tpm=true
        jq -e '[.tokens[] | select(.type == "systemd-tpm2" and ."tpm2-pin" != true)] | length > 0' \
            <<<"${header}" >/dev/null && pin=false
    done < <(/usr/libexec/amethystora-raid root-luks 2>/dev/null)
    [[ "${tpm}" == true ]] || pin=null
    jq -n --argjson tpm "${tpm}" --argjson pin "${pin}" '{$tpm, $pin}'
}

# --- The duress finger and password -----------------------------------------------------------------------

# What keeps a duress action from running, from amethystora-duress, which only root can ask: its folder open,
# its action changed or gone, a duress finger's print written again, its service stopped. The finger and the
# password each have their own action, so each is reported on its own ({fingerprint, password}), with only
# the kinds, never which account (the report is world-readable); a source is null while it works or is off,
# and the whole thing is null while neither feature is on, so the report says nothing of a duress that works.
duress_source_kinds() {
    local out
    [[ "$(/usr/libexec/amethystora-duress "status-$1")" == on ]] || { echo null; return; }
    if out="$(/usr/libexec/amethystora-duress check "$1" 2>/dev/null)"; then
        echo null
    else
        cut -d' ' -f1 <<<"${out}" | sort -u | jq -R . | jq -sc .
    fi
}
duress_status() {
    [[ "$(/usr/libexec/amethystora-duress status)" == on ]] || { echo null; return; }
    jq -nc --argjson fingerprint "$(duress_source_kinds fingerprint)" \
        --argjson password "$(duress_source_kinds password)" '{$fingerprint, $password}'
}

# --- What only an account can see ------------------------------------------------------------------------

# Some things only an account can read: its own Flatpaks' permissions, its agents' configurations, its Python
# and git setup. Each is read by /usr/libexec/amethystora-security-reader, as that account and never as root,
# which would follow whatever link the account put in its home: with a clean environment, a fixed PATH, and
# for no longer than a minute. The reader prints what it finds, one JSON line each ({id, level, tactic, text,
# allow}). What it printed last time is kept here, in root's state, where the account cannot change it to
# hide something new, and an id that was not there then is news, said to that account alone. Only accounts
# with a session in the last day are read, so an account nobody uses costs nothing.
READER=/usr/libexec/amethystora-security-reader
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_READER:-}" ]] && READER="${AMETHYSTORA_WATCH_READER}"
# Each switch read this way, and the reader's mode for it
declare -A READERS=([APP_PERMISSIONS]=app-permissions [DEV_HOOKS]=dev-hooks [AGENT_CONFIG]=agent-config)
ACTIVE_FOR=86400
ACCOUNT_TACTICS=" Persistence Execution Collection Credential-Access Privilege-Escalation Defense-Evasion Command-and-Control "

# The accounts with a session now are marked, and those marked in the last day are printed, by UID
active_accounts() {
    local uid dir mark
    logged_in | while read -r uid; do
        [[ "${uid}" =~ ^[0-9]+$ && "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        mkdir -p -m 0700 "${STATE}/accounts/${uid}"
        echo "${NOW}" >"${STATE}/accounts/${uid}/active"
    done
    for dir in "${STATE}"/accounts/*/; do
        [[ -d "${dir}" ]] || continue
        uid="$(basename "${dir}")"
        mark="$(cat "${dir}active" 2>/dev/null)"
        [[ "${mark}" =~ ^[0-9]+$ && $((NOW - mark)) -lt ${ACTIVE_FOR} ]] && echo "${uid}"
    done
}

read_accounts() {
    local key="$1" mode="${READERS[$1]}" feature user uid gid home groups out seen first new id level tactic text allow within
    feature="$(tr "A-Z_" "a-z-" <<<"${key}")"
    while IFS=: read -r user _ uid gid _ home _; do
        [[ " ${ACTIVE} " == *" ${uid} "* ]] || continue
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue
        [[ "${gid}" =~ ^[0-9]+$ ]] || gid="$(stat -c %g "${home}")"
        # A domain's account has its groups once SSSD answers; one nothing can look up gets none
        groups=--init-groups
        id -nu "${uid}" >/dev/null 2>&1 || groups=--clear-groups
        out="$(timeout 60 setpriv --reuid="${uid}" --regid="${gid}" "${groups}" -- /usr/bin/env -i HOME="${home}" \
            USER="${user}" LOGNAME="${user}" PATH=/usr/bin:/usr/sbin LANG=C.UTF-8 "${READER}" "${mode}" 2>/dev/null)" ||
            continue
        # One line each, its fields apart by the unit separator, which no field keeps: a tab is whitespace to
        # read, which would run an empty field into the next
        out="$(jq -rc 'select(type == "object" and (.id | type == "string") and (.text | type == "string"))
            | [.id, (.level // "normal"), (.tactic // "-"), .text, (.allow // ""), (.within // "")]
            | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' <<<"${out}" 2>/dev/null)"
        seen="${STATE}/accounts/${uid}/${mode}.seen"
        first=false
        [[ -e "${seen}" ]] || first=true
        # What is new since last time; a thing within something that is new itself came with it, and is quiet
        new="$(cut -d$'\x1f' -f1 <<<"${out}" | grep . | grep -vxF -f "${seen}" 2>/dev/null)"
        [[ -e "${seen}" ]] || new="$(cut -d$'\x1f' -f1 <<<"${out}" | grep .)"
        while IFS=$'\x1f' read -r id level tactic text allow within; do
            [[ -n "${id}" && "${first}" == false ]] && grep -qxF -- "${id}" <<<"${new}" || continue
            [[ "${level}" =~ ^(critical|normal|quiet)$ ]] || level=normal
            [[ -n "${within}" ]] && grep -qxF -- "${within}" <<<"${new}" && level=quiet
            [[ "${ACCOUNT_TACTICS}" == *" ${tactic// /-} "* ]] || tactic=-
            [[ -n "${allow}" ]] && allowed "${feature}" "${allow}" && { level=quiet; ALLOWED_HIT=1; }
            add "${level}" "${feature}" "${user}" "${tactic}" "${text}" ${allow:+"allow=${allow}"} "tell=${user}"
        done <<<"${out}"
        mkdir -p -m 0700 "${seen%/*}"
        cut -d$'\x1f' -f1 <<<"${out}" | grep . >"${seen}"
    done < <(accounts)
}

# --- Installed apps against their updates ------------------------------------------------------------------------

# What the app integrity check found (APP_INTEGRITY, amethystora-integrity, daily and after each change to the
# system's Flatpaks), all of it at each of its runs, in the readers' form: what was not there at the last read is
# said. What is about an account's own apps is said to that account, and to the administrators as well. None of it
# can be allowed: a changed file is not a setting, and the way out is putting it back.
INTEGRITY="${STATE}/integrity"
read_integrity() {
    local seen="${STATE}/integrity.seen" out new id level tactic text account
    local -a facts
    [[ -r "${INTEGRITY}/findings.jsonl" ]] || return 0
    touch "${seen}"
    out="$(jq -rc 'select(type == "object" and (.id | type == "string") and (.text | type == "string"))
        | [.id, (.level // "normal"), (.tactic // "-"), .text, (.account // "-")]
        | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' "${INTEGRITY}/findings.jsonl" 2>/dev/null)"
    new="$(cut -d$'\x1f' -f1 <<<"${out}" | grep . | grep -vxF -f "${seen}")"
    while IFS=$'\x1f' read -r id level tactic text account; do
        [[ -n "${id}" ]] && grep -qxF -- "${id}" <<<"${new}" || continue
        [[ "${level}" =~ ^(critical|normal|quiet)$ ]] || level=normal
        [[ " Persistence Execution Initial-Access " == *" ${tactic// /-} "* ]] || tactic=-
        facts=()
        [[ "${account}" != - ]] && facts=("tell=${account}")
        add "${level}" app-integrity "${account}" "${tactic}" "${text}" "${facts[@]}"
    done <<<"${out}"
    cut -d$'\x1f' -f1 <<<"${out}" | grep . >"${seen}"
    return 0
}

# ...and for the report, world-readable: when it last ran, what it checked, and what it found about the system's
# own and the system's apps. Of an account's own apps only whose they are, how loud and which app, for that
# account's report: their sentences name its files, and are said to it and kept in the events.
integrity_status() {
    [[ -r "${INTEGRITY}/last.json" ]] || { echo null; return; }
    jq -c --slurpfile found "${INTEGRITY}/findings.jsonl" '{time, sealed, system, flatpak,
        accounts: (.accounts // {} | keys),
        findings: [$found[] | select(type == "object") | if .account == "-"
            then {id, level, text, account, app, ref, origin, installation}
            else {level, account, app, ref, origin, installation} end]}' "${INTEGRITY}/last.json" 2>/dev/null || echo null
}

# --- The behaviour sensor -----------------------------------------------------------------------------------

# What Falco saw (BEHAVIOUR, amethystora-behaviour.service): its rules match what processes do as the kernel
# sees it, every command, file opened and connection, through its eBPF probe. Each run reads what is new in
# its file of JSON lines, one line for each rule and program however often, at the level its rule gives:
# critical, normal for a warning or an error, quiet for a notice. Its ATT&CK tags feed the chains. The file is
# moved aside once it grows past 20 MB, and Falco reopens its own.
FALCO_EVENTS="${ROOT}/var/log/falco/events.json"
FALCO_KEPT=$((20 * 1024 * 1024))
read_behaviour() {
    local position="${STATE}/falco.position" chunk="${STATE}/falco.chunk" inode size last="" offset=0
    local rule level tactic program user command count
    [[ -f "${FALCO_EVENTS}" ]] || return 0
    inode="$(stat -c %i "${FALCO_EVENTS}")"
    size="$(stat -c %s "${FALCO_EVENTS}")"
    { read -r last offset <"${position}"; } 2>/dev/null
    [[ "${last}" == "${inode}" && "${offset}" =~ ^[0-9]+$ && "${offset}" -le "${size}" ]] || offset=0
    tail -c "+$((offset + 1))" "${FALCO_EVENTS}" | head -c "$((size - offset))" >"${chunk}"
    # Whole lines only: the last one may still be being written
    if [[ -s "${chunk}" && "$(tail -c 1 "${chunk}" | od -An -tx1 | tr -d ' ')" != 0a ]]; then
        sed -i '$d' "${chunk}"
    fi
    echo "${inode} $((offset + $(stat -c %s "${chunk}")))" >"${position}"
    if [[ "${size}" -gt "${FALCO_KEPT}" && -z "${ROOT}" ]]; then
        mv -f "${FALCO_EVENTS}" "${FALCO_EVENTS}.1" && systemctl reload amethystora-behaviour.service 2>/dev/null
        rm -f "${position}"
    fi
    while IFS=$'\x1f' read -r rule level tactic program user command count; do
        [[ -n "${rule}" ]] || continue
        allowed behaviour "${program} ${rule}" && { level=quiet; ALLOWED_HIT=1; }
        [[ -n "${LAST_RUN}" ]] &&
            add "${level}" behaviour "${user}" "${tactic}" "The behaviour sensor saw: ${rule}, by ${program} as ${user}: ${command}$([[ "${count}" -gt 1 ]] && echo " (${count} times)")" \
                "allow=${program} ${rule}"
    done < <(jq -rs '
        def tactic: (map(select(startswith("mitre_"))) | first // "") as $tag
            | {mitre_initial_access: "Initial Access", mitre_execution: "Execution", mitre_persistence: "Persistence",
               mitre_privilege_escalation: "Privilege Escalation", mitre_defense_evasion: "Defense Evasion",
               mitre_credential_access: "Credential Access", mitre_discovery: "Discovery",
               mitre_lateral_movement: "Lateral Movement", mitre_collection: "Collection",
               mitre_command_and_control: "Command and Control", mitre_exfiltration: "Exfiltration",
               mitre_impact: "Impact"}[$tag] // "-";
        map(select(type == "object" and (.rule | type == "string")))
        | group_by([.rule, .output_fields["proc.exepath"]])[]
        | .[0] as $e | length as $count
        | [$e.rule,
           (if ($e.priority | IN("Emergency", "Alert", "Critical")) then "critical"
            elif ($e.priority | IN("Error", "Warning")) then "normal" else "quiet" end),
           (($e.tags // []) | tactic),
           ($e.output_fields["proc.exepath"] // $e.output_fields["proc.name"] // "?"),
           ($e.output_fields["user.name"] // "-"),
           ($e.output_fields["proc.cmdline"] // ""),
           $count]
        | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\u001f")' "${chunk}" 2>/dev/null)
    rm -f "${chunk}"
}

# --- Hash reputation ----------------------------------------------------------------------------------------

# Known malware recognised sooner than a signature would (REPUTATION): the full SHA-256 of each program odd
# processes or the download folders' watch saw run for the first time is looked up with MalwareBazaar
# (abuse.ch), once, with the owner's own free key in /etc/amethystora/abusech.key. Only the hash is sent:
# never the file, its name or its path. A hash knows only samples already submitted, and one byte changed
# defeats it: this is no defence against new malware, only a faster word on old.
REPUTATION_QUEUE="${STATE}/reputation-queue"
REPUTATION_KEY="${ROOT}/etc/amethystora/abusech.key"
REPUTATION_URL=https://mb-api.abuse.ch/api/v1/
REPUTATION_PER_RUN=20
# With a stand-in root, AMETHYSTORA_WATCH_CURL names a stand-in for curl
CURL=curl
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_CURL:-}" ]] && CURL="${AMETHYSTORA_WATCH_CURL}"
queue_hash() {
    [[ "${SETTING[REPUTATION]:-off}" == on && "$1" =~ ^[0-9a-f]{64}$ ]] || return 0
    printf '%s\t%s\n' "$1" "$2" >>"${REPUTATION_QUEUE}"
}

read_reputation() {
    local asked="${STATE}/reputation-asked" key sum program answer status signature seen_first looked=0
    [[ -s "${REPUTATION_QUEUE}" ]] || return 0
    key="$(head -c 200 "${REPUTATION_KEY}" 2>/dev/null | tr -cd 'A-Za-z0-9_-')"
    [[ -n "${key}" ]] || return 0
    # The key goes in a header read from a file of root's, never on a command line other accounts can read
    printf 'Auth-Key: %s\n' "${key}" >"${STATE}/reputation-header"
    touch "${asked}"
    while IFS=$'\t' read -r sum program; do
        grep -qxF -- "${sum}" "${asked}" && continue
        # A few a run: the rest wait for the next, where they still are
        [[ "${looked}" -lt "${REPUTATION_PER_RUN}" ]] || { printf '%s\t%s\n' "${sum}" "${program}" >>"${REPUTATION_QUEUE}.next"; continue; }
        looked=$((looked + 1))
        answer="$("${CURL}" -fsS --proto '=https' --tlsv1.2 --max-time 15 -H @"${STATE}/reputation-header" \
            --data-urlencode query=get_info --data-urlencode "hash=${sum}" "${REPUTATION_URL}" 2>/dev/null)" ||
            { printf '%s\t%s\n' "${sum}" "${program}" >>"${REPUTATION_QUEUE}.next"; continue; }
        echo "${sum}" >>"${asked}"
        status="$(jq -r '.query_status // empty' <<<"${answer}" 2>/dev/null)"
        [[ "${status}" == ok ]] || continue
        signature="$(jq -r '.data[0].signature // "malware with no name"' <<<"${answer}")"
        seen_first="$(jq -r '.data[0].first_seen // "some time ago"' <<<"${answer}")"
        add critical reputation - Execution "A program that ran here is known malware: ${program}, which MalwareBazaar knows as ${signature}, first seen ${seen_first}"
    done <"${REPUTATION_QUEUE}"
    mv -f "${REPUTATION_QUEUE}.next" "${REPUTATION_QUEUE}" 2>/dev/null || : >"${REPUTATION_QUEUE}"
}

# --- Odd names in DNS ---------------------------------------------------------------------------------------

# What amethystora-dns-names flagged among the names looked up since the last run (DNS_NAMES): one that looks
# made by a program, or that carries data. Read and emptied each run; each name said once.
DNS_FOUND="${STATE}/dns-names"
DNS_SEEN_KEPT=5000
read_dns() {
    local seen="${STATE}/dns-seen" reason name level
    [[ -s "${DNS_FOUND}" ]] || return 0
    touch "${seen}"
    while IFS=$'\x1f' read -r reason name; do
        [[ "${name}" =~ ^[a-z0-9._-]{1,253}$ ]] || continue
        grep -qxF -- "${name}" "${seen}" && continue
        echo "${name}" >>"${seen}"
        level=normal
        allowed dns-names "${name}" && { level=quiet; ALLOWED_HIT=1; }
        add "${level}" dns-names - "Command and Control" "A name looked up looks odd: ${name}, ${reason}" "allow=${name}"
    done <"${DNS_FOUND}"
    : >"${DNS_FOUND}"
    tail -n "${DNS_SEEN_KEPT}" "${seen}" >"${seen}.new" && mv "${seen}.new" "${seen}"
}

# --- Chains of steps ----------------------------------------------------------------------------------------

# An attack is steps that each look harmless: a program run from the downloads, a token read, a connection
# out. Every finding names its account and its step, as an ATT&CK tactic; those recorded only count as well,
# which is how a part set to record still protects without a sound, and what the owner allowed does not.
# Two different steps for one account within half an hour is said; three, or reading secrets and then talking
# to a command server, is critical. Network protection knows no account, so a command server it saw joins the
# chain of every account that ran something or read secrets in that half hour. Each chain is said once, and
# again only when it grows.
CHAIN_WINDOW=1800
read_chains() {
    local window="${STATE}/chain-window" said="${STATE}/chains-said" account level tactics steps key
    # This run's findings, then everything of the last half hour
    printf '%s\n' "${FINDINGS[@]}" | jq -c 'select(type == "object" and .key != "chains" and .tactic != "-" and (.allowed // "") == "")
        | {time, account, tactic, key}' >>"${window}" 2>/dev/null
    jq -c --argjson since "$((NOW - CHAIN_WINDOW))" 'select(.time >= $since)' "${window}" >"${window}.new" 2>/dev/null &&
        mv "${window}.new" "${window}"
    awk -v since="$((NOW - CHAIN_WINDOW))" -F'\x1f' '$3 >= since' "${said}" >"${said}.new" 2>/dev/null
    mv "${said}.new" "${said}" 2>/dev/null
    while IFS=$'\x1f' read -r account level tactics steps; do
        key="${account}"$'\x1f'"${tactics}"
        grep -qF -- "${key}"$'\x1f' "${said}" 2>/dev/null && continue
        printf '%s\x1f%s\n' "${key}" "${NOW}" >>"${said}"
        add "${level}" chains "${account}" - "Steps of one attack, for ${account}, within half an hour: ${steps}. Each may be harmless alone; together they are how an attack goes"
    done < <(jq -rs '
        [.[] | select(.account == "-" and .tactic == "Command and Control")] as $c2
        | [.[] | select(.account != "-")] | group_by(.account)[]
        | . as $own
        | ($own | map(.tactic) | any(. == "Execution" or . == "Credential Access")) as $active
        | ($own + (if $active then $c2 else [] end)) as $all
        | ($all | map(.tactic) | unique) as $tactics
        | select(($tactics | length) >= 2)
        | [$own[0].account,
           (if ($tactics | length) >= 3 or (($tactics | index("Credential Access")) != null and ($tactics | index("Command and Control")) != null)
            then "critical" else "normal" end),
           ($tactics | join(",")),
           ($all | map("\(.tactic) (\(.key))") | unique | join(", "))]
        | join("\u001f")' "${window}" 2>/dev/null)
}

# --- A run --------------------------------------------------------------------------------------------

# What each part took, in milliseconds, under the key of its switch: status.json carries them, and the
# Settings page shows each beside its switch
declare -A TIMINGS=()
timed() {
    local key="$1" start="${EPOCHREALTIME//[.,]/}"
    shift
    "$@"
    TIMINGS["${key}"]=$(((${EPOCHREALTIME//[.,]/} - start) / 1000))
}

# Each part is skipped while its switch is off. The ones that keep a place to read on from forget it, so
# that turned on again they start from then, not from everything since they were turned off.
if [[ "${SETTING[AUDIT_LOG]:-on}" != off ]]; then
    timed AUDIT_LOG read_audit
    [[ "${SETTING[SELINUX_DENIALS]:-off}" == off ]] && rm -f "${STATE}/audit-selinux.checkpoint"
    timed SELINUX_DENIALS switched SELINUX_DENIALS read_selinux
    [[ "${SETTING[EXEC_WATCH]:-off}" == off ]] && rm -f "${STATE}/audit-exec-watch.checkpoint" "${STATE}/sensor-exec-watch.checkpoint"
    timed EXEC_WATCH switched EXEC_WATCH read_exec
    [[ "${SETTING[AGENT_CLIS]:-off}" == off ]] && rm -f "${STATE}/audit-agent-clis.checkpoint" "${STATE}/sensor-agent-clis.checkpoint"
    timed AGENT_CLIS switched AGENT_CLIS read_agent_clis
    [[ "${SETTING[CREDENTIALS]:-off}" == off ]] && rm -f "${STATE}/audit-credentials.checkpoint" "${STATE}/sensor-credentials.checkpoint"
    timed CREDENTIALS switched CREDENTIALS read_credentials
    [[ "${SETTING[DECOY]:-off}" == off ]] && rm -f "${STATE}/audit-decoy.checkpoint" "${STATE}/sensor-decoy.checkpoint"
    timed DECOY switched DECOY read_decoy
    [[ "${SETTING[INJECTION]:-off}" == off ]] && rm -f "${STATE}/audit-injection.checkpoint" "${STATE}/sensor-injection.checkpoint"
    timed INJECTION switched INJECTION read_injection
    # The sensor stands in for the audit rules where it covers a key; say when it should be recording but is
    # not (MODE is on here, set back by the last switched call, so the stop is said)
    sensor_watch
fi
timed HARDENING switched HARDENING read_settings
[[ "${SETTING[PROCESSES]:-off}" == off ]] && rm -f "${STATE}/processes-seen"
timed PROCESSES switched PROCESSES read_processes
[[ "${SETTING[BPF_PROGRAMS]:-off}" == off ]] && rm -f "${STATE}/bpf-seen"
timed BPF_PROGRAMS switched BPF_PROGRAMS read_bpf
[[ "${SETTING[SNAPSHOT_WATCH]:-off}" == off ]] && rm -f "${STATE}/snapshot-last"
timed SNAPSHOT_WATCH switched SNAPSHOT_WATCH read_snapshots
[[ "${SETTING[BEHAVIOUR]:-off}" == off ]] && rm -f "${STATE}/falco.position"
timed BEHAVIOUR switched BEHAVIOUR read_behaviour
# After the parts that hash what runs, whose new programs it looks up
[[ "${SETTING[REPUTATION]:-off}" == off ]] && rm -f "${REPUTATION_QUEUE}"
timed REPUTATION switched REPUTATION read_reputation
[[ "${SETTING[JOURNAL]:-on}" == off ]] && rm -f "${STATE}/journal.cursor"
timed JOURNAL switched JOURNAL read_journal
timed NETWORK read_network
[[ "${SETTING[DNS_NAMES]:-off}" == off ]] && rm -f "${DNS_FOUND}" "${STATE}/dns-seen"
timed DNS_NAMES switched DNS_NAMES read_dns

# null in status.json for a part that is off, which the report shows as turned off rather than as clean
SETUID=null
if [[ "${SETTING[SETUID_SWEEP]:-on}" != off ]]; then
    SWEPT="$(cat "${STATE}/swept" 2>/dev/null || true)"
    if [[ ! "${SWEPT}" =~ ^[0-9]+$ || $((NOW - SWEPT)) -ge ${SWEEP_EVERY} ]]; then
        timed SETUID_SWEEP sweep_to_list
        SWEPT="${NOW}"
        echo "${SWEPT}" >"${STATE}/swept"
    fi
    SETUID="$(jq -R . "${STATE}/setuid.list" | jq -s .)"
else
    rm -f "${STATE}/swept"
fi
LISTENERS=""
LISTENING=null
if [[ "${SETTING[LISTENERS]:-on}" != off ]]; then
    LISTENERS="$(listeners)"
    LISTENING="$(jq -R 'split("\t") | select(length == 3) |
        {port: (.[0] | tonumber), address: .[1], program: .[2]}' <<<"${LISTENERS}" | jq -s .)"
    timed LISTENERS switched LISTENERS read_listeners
fi
timed USER_PATHS switched USER_PATHS read_user_paths
# What each account's own reader finds, for the accounts with a session in the last day. A reader that is off
# forgets what it saw, so that turned on again it starts from then.
ACTIVE=" $(active_accounts | tr '\n' ' ') "
for key in "${!READERS[@]}"; do
    if [[ "${SETTING[${key}]:-off}" == off ]]; then
        rm -f "${STATE}"/accounts/*/"${READERS[${key}]}.seen"
        continue
    fi
    timed "${key}" switched "${key}" read_accounts "${key}"
done
[[ "${SETTING[APP_INTEGRITY]:-off}" == off ]] && rm -f "${STATE}/integrity.seen"
timed APP_INTEGRITY switched APP_INTEGRITY read_integrity

# What the report reads, world-readable: it names files and ports, not what is in them, of network
# protection only how much it blocked, and of the audit log how many events it dropped
DRIFT=null
if [[ -d /usr/etc && "${SETTING[IMAGE_DRIFT]:-on}" != off ]]; then
    timed IMAGE_DRIFT drift_to_json
fi
AUDIT=null
[[ "${SETTING[AUDIT_LOG]:-on}" != off ]] && AUDIT="$(audit_status)"
DISK_UNLOCK="$(disk_unlock_status)"
DURESS="$(duress_status)"
SENSOR_STATE=null
[[ "${SETTING[AUDIT_LOG]:-on}" != off ]] && SENSOR_STATE="$(sensor_status)"
INTEGRITY_STATE=null
[[ "${SETTING[APP_INTEGRITY]:-off}" != off ]] && INTEGRITY_STATE="$(integrity_status)"
write_status() {
    jq -n --argjson checked "${NOW}" --argjson swept "${SWEPT:-null}" --argjson drift "${DRIFT:-null}" \
        --argjson setuid "${SETUID}" --argjson listeners "${LISTENING}" \
        --argjson network "$(network_status)" --argjson audit "${AUDIT:-null}" --argjson disk_unlock "${DISK_UNLOCK:-null}" \
        --argjson duress "${DURESS:-null}" --argjson sensor "${SENSOR_STATE:-null}" --argjson integrity "${INTEGRITY_STATE:-null}" \
        --argjson timings "$(for key in "${!TIMINGS[@]}"; do printf '%s\t%s\n' "${key}" "${TIMINGS[${key}]}"; done |
            jq -R 'split("\t") | {(.[0]): (.[1] | tonumber)}' | jq -s 'add // {}')" \
        '{$checked, $swept, $drift, $setuid, $listeners, $network, $audit, $disk_unlock, $duress, $sensor, $integrity, $timings}' >"${STATUS}.new" &&
        chmod 0644 "${STATUS}.new" && mv "${STATUS}.new" "${STATUS}"
}
# Written before the report runs, which reads it, and again after with the report's own time
write_status
if [[ "${SETTING[REPORT_ALERTS]:-on}" != off ]]; then
    timed REPORT_ALERTS read_report
    write_status
else
    # Turned on again, it compares from then
    rm -f "${STATE}/report.json" "${STATE}/tiles.json"
fi
# Last, so that it sees what every other part found in this run
if [[ "${SETTING[CHAINS]:-off}" == off ]]; then
    rm -f "${STATE}/chain-window" "${STATE}/chains-said"
else
    timed CHAINS switched CHAINS read_chains
fi
echo "${NOW}" >"${STATE}/last-run"

[[ ${#FINDINGS[@]} -gt 0 ]] || exit 0

STAMP="$(date -d "@${NOW}" '+%F %T')"
TOLD=()
URGENCY=normal
# What is about one account's own things alone, said to that account: its findings a line each
declare -A TOLD_TO=() URGENCY_TO=()
mkdir -p -m 0755 "${HISTORY%/*}"
for finding in "${FINDINGS[@]}"; do
    { read -r level; read -r key; read -r tell; IFS= read -r text; } < <(jq -r '.level, .key, (.tell // ""), .text' <<<"${finding}")
    printf '%s\n' "${finding}" >>"${HISTORY}"
    [[ "${level}" == quiet ]] && continue
    echo "${STAMP}  ${text}" >>"${UNREAD}"
    # NOTIFY: all, critical only, or none. Either way it waits in the unread list for the report.
    case "${SETTING[NOTIFY]:-all}" in
        none) continue ;;
        critical) [[ "${level}" == critical ]] || continue ;;
    esac
    if [[ -n "${tell}" ]]; then
        TOLD_TO["${tell}"]+="${text}"$'\n'
        [[ "${level}" == critical ]] && URGENCY_TO["${tell}"]=critical
        # An app of the account's own changed outside an update: the administrators are told as well
        [[ "${key}" == app-integrity ]] || continue
    fi
    TOLD+=("${text}")
    [[ "${level}" == critical ]] && URGENCY=critical
done
chmod 0600 "${HISTORY}" "${UNREAD}" 2>/dev/null
tail -n "${HISTORY_KEPT}" "${HISTORY}" >"${HISTORY}.new" && mv "${HISTORY}.new" "${HISTORY}"
# The newest findings for the Security app's Events page, newest first. They name accounts and files, so
# wheel can read them, as it can the journal, and nobody else.
if tail -n "${EVENTS_KEPT}" "${HISTORY}" | jq -s 'reverse' >"${EVENTS}.new" 2>/dev/null; then
    chgrp wheel "${EVENTS}.new" 2>/dev/null; chmod 0640 "${EVENTS}.new" && mv "${EVENTS}.new" "${EVENTS}"
fi
rm -f "${EVENTS}.new"
printf '%s\n' "${FINDINGS[@]}"

# One notification for a list of findings: the finding itself when there is one, the count and the first two
# when there are more. say URGENCY OPTION... -- FINDING...
say() {
    local urgency="$1" options=()
    shift
    while [[ $# -gt 0 && "$1" != -- ]]; do
        options+=("$1")
        shift
    done
    shift
    if [[ $# -eq 1 ]]; then
        "${NOTIFY}" --security "${options[@]}" "$1" "See it with: ame security events" "${urgency}" >/dev/null
    else
        "${NOTIFY}" --security "${options[@]}" "$# security changes on this machine" \
            "$(printf '%s\n' "${@:1:2}")"$'\n'"See them all with: ame security events" "${urgency}" >/dev/null
    fi
}
# Findings about one account's own things go to its sessions alone (amethystora-security-reader)
for user in "${!TOLD_TO[@]}"; do
    mapfile -t lines <<<"${TOLD_TO[${user}]%$'\n'}"
    say "${URGENCY_TO[${user}]:-normal}" --user "${user}" -- "${lines[@]}"
done
[[ ${#TOLD[@]} -gt 0 ]] || exit 0
# The rest name other accounts' files and launchers, which the events keep for wheel alone
say "${URGENCY}" --admins -- "${TOLD[@]}"
