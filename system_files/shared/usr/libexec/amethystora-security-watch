#!/usr/bin/bash
# The security watcher (amethystora-security-watch.timer: every 15 minutes, and at once while real-time
# watching is on). What Wazuh's agent does for a server, cut down to what one desktop with a read-only
# /usr needs, and with nothing sent anywhere:
#
#   - The audit log. The rules in /etc/audit/rules.d record writes to what would let something survive a
#     reboot or reach root, kernel modules loaded from a login, and programs opening input devices.
#     Each run reads what is new since the last, one checkpoint per key.
#   - The journal: accounts locked by faillock, wrong sudo and administrator passwords, and USB devices
#     USBGuard blocked. A few of those are someone typing badly; more is someone guessing.
#   - Network protection's alerts (amethystora-ips.service): each connection Suricata blocked, and what
#     it recognised without blocking. Kept for `ame security connections` and the Security app.
#   - What only root can see, written to status.json for the report: /etc compared with the image's own
#     copy of it in /usr/etc, setuid programs outside /usr (once a day), and which programs accept
#     connections from other machines.
#   - What each account's session finds first: a command in ~/.local/bin, ~/bin or Homebrew's prefix
#     named like one of the system's, and a launcher in the app grid that no container export made.
#     And a place in a home the audit rules watch that a link takes out of it, where they cannot.
#   - The report. Its checks live in /usr/libexec/amethystora-security-status and nowhere else. This runs
#     it and speaks up when a check it watches goes from fine to not, or changes while it is not fine,
#     the way Wazuh's configuration checks report a result only when it changes.
#
# The first run only records where things stand. After it, anything new is written to the history and,
# unless it is routine, to the unread list `ame security events` shows, with one notification a run.
#
# Each part is a switch of its own in /etc/amethystora/security.conf (`ame security settings` lists them):
# off, record (to the history, without a notification) or on. The watcher as a whole is WATCHER.
#
#   amethystora-security-watch           one run (amethystora-security-watch.service)
#   amethystora-security-watch --show    what is unread, then the end of the history
#   amethystora-security-watch --seen    mark everything read
#   amethystora-security-watch --keys    the audit keys it reads, for `ame security events`
#
# A finding carries its facts: when, its level, the part of the watcher that found it (an audit key, journal,
# listeners, user-paths, network, report, settings), the account it is about or "-", the ATT&CK tactic it
# belongs to or "-", and its sentence. The history keeps them as JSON lines (amethystora-security-events.jsonl,
# root's alone, the last 5000), and events.json the last 500 for the Security app's Events page, which the
# members of wheel can read. What somebody else wrote (a file name, a program's, a command line, a launcher's
# Exec= line) goes through amethystora-security-text before it is kept, said or shown anywhere.

set -uo pipefail

# AMETHYSTORA_WATCH_ROOT is for build_files/shared/test-security-watch.sh, which runs this against a stand-in
# /etc/passwd, /var/home, state and logs; a build must not write /var/lib or /var/log. AMETHYSTORA_WATCH_NOTIFY
# names a stand-in for amethystora-notify-users then, and is read only with a stand-in root.
ROOT="${AMETHYSTORA_WATCH_ROOT:-}"
NOTIFY=/usr/libexec/amethystora-notify-users
[[ -n "${ROOT}" && -n "${AMETHYSTORA_WATCH_NOTIFY:-}" ]] && NOTIFY="${AMETHYSTORA_WATCH_NOTIFY}"
STATE="${ROOT}/var/lib/amethystora/security"
STATUS="${STATE}/status.json"
EVENTS="${STATE}/events.json"
EVENTS_KEPT=500
UNREAD="${ROOT}/var/log/amethystora-security-events.new"
HISTORY="${ROOT}/var/log/amethystora-security-events.jsonl"
# The history before it held facts, one "date time  text" a line: shown once more, then left as it is
OLD_HISTORY="${ROOT}/var/log/amethystora-security-events.log"
HISTORY_KEPT=5000
# The setuid sweep reads every file under /etc and /var, home directories included
SWEEP_EVERY=$((24 * 3600))
AUDIT_KEYS=(identity privilege persistence hardening modules input-capture user-programs)
TEXT=/usr/libexec/amethystora-security-text

[[ "${EUID}" -eq 0 || "${1:-}" == --keys ]] || { echo "${0##*/} needs root." >&2; exit 77; }

case "${1:-}" in
    --show)
        if [[ -s "${UNREAD}" ]]; then
            echo "New since you last looked:"
            "${TEXT}" --lines <"${UNREAD}" | sed 's/^/  /'
        else
            echo "Nothing new since you last looked."
        fi
        if [[ -s "${HISTORY}" ]]; then
            echo
            echo "The last 20 in the history (${HISTORY}):"
            tail -n 20 "${HISTORY}" | jq -r '[(.time | strftime("%F %T")), .level, .text] | join("  ")' 2>/dev/null |
                "${TEXT}" --lines | sed 's/^/  /'
        elif [[ -s "${OLD_HISTORY}" ]]; then
            echo
            echo "The last 20 in the history (${OLD_HISTORY}):"
            tail -n 20 "${OLD_HISTORY}" | "${TEXT}" --lines | sed 's/^/  /'
        fi
        exit 0
        ;;
    --seen)
        [[ -e "${UNREAD}" ]] && : >"${UNREAD}"
        exit 0
        ;;
    --keys)
        (IFS='|'; echo "${AUDIT_KEYS[*]}")
        exit 0
        ;;
    "") ;;
    *)
        echo "usage: ${0##*/} [--show | --seen | --keys]" >&2
        exit 64
        ;;
esac

# Everything written here is root's alone, apart from status.json, which says so where it is written
umask 077
mkdir -p -m 0755 "${STATE}"
NOW="$(date +%s)"
LAST_RUN="$(cat "${STATE}/last-run" 2>/dev/null || true)"
[[ "${LAST_RUN}" =~ ^[0-9]+$ ]] || LAST_RUN=""

# Every part of this is a switch in /etc/amethystora/security.conf, read once: off, it is not read at all;
# record, what it finds goes to the history without a notification; on, it is said. WATCHER=off stops the
# whole run before it starts (ExecCondition= in the unit).
declare -A SETTING=()
while IFS='=' read -r key value; do
    SETTING["${key}"]="${value}"
done < <(/usr/libexec/amethystora-security-config --all)

# What this run found, one JSON object each: add LEVEL KEY ACCOUNT TACTIC TEXT. critical and normal are said
# out loud; quiet only goes to the history, for what is worth a record and not an interruption. While the
# part that found it is set to record, everything it finds is quiet. The text is made safe to show here, once,
# for the history, the unread list, events.json and the notification alike.
FINDINGS=()
MODE=on
add() {
    local level="$1" key="$2" account="$3" tactic="$4" text
    [[ "${MODE}" == record ]] && level=quiet
    [[ "${account}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@-]*$ && "${account}" != unset ]] || account=-
    text="$("${TEXT}" "$5")"
    FINDINGS+=("$(jq -nc --argjson time "${NOW}" --arg level "${level}" --arg key "${key}" --arg account "${account}" \
        --arg tactic "${tactic}" --arg text "${text}" '{$time, $level, $key, $account, $tactic, $text}')")
}

# Runs a part of the watcher unless its switch is off, with what it finds quiet while the switch is record
switched() {
    MODE="${SETTING[$1]:-on}"
    shift
    [[ "${MODE}" == off ]] || "$@"
    MODE=on
}

# When a switch's own command changed something (amethystora-security-config note), what the audit log
# recorded around then is that change: recorded, and not said. Two minutes from each note.
NOTED="$(cut -f1 "${STATE}/notes" 2>/dev/null | grep -E '^[0-9]+$' | tr '\n' ' ')"

# --- The audit log ------------------------------------------------------------------------------------

# The ATT&CK tactic a change under each key belongs to
declare -A AUDIT_TACTIC=(
    [identity]=Persistence [privilege]="Privilege Escalation" [persistence]=Persistence
    [hardening]="Defense Evasion" [modules]=Persistence [input-capture]=Collection [user-programs]=Persistence
)
declare -A AUDIT_WHAT=(
    [identity]="Accounts changed"
    [privilege]="Who may become root changed"
    [persistence]="What starts by itself changed"
    [hardening]="A security setting changed"
    [modules]="A kernel module was loaded or removed"
    [input-capture]="A program read the keyboard or another input device directly"
    [user-programs]="A command or launcher in a home folder changed"
)
# Changing accounts is these programs' job: a new password is not news
ACCOUNT_TOOLS=" /usr/bin/passwd /usr/sbin/useradd /usr/sbin/usermod /usr/sbin/userdel /usr/sbin/groupadd \
/usr/sbin/groupmod /usr/sbin/groupdel /usr/bin/gpasswd /usr/sbin/chpasswd /usr/bin/chage \
/usr/libexec/accounts-daemon /usr/bin/systemd-sysusers "
# Programs already seen opening input devices: the first time is news, the hundredth is a game
INPUT_SEEN="${STATE}/input-programs"

# ausearch --format text writes one sentence an event: "At 10:02:03 09/26/2026 alice, acting as root,
# successfully opened-file /etc/sudoers using /usr/bin/vim". Its dates are in the locale's %x, so every
# call runs in the C locale and every date passed to it is written in that locale too.
#
# Only SYSCALL events, which is what every rule here records. The kernel also notes each rule it loads
# as a CONFIG_CHANGE carrying that rule's key, and those would read as "add_rule identity using
# auditctl", once per rule at every boot. The rules cannot change after that: -e 2 locks them.
audit_events() {
    local key="$1" checkpoint="${STATE}/audit-$1.checkpoint" output status day time
    if [[ -s "${checkpoint}" ]]; then
        output="$(LC_ALL=C ausearch --checkpoint "${checkpoint}" -m SYSCALL -k "${key}" --format text \
            2>/dev/null)"
        status=$?
        # The event the checkpoint names has rotated out of the log: carry on from its time instead
        if [[ ${status} -ge 10 && ${status} -le 12 ]]; then
            output="$(LC_ALL=C ausearch --checkpoint "${checkpoint}" --start checkpoint -m SYSCALL -k "${key}" \
                --format text 2>/dev/null)"
        fi
    else
        # No event under this key yet: everything since the last run, which also makes the checkpoint
        read -r day time <<<"$(LC_ALL=C date -d "@${LAST_RUN:-${NOW}}" '+%x %T')"
        output="$(LC_ALL=C ausearch --checkpoint "${checkpoint}" --start "${day}" "${time}" -m SYSCALL \
            -k "${key}" --format text 2>/dev/null)"
    fi
    chmod 0600 "${checkpoint}" 2>/dev/null
    # One line for each different thing that happened, however many times it did, each marked "noted"
    # when it happened within two minutes of a switch's own command and "-" otherwise. The times are the
    # local ones ausearch writes, which mktime reads as local too.
    awk -v noted="${NOTED}" '
        BEGIN { count = split(noted, times, " ") }
        /^At [0-9:]+ [0-9\/]+ / {
            split($2, t, ":")
            split($3, d, "/")
            year = d[3] < 100 ? d[3] + 2000 : d[3]
            when = mktime(year " " d[1] " " d[2] " " t[1] " " t[2] " " t[3])
            mark = "-"
            for (i = 1; i <= count; i++) {
                if (when >= times[i] - 5 && when <= times[i] + 120) mark = "noted"
            }
            line = $0
            sub(/^At [^ ]+ [^ ]+ /, "", line)
            print mark " " line
        }' <<<"${output}" | sort | uniq -c
}

read_audit() {
    local key count mark event exe level text
    for key in "${AUDIT_KEYS[@]}"; do
        MODE="${SETTING[$(tr 'a-z-' 'A-Z_' <<<"${key}")]:-on}"
        if [[ "${MODE}" == off ]]; then
            # Turned on again, it starts from that run rather than reading everything since it went off
            rm -f "${STATE}/audit-${key}.checkpoint"
            continue
        fi
        while read -r count mark event; do
            [[ -n "${event}" ]] || continue
            exe=""
            [[ "${event}" == *" using "* ]] && exe="${event##* using }"
            case "${key}" in
                identity) [[ -n "${exe}" && "${ACCOUNT_TOOLS}" == *" ${exe} "* ]] && level=quiet || level=normal ;;
                privilege | modules) level=critical ;;
                # Installing anything with pip or a container export writes here. What matters among it,
                # a name the system's own commands have, read_user_paths below says out loud.
                user-programs) level=quiet ;;
                input-capture)
                    level=quiet
                    if [[ -n "${exe}" ]] && ! grep -qxF -- "${exe}" "${INPUT_SEEN}" 2>/dev/null; then
                        echo "${exe}" >>"${INPUT_SEEN}"
                        level=normal
                    fi
                    ;;
                *) level=normal ;;
            esac
            [[ "${mark}" == noted ]] && level=quiet
            text="${AUDIT_WHAT[${key}]}: ${event}"
            [[ "${count}" -gt 1 ]] && text+=" (${count} times)"
            # The first run has no "since": it only makes the checkpoints
            # The account is the sentence's first word: "alice, acting as root, ..."
            [[ -n "${LAST_RUN}" ]] && add "${level}" "${key}" "${event%%,*}" "${AUDIT_TACTIC[${key}]}" "${text}"
        done < <(audit_events "${key}")
    done
    MODE=on
}

# --- The journal --------------------------------------------------------------------------------------

read_journal() {
    local cursor="${STATE}/journal.cursor" line user
    local -A locked=() wrong=()
    local polkit=0 usb=0
    if [[ ! -s "${cursor}" ]]; then
        journalctl -q -n1 --cursor-file="${cursor}" >/dev/null 2>&1
        chmod 0600 "${cursor}" 2>/dev/null
        return
    fi
    # auth and authpriv (sudo, and pam_faillock in whichever program asked for the password), polkitd,
    # and the kernel (USB devices refused)
    while IFS= read -r line; do
        if [[ "${line}" =~ pam_faillock\(([^:\)]+)[^\)]*\):\ Consecutive\ login\ failures\ for\ user\ ([^ ]+) ]]; then
            locked["${BASH_REMATCH[2]}"]="${BASH_REMATCH[1]}"
        elif [[ "${line}" =~ sudo\[[0-9]+\]:\ +([^ ]+)\ :\ ([0-9]+)\ incorrect\ password\ attempt ]]; then
            user="${BASH_REMATCH[1]}"
            wrong["${user}"]=$((${wrong[${user}]:-0} + BASH_REMATCH[2]))
        elif [[ "${line}" == *"FAILED to authenticate to gain authorization"* ]]; then
            polkit=$((polkit + 1))
        elif [[ "${line}" == *"Device is not authorized for usage"* ]]; then
            usb=$((usb + 1))
        fi
    done < <(journalctl -q --no-pager -o short-iso --cursor-file="${cursor}" \
        SYSLOG_FACILITY=4 SYSLOG_FACILITY=10 + SYSLOG_IDENTIFIER=polkitd + _TRANSPORT=kernel 2>/dev/null)

    for user in "${!locked[@]}"; do
        add critical journal "${user}" "Credential Access" "The account ${user} was locked after too many wrong passwords in a row (${locked[${user}]}). Unlock it early with: sudo faillock --user ${user} --reset"
    done
    for user in "${!wrong[@]}"; do
        [[ "${wrong[${user}]}" -ge 3 ]] && level=normal || level=quiet
        add "${level}" journal "${user}" "Credential Access" "${wrong[${user}]} wrong password(s) for sudo, as ${user}"
    done
    [[ "${polkit}" -ge 3 ]] && add normal journal - "Credential Access" "${polkit} administrator password prompts were answered wrongly"
    [[ "${usb}" -gt 0 ]] && add normal journal - "Initial Access" "USB protection blocked ${usb} USB device(s). Allow one with: ame security usb allow"
}

# --- /etc against the image ---------------------------------------------------------------------------

# Where the settings that decide this machine's security live. ostree keeps /etc as the image shipped it
# in /usr/etc, so what differs is exactly what changed on this machine.
DRIFT_PATHS=(amethystora audit authselect brave/policies chromium/policies clamd.d containers/policy.json
    containers/registries.d containers/systemd environment fail2ban firefox/policies firewalld
    flatpak/overrides ld.so.conf ld.so.conf.d opt/chrome/policies opt/edge/policies
    ld.so.preload modprobe.d modules-load.d pam.d pki/akmods/certs pki/ca-trust/source pki/containers
    polkit-1/rules.d profile profile.d rc.d/rc.local security ssh/sshd_config ssh/sshd_config.d sudoers
    sudoers.d sysctl.conf sysctl.d tmpfiles.d udev/rules.d usbguard xdg/autostart)
# ...less what the image's own recipes and services write there as a matter of course
EXPECTED_DRIFT=" amethystora/security.conf amethystora/ips-allowed amethystora/browser-extensions \
amethystora/hardening-off amethystora/allow.d/report \
audit/audit.rules audit/audit.rules.prev audit/rules.d/60-amethystora.rules audit/rules.d/61-amethystora-home.rules \
brave/policies/managed/10-amethystora.json chromium/policies/managed/10-amethystora.json \
firefox/policies/policies.json modprobe.d/tuned.conf opt/chrome/policies/managed/10-amethystora.json \
opt/edge/policies/managed/10-amethystora.json security/opasswd usbguard/rules.conf \
usbguard/usbguard-daemon.conf "
# A file in /etc takes the place of the one of the same name in /usr/lib entirely
SHADOWED=(sysctl.d:/usr/lib/sysctl.d modprobe.d:/usr/lib/modprobe.d modules-load.d:/usr/lib/modules-load.d
    tmpfiles.d:/usr/lib/tmpfiles.d udev/rules.d:/usr/lib/udev/rules.d firewalld/zones:/usr/lib/firewalld/zones
    polkit-1/rules.d:/usr/share/polkit-1/rules.d systemd/system:/usr/lib/systemd/system)
# ...and for systemd, only the units the security of the machine rests on
SECURITY_UNITS='^(auditd|fail2ban|firewalld|clamd@.*|clamav-.*|amethystora-.*|uupd.*|usbguard|rpm-ostreed.*|bootc-.*|polkit|systemd-journald)\.(service|timer|socket)$'

# One "change<TAB>path<TAB>detail" a line: added, changed, removed, replaces, overrides or masks
drift() {
    local pair dir lib etc name rel usr unit kind domain=false
    local -A shadows=() masks=() files=()
    # A machine that joined a domain has authselect's sssd or winbind profile with every feature of the
    # image's, which realmd set through amethystora-domain-logins, and pam_winbind's settings realmd
    # writes. That is the image's setup for a domain: a feature turned off, or a file edited by hand, is not.
    /usr/libexec/amethystora-domain-logins check && domain=true
    # What the owner turned off with the prevention switches (ame security kernel, firewall, lockout...):
    # exactly the files the switch writes, which amethystora-hardening names, and nothing in between
    while IFS=$'\t' read -r rel kind; do
        [[ "${kind}" == mask ]] && masks["${rel}"]=1
        [[ "${kind}" == file ]] && files["${rel}"]=1
    done < <(/usr/libexec/amethystora-hardening managed 2>/dev/null)
    for pair in "${SHADOWED[@]}"; do
        dir="/etc/${pair%%:*}"
        lib="${pair#*:}"
        for etc in "${dir}"/*; do
            name="${etc##*/}"
            [[ -e "${lib}/${name}" && ! ( -d "${etc}" && ! -L "${etc}" ) ]] || continue
            [[ "${pair}" == systemd/system:* && ! "${name}" =~ ${SECURITY_UNITS} ]] && continue
            # What the image itself ships there is its own choice
            [[ -e "/usr/etc/${etc#/etc/}" ]] && cmp -s "${etc}" "/usr/etc/${etc#/etc/}" && continue
            if [[ -n "${masks[${etc#/etc/}]+set}" && "$(readlink "${etc}")" == /dev/null ]]; then
                shadows["${etc}"]=1
                continue
            fi
            if [[ "$(readlink "${etc}")" == /dev/null ]]; then
                printf 'masks\t%s\t%s\n' "${etc}" "${name}"
            else
                printf 'replaces\t%s\t%s\n' "${etc}" "${lib}/${name}"
            fi
            shadows["${etc}"]=1
        done
    done
    # Drop-ins change a unit without replacing it: `systemctl edit auditd` is one
    for etc in /etc/systemd/system/*.d/*.conf; do
        [[ -e "${etc}" ]] || continue
        unit="$(basename "$(dirname "${etc}")")"
        unit="${unit%.d}"
        [[ "${unit}" =~ ${SECURITY_UNITS} ]] || continue
        [[ -e "/usr/etc/${etc#/etc/}" ]] && cmp -s "${etc}" "/usr/etc/${etc#/etc/}" && continue
        printf 'overrides\t%s\t%s\n' "${etc}" "${unit}"
    done

    for rel in "${DRIFT_PATHS[@]}"; do
        find "/etc/${rel}" "/usr/etc/${rel}" \( -type f -o -type l \) 2>/dev/null
    done | sed 's#^/usr/etc/#/etc/#' | sort -u | while IFS= read -r etc; do
        rel="${etc#/etc/}"
        usr="/usr/etc/${rel}"
        [[ "${EXPECTED_DRIFT}" == *" ${rel} "* || -n "${shadows[${etc}]+set}" ]] && continue
        [[ "${domain}" == true && ( "${rel}" =~ ^authselect/[^/]+$ || "${rel}" == security/pam_winbind.conf ) ]] &&
            continue
        # One-time codes for SSH exactly as amethystora-ssh-codes sets them, and nothing in between
        [[ "${rel}" == pam.d/sshd && -f "${usr}" ]] &&
            cmp -s "${etc}" <(/usr/libexec/amethystora-ssh-codes pam <"${usr}") && continue
        [[ "${rel}" == ssh/sshd_config.d/30-amethystora-ssh-codes.conf ]] &&
            cmp -s "${etc}" "/usr/share/amethystora/ssh-codes/${rel##*/}" && continue
        [[ -n "${files[${rel}]+set}" ]] &&
            cmp -s "${etc}" <(/usr/libexec/amethystora-hardening expected "${rel}") && continue
        if [[ ! -e "${usr}" && ! -L "${usr}" ]]; then
            printf 'added\t%s\t\n' "${etc}"
        elif [[ ! -e "${etc}" && ! -L "${etc}" ]]; then
            printf 'removed\t%s\t\n' "${etc}"
        elif [[ -L "${etc}" || -L "${usr}" ]]; then
            [[ "$(readlink "${etc}")" == "$(readlink "${usr}")" ]] || printf 'changed\t%s\t\n' "${etc}"
        elif ! cmp -s "${etc}" "${usr}"; then
            printf 'changed\t%s\t\n' "${etc}"
        fi
    done
}

# --- setuid programs outside the image ----------------------------------------------------------------

# /usr is the image's, and every setuid program the image has is there. One anywhere else was put there
# on this machine. Container storage is left out: it holds other distributions' sudo and su, which only
# ever run inside their containers.
sweep_setuid() {
    find /etc /var -xdev \
        \( -path /var/lib/containers -o -path /var/lib/docker -o -path /var/lib/flatpak \
        -o -path '/var/home/*/.local/share/containers' -o -path '/var/home/*/.local/share/flatpak' \) -prune -o \
        -type f \( -perm -4000 -o -perm -2000 \) -print 2>/dev/null | sort
}
sweep_to_list() { sweep_setuid >"${STATE}/setuid.list"; }
drift_to_json() { DRIFT="$(drift | jq -R 'split("\t") | {change: .[0], path: .[1], detail: .[2]}' | jq -s .)"; }

# --- Programs that accept connections -----------------------------------------------------------------

# TCP listeners on anything but the loopback address, one "port<TAB>address<TAB>program" a line. The
# tailnet is trusted by the firewall, so every one of these can be reached from every device on it.
# UDP is left out: most of what shows there is programs' own outgoing sockets, on new ports each time.
listeners() {
    ss -Htlnp 2>/dev/null | awk '
        {
            port = $4; sub(/.*:/, "", port)
            address = $4; sub(/:[^:]*$/, "", address)
            if (address ~ /^(127\.|\[::1\]|\[::ffff:127\.)/ || address ~ /%lo$/) next
            program = "?"
            if (match($0, /users:\(\("[^"]+"/)) program = substr($0, RSTART + 9, RLENGTH - 10)
            print port "\t" address "\t" program
        }' | sort -u -t$'\t' -k1,1n -k3,3
}

# A program listening on a port for the first time is news. Ports from the ephemeral range are chosen
# anew at every start, so for those the program is what is remembered, not the number.
read_listeners() {
    local seen="${STATE}/listeners-seen" low high port address program key
    read -r low high </proc/sys/net/ipv4/ip_local_port_range 2>/dev/null || { low=32768; high=60999; }
    while IFS=$'\t' read -r port address program; do
        [[ "${port}" =~ ^[0-9]+$ ]] || continue
        key="${program} ${port}"
        [[ "${port}" -ge "${low}" && "${port}" -le "${high}" ]] && key="${program} ephemeral"
        grep -qxF -- "${key}" "${seen}" 2>/dev/null && continue
        echo "${key}" >>"${seen}"
        [[ -n "${LAST_RUN}" ]] &&
            add normal listeners - "Command and Control" "${program} accepts connections on port ${port} (${address}), which every device on your tailnet can reach"
    done <<<"${LISTENERS}"
}

# --- What a session finds first -----------------------------------------------------------------------

# A shell looks in ~/.local/bin and ~/bin before /usr/bin, so a program called sudo there runs in place
# of the real one, and asks for the password the real one would: the oldest way to catch it. A command
# with a system command's name is said when it appears and whenever it changes, out loud when the name
# is one that asks for a password or a key. Homebrew's prefix comes before /usr/bin too, and whoever set
# Homebrew up can write to it, but there a name like the system's is mostly what was installed on
# purpose (git, curl, Python), so only those that ask for a password or a key are said.
#
# A launcher in the app grid's folder of an account is said once when no container export made it:
# distrobox writes those, as amethystora-pkg asks it to, and the image's own web apps are there too.
PASSWORD_COMMANDS=" sudo su pkexec run0 doas passwd login ssh scp sftp ssh-add ssh-agent ssh-keygen gpg gpg2 \
gpg-agent pinentry secret-tool "

# Every account with a home here, as passwd lines: those in /etc/passwd, and those of a domain (SSSD or
# winbind), which are not in it, by their home folders in /var/home. As amethystora-audit-home-rules
# finds them, which runs before anything could look them up.
accounts() {
    {
        cat "${ROOT}/etc/passwd"
        for home in "${ROOT}"/var/home/*/; do
            [[ -d "${home}" ]] && printf '%s:x:%s:::%s:\n' "$(basename "${home}")" "$(stat -c %u "${home}")" "${home%/}"
        done
    } | awk -F: '!seen[$3]++'
}

read_user_paths() {
    local seen="${STATE}/user-paths-seen" first=false user uid home dir file name level key line where
    local path part component target shown odd='[^[:alnum:]._/@+-]'
    local -a parts home_paths
    mapfile -t home_paths < <(/usr/libexec/amethystora-audit-home-rules --paths 2>/dev/null)
    # The first run of this check only records where things stand, on a machine with years of them
    [[ -e "${seen}" ]] || first=true
    touch "${seen}"
    remember() {
        grep -qxF -- "$1" "${seen}" && return 1
        echo "$1" >>"${seen}"
        [[ "${first}" != true ]]
    }
    # Root reads what an account put in its home: only a plain file, never through a link, and never for long
    # or much. A launcher made a link to /proc/kmsg, which says it is a regular file, kept an earlier
    # version waiting until the next boot.
    plain() { [[ -f "$1" && ! -L "$1" ]]; }
    head_of() { timeout 5 head -c "${2:-65536}" -- "$1" 2>/dev/null; }
    hash_of() { head_of "$1" 16777216 | sha256sum | cut -c1-16; }
    while IFS=: read -r user _ uid _ _ home _; do
        # Not system accounts, nor nobody. A domain's are numbered from far above nobody's 65534.
        [[ "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue
        for dir in "${home}/.local/bin" "${home}/bin"; do
            # A folder a link takes out of the home is said below, not read
            [[ "$(realpath -e -- "${dir}" 2>/dev/null)" == "${home}"/* ]] || continue
            for file in "${dir}"/*; do
                plain "${file}" && [[ -x "${file}" ]] || continue
                name="${file##*/}"
                [[ -e "/usr/bin/${name}" || -e "/usr/sbin/${name}" ]] || continue
                remember "${file} $(hash_of "${file}")" || continue
                [[ "${PASSWORD_COMMANDS}" == *" ${name} "* ]] && level=critical || level=normal
                where=""
                grep -qx '# distrobox_binary' <<<"$(head_of "${file}")" && where=", exported from a container"
                add "${level}" user-paths "${user}" Persistence "~${user}${file#"${home}"} is run in place of the system's ${name} by ${user}${where}"
            done
        done
        [[ "$(realpath -e -- "${home}/.local/share/applications" 2>/dev/null)" == "${home}"/* ]] &&
        for file in "${home}/.local/share/applications"/*.desktop; do
            plain "${file}" || continue
            line="$(head_of "${file}" | grep -m1 '^Exec=')"
            [[ "${line}" =~ ^Exec=(/usr/bin/)?(distrobox-enter|distrobox\ enter)\  ||
                "${line}" == "Exec=amethystora-webapp "* ]] && continue
            remember "${file} $(sha256sum <<<"${line}" | cut -c1-16)" || continue
            add normal user-paths "${user}" Persistence "A launcher no container export made is in ${user}'s app grid: ~${user}${file#"${home}"}, which runs ${line#Exec=}"
        done
        # A place the per-home audit rules watch, taken out of the home by a link: they write no watch
        # through one, so what starts from there goes unseen. Only lstat and readlink, never a read.
        for path in "${home_paths[@]}"; do
            part="${home}"
            IFS=/ read -ra parts <<<"${path}"
            for component in "${parts[@]}"; do
                part+="/${component}"
                [[ -L "${part}" ]] || continue
                target="$(realpath -m -- "${part}" 2>/dev/null)"
                [[ "${target}" == "${home}"/* && ! "${target}" =~ ${odd} ]] && continue
                # The account chose where it leads: only plain characters of it reach a notification
                shown="${target//${odd}/?}"
                remember "${part} -> ${target}" &&
                    add normal user-paths "${user}" "Defense Evasion" "~${user}${part#"${home}"} is a link out of ${user}'s home folder, to ${shown:-nowhere}: the audit log no longer watches what is put there"
                break
            done
        done
    done < <(accounts)
    for dir in /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin; do
        for file in "${dir}"/*; do
            name="${file##*/}"
            [[ "${PASSWORD_COMMANDS}" == *" ${name} "* && -x "${file}" ]] || continue
            # Homebrew's commands are links into its Cellar, so a link is read here, but only for so long
            remember "${file} $(hash_of "${file}")" || continue
            add critical user-paths - Persistence "${file} is run in place of the system's ${name} by everyone whose shell loads Homebrew"
        done
    done
}

# --- Network protection -------------------------------------------------------------------------------

# Suricata writes its alerts to eve.json and nowhere else (amethystora-ips.service): what it blocked, and
# what it recognised on a rule that only alerts. Each run reads what is new since the last. The newest
# are kept in network.json, one entry for each rule and pair of addresses, for `ame security connections`
# and the Security app. They name the sites this machine talked to, so wheel can read them, as it can the
# journal, and nobody else. A log rotated between two runs loses what the first did not read of it,
# which real-time watching, following eve.json while network protection is on, keeps to seconds.
EVE=/var/log/suricata/eve.json
NETWORK_EVENTS="${STATE}/network.json"
NETWORK_KEPT=200
# One alert, as network.json keeps it. Suricata writes local times: 2026-09-27T10:02:03.123456+0200.
ALERT_FILTER='
def seconds: capture("^(?<t>[0-9-]+T[0-9:]+)(\\.[0-9]+)?(?<s>[+-])(?<h>[0-9]{2}):?(?<m>[0-9]{2})$")
    | (.t + "Z" | fromdateiso8601) - (if .s == "+" then 1 else -1 end) * ((.h | tonumber) * 3600 + (.m | tonumber) * 60);
fromjson? | select(.event_type == "alert") | {
    time: ((.timestamp | try seconds catch null) // now | floor),
    action: (.alert.action // "allowed"),
    sid: .alert.signature_id,
    signature: (.alert.signature // "an unnamed rule"),
    category: (.alert.category // ""),
    severity: (.alert.severity // 3),
    proto: (.proto // ""),
    src: .src_ip,
    dest: .dest_ip,
    port: .dest_port,
    host: ([(.tls.sni), (.http.hostname), ((.dns.query? // .dns.queries?) | arrays | .[0].rrname?)]
        | map(select(type == "string" and . != "")) | first)
}'

read_network() {
    local position="${STATE}/eve.position" chunk="${STATE}/eve.chunk" inode size last="" offset=0
    [[ -f "${EVE}" ]] || return 0
    inode="$(stat -c %i "${EVE}")"
    size="$(stat -c %s "${EVE}")"
    { read -r last offset <"${position}"; } 2>/dev/null
    # A log rotated away, or cut short, is read from its beginning
    [[ "${last}" == "${inode}" && "${offset}" =~ ^[0-9]+$ && "${offset}" -le "${size}" ]] || offset=0
    tail -c "+$((offset + 1))" "${EVE}" | head -c "$((size - offset))" >"${chunk}"
    # Whole lines only: the last one may still be being written, and is read next time
    if [[ -s "${chunk}" && "$(tail -c 1 "${chunk}" | od -An -tx1 | tr -d ' ')" != 0a ]]; then
        sed -i '$d' "${chunk}"
    fi
    echo "${inode} $((offset + $(stat -c %s "${chunk}")))" >"${position}"
    jq -cR "${ALERT_FILTER}" "${chunk}" >"${chunk}.alerts" 2>/dev/null
    rm -f "${chunk}"

    # One line for each rule, however many times and between however many addresses it went off. A
    # block is said out loud with the way to undo it; an alert that let something through only when
    # the rule rates it serious.
    [[ -n "${LAST_RUN}" ]] && while IFS=$'\t' read -r level text; do
        add "${level}" network - "Command and Control" "${text}"
    done < <(jq -rs '
        group_by([.action, .sid]) | .[]
        | (map(.host // "\(.src) and \(.dest)") | unique) as $peers | .[0] as $a | length as $times
        | [(if $a.action == "blocked" then (if $a.severity == 1 then "critical" else "normal" end)
            elif $a.severity == 1 then "normal" else "quiet" end),
           ((if $a.action == "blocked" then "Network protection blocked " else "Network protection noticed " end)
            + $a.signature + " (" + $peers[0]
            + (if ($peers | length) > 1 then " and \(($peers | length) - 1) more" else "" end)
            + (if $times > 1 then ", \($times) times" else "" end) + ")"
            + (if $a.action == "blocked"
               then ". If that was yours and wanted, allow it again with: ame security connections allow \($a.sid)"
               else ", and let it through" end))]
        | @tsv' "${chunk}.alerts")

    if jq -s --slurpfile kept <(cat "${NETWORK_EVENTS}" 2>/dev/null || echo '[]') --argjson most "${NETWORK_KEPT}" '
        (($kept[0] // []) + map(. + {count: 1, first: .time}))
        | group_by([.action, .sid, .src, .dest, .port])
        | map(reduce .[1:][] as $e (.[0];
            .count += $e.count | .first = ([.first, $e.first] | min) | .time = ([.time, $e.time] | max)
            | .host //= $e.host))
        | sort_by(-.time) | .[:$most]' "${chunk}.alerts" >"${NETWORK_EVENTS}.new"; then
        chgrp wheel "${NETWORK_EVENTS}.new" && chmod 0640 "${NETWORK_EVENTS}.new" &&
            mv "${NETWORK_EVENTS}.new" "${NETWORK_EVENTS}"
    fi
    rm -f "${chunk}.alerts" "${NETWORK_EVENTS}.new"
}

# What the report says about network protection and cannot see for itself: whether the table that sends
# Suricata the traffic is there, when the rules were last built, and how much it blocked in a week
network_status() {
    local blocked=0 rules table=false
    [[ -s "${NETWORK_EVENTS}" ]] && blocked="$(jq --argjson since "$((NOW - 7 * 86400))" \
        '[.[] | select(.action == "blocked" and .time >= $since) | .count] | add // 0' "${NETWORK_EVENTS}" 2>/dev/null)"
    rules="$(stat -c %Y /var/lib/suricata/rules/suricata.rules 2>/dev/null)"
    nft list table inet amethystora-ips >/dev/null 2>&1 && table=true
    jq -n --argjson blocked "${blocked:-0}" --argjson rules "${rules:-null}" --argjson table "${table}" \
        '{$blocked, $rules, $table}'
}

# --- The report ---------------------------------------------------------------------------------------

# The checks this speaks up about: the ones that say something was turned off or tampered with. Those
# that only age (signatures, the image), and those that already raise their own alarm, are left out.
# The security watcher's own check counts only when it is "check" (a run that failed or stalled, said by the
# next one that does not); "off" there means what it found is unread, which it has said already.
WATCHED_CHECKS='["signed-updates","lockdown","automatic-updates","audit-log","audit-rules","fail2ban",
"firewall","network","image-settings","rootkit","virus-scan-schedule","settings-audit","security-watcher","selinux"]'

# Whether a switch's own command made a change since the last run (amethystora-security-config note), for any
# of the names given: then that change was the person at the machine, and is recorded rather than said
noted() {
    local since="${LAST_RUN:-$((NOW - 1800))}" name
    for name in "$@"; do
        awk -F'\t' -v since="$((since - 5))" -v name="${name}" '$1 >= since && ($2 == name || index($2, name ":") == 1) { found = 1 }
            END { exit !found }' "${STATE}/notes" 2>/dev/null && return 0
    done
    return 1
}

read_report() {
    local report now before tiles was id state title level
    report="$(/usr/libexec/amethystora-security-status --json 2>/dev/null)" || return
    now="$(jq -c '[.checks[] | select(.group != "optional") | {id, state, text, details}]' <<<"${report}" 2>/dev/null)"
    tiles="$(jq -c '[.checks[] | select(.group == "optional") | {id, state, title}]' <<<"${report}" 2>/dev/null)"
    [[ -n "${now}" ]] || return
    # A protection turned off with no switch of the image's own, such as encrypted DNS or USB protection, is
    # said once, unless its own command did it; one turned on is only recorded
    was="$(cat "${STATE}/tiles.json" 2>/dev/null)"
    printf '%s\n' "${tiles:-[]}" >"${STATE}/tiles.json"
    if [[ -n "${was}" ]]; then
        while IFS=$'\t' read -r id state title; do
            level=normal
            noted "${id}" "${id%-protection}" "${id}-scan" "${id}-watch" && level=quiet
            [[ "${state}" == on ]] && level=quiet
            add "${level}" report - "Defense Evasion" "${title} was turned ${state}"
        done < <(jq -r --argjson was "${was}" '
            (reduce $was[] as $tile ({}; .[$tile.id] = $tile.state)) as $before
            | .[] | select($before[.id] != null and $before[.id] != .state and (.state | IN("on", "off"))
                and ($before[.id] | IN("on", "off")))
            | [.id, .state, .title] | @tsv' <<<"${tiles:-[]}")
    fi
    before="$(cat "${STATE}/report.json" 2>/dev/null)"
    printf '%s\n' "${now}" >"${STATE}/report.json"
    [[ -n "${before}" ]] || return
    while IFS=$'\t' read -r state text details; do
        [[ "${state}" == off ]] && level=critical || level=normal
        add "${level}" report - "Defense Evasion" "${text}${details:+. ${details}}"
    # A list that grows (another setuid program, another changed file) is news while the check is
    # already failing. A count of days going up is not, so the others count only when their state does.
    done < <(jq -r --argjson before "${before}" --argjson watched "${WATCHED_CHECKS}" '
        (reduce $before[] as $check ({}; .[$check.id] = $check)) as $was
        | .[]
        | select(.id | IN($watched[]))
        | select(.state == "check" or .state == "off")
        | select(.id != "security-watcher" or .state == "check")
        | select($was[.id] == null or $was[.id].state != .state
            or ((.id | IN("image-settings", "rootkit")) and $was[.id].details != .details))
        | [.state, .text, (.details | join(" "))] | @tsv' <<<"${now}")
}

# --- The switches themselves --------------------------------------------------------------------------

# A security setting changed in /etc/amethystora/security.conf, or one of what the image enforces turned off
# (/etc/amethystora/hardening-off), named with what it changed to. The audit log says which program wrote
# the file; this says what it now means. A change its own switch made is recorded, not said.
read_settings() {
    local now was key value old
    now="$(/usr/libexec/amethystora-security-config --all | sort)"
    was="$(cat "${STATE}/settings.seen" 2>/dev/null)"
    printf '%s\n' "${now}" >"${STATE}/settings.seen"
    if [[ -n "${was}" ]]; then
        while IFS='=' read -r key value; do
            old="$(sed -n "s/^${key}=//p" <<<"${was}")"
            [[ -n "${old}" && "${old}" != "${value}" ]] || continue
            level=normal
            noted "$(tr 'A-Z_' 'a-z-' <<<"${key}")" profile realtime && level=quiet
            add "${level}" settings - "Defense Evasion" "The security setting ${key} changed from ${old} to ${value} (/etc/amethystora/security.conf)"
        done <<<"${now}"
    fi
    now="$(sort "${ROOT}/etc/amethystora/hardening-off" 2>/dev/null)"
    [[ -e "${STATE}/hardening.seen" ]] || { printf '%s\n' "${now}" >"${STATE}/hardening.seen"; return; }
    was="$(cat "${STATE}/hardening.seen")"
    printf '%s\n' "${now}" >"${STATE}/hardening.seen"
    while IFS= read -r key; do
        [[ -n "${key}" ]] || continue
        level=normal
        noted "${key%% *}" && level=quiet
        add "${level}" settings - "Defense Evasion" "${key} was turned off, of what the image enforces (ame security ${key%% *})"
    done < <(comm -13 <(printf '%s\n' "${was}" | sed '/^$/d') <(printf '%s\n' "${now}" | sed '/^$/d'))
}

# --- What the audit log lost ---------------------------------------------------------------------------

# The kernel drops an audit event rather than make anything wait when its backlog is full
# (--backlog_wait_time 0, 99-amethystora-finalize.rules), and counts what it dropped. Only root can ask, so
# the drops of the last week go into status.json for the report's "Audit rules" check, which says them. The
# count starts again at every boot.
audit_status() {
    local status enabled lost previous since drops="${STATE}/audit-drops"
    status="$(auditctl -s 2>/dev/null)" || { echo null; return; }
    enabled="$(awk '$1 == "enabled" { print $2 }' <<<"${status}")"
    lost="$(awk '$1 == "lost" { print $2 }' <<<"${status}")"
    [[ "${enabled}" =~ ^[0-9]+$ && "${lost}" =~ ^[0-9]+$ ]] || { echo null; return; }
    read -r previous since <"${STATE}/audit-lost" 2>/dev/null
    [[ "${previous}" =~ ^[0-9]+$ && "${previous}" -le "${lost}" ]] || previous=0
    [[ "${lost}" -gt "${previous}" ]] && echo "${NOW} $((lost - previous))" >>"${drops}"
    echo "${lost} ${NOW}" >"${STATE}/audit-lost"
    # A week of them, one "time count" a line
    awk -v since="$((NOW - 7 * 86400))" '$1 >= since' "${drops}" 2>/dev/null >"${drops}.new"
    mv "${drops}.new" "${drops}" 2>/dev/null
    jq -n --argjson enabled "${enabled}" --argjson drops "$(jq -R 'split(" ") | {time: (.[0] | tonumber), count: (.[1] | tonumber)}' "${drops}" | jq -s .)" \
        '{$enabled, $drops}'
}

# --- A run --------------------------------------------------------------------------------------------

# What each part took, in milliseconds, under the key of its switch: status.json carries them, and the
# Settings page shows each beside its switch
declare -A TIMINGS=()
timed() {
    local key="$1" start="${EPOCHREALTIME//[.,]/}"
    shift
    "$@"
    TIMINGS["${key}"]=$(((${EPOCHREALTIME//[.,]/} - start) / 1000))
}

# Each part is skipped while its switch is off. The ones that keep a place to read on from forget it, so
# that turned on again they start from then, not from everything since they were turned off.
if [[ "${SETTING[AUDIT_LOG]:-on}" != off ]]; then
    timed AUDIT_LOG read_audit
fi
timed HARDENING switched HARDENING read_settings
[[ "${SETTING[JOURNAL]:-on}" == off ]] && rm -f "${STATE}/journal.cursor"
timed JOURNAL switched JOURNAL read_journal
timed NETWORK read_network

# null in status.json for a part that is off, which the report shows as turned off rather than as clean
SETUID=null
if [[ "${SETTING[SETUID_SWEEP]:-on}" != off ]]; then
    SWEPT="$(cat "${STATE}/swept" 2>/dev/null || true)"
    if [[ ! "${SWEPT}" =~ ^[0-9]+$ || $((NOW - SWEPT)) -ge ${SWEEP_EVERY} ]]; then
        timed SETUID_SWEEP sweep_to_list
        SWEPT="${NOW}"
        echo "${SWEPT}" >"${STATE}/swept"
    fi
    SETUID="$(jq -R . "${STATE}/setuid.list" | jq -s .)"
else
    rm -f "${STATE}/swept"
fi
LISTENERS=""
LISTENING=null
if [[ "${SETTING[LISTENERS]:-on}" != off ]]; then
    LISTENERS="$(listeners)"
    LISTENING="$(jq -R 'split("\t") | select(length == 3) |
        {port: (.[0] | tonumber), address: .[1], program: .[2]}' <<<"${LISTENERS}" | jq -s .)"
    timed LISTENERS switched LISTENERS read_listeners
fi
timed USER_PATHS switched USER_PATHS read_user_paths

# What the report reads, world-readable: it names files and ports, not what is in them, of network
# protection only how much it blocked, and of the audit log how many events it dropped
DRIFT=null
if [[ -d /usr/etc && "${SETTING[IMAGE_DRIFT]:-on}" != off ]]; then
    timed IMAGE_DRIFT drift_to_json
fi
AUDIT=null
[[ "${SETTING[AUDIT_LOG]:-on}" != off ]] && AUDIT="$(audit_status)"
write_status() {
    jq -n --argjson checked "${NOW}" --argjson swept "${SWEPT:-null}" --argjson drift "${DRIFT:-null}" \
        --argjson setuid "${SETUID}" --argjson listeners "${LISTENING}" \
        --argjson network "$(network_status)" --argjson audit "${AUDIT:-null}" \
        --argjson timings "$(for key in "${!TIMINGS[@]}"; do printf '%s\t%s\n' "${key}" "${TIMINGS[${key}]}"; done |
            jq -R 'split("\t") | {(.[0]): (.[1] | tonumber)}' | jq -s 'add // {}')" \
        '{$checked, $swept, $drift, $setuid, $listeners, $network, $audit, $timings}' >"${STATUS}.new" &&
        chmod 0644 "${STATUS}.new" && mv "${STATUS}.new" "${STATUS}"
}
# Written before the report runs, which reads it, and again after with the report's own time
write_status
if [[ "${SETTING[REPORT_ALERTS]:-on}" != off ]]; then
    timed REPORT_ALERTS read_report
    write_status
else
    # Turned on again, it compares from then
    rm -f "${STATE}/report.json" "${STATE}/tiles.json"
fi
echo "${NOW}" >"${STATE}/last-run"

[[ ${#FINDINGS[@]} -gt 0 ]] || exit 0

STAMP="$(date -d "@${NOW}" '+%F %T')"
TOLD=()
URGENCY=normal
mkdir -p -m 0755 "${HISTORY%/*}"
for finding in "${FINDINGS[@]}"; do
    level="$(jq -r .level <<<"${finding}")"
    text="$(jq -r .text <<<"${finding}")"
    printf '%s\n' "${finding}" >>"${HISTORY}"
    [[ "${level}" == quiet ]] && continue
    echo "${STAMP}  ${text}" >>"${UNREAD}"
    # NOTIFY: all, critical only, or none. Either way it waits in the unread list for the report.
    case "${SETTING[NOTIFY]:-all}" in
        none) continue ;;
        critical) [[ "${level}" == critical ]] || continue ;;
    esac
    TOLD+=("${text}")
    [[ "${level}" == critical ]] && URGENCY=critical
done
chmod 0600 "${HISTORY}" "${UNREAD}" 2>/dev/null
tail -n "${HISTORY_KEPT}" "${HISTORY}" >"${HISTORY}.new" && mv "${HISTORY}.new" "${HISTORY}"
# The newest findings for the Security app's Events page, newest first. They name accounts and files, so
# wheel can read them, as it can the journal, and nobody else.
if tail -n "${EVENTS_KEPT}" "${HISTORY}" | jq -s 'reverse' >"${EVENTS}.new" 2>/dev/null; then
    chgrp wheel "${EVENTS}.new" 2>/dev/null; chmod 0640 "${EVENTS}.new" && mv "${EVENTS}.new" "${EVENTS}"
fi
rm -f "${EVENTS}.new"
printf '%s\n' "${FINDINGS[@]}"

[[ ${#TOLD[@]} -gt 0 ]] || exit 0
if [[ ${#TOLD[@]} -eq 1 ]]; then
    SUMMARY="${TOLD[0]}"
    BODY="See it with: ame security events"
else
    SUMMARY="${#TOLD[@]} security changes on this machine"
    BODY="$(printf '%s\n' "${TOLD[@]:0:2}")"$'\n'"See them all with: ame security events"
fi
"${NOTIFY}" --security "${SUMMARY}" "${BODY}" "${URGENCY}" >/dev/null
