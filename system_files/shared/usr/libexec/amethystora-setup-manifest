#!/usr/bin/bash
# What this account's setup is, as JSON on stdout, for `ame restore-setup` to make again on another
# machine: the image and stream, the Flatpak apps of the machine and of the user with the remotes they
# came from, the Homebrew packages, the containers amethystora-pkg manages with the templates and
# managers they need, the enabled GNOME extensions, the theme, and the few settings `ame setup` keeps.
#
# amethystora-backup stores it beside every backup, as a snapshot of its own, and `ame setup save`
# writes the part of it that names no address and no script to a file of the account's own. Nothing
# secret goes in it: names, addresses and the public keys the Flatpak remotes are checked with, no
# tokens, passwords or settings files.

set -uo pipefail

# Lines that look like an application ID, from flatpak's tab-separated columns
flatpaks() {
    flatpak list "--$1" --app --columns=application,origin 2>/dev/null |
        awk -F'\t' '$1 ~ /^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)+$/ && NF >= 2 { print $1 "\t" $2 }' |
        jq -R 'split("\t") | {app: .[0], origin: .[1]}' | jq -s .
}

# Each remote with its address and the public key flatpak checks it with, so that one this machine
# did not come with can be added again as it was
remotes() {
    local name url keyring key repo
    if [[ "$1" == system ]]; then repo=/var/lib/flatpak/repo; else repo="${XDG_DATA_HOME:-${HOME}/.local/share}/flatpak/repo"; fi
    flatpak remotes "--$1" --columns=name,url 2>/dev/null | while IFS=$'\t' read -r name url; do
        [[ "${name}" =~ ^[A-Za-z0-9._-]+$ && "${url}" == http* ]] || continue
        keyring="${repo}/${name}.trustedkeys.gpg"
        key=""
        [[ -r "${keyring}" ]] && key="$(base64 -w0 "${keyring}")"
        jq -nc --arg name "${name}" --arg url "${url}" --arg key "${key}" \
            '{name: $name, url: $url, gpg_key: (if $key == "" then null else $key end)}'
    done | jq -s .
}

BREW="$(command -v brew 2>/dev/null || echo /home/linuxbrew/.linuxbrew/bin/brew)"
BREWFILE=""
[[ -x "${BREW}" ]] && BREWFILE="$("${BREW}" bundle dump --file=- 2>/dev/null)"
# The Brewfile's taps, formulae or casks, by name
brew_names() { sed -nE "s/^$1 \"([^\"]+)\".*/\1/p" <<<"${BREWFILE}" | jq -R . | jq -sc 'sort'; }

# The settings `ame setup` keeps, where the account changed them from the image's own, so that what a
# later image changes still reaches it: the dock's apps, the keybindings (their keys, never a command),
# the window layout, and the tiling's and the pointer's settings. GSETTINGS_BACKEND=memory reads no dconf at all, so it gives the
# image's value (15-extensions.sh reads it the same way); the image's custom keybindings are in its
# dconf database, which `dconf read -d` reads.
KEY_SCHEMAS=(org.gnome.desktop.wm.keybindings org.gnome.shell.keybindings org.gnome.mutter.keybindings
    org.gnome.mutter.wayland.keybindings org.gnome.settings-daemon.plugins.media-keys
    org.gnome.shell.extensions.amethystora-ui.tiling.keybindings org.gnome.shell.extensions.amethystora-ui.windows
    org.gnome.shell.extensions.amethystora-ui.search org.gnome.shell.extensions.amethystora-ui.emoji)
CUSTOM=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
# The tiling's settings amethystora-setup's TILING_KEYS takes, which test-setup.sh holds this list to: never
# `enabled`, which is the layout, nor the window rules or a picture, which hold patterns and paths
TILING=org.gnome.shell.extensions.amethystora-ui.tiling
TILING_KEYS=(window-gap horizontal-margin vertical-margin vertical-margin-bottom selection-border-size
    selection-border-radius-top selection-border-radius-bottom cycle-width-steps cycle-height-steps
    maximize-width-percent maximize-within-tiling default-focus-mode open-window-position
    open-window-position-option-right open-window-position-option-left open-window-position-option-start
    open-window-position-option-end open-window-position-option-down open-window-position-option-up
    animation-time drift-speed drag-drift-speed minimap-scale minimap-shade-opacity edge-preview-enable
    edge-preview-scale edge-preview-click-enable edge-preview-timeout-enable edge-preview-timeout
    edge-preview-timeout-continual gesture-enabled gesture-horizontal-fingers gesture-workspace-fingers
    swipe-sensitivity swipe-friction show-focus-mode-icon show-open-position-icon default-show-top-bar
    topbar-mouse-scroll-enable window-switcher-preview-scale show-workspace-indicator show-window-position-bar
    only-scratch-in-overview disable-scratch-in-overview overview-ensure-viewport-animation use-default-background
    workspace-colors)
# The pointer module's keys amethystora-setup's POINTER_KEYS takes (test-setup.sh holds the two to the schema)
POINTER=org.gnome.shell.extensions.amethystora-ui.pointer
POINTER_KEYS=(shake dense)
# The glass's keys amethystora-setup's GLASS_KEYS takes: which glass, and Reduce transparency
GLASS=org.gnome.shell.extensions.amethystora-ui.glass
GLASS_KEYS=(material solid)
# The motion's and the top bar's workspaces' keys amethystora-setup's MOTION_KEYS and WORKSPACES_KEYS take
MOTION=org.gnome.shell.extensions.amethystora-ui.motion
MOTION_KEYS=(minimize workspace-switch)
WORKSPACES=org.gnome.shell.extensions.amethystora-ui.workspaces
WORKSPACES_KEYS=(auto-names sets)
# The windows module's keys amethystora-setup's WINDOWS_KEYS takes; its keybinding, snap-chooser, is kept with the
# other keybindings (KEY_SCHEMAS lists its schema for that)
WINDOWS=org.gnome.shell.extensions.amethystora-ui.windows
WINDOWS_KEYS=(snap switcher hold-super hold-super-delay corner-top-left corner-top-right corner-bottom-left
    corner-bottom-right show-desktop gesture-pinch gesture-spread gesture-down gesture-today places dim)
# The dock's keys amethystora-setup's DOCK_KEYS takes; a stack outside the home folder names this machine and is
# left out (test-setup.sh holds the list to the schema)
DOCK=org.gnome.shell.extensions.amethystora-ui.dock
DOCK_KEYS=(magnify magnify-amount launch indicator recent previews edge screens autohide workspace-apps folders stacks)
# The live pill's keys amethystora-setup's PILL_KEYS takes (test-setup.sh holds the list to the schema)
PILL=org.gnome.shell.extensions.amethystora-ui.pill
PILL_KEYS=(live privacy-dots glow quiet quiet-night digest digest-times later later-times whats-new)
# Quick settings' keys amethystora-setup's QUICK_KEYS takes: the tiles' order and the ones put away
QUICK=org.gnome.shell.extensions.amethystora-ui.quick
QUICK_KEYS=(tile-order tile-hidden)
# A top bar on every screen and over fullscreen, today's tasks in the calendar (never the weather, which sends the place
# chosen in Weather) and GNOME's rest reminders: amethystora-setup's BARS_KEYS, TODAY_KEYS and BREAKS_KEYS
BARS=org.gnome.shell.extensions.amethystora-ui.bars
BARS_KEYS=(every-screen peek)
TODAY=org.gnome.shell.extensions.amethystora-ui.today
TODAY_KEYS=(tasks getting-set)
BREAKS=org.gnome.desktop.break-reminders
BREAKS_KEYS=(selected-breaks)
# The search's switches and the emoji picker's skin tone, which amethystora-setup's SEARCH_KEYS and EMOJI_KEYS take;
# their keybindings (open, emoji-picker) are kept with the other keybindings
SEARCH=org.gnome.shell.extensions.amethystora-ui.search
SEARCH_KEYS=(answers settings manual windows clipboard agent glance)
EMOJI=org.gnome.shell.extensions.amethystora-ui.emoji
EMOJI_KEYS=(skin-tone)
# Rounded screen corners, and whether the desktop makes its own sounds (never the sound theme's name, which Settings
# points at a folder of the account's), which amethystora-setup's BEZEL_KEYS and SOUND_KEYS take
BEZEL=org.gnome.shell.extensions.amethystora-ui.bezel
BEZEL_KEYS=(round-corners)
SOUND=org.gnome.desktop.sound
SOUND_KEYS=(event-sounds)
# The theme module's keys amethystora-setup's LOOK_KEYS takes beside the account's look files: an accent per workspace
THEME_UI=org.gnome.shell.extensions.amethystora-ui.theme
THEME_UI_KEYS=(accent-per-workspace workspace-accents)
# The reveal at login, the tips and the app grid's recent row, which amethystora-setup's TRANSITIONS_KEYS, HINTS_KEYS
# and APPGRID_KEYS take
TRANSITIONS=org.gnome.shell.extensions.amethystora-transitions
TRANSITIONS_KEYS=(reveal)
HINTS=org.gnome.shell.extensions.amethystora-ui.hints
HINTS_KEYS=(enabled)
APPGRID=org.gnome.shell.extensions.amethystora-ui.appgrid
APPGRID_KEYS=(recent)
# The battery explained and the busy app's chip, which amethystora-setup's POWER_KEYS takes
POWER=org.gnome.shell.extensions.amethystora-ui.power
POWER_KEYS=(battery-details busy-app)
# Focus profiles: the triggers and what each profile does, which amethystora-setup's FOCUS_KEYS takes; never the profile on
# now, when it ends, or a saved set a profile names
FOCUS=org.gnome.shell.extensions.amethystora-ui.focus
FOCUS_KEYS=(trigger-games trigger-sleep work-banners work-apps work-sounds work-dock work-lighter work-night-light work-power work-accent work-wallpaper work-grey games-banners games-apps games-sounds games-dock games-lighter games-night-light games-power games-accent games-wallpaper games-grey sleep-banners sleep-apps sleep-sounds sleep-dock sleep-lighter sleep-night-light sleep-power sleep-accent sleep-wallpaper sleep-grey)
# Seeing and reading, and touch and pen, which amethystora-setup's ACCESS_KEYS and TOUCH_KEYS take; never whether a
# filter or the ruler is drawn this moment, or the shortcuts
ACCESS=org.gnome.shell.extensions.amethystora-ui.access
ACCESS_KEYS=(filter filter-strength ruler read-aloud read-aloud-speed)
TOUCH=org.gnome.shell.extensions.amethystora-ui.touch
TOUCH_KEYS=(touch-mode pen-ring pen-ring-tools)

# The tiling, while it runs, takes a combination out of four GNOME keys that it cannot wrap in memory, and
# writes down what it took in its state file, to put back when it is turned off: the account's own value is the
# shorter list in dconf with those put back. As "schema key value" lines, the value as gsettings prints a list.
TILING_STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/amethystora/tiling.json"
TILING_KEPT="$(jq -r '(.taken // [])[] as $t
    | (reduce $t.removed[] as $r ($t.wrote; .[:$r.index] + [$r.accelerator] + .[$r.index:])) as $keys
    | "\($t.schema) \($t.key) " + if $keys == [] then "@as []"
        else "[" + ($keys | map(@sh) | join(", ")) + "]" end' "${TILING_STATE}" 2>/dev/null)"

# The lines "schema key value" of a schema whose value is not the image's
changed() {
    comm -13 <(GSETTINGS_BACKEND=memory gsettings list-recursively "$1" 2>/dev/null | sort) \
        <(gsettings list-recursively "$1" 2>/dev/null | awk 'NR == FNR { key = $1 " " $2; $1 = $2 = "";
            kept[key] = substr($0, 3); next } ($1 " " $2) in kept { print $1, $2, kept[$1 " " $2]; next } 1' \
            <(printf '%s\n' "${TILING_KEPT}") - | sort) | awk -v schema="$1" '$1 == schema'
}

# A value as GSettings prints it, as JSON: lists of strings or numbers, strings, numbers, switches and the dock's
# folders. A string may hold either quote (GSettings then writes it in the other), so text with a quote in it is read
# as GVariant text is written, by python, the types GVariant writes before a value left out. A number is written as
# JSON writes it, 0.15 where GSettings prints 0.14999999999999999.
as_json() {
    local text
    text="$(cat)"
    if [[ "${text}" != *[\'\"]* ]]; then
        sed -E "s/^@[^ ]+ //" <<<"${text}" | jq -c 'walk(if type == "number" then . + 0 else . end)' 2>/dev/null
        return
    fi
    python3 -I -c '
import ast, json, sys
QUOTES, BACKSLASH = (chr(34), chr(39)), chr(92)
TYPES = {"byte", "int16", "uint16", "int32", "uint32", "int64", "uint64", "handle", "double", "objectpath",
         "signature", "string", "boolean"}
WORDS = {"true": "True", "false": "False", "nothing": "None"}
text, out, i = sys.stdin.read().strip(), [], 0
while i < len(text):
    c = text[i]
    if c in QUOTES:
        j = i + 1
        while j < len(text) and text[j] != c:
            j += 2 if text[j] == BACKSLASH else 1
        out.append(text[i:j + 1])
        i = j + 1
    elif c == "@":
        while i < len(text) and not text[i].isspace():
            i += 1
    elif c.isalpha():
        j = i
        while j < len(text) and (text[j].isalnum() or text[j] == "_"):
            j += 1
        word = text[i:j]
        out.append("" if word in TYPES else WORDS.get(word, word))
        i = j
    else:
        out.append(c)
        i += 1
print(json.dumps(ast.literal_eval("".join(out))))
' <<<"${text}" 2>/dev/null | jq -c 'walk(if type == "number" then . + 0 else . end)' 2>/dev/null
}

settings() {
    local schema key value dir id
    {
        changed org.gnome.shell | awk '$2 == "favorite-apps"'
        # Keybindings only, lists of keys: those schemas also hold numbers, such as the volume step
        for schema in "${KEY_SCHEMAS[@]}"; do
            changed "${schema}" | awk '$2 != "custom-keybindings" && $3 ~ /^(\[|@as$)/'
        done
        changed "${TILING}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${TILING_KEYS[@]}") -
        changed "${POINTER}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${POINTER_KEYS[@]}") -
        changed "${GLASS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${GLASS_KEYS[@]}") -
        changed "${MOTION}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${MOTION_KEYS[@]}") -
        changed "${WORKSPACES}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${WORKSPACES_KEYS[@]}") -
        changed "${WINDOWS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${WINDOWS_KEYS[@]}") -
        changed "${DOCK}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${DOCK_KEYS[@]}") -
        changed "${PILL}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${PILL_KEYS[@]}") -
        changed "${QUICK}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${QUICK_KEYS[@]}") -
        changed "${BARS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${BARS_KEYS[@]}") -
        changed "${TODAY}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${TODAY_KEYS[@]}") -
        changed "${BREAKS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${BREAKS_KEYS[@]}") -
        changed "${SEARCH}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${SEARCH_KEYS[@]}") -
        changed "${EMOJI}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${EMOJI_KEYS[@]}") -
        changed "${BEZEL}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${BEZEL_KEYS[@]}") -
        changed "${SOUND}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${SOUND_KEYS[@]}") -
        changed "${TRANSITIONS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${TRANSITIONS_KEYS[@]}") -
        changed "${HINTS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${HINTS_KEYS[@]}") -
        changed "${APPGRID}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${APPGRID_KEYS[@]}") -
        changed "${FOCUS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${FOCUS_KEYS[@]}") -
        changed "${POWER}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${POWER_KEYS[@]}") -
        changed "${ACCESS}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${ACCESS_KEYS[@]}") -
        changed "${TOUCH}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${TOUCH_KEYS[@]}") -
    } | while read -r schema key value; do
        value="$(as_json <<<"${value}")" && [[ -n "${value}" ]] || continue
        jq -nc --arg s "${schema}" --arg k "${key}" --argjson v "${value}" '{schema: $s, key: $k, value: $v}'
    done
    # A custom keybinding is a command too: only the image's own are kept, and only their keys
    for dir in $(dconf list "${CUSTOM}/" 2>/dev/null); do
        id="${dir%/}"
        [[ "${id}" =~ ^custom[0-9]+$ && -n "$(dconf read -d "${CUSTOM}/${id}/command" 2>/dev/null)" ]] || continue
        value="$(dconf read "${CUSTOM}/${id}/binding" 2>/dev/null)"
        [[ "${value}" != "$(dconf read -d "${CUSTOM}/${id}/binding" 2>/dev/null)" ]] || continue
        value="$(as_json <<<"${value}")" && [[ -n "${value}" ]] || continue
        jq -nc --arg k "${id}" --argjson v "${value}" '{schema: "custom", key: $k, value: $v}'
    done
}

LAYOUT=tiling
[[ "$(gsettings get org.gnome.shell.extensions.amethystora-ui.tiling enabled 2>/dev/null)" == false ]] && LAYOUT=classic
SETTINGS="$(settings | jq -sc --arg layout "${LAYOUT}" --arg tiling "${TILING}" --arg pointer "${POINTER}" --arg glass "${GLASS}" \
    --arg windows "${WINDOWS}" --arg dock "${DOCK}" --arg motion "${MOTION}" --arg workspaces "${WORKSPACES}" \
    --arg pill "${PILL}" --arg quick "${QUICK}" --arg bars "${BARS}" --arg today "${TODAY}" --arg breaks "${BREAKS}" \
    --arg search "${SEARCH}" --arg emoji "${EMOJI}" --arg bezel "${BEZEL}" --arg sound "${SOUND}" \
    --arg transitions "${TRANSITIONS}" --arg hints "${HINTS}" --arg appgrid "${APPGRID}" \
    --arg focus "${FOCUS}" --arg power "${POWER}" --arg access "${ACCESS}" --arg touch "${TOUCH}" '
    map(if .schema == "custom" then .value |= (if . == "" then [] else [.] end) else . end) as $all
    | {layout: $layout}
    + ([$all[] | select(.schema == "org.gnome.shell")] | if length > 0 then {favorites: .[0].value} else {} end)
    + {keybindings: (reduce ($all[] | select(if .schema == $windows then .key == "snap-chooser"
            elif .schema == $search then .key == "open" elif .schema == $emoji then .key == "emoji-picker"
            else .schema | IN("org.gnome.shell", $tiling, $pointer, $glass, $motion, $workspaces, $dock, $pill, $quick, $bars,
                $today, $breaks, $bezel, $sound, $transitions, $hints, $appgrid, $focus, $power,
                $access, $touch) | not end))
        as $e ({}; .[$e.schema][$e.key] = $e.value))}
    + ([$all[] | select(.schema == $windows and .key != "snap-chooser")]
        | if length > 0 then {windows: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $tiling)] | if length > 0 then {tiling: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $pointer)] | if length > 0 then {pointer: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $glass)] | if length > 0 then {glass: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $motion)] | if length > 0 then {motion: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $workspaces)]
        | if length > 0 then {workspaces: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $dock)] | if length > 0 then {dock: (map({(.key): .value}) | add
        | if has("stacks") then .stacks |= map(select(test("^(xdg:|~/)"))) else . end)} else {} end)
    + ([$all[] | select(.schema == $pill)] | if length > 0 then {pill: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $quick)] | if length > 0 then {quick: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $bars)] | if length > 0 then {bars: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $today)] | if length > 0 then {today: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $breaks)] | if length > 0 then {breaks: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $search and .key != "open")]
        | if length > 0 then {search: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $emoji and .key != "emoji-picker")]
        | if length > 0 then {emoji: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $bezel)] | if length > 0 then {bezel: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $sound)] | if length > 0 then {sound: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $transitions)] | if length > 0 then {transitions: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $hints)] | if length > 0 then {hints: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $appgrid)] | if length > 0 then {appgrid: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $focus)] | if length > 0 then {focus: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $power)] | if length > 0 then {power: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $access)] | if length > 0 then {access: (map({(.key): .value}) | add)} else {} end)
    + ([$all[] | select(.schema == $touch)] | if length > 0 then {touch: (map({(.key): .value}) | add)} else {} end)')"

# The look, where the account changed it from the image's: its accent, Daylight turned off and colours from the wallpaper
# (the account's files, each only as one of its values), and an accent per workspace (the theme module's keys)
look() {
    local config="${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora" accent colours image_accent image_colours schema key value
    # What is in force (the account's choice, else its image's), saved where it is not the image's own
    accent="$(source /usr/lib/amethystora/theme/lib.sh && account_accent)"
    colours="$(source /usr/lib/amethystora/theme/lib.sh && colours_way)"
    image_accent="$(head -n1 /usr/share/amethystora/image-setup/accent 2>/dev/null || true)"
    image_colours="$(head -n1 /usr/share/amethystora/image-setup/colours 2>/dev/null || true)"
    {
        [[ "${accent:-theme}" != "${image_accent:-theme}" ]] && jq -nc --arg v "${accent:-theme}" '{accent: $v}'
        [[ "$(head -n1 "${config}/daylight" 2>/dev/null || true)" == off ]] && jq -nc '{daylight: "off"}'
        [[ "${colours:-off}" != "${image_colours:-off}" ]] && jq -nc --arg v "${colours:-off}" '{colours: $v}'
        changed "${THEME_UI}" | awk 'NR == FNR { kept[$1]; next } $2 in kept' <(printf '%s\n' "${THEME_UI_KEYS[@]}") - |
            while read -r schema key value; do
                value="$(as_json <<<"${value}")" && [[ -n "${value}" ]] || continue
                jq -nc --arg k "${key}" --argjson v "${value}" '{($k): $v}'
            done
    } | jq -sc 'add // {}'
}
LOOK="$(look)"
SETTINGS="$(jq -c --argjson look "${LOOK}" 'if $look == {} then . else . + {look: $look} end' <<<"${SETTINGS}")"

# The image the machine runs, which is the one it follows, as rpm-ostree has it (amethystora-deployments
# asks bootc on a sealed image)
REFERENCE="$(/usr/libexec/amethystora-deployments 2>/dev/null |
    jq -r '[.deployments[] | select(.booted)][0]["container-image-reference"] // empty' 2>/dev/null |
    sed -E 's|^[^:]+:(docker://)?||')"

EXTENSIONS="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null | sed "s/^@as //; s/'/\"/g")"
jq -e 'type == "array"' <<<"${EXTENSIONS}" >/dev/null 2>&1 || EXTENSIONS='[]'

PKG='[]' TEMPLATES='[]' MANAGERS='[]'
if command -v amethystora-pkg >/dev/null; then
    PKG="$(amethystora-pkg containers list --json 2>/dev/null)" || PKG='[]'
    TEMPLATES="$(amethystora-pkg templates list --json 2>/dev/null | jq -c 'map(select(.built_in | not))')" || TEMPLATES='[]'
    MANAGERS="$(amethystora-pkg managers list --json 2>/dev/null | jq -c 'map(select(.built_in | not))')" || MANAGERS='[]'
fi
AUR=false
[[ -e "${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora/aur" ]] && AUR=true

jq -n --arg host "$(hostname)" --arg account "${USER:-$(id -un)}" --arg home "${HOME}" \
    --argjson image "$(jq -c '{name: ."image-name", flavor: ."image-flavor", stream: ."image-tag"}' \
        /usr/share/amethystora/image-info.json 2>/dev/null || echo null)" \
    --arg reference "${REFERENCE}" \
    --argjson system_apps "$(flatpaks system)" --argjson user_apps "$(flatpaks user)" \
    --argjson system_remotes "$(remotes system)" --argjson user_remotes "$(remotes user)" \
    --arg brewfile "${BREWFILE}" --argjson taps "$(brew_names tap)" --argjson formulae "$(brew_names brew)" \
    --argjson casks "$(brew_names cask)" --argjson containers "${PKG:-[]}" --argjson templates "${TEMPLATES:-[]}" \
    --argjson managers "${MANAGERS:-[]}" --argjson aur "${AUR}" --argjson extensions "${EXTENSIONS}" \
    --arg theme "$(amethystora-theme current 2>/dev/null)" --argjson settings "${SETTINGS}" '{
        version: 1, created: (now | floor), host: $host, user: $account, home: $home,
        image: (($image // {}) + {reference: $reference}),
        flatpaks: {system: $system_apps, user: $user_apps},
        remotes: {system: $system_remotes, user: $user_remotes},
        brewfile: $brewfile,
        # The taps of Homebrew itself come with it, or no longer exist
        brew: {taps: ($taps | map(select(startswith("homebrew/") | not))), formulae: $formulae, casks: $casks},
        containers: $containers, templates: $templates, managers: $managers, aur: $aur,
        extensions: $extensions, theme: $theme, settings: $settings
    }'
