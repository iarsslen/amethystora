#!/usr/bin/bash
# What this account's setup is, as JSON on stdout, for `ame restore-setup` to make again on another
# machine: the image and stream, the Flatpak apps of the machine and of the user with the remotes they
# came from, the Homebrew packages, the containers amethystora-pkg manages with the templates and
# managers they need, the enabled GNOME extensions, the theme, and the few settings `ame setup` keeps.
#
# amethystora-backup stores it beside every backup, as a snapshot of its own, and `ame setup save`
# writes the part of it that names no address and no script to a file of the account's own. Nothing
# secret goes in it: names, addresses and the public keys the Flatpak remotes are checked with, no
# tokens, passwords or settings files.

set -uo pipefail

# Lines that look like an application ID, from flatpak's tab-separated columns
flatpaks() {
    flatpak list "--$1" --app --columns=application,origin 2>/dev/null |
        awk -F'\t' '$1 ~ /^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)+$/ && NF >= 2 { print $1 "\t" $2 }' |
        jq -R 'split("\t") | {app: .[0], origin: .[1]}' | jq -s .
}

# Each remote with its address and the public key flatpak checks it with, so that one this machine
# did not come with can be added again as it was
remotes() {
    local name url keyring key repo
    if [[ "$1" == system ]]; then repo=/var/lib/flatpak/repo; else repo="${XDG_DATA_HOME:-${HOME}/.local/share}/flatpak/repo"; fi
    flatpak remotes "--$1" --columns=name,url 2>/dev/null | while IFS=$'\t' read -r name url; do
        [[ "${name}" =~ ^[A-Za-z0-9._-]+$ && "${url}" == http* ]] || continue
        keyring="${repo}/${name}.trustedkeys.gpg"
        key=""
        [[ -r "${keyring}" ]] && key="$(base64 -w0 "${keyring}")"
        jq -nc --arg name "${name}" --arg url "${url}" --arg key "${key}" \
            '{name: $name, url: $url, gpg_key: (if $key == "" then null else $key end)}'
    done | jq -s .
}

BREW="$(command -v brew 2>/dev/null || echo /home/linuxbrew/.linuxbrew/bin/brew)"
BREWFILE=""
[[ -x "${BREW}" ]] && BREWFILE="$("${BREW}" bundle dump --file=- 2>/dev/null)"
# The Brewfile's taps, formulae or casks, by name
brew_names() { sed -nE "s/^$1 \"([^\"]+)\".*/\1/p" <<<"${BREWFILE}" | jq -R . | jq -sc 'sort'; }

# The settings `ame setup` keeps, where the account changed them from the image's own, so that what a
# later image changes still reaches it: the dock's apps, the keybindings (their keys, never a command),
# PaperWM's gaps and the window layout. GSETTINGS_BACKEND=memory reads no dconf at all, so it gives the
# image's value (15-extensions.sh reads it the same way); the image's custom keybindings are in its
# dconf database, which `dconf read -d` reads.
KEY_SCHEMAS=(org.gnome.desktop.wm.keybindings org.gnome.shell.keybindings org.gnome.mutter.keybindings
    org.gnome.mutter.wayland.keybindings org.gnome.settings-daemon.plugins.media-keys
    org.gnome.shell.extensions.paperwm.keybindings)
CUSTOM=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings

# The lines "schema key value" of a schema whose value is not the image's
changed() {
    comm -13 <(GSETTINGS_BACKEND=memory gsettings list-recursively "$1" 2>/dev/null | sort) \
        <(gsettings list-recursively "$1" 2>/dev/null | sort) | awk -v schema="$1" '$1 == schema'
}

# A value as GSettings prints it, as JSON: the ones kept are lists of strings, strings and numbers
as_json() { sed -E "s/^@as //; s/'/\"/g" | jq -c . 2>/dev/null; }

settings() {
    local schema key value dir id
    {
        changed org.gnome.shell | awk '$2 == "favorite-apps"'
        for schema in "${KEY_SCHEMAS[@]}"; do
            changed "${schema}" | awk '$2 != "custom-keybindings"'
        done
        changed org.gnome.shell.extensions.paperwm |
            awk '$2 ~ /^(window-gap|horizontal-margin|vertical-margin|vertical-margin-bottom)$/'
    } | while read -r schema key value; do
        value="$(as_json <<<"${value}")" && [[ -n "${value}" ]] || continue
        jq -nc --arg s "${schema}" --arg k "${key}" --argjson v "${value}" '{schema: $s, key: $k, value: $v}'
    done
    # A custom keybinding is a command too: only the image's own are kept, and only their keys
    for dir in $(dconf list "${CUSTOM}/" 2>/dev/null); do
        id="${dir%/}"
        [[ "${id}" =~ ^custom[0-9]+$ && -n "$(dconf read -d "${CUSTOM}/${id}/command" 2>/dev/null)" ]] || continue
        value="$(dconf read "${CUSTOM}/${id}/binding" 2>/dev/null)"
        [[ "${value}" != "$(dconf read -d "${CUSTOM}/${id}/binding" 2>/dev/null)" ]] || continue
        value="$(as_json <<<"${value}")" && [[ -n "${value}" ]] || continue
        jq -nc --arg k "${id}" --argjson v "${value}" '{schema: "custom", key: $k, value: $v}'
    done
}

LAYOUT=tiling
[[ "$(cat "${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora/layout" 2>/dev/null)" == classic ]] && LAYOUT=classic
SETTINGS="$(settings | jq -sc --arg layout "${LAYOUT}" '
    map(if .schema == "custom" then .value |= (if . == "" then [] else [.] end) else . end) as $all
    | {layout: $layout}
    + ([$all[] | select(.schema == "org.gnome.shell")] | if length > 0 then {favorites: .[0].value} else {} end)
    + {keybindings: (reduce ($all[] | select(.schema | IN("org.gnome.shell", "org.gnome.shell.extensions.paperwm") | not))
        as $e ({}; .[$e.schema][$e.key] = $e.value))}
    + {paperwm: (reduce ($all[] | select(.schema == "org.gnome.shell.extensions.paperwm")) as $e ({}; .[$e.key] = $e.value))}')"

# The image the machine runs, which is the one it follows, as rpm-ostree has it (amethystora-deployments
# asks bootc on a sealed image)
REFERENCE="$(/usr/libexec/amethystora-deployments 2>/dev/null |
    jq -r '[.deployments[] | select(.booted)][0]["container-image-reference"] // empty' 2>/dev/null |
    sed -E 's|^[^:]+:(docker://)?||')"

EXTENSIONS="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null | sed "s/^@as //; s/'/\"/g")"
jq -e 'type == "array"' <<<"${EXTENSIONS}" >/dev/null 2>&1 || EXTENSIONS='[]'

PKG='[]' TEMPLATES='[]' MANAGERS='[]'
if command -v amethystora-pkg >/dev/null; then
    PKG="$(amethystora-pkg containers list --json 2>/dev/null)" || PKG='[]'
    TEMPLATES="$(amethystora-pkg templates list --json 2>/dev/null | jq -c 'map(select(.built_in | not))')" || TEMPLATES='[]'
    MANAGERS="$(amethystora-pkg managers list --json 2>/dev/null | jq -c 'map(select(.built_in | not))')" || MANAGERS='[]'
fi
AUR=false
[[ -e "${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora/aur" ]] && AUR=true

jq -n --arg host "$(hostname)" --arg account "${USER:-$(id -un)}" --arg home "${HOME}" \
    --argjson image "$(jq -c '{name: ."image-name", flavor: ."image-flavor", stream: ."image-tag"}' \
        /usr/share/amethystora/image-info.json 2>/dev/null || echo null)" \
    --arg reference "${REFERENCE}" \
    --argjson system_apps "$(flatpaks system)" --argjson user_apps "$(flatpaks user)" \
    --argjson system_remotes "$(remotes system)" --argjson user_remotes "$(remotes user)" \
    --arg brewfile "${BREWFILE}" --argjson taps "$(brew_names tap)" --argjson formulae "$(brew_names brew)" \
    --argjson casks "$(brew_names cask)" --argjson containers "${PKG:-[]}" --argjson templates "${TEMPLATES:-[]}" \
    --argjson managers "${MANAGERS:-[]}" --argjson aur "${AUR}" --argjson extensions "${EXTENSIONS}" \
    --arg theme "$(amethystora-theme current 2>/dev/null)" --argjson settings "${SETTINGS}" '{
        version: 1, created: (now | floor), host: $host, user: $account, home: $home,
        image: (($image // {}) + {reference: $reference}),
        flatpaks: {system: $system_apps, user: $user_apps},
        remotes: {system: $system_remotes, user: $user_remotes},
        brewfile: $brewfile,
        # The taps of Homebrew itself come with it, or no longer exist
        brew: {taps: ($taps | map(select(startswith("homebrew/") | not))), formulae: $formulae, casks: $casks},
        containers: $containers, templates: $templates, managers: $managers, aur: $aur,
        extensions: $extensions, theme: $theme, settings: $settings
    }'
