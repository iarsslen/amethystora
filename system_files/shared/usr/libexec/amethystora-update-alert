#!/usr/bin/bash
# Runs as the user when a graphical session starts (amethystora-update-alert.service).
#
# Says so when the machine started an older version than the one it starts by default, which is what
# picking the second entry in the boot menu does, and opens System Updates when the notification is
# clicked: the window offers to keep that version or to restart into the newest. An update staged for
# the next restart is not this: rpm-ostree marks that one staged. amethystora-deployments gives the same
# list on a sealed image, which has no rpm-ostree.
#
# Said once a boot: the mark is the boot's id, kept in the account's state, which a logout leaves alone
# (the runtime directory went with the last session, and the notice came again at every login).
#
# Then says when firmware updates are waiting, once for each release: fwupd-refresh.timer fetches what LVFS
# has, and nothing else in the image says so. Clicking it opens System Updates too, whose Firmware section
# installs them.

set -uo pipefail

command -v notify-send >/dev/null || exit 0

STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/amethystora"

# GNOME Shell takes the notification name on the bus a little after the session starts
wait_for_shell() {
    command -v gdbus >/dev/null &&
        gdbus wait --session --timeout 60 org.freedesktop.Notifications >/dev/null 2>&1
}

# "default" is what clicking the notification itself does; --wait keeps this here to hear it
say() {
    local action
    action="$(notify-send --app-name=Amethystora --icon=amethystora-update --urgency=normal --wait \
        --action=default="Open System Updates" --action=open="Open System Updates" "$1" "$2")"
    case "${action}" in
        default | open) exec /usr/bin/amethystora-update ;;
    esac
}

previous_version() {
    local stamp="${STATE}/previous-version" boot status version
    boot="$(cat /proc/sys/kernel/random/boot_id)"
    [[ "$(cat "${stamp}" 2>/dev/null)" == "${boot}" ]] && return 0
    status="$(/usr/libexec/amethystora-deployments 2>/dev/null)" || return 0
    jq -e '(.deployments | map(.booted) | index(true)) as $b | $b != null and $b > 0
        and (.deployments[0].staged | not)
        and ((.deployments[0].timestamp // 0) > (.deployments[$b].timestamp // 0))' <<<"${status}" >/dev/null || return 0
    mkdir -p "${STATE}" && printf '%s\n' "${boot}" >"${stamp}"
    wait_for_shell
    version="$(jq -r '[.deployments[] | select(.booted)][0].version // ""' <<<"${status}")"
    say "You're on the previous version" \
        "This machine started Amethystora ${version}, not the newest. System Updates can keep this version, or restart into the latest."
}

firmware() {
    local said="${STATE}/firmware-said" updates waiting names
    command -v fwupdmgr >/dev/null || return 0
    # With --json, fwupdmgr asks nothing and needs no password; a device can be listed with no release to install
    updates="$(timeout 60 fwupdmgr get-updates --json 2>/dev/null)" || true
    waiting="$(jq -r '.Devices[]? | select((.Releases // []) | length > 0) | "\(.DeviceId) \(.Releases[0].Version // "")"' \
        <<<"${updates}" 2>/dev/null | sort)"
    [[ -n "${waiting}" ]] || return 0
    [[ -n "$(comm -23 <(printf '%s\n' "${waiting}") <(sort "${said}" 2>/dev/null))" ]] || return 0
    mkdir -p "${STATE}" && printf '%s\n' "${waiting}" >"${said}"
    # The devices' names are their makers' words, which GNOME would read as markup
    names="$(jq -r '[.Devices[]? | select((.Releases // []) | length > 0) | .Name // .DeviceId] | join(", ")' <<<"${updates}" |
        /usr/libexec/amethystora-security-text --markup --max 200)"
    wait_for_shell
    say "Firmware updates are waiting" \
        "For ${names}: fixes from its maker, often for security holes. System Updates installs them, and some need a restart."
}

previous_version
firmware
exit 0
