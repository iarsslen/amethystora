#!/usr/bin/bash
# Runs a command in a terminal window of its own and keeps the window open once it has finished, so
# that what it printed can be read: a launched terminal otherwise closes the instant its command ends.
# The Security app (amethystora-security) opens the recipes it offers this way.
#
#   amethystora-in-terminal <command> [<argument>...]
#   amethystora-in-terminal [--agent REASON] [--report DIR] -- <command> [<argument>...]
#
# The two options are the AI agent's tools' (amethystora-agent-tools), for a command the agent hands to the
# person at the machine. --agent shows the command as words, and the agent's reason as the agent's own words,
# and runs it only after a yes. --report writes how it ended into DIR, a folder of the caller's own: DIR/status
# (the exit code, or "declined") after DIR/output (the last 8 KB of what it printed), since neither this nor
# xdg-terminal-exec tells its caller anything.
#
# xdg-terminal-exec is how amethystora-menu reopens itself from a keybinding, too.

set -uo pipefail

[[ $# -gt 0 ]] || exit 2

if [[ ! -t 1 ]]; then
    command -v xdg-terminal-exec >/dev/null || exit 1
    exec xdg-terminal-exec "$0" "$@"
fi

AGENT=false REASON="" REPORT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --agent) AGENT=true REASON="${2:-}"; shift 2 ;;
        --report) REPORT="${2:-}"; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[[ $# -gt 0 ]] || exit 2
# Only a folder of this account's own, which nobody else can write into
if [[ -n "${REPORT}" ]] && [[ ! -d "${REPORT}" || ! -O "${REPORT}" || -L "${REPORT}" ]]; then
    echo "amethystora-in-terminal: ${REPORT} is not a folder of yours" >&2
    exit 2
fi

ended() {
    [[ -z "${REPORT}" ]] || { printf '%s\n' "$1" >"${REPORT}/status.new" && mv "${REPORT}/status.new" "${REPORT}/status"; }
}

if [[ "${AGENT}" == true ]]; then
    echo "The AI agent asks to run this:"
    echo
    printf '    '
    printf '%q ' "$@"
    echo
    echo
    echo "Its reason, in its own words: $(/usr/libexec/amethystora-security-text --max 600 "${REASON}")"
    [[ -z "${REPORT}" ]] || echo "What the command prints goes back to the agent."
    echo
    read -rp "Run it? [y/N] " answer || answer=""
    if [[ ${answer,,} != y* ]]; then
        ended declined
        echo "Not run."
        sleep 1
        exit 0
    fi
fi

if [[ -n "${REPORT}" ]]; then
    # In a terminal of its own, as it would be here, with what it prints also kept: Python's pty, since the image
    # has no script(1). Its last 8 KB stay.
    python3 -I -c '
import os, pty, sys
path = sys.argv[1]
with open(path, "wb") as out:
    def read(fd):
        data = os.read(fd, 4096)
        out.write(data)
        out.flush()
        return data
    try:
        status = pty.spawn(sys.argv[2:], read)
    except OSError as error:
        print(error, file=sys.stderr)
        sys.exit(127)
with open(path, "rb") as kept:
    data = kept.read()[-8192:]
with open(path, "wb") as out:
    out.write(data)
code = os.waitstatus_to_exitcode(status)
sys.exit(code if code >= 0 else 128 - code)
' "${REPORT}/output" "$@"
    status=$?
    ended "${status}"
else
    "$@"
fi

echo
# gum is what the rest of this image prompts with; read is what is there if it ever is not
if command -v gum >/dev/null; then
    gum input --placeholder "Press enter to close" >/dev/null || true
else
    read -rsp "Press enter to close" _ || true
fi
