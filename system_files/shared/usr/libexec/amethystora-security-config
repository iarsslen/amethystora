#!/usr/bin/bash
# The one reader of /etc/amethystora/security.conf, for the scripts, the recipes and the Security app.
#
#   amethystora-security-config KEY                 the value, or the default when it is unset or unknown
#   amethystora-security-config --is KEY VALUE...   exit 0 when KEY is one of the VALUEs (ExecCondition=)
#   amethystora-security-config --all               every key, as KEY=value lines
#   amethystora-security-config --list [--json]     every setting with its values and what it does
#   amethystora-security-config --profile           which profile the keys match: off, default, light,
#                                                   balanced, thorough, or custom
#   amethystora-security-config set KEY VALUE       change it (root), and note who did
#   amethystora-security-config profile NAME        off: every key that can be off to off; default: each to its
#                                                   default; light, balanced, thorough: what looks for new
#                                                   threats as the profile says, the rest to its default (root)
#   amethystora-security-config note SWITCH VALUE   record that a switch's own command changed it (root),
#                                                   so the security watcher records the change without
#                                                   announcing it
#
# A value it does not know is the default and never an error: a typo in the file must not turn
# real-time scanning on, files found by a scan into files deleted, or connections into blocked ones.
#
# Every security feature that runs without being asked for has a key here, and off means it costs
# nothing: each unit checks its key with --is as it starts, so a line edited by hand from a text console
# takes effect at the next boot even when the desktop does not start.

set -uo pipefail

# AMETHYSTORA_SECURITY_CONF and AMETHYSTORA_SECURITY_NOTES are for the tests in build_files/shared, which
# run against stand-ins: a build must not write to /var/lib
CONFIG="${AMETHYSTORA_SECURITY_CONF:-/etc/amethystora/security.conf}"
NOTES="${AMETHYSTORA_SECURITY_NOTES:-/var/lib/amethystora/security/notes}"
NOTES_KEPT=200

# In the order --list gives them. REALTIME is the shortcut for its two halves, and not listed itself.
KEYS=(WATCHER ON_BATTERY REALTIME_WATCH AUDIT_LOG IDENTITY PRIVILEGE PERSISTENCE HARDENING MODULES INPUT_CAPTURE
    USER_PROGRAMS JOURNAL IMAGE_DRIFT SETUID_SWEEP LISTENERS USER_PATHS
    # What looks for new threats, off as the image ships
    APP_PERMISSIONS PROCESSES SELINUX_DENIALS SNAPSHOT_WATCH AGENT_CLIS AGENT_CONFIG DEV_HOOKS BPF_PROGRAMS
    CREDENTIALS DECOY EXEC_WATCH BEHAVIOUR CHAINS
    VIRUS_SCAN REALTIME_SCAN YARA_ELASTIC YARA_SIGNATURE_BASE YARA_FORGE ON_DETECTION SETTINGS_AUDIT
    NETWORK NETWORK_FEEDS NETWORK_HUNTING DNS_NAMES NOTIFY REPORT_ALERTS
    # What sends something to somebody else, each chosen on its own
    OSPREY TRIAGE REPUTATION)

declare -A DEFAULTS=(
    [ON_DETECTION]=report [REALTIME]=off [NETWORK]=off
    [WATCHER]=on [ON_BATTERY]=skip [AUDIT_LOG]=on [VIRUS_SCAN]=weekly [SETTINGS_AUDIT]=on [NOTIFY]=all
    # The two halves of REALTIME take its value until they are set themselves
    [REALTIME_SCAN]=REALTIME [REALTIME_WATCH]=REALTIME
    [IDENTITY]=on [PRIVILEGE]=on [PERSISTENCE]=on [HARDENING]=on [MODULES]=on [INPUT_CAPTURE]=on
    [USER_PROGRAMS]=record [JOURNAL]=on [IMAGE_DRIFT]=on [SETUID_SWEEP]=on [LISTENERS]=on [USER_PATHS]=on
    [REPORT_ALERTS]=on
    # What looks for new threats: each off until it is turned on, alone or with a profile
    [APP_PERMISSIONS]=off [DEV_HOOKS]=off
    [SELINUX_DENIALS]=off
    [PROCESSES]=off
    [BPF_PROGRAMS]=off
    [AGENT_CONFIG]=off
    [EXEC_WATCH]=off
    [AGENT_CLIS]=off
    [CREDENTIALS]=off
    [DECOY]=off
    [SNAPSHOT_WATCH]=off
    [CHAINS]=off
    [NETWORK_FEEDS]=off
    [NETWORK_HUNTING]=off
    [DNS_NAMES]=off
    [YARA_ELASTIC]=off
    [YARA_SIGNATURE_BASE]=off
    [YARA_FORGE]=off
    [OSPREY]=off
    [TRIAGE]=off
    [REPUTATION]=off
    [BEHAVIOUR]=off
)
declare -A ALLOWED=(
    [ON_DETECTION]="report quarantine delete" [REALTIME]="off on" [NETWORK]="off watch block"
    [WATCHER]="off on" [ON_BATTERY]="skip run" [AUDIT_LOG]="off on" [VIRUS_SCAN]="off manual weekly" [SETTINGS_AUDIT]="off on"
    [NOTIFY]="all critical none" [REALTIME_SCAN]="off on" [REALTIME_WATCH]="off on"
    [IDENTITY]="off record on" [PRIVILEGE]="off record on" [PERSISTENCE]="off record on"
    [HARDENING]="off record on" [MODULES]="off record on" [INPUT_CAPTURE]="off record on"
    [USER_PROGRAMS]="off record on" [JOURNAL]="off record on" [IMAGE_DRIFT]="off on"
    [SETUID_SWEEP]="off on" [LISTENERS]="off record on" [USER_PATHS]="off record on" [REPORT_ALERTS]="off on"
    [APP_PERMISSIONS]="off record on"
    [DEV_HOOKS]="off record on"
    [SELINUX_DENIALS]="off record on"
    [PROCESSES]="off record on"
    [BPF_PROGRAMS]="off record on"
    [AGENT_CONFIG]="off record on"
    [EXEC_WATCH]="off record on"
    [AGENT_CLIS]="off record on"
    [CREDENTIALS]="off record on"
    [DECOY]="off on"
    [SNAPSHOT_WATCH]="off record on"
    [CHAINS]="off record on"
    [NETWORK_FEEDS]="off daily hourly"
    [NETWORK_HUNTING]="off record"
    [DNS_NAMES]="off record on"
    [YARA_ELASTIC]="off on"
    [YARA_SIGNATURE_BASE]="off on"
    [YARA_FORGE]="off on"
    [OSPREY]="off on"
    [TRIAGE]="off on"
    [REPUTATION]="off on"
    [BEHAVIOUR]="off record on"
)
# How a change is applied: restart:UNIT (each checks its key as it starts), run (the watcher reads it at its
# next run), reboot (the kernel's audit rules, which -e 2 locks, and auditd), or now (read when used)
declare -A APPLIES=(
    [WATCHER]="restart:amethystora-security-realtime.service run"
    [ON_BATTERY]="run"
    [REALTIME_WATCH]="restart:amethystora-security-realtime.service"
    [AUDIT_LOG]="reboot"
    [IDENTITY]="run reboot" [PRIVILEGE]="run reboot" [PERSISTENCE]="run reboot" [HARDENING]="run reboot"
    [MODULES]="run reboot" [INPUT_CAPTURE]="run reboot" [USER_PROGRAMS]="run reboot"
    [JOURNAL]="run" [IMAGE_DRIFT]="run" [SETUID_SWEEP]="run" [LISTENERS]="run" [USER_PATHS]="run"
    [REPORT_ALERTS]="run" [APP_PERMISSIONS]="run"
    [DEV_HOOKS]="run"
    [VIRUS_SCAN]="restart:clamav-freshclam.service restart:clamd@scan.socket restart:amethystora-clamav-onaccess.service"
    [REALTIME_SCAN]="restart:amethystora-clamav-onaccess.service"
    [ON_DETECTION]="now" [SETTINGS_AUDIT]="now" [NOTIFY]="now"
    [NETWORK]="restart:amethystora-ips.service restart:amethystora-security-realtime.service run"
    [SELINUX_DENIALS]="run"
    [PROCESSES]="run"
    [BPF_PROGRAMS]="run"
    [AGENT_CONFIG]="run"
    [EXEC_WATCH]="run reboot"
    [AGENT_CLIS]="run reboot"
    [CREDENTIALS]="run reboot"
    [DECOY]="run reboot"
    [SNAPSHOT_WATCH]="run"
    [CHAINS]="run"
    [NETWORK_FEEDS]="restart:amethystora-ips-rules.service"
    [NETWORK_HUNTING]="restart:amethystora-ips-rules.service"
    [DNS_NAMES]="restart:amethystora-dns-names.service run"
    [YARA_ELASTIC]="restart:amethystora-yara.service"
    [YARA_SIGNATURE_BASE]="restart:amethystora-yara.service"
    [YARA_FORGE]="restart:amethystora-yara.service"
    [OSPREY]="now"
    [TRIAGE]="now"
    [REPUTATION]="run"
    [BEHAVIOUR]="restart:amethystora-behaviour.service run"
)
declare -A GROUP=(
    [WATCHER]=watching [ON_BATTERY]=watching [REALTIME_WATCH]=watching [AUDIT_LOG]=watching [IDENTITY]=audit [PRIVILEGE]=audit
    [PERSISTENCE]=audit [HARDENING]=audit [MODULES]=audit [INPUT_CAPTURE]=audit [USER_PROGRAMS]=audit
    [JOURNAL]=watching [IMAGE_DRIFT]=watching [SETUID_SWEEP]=watching [LISTENERS]=watching
    [USER_PATHS]=watching [VIRUS_SCAN]=scans [REALTIME_SCAN]=scans [ON_DETECTION]=scans
    [SETTINGS_AUDIT]=scans [NETWORK]=network [NOTIFY]=notices [REPORT_ALERTS]=notices
    [APP_PERMISSIONS]=detection [DEV_HOOKS]=detection
    [SELINUX_DENIALS]=detection
    [PROCESSES]=detection
    [BPF_PROGRAMS]=detection
    [AGENT_CONFIG]=detection
    [EXEC_WATCH]=detection
    [AGENT_CLIS]=detection
    [CREDENTIALS]=detection
    [DECOY]=detection
    [SNAPSHOT_WATCH]=detection
    [CHAINS]=detection
    [NETWORK_FEEDS]=network
    [NETWORK_HUNTING]=network
    [DNS_NAMES]=network
    [YARA_ELASTIC]=scans
    [YARA_SIGNATURE_BASE]=scans
    [YARA_FORGE]=scans
    [OSPREY]=away
    [TRIAGE]=away
    [REPUTATION]=away
    [BEHAVIOUR]=detection
)
# What leaves the machine: none, or downloads (signatures and rules, fetched on the machine)
declare -A SENDS=([VIRUS_SCAN]=downloads [NETWORK]=downloads [NETWORK_FEEDS]=downloads [YARA_ELASTIC]=downloads
    [YARA_SIGNATURE_BASE]=downloads [YARA_FORGE]=downloads
    # ...or what goes to somebody else: each such switch is chosen on its own, after its explanation, and no
    # profile turns one on
    [OSPREY]=sites [TRIAGE]=event [REPUTATION]=hashes)

usage() {
    echo "usage: ${0##*/} KEY | --is KEY VALUE... | --all | --list [--json] | --profile" \
        "| set KEY VALUE | profile off|default|light|balanced|thorough | note SWITCH VALUE" >&2
    exit 64
}

known_key() { [[ -n "${DEFAULTS[$1]+set}" ]]; }
allowed() { [[ " ${ALLOWED[$1]} " == *" $2 "* ]]; }

# What the file says, read once: the last assignment wins, the way a sourced file would have it, without
# sourcing anything
declare -A FOUND=()
while IFS='=' read -r key found; do
    FOUND["${key}"]="${found}"
done < <(sed -nE 's/^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*"?([a-z]*)"?[[:space:]]*(#.*)?$/\1=\2/p' \
    "${CONFIG}" 2>/dev/null)

value() {
    local key="$1" default
    if allowed "${key}" "${FOUND[${key}]:-}"; then
        echo "${FOUND[${key}]}"
        return
    fi
    default="${DEFAULTS[${key}]}"
    # A half of REALTIME that is not set itself follows it
    [[ "${default}" == REALTIME ]] && default="$(value REALTIME)"
    echo "${default}"
}

need_root() {
    [[ "${EUID}" -eq 0 ]] || { echo "Changing a security setting needs root." >&2; exit 77; }
}

# Who asked, for the note: sudo and pkexec both say
asker() {
    if [[ -n "${SUDO_USER:-}" ]]; then
        echo "${SUDO_USER}"
    elif [[ -n "${PKEXEC_UID:-}" ]]; then
        id -nu "${PKEXEC_UID}" 2>/dev/null || echo "${PKEXEC_UID}"
    else
        id -nu
    fi
}

note() {
    [[ "$1" =~ ^[a-z0-9_.=:-]+$ && "$2" =~ ^[a-z0-9_.=:-]+$ ]] || usage
    need_root
    mkdir -p -m 0755 "${NOTES%/*}"
    printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "$(asker)" >>"${NOTES}"
    tail -n "${NOTES_KEPT}" "${NOTES}" >"${NOTES}.new" && mv "${NOTES}.new" "${NOTES}"
    chmod 0600 "${NOTES}"
}

write() {
    local key="$1" new="$2"
    mkdir -p "${CONFIG%/*}"
    if [[ -z "${new}" ]]; then
        sed -i -E "/^[[:space:]]*${key}[[:space:]]*=/d" "${CONFIG}" 2>/dev/null
    elif grep -qE "^[[:space:]]*${key}[[:space:]]*=" "${CONFIG}" 2>/dev/null; then
        sed -i -E "s/^[[:space:]]*${key}[[:space:]]*=.*/${key}=${new}/" "${CONFIG}"
    else
        printf '%s=%s\n' "${key}" "${new}" >>"${CONFIG}"
    fi
    chmod 0644 "${CONFIG}"
}

# Which profile the keys match as they stand: off, default, or custom
# The profiles beside off and default, shortcuts that set what looks for new threats and every other key to
# its default. None turns on, or touches, a switch that sends something to somebody else: each of those is
# chosen on its own, after its explanation.
declare -A PROFILE_LIGHT=([PROCESSES]=record [SELINUX_DENIALS]=record [SNAPSHOT_WATCH]=on [AGENT_CLIS]=record
    [AGENT_CONFIG]=on [DEV_HOOKS]=record [APP_PERMISSIONS]=on)
declare -A PROFILE_BALANCED=([PROCESSES]=on [SELINUX_DENIALS]=on [SNAPSHOT_WATCH]=on [AGENT_CLIS]=on [AGENT_CONFIG]=on
    [DEV_HOOKS]=on [APP_PERMISSIONS]=on [BPF_PROGRAMS]=record [CREDENTIALS]=record [EXEC_WATCH]=record [CHAINS]=on
    [NETWORK_FEEDS]=daily)
declare -A PROFILE_THOROUGH=([PROCESSES]=on [SELINUX_DENIALS]=on [SNAPSHOT_WATCH]=on [AGENT_CLIS]=on [AGENT_CONFIG]=on
    [DEV_HOOKS]=on [APP_PERMISSIONS]=on [BPF_PROGRAMS]=on [CREDENTIALS]=on [DECOY]=on [EXEC_WATCH]=on [CHAINS]=on
    [NETWORK_FEEDS]=hourly [NETWORK_HUNTING]=record [DNS_NAMES]=record [YARA_ELASTIC]=on [YARA_SIGNATURE_BASE]=on
    [YARA_FORGE]=on [BEHAVIOUR]=record)
PROFILES="off default light balanced thorough"

# Whether KEY sends something to somebody else, which no profile but off and default touches
away() { [[ -n "${SENDS[$1]:-}" && "${SENDS[$1]}" != downloads ]]; }

# What profile NAME sets KEY to, empty for its default; light, balanced and thorough leave what sends away be
profile_value() {
    local name="$1" key="$2"
    case "${name}" in
        off) allowed "${key}" off && echo off || echo "${FOUND[${key}]:-}" ;;
        default) ;;
        light | balanced | thorough)
            local -n table="PROFILE_${name^^}"
            if away "${key}"; then
                echo "${FOUND[${key}]:-}"
            else
                echo "${table[${key}]:-}"
            fi
            ;;
    esac
}

# Which profile the keys match as they stand: one of PROFILES, or custom
current_profile() {
    local key name matches wanted
    for name in ${PROFILES}; do
        matches=true
        for key in "${!DEFAULTS[@]}"; do
            [[ "${DEFAULTS[${key}]}" == REALTIME ]] && continue
            [[ "${name}" != off && "${name}" != default ]] && away "${key}" && continue
            wanted="$(profile_value "${name}" "${key}")"
            [[ "${name}" == off ]] && ! allowed "${key}" off && continue
            [[ -n "${wanted}" ]] || wanted="${DEFAULTS[${key}]}"
            [[ "$(value "${key}")" == "${wanted}" ]] || { matches=false; break; }
        done
        # The halves of REALTIME are off with the rest, and at their default when they follow it
        if [[ "${name}" == off ]]; then
            [[ "$(value REALTIME_SCAN)" == off && "$(value REALTIME_WATCH)" == off ]] || matches=false
        elif [[ -n "${FOUND[REALTIME_SCAN]:-}${FOUND[REALTIME_WATCH]:-}" ]] &&
            [[ "$(value REALTIME_SCAN)" != "$(value REALTIME)" || "$(value REALTIME_WATCH)" != "$(value REALTIME)" ]]; then
            matches=false
        fi
        [[ "${matches}" == true ]] && { echo "${name}"; return; }
    done
    echo custom
}

# What a running feature costs now, from systemd's own accounting: the memory of its daemons, or how long
# its last run took. Empty when it is not running or has not run.
cost() {
    local units="" run="" unit bytes total=0 start stop
    case "$1" in
        VIRUS_SCAN) units="clamd@scan.service clamav-freshclam.service" ;;
        REALTIME_SCAN) units="amethystora-clamav-onaccess.service" ;;
        NETWORK) units="amethystora-ips.service" ;;
        REALTIME_WATCH) units="amethystora-security-realtime.service" ;;
        WATCHER) run=amethystora-security-watch.service ;;
        SETTINGS_AUDIT) run=amethystora-lynis-audit.service ;;
        AUDIT_LOG) units="auditd.service amethystora-sensor.service" ;;
        BEHAVIOUR) units="amethystora-behaviour.service" ;;
        DNS_NAMES) units="amethystora-dns-names.service" ;;
        YARA_ELASTIC | YARA_SIGNATURE_BASE | YARA_FORGE) run=amethystora-yara.service ;;
    esac
    for unit in ${units}; do
        bytes="$(systemctl show -p MemoryCurrent --value "${unit}" 2>/dev/null)"
        [[ "${bytes}" =~ ^[0-9]+$ ]] && total=$((total + bytes))
    done
    if [[ "${total}" -gt 0 ]]; then
        echo "{\"memory\":${total}}"
    elif [[ -n "${run}" ]]; then
        { read -r start; read -r stop; } < <(systemctl show -p ExecMainStartTimestampMonotonic \
            -p ExecMainExitTimestampMonotonic --value "${run}" 2>/dev/null)
        [[ "${start:-0}" =~ ^[1-9][0-9]*$ && "${stop:-0}" =~ ^[1-9][0-9]*$ && "${stop}" -ge "${start}" ]] &&
            echo "{\"seconds\":$(((stop - start + 500000) / 1000000))}"
    elif [[ -n "${TIMINGS[$1]:-}" ]]; then
        # A part of the watcher's: what it took in its last run, which the watcher keeps in status.json
        echo "{\"milliseconds\":${TIMINGS[$1]}}"
    fi
}

# What each part of the security watcher took in its last run, in milliseconds, by its switch
declare -A TIMINGS=()
read_timings() {
    local key ms
    while IFS=$'\t' read -r key ms; do
        [[ "${key}" =~ ^[A-Z_]+$ && "${ms}" =~ ^[0-9]+$ ]] && TIMINGS["${key}"]="${ms}"
    done < <(jq -r '.timings // {} | to_entries[] | "\(.key)\t\(.value)"' \
        /var/lib/amethystora/security/status.json 2>/dev/null)
}

list() {
    # The words are the report's, in the session's language where there is a translation of them
    export TEXTDOMAIN=amethystora
    # shellcheck source=/dev/null
    source gettext.sh
    declare -A TITLE=(
        [WATCHER]="$(gettext "Security watcher")"
        [ON_BATTERY]="$(gettext "On battery")"
        [REALTIME_WATCH]="$(gettext "Real-time watching")"
        [AUDIT_LOG]="$(gettext "Audit log")"
        [IDENTITY]="$(gettext "Accounts")"
        [PRIVILEGE]="$(gettext "Who may become root")"
        [PERSISTENCE]="$(gettext "What starts by itself")"
        [HARDENING]="$(gettext "Security settings")"
        [MODULES]="$(gettext "Kernel modules")"
        [INPUT_CAPTURE]="$(gettext "Keyboard readers")"
        [USER_PROGRAMS]="$(gettext "Programs in home folders")"
        [JOURNAL]="$(gettext "Logins and USB devices")"
        [IMAGE_DRIFT]="$(gettext "Image settings")"
        [SETUID_SWEEP]="$(gettext "Setuid sweep")"
        [LISTENERS]="$(gettext "Open to the network")"
        [USER_PATHS]="$(gettext "Commands a session finds first")"
        [VIRUS_SCAN]="$(gettext "Virus scanner")"
        [REALTIME_SCAN]="$(gettext "Real-time scanning")"
        [ON_DETECTION]="$(gettext "Act on what scans find")"
        [SETTINGS_AUDIT]="$(gettext "Settings audit")"
        [NETWORK]="$(gettext "Network protection")"
        [NOTIFY]="$(gettext "Notifications")"
        [REPORT_ALERTS]="$(gettext "Report alerts")"
        [APP_PERMISSIONS]="$(gettext "Apps that gain permissions")"
        [DEV_HOOKS]="$(gettext "Startup hooks in developer tools")"
        [SELINUX_DENIALS]="$(gettext "SELinux denials")"
        [PROCESSES]="$(gettext "Odd processes")"
        [BPF_PROGRAMS]="$(gettext "Programs in the kernel")"
        [AGENT_CONFIG]="$(gettext "AI agents' settings")"
        [EXEC_WATCH]="$(gettext "Programs run from download folders")"
        [AGENT_CLIS]="$(gettext "AI agents run with their checks off")"
        [CREDENTIALS]="$(gettext "Credential tripwires")"
        [DECOY]="$(gettext "Decoy key")"
        [SNAPSHOT_WATCH]="$(gettext "Ransomware behaviour")"
        [CHAINS]="$(gettext "Chains of steps")"
        [NETWORK_FEEDS]="$(gettext "Faster command-server lists")"
        [NETWORK_HUNTING]="$(gettext "Hunting rules")"
        [DNS_NAMES]="$(gettext "Odd names in DNS")"
        [YARA_ELASTIC]="$(gettext "YARA rules from Elastic")"
        [YARA_SIGNATURE_BASE]="$(gettext "YARA rules from signature-base")"
        [YARA_FORGE]="$(gettext "YARA rules from YARA Forge")"
        [OSPREY]="$(gettext "Site checking (Osprey)")"
        [TRIAGE]="$(gettext "Ask the agent about events")"
        [REPUTATION]="$(gettext "Hash reputation")"
        [BEHAVIOUR]="$(gettext "Behaviour sensor")"
    )
    declare -A DESCRIBE=(
        [WATCHER]="$(gettext "Every 15 minutes, reads the audit log and the journal, compares the settings with the image's, and says what changed. Every switch below that it reads acts only while it is on.")"
        [ON_BATTERY]="$(gettext "Whether the watcher's runs every 15 minutes go on while the machine is on battery. Skipped, the next run on mains power reads the audit log and the journal from where the last one stopped, so what they recorded is said later; what is looked at as it stands, such as the ports open, is looked at then. Real-time watching is not skipped.")"
        [REALTIME_WATCH]="$(gettext "Reads each change as the audit log records it, instead of every 15 minutes.")"
        [AUDIT_LOG]="$(gettext "The kernel's record of changes to accounts, sudo, what starts by itself and the security settings, kept by auditd. Off, nothing is recorded and the switches that read it have nothing to read.")"
        [IDENTITY]="$(gettext "Changes to accounts and their passwords.")"
        [PRIVILEGE]="$(gettext "Changes to who may use sudo and to the administrator rules.")"
        [PERSISTENCE]="$(gettext "Services, autostart entries and shell startup files: what would survive a restart.")"
        [HARDENING]="$(gettext "Changes to the security settings, these switches included. Off, turning one of them off is not said either.")"
        [MODULES]="$(gettext "Kernel modules loaded or removed from a login.")"
        [INPUT_CAPTURE]="$(gettext "A program opening the keyboard or another input device directly, said the first time each program does it.")"
        [USER_PROGRAMS]="$(gettext "Commands and launchers added to a home folder, recorded without notifying.")"
        [JOURNAL]="$(gettext "Accounts locked after wrong passwords, repeated wrong sudo and administrator passwords, and blocked USB devices.")"
        [IMAGE_DRIFT]="$(gettext "The security settings in /etc compared with the image's own copy, and the kernel's settings as they are.")"
        [SETUID_SWEEP]="$(gettext "A daily search of /etc and /var for setuid programs, which only the image should have.")"
        [LISTENERS]="$(gettext "A program that starts accepting connections from other machines.")"
        [USER_PATHS]="$(gettext "A command in a home folder named like one of the system's, and a launcher no container export made.")"
        [VIRUS_SCAN]="$(gettext "ClamAV. Off: no scanning, and no signatures kept in memory or downloaded. Manual: scans only when you start one. Weekly: and every Sunday, the home and temporary folders.")"
        [REALTIME_SCAN]="$(gettext "Scans every file written in a home folder as it is closed. Costs CPU while files are being written.")"
        [ON_DETECTION]="$(gettext "What happens to a file a virus scan finds: reported, moved to quarantine, or deleted.")"
        [SETTINGS_AUDIT]="$(gettext "Lynis audits the settings every month, and says what is new since the last audit.")"
        [NETWORK]="$(gettext "Suricata inspects this machine's connections. Watch says what it recognises; block also cuts off known malware.")"
        [NOTIFY]="$(gettext "What is said out loud: everything, critical findings only, or nothing. Everything is still in the report and the history.")"
        [REPORT_ALERTS]="$(gettext "Says when a check of the report turns bad: the firewall, signed updates, the audit log.")"
        [APP_PERMISSIONS]="$(gettext "A Flatpak app that gains a way out of its sandbox, through an update, an override or another app in its place. Read as each account with a session in the last day, and said to that account.")"
        [DEV_HOOKS]="$(gettext "Code put where a developer tool runs it by itself: Python's .pth files, git's hooks and fsmonitor, SSH's ProxyCommand, npm's script shell, and new editor extensions. Read as each account with a session in the last day, and said to that account.")"
        [SELINUX_DENIALS]="$(gettext "A confined service doing what its policy never let it, which is often what an exploit looks like: each different denial said the first time. Needs the audit log.")"
        [PROCESSES]="$(gettext "A program running from a deleted file, from memory alone, or from a temporary or download folder; one disguised as a kernel thread; a network tool or AI agent started by an npm package's install script; and an AI agent run with its own checks off. Each said the first time for that program.")"
        [BPF_PROGRAMS]="$(gettext "A program loaded into the kernel's BPF, which is how eBPF rootkits hide files and connections: recorded when new, and said when loaded by a program outside the system, or when it watches the kernel and nothing is left holding it.")"
        [AGENT_CONFIG]="$(gettext "A hook, an MCP server, a plugin or a command put in an AI agent's own settings, which it then runs by itself, and a permission mode that turns its checks off. Read as each account with a session in the last day, and said to that account.")"
        [EXEC_WATCH]="$(gettext "A program run for the first time from a temporary folder, ~/.cache or the download folder: a download or a dropped file starting. Recorded by the audit log, from the next restart.")"
        [AGENT_CLIS]="$(gettext "An AI agent started with a flag that turns its own checks off, as an npm install script did in the Nx attack: said when no terminal started it. Recorded by the audit log on the folders the agents run from, from the next restart.")"
        [CREDENTIALS]="$(gettext "A program reading where secrets are kept that is not their own: SSH keys, package registry and cloud tokens, the browsers' passwords and cookies, the AI agents' tokens. One process reading several kinds is critical. Recorded by the audit log, from the next restart.")"
        [DECOY]="$(gettext "Puts a fake SSH key, ~/.ssh/id_backup, in each home folder, which nothing legitimate reads: any read of it is critical. Off takes it away again, at the next restart.")"
        [SNAPSHOT_WATCH]="$(gettext "After each hourly snapshot, how many files of each account changed or were deleted within the hour, and whether those that changed went from readable to random, as encryption makes them. Needs ransomware protection's snapshots.")"
        [CHAINS]="$(gettext "Steps of one attack, put together: two different ones for one account within half an hour, such as a program run from the downloads and a token read, are said, and three, or reading secrets then reaching a command server, are critical. It reads what the other switches find, recorded or said.")"
        [NETWORK_FEEDS]="$(gettext "abuse.ch's lists of botnet servers, command servers' certificates and malware addresses, added to network protection's rules, daily or hourly: they know new campaigns hours after they start. Downloaded on this machine, skipped on a metered connection.")"
        [NETWORK_HUNTING]="$(gettext "Emerging Threats' hunting rules, which catch the suspicious but uncertain, where new attacks first show: recorded for the chains of steps, never said and never blocked. Costs memory for the rules.")"
        [DNS_NAMES]="$(gettext "Names looked up that look made by a program, as malware makes its command servers' names, or that carry data, as DNS tunnelling does. Every name passes through it and only those are kept, for up to 15 minutes, where only root can read them.")"
        [YARA_ELASTIC]="$(gettext "Elastic's rules for Linux malware families, which the virus scanner then recognises by their structure, where a hash signature misses a variant. Downloaded on this machine; under the Elastic License 2.0.")"
        [YARA_SIGNATURE_BASE]="$(gettext "Florian Roth's rules, under the Detection Rule License: mostly for Windows malware and attack tools, some of which a security professional uses on purpose. Downloaded on this machine.")"
        [YARA_FORGE]="$(gettext "YARA Forge's core set, from many authors: only the rules whose licence asks nothing beyond naming the author. Downloaded on this machine.")"
        [OSPREY]="$(gettext "Browsers may install Osprey, which checks each site you open against more than twenty threat-intelligence providers and warns or blocks. Only allowed, never installed: you install it from your browser's store.")"
        [TRIAGE]="$(gettext "Ask the agent on an event of the Events page has your AI agent explain what it most likely is, in a terminal, reading only and changing nothing.")"
        [REPUTATION]="$(gettext "Looks up each program odd processes or the download folders' watch saw run for the first time with MalwareBazaar, by its hash, with your own free abuse.ch key: known malware recognised sooner than a signature. It catches nothing new.")"
        [BEHAVIOUR]="$(gettext "Falco watches what every process does as the kernel sees it, each command, file opened and connection, through an eBPF probe, and the watcher reads what its rules notice. It runs all the time: a little CPU and a few hundred megabytes.")"
    )
    # What a switch that sends something to somebody else sends, and to whom, said before it is turned on
    declare -A EXPLAIN=(
        [OSPREY]="$(gettext "Osprey sends the address of every site you open to Osprey Project LLC, in California, and on from there to its providers, without the query string and without your address. Amethystora does not make it: it is GPL-3.0, and you install it from your browser's own store, where it can be removed like any other extension.")"
        [TRIAGE]="$(gettext "Each event you ask about goes to your AI agent's maker with what the agent then reads on this machine: file names, program names and command lines, some of them other accounts'. The event is written partly by whatever it is about, so the agent is told to treat it as data and never to change anything.")"
        [REPUTATION]="$(gettext "The hash of each new program that runs goes to abuse.ch, a Swiss non-profit run with Spamhaus, with your key: never the file, its name or its path. A hash can still say which files you have, and the lookups made with one key say when new programs ran. It needs your own free key from auth.abuse.ch, for not-for-profit use.")"
    )
    local key spent json=false
    [[ "${1:-}" == --json ]] && json=true
    if [[ "${json}" == true ]]; then
        read_timings
        for key in "${KEYS[@]}"; do
            spent="$(cost "${key}")"
            jq -nc --arg key "${key}" --arg value "$(value "${key}")" --arg title "${TITLE[${key}]}" \
                --arg text "${DESCRIBE[${key}]}" --arg group "${GROUP[${key}]}" \
                --arg allowed "${ALLOWED[${key}]}" --arg applies "${APPLIES[${key}]}" \
                --arg sends "${SENDS[${key}]:-none}" --arg explain "${EXPLAIN[${key}]:-}" --argjson cost "${spent:-null}" \
                '{$key, setting: ($key | ascii_downcase | gsub("_"; "-")), $value, $title, $text, $group,
                  allowed: ($allowed | split(" ")), applies: ($applies | split(" ")), $sends,
                  explain: (if $explain == "" then null else $explain end), $cost}'
        done | jq -s --arg profile "$(current_profile)" '{$profile, settings: .}'
    else
        for key in "${KEYS[@]}"; do
            printf '  %-32s %-8s (%s)\n' "${TITLE[${key}]}" "$(value "${key}")" "${ALLOWED[${key}]// /, }"
            printf '      %s\n' "$(fold -s -w 92 <<<"${DESCRIBE[${key}]}" | sed 's/ *$//; 2,$s/^/      /')"
            printf '      ame security settings %s VALUE\n' "$(tr 'A-Z_' 'a-z-' <<<"${key}")"
        done
    fi
}

case "${1:-}" in
    --is)
        [[ $# -ge 3 ]] && known_key "$2" || usage
        current="$(value "$2")"
        shift 2
        for wanted in "$@"; do
            [[ "${current}" == "${wanted}" ]] && exit 0
        done
        exit 1
        ;;
    --all)
        for key in "${!DEFAULTS[@]}"; do
            echo "${key}=$(value "${key}")"
        done
        ;;
    --list)
        list "${2:-}"
        ;;
    --profile)
        current_profile
        ;;
    set)
        [[ $# -eq 3 ]] && known_key "$2" || usage
        allowed "$2" "$3" || { echo "${2} can be one of: ${ALLOWED[$2]}" >&2; exit 64; }
        need_root
        write "$2" "$3"
        # Setting REALTIME is setting both of its halves
        if [[ "$2" == REALTIME ]]; then
            write REALTIME_SCAN ""
            write REALTIME_WATCH ""
        fi
        note "$(tr 'A-Z_' 'a-z-' <<<"$2")" "$3"
        ;;
    profile)
        [[ $# -eq 2 && " ${PROFILES} " == *" $2 "* ]] || usage
        need_root
        for key in "${!DEFAULTS[@]}"; do
            if [[ "$2" == off ]]; then
                allowed "${key}" off && write "${key}" off
            elif [[ "$2" != default ]] && away "${key}"; then
                # What sends something away stays as its owner chose
                continue
            elif [[ "${DEFAULTS[${key}]}" == REALTIME ]]; then
                write "${key}" ""
            else
                wanted="$(profile_value "$2" "${key}")"
                write "${key}" "${wanted:-${DEFAULTS[${key}]}}"
            fi
        done
        note profile "$2"
        ;;
    note)
        [[ $# -eq 3 ]] || usage
        note "$2" "$3"
        ;;
    "" | -*)
        usage
        ;;
    *)
        known_key "$1" || usage
        value "$1"
        ;;
esac
