#!/usr/bin/bash
# Greeting shown in new terminals (/etc/profile.d/amethystora-greeting.sh, fish_greeting.fish):
# a welcome line in the Amethystora purple, then the logo and system summary.

if [ -t 1 ] && [ -z "${NO_COLOR-}" ]; then
    printf '\n\e[1;38;2;155;92;224mWelcome to Amethystora\e[0m\n\n'
else
    printf '\nWelcome to Amethystora\n\n'
fi

# Label colour: fastfetch takes GNOME's accent colour, which is never set here, so it would fall back to blue
export FASTFETCH_FORCE_THEME="${FASTFETCH_FORCE_THEME:-purple}"

# The text console (Ctrl+Alt+F3) turns the truecolour logo's dark facets blue: draw it in the console's magentas
if [ "${TERM-}" = "linux" ]; then
    exec amethystora-fastfetch --logo /usr/share/amethystora/logos/console/amethystora
fi
exec amethystora-fastfetch
