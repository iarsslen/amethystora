#!/usr/bin/bash
# The login screen's background, while an image is built (12-login-screen.sh for Amethystora's own picture,
# amethystora-brand for the picture of an image of one's own built on it; never on a machine):
#
#   amethystora-login-background PICTURE
#
# GNOME takes it from exactly one place: the #lockDialogGroup rule in GNOME Shell's own stylesheet,
# which ships compiled into gnome-shell-theme.gresource. There is no setting for it and no drop-in
# directory, so the bundle is unpacked, the picture put in it, the rule appended, and the bundle built again.
#
# The usual objection to doing this is that the next gnome-shell update overwrites it. That is an
# objection to doing it on a running system: here the image is rebuilt from scratch, so an update to
# gnome-shell means this runs again on the new stylesheet rather than being undone by it.
#
# Run again on a bundle that already has a picture, it puts the new one in its place under the same name,
# and the rule that names it stays the one rule.
#
# The same stylesheet carries the lock screen's look, which no extension can reach (GNOME runs none while the
# screen is locked): the large clock and date in Quicksand, and what is playing and the notifications as cards of
# glass. Its colours are Amethystora's own, like the login screen's, not the theme's. It is appended once too.

set -euo pipefail

BACKGROUND="${1:?usage: amethystora-login-background PICTURE}"
GRESOURCE=/usr/share/gnome-shell/gnome-shell-theme.gresource
PREFIX=/org/gnome/shell/theme
CLOCK_MARKER="Amethystora: the lock screen clock and its cards (/usr/libexec/amethystora-login-background)"
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

test -s "${BACKGROUND}"
test -s "${GRESOURCE}"

# glib-compile-resources and gresource both come from glib2-devel, which build-gnome-extensions.sh
# takes back out when it has finished with it. Neither is in glib2 itself, so both have to be
# brought back before the bundle can be read or written.
GLIB_DEVEL_ADDED=false
if ! command -v glib-compile-resources >/dev/null || ! command -v gresource >/dev/null; then
    # dnf leaves its lock in /run, where `bootc container lint` wants nothing, unless it was there already
    RUN_DNF_WAS_THERE=false
    [[ -e /run/dnf ]] && RUN_DNF_WAS_THERE=true
    dnf5 -y install glib2-devel
    GLIB_DEVEL_ADDED=true
fi

mapfile -t RESOURCES < <(gresource list "${GRESOURCE}")
# The stock bundle holds the three stylesheets and a handful of images. Far fewer than that means
# gresource read something other than the theme, and the rebuilt bundle would drop what it missed.
((${#RESOURCES[@]} >= 4))
for resource in "${RESOURCES[@]}"; do
    file="${WORK}/${resource#"${PREFIX}/"}"
    mkdir -p "$(dirname "${file}")"
    gresource extract "${GRESOURCE}" "${resource}" >"${file}"
done

# The background travels inside the bundle, so the stylesheet can name it the way the shell names
# its own artwork: a relative URL, which St resolves against the stylesheet's place in the bundle. St
# reads a picture by what it holds, whatever its name says.
install -pm0644 "${BACKGROUND}" "${WORK}/amethystora-login.png"

# Both stylesheets, because the greeter follows the colour scheme and either can be the one in use.
# The rule is appended rather than substituted for the upstream one: the last rule of the same
# specificity is the one that applies, and leaving theirs in place keeps the change to one block at
# the end of the file, where a diff against stock gnome-shell shows it whole.
for stylesheet in "${WORK}/gnome-shell-dark.css" "${WORK}/gnome-shell-light.css"; do
    test -s "${stylesheet}"
    # If the selector has gone, the rule below would be styling nothing at all
    grep -q "lockDialogGroup" "${stylesheet}"
    if ! grep -qF 'background-image: url("amethystora-login.png")' "${stylesheet}"; then
        cat >>"${stylesheet}" <<'EOF'

/* Amethystora: the login screen background (/usr/libexec/amethystora-login-background) */
#lockDialogGroup {
  background-image: url("amethystora-login.png");
  background-size: cover;
}
EOF
    fi
    # The lock screen's own classes, as GNOME Shell's unlockDialog.js names them: if they have gone, the block
    # below would style nothing
    grep -q "unlock-dialog-clock-time" "${stylesheet}"
    grep -q "unlock-dialog-notifications-container" "${stylesheet}"
    grep -qF "${CLOCK_MARKER}" "${stylesheet}" && continue
    # GNOME's own rules for the clock are nested under .unlock-dialog-clock, so these are as well: a rule of the same
    # weight that comes later wins, a lighter one would not. St cuts a text shadow off at the label's edges, where a
    # wider blur than this one shows as a box around the time.
    cat >>"${stylesheet}" <<EOF

/* ${CLOCK_MARKER} */
.unlock-dialog-clock {
  spacing: 4px;
}
.unlock-dialog-clock .unlock-dialog-clock-time {
  font-family: "Quicksand";
  font-size: 116px;
  font-weight: 600;
  letter-spacing: -2px;
  color: #f3ecfb;
  text-shadow: 0 6px 12px rgba(0, 0, 0, 0.35);
}
.unlock-dialog-clock .unlock-dialog-clock-date {
  font-family: "Quicksand";
  font-size: 20px;
  font-weight: 600;
  color: #e3d6f5;
}
.unlock-dialog-notifications-container {
  width: 360px;
  spacing: 10px;
}
.unlock-dialog-notifications-container .message,
.unlock-dialog-notifications-container .unlock-dialog-notification-source {
  background-color: rgba(26, 16, 42, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 22px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  padding: 12px;
  color: #efe4ff;
}
.unlock-dialog-notifications-container .unlock-dialog-notification-source {
  border-radius: 999px;
  padding: 7px 16px;
  font-size: 13.5px;
  font-weight: 700;
}
.unlock-dialog-notifications-container .message.critical,
.unlock-dialog-notifications-container .unlock-dialog-notification-source.critical {
  background-color: rgba(58, 26, 74, 0.62);
}
.unlock-dialog-notifications-container .message:active,
.unlock-dialog-notifications-container .unlock-dialog-notification-source:active {
  background-color: rgba(26, 16, 42, 0.58);
}
EOF
done

# Rebuilt from what was unpacked plus the one file added, so anything the bundle held that this
# script has no opinion about is carried over untouched
{
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<gresources>'
    echo "  <gresource prefix=\"${PREFIX}\">"
    (cd "${WORK}" && find . -type f ! -name '*.gresource.xml' -printf '%P\n' | sort) |
        while read -r file; do echo "    <file>${file}</file>"; done
    echo '  </gresource>'
    echo '</gresources>'
} >"${WORK}/gnome-shell-theme.gresource.xml"

glib-compile-resources --sourcedir="${WORK}" --target="${GRESOURCE}" \
    "${WORK}/gnome-shell-theme.gresource.xml"

# The bundle has to still hold everything it held before, plus the background, and the stylesheets
# have to have come through with the rule in them. Not grep -q: it quits at the first match, and
# under pipefail the SIGPIPE that gresource then gets fails the build with exit 141
gresource list "${GRESOURCE}" | grep -x "${PREFIX}/amethystora-login.png" >/dev/null
for resource in "${RESOURCES[@]}"; do
    gresource list "${GRESOURCE}" | grep -x "${resource}" >/dev/null
done
for variant in dark light; do
    gresource extract "${GRESOURCE}" "${PREFIX}/gnome-shell-${variant}.css" >"${WORK}/check.css"
    [[ "$(grep -c 'background-image: url("amethystora-login.png")' "${WORK}/check.css")" == 1 ]]
    # The clock's block once, and the clock in it in Quicksand at its size
    [[ "$(grep -cF "${CLOCK_MARKER}" "${WORK}/check.css")" == 1 ]]
    awk -v marker="${CLOCK_MARKER}" 'index($0, marker) { on = 1 } on && /\.unlock-dialog-clock-time \{/ { block = 1 }
        block { print } block && /\}/ { exit }' "${WORK}/check.css" >"${WORK}/clock.css"
    grep -qF 'font-family: "Quicksand";' "${WORK}/clock.css"
    grep -qF 'font-size: 116px;' "${WORK}/clock.css"
done
cmp -s "${BACKGROUND}" <(gresource extract "${GRESOURCE}" "${PREFIX}/amethystora-login.png")

if [[ "${GLIB_DEVEL_ADDED}" == true ]]; then
    dnf5 -y remove glib2-devel
    [[ "${RUN_DNF_WAS_THERE}" == true ]] || rm -rf /run/dnf
fi
