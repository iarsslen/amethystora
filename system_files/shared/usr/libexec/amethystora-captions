#!/usr/bin/python3 -I
# Live captions (plans/beyond/spec-r4-later.md, part B): words for the speech this computer plays, made on this
# computer by the Vosk recognizer through GStreamer's vosk element (Fedora's gst-vosk), and shown by Amethystora UI's
# captions module. Run as the account.
#
#   amethystora-captions status    ready, no-model or no-engine
#   amethystora-captions fetch     downloads the speech model once, checks it against its pinned SHA-256 and unpacks it
#                                  into ~/.local/share/amethystora/captions/model; nothing is kept when it fails
#   amethystora-captions remove    deletes the model, and what a fetch that was cut short left
#   amethystora-captions listen    the recognizer, for the module: `play` and `pause` on stdin, one per line, start and
#                                  stop listening; JSON lines on stdout, {"partial": TEXT} while a sentence is spoken,
#                                  {"text": TEXT} when it ends, {"error": "model"|"engine"|"audio"}; it ends with stdin
#
# The sound comes from the monitor of the default output (what the speakers play), only while the module says play,
# and reaches the recognizer only while it is not silent (a level meter shuts a valve after two seconds of silence, so
# that a stream a paused player keeps open costs next to nothing); it goes into the recognizer's memory alone: no element of the pipeline writes a file or opens a connection, and
# the words exist only in the pipe and on the screen. The `ame desktop captions` recipe says all of this, and asks,
# before `fetch` makes the one connection there is.

import hashlib
import json
import os
import shutil
import subprocess
import sys
import zipfile

# The model: Vosk's small US English model (Apache-2.0, Alpha Cephei), pinned by its address and SHA-256. Its MD5 is
# the one the maker's model list gives (09ab50ccd62b674cbaa231b825f9c1cb)
MODEL_URL = 'https://alphacephei.com/vosk/models/vosk-model-small-en-us-0.15.zip'
MODEL_SHA256 = '30f26242c4eb449f948e42cb302dd7a686cb29a3423a8367f99ff41780942498'
MODEL_DIR = 'vosk-model-small-en-us-0.15'
MODEL_BYTES = 41205931
# A file that tells the folder is a whole model (vosk reads it first)
MARKER = os.path.join('conf', 'model.conf')
# What the recognizer is given: 16 kHz mono, as the model was trained; partial results at most every 300 ms
SAMPLE_RATE = 16000
PARTIAL_MS = 300
# Silence: a peak under -60 dB for 2 s shuts the valve before the recognizer; the meter looks every 100 ms, so the
# first tenth of a second of the next sound may be missed
SILENT_DB = -60.0
SILENT_S = 2.0
LEVEL_NS = 100_000_000
# By its full path: a curl of the account's own earlier in PATH is not run instead
CURL = '/usr/bin/curl'


def folder():
    data = os.environ.get('XDG_DATA_HOME', '')
    if not os.path.isabs(data):
        data = os.path.join(os.path.expanduser('~'), '.local', 'share')
    return os.path.join(data, 'amethystora', 'captions')


def model_path():
    return os.path.join(folder(), 'model')


def have_model():
    return os.path.isfile(os.path.join(model_path(), MARKER))


def gst():
    import gi
    gi.require_version('Gst', '1.0')
    from gi.repository import Gst
    Gst.init(None)
    return Gst


def have_engine():
    try:
        Gst = gst()
    except (ImportError, ValueError):
        return False
    return all(Gst.ElementFactory.find(name) for name in ('vosk', 'pulsesrc', 'audioconvert', 'audioresample', 'level', 'valve'))


def status():
    print('no-engine' if not have_engine() else 'ready' if have_model() else 'no-model')
    return 0


def unpack(archive, into):
    """The model's members, each kept inside its own folder: nothing absolute, no '..', no link, nothing else"""
    with zipfile.ZipFile(archive) as z:
        for info in z.infolist():
            name = info.filename
            parts = name.split('/')
            if name.startswith('/') or '\\' in name or '..' in parts or parts[0] != MODEL_DIR:
                raise ValueError(f'the archive holds {name!r}')
            # A link is stored with the Unix mode of one in the upper bits
            if (info.external_attr >> 16) & 0o170000 == 0o120000:
                raise ValueError(f'the archive holds a link, {name!r}')
        z.extractall(into)
    return os.path.join(into, MODEL_DIR)


def fetch():
    base = folder()
    os.makedirs(base, mode=0o700, exist_ok=True)
    os.chmod(base, 0o700)
    part = os.path.join(base, '.download.zip')
    fresh = os.path.join(base, '.unpacking')
    url = MODEL_URL
    protocols = '=https'
    # The VM lab hands over a copy it keeps. What makes that safe is the pinned SHA-256 below: whatever the address,
    # only the model's own bytes are ever unpacked, and anything else is deleted
    if os.environ.get('AMETHYSTORA_CAPTIONS_URL'):
        url = os.environ['AMETHYSTORA_CAPTIONS_URL']
        protocols = '=https,http,file'
    try:
        # A redirect is held to the same protocols as the first request (curl's own default lets one go to http)
        subprocess.run([CURL, '--proto', protocols, '--proto-redir', protocols, '--tlsv1.2', '-fL',
                        '--max-filesize', str(MODEL_BYTES + 1024 * 1024),
                        '--retry', '2', '--progress-bar', '-o', part, '--', url], check=True)
        digest = hashlib.sha256()
        with open(part, 'rb') as f:
            for block in iter(lambda: f.read(1 << 20), b''):
                digest.update(block)
        if digest.hexdigest() != MODEL_SHA256:
            print(f'amethystora-captions: the download is not the model (SHA-256 {digest.hexdigest()})', file=sys.stderr)
            return 1
        shutil.rmtree(fresh, ignore_errors=True)
        os.makedirs(fresh, mode=0o700)
        unpacked = unpack(part, fresh)
        if not os.path.isfile(os.path.join(unpacked, MARKER)):
            print('amethystora-captions: the archive holds no model', file=sys.stderr)
            return 1
        shutil.rmtree(model_path(), ignore_errors=True)
        os.rename(unpacked, model_path())
        return 0
    except (OSError, ValueError, zipfile.BadZipFile, subprocess.CalledProcessError) as e:
        print(f'amethystora-captions: {e}', file=sys.stderr)
        return 1
    finally:
        for leftover in (part,):
            try:
                os.unlink(leftover)
            except FileNotFoundError:
                pass
        shutil.rmtree(fresh, ignore_errors=True)


def remove():
    # A fetch ended by closing its terminal leaves its partial files
    for name in ('model', '.unpacking', '.download.zip'):
        path = os.path.join(folder(), name)
        if os.path.isdir(path) and not os.path.islink(path):
            shutil.rmtree(path, ignore_errors=True)
        elif os.path.lexists(path):
            os.unlink(path)
    return 0


def say(record):
    try:
        sys.stdout.write(json.dumps(record, ensure_ascii=False) + '\n')
        sys.stdout.flush()
    except BrokenPipeError:
        os._exit(0)


def sentence(text):
    """The recognizer writes lower case without stops: a sentence starts with a capital"""
    text = ' '.join(text.split())
    return text[:1].upper() + text[1:]


def listen():
    if not have_engine():
        say({'error': 'engine'})
        return 1
    if not have_model():
        say({'error': 'model'})
        return 1
    Gst = gst()
    from gi.repository import GLib

    pipeline = Gst.Pipeline.new('captions')
    source = Gst.ElementFactory.make('pulsesrc', 'sound')
    # The monitor of the default output, which follows the output the person picks; the stream says what it is in the
    # sound settings
    source.set_property('device', '@DEFAULT_MONITOR@')
    source.set_property('client-name', 'Live captions')
    source.set_property('stream-properties', Gst.Structure.new_from_string(
        'props,application.id=org.amethystora.Captions,media.role=accessibility'))
    convert = Gst.ElementFactory.make('audioconvert')
    resample = Gst.ElementFactory.make('audioresample')
    caps = Gst.ElementFactory.make('capsfilter')
    caps.set_property('caps', Gst.Caps.from_string(f'audio/x-raw,format=S16LE,rate={SAMPLE_RATE},channels=1'))
    recognizer = Gst.ElementFactory.make('vosk', 'words')
    recognizer.set_property('speech-model', model_path())
    recognizer.set_property('partial-results-interval', PARTIAL_MS)
    # Its noise filter is for a microphone's room; what the speakers play has none, and the filter costs a fifth more
    # time for the same words (measured on a test sentence)
    recognizer.set_property('enable-denoise', False)
    # Silence goes no further than the valve: the meter measures what comes, and the valve drops it while it is quiet
    meter = Gst.ElementFactory.make('level', 'meter')
    meter.set_property('interval', LEVEL_NS)
    meter.set_property('post-messages', True)
    gate = Gst.ElementFactory.make('valve', 'gate')
    sink = Gst.ElementFactory.make('fakesink')
    sink.set_property('sync', False)
    elements = [source, convert, resample, caps, meter, gate, recognizer, sink]
    for element in elements:
        pipeline.add(element)
    for a, b in zip(elements, elements[1:]):
        a.link(b)

    loop = GLib.MainLoop()
    last = {'partial': None, 'quiet': 0.0}

    def on_message(bus, message):
        if message.type == Gst.MessageType.ELEMENT and message.src == meter:
            peaks = message.get_structure().get_value('peak') or []
            if max(peaks, default=-200.0) < SILENT_DB:
                last['quiet'] += LEVEL_NS / 1e9
            else:
                last['quiet'] = 0.0
            shut = last['quiet'] >= SILENT_S
            if gate.get_property('drop') != shut:
                gate.set_property('drop', shut)
        elif message.type == Gst.MessageType.ELEMENT and message.src == recognizer:
            raw = message.get_structure().get_string('current-result')
            try:
                result = json.loads(raw or '{}')
            except ValueError:
                return
            if 'text' in result:
                last['partial'] = None
                if result['text'].strip():
                    say({'text': sentence(result['text'])})
            elif result.get('partial', '').strip() and result['partial'] != last['partial']:
                last['partial'] = result['partial']
                say({'partial': sentence(result['partial'])})
        elif message.type == Gst.MessageType.ERROR:
            error, debug = message.parse_error()
            print(f'amethystora-captions: {error.message} ({debug})', file=sys.stderr)
            say({'error': 'audio' if message.src == source else 'model'})
            loop.quit()

    bus = pipeline.get_bus()
    bus.add_signal_watch()
    bus.connect('message', on_message)

    pending = bytearray()

    def on_command(channel, condition):
        # Read from the descriptor itself: a buffered reader would keep a second line where the watch never sees it
        try:
            chunk = os.read(sys.stdin.fileno(), 4096) if condition & GLib.IOCondition.IN else b''
        except OSError:
            chunk = b''
        if not chunk:
            loop.quit()
            return False
        pending.extend(chunk)
        while b'\n' in pending:
            line, _, rest = bytes(pending).partition(b'\n')
            pending[:] = rest
            word = line.strip()
            if word == b'play':
                pipeline.set_state(Gst.State.PLAYING)
            elif word == b'pause':
                # A live source paused reads nothing: the stream is corked, and the recognizer has nothing to do
                pipeline.set_state(Gst.State.PAUSED)
        # A line too long to be a word is nobody's
        if len(pending) > 64:
            pending.clear()
        return True

    GLib.io_add_watch(GLib.IOChannel.unix_new(sys.stdin.fileno()), GLib.PRIORITY_DEFAULT,
                      GLib.IOCondition.IN | GLib.IOCondition.HUP | GLib.IOCondition.ERR, on_command)
    # Paused from the start: the model is loaded now, so that the first words of the first sound are not lost
    pipeline.set_state(Gst.State.PAUSED)
    try:
        loop.run()
    finally:
        pipeline.set_state(Gst.State.NULL)
    return 0


def main(argv):
    commands = {'status': status, 'fetch': fetch, 'remove': remove, 'listen': listen}
    if len(argv) != 2 or argv[1] not in commands:
        print('usage: amethystora-captions status|fetch|remove|listen', file=sys.stderr)
        return 64
    return commands[argv[1]]()


if __name__ == '__main__':
    sys.exit(main(sys.argv))
