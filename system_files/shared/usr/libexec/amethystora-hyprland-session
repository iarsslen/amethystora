#!/usr/bin/bash
# Starts Amethystora's Hyprland session (launched by greetd through hyprland.desktop).
# On a user's first login, deploy the DankMaterialShell Hyprland config (keybinds, colours, layout,
# kitty) before Hyprland reads it; Hyprland would otherwise generate its own bare default config.

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

# Prefer native Wayland for Qt and Electron applications
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

# NVIDIA images: https://wiki.hypr.land/Nvidia/
if [[ -d /sys/module/nvidia_drm ]]; then
    export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-nvidia}"
    export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
fi

# Software rendering in VMs without a usable GPU. DMS runs as a systemd user service (dms.service),
# which does not inherit this environment, so hand it to the user's service manager too.
# shellcheck source=system_files/shared/usr/lib/amethystora/graphics.sh
source /usr/lib/amethystora/graphics.sh
if [[ -n "${LIBGL_ALWAYS_SOFTWARE:-}" ]]; then
    systemctl --user import-environment LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND
fi

if [[ ! -e "${config_home}/hypr/hyprland.lua" && ! -e "${config_home}/hypr/hyprland.conf" ]]; then
    dms setup headless --compositor hyprland --terminal kitty --skip-existing ||
        echo "amethystora: dms setup failed, Hyprland starts with its default config" >&2
fi

# Window title bars (hyprbars): add them to each user's config once, so removing the line opts out
hyprbars_marker="${XDG_STATE_HOME:-$HOME/.local/state}/amethystora/hyprbars-added"
hypr_config="${config_home}/hypr/hyprland.lua"
if [[ ! -e "${hyprbars_marker}" && -e "${hypr_config}" ]]; then
    grep -qF /usr/share/amethystora/hypr/hyprbars.lua "${hypr_config}" ||
        printf '\n-- Amethystora window title bars\npcall(dofile, "/usr/share/amethystora/hypr/hyprbars.lua")\n' >>"${hypr_config}"
    mkdir -p "$(dirname "${hyprbars_marker}")"
    touch "${hyprbars_marker}"
fi

# New DMS users: show the Amethystora logo (os-release LOGO=amethystora-logo) on the bar's launcher button.
# DMS fills every other setting with its defaults.
dms_settings="${config_home}/DankMaterialShell/settings.json"
if [[ ! -e "${dms_settings}" ]]; then
    mkdir -p "$(dirname "${dms_settings}")"
    printf '{\n  "launcherLogoMode": "os"\n}\n' >"${dms_settings}"
fi

# Amethystora colour theme (dark amethyst accent), once per user. A theme the user already picked is kept.
theme_marker="${XDG_STATE_HOME:-$HOME/.local/state}/amethystora/theme-set"
theme=/usr/share/amethystora/dms/amethystora-theme.json
if [[ ! -e "${theme_marker}" ]]; then
    if jq -e '(.currentThemeName // "") == ""' "${dms_settings}" >/dev/null; then
        jq --arg theme "${theme}" '.currentThemeName = "custom" | .customThemeFile = $theme' "${dms_settings}" \
            >"${dms_settings}.new" && mv "${dms_settings}.new" "${dms_settings}"
    fi
    mkdir -p "$(dirname "${theme_marker}")"
    touch "${theme_marker}"
fi

# Amethystora wallpaper, once per user. Without one DMS draws its own placeholder backdrop. Written to DMS's
# session file before DMS starts, so it does not depend on DMS being ready to take IPC calls; a wallpaper
# the user already picked is kept.
wallpaper_marker="${XDG_STATE_HOME:-$HOME/.local/state}/amethystora/wallpaper-set"
dms_session="${XDG_STATE_HOME:-$HOME/.local/state}/DankMaterialShell/session.json"
wallpaper=/usr/share/backgrounds/amethystora/amethystora-d.png
if [[ ! -e "${wallpaper_marker}" ]]; then
    mkdir -p "$(dirname "${dms_session}")" "$(dirname "${wallpaper_marker}")"
    if [[ ! -s "${dms_session}" ]]; then
        printf '{\n  "wallpaperPath": "%s"\n}\n' "${wallpaper}" >"${dms_session}"
    elif jq -e '(.wallpaperPath // "") == "" and (.perMonitorWallpaper // false) == false' "${dms_session}" >/dev/null; then
        jq --arg wallpaper "${wallpaper}" '.wallpaperPath = $wallpaper' "${dms_session}" >"${dms_session}.new" &&
            mv "${dms_session}.new" "${dms_session}"
    fi
    touch "${wallpaper_marker}"
fi

exec start-hyprland "$@"
