#!/usr/bin/bash
# Amethystora's duress credential, a finger or a password that also runs its owner's action. At the login
# and lock screens it unlocks like any other; at sudo, polkit and the text consoles it is refused as one
# that did not match. The finger and the password each have their own action, run as root once per boot. A
# duress finger is told apart by pam_fprintd (packaging/fprintd: duress=allow in fingerprint-auth,
# duress=deny in system-auth, through the authselect feature with-duress-fingerprint); a duress password by
# amethystora-duress-pam, which pam_exec runs after pam_unix (the feature with-duress-password,
# 08-hardening.sh). Both ask amethystora-duress-service, which runs `run` here with the source.
#
# Everything is in /etc/amethystora/duress.d, root's and readable by nobody else, as the login path demands:
#   fingers             UID FINGER, a line for each account with a duress finger, in one file for all of
#                       them, so that no file name outside tells which accounts have one
#   passwords           UID HASH, the same for a duress password; HASH is a yescrypt hash, never the password
#   action-fingerprint  the owner's root script for the duress finger, an unrestricted root-level script run
#                       with DURESS_USER, DURESS_UID and DURESS_SOURCE (and no time limit)
#   action-password     the owner's root script for the duress password; each source has its own
#   sums                sha256sum's lines for each action and each duress finger's print, written only here
# An action runs only while every sum it needs still holds. The finger's never runs when its print was
# written again, for example because the finger was enrolled afresh as an ordinary one, and neither runs
# when its action was changed by anything but this command. `check` says the same to the security watcher.
# What a run did is kept in /var/lib/amethystora/duress/log, root's alone, never in the journal.
#
#   amethystora-duress status                on or off, for this machine (either feature)
#   amethystora-duress status-fingerprint    just the duress finger feature (on or off)
#   amethystora-duress status-password       just the duress password feature (on or off)
#   amethystora-duress supported             whether this image's fprintd and pam_fprintd can tell the
#                                            duress finger apart (exit 0 or 1)
#   amethystora-duress password-supported    whether this image can check a duress password (exit 0 or 1)
#   amethystora-duress on|off                the finger's authselect feature and the service (root)
#   amethystora-duress on-password|off-password   the password's feature and the service (root)
#   amethystora-duress forget                both off, and the folder and the log removed (root)
#   amethystora-duress set USER FINGER       USER's duress finger, enrolled already (root)
#   amethystora-duress unset USER            forget USER's duress finger; the print stays enrolled (root)
#   amethystora-duress set-password USER     USER's duress password, read on stdin and hashed (root)
#   amethystora-duress unset-password USER   forget USER's duress password (root)
#   amethystora-duress accounts              the accounts with a duress finger, a name a line (root)
#   amethystora-duress password-accounts     the accounts with a duress password, a name a line (root)
#   amethystora-duress has-password USER     whether USER has a duress password (exit 0 or 1, root)
#   amethystora-duress finger USER           USER's duress finger, or nothing (root)
#   amethystora-duress action SOURCE FILE    FILE becomes the fingerprint or password action (root)
#   amethystora-duress check [SOURCE]        what no longer holds for a source (or both), a line each:
#                                            action-missing, action-changed, print-changed USER,
#                                            service-stopped, folder-open; exit 1 when anything (root)
#   amethystora-duress authselect            whether /etc/authselect is the image's own with only the
#                                            duress features that are on added, for the watcher (exit 0/1)
#   amethystora-duress run UID SOURCE        run SOURCE's action for UID, as the service asks (root)

set -euo pipefail

DIR=/etc/amethystora/duress.d
LOG_DIR=/var/lib/amethystora/duress
PRINTS=/var/lib/fprint
FEATURE_FP=with-duress-fingerprint
FEATURE_PW=with-duress-password
UNIT=amethystora-duress.service
CONF=/etc/authselect/authselect.conf
IMAGE_CONF=/usr/etc/authselect/authselect.conf
PAM_HELPER=/usr/libexec/amethystora-duress-pam
# The one pam_exec line the password feature adds after pam_unix. 08-hardening.sh writes exactly this into
# the authselect vendor profiles, so it is kept here identically for the drift check to rebuild it.
DURESS_PAM_LINE='auth [success=done default=ignore] pam_exec.so quiet expose_authtok /usr/libexec/amethystora-duress-pam'
# fprintd's names in the order of libfprint's FpFinger, from 1, which is how it names each print's file
FINGERS=(left-thumb left-index-finger left-middle-finger left-ring-finger left-little-finger
    right-thumb right-index-finger right-middle-finger right-ring-finger right-little-finger)

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}

need_root() {
    [[ ${EUID} -eq 0 ]] || die "this needs root: sudo ${0##*/} $*"
}

# Written beside the file and moved over it, root's and readable by nobody else
write() {
    local file="$1" new
    new="$(mktemp "${DIR}/.new.XXXXXX")"
    cat >"${new}"
    chmod 0600 "${new}"
    mv -f "${new}" "${file}"
}

prepare() {
    install -d -m 0700 -o root -g root "${DIR}"
    touch "${DIR}/fingers" "${DIR}/sums" "${DIR}/passwords"
    chmod 0600 "${DIR}/fingers" "${DIR}/sums" "${DIR}/passwords"
}

# The service listens while any account has a duress finger or password, and stops when none does
any_credential() {
    [[ -s "${DIR}/fingers" || -s "${DIR}/passwords" ]]
}
service_follows() {
    if any_credential; then
        systemctl enable --now --quiet "${UNIT}"
    else
        systemctl disable --now --quiet "${UNIT}"
    fi
}

uid_of() {
    getent passwd "$1" | cut -d: -f3
}

# The one file fprintd keeps USER's FINGER in: /var/lib/fprint/USER/DRIVER/DEVICE/N, N in hex
print_of() {
    local user="$1" finger="$2" i
    local -a prints=()
    for i in "${!FINGERS[@]}"; do
        [[ "${FINGERS[i]}" == "${finger}" ]] || continue
        mapfile -t prints < <(find "${PRINTS}/${user}" -mindepth 3 -maxdepth 3 -type f \
            -name "$(printf '%x' $((i + 1)))" 2>/dev/null)
    done
    [[ ${#prints[@]} -eq 1 ]] || return 1
    echo "${prints[0]}"
}

# The sums file without the line for PATH
sums_without() {
    awk -v path="$1" '{ line = $0; sub(/^[0-9a-f]+  /, "", line) } line != path' "${DIR}/sums"
}

# Whether a credential type is set up on this machine (some account has one)
in_use() {
    case "$1" in
        fingerprint) [[ -s "${DIR}/fingers" ]] ;;
        password) [[ -s "${DIR}/passwords" ]] ;;
        *) return 1 ;;
    esac
}

# What no longer holds for one source's action: its file gone, its sum changed, or its mode loosened
action_problems() {
    local af="${DIR}/action-$1"
    if [[ ! -f "${af}" || -L "${af}" ]]; then
        echo action-missing
    elif ! grep -qxF "$(sha256sum "${af}")" "${DIR}/sums"; then
        echo action-changed
    elif [[ "$(stat -c '%u %a' "${af}")" != "0 700" ]]; then
        echo action-changed
    fi
}

# What no longer holds, for the given source (empty = both): the folder, each in-use action, and each duress
# finger's print (or UID's alone). The finger and the password each have their own action-<source> script.
problems() {
    local source="${1:-}" only="${2:-}" mode="" owner="" uid finger user print line s
    read -r mode owner < <(stat -c '%a %u' "${DIR}" 2>/dev/null) || true
    if [[ "${owner}" != 0 || "${mode}" != 700 ]]; then
        echo folder-open
        return 0
    fi
    for s in fingerprint password; do
        [[ -z "${source}" || "${source}" == "${s}" ]] || continue
        in_use "${s}" || continue
        action_problems "${s}"
    done
    [[ -z "${source}" || "${source}" == fingerprint ]] || return 0
    [[ -f "${DIR}/fingers" ]] || return 0
    while read -r uid finger; do
        [[ -z "${only}" || "${uid}" == "${only}" ]] || continue
        user="$(getent passwd "${uid}" | cut -d: -f1)"
        print=""
        [[ -n "${user}" ]] && print="$(print_of "${user}" "${finger}" || true)"
        line=""
        [[ -n "${print}" ]] && line="$(sha256sum "${print}")"
        if [[ -z "${line}" ]] || ! grep -qxF "${line}" "${DIR}/sums"; then
            echo "print-changed ${user:-${uid}}"
        fi
    done <"${DIR}/fingers"
    return 0
}

case "${1:-}" in
    status)
        if grep -qx "${FEATURE_FP}" "${CONF}" 2>/dev/null || grep -qx "${FEATURE_PW}" "${CONF}" 2>/dev/null; then
            echo on
        else
            echo off
        fi
        ;;
    status-fingerprint)
        if grep -qx "${FEATURE_FP}" "${CONF}" 2>/dev/null; then echo on; else echo off; fi
        ;;
    status-password)
        if grep -qx "${FEATURE_PW}" "${CONF}" 2>/dev/null; then echo on; else echo off; fi
        ;;
    supported)
        # The strings each part of the patch adds: the daemon names the matched finger, and the module
        # knows the service it tells
        grep -qa VerifyFingerMatched /usr/libexec/fprintd &&
            grep -qa org.amethystora.Duress /usr/lib64/security/pam_fprintd.so
        ;;
    password-supported)
        # A duress password needs only pam_exec and this image's helper, both always present
        [[ -x "${PAM_HELPER}" ]] && test -e /usr/lib64/security/pam_exec.so
        ;;
    on)
        need_root "$@"
        "$0" supported || die "this image's fprintd cannot tell one finger from another"
        prepare
        install -d -m 0700 -o root -g root "${LOG_DIR}"
        grep -qx "${FEATURE_FP}" "${CONF}" || authselect enable-feature "${FEATURE_FP}" >/dev/null
        systemctl enable --now --quiet "${UNIT}"
        ;;
    on-password)
        need_root "$@"
        "$0" password-supported || die "this image cannot check a duress password"
        prepare
        install -d -m 0700 -o root -g root "${LOG_DIR}"
        grep -qx "${FEATURE_PW}" "${CONF}" || authselect enable-feature "${FEATURE_PW}" >/dev/null
        systemctl enable --now --quiet "${UNIT}"
        ;;
    off)
        need_root "$@"
        if grep -qx "${FEATURE_FP}" "${CONF}"; then authselect disable-feature "${FEATURE_FP}" >/dev/null; fi
        service_follows
        ;;
    off-password)
        need_root "$@"
        if grep -qx "${FEATURE_PW}" "${CONF}"; then authselect disable-feature "${FEATURE_PW}" >/dev/null; fi
        service_follows
        ;;
    forget)
        need_root "$@"
        if grep -qx "${FEATURE_FP}" "${CONF}"; then authselect disable-feature "${FEATURE_FP}" >/dev/null; fi
        if grep -qx "${FEATURE_PW}" "${CONF}"; then authselect disable-feature "${FEATURE_PW}" >/dev/null; fi
        systemctl disable --now --quiet "${UNIT}"
        rm -rf "${DIR}" "${LOG_DIR}"
        ;;
    set)
        need_root "$@"
        [[ $# -eq 3 ]] || die "usage: ${0##*/} set USER FINGER"
        user="$2" finger="$3"
        [[ " ${FINGERS[*]} " == *" ${finger} "* ]] || die "no finger is called ${finger}"
        uid="$(uid_of "${user}")"
        [[ -n "${uid}" ]] || die "no account is called ${user}"
        print="$(print_of "${user}" "${finger}")" || die "fprintd keeps no single print of ${finger} for ${user}"
        prepare
        old="$(awk -v uid="${uid}" '$1 == uid { print $2 }' "${DIR}/fingers")"
        { awk -v uid="${uid}" '$1 != uid' "${DIR}/fingers"; echo "${uid} ${finger}"; } | write "${DIR}/fingers"
        if [[ -n "${old}" ]] && old="$(print_of "${user}" "${old}")"; then
            sums_without "${old}" | write "${DIR}/sums"
        fi
        { sums_without "${print}"; sha256sum "${print}"; } | write "${DIR}/sums"
        ;;
    unset)
        need_root "$@"
        [[ $# -eq 2 ]] || die "usage: ${0##*/} unset USER"
        uid="$(uid_of "$2")"
        [[ -n "${uid}" && -f "${DIR}/fingers" ]] || exit 0
        finger="$(awk -v uid="${uid}" '$1 == uid { print $2 }' "${DIR}/fingers")"
        awk -v uid="${uid}" '$1 != uid' "${DIR}/fingers" | write "${DIR}/fingers"
        # A print already gone leaves its line, which nothing reads once the finger is forgotten
        if [[ -n "${finger}" ]] && print="$(print_of "$2" "${finger}")"; then
            sums_without "${print}" | write "${DIR}/sums"
        fi
        ;;
    accounts)
        need_root "$@"
        [[ -f "${DIR}/fingers" ]] || exit 0
        while read -r uid _; do getent passwd "${uid}" | cut -d: -f1; done <"${DIR}/fingers"
        ;;
    finger)
        need_root "$@"
        [[ $# -eq 2 && -f "${DIR}/fingers" ]] || exit 0
        uid="$(uid_of "$2")"
        [[ -n "${uid}" ]] || exit 0
        awk -v uid="${uid}" '$1 == uid { print $2 }' "${DIR}/fingers"
        ;;
    set-password)
        need_root "$@"
        [[ $# -eq 2 ]] || die "usage: ${0##*/} set-password USER"
        uid="$(uid_of "$2")"
        [[ -n "${uid}" ]] || die "no account is called $2"
        # The password is read from stdin and only its hash is ever written
        hash="$("${PAM_HELPER}" hash)" || die "could not hash the password"
        [[ -n "${hash}" ]] || die "could not hash the password"
        prepare
        { awk -v uid="${uid}" '$1 != uid' "${DIR}/passwords"; printf '%s %s\n' "${uid}" "${hash}"; } |
            write "${DIR}/passwords"
        ;;
    unset-password)
        need_root "$@"
        [[ $# -eq 2 ]] || die "usage: ${0##*/} unset-password USER"
        uid="$(uid_of "$2")"
        [[ -n "${uid}" && -f "${DIR}/passwords" ]] || exit 0
        awk -v uid="${uid}" '$1 != uid' "${DIR}/passwords" | write "${DIR}/passwords"
        ;;
    password-accounts)
        need_root "$@"
        [[ -f "${DIR}/passwords" ]] || exit 0
        while read -r uid _; do getent passwd "${uid}" | cut -d: -f1; done <"${DIR}/passwords"
        ;;
    has-password)
        need_root "$@"
        [[ $# -eq 2 && -f "${DIR}/passwords" ]] || exit 1
        uid="$(uid_of "$2")"
        [[ -n "${uid}" ]] && grep -q "^${uid} " "${DIR}/passwords"
        ;;
    action)
        need_root "$@"
        [[ $# -eq 3 && -f "$3" ]] || die "usage: ${0##*/} action fingerprint|password FILE"
        source="$2"
        [[ "${source}" == fingerprint || "${source}" == password ]] || die "no source is called ${source}"
        prepare
        new="$(mktemp "${DIR}/.new.XXXXXX")"
        cat -- "$3" >"${new}"
        chmod 0700 "${new}"
        mv -f "${new}" "${DIR}/action-${source}"
        { sums_without "${DIR}/action-${source}"; sha256sum "${DIR}/action-${source}"; } | write "${DIR}/sums"
        ;;
    check)
        need_root "$@"
        source="${2:-}"
        [[ -z "${source}" || "${source}" == fingerprint || "${source}" == password ]] || die "no source is called ${source}"
        [[ -d "${DIR}" ]] || exit 0
        found="$(problems "${source}")"
        # The service is shared, so a stopped service is a problem for a source only when its feature is on
        case "${source}" in
            fingerprint) on="$("$0" status-fingerprint)" ;;
            password) on="$("$0" status-password)" ;;
            *) on="$("$0" status)" ;;
        esac
        if [[ "${on}" == on ]] && ! systemctl is-active --quiet "${UNIT}"; then
            found+=$'\n'service-stopped
        fi
        found="$(sed '/^$/d' <<<"${found}")"
        [[ -z "${found}" ]] && exit 0
        echo "${found}"
        exit 1
        ;;
    authselect)
        # The image's profile and features, then whichever duress features are on, and every file the
        # image's own but for the pam_fprintd option (the finger) and one pam_exec line after pam_unix (the
        # password), byte for byte. `authselect check` would not do: it calls a file with a line added by
        # hand valid.
        [[ -f "${IMAGE_CONF}" ]] || exit 1
        fp=off
        pw=off
        grep -qx "${FEATURE_FP}" "${CONF}" 2>/dev/null && fp=on || true
        grep -qx "${FEATURE_PW}" "${CONF}" 2>/dev/null && pw=on || true
        # The live features, less whichever duress features are on, must be exactly the image's: so no other
        # feature was added or removed and no base feature changed.
        cmp -s <(grep -vE '^[[:space:]]*(#|$)' "${CONF}" | grep -vxE "${FEATURE_FP}|${FEATURE_PW}") \
            <(grep -vE '^[[:space:]]*(#|$)' "${IMAGE_CONF}") || exit 1
        while read -r name; do
            [[ "${name}" == authselect.conf ]] && continue
            expected="/usr/etc/authselect/${name}"
            live="/etc/authselect/${name}"
            [[ -f "${expected}" && -f "${live}" ]] || exit 1
            option=""
            case "${name}" in
                system-auth) [[ "${fp}" == on ]] && option=deny ;;
                fingerprint-auth) [[ "${fp}" == on ]] && option=allow ;;
            esac
            # Rebuild the file from the image's own: the finger's pam_fprintd option, then the password's
            # pam_exec line after pam_unix, for whichever feature is on.
            cmp -s "${live}" <(
                if [[ -n "${option}" ]]; then
                    sed -E "s/([[:space:]])pam_fprintd\.so([[:space:]]|$)/\1pam_fprintd.so duress=${option}\2/" "${expected}"
                else
                    cat "${expected}"
                fi | if [[ "${pw}" == on && ( "${name}" == system-auth || "${name}" == password-auth ) ]]; then
                    awk -v line="${DURESS_PAM_LINE}" '{ print } !done && /pam_unix\.so/ { print line; done = 1 }'
                else
                    cat
                fi
            ) || exit 1
        done < <(find /etc/authselect /usr/etc/authselect -maxdepth 1 -mindepth 1 \( -type f -o -type l \) -printf '%f\n' |
            sort -u)
        ;;
    run)
        need_root "$@"
        [[ "${2:-}" =~ ^[0-9]+$ ]] || exit 64
        uid="$2"
        # The service passes the source; an older caller that passes only a uid means the finger
        source="${3:-fingerprint}"
        [[ "${source}" == fingerprint || "${source}" == password ]] || exit 64
        install -d -m 0700 -o root -g root "${LOG_DIR}"
        exec >>"${LOG_DIR}/log" 2>&1
        log() { printf '%s %s\n' "$(date -Is)" "$*"; }
        user="$(getent passwd "${uid}" | cut -d: -f1)"
        found="$(problems "${source}" "${uid}" 2>&1)"
        case "${source}" in
            fingerprint) grep -q "^${uid} " "${DIR}/fingers" 2>/dev/null || found+=$'\n'no-credential ;;
            password) grep -q "^${uid} " "${DIR}/passwords" 2>/dev/null || found+=$'\n'no-credential ;;
        esac
        found="$(sed '/^$/d' <<<"${found}" | paste -sd ' ')"
        if [[ -n "${found}" ]]; then
            log "not run for ${user:-${uid}} (${source}): ${found}"
            exit 0
        fi
        # Once per boot per source, whichever account and however many touches
        mkdir -p -m 0700 /run/amethystora-duress
        if ! mkdir -m 0700 "/run/amethystora-duress/${source}" 2>/dev/null; then
            log "not run for ${user} (${source}): it ran already since this boot"
            exit 0
        fi
        log "running the ${source} action for ${user}"
        rc=0
        # The owner's action is an unrestricted root script: a clean environment, but no time limit
        env -i PATH=/usr/bin:/usr/sbin HOME=/root LANG=C.UTF-8 \
            DURESS_USER="${user}" DURESS_UID="${uid}" DURESS_SOURCE="${source}" \
            "${DIR}/action-${source}" </dev/null || rc=$?
        log "the action ended with ${rc}"
        ;;
    *)
        sed -n '2,/^$/p' "$0" | sed 's/^# \?//' >&2
        exit 64
        ;;
esac
