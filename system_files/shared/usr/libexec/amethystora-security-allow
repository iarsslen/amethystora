#!/usr/bin/bash
# The allowlists of the security features: what the machine's owner said was fine, so that it stops being
# said without the feature being turned off. One root helper writes them, after checking each entry.
#
#   amethystora-security-allow --features             the features that have one, a line each
#   amethystora-security-allow list FEATURE
#   amethystora-security-allow add FEATURE ENTRY      (root)
#   amethystora-security-allow remove FEATURE ENTRY   (root)
#
# The image's own entries are in /usr/share/amethystora/allow.d/FEATURE, so they change with the image and
# never show as a change to /etc; the machine's are in /etc/amethystora/allow.d/FEATURE, which the image
# does not ship. Changing one is recorded by the audit log under the hardening key, as every change to
# /etc/amethystora is.
#
# The features with an allowlist, and what an entry is:
#
#   report   a check of the report (amethystora-security-status) and the state it was accepted in, as
#            "secure-boot check": shown as accepted, kept out of the summary and never said, until its
#            state changes. For what cannot be fixed on this machine, such as Secure Boot it does not have.
#   identity, privilege, persistence, hardening, modules, input-capture, user-programs, dev-hooks, processes
#            a path, or the program that wrote there, as the audit log names it, or a glob of either:
#            '~/.local/share/gnome-shell/extensions/*' quietens new extensions in every home. What it
#            matches is recorded, not said.
#   selinux-denials
#            a denial as SELinux names it: the source and target types, the class and the permissions, or
#            globs of them: "xdm_t user_home_t file read,open"
#   app-permissions
#            a Flatpak app's id and a way out of its sandbox, as amethystora-app-permissions names it, or a
#            glob of either: "com.valvesoftware.Steam x11", "org.example.App *"
#
# Every entry is one line of at most 1024 characters with no control character, in the shape its feature
# reads: the watcher compares, and never runs, an entry.

set -uo pipefail

# AMETHYSTORA_ALLOW_ROOT is for the tests in build_files/shared, which use a stand-in /etc
ROOT="${AMETHYSTORA_ALLOW_ROOT:-}"
SHIPPED=/usr/share/amethystora/allow.d
MACHINE="${ROOT}/etc/amethystora/allow.d"
# What an entry of each looks like
declare -A SHAPE=(
    # A signing key's check is named after its certificate: key-amethystora-modules.der
    [report]='^[a-z0-9][A-Za-z0-9._-]{0,95} (check|off)$'
    [app-permissions]='^[A-Za-z0-9_.*-]{1,255} [a-z*-]{1,32}$'
    # A denial as SELinux names it: source type, target type, class and permissions, or globs of them
    [selinux-denials]='^[a-z0-9_*]{1,64} [a-z0-9_*]{1,64} [a-z0-9_*]{1,64} [a-z0-9_*,]{1,256}$'
)
# A path, a program or a glob of either, from the root or from every home
PATHS='^(/|~/)[^[:cntrl:]]{0,1022}$'
for feature in identity privilege persistence hardening modules input-capture user-programs dev-hooks processes; do
    SHAPE["${feature}"]="${PATHS}"
done

usage() {
    echo "usage: ${0##*/} --features | list FEATURE | add FEATURE ENTRY | remove FEATURE ENTRY" >&2
    exit 64
}

if [[ "${1:-}" == --features ]]; then
    printf '%s\n' "${!SHAPE[@]}" | sort
    exit 0
fi

[[ $# -ge 2 && -n "${SHAPE[$2]+set}" ]] || usage
FEATURE="$2"
FILE="${MACHINE}/${FEATURE}"

case "$1" in
    list)
        cat "${SHIPPED}/${FEATURE}" "${FILE}" 2>/dev/null | grep -v '^#' | grep . || true
        ;;
    add | remove)
        [[ $# -eq 3 ]] || usage
        ENTRY="$3"
        [[ "${ENTRY}" != *$'\n'* && "${ENTRY}" =~ ${SHAPE[${FEATURE}]} ]] ||
            { echo "Not an entry ${FEATURE} takes: ${ENTRY}" | /usr/libexec/amethystora-security-text >&2; exit 64; }
        [[ "${EUID}" -eq 0 ]] || { echo "Changing an allowlist needs root." >&2; exit 77; }
        mkdir -p -m 0755 "${MACHINE}"
        { grep -vxF -- "${ENTRY}" "${FILE}" 2>/dev/null || true; [[ "$1" == add ]] && printf '%s\n' "${ENTRY}"; } >"${FILE}.new"
        mv "${FILE}.new" "${FILE}"
        chmod 0644 "${FILE}"
        restorecon "${FILE}" 2>/dev/null || true
        # The person at the machine did this: the watcher records it without announcing it
        /usr/libexec/amethystora-security-config note "allow-${FEATURE}" "$1" 2>/dev/null || true
        ;;
    *)
        usage
        ;;
esac
