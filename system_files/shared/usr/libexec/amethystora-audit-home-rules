#!/usr/bin/bash
# Audit watches for the places inside a home directory that survive a logout: the desktop's autostart
# entries, the user's own systemd units and environment, the per-user Flatpak permission overrides
# (where a granted-back X11 socket would show up) and the shell startup files, and, under a key of their
# own, the folders a session finds commands and launchers in before the system's. Written as a rules file
# rather than shipped with the image because an audit watch needs a path that exists when the rules are
# loaded, and home directories only exist once accounts do. Runs from amethystora-audit-rules.service,
# at every boot, so accounts made since the last one are picked up.
#
# The system-wide half is written here too, into /etc/audit/rules.d/60-amethystora.rules, from the rules the
# image ships one file per key in /usr/share/amethystora/audit. Every key is a switch in
# /etc/amethystora/security.conf (IDENTITY, PERSISTENCE, USER_PROGRAMS...): a key that is off gets no rule
# at all, so it costs nothing once these have been loaded at the next boot.

set -euo pipefail

# AMETHYSTORA_AUDIT_ROOT is for build_files/shared/test-audit-home-rules.sh, which runs this against a
# stand-in /etc/passwd and /var/home
ROOT="${AMETHYSTORA_AUDIT_ROOT:-}"
RULES="${ROOT}/etc/audit/rules.d/61-amethystora-home.rules"
SYSTEM_RULES="${ROOT}/etc/audit/rules.d/60-amethystora.rules"
SHIPPED=/usr/share/amethystora/audit

# Whether an audit key is wanted: anything but off, under its name in security.conf (input-capture is
# INPUT_CAPTURE). A key the helper does not know is wanted, as one with no switch always was. Every value
# is read once: asking the helper for each key in turn took most of a second, early in every boot.
declare -A SETTING=()
while IFS='=' read -r name value; do
    SETTING["${name}"]="${value}"
done < <(/usr/libexec/amethystora-security-config --all 2>/dev/null)
wanted() {
    local name="${1^^}"
    [[ "${SETTING[${name//-/_}]:-}" != off ]]
}

# The file-watch sensor (amethystora-sensor, plans/security/PLAN-audit-cost.md): where it covers a key, that
# key gets no audit syscall rule (so no per-call cost), and what to watch is written to a plan and a watch
# list under /run instead, from the very same shipped rules and per-home logic as the audit rules. The two
# outputs never disagree because one set of decisions makes both. The audit keys, in the watcher's order.
AUDIT_KEYS=(identity privilege persistence hardening modules input-capture user-programs exec-watch agent-clis \
    credentials decoy)
SENSOR_BIN="${AMETHYSTORA_SENSOR_BIN:-/usr/libexec/amethystora-sensor}"
RUNDIR="${AMETHYSTORA_SENSOR_RUN:-${ROOT}/run/amethystora/sensor}"
PLAN="${RUNDIR}/plan"
WATCHLIST="${RUNDIR}/watch.list"
PROBE_CACHE="${ROOT}/var/lib/amethystora/security/sensor-probe"
USE_SENSOR=false

# Does the sensor take this kernel and this build? A test forces it either way; a stand-in run (a build,
# AMETHYSTORA_AUDIT_ROOT set) never probes, since there is no BPF to load there; otherwise load-and-detach
# once (amethystora-sensor --probe), cached by kernel version and the binary's hash so only a new deployment
# pays for it. audit-locked, a stricter setting, keeps today's audit rules and their cost.
decide_sensor() {
    case "${AMETHYSTORA_SENSOR_FORCE:-}" in
        sensor) return 0 ;;
        audit) return 1 ;;
    esac
    [[ -z "${ROOT}" ]] || return 1
    [[ "${SETTING[AUDIT_LOG]:-on}" != off ]] || return 1
    if [[ -x /usr/libexec/amethystora-hardening ]] && /usr/libexec/amethystora-hardening is-on audit-locked 2>/dev/null; then
        return 1
    fi
    [[ -x "${SENSOR_BIN}" ]] || return 1
    local key cached sum
    sum="$(sha256sum "${SENSOR_BIN}" 2>/dev/null | cut -d' ' -f1)"
    key="$(uname -r) ${sum}"
    if [[ -r "${PROBE_CACHE}" ]]; then
        cached="$(head -n1 "${PROBE_CACHE}" 2>/dev/null)"
        [[ "${cached}" == "ok ${key}" ]] && return 0
        [[ "${cached}" == "no ${key}" ]] && return 1
    fi
    mkdir -p "$(dirname "${PROBE_CACHE}")" 2>/dev/null
    if "${SENSOR_BIN}" --probe 2>/dev/null; then
        echo "ok ${key}" >"${PROBE_CACHE}" 2>/dev/null
        return 0
    fi
    echo "no ${key}" >"${PROBE_CACHE}" 2>/dev/null
    return 1
}

# A watch for the sensor, one "KIND KEY PATH" line (KIND: tree, file, exec-tree, read-tree, read-file)
watchlist() { printf '%s %s %s\n' "$1" "$2" "$3" >>"${WATCHLIST}.new"; }

# One shipped audit rule line turned into a watch-list line for the sensor. A -w folder or file, and the
# folder a program runs from; a module or input rule needs none, since the plan's key is enough.
to_watchlist() {
    local key="$1" line="$2" p
    if [[ "${line}" =~ ^-w\ ([^ ]+)\  ]]; then
        p="${BASH_REMATCH[1]}"
        [[ -e "${p%/}" ]] || return 0
        if [[ "${p}" == */ ]]; then watchlist tree "${key}" "${p%/}"; else watchlist file "${key}" "${p}"; fi
    elif [[ "${line}" =~ -S\ execve && "${line}" =~ \ -F\ dir=([^ ]+) ]]; then
        p="${BASH_REMATCH[1]}"
        [[ -e "${p%/}" ]] || return 0
        watchlist exec-tree "${key}" "${p%/}"
    fi
}

# A per-home watch, emitted as a watch-list line when the sensor covers it, else as the audit rule it would
# have been (byte for byte what this wrote before the sensor, so the fallback is unchanged)
emit() {
    if [[ "${USE_SENSOR}" == true ]]; then
        watchlist "$1" "$2" "$3"
        return
    fi
    case "$1" in
        tree) echo "-w $3/ -p wa -k $2" ;;
        file) echo "-w $3 -p wa -k $2" ;;
        exec-tree) exec_rule "$3" "$2" ;;
        read-tree) read_rule dir "$3" "$2" ;;
        read-file) read_rule path "$3" "$2" ;;
    esac
}

# Directories worth watching whether or not anything has created them yet: each is a standard XDG path
# that the desktop would create on its own, and a watch on the directory catches the file appearing in
# it, which is what persistence looks like. Quadlets are containers the user's systemd starts at login.
WATCH_DIRS=(
    .config/autostart
    .config/systemd/user
    .config/environment.d
    .config/containers/systemd
    .local/share/systemd/user
    .local/share/flatpak/overrides
    # A D-Bus service an app activates, and a GNOME Shell extension, which runs inside the compositor and
    # sees every key pressed
    .local/share/dbus-1/services
    .local/share/gnome-shell/extensions
    # A top-bar widget, whose command runs as soon as its folder appears, without a login in between: a
    # Flatpak with the home folder can put one there (the widgets keep what they write elsewhere)
    .config/amethystora/widgets
)
# ...and those watched only where they are, since an account without them has no use for them: SSH's keys
# that let someone log in, its rc and its config (ProxyCommand runs a command), and fish's startup folders
WATCH_EXISTING_DIRS=(
    .ssh
    .config/fish/conf.d
    .config/fish/functions
)
# Where a session finds commands before the system's own, and the app grid's launchers, under a key of
# their own: writes here are everyday (pip, a container's exported apps), so the watcher only records
# them, and what it says out loud is a command named like a system one, or a launcher no container
# export made, which it looks for at each run (read_user_paths)
PROGRAM_DIRS=(
    .local/bin
    .local/share/applications
)
# ...and which app opens what, as everyday: GLib rewrites it whenever an app registers for a type, which
# GSConnect does at every login, and for each "Open With" a person makes the default
PROGRAM_FILES=(
    .config/mimeapps.list
)
# Startup files, watched only where they exist: creating one is caught by the watch on the home
# directory's own shell configuration only if it is already there, so a missing file is a known gap.
WATCH_FILES=(
    .bashrc
    .bash_profile
    .bash_login
    .bash_logout
    .profile
    .zshrc
    .zshenv
    .zprofile
    .zlogin
    .config/fish/config.fish
    # git's settings, whose hooksPath, fsmonitor and sshCommand run commands
    .gitconfig
    .config/git/config
)

# The places in a home these rules watch, one a line, for the security watcher: it says when a link takes
# one of them out of the home, and so out of these rules' reach
if [[ "${1:-}" == --paths ]]; then
    printf '%s\n' "${WATCH_DIRS[@]}" "${PROGRAM_DIRS[@]}" "${WATCH_EXISTING_DIRS[@]}" "${WATCH_FILES[@]}" "${PROGRAM_FILES[@]}" bin
    exit 0
fi

# Root never follows a link the account put in its home out of it. -L and chown -h only ever look at the
# last name of a path: with ~/.config a link to /etc, ~/.config/systemd is /etc/systemd, no link itself,
# and an earlier version of this script handed it to the account, which made it root at the next boot.
# Nothing of the account's runs yet this early in boot, so nothing can swap a name between look and act.

# The real path of HOME/NAME, printed only when it is inside HOME and one word of plain characters. An
# audit watch follows no link, so the rule names the real path; one that leads out of the home gets no
# watch at all, since root would watch whatever the account pointed it at, and a watch on / is refused by
# the kernel, which stops auditctl loading every rule after it, -e 2 included. auditctl also splits a rule
# on spaces, and stops the same way at a line it cannot read.
inside() {
    local real
    real="$(realpath -e -- "$1/$2" 2>/dev/null)" || return 1
    [[ "${real}" == "$1"/* && "${real}" =~ ^[[:alnum:]._/@+-]+$ ]] && echo "${real}"
}

# Gives the account back each folder on the way from its home to NAME that root owns: what an older version
# of this script left behind when it made them as root with install -o. One name at a time, stopping at the
# first that is not a plain folder reached without a link.
give_back() {
    local home="$1" uid="$2" part="$1" component
    local -a parts
    IFS=/ read -ra parts <<<"$3"
    for component in "${parts[@]}"; do
        part+="/${component}"
        [[ ! -L "${part}" && -d "${part}" && "$(realpath -e -- "${part}" 2>/dev/null)" == "${part}" ]] || return 0
        if [[ "$(stat -c '%u' -- "${part}")" == 0 ]] && ! chown -h -- "${uid}:$(stat -c '%g' -- "${home}")" "${part}"; then
            echo "Could not give ${part} back to UID ${uid}" >&2
        fi
    done
}

# Decide the sensor once, then write the plan (one wanted key a line, "KEY sensor" or "KEY audit") and start
# a fresh watch list. mkdir of /run early in boot is safe; a stand-in run writes these under its own root.
decide_sensor && USE_SENSOR=true
DECISION=audit
[[ "${USE_SENSOR}" == true ]] && DECISION=sensor
mkdir -p "${RUNDIR}"
: >"${WATCHLIST}.new"
{
    for key in "${AUDIT_KEYS[@]}"; do
        wanted "${key}" && echo "${key} ${DECISION}"
    done
} >"${PLAN}.new"

# The image's rules, for each key that is not off. A watch on a path that is not there would stop auditctl
# loading every rule after it, -e 2 included, so such a line is left out rather than written. Where the
# sensor covers a key, nothing is written here but the plan's entry and the watch list's lines; and once
# every wanted key is the sensor's, one -a never,task is all that loads, which is Fedora's own default.
{
    echo "## Generated by ${0} from ${SHIPPED}, for the keys not"
    echo "## off in /etc/amethystora/security.conf. Edits are overwritten at the next boot."
    if [[ "${USE_SENSOR}" == true ]]; then
        echo "## The file-watch sensor (amethystora-sensor) covers every watched key; the kernel audits no"
        echo "## system call. What it watches is in ${WATCHLIST}."
        echo "-a never,task"
    fi
    for shipped in "${SHIPPED}"/*.rules; do
        [[ -f "${shipped}" ]] || continue
        key="$(basename "${shipped}" .rules)"
        echo
        if ! wanted "${key}"; then
            echo "## ${key} is off"
            continue
        fi
        while IFS= read -r line; do
            [[ "${line}" == -* ]] || continue
            if [[ "${USE_SENSOR}" == true ]]; then
                to_watchlist "${key}" "${line}"
            elif [[ "${line}" =~ ^-w\ ([^ ]+)\  && ! -e "${BASH_REMATCH[1]}" ]]; then
                echo "## Left out, not on this machine: ${line}"
            elif [[ "${line}" =~ \ -F\ (dir|path)=([^ ]+) && ! -e "${BASH_REMATCH[2]}" ]]; then
                echo "## Left out, not on this machine: ${line}"
            else
                echo "${line}"
            fi
        done <"${shipped}"
    done
} >"${SYSTEM_RULES}.new"
mv "${SYSTEM_RULES}.new" "${SYSTEM_RULES}"
chmod 0600 "${SYSTEM_RULES}"
restorecon "${SYSTEM_RULES}" 2>/dev/null || true

PERSISTENCE=false
wanted persistence && PERSISTENCE=true
USER_PROGRAMS=false
wanted user-programs && USER_PROGRAMS=true
EXEC_WATCH=false
wanted exec-watch && EXEC_WATCH=true
AGENT_CLIS=false
wanted agent-clis && AGENT_CLIS=true
# Where amethystora-agent's agents are installed, by their makers' installers, in each home. A command here is
# usually a link to the folder the agent really runs from, which is the one watched: Claude Code's and Cursor's
# point into versions/ folders that their updates add to.
AGENT_COMMANDS=(.local/bin/claude .local/bin/codex .local/bin/agy .local/bin/copilot .local/bin/cursor-agent
    .local/bin/agent .opencode/bin/opencode)
# Gemini CLI came from Homebrew, whose prefix every account shares, and Antigravity CLI can
BREW_AGENTS=(/home/linuxbrew/.linuxbrew/bin/gemini /home/linuxbrew/.linuxbrew/bin/agy)
CREDENTIALS=false
wanted credentials && CREDENTIALS=true
DECOY=false
wanted decoy && DECOY=true
# Where secrets are kept in a home, each a glob: SSH's keys, the package registries', git's, GitHub's, the
# clouds', the browsers' passwords and cookies (their Flatpaks' too), and the AI agents' tokens.
CREDENTIAL_FILES=(.ssh/id_* .npmrc .pypirc .git-credentials .config/gh/hosts.yml .aws/credentials .docker/config.json
    .kube/config
    .mozilla/firefox/*/logins.json .mozilla/firefox/*/key4.db .mozilla/firefox/*/cookies.sqlite
    .var/app/org.mozilla.firefox/.mozilla/firefox/*/logins.json .var/app/org.mozilla.firefox/.mozilla/firefox/*/key4.db
    .var/app/org.mozilla.firefox/.mozilla/firefox/*/cookies.sqlite
    .config/{google-chrome,chromium,BraveSoftware/Brave-Browser,microsoft-edge}/*/{Cookies,Network/Cookies}
    .var/app/{com.google.Chrome/config/google-chrome,org.chromium.Chromium/config/chromium}/*/{Cookies,Network/Cookies}
    .var/app/{com.brave.Browser/config/BraveSoftware/Brave-Browser,com.microsoft.Edge/config/microsoft-edge}/*/{Cookies,Network/Cookies}
    .claude/.credentials.json .codex/auth.json .codex/.credentials.json .gemini/oauth_creds.json
    .gemini/gemini-credentials.json .gemini/mcp-oauth-tokens.json .local/share/opencode/auth.json
    .local/share/opencode/mcp-auth.json .config/cursor/auth.json .gemini/antigravity-cli/antigravity-oauth-token)
CREDENTIAL_DIRS=(.local/share/keyrings)
# Chromium's browsers keep their passwords in "Login Data", whose space no rule's path can hold: each is watched
# by its inode instead, on the device the kernel knows its filesystem by (findmnt's, which btrfs's stat is not).
# That holds while the browser writes the file in place, as SQLite does, and the next boot writes it again. The
# space is a ? here.
CREDENTIAL_INODES=(.config/{google-chrome,chromium,BraveSoftware/Brave-Browser,microsoft-edge}/*/Login?Data{,?For?Account}
    .var/app/{com.google.Chrome/config/google-chrome,org.chromium.Chromium/config/chromium}/*/Login?Data{,?For?Account}
    .var/app/{com.brave.Browser/config/BraveSoftware/Brave-Browser,com.microsoft.Edge/config/microsoft-edge}/*/Login?Data{,?For?Account})
# The decoy: a key nothing legitimate reads, since ssh offers no key under this name on its own. Its first line
# of base64 begins with this, which is how this script knows its own decoy from a key of the account's.
DECOY_FILE=.ssh/id_backup
DECOY_MARK=YW1ldGh5c3RvcmEtZGVjb3k6

# A rule on reading a file, or the files in a folder, by the account's own logins
read_rule() { echo "-a always,exit -F arch=b64 -F $1=$2 -F perm=r -F auid>=1000 -F auid!=unset -k $3"; }

# A rule on opening the file at PATH, by its inode and its filesystem's device, for a name a rule cannot hold
inode_rule() {
    local inode dev
    inode="$(stat -c '%i' -- "$1")" && dev="$(findmnt -n -o MAJ:MIN --target "$1")" || return 0
    dev="${dev// /}"
    [[ "${inode}" =~ ^[0-9]+$ && "${dev}" =~ ^[0-9]+:[0-9]+$ ]] || return 0
    echo "-a always,exit -F arch=b64 -S open,openat,openat2 -F inode=${inode} -F devmajor=${dev%:*} -F devminor=${dev#*:} -F auid>=1000 -F auid!=unset -k $2"
}

# Whether the decoy at PATH is this script's
own_decoy() { [[ -f "$1" && ! -L "$1" ]] && head -c 4096 -- "$1" 2>/dev/null | sed -n 2p | grep -q "^${DECOY_MARK}"; }

# Makes the decoy as the account, never over a file that is there: a private key in OpenSSH's armour, around
# nothing but the mark and random bytes
make_decoy() {
    local home="$1" uid="$2" gid
    gid="$(stat -c '%g' "${home}")"
    setpriv --reuid="${uid}" --regid="${gid}" --clear-groups mkdir -p -m 0700 "${home}/.ssh" || return 1
    [[ -e "${home}/${DECOY_FILE}" || -L "${home}/${DECOY_FILE}" ]] && return 0
    inside "${home}" .ssh >/dev/null || return 1
    {
        echo "-----BEGIN OPENSSH PRIVATE KEY-----"
        { printf 'amethystora-decoy:'; head -c 381 /dev/urandom; } | base64 -w 68
        echo "-----END OPENSSH PRIVATE KEY-----"
    } | setpriv --reuid="${uid}" --regid="${gid}" --clear-groups /usr/bin/bash -c 'umask 077; set -C; cat >"$1"' _ \
        "${home}/${DECOY_FILE}"
}

# A rule on a folder each time a program runs from it, for the account's own logins. The folder has to be
# there, or auditctl stops at the rule: the caller has checked it.
exec_rule() { echo "-a always,exit -F arch=b64 -S execve,execveat -F dir=$1 -F auid>=1000 -F auid!=unset -k $2"; }

# The download folder's name follows the session's language: the one in ~/.config/user-dirs.dirs, plain, and
# inside the home, else Downloads
download_dir() {
    local home="$1" file="$1/.config/user-dirs.dirs" name=""
    if [[ -f "${file}" && ! -L "${file}" ]]; then
        name="$(head -c 8192 -- "${file}" | sed -n 's/^XDG_DOWNLOAD_DIR="\$HOME\/\([^"]*\)"$/\1/p' | head -n1)"
    fi
    [[ -n "${name}" && "${name}" != *..* ]] || name=Downloads
    echo "${name%/}"
}

{
    echo "## Generated by ${0}. Edits are overwritten at the next boot."
    echo "## Read what these caught with: sudo ausearch -k persistence -i (and -k user-programs)"
    echo

    # Real accounts only: system users below UID 1000, and nobody at 65534, have no desktop session. A
    # domain's (SSSD or winbind) are numbered from far above 65534, and are not in /etc/passwd: their
    # home folders in /var/home stand in for them, since nothing can look them up this early in boot.
    while IFS=: read -r user _ uid _ _ home _; do
        [[ "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        # /home is a symlink to /var/home on this system, and an audit watch follows no symlinks:
        # the rule has to name the path the kernel sees.
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue

        echo "## ${user}"
        for dir in "${WATCH_DIRS[@]}" "${PROGRAM_DIRS[@]}"; do
            key=persistence
            [[ " ${PROGRAM_DIRS[*]} " == *" ${dir} "* ]] && key=user-programs
            # A key that is off gets no watch, and nothing made in the home for one
            [[ "${key}" == persistence && "${PERSISTENCE}" == true ]] ||
                [[ "${key}" == user-programs && "${USER_PROGRAMS}" == true ]] || continue
            if [[ ! -d "${home}/${dir}" ]]; then
                # As the user, not as root with install -o: that gave only the last directory to the
                # user and left the ones made on the way, ~/.local/share/flatpak among them, to root,
                # and it followed any link the user had put in the way wherever it led
                setpriv --reuid="${uid}" --regid="$(stat -c '%g' "${home}")" --clear-groups \
                    mkdir -p -m 0700 "${home}/${dir}" || continue
            fi
            give_back "${home}" "${uid}" "${dir}"
            if real="$(inside "${home}" "${dir}")"; then
                emit tree "${key}" "${real}"
            fi
        done
        for file in "${WATCH_FILES[@]}"; do
            [[ "${PERSISTENCE}" == true ]] || break
            [[ -f "${home}/${file}" ]] && real="$(inside "${home}" "${file}")" && emit file persistence "${real}"
        done
        for file in "${PROGRAM_FILES[@]}"; do
            [[ "${USER_PROGRAMS}" == true ]] || break
            [[ -f "${home}/${file}" ]] && real="$(inside "${home}" "${file}")" && emit file user-programs "${real}"
        done
        for dir in "${WATCH_EXISTING_DIRS[@]}"; do
            [[ "${PERSISTENCE}" == true ]] || break
            [[ -d "${home}/${dir}" ]] && real="$(inside "${home}" "${dir}")" && emit tree persistence "${real}"
        done
        # ~/bin is in the PATH a shell sets up, but only where it is there: nobody is given one to watch
        [[ "${USER_PROGRAMS}" == true && -d "${home}/bin" && ! -L "${home}/bin" ]] && real="$(inside "${home}" bin)" &&
            emit tree user-programs "${real}"
        # A program run from the cache or the download folder (EXEC_WATCH), where they are
        if [[ "${EXEC_WATCH}" == true ]]; then
            for dir in .cache "$(download_dir "${home}")"; do
                if [[ -d "${home}/${dir}" ]] && real="$(inside "${home}" "${dir}")"; then
                    emit exec-tree exec-watch "${real}"
                fi
            done
        fi
        # Each AI agent the account has, run (AGENT_CLIS): the folder its command leads to, once each. An agent
        # installed after this boot is covered from the next; odd processes see it until then.
        if [[ "${AGENT_CLIS}" == true ]]; then
            for command in "${AGENT_COMMANDS[@]}"; do
                if [[ -e "${home}/${command}" ]] && real="$(inside "${home}" "${command}")"; then
                    echo "${real%/*}"
                fi
            done | sort -u | while read -r dir; do
                if [[ -d "${dir}" ]]; then
                    emit exec-tree agent-clis "${dir}"
                fi
            done
        fi
        # Reading where secrets are kept (CREDENTIALS): each file that is there, the keyring's folder, and the
        # file the backup's password is in, which its settings name. Root reads those settings as it reads
        # any file of an account's: plain, never through a link, and no more than a little of it.
        if [[ "${CREDENTIALS}" == true ]]; then
            {
                for pattern in "${CREDENTIAL_FILES[@]}"; do
                    for file in "${home}"/${pattern}; do
                        [[ -f "${file}" && "${file}" != *.pub ]] || continue
                        if real="$(inside "${home}" "${file#"${home}/"}")"; then
                            emit read-file credentials "${real}"
                        fi
                    done
                done
                for dir in "${CREDENTIAL_DIRS[@]}"; do
                    if [[ -d "${home}/${dir}" ]] && real="$(inside "${home}" "${dir}")"; then
                        emit read-tree credentials "${real}"
                    fi
                done
                for pattern in "${CREDENTIAL_INODES[@]}"; do
                    for file in "${home}"/${pattern}; do
                        [[ -f "${file}" && "$(realpath -e -- "${file}" 2>/dev/null)" == "${file}" ]] || continue
                        # The sensor matches "Login Data" by folder and name (a space and all), so it needs
                        # no inode; audit cannot hold the space, so there it stays an inode rule.
                        if [[ "${USE_SENSOR}" == true ]]; then
                            watchlist read-file credentials "${file}"
                        else
                            inode_rule "${file}" credentials
                        fi
                    done
                done
                settings="${home}/.config/amethystora/backup.env"
                if [[ -f "${settings}" && ! -L "${settings}" ]]; then
                    file="$(head -c 8192 -- "${settings}" | sed -n 's/^RESTIC_PASSWORD_FILE="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' | head -n1)"
                    file="${file/#\~/${home}}"
                    if [[ "${file}" == "${home}"/* && -f "${file}" ]] && real="$(inside "${home}" "${file#"${home}/"}")"; then
                        emit read-file credentials "${real}"
                    fi
                fi
            } | sort -u
        fi
        # The decoy (DECOY): made as the account when on, and taken back when off, only ever this script's own
        if [[ "${DECOY}" == true ]]; then
            if make_decoy "${home}" "${uid}" && own_decoy "${home}/${DECOY_FILE}" &&
                real="$(inside "${home}" "${DECOY_FILE}")"; then
                emit read-file decoy "${real}"
            fi
        elif own_decoy "${home}/${DECOY_FILE}" && real="$(inside "${home}" "${DECOY_FILE}")"; then
            setpriv --reuid="${uid}" --regid="$(stat -c '%g' "${home}")" --clear-groups rm -f -- "${real}" || true
        fi
        echo
    done < <({
        cat "${ROOT}/etc/passwd"
        for home in "${ROOT}"/var/home/*/; do
            [[ -d "${home}" ]] && printf '%s:x:%s:::%s:\n' "$(basename "${home}")" "$(stat -c %u "${home}")" "${home%/}"
        done
    } | awk -F: '!seen[$3]++')

    # The agents in Homebrew's prefix, where it leads: inside the prefix, and plain
    if [[ "${AGENT_CLIS}" == true ]]; then
        for command in "${BREW_AGENTS[@]}"; do
            real="$(realpath -e -- "${ROOT}${command}" 2>/dev/null)" || continue
            if [[ ( "${real}" == "${ROOT}"/home/linuxbrew/* || "${real}" == "${ROOT}"/var/home/linuxbrew/* ) &&
                "${real}" =~ ^[[:alnum:]._/@+-]+$ ]]; then
                emit exec-tree agent-clis "${real%/*}"
            fi
        done
    fi
} >"${RULES}.new"

mv "${RULES}.new" "${RULES}"
chmod 0600 "${RULES}"
restorecon "${RULES}" 2>/dev/null || true

# The sensor's plan and watch list, written together with the rules from the one set of decisions above.
mv "${WATCHLIST}.new" "${WATCHLIST}" && chmod 0644 "${WATCHLIST}"
mv "${PLAN}.new" "${PLAN}" && chmod 0644 "${PLAN}"

# Nothing to load here in the normal case: this runs before every file in /etc/audit/rules.d is loaded
# at boot, by audit-rules.service once auditd has started (audit 4.2 and later; auditd itself before).
# The load below is for the other case, someone running this by hand on a machine where auditd is
# already up, and it is refused once the rule set has been made immutable, which is correct: those
# rules are already loaded.
if [[ -z "${ROOT}" ]] && systemctl is-active --quiet auditd.service; then
    augenrules --load
fi
