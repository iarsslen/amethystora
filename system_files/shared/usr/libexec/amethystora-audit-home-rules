#!/usr/bin/bash
# Audit watches for the places inside a home directory that survive a logout: the desktop's autostart
# entries, the user's own systemd units and environment, the per-user Flatpak permission overrides
# (where a granted-back X11 socket would show up) and the shell startup files, and, under a key of their
# own, the folders a session finds commands and launchers in before the system's. Written as a rules file
# rather than shipped with the image because an audit watch needs a path that exists when the rules are
# loaded, and home directories only exist once accounts do. Runs from amethystora-audit-rules.service,
# at every boot, so accounts made since the last one are picked up.
#
# The system-wide half is written here too, into /etc/audit/rules.d/60-amethystora.rules, from the rules the
# image ships one file per key in /usr/share/amethystora/audit. Every key is a switch in
# /etc/amethystora/security.conf (IDENTITY, PERSISTENCE, USER_PROGRAMS...): a key that is off gets no rule
# at all, so it costs nothing once these have been loaded at the next boot.

set -euo pipefail

# AMETHYSTORA_AUDIT_ROOT is for build_files/shared/test-audit-home-rules.sh, which runs this against a
# stand-in /etc/passwd and /var/home
ROOT="${AMETHYSTORA_AUDIT_ROOT:-}"
RULES="${ROOT}/etc/audit/rules.d/61-amethystora-home.rules"
SYSTEM_RULES="${ROOT}/etc/audit/rules.d/60-amethystora.rules"
SHIPPED=/usr/share/amethystora/audit

# Whether an audit key is wanted: anything but off, under its name in security.conf (input-capture is
# INPUT_CAPTURE). A key the helper does not know is wanted, as one with no switch always was.
wanted() {
    local name
    name="$(tr "a-z-" "A-Z_" <<<"$1")"
    ! /usr/libexec/amethystora-security-config --is "${name}" off 2>/dev/null
}

# Directories worth watching whether or not anything has created them yet: each is a standard XDG path
# that the desktop would create on its own, and a watch on the directory catches the file appearing in
# it, which is what persistence looks like. Quadlets are containers the user's systemd starts at login.
WATCH_DIRS=(
    .config/autostart
    .config/systemd/user
    .config/environment.d
    .config/containers/systemd
    .local/share/systemd/user
    .local/share/flatpak/overrides
    # A D-Bus service an app activates, and a GNOME Shell extension, which runs inside the compositor and
    # sees every key pressed
    .local/share/dbus-1/services
    .local/share/gnome-shell/extensions
    # A top-bar widget, whose command runs as soon as its folder appears, without a login in between: a
    # Flatpak with the home folder can put one there (the widgets keep what they write elsewhere)
    .config/amethystora/widgets
)
# ...and those watched only where they are, since an account without them has no use for them: SSH's keys
# that let someone log in, its rc and its config (ProxyCommand runs a command), and fish's startup folders
WATCH_EXISTING_DIRS=(
    .ssh
    .config/fish/conf.d
    .config/fish/functions
)
# Where a session finds commands before the system's own, and the app grid's launchers, under a key of
# their own: writes here are everyday (pip, a container's exported apps), so the watcher only records
# them, and what it says out loud is a command named like a system one, or a launcher no container
# export made, which it looks for at each run (read_user_paths)
PROGRAM_DIRS=(
    .local/bin
    .local/share/applications
)
# Startup files, watched only where they exist: creating one is caught by the watch on the home
# directory's own shell configuration only if it is already there, so a missing file is a known gap.
WATCH_FILES=(
    .bashrc
    .bash_profile
    .bash_login
    .bash_logout
    .profile
    .zshrc
    .zshenv
    .zprofile
    .zlogin
    .config/fish/config.fish
    # Which app opens what, and git's settings, whose hooksPath, fsmonitor and sshCommand run commands
    .config/mimeapps.list
    .gitconfig
    .config/git/config
)

# The places in a home these rules watch, one a line, for the security watcher: it says when a link takes
# one of them out of the home, and so out of these rules' reach
if [[ "${1:-}" == --paths ]]; then
    printf '%s\n' "${WATCH_DIRS[@]}" "${PROGRAM_DIRS[@]}" "${WATCH_EXISTING_DIRS[@]}" "${WATCH_FILES[@]}" bin
    exit 0
fi

# Root never follows a link the account put in its home out of it. -L and chown -h only ever look at the
# last name of a path: with ~/.config a link to /etc, ~/.config/systemd is /etc/systemd, no link itself,
# and an earlier version of this script handed it to the account, which made it root at the next boot.
# Nothing of the account's runs yet this early in boot, so nothing can swap a name between look and act.

# The real path of HOME/NAME, printed only when it is inside HOME and one word of plain characters. An
# audit watch follows no link, so the rule names the real path; one that leads out of the home gets no
# watch at all, since root would watch whatever the account pointed it at, and a watch on / is refused by
# the kernel, which stops auditctl loading every rule after it, -e 2 included. auditctl also splits a rule
# on spaces, and stops the same way at a line it cannot read.
inside() {
    local real
    real="$(realpath -e -- "$1/$2" 2>/dev/null)" || return 1
    [[ "${real}" == "$1"/* && "${real}" =~ ^[[:alnum:]._/@+-]+$ ]] && echo "${real}"
}

# Gives the account back each folder on the way from its home to NAME that root owns: what an older version
# of this script left behind when it made them as root with install -o. One name at a time, stopping at the
# first that is not a plain folder reached without a link.
give_back() {
    local home="$1" uid="$2" part="$1" component
    local -a parts
    IFS=/ read -ra parts <<<"$3"
    for component in "${parts[@]}"; do
        part+="/${component}"
        [[ ! -L "${part}" && -d "${part}" && "$(realpath -e -- "${part}" 2>/dev/null)" == "${part}" ]] || return 0
        if [[ "$(stat -c '%u' -- "${part}")" == 0 ]] && ! chown -h -- "${uid}:$(stat -c '%g' -- "${home}")" "${part}"; then
            echo "Could not give ${part} back to UID ${uid}" >&2
        fi
    done
}

# The image's rules, for each key that is not off. A watch on a path that is not there would stop auditctl
# loading every rule after it, -e 2 included, so such a line is left out rather than written.
{
    echo "## Generated by ${0} from ${SHIPPED}, for the keys not"
    echo "## off in /etc/amethystora/security.conf. Edits are overwritten at the next boot."
    for shipped in "${SHIPPED}"/*.rules; do
        [[ -f "${shipped}" ]] || continue
        key="$(basename "${shipped}" .rules)"
        echo
        if ! wanted "${key}"; then
            echo "## ${key} is off"
            continue
        fi
        while IFS= read -r line; do
            if [[ "${line}" =~ ^-w\ ([^ ]+)\  && ! -e "${BASH_REMATCH[1]}" ]]; then
                echo "## Left out, not on this machine: ${line}"
            elif [[ "${line}" =~ \ -F\ (dir|path)=([^ ]+) && ! -e "${BASH_REMATCH[2]}" ]]; then
                echo "## Left out, not on this machine: ${line}"
            elif [[ "${line}" == -* ]]; then
                echo "${line}"
            fi
        done <"${shipped}"
    done
} >"${SYSTEM_RULES}.new"
mv "${SYSTEM_RULES}.new" "${SYSTEM_RULES}"
chmod 0600 "${SYSTEM_RULES}"
restorecon "${SYSTEM_RULES}" 2>/dev/null || true

PERSISTENCE=false
wanted persistence && PERSISTENCE=true
USER_PROGRAMS=false
wanted user-programs && USER_PROGRAMS=true
EXEC_WATCH=false
wanted exec-watch && EXEC_WATCH=true
AGENT_CLIS=false
wanted agent-clis && AGENT_CLIS=true
# Where amethystora-agent's agents are installed, by their makers' installers, in each home. A command here is
# usually a link to the folder the agent really runs from, which is the one watched: Claude Code's and Cursor's
# point into versions/ folders that their updates add to.
AGENT_COMMANDS=(.local/bin/claude .local/bin/codex .local/bin/copilot .local/bin/cursor-agent .local/bin/agent
    .opencode/bin/opencode)
# Gemini CLI comes from Homebrew, whose prefix every account shares
BREW_AGENTS=(/home/linuxbrew/.linuxbrew/bin/gemini)

# A rule on a folder each time a program runs from it, for the account's own logins. The folder has to be
# there, or auditctl stops at the rule: the caller has checked it.
exec_rule() { echo "-a always,exit -F arch=b64 -S execve,execveat -F dir=$1 -F auid>=1000 -F auid!=unset -k $2"; }

# The download folder's name follows the session's language: the one in ~/.config/user-dirs.dirs, plain, and
# inside the home, else Downloads
download_dir() {
    local home="$1" file="$1/.config/user-dirs.dirs" name=""
    if [[ -f "${file}" && ! -L "${file}" ]]; then
        name="$(head -c 8192 -- "${file}" | sed -n 's/^XDG_DOWNLOAD_DIR="\$HOME\/\([^"]*\)"$/\1/p' | head -n1)"
    fi
    [[ -n "${name}" && "${name}" != *..* ]] || name=Downloads
    echo "${name%/}"
}

{
    echo "## Generated by ${0}. Edits are overwritten at the next boot."
    echo "## Read what these caught with: sudo ausearch -k persistence -i (and -k user-programs)"
    echo

    # Real accounts only: system users below UID 1000, and nobody at 65534, have no desktop session. A
    # domain's (SSSD or winbind) are numbered from far above 65534, and are not in /etc/passwd: their
    # home folders in /var/home stand in for them, since nothing can look them up this early in boot.
    while IFS=: read -r user _ uid _ _ home _; do
        [[ "${uid}" -ge 1000 && "${uid}" -ne 65534 ]] || continue
        # /home is a symlink to /var/home on this system, and an audit watch follows no symlinks:
        # the rule has to name the path the kernel sees.
        home="$(realpath -q "${home}" || true)"
        [[ -n "${home}" && -d "${home}" ]] || continue

        echo "## ${user}"
        for dir in "${WATCH_DIRS[@]}" "${PROGRAM_DIRS[@]}"; do
            key=persistence
            [[ " ${PROGRAM_DIRS[*]} " == *" ${dir} "* ]] && key=user-programs
            # A key that is off gets no watch, and nothing made in the home for one
            [[ "${key}" == persistence && "${PERSISTENCE}" == true ]] ||
                [[ "${key}" == user-programs && "${USER_PROGRAMS}" == true ]] || continue
            if [[ ! -d "${home}/${dir}" ]]; then
                # As the user, not as root with install -o: that gave only the last directory to the
                # user and left the ones made on the way, ~/.local/share/flatpak among them, to root,
                # and it followed any link the user had put in the way wherever it led
                setpriv --reuid="${uid}" --regid="$(stat -c '%g' "${home}")" --clear-groups \
                    mkdir -p -m 0700 "${home}/${dir}" || continue
            fi
            give_back "${home}" "${uid}" "${dir}"
            if real="$(inside "${home}" "${dir}")"; then
                echo "-w ${real}/ -p wa -k ${key}"
            fi
        done
        for file in "${WATCH_FILES[@]}"; do
            [[ "${PERSISTENCE}" == true ]] || break
            [[ -f "${home}/${file}" ]] && real="$(inside "${home}" "${file}")" && echo "-w ${real} -p wa -k persistence"
        done
        for dir in "${WATCH_EXISTING_DIRS[@]}"; do
            [[ "${PERSISTENCE}" == true ]] || break
            [[ -d "${home}/${dir}" ]] && real="$(inside "${home}" "${dir}")" && echo "-w ${real}/ -p wa -k persistence"
        done
        # ~/bin is in the PATH a shell sets up, but only where it is there: nobody is given one to watch
        [[ "${USER_PROGRAMS}" == true && -d "${home}/bin" && ! -L "${home}/bin" ]] && real="$(inside "${home}" bin)" &&
            echo "-w ${real}/ -p wa -k user-programs"
        # A program run from the cache or the download folder (EXEC_WATCH), where they are
        if [[ "${EXEC_WATCH}" == true ]]; then
            for dir in .cache "$(download_dir "${home}")"; do
                if [[ -d "${home}/${dir}" ]] && real="$(inside "${home}" "${dir}")"; then
                    exec_rule "${real}" exec-watch
                fi
            done
        fi
        # Each AI agent the account has, run (AGENT_CLIS): the folder its command leads to, once each. An agent
        # installed after this boot is covered from the next; odd processes see it until then.
        if [[ "${AGENT_CLIS}" == true ]]; then
            for command in "${AGENT_COMMANDS[@]}"; do
                if [[ -e "${home}/${command}" ]] && real="$(inside "${home}" "${command}")"; then
                    echo "${real%/*}"
                fi
            done | sort -u | while read -r dir; do
                if [[ -d "${dir}" ]]; then
                    exec_rule "${dir}" agent-clis
                fi
            done
        fi
        echo
    done < <({
        cat "${ROOT}/etc/passwd"
        for home in "${ROOT}"/var/home/*/; do
            [[ -d "${home}" ]] && printf '%s:x:%s:::%s:\n' "$(basename "${home}")" "$(stat -c %u "${home}")" "${home%/}"
        done
    } | awk -F: '!seen[$3]++')

    # The agents in Homebrew's prefix, where it leads: inside the prefix, and plain
    if [[ "${AGENT_CLIS}" == true ]]; then
        for command in "${BREW_AGENTS[@]}"; do
            real="$(realpath -e -- "${ROOT}${command}" 2>/dev/null)" || continue
            if [[ ( "${real}" == "${ROOT}"/home/linuxbrew/* || "${real}" == "${ROOT}"/var/home/linuxbrew/* ) &&
                "${real}" =~ ^[[:alnum:]._/@+-]+$ ]]; then
                exec_rule "${real%/*}" agent-clis
            fi
        done
    fi
} >"${RULES}.new"

mv "${RULES}.new" "${RULES}"
chmod 0600 "${RULES}"
restorecon "${RULES}" 2>/dev/null || true

# Nothing to load here in the normal case: this runs before every file in /etc/audit/rules.d is loaded
# at boot, by audit-rules.service once auditd has started (audit 4.2 and later; auditd itself before).
# The load below is for the other case, someone running this by hand on a machine where auditd is
# already up, and it is refused once the rule set has been made immutable, which is correct: those
# rules are already loaded.
if [[ -z "${ROOT}" ]] && systemctl is-active --quiet auditd.service; then
    augenrules --load
fi
