#!/usr/bin/bash
# `ame setup save|diff|apply`: this account's setup in a file of its own, to keep in git, read, edit and
# apply, here or on another machine (`ame restore-setup` makes it again from a backup instead):
#
#   amethystora-setup save [FILE]                      write this machine's setup to FILE ("-" prints it)
#   amethystora-setup diff [--json] [FILE]             what the machine and the file disagree on
#   amethystora-setup apply [--remove] [--yes] [FILE]  bring the machine in line with the file
#
# FILE is ~/.config/amethystora/setup.json unless one is named. It is what amethystora-setup-manifest
# writes, less what describes the machine rather than the setup (its name, the account, the time), and
# less everything that is an address or a script: the Flatpak remotes, the Brewfile (Ruby, which
# Homebrew runs), templates and package managers of the account's own (images and commands), the AUR's
# switch. A file can be shared, and one somebody shared must not be able to run anything. What is left
# names things, and each comes from where it always does:
#
#   version      1
#   image        {name, stream}, switched to through `ame system rebase`: signed images only, and it asks
#   flatpaks     {system, user}: [{app, origin}], from remotes this machine already has
#   brew         {taps, formulae, casks}, from Homebrew
#   containers   [{name, template, init, packages}], made by amethystora-pkg from a template this machine
#                has (the built-in ones pinned by digest in the image), packages from its repositories
#   extensions   the GNOME extensions turned on, of those installed here
#   theme        the desktop theme
#   settings     {layout, favorites, keybindings, tiling}: the window layout, the dock's apps, the keys of
#                keybindings (the image's custom keybindings by their id, never a command), and the tiling's
#                settings by their key in its schema (TILING_KEYS: numbers, switches and lists, never its
#                window rules, which hold patterns, or a picture's path), and no other GNOME setting. A file
#                from before the tiling replaced PaperWM may still hold its gaps under paperwm, which are read
#                as the tiling's when the file has no tiling of its own (a gap the tiling cannot take is left
#                out), and its keybindings, which `diff` lists as keys this machine does not have.
#
# A file with any other key is refused, by `save` as well. A list the file leaves out counts as empty,
# and a setting it leaves out as the machine's. `apply` adds what is missing after showing the list, and
# takes nothing away unless --remove is given, and then only after asking; run twice, the second run
# finds nothing to do.
#
# An image of one's own takes the same file as the defaults of every machine and account, while it is built
# (the image template's build runs it as root; never on a machine):
#
#     /usr/libexec/amethystora-setup bake FILE [--root DIR]
#
# It writes what the image already reads: the apps into a preinstall.d file (Flathub's only, the one remote an
# image has), the dock, the extensions (the image's own and the file's, each installed in the image), the
# keybindings, the layout and the tiling's settings into a zz2 schema override after the image's zz0 and zz1, an
# image custom keybinding's key into a dconf file, and the theme and Homebrew's names under
# /usr/share/amethystora/image-setup, which user-setup.hooks.d/11-theme.sh and 18-image-brewfile.sh read for each
# new account. Containers are made per account and the image is the build itself: both are left out, and said so.
# It fails on what the image cannot have, so that a build stops rather than ship half of it.

set -uo pipefail

# A build (bake) may run with no HOME at all: then the account's own folder, which bake never reads
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}/.config}/amethystora"
DEFAULT_FILE="${CONFIG_DIR}/setup.json"
BREW="$(command -v brew 2>/dev/null || echo /home/linuxbrew/.linuxbrew/bin/brew)"
CUSTOM=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
RELOCATABLE=org.gnome.settings-daemon.plugins.media-keys.custom-keybinding
KEY_SCHEMAS='["org.gnome.desktop.wm.keybindings", "org.gnome.shell.keybindings", "org.gnome.mutter.keybindings",
    "org.gnome.mutter.wayland.keybindings", "org.gnome.settings-daemon.plugins.media-keys",
    "org.gnome.shell.extensions.amethystora-ui.tiling.keybindings"]'
TILING=org.gnome.shell.extensions.amethystora-ui.tiling
# The tiling's settings a file may hold, each with its type and, for a number, the range its schema gives it,
# so that a file is checked before anything is set rather than half applied; test-setup.sh holds this to the
# schema. A step is a share of the screen or a width in pixels, so above 0; a workspace's colour is "" or #rrggbb.
# Never `enabled`, which is the layout, nor the window rules or a picture, which hold patterns and paths.
TILING_KEYS='{
    "window-gap": ["i", 0, 200], "horizontal-margin": ["i", 0, 400], "vertical-margin": ["i", 0, 400],
    "vertical-margin-bottom": ["i", 0, 400], "selection-border-size": ["i", 0, 100],
    "selection-border-radius-top": ["i", 0, 100], "selection-border-radius-bottom": ["i", 0, 100],
    "cycle-width-steps": ["ad", "steps"], "cycle-height-steps": ["ad", "steps"],
    "maximize-width-percent": ["d", 0.5, 1], "maximize-within-tiling": ["b"],
    "default-focus-mode": ["i", 0, 2], "open-window-position": ["i", 0, 5],
    "open-window-position-option-right": ["b"], "open-window-position-option-left": ["b"],
    "open-window-position-option-start": ["b"], "open-window-position-option-end": ["b"],
    "open-window-position-option-down": ["b"], "open-window-position-option-up": ["b"],
    "animation-time": ["d", 0, 2], "drift-speed": ["i", 1, 20], "drag-drift-speed": ["i", 1, 20],
    "minimap-scale": ["d", 0, 0.5], "minimap-shade-opacity": ["i", 0, 255],
    "edge-preview-enable": ["b"], "edge-preview-scale": ["d", 0.05, 0.5], "edge-preview-click-enable": ["b"],
    "edge-preview-timeout-enable": ["b"], "edge-preview-timeout": ["i", 100, 5000], "edge-preview-timeout-continual": ["b"],
    "gesture-enabled": ["b"], "gesture-horizontal-fingers": ["i", 0, 4], "gesture-workspace-fingers": ["i", 0, 4],
    "swipe-sensitivity": ["ad"], "swipe-friction": ["ad"],
    "show-focus-mode-icon": ["b"], "show-open-position-icon": ["b"], "default-show-top-bar": ["b"],
    "topbar-mouse-scroll-enable": ["b"], "window-switcher-preview-scale": ["d", 0.05, 0.5],
    "workspace-colors": ["as", "colours"]
}'
# What a value of each kind has to be, for the check and for reading an old file's gaps
TILING_JQ="$(
    cat <<'EOF'
def valid($spec): $spec as [$t, $a, $b] |
    if $t == "b" then type == "boolean"
    elif $t == "i" then type == "number" and . == floor and . >= $a and . <= $b
    elif $t == "d" then type == "number" and . >= $a and . <= $b
    elif $t == "ad" then type == "array" and all(.[]; type == "number" and ($a != "steps" or . > 0))
    elif $t == "as" and $a == "colours" then type == "array" and all(.[]; type == "string" and test("^(#[0-9A-Fa-f]{6})?$"))
    else false end;
def wanted($spec): $spec as [$t, $a, $b] |
    if $t == "b" then "true or false"
    elif $t == "i" then "a whole number from \($a) to \($b)"
    elif $t == "d" then "a number from \($a) to \($b)"
    elif $a == "steps" then "a list of numbers above 0"
    elif $t == "ad" then "a list of numbers"
    else "a list of colours, each \"\" or one such as \"#314e6c\"" end;
# A file from before the tiling replaced PaperWM: its gaps are the tiling's, unless the file has a tiling of its
# own, and one the tiling cannot take (PaperWM took up to 1000 pixels) is left out rather than the file refused
def from_paperwm:
    if (.settings | type) == "object" and (.settings | has("tiling") | not) and (.settings.paperwm | type) == "object" then
        (.settings.paperwm | with_entries(select(.key | IN("window-gap", "horizontal-margin", "vertical-margin",
            "vertical-margin-bottom")) | select($tiling[.key] as $spec | .value | valid($spec)))) as $gaps
        | if $gaps == {} then . else .settings.tiling = $gaps end
    else . end;
EOF
)"

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    sed -n 's/^#   amethystora-setup /ame setup /p' "$0"
}

interactive() { [[ -t 0 && -t 1 ]]; }

# gum asks, as it does everywhere in the image; read is what is there if it is not
confirm() {
    local answer
    if command -v gum >/dev/null 2>&1; then
        gum confirm --default="$2" "$1"
        return
    fi
    read -r -p "$1 [y/N] " answer || return 1
    [[ "${answer}" =~ ^[Yy] ]]
}

# --- The format -----------------------------------------------------------------------------------

# Each line it prints is a reason a file is not a setup file. Names are checked as well as keys: a name
# that starts with "-" would be read as an option by the command it is handed to.
CHECK="$(
    cat <<'EOF'
def name: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+@-]*$");
def accels: type == "array" and all(.[]; type == "string" and test("^(<[A-Za-z0-9_]+>)*[A-Za-z0-9_]*$"));
def at($key; f): if has($key) then .[$key] | f else empty end;
# A $name parameter is also a filter called name, so this one must not be called keys
def only($allowed; $where):
    if type == "object" then (keys - $allowed)[] | "\($where)\(.) is not part of a setup file"
    else "\($where) is not an object" end;
# Each entry of a list that is not what f accepts, named
def each($where; f; $what):
    if type != "array" then "\($where) is not a list" else .[] | select(f | not) | "\($where): \(tojson) is not \($what)" end;
if type != "object" then "it is not a JSON object" else
    only(["version", "image", "flatpaks", "brew", "containers", "extensions", "theme", "settings"]; ""),
    (if .version == 1 then empty else "its version is \(.version | tojson), and this reads version 1" end),
    at("image"; only(["name", "stream"]; "image."),
        (if type == "object" and (.name | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
            and (.stream | type == "string" and test("^[a-z0-9][a-z0-9._-]*$")) then empty
         else "image has a name and a stream, such as amethystora and stable" end)),
    at("flatpaks"; only(["system", "user"]; "flatpaks."),
        (if type == "object" then ("system", "user") as $i | at($i; each("flatpaks.\($i)";
            type == "object" and keys == ["app", "origin"] and (.origin | name)
                and (.app | type == "string" and test("^[A-Za-z][A-Za-z0-9_-]*([.][A-Za-z0-9_-]+)+$"));
            "{\"app\": ID, \"origin\": REMOTE}")) else empty end)),
    at("brew"; only(["taps", "formulae", "casks"]; "brew."),
        (if type == "object" then ("taps", "formulae", "casks") as $k | at($k; each("brew.\($k)";
            type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+@-]*(/[A-Za-z0-9][A-Za-z0-9._+@-]*){0,2}$");
            "one of Homebrew's names")) else empty end),
        # A formula or cask named with its tap is installed from that repository, Ruby and all, so the tap is
        # listed, and shown with its warning, as every other is
        (if type == "object" then (.taps | if type == "array" then . else [] end) as $taps
            | ("formulae", "casks") as $k | at($k; if type == "array" then .[] | strings
                | select(split("/") | length == 3 and (.[:2] | join("/") | IN($taps[]) | not))
                | "brew.\($k): \(tojson) comes from a tap that brew.taps does not list" else empty end)
         else empty end)),
    at("containers"; if type != "array" then "containers is not a list" else .[] |
        if type != "object" then "containers: \(tojson) is not a container" else
            only(["name", "template", "init", "packages"]; "containers[]."),
            (if (.name | type == "string" and test("^[a-z0-9][a-z0-9_-]{0,31}$")) and (.template | name) then empty
             else "containers: \(tojson) has no name and template" end),
            at("init"; if type == "boolean" then empty else "a container's init is true or false" end),
            at("packages"; each("the packages of a container";
                type == "string" and test("^[A-Za-z0-9@_+][A-Za-z0-9@._+:=~-]*$"); "a package's name"))
        end end),
    at("extensions"; each("extensions"; name; "an extension's id")),
    at("theme"; if type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$") then empty else "theme is not a theme's name" end),
    at("settings"; only(["layout", "favorites", "keybindings", "tiling", "paperwm"]; "settings."),
        (if type == "object" then
            at("layout"; if IN("tiling", "classic") then empty else "settings.layout is tiling or classic" end),
            at("favorites"; each("settings.favorites";
                type == "string" and test("^[A-Za-z0-9_][A-Za-z0-9._+@-]*[.]desktop$"); "an app's .desktop file")),
            # PaperWM's keybindings, which a file from before the tiling replaced it may hold, are tolerated: the diff
            # lists them as keys this machine does not have, and the rest of the file applies
            at("keybindings"; only($schemas + ["custom", "org.gnome.shell.extensions.paperwm.keybindings"]; "settings.keybindings."),
                (if type == "object" then to_entries[] | .key as $s | select($s | IN($schemas[], "custom")) | .value |
                    if type != "object" then "settings.keybindings.\($s) is not an object"
                    elif $s == "custom" then to_entries[] |
                        if (.key | test("^custom[0-9]+$")) and (.value | accels and length <= 1) then empty
                        else "settings.keybindings.custom.\(.key) is one of the image's custom keybindings, set to a list of one key or none" end
                    else to_entries[] |
                        if (.key | test("^[a-z0-9][a-z0-9-]*$")) and .key != "custom-keybindings" and (.value | accels) then empty
                        else "settings.keybindings.\($s).\(.key) is not a keybinding set to a list of keys" end
                    end else empty end)),
            at("tiling"; only($tiling | keys; "settings.tiling."),
                (if type == "object" then to_entries[] | select(.key | IN($tiling | keys[])) | $tiling[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.tiling.\(.key) is \(wanted($spec))" end
                 else empty end))
        else empty end))
end
EOF
)"

# Exits, saying why, unless the JSON on stdin is a setup file
check() {
    local problems
    problems="$(jq -r --argjson schemas "${KEY_SCHEMAS}" --argjson tiling "${TILING_KEYS}" "${TILING_JQ} ${CHECK}" 2>&1)" ||
        die "$1 is not JSON."
    [[ -z "${problems}" ]] ||
        die "$1 is not a setup file this version of Amethystora reads:"$'\n'"$(sed 's/^/  /' <<<"${problems}")"
}

load() {
    [[ -f "$1" ]] || die "There is no setup file at $1 yet: ame setup save writes one."
    check "$1" <"$1"
}

# This machine's setup as the file has it: the manifest's, less the machine, addresses and scripts, with
# every list sorted, so that a file kept in git changes only where the setup does
TO_SETUP="$(
    cat <<'EOF'
{
    version: 1,
    image: {name: .image.name, stream: .image.stream},
    flatpaks: {system: (.flatpaks.system // [] | sort_by(.app)), user: (.flatpaks.user // [] | sort_by(.app))},
    brew: (.brew // {} | {taps: (.taps // []), formulae: (.formulae // []), casks: (.casks // [])}),
    containers: (.containers // [] | map({name, template, init: (.init == true), packages: (.packages // [] | sort)})
        | sort_by(.name)),
    extensions: (.extensions // [] | sort),
    theme: .theme,
    settings: .settings
}
| if .image.name == null or .image.stream == null then del(.image) else . end
| if (.theme // "") == "" then del(.theme) else . end
| if .settings == null then del(.settings) else . end
EOF
)"

machine() {
    /usr/libexec/amethystora-setup-manifest | jq "${TO_SETUP}"
}

# --- What the machine has -----------------------------------------------------------------------

# A value as GSettings prints it, as JSON: lists of strings or numbers, strings, numbers and switches. A
# number is written as JSON writes it, 0.15 where GSettings prints 0.14999999999999999.
as_json() { sed -E "s/^@[a-z]+ //; s/'/\"/g" | jq -c 'walk(if type == "number" then . + 0 else . end)' 2>/dev/null; }

# A list of names as GSettings takes it: the format keeps quotes out of every one, so @sh quotes each
# the way GVariant does
as_variant() { jq -r 'if length == 0 then "@as []" else "[" + (map(@sh) | join(", ")) + "]" end'; }

# The value each setting the file (its JSON in $1) names has here now, in the file's shape, or null where
# this machine has no such setting. The manifest leaves out a setting that is the image's, so it has to be read.
current() {
    local schema key value
    {
        if jq -e '.settings // {} | has("favorites")' <<<"$1" >/dev/null; then
            value="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null | as_json)"
            jq -nc --argjson v "${value:-null}" '{favorites: $v}'
        fi
        while IFS=$'\t' read -r schema key; do
            value=""
            if [[ "${schema}" == custom ]]; then
                # The image's own only: it sets their command in its dconf database
                if [[ -n "$(dconf read -d "${CUSTOM}/${key}/command" 2>/dev/null)" ]]; then
                    value="$(gsettings get "${RELOCATABLE}:${CUSTOM}/${key}/" binding 2>/dev/null | as_json |
                        jq -c 'if . == "" then [] else [.] end')"
                fi
            elif [[ "$(gsettings range "${schema}" "${key}" 2>/dev/null)" == "type as" ]]; then
                value="$(gsettings get "${schema}" "${key}" 2>/dev/null | as_json)"
            fi
            jq -nc --arg s "${schema}" --arg k "${key}" --argjson v "${value:-null}" '{keybindings: {($s): {($k): $v}}}'
        done < <(jq -r '.settings.keybindings // {} | to_entries[] | .key as $s | .value | keys[] | [$s, .] | @tsv' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${TILING}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{tiling: {($k): $v}}'
        done < <(jq -r '.settings.tiling // {} | keys[]' <<<"$1")
    } | jq -sc 'reduce .[] as $x ({favorites: null, keybindings: {}, tiling: {}}; . * $x)'
}

# Where this machine can install from, and what it can turn on
abilities() {
    local extensions="${XDG_DATA_HOME:-${HOME}/.local/share}/gnome-shell/extensions"
    jq -nc \
        --argjson system "$(flatpak remotes --system --columns=name 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson user "$(flatpak remotes --user --columns=name 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson templates "$(amethystora-pkg templates list --json 2>/dev/null | jq -c 'map(.name)' 2>/dev/null || echo '[]')" \
        --argjson aur "$(find /usr/share/amethystora/pkg/aur/templates -name '*.json' -printf '%f\n' 2>/dev/null |
            sed 's/\.json$//' | jq -R . | jq -sc .)" \
        --argjson themes "$(amethystora-theme list 2>/dev/null | sed 's/^[*] /  /' | awk '{ print $1 }' | jq -R . | jq -sc .)" \
        --argjson extensions "$(find /usr/share/gnome-shell/extensions "${extensions}" -mindepth 1 -maxdepth 1 \
            -type d -printf '%f\n' 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson brew "$([[ -x "${BREW}" ]] && echo true || echo false)" \
        '{remotes: {system: $system, user: $user}, templates: $templates, aur_templates: $aur, themes: $themes,
          extensions: $extensions, brew: $brew}'
}

# --- What differs ---------------------------------------------------------------------------------

# Every difference between the file and the machine: something to add, something to set as the file
# has it, or something the machine has that the file does not ("remove": uninstall, turn off, or put
# back to the image's), each with ok false and a reason when this machine cannot do it
CHANGES="$(
    cat <<'EOF'
def apps($x): [$x.flatpaks.system[]?, $x.flatpaks.user[]?] | map(.app);
def brew($x; $k): $x.brew[$k] // [];
($file.settings // {}) as $fs
| ($here.settings // {}) as $hs
| ($here.containers // [] | map(.name)) as $have
| ($file.containers // [] | map(.name)) as $want
| [
    ($file.image // empty | select("\(.name):\(.stream)" != "\($here.image.name):\($here.image.stream)")
        | {area: "image", action: "set", name, stream, to: "\(.name):\(.stream)",
           from: "\($here.image.name // "?"):\($here.image.stream // "?")"}),
    # An app installed in either installation counts, whichever the file has it in
    (("system", "user") as $i | $file.flatpaks[$i][]? | select(.app | IN(apps($here)[]) | not)
        | {area: "flatpak", action: "add", installation: $i, app, origin}
        + if .origin | IN($can.remotes[$i][]) then {} else {ok: false, why: "this machine has no \($i) remote called \(.origin)"} end),
    (("system", "user") as $i | $here.flatpaks[$i][]? | select(.app | IN(apps($file)[]) | not)
        | {area: "flatpak", action: "remove", installation: $i, app}),
    ((["tap", "taps"], ["formula", "formulae"], ["cask", "casks"]) as [$area, $k]
        | ((brew($file; $k) - brew($here; $k))[] | {area: $area, action: "add", name: .}
            + if $can.brew then {} else {ok: false, why: "Homebrew is not set up here"} end),
          ((brew($here; $k) - brew($file; $k))[] | {area: $area, action: "remove", name: .})),
    ($file.containers[]? | select(.name | IN($have[]) | not)
        | {area: "container", action: "add", name, template, init: (.init // false), packages: (.packages // [])}
        + if .template | IN($can.templates[]) then {}
          elif .template | IN($can.aur_templates[]) then {ok: false, why: "it is made from the AUR, which is off here: ame apps aur turns it on"}
          else {ok: false, why: "this machine has no template called \(.template)"} end),
    ($here.containers[]? | select(.name | IN($want[]) | not) | {area: "container", action: "remove", name}),
    ($file.containers[]? as $c | $here.containers[]? | select(.name == $c.name)
        | ($c.packages // []) - (.packages // []) | select(length > 0)
        | {area: "packages", action: "add", container: $c.name, packages: .}),
    ((($file.extensions // []) - ($here.extensions // []))[] | {area: "extension", action: "add", uuid: .}
        + if IN($can.extensions[]) then {} else {ok: false, why: "it is not installed here: Extension Manager finds it"} end),
    ((($here.extensions // []) - ($file.extensions // []))[] | {area: "extension", action: "remove", uuid: .}),
    ($file.theme // empty | select(. != $here.theme) | {area: "theme", action: "set", to: ., from: $here.theme}
        + if IN($can.themes[]) then {} else {ok: false, why: "there is no theme called \(.) here"} end),
    ($fs.layout // empty | select(. != $hs.layout) | {area: "layout", action: "set", to: ., from: $hs.layout}),
    (if $fs | has("favorites") then
        select($fs.favorites != $now.favorites) | {area: "favorites", action: "set", to: $fs.favorites, from: $now.favorites}
     elif $hs | has("favorites") then {area: "favorites", action: "remove", from: $hs.favorites}
     else empty end),
    ($fs.keybindings // {} | to_entries[] | .key as $s | .value | to_entries[] | .key as $k | $now.keybindings[$s][$k] as $v
        | select(.value != $v) | {area: "keybinding", action: "set", schema: $s, key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such keybinding"} else {} end),
    ($hs.keybindings // {} | to_entries[] | .key as $s | .value | to_entries[] | .key as $k
        | select($fs.keybindings[$s] // {} | has($k) | not)
        | {area: "keybinding", action: "remove", schema: $s, key: $k, from: .value}),
    ($fs.tiling // {} | to_entries[] | .key as $k | $now.tiling[$k] as $v
        | select(.value != $v) | {area: "tiling", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine's tiling has no such setting"} else {} end),
    ($hs.tiling // {} | to_entries[] | .key as $k | select($fs.tiling // {} | has($k) | not)
        | {area: "tiling", action: "remove", key: $k, from: .value})
  ]
| map({ok: true, why: null} + .)
EOF
)"

changes() {
    local here file
    here="$(machine)" && [[ -n "${here}" ]] || die "This machine's setup could not be read."
    file="$(jq -c --argjson tiling "${TILING_KEYS}" "${TILING_JQ} from_paperwm" "$1")" || die "$1 could not be read."
    jq -nc --argjson file "${file}" --argjson here "${here}" --argjson now "$(current "${file}")" \
        --argjson can "$(abilities)" "${CHANGES}"
}

# One line for each change
DESCRIBE="$(
    cat <<'EOF'
def accels: if length == 0 then "no key" else join(" or ") end;
def text:
    if .area == "image" then "the system: \(.to), in place of \(.from)"
    elif .area == "flatpak" then "the app \(.app)" + if .action == "add" then ", from \(.origin)"
        + if .installation == "user" then ", for you alone" else "" end else "" end
    elif .area == "tap" then "the Homebrew tap \(.name)"
        + if .action == "add" then ", whose formulae anyone can publish and Homebrew does not review" else "" end
    elif .area == "formula" then "the Homebrew formula \(.name)"
    elif .area == "cask" then "the Homebrew cask \(.name)"
    elif .area == "container" then "the container \(.name)" + if .action == "add" then ", from the template \(.template)"
        + if (.packages | length) > 0 then ", with \(.packages | join(", "))" else "" end
        else ", and everything installed in it" end
    elif .area == "packages" then "\(.packages | join(", ")) in the container \(.container)"
    elif .area == "extension" then "the extension \(.uuid)"
    elif .area == "theme" then "the theme: \(.to), in place of \(.from // "none")"
    elif .area == "layout" then "the window layout: \(.to), in place of \(.from)"
    elif .area == "favorites" then if .action == "set" then "the dock's apps: \(.to | join(", "))"
        else "the dock's apps, back to the image's" end
    elif .area == "keybinding" then "the keybinding " + if .schema == "custom" then .key else "\(.schema) \(.key)" end
        + if .action == "set" then ": \(.to | accels)" + if .from == null then "" else ", in place of \(.from | accels)" end
          else ", \(.from | accels) here, back to the image's" end
    elif .area == "tiling" then "the tiling's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    else tojson end;
EOF
)"

# Prints the changes on stdin that the jq condition $3 selects, marked with $2, under the heading $1
section() {
    jq -r --arg title "$1" --arg mark "$2" "${DESCRIBE}"' [.[] | select('"$3"')] | select(length > 0)
        | if $title == "" then empty else $title end,
          (.[] | "  \($mark) " + text + if .ok then "" else ": \(.why)" end),
          if $title == "" then empty else "" end'
}

# --- The commands ---------------------------------------------------------------------------------

save() {
    local target="${1:-${DEFAULT_FILE}}" setup
    [[ $# -le 1 && "${target}" != -?* ]] || die "usage: ame setup save [FILE]"
    setup="$(machine)" && [[ -n "${setup}" ]] || die "This machine's setup could not be read."
    check "This machine's setup" <<<"${setup}"
    if [[ "${target}" == - ]]; then
        printf '%s\n' "${setup}"
        return
    fi
    # Through a link, to where it leads, as a file kept in a folder of dotfiles often is
    target="$(realpath -m -- "${target}")"
    mkdir -p "$(dirname "${target}")" || die "Could not make the folder for ${target}."
    printf '%s\n' "${setup}" >"${target}.new" && mv -f "${target}.new" "${target}" || die "Could not write ${target}."
    echo "Saved this machine's setup to ${target}:"
    jq -r 'def n($count; $what): "\($count) \($what)\(if $count == 1 then "" else "s" end)";
        "\(n(.flatpaks.system + .flatpaks.user | length; "app")), \(.brew.formulae + .brew.casks | length) from Homebrew, "
        + "\(n(.containers | length; "container")), \(n(.extensions | length; "extension")), the theme \(.theme // "none"), "
        + "\(n(.settings.keybindings // {} | map(length) | add // 0; "keybinding")) "
        + "and \(n(.settings.tiling // {} | length; "tiling setting")) of your own."' <<<"${setup}"
    if ! git -C "$(dirname "${target}")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "To keep it in git, see: amethystora-manual setup#keeping-it-in-git"
    fi
}

diff_setup() {
    local json=false file="" changes
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true ;;
            -*) die "usage: ame setup diff [--json] [FILE]" ;;
            *) [[ -z "${file}" ]] || die "usage: ame setup diff [--json] [FILE]"; file="$1" ;;
        esac
        shift
    done
    file="${file:-${DEFAULT_FILE}}"
    load "${file}"
    changes="$(changes "${file}")" || exit 1
    if [[ "${json}" == true ]]; then
        jq . <<<"${changes}"
    elif [[ "${changes}" == "[]" ]]; then
        echo "This machine is as ${file} says."
    else
        section "In the file, not here (ame setup apply adds them):" + '.ok and .action == "add"' <<<"${changes}"
        section "Set differently here (ame setup apply sets them as the file has them):" "~" '.ok and .action == "set"' <<<"${changes}"
        section "Here, not in the file (ame setup apply --remove takes them away, after asking):" - '.action == "remove"' <<<"${changes}"
        section "In the file, but this machine cannot have them:" "!" '.ok | not' <<<"${changes}"
    fi
}

apply() {
    local remove=false yes=false did=false file="" changes todo gone
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remove) remove=true ;;
            --yes | -y) yes=true ;;
            -*) die "usage: ame setup apply [--remove] [--yes] [FILE]" ;;
            *) [[ -z "${file}" ]] || die "usage: ame setup apply [--remove] [--yes] [FILE]"; file="$1" ;;
        esac
        shift
    done
    file="${file:-${DEFAULT_FILE}}"
    load "${file}"
    changes="$(changes "${file}")" || exit 1
    todo="$(jq -c '[.[] | select(.ok and .action != "remove")]' <<<"${changes}")"
    gone="$(jq -c '[.[] | select(.action == "remove")]' <<<"${changes}")"
    section "In the file, but this machine cannot have them, so they are left out:" "!" '.ok | not' <<<"${changes}"

    if [[ "${todo}" == "[]" && ("${remove}" == false || "${gone}" == "[]") ]]; then
        echo "Nothing to do: this machine has everything ${file} names, as it names it."
    fi
    if [[ "${todo}" != "[]" ]]; then
        echo "To make this machine as ${file} says:"
        section "" + '.action == "add"' <<<"${todo}"
        section "" "~" '.action == "set"' <<<"${todo}"
        echo
        if [[ "${yes}" != true ]]; then
            interactive || die "apply asks before it changes anything, which needs a terminal, or --yes."
            confirm "Go ahead?" true || exit 0
        fi
        add_all "${todo}"
        did=true
    fi
    if [[ "${gone}" != "[]" && "${remove}" == true ]]; then
        section "Here, and not in the file:" - 'true' <<<"${gone}"
        interactive || die "--remove asks before it takes anything away, which needs a terminal."
        if confirm "Take these away? Apps keep their data, and a container's home folder stays." false; then
            remove_all "${gone}"
            did=true
        fi
    elif [[ "${gone}" != "[]" ]]; then
        echo "Left as they are: $(jq length <<<"${gone}") here that the file does not name (ame setup diff lists them)."
    fi

    if [[ ${#FAILED[@]} -gt 0 ]]; then
        echo
        echo "Done, except: $(printf '%s, ' "${FAILED[@]}" | sed 's/, $//'). Running it again picks up where it stopped."
        return 1
    fi
    [[ "${did}" == false ]] || echo "Done."
}

# --- Doing it -------------------------------------------------------------------------------------

# Each change is read into an array first, so that what runs keeps the terminal on its stdin and can
# ask its questions there. What fails is named in FAILED.
FAILED=()

# The changes of one area, one JSON object a line
of() { jq -c --arg a "$2" '.[] | select(.area == $a)' <<<"$1"; }

add_all() {
    local todo="$1" change installation origin name template value stream
    local -a changes names args
    mapfile -t changes < <(jq -r '[.[] | select(.area == "flatpak") | [.installation, .origin]] | unique[] | @tsv' <<<"${todo}")
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r installation origin <<<"${change}"
        mapfile -t names < <(jq -r --arg i "${installation}" --arg o "${origin}" \
            '.[] | select(.area == "flatpak" and .installation == $i and .origin == $o) | .app' <<<"${todo}")
        flatpak install "--${installation}" --noninteractive "${origin}" "${names[@]}" || FAILED+=("apps from ${origin}")
    done

    mapfile -t names < <(of "${todo}" tap | jq -r .name)
    for name in "${names[@]}"; do
        "${BREW}" tap "${name}" || FAILED+=("the Homebrew tap ${name}")
    done
    mapfile -t names < <(of "${todo}" formula | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" install --formula "${names[@]}" || FAILED+=("Homebrew formulae")
    mapfile -t names < <(of "${todo}" cask | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" install --cask "${names[@]}" || FAILED+=("Homebrew casks")

    # A package from the AUR is built only once its PKGBUILD has been read, --yes or not
    mapfile -t changes < <(of "${todo}" container)
    for change in "${changes[@]}"; do
        name="$(jq -r .name <<<"${change}")"
        template="$(jq -r .template <<<"${change}")"
        args=(containers new --template "${template}" --name "${name}" --no-prompt --yes)
        [[ "$(jq -r .init <<<"${change}")" == true ]] && args+=(--init)
        amethystora-pkg "${args[@]}" || { FAILED+=("the container ${name}"); continue; }
        mapfile -t names < <(jq -r '.packages[]' <<<"${change}")
        [[ ${#names[@]} -eq 0 ]] || amethystora-pkg "${name}" install --yes "${names[@]}" || FAILED+=("packages in ${name}")
    done
    mapfile -t changes < <(of "${todo}" packages)
    for change in "${changes[@]}"; do
        name="$(jq -r .container <<<"${change}")"
        mapfile -t names < <(jq -r '.packages[]' <<<"${change}")
        amethystora-pkg "${name}" install --yes "${names[@]}" || FAILED+=("packages in ${name}")
    done

    mapfile -t names < <(of "${todo}" extension | jq -r .uuid)
    for name in "${names[@]}"; do
        gnome-extensions enable "${name}" || FAILED+=("the extension ${name}")
    done
    mapfile -t names < <(of "${todo}" theme | jq -r .to)
    for name in "${names[@]}"; do
        amethystora-theme set "${name}" || FAILED+=("the theme")
    done
    mapfile -t names < <(of "${todo}" layout | jq -r .to)
    for name in "${names[@]}"; do
        ame desktop layout "${name}" || FAILED+=("the window layout")
    done

    mapfile -t changes < <(of "${todo}" favorites)
    for change in "${changes[@]}"; do
        gsettings set org.gnome.shell favorite-apps "$(jq -c .to <<<"${change}" | as_variant)" || FAILED+=("the dock's apps")
    done
    mapfile -t changes < <(of "${todo}" keybinding)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        if [[ "$(jq -r .schema <<<"${change}")" == custom ]]; then
            gsettings set "${RELOCATABLE}:${CUSTOM}/${name}/" binding "'$(jq -r '.to[0] // ""' <<<"${change}")'"
        else
            gsettings set "$(jq -r .schema <<<"${change}")" "${name}" "$(jq -c .to <<<"${change}" | as_variant)"
        fi || FAILED+=("the keybinding ${name}")
    done
    # The check let through only numbers, switches and lists of numbers or of colours, which GSettings reads
    # as JSON writes them
    mapfile -t changes < <(of "${todo}" tiling)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${TILING}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the tiling's ${name}")
    done

    # Last, since it downloads a whole system, which only takes over at the next restart
    mapfile -t changes < <(of "${todo}" image | jq -r '[.name, .stream] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r name stream <<<"${change}"
        if interactive; then
            ame system rebase "${name}" "${stream}" || FAILED+=("the system")
        else
            echo "Switching the system asks its own questions, in a terminal: ame system rebase ${name} ${stream}"
            FAILED+=("the system")
        fi
    done
}

remove_all() {
    local gone="$1" change installation schema name
    local -a changes names
    mapfile -t changes < <(of "${gone}" flatpak | jq -r '[.installation, .app] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r installation name <<<"${change}"
        flatpak uninstall "--${installation}" --noninteractive "${name}" || FAILED+=("the app ${name}")
    done
    mapfile -t names < <(of "${gone}" formula | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" uninstall --formula "${names[@]}" || FAILED+=("Homebrew formulae")
    mapfile -t names < <(of "${gone}" cask | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" uninstall --cask "${names[@]}" || FAILED+=("Homebrew casks")
    mapfile -t names < <(of "${gone}" tap | jq -r .name)
    for name in "${names[@]}"; do
        "${BREW}" untap "${name}" || FAILED+=("the Homebrew tap ${name}")
    done
    mapfile -t names < <(of "${gone}" container | jq -r .name)
    for name in "${names[@]}"; do
        amethystora-pkg containers rm "${name}" --force || FAILED+=("the container ${name}")
    done
    mapfile -t names < <(of "${gone}" extension | jq -r .uuid)
    for name in "${names[@]}"; do
        gnome-extensions disable "${name}" || FAILED+=("the extension ${name}")
    done
    if [[ -n "$(of "${gone}" favorites)" ]]; then
        gsettings reset org.gnome.shell favorite-apps || FAILED+=("the dock's apps")
    fi
    mapfile -t changes < <(of "${gone}" keybinding | jq -r '[.schema, .key] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r schema name <<<"${change}"
        if [[ "${schema}" == custom ]]; then
            gsettings reset "${RELOCATABLE}:${CUSTOM}/${name}/" binding
        else
            gsettings reset "${schema}" "${name}"
        fi || FAILED+=("the keybinding ${name}")
    done
    mapfile -t names < <(of "${gone}" tiling | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${TILING}" "${name}" || FAILED+=("the tiling's ${name}")
    done
}

# --- An image's defaults ---------------------------------------------------------------------------

# GVariant text of a JSON value the check let through: names, keys and colours hold no quote or backslash
GVARIANT='def gv: if type == "array" then "[" + (map(gv) | join(", ")) + "]"
    elif type == "string" then ([39] | implode) as $q | $q + . + $q else tojson end;'

bake() {
    local file="" root=/ setup out problems schemas ids defaults uuid id key
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root) [[ $# -ge 2 ]] || die "usage: amethystora-setup bake FILE [--root DIR]"; root="$2"; shift ;;
            -*) die "usage: amethystora-setup bake FILE [--root DIR]" ;;
            *) [[ -z "${file}" ]] || die "usage: amethystora-setup bake FILE [--root DIR]"; file="$1" ;;
        esac
        shift
    done
    [[ -n "${file}" ]] || die "usage: amethystora-setup bake FILE [--root DIR]"
    load "${file}"
    setup="$(jq -c --argjson tiling "${TILING_KEYS}" "${TILING_JQ} from_paperwm" "${file}")" || die "${file} could not be read."
    root="${root%/}"
    schemas="${root}/usr/share/glib-2.0/schemas"
    out="${root}/usr/share/amethystora/image-setup"
    [[ -d "${schemas}" ]] || die "${root:-/} has no ${schemas#"${root}"}: bake runs on an Amethystora image."

    # What the image cannot have stops the build, every reason at once
    problems="$(
        jq -r '.flatpaks // {} | (.system // []) + (.user // []) | .[] | select(.origin != "flathub")
            | "the app \(.app) comes from \(.origin), and an image installs apps from Flathub only"' <<<"${setup}"
        for uuid in $(jq -r '.extensions // [] | .[]' <<<"${setup}"); do
            [[ -d "${root}/usr/share/gnome-shell/extensions/${uuid}" ]] ||
                echo "the extension ${uuid} is not installed in the image: build.sh installs it first"
        done
        id="$(jq -r '.theme // empty' <<<"${setup}")"
        [[ -z "${id}" || -d "${root}/usr/share/amethystora/themes/${id}" ]] || echo "the image has no theme called ${id}"
        for id in $(jq -r '.settings.keybindings.custom // {} | keys[]' <<<"${setup}"); do
            grep -qsxF "[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/${id}]" \
                "${root}"/etc/dconf/db/distro.d/* || echo "the image has no custom keybinding ${id}"
        done
        # PaperWM's, which a file from before the tiling may hold, belong to no extension the image runs
        jq -r '.settings.keybindings // {} | keys[] | select(. == "org.gnome.shell.extensions.paperwm.keybindings")
            | "\(.) belong to PaperWM, which the image no longer has"' <<<"${setup}"
        # A key the image's schemas do not have would be dropped by glib-compile-schemas without a word
        while IFS=$'\t' read -r id key; do
            GSETTINGS_SCHEMA_DIR="${schemas}" GSETTINGS_BACKEND=memory /usr/bin/gsettings range "${id}" "${key}" >/dev/null 2>&1 ||
                echo "the image has no keybinding ${key} in ${id}"
        done < <(jq -r '.settings.keybindings // {} | to_entries[] | select(.key != "custom") | .key as $s | .value | keys[]
            | [$s, .] | @tsv' <<<"${setup}")
    )"
    [[ -z "${problems}" ]] || die "${file} cannot be baked into this image:"$'\n'"$(sed 's/^/  /' <<<"${problems}")"

    mkdir -p "${out}" "${root}/usr/share/flatpak/preinstall.d" "${root}/etc/dconf/db/distro.d" || die "Could not write into ${root:-/}."
    install -m0644 "${file}" "${out}/setup.json"

    # Every app, the account's own as well: an image has one installation for every account
    jq -r '[.flatpaks // {} | (.system // []) + (.user // []) | .[].app] | unique
        | "# The apps of this image'"'"'s setup.json (amethystora-setup bake), from Flathub on the first boot with a network",
          (.[] | "", "[Flatpak Preinstall \(.)]", "Branch=stable", "IsRuntime=false")' <<<"${setup}" \
        >"${root}/usr/share/flatpak/preinstall.d/image-setup.preinstall"

    # The image's extensions stay on whatever the file says: they are what the desktop is made of
    defaults="$(GSETTINGS_SCHEMA_DIR="${schemas}" GSETTINGS_BACKEND=memory /usr/bin/gsettings get org.gnome.shell \
        enabled-extensions | sed "s/^@as //; s/'/\"/g")" || die "Could not read the image's extensions."
    jq -r --argjson image "${defaults}" --argjson tiling "${TILING_KEYS}" "${GVARIANT}"'
        def section($schema; $values): select($values != {}) | "", "[\($schema)]", ($values | to_entries[] | "\(.key)=\(.value | gv)");
        (.settings // {}) as $s
        | "# This image'"'"'s setup.json (amethystora-setup bake), after the image'"'"'s own zz0 and zz1",
          section("org.gnome.shell"; {}
            + if has("extensions") then {"enabled-extensions": ($image + (.extensions - $image))} else {} end
            + if $s | has("favorites") then {"favorite-apps": $s.favorites} else {} end),
          ($s.keybindings // {} | to_entries[] | select(.key != "custom") | section(.key; .value)),
          section("org.gnome.shell.extensions.amethystora-ui.tiling"; ($s.tiling // {})
            + if $s.layout == null then {} else {enabled: ($s.layout == "tiling")} end)' <<<"${setup}" \
        >"${schemas}/zz2-image-setup.gschema.override"

    # The image's custom keybindings are relocatable, so their keys are dconf's
    jq -r "${GVARIANT}"'.settings.keybindings.custom // {} | to_entries[]
        | "[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/\(.key)]", "binding=\(.value[0] // "" | gv)", ""' \
        <<<"${setup}" >"${root}/etc/dconf/db/distro.d/zz2-image-setup"
    [[ -s "${root}/etc/dconf/db/distro.d/zz2-image-setup" ]] || rm -f "${root}/etc/dconf/db/distro.d/zz2-image-setup"

    rm -f "${out}/theme" "${out}/Brewfile"
    jq -r '.theme // empty' <<<"${setup}" | sed '/^$/d' >"${out}/theme"
    [[ -s "${out}/theme" ]] || rm -f "${out}/theme"
    # Names only, each in quotes the check keeps out of it: Homebrew reads a Brewfile as Ruby
    jq -r '.brew // {} | (.taps // [] | .[] | "tap \"\(.)\""), (.formulae // [] | .[] | "brew \"\(.)\""),
        (.casks // [] | .[] | "cask \"\(.)\"")' <<<"${setup}" >"${out}/Brewfile"
    [[ -s "${out}/Brewfile" ]] || rm -f "${out}/Brewfile"

    # Compiled where GNOME reads them: the system's schemas, and each extension's own, which GNOME Shell reads
    # first (build-gnome-extensions.sh), with its sections of every override
    for id in "${root}"/usr/share/gnome-shell/extensions/*/schemas; do
        [[ -d "${id}" ]] || continue
        ids="$(cat "${id}"/*.gschema.xml | tr -s '[:space:]' ' ' | grep -oE '<schema [^>]*id="[^"]+"' |
            sed -E 's/.*id="([^"]+)".*/\1/' | tr '\n' ' ')"
        awk -v ids="${ids}" 'BEGIN { n = split(ids, list, " "); for (i = 1; i <= n; i++) own["[" list[i] "]"] = 1 }
            /^\[/ { keep = ($0 in own) } keep' "${schemas}"/zz[0-9]-*.gschema.override >"${id}/zz-amethystora-modifications.gschema.override"
        glib-compile-schemas --strict "${id}" || die "The schemas of ${id%/schemas} do not take this setup."
        rm "${id}/zz-amethystora-modifications.gschema.override"
    done
    glib-compile-schemas "${schemas}" || die "The image's schemas do not take this setup."
    # Built anew, locks and all: an image's files all carry one time, so dconf could take the old one for current
    rm -f "${root}/etc/dconf/db/distro"
    dconf update "${root}/etc/dconf/db" || die "dconf could not compile ${root}/etc/dconf/db/distro.d."

    echo "Baked ${file} into the image:"
    jq -r 'def n($count; $what): "\($count) \($what)\(if $count == 1 then "" else "s" end)";
        "  \(n([.flatpaks // {} | (.system // []) + (.user // []) | .[].app] | unique | length; "app")) from Flathub, "
        + "\(n(.brew // {} | (.taps // []) + (.formulae // []) + (.casks // []) | length; "name")) from Homebrew, "
        + "\(n(.extensions // [] | length; "extension")), the theme \(.theme // "of the image")",
        if (.containers // []) != [] then "  Left out: the containers, which each account makes (ame setup apply)" else empty end,
        if .image then "  Left out: image, which is this build itself" else empty end' <<<"${setup}"
}

case "${1:-}" in
    save) shift; save "$@" ;;
    bake) shift; bake "$@" ;;
    diff) shift; diff_setup "$@" ;;
    apply) shift; apply "$@" ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 1 ;;
esac
