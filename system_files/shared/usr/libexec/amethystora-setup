#!/usr/bin/bash
# `ame setup save|diff|apply`: this account's setup in a file of its own, to keep in git, read, edit and
# apply, here or on another machine (`ame restore-setup` makes it again from a backup instead):
#
#   amethystora-setup save [FILE]                      write this machine's setup to FILE ("-" prints it)
#   amethystora-setup diff [--json] [FILE]             what the machine and the file disagree on
#   amethystora-setup apply [--remove] [--yes] [FILE]  bring the machine in line with the file
#
# FILE is ~/.config/amethystora/setup.json unless one is named. It is what amethystora-setup-manifest
# writes, less what describes the machine rather than the setup (its name, the account, the time), and
# less everything that is an address or a script: the Flatpak remotes, the Brewfile (Ruby, which
# Homebrew runs), templates and package managers of the account's own (images and commands), the AUR's
# switch. A file can be shared, and one somebody shared must not be able to run anything. What is left
# names things, and each comes from where it always does:
#
#   version      1
#   image        {name, stream}, switched to through `ame system rebase`: signed images only, and it asks
#   flatpaks     {system, user}: [{app, origin}], from remotes this machine already has
#   brew         {taps, formulae, casks}, from Homebrew
#   containers   [{name, template, init, packages}], made by amethystora-pkg from a template this machine
#                has (the built-in ones pinned by digest in the image), packages from its repositories
#   extensions   the GNOME extensions turned on, of those installed here
#   theme        the desktop theme
#   settings     {layout, favorites, keybindings, tiling, pointer, glass, motion, workspaces, windows, dock, pill, quick,
#                bars, today, breaks, search, emoji, bezel, sound, look, transitions, hints, appgrid, focus, power,
#                access, touch, present, screenshot, deskwidgets, shelf, desks}: the window
#                layout, the dock's apps, the keys of
#                keybindings (the image's custom keybindings by their id, never a command), the tiling's
#                settings by their key in its schema (TILING_KEYS: numbers, switches and lists, never its
#                window rules, which hold patterns, or a picture's path), shake to find and the larger pointer on
#                dense screens (POINTER_KEYS), the glass and Reduce transparency (GLASS_KEYS), the minimize and
#                the workspace switch (MOTION_KEYS), workspaces named after their apps and their saved sets' menu
#                (WORKSPACES_KEYS; never the sets themselves, which are the machine's state), the windows
#                module's switches, corners and gestures (WINDOWS_KEYS), the dock's settings, folders and stacks
#                under the home folder (DOCK_KEYS), the live pill, the privacy dots, the glow, quiet and the
#                digest (PILL_KEYS), the order of quick settings' tiles and the ones put away (QUICK_KEYS), a top bar
#                on every screen and over fullscreen (BARS_KEYS), today's tasks in the calendar (TODAY_KEYS; never
#                the weather, which sends the place chosen in Weather), GNOME's rest reminders (BREAKS_KEYS), what
#                the search finds besides GNOME's own (SEARCH_KEYS), the emoji picker's skin tone (EMOJI_KEYS), rounded
#                corners on a laptop's own screen (BEZEL_KEYS), whether the desktop makes its own sounds (SOUND_KEYS;
#                never the sound theme's name, which Settings sets to a folder of the account's), the look: the
#                accent, Daylight, colours from the wallpaper and an accent per workspace (LOOK_KEYS), the reveal at
#                login, the tips and the app grid's row of recent apps (TRANSITIONS_KEYS, HINTS_KEYS, APPGRID_KEYS), what
#                each focus profile does and its two triggers (FOCUS_KEYS; never the profile on now, when it ends, or
#                a saved set it names, which are this machine's), colour filters, the reading ruler and reading
#                aloud (ACCESS_KEYS; never whether a filter or the ruler is drawn this moment), touch mode and the
#                pen's tools (TOUCH_KEYS; never the pens' own buttons, GNOME's settings of this machine's pens),
#                Present mode, its pointer and its question (PRESENT_KEYS; never Scribble's key), the screenshot's
#                thumbnail and pinning (SCREENSHOT_KEYS; never the drawing tools' colours), widgets on the desktop
#                (DESKWIDGETS_KEYS; never a widget, which is a command), how the shelf opens (SHELF_KEYS; never what
#                it holds), whether desks are on and learn (DESKS_KEYS; never the desks, which name this machine's
#                screens by serial number), and no other GNOME
#                setting (Reduce motion and High Contrast are GNOME's accessibility keys, left out). A file
#                from before the tiling replaced PaperWM may still hold its gaps under paperwm, which are read
#                as the tiling's when the file has no tiling of its own (a gap the tiling cannot take is left
#                out), and its keybindings, which `diff` lists as keys this machine does not have.
#
# A file with any other key is refused, by `save` as well. A list the file leaves out counts as empty,
# and a setting it leaves out as the machine's. `apply` adds what is missing after showing the list, and
# takes nothing away unless --remove is given, and then only after asking; run twice, the second run
# finds nothing to do.
#
# An image of one's own takes the same file as the defaults of every machine and account, while it is built
# (the image template's build runs it as root; never on a machine):
#
#     /usr/libexec/amethystora-setup bake FILE [--root DIR]
#
# It writes what the image already reads: the apps into a preinstall.d file (Flathub's, or a remote the image's policy
# adds, amethystora-image-policy --only flatpak-remotes), the dock, the extensions (the image's own and the file's, each installed in the image), the
# keybindings, the layout and the tiling's settings into a zz2 schema override after the image's zz0 and zz1, an
# image custom keybinding's key into a dconf file, and the theme and Homebrew's names under
# /usr/share/amethystora/image-setup, which user-setup.hooks.d/11-theme.sh and 18-image-brewfile.sh read for each
# new account. Containers are made per account and the image is the build itself: both are left out, and said so.
# It fails on what the image cannot have, so that a build stops rather than ship half of it.

set -uo pipefail

# A build (bake) may run with no HOME at all: then the account's own folder, which bake never reads
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}/.config}/amethystora"
DEFAULT_FILE="${CONFIG_DIR}/setup.json"
BREW="$(command -v brew 2>/dev/null || echo /home/linuxbrew/.linuxbrew/bin/brew)"
CUSTOM=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
RELOCATABLE=org.gnome.settings-daemon.plugins.media-keys.custom-keybinding
KEY_SCHEMAS='["org.gnome.desktop.wm.keybindings", "org.gnome.shell.keybindings", "org.gnome.mutter.keybindings",
    "org.gnome.mutter.wayland.keybindings", "org.gnome.settings-daemon.plugins.media-keys",
    "org.gnome.shell.extensions.amethystora-ui.tiling.keybindings", "org.gnome.shell.extensions.amethystora-ui.windows",
    "org.gnome.shell.extensions.amethystora-ui.search", "org.gnome.shell.extensions.amethystora-ui.emoji"]'
TILING=org.gnome.shell.extensions.amethystora-ui.tiling
# The tiling's settings a file may hold, each with its type and, for a number, the range its schema gives it,
# so that a file is checked before anything is set rather than half applied; test-setup.sh holds this to the
# schema. A step is a share of the screen or a width in pixels, so above 0; a workspace's colour is "" or #rrggbb.
# Never `enabled`, which is the layout, nor the window rules, a picture or a workspace's name or folder, which
# hold patterns, paths and text.
TILING_KEYS='{
    "window-gap": ["i", 0, 200], "horizontal-margin": ["i", 0, 400], "vertical-margin": ["i", 0, 400],
    "vertical-margin-bottom": ["i", 0, 400], "selection-border-size": ["i", 0, 100],
    "selection-border-radius-top": ["i", 0, 100], "selection-border-radius-bottom": ["i", 0, 100],
    "cycle-width-steps": ["ad", "steps"], "cycle-height-steps": ["ad", "steps"],
    "maximize-width-percent": ["d", 0.5, 1], "maximize-within-tiling": ["b"],
    "default-focus-mode": ["i", 0, 2], "open-window-position": ["i", 0, 5],
    "open-window-position-option-right": ["b"], "open-window-position-option-left": ["b"],
    "open-window-position-option-start": ["b"], "open-window-position-option-end": ["b"],
    "open-window-position-option-down": ["b"], "open-window-position-option-up": ["b"],
    "animation-time": ["d", 0, 2], "drift-speed": ["i", 1, 20], "drag-drift-speed": ["i", 1, 20],
    "minimap-scale": ["d", 0, 0.5], "minimap-shade-opacity": ["i", 0, 255],
    "edge-preview-enable": ["b"], "edge-preview-scale": ["d", 0.05, 0.5], "edge-preview-click-enable": ["b"],
    "edge-preview-timeout-enable": ["b"], "edge-preview-timeout": ["i", 100, 5000], "edge-preview-timeout-continual": ["b"],
    "gesture-enabled": ["b"], "gesture-horizontal-fingers": ["i", 0, 4], "gesture-workspace-fingers": ["i", 0, 4],
    "swipe-sensitivity": ["ad"], "swipe-friction": ["ad"],
    "show-focus-mode-icon": ["b"], "show-open-position-icon": ["b"], "default-show-top-bar": ["b"],
    "topbar-mouse-scroll-enable": ["b"], "window-switcher-preview-scale": ["d", 0.05, 0.5],
    "show-workspace-indicator": ["b"], "show-window-position-bar": ["b"], "only-scratch-in-overview": ["b"],
    "disable-scratch-in-overview": ["b"], "overview-ensure-viewport-animation": ["i", 0, 2],
    "use-default-background": ["b"], "workspace-colors": ["as", "colours"]
}'
# The pointer module's keys, checked the same way (a string key with the choices its schema gives it)
POINTER=org.gnome.shell.extensions.amethystora-ui.pointer
POINTER_KEYS='{"shake": ["s", ["grow", "beacon", "off"]], "dense": ["b"]}'
# The glass's keys: which glass, and Reduce transparency
GLASS=org.gnome.shell.extensions.amethystora-ui.glass
GLASS_KEYS='{"material": ["s", ["frost", "prism", "clear"]], "solid": ["b"]}'
# The motion's keys: how a window goes into the dock, and how workspaces change
MOTION=org.gnome.shell.extensions.amethystora-ui.motion
MOTION_KEYS='{"minimize": ["s", ["droplet", "shrink"]], "workspace-switch": ["s", ["depth", "slide"]]}'
# The top bar's workspaces: their names from their main app, and the saved sets in their menu. Never its two
# keybindings, which the keybindings part keeps, nor sets.json, which names this machine's screens.
WORKSPACES=org.gnome.shell.extensions.amethystora-ui.workspaces
WORKSPACES_KEYS='{"auto-names": ["b"], "sets": ["b"]}'
# The windows module's keys: snap layouts, the switcher, the Super card, the corners, show desktop, the gestures,
# places and dimming. Never snap-chooser, a keybinding the keybindings part keeps, nor places.json, which is the
# machine's own, made of its screens' connectors.
WINDOWS=org.gnome.shell.extensions.amethystora-ui.windows
WINDOWS_KEYS='{
    "snap": ["b"], "switcher": ["b"], "hold-super": ["b"], "hold-super-delay": ["i", 500, 3000],
    "corner-top-left": ["s", ["none", "overview", "desktop", "lock", "note", "notifications"]],
    "corner-top-right": ["s", ["none", "overview", "desktop", "lock", "note", "notifications"]],
    "corner-bottom-left": ["s", ["none", "overview", "desktop", "lock", "note", "notifications"]],
    "corner-bottom-right": ["s", ["none", "overview", "desktop", "lock", "note", "notifications"]],
    "show-desktop": ["b"], "gesture-pinch": ["b"], "gesture-spread": ["b"], "gesture-down": ["b"],
    "gesture-today": ["b"], "places": ["b"], "dim": ["b"]
}'
# The dock's keys: how it moves, what it holds and where it lives. Its folders by name, each two launcher IDs or more,
# and its stacks as special folders or folders under the home folder only: a folder elsewhere names this machine.
DOCK=org.gnome.shell.extensions.amethystora-ui.dock
DOCK_KEYS='{
    "magnify": ["s", ["off", "swell", "lift"]], "magnify-amount": ["d", 1.2, 2.2],
    "launch": ["s", ["halo", "hop", "breathe", "off"]], "indicator": ["s", ["bar", "dot", "glow"]],
    "recent": ["b"], "previews": ["b"], "edge": ["s", ["bottom", "left", "right"]],
    "screens": ["s", ["every", "primary"]], "autohide": ["s", ["off", "touch"]], "workspace-apps": ["b"],
    "folders": ["folders"], "stacks": ["as", "stacks"]
}'
# The live pill's keys: the pill, the privacy dots, the glow, quiet, quiet at night, the digest and its times
PILL=org.gnome.shell.extensions.amethystora-ui.pill
PILL_KEYS='{
    "live": ["b"], "privacy-dots": ["b"], "glow": ["b"], "quiet": ["b"], "quiet-night": ["b"],
    "digest": ["b"], "digest-times": ["as", "times"], "later": ["b"], "later-times": ["as", "times"], "whats-new": ["b"]
}'
# Quick settings' tiles: the order they come first in and the ones put away, each a tile's short name
QUICK=org.gnome.shell.extensions.amethystora-ui.quick
QUICK_KEYS='{"tile-order": ["as", "ids"], "tile-hidden": ["as", "ids"]}'
# A top bar on every screen, and over a fullscreen window
BARS=org.gnome.shell.extensions.amethystora-ui.bars
BARS_KEYS='{"every-screen": ["b"], "peek": ["b"]}'
# Today's tasks in the calendar menu. Never the weather, which sends the place chosen in Weather: a file someone
# shares must not turn that on.
TODAY=org.gnome.shell.extensions.amethystora-ui.today
TODAY_KEYS='{"tasks": ["b"], "getting-set": ["b"]}'
# GNOME's own rest reminders: which of its two kinds of break are on
BREAKS=org.gnome.desktop.break-reminders
BREAKS_KEYS='{"selected-breaks": ["as", "breaks"]}'
# What the search finds besides GNOME's own: each a switch. Never open, the search box's key, which the keybindings
# part keeps.
SEARCH=org.gnome.shell.extensions.amethystora-ui.search
SEARCH_KEYS='{
    "answers": ["b"], "settings": ["b"], "manual": ["b"], "windows": ["b"], "clipboard": ["b"], "agent": ["b"],
    "glance": ["b"]
}'
# The emoji picker's skin tone. Never emoji-picker, its key, which the keybindings part keeps.
EMOJI=org.gnome.shell.extensions.amethystora-ui.emoji
EMOJI_KEYS='{"skin-tone": ["s", ["none", "light", "medium-light", "medium", "medium-dark", "dark"]]}'
# Rounded corners on a laptop's own screen
BEZEL=org.gnome.shell.extensions.amethystora-ui.bezel
BEZEL_KEYS='{"round-corners": ["b"]}'
# Whether the desktop makes its own sounds (ame desktop sounds soft|off). Never theme-name: Settings points it at a
# theme it writes into the account's own folder for the alert sound, which another machine does not have.
SOUND=org.gnome.desktop.sound
SOUND_KEYS='{"event-sounds": ["b"]}'
# The look: the accent, Daylight and colours from the wallpaper, which are the account's files that the theme reads (set
# through their `ame desktop` commands), and an accent per workspace, the theme module's keys. Each value from its list, the
# accents' ids the twelve of ACCENTS in /usr/lib/amethystora/theme/lib.sh (20-tests.sh holds the two together).
THEME_UI=org.gnome.shell.extensions.amethystora-ui.theme
LOOK_ACCENTS='["amethyst", "iris", "sky", "lagoon", "jade", "moss", "amber", "ember", "coral", "rose", "orchid", "slate", "theme"]'
LOOK_KEYS='{
    "accent": ["s", '"${LOOK_ACCENTS}"'], "daylight": ["s", ["on", "off"]], "colours": ["s", ["vivid", "soft", "mono", "off"]],
    "accent-per-workspace": ["b"], "workspace-accents": ["as", "accents"]
}'
# The first start's three switches: the reveal at login, the tips, and the app grid's row of the apps used most. Never
# the tips' state file or the app grid's folders, which are GNOME's and may name another machine's apps.
TRANSITIONS=org.gnome.shell.extensions.amethystora-transitions
TRANSITIONS_KEYS='{"reveal": ["b"]}'
HINTS=org.gnome.shell.extensions.amethystora-ui.hints
HINTS_KEYS='{"enabled": ["b"]}'
APPGRID=org.gnome.shell.extensions.amethystora-ui.appgrid
APPGRID_KEYS='{"recent": ["b"]}'
# The battery explained and the busy app's chip (Power you can see)
POWER=org.gnome.shell.extensions.amethystora-ui.power
POWER_KEYS='{"battery-details": ["b"], "busy-app": ["b"]}'
# The shelf, by how it opens; never what it holds, which is never written anywhere
SHELF=org.gnome.shell.extensions.amethystora-ui.shelf
SHELF_KEYS='{"shelf": ["s", ["off", "edge", "shake"]]}'
# Desks, on or off and whether they learn; never the desks themselves, which name this machine's screens by serial number
DESKS=org.gnome.shell.extensions.amethystora-ui.desks
DESKS_KEYS='{"desks": ["b"], "desks-learn": ["b"]}'
# Focus profiles: the two triggers and what each of Work, Games and Sleep does. Never profile, ends and off-at (what is on
# now) or a profile's set (a saved set is this machine's state). The apps let through are launchers by their ID.
FOCUS=org.gnome.shell.extensions.amethystora-ui.focus
FOCUS_KEYS='{
    "trigger-games": ["b"], "trigger-sleep": ["b"],
    "work-banners": ["s", ["shown", "apps", "held"]], "work-apps": ["as", "launchers"], "work-sounds": ["b"],
    "work-dock": ["s", ["as-set", "touch"]], "work-lighter": ["b"], "work-night-light": ["s", ["as-set", "paused", "warmest"]],
    "work-power": ["s", ["as-set", "performance", "power-saver"]], "work-accent": ["s", '"${LOOK_ACCENTS}"'],
    "work-wallpaper": ["s", ["as-set", "night"]], "work-grey": ["b"],
    "games-banners": ["s", ["shown", "apps", "held"]], "games-apps": ["as", "launchers"], "games-sounds": ["b"],
    "games-dock": ["s", ["as-set", "touch"]], "games-lighter": ["b"], "games-night-light": ["s", ["as-set", "paused", "warmest"]],
    "games-power": ["s", ["as-set", "performance", "power-saver"]], "games-accent": ["s", '"${LOOK_ACCENTS}"'],
    "games-wallpaper": ["s", ["as-set", "night"]], "games-grey": ["b"],
    "sleep-banners": ["s", ["shown", "apps", "held"]], "sleep-apps": ["as", "launchers"], "sleep-sounds": ["b"],
    "sleep-dock": ["s", ["as-set", "touch"]], "sleep-lighter": ["b"], "sleep-night-light": ["s", ["as-set", "paused", "warmest"]],
    "sleep-power": ["s", ["as-set", "performance", "power-saver"]], "sleep-accent": ["s", '"${LOOK_ACCENTS}"'],
    "sleep-wallpaper": ["s", ["as-set", "night"]], "sleep-grey": ["b"]
}'
# Seeing and reading: the colour filter and its strength, the reading ruler and reading aloud. Never filter-on or
# ruler-shown (whether they are drawn this moment) or the shortcuts, which are the image's.
ACCESS=org.gnome.shell.extensions.amethystora-ui.access
ACCESS_KEYS='{
    "filter": ["s", ["none", "protan", "deutan", "tritan", "grey"]], "filter-strength": ["i", 25, 100],
    "ruler": ["s", ["off", "band", "dim", "underline"]], "read-aloud": ["b"], "read-aloud-speed": ["s", ["0.75", "1", "1.5", "2"]]
}'
# Touch and pen: touch mode and the pen's tools, by name. Never the shortcut, or the pens' buttons, which GNOME keeps per pen.
TOUCH=org.gnome.shell.extensions.amethystora-ui.touch
TOUCH_KEYS='{"touch-mode": ["s", ["off", "follow", "on"]], "pen-ring": ["s", ["off", "ring", "strip"]],
    "pen-ring-tools": ["as", "pen-tools"]}'
# Present mode (offered), the pointer while presenting and the question when a screen is plugged in. Never scribble, the
# keybinding, which is the image's
PRESENT=org.gnome.shell.extensions.amethystora-ui.present
PRESENT_KEYS='{"enabled": ["b"], "pointer-mark": ["s", ["halo", "torch", "none"]], "ask-on-screen": ["b"]}'
# The thumbnail after a screenshot and pinning pictures on top. Never tool-settings, the drawing tools' last colours
SCREENSHOT=org.gnome.shell.extensions.amethystora-ui.screenshot
SCREENSHOT_KEYS='{"capture-thumbnail": ["b"], "capture-pin": ["b"]}'
# Widgets on the desktop: the switch only; the widgets themselves are commands, which a setup file never carries
DESKWIDGETS=org.gnome.shell.extensions.amethystora-ui.deskwidgets
DESKWIDGETS_KEYS='{"enabled": ["b"]}'
# What a value of each kind has to be, for the check and for reading an old file's gaps
TILING_JQ="$(
    cat <<'EOF'
def valid($spec): $spec as [$t, $a, $b] |
    if $t == "b" then type == "boolean"
    elif $t == "i" then type == "number" and . == floor and . >= $a and . <= $b
    elif $t == "d" then type == "number" and . >= $a and . <= $b
    elif $t == "ad" then type == "array" and all(.[]; type == "number" and ($a != "steps" or . > 0))
    elif $t == "as" and $a == "colours" then type == "array" and all(.[]; type == "string" and test("^(#[0-9A-Fa-f]{6})?$"))
    elif $t == "as" and $a == "stacks" then type == "array" and length <= 12 and all(.[]; type == "string" and
        (test("^xdg:(DESKTOP|DOCUMENTS|DOWNLOAD|MUSIC|PICTURES|PUBLICSHARE|TEMPLATES|VIDEOS)$") or
         (test("^~/[^'\\\\]+$") and (split("/") | index("..") | not))))
    elif $t == "as" and $a == "times" then type == "array" and length >= 1 and length <= 6 and (unique | length) == length
        and all(.[]; type == "string" and test("^([01][0-9]|2[0-3]):[0-5][0-9]$"))
    elif $t == "as" and $a == "ids" then type == "array" and length <= 64 and (unique | length) == length
        and all(.[]; type == "string" and test("^[a-z0-9-]{1,40}$"))
    elif $t == "as" and $a == "breaks" then type == "array" and (unique | length) == length
        and all(.[]; type == "string" and IN("eyesight", "movement"))
    elif $t == "as" and $a == "accents" then type == "array" and length >= 1 and length <= 36
        and all(.[]; type == "string" and test("^(amethyst|iris|sky|lagoon|jade|moss|amber|ember|coral|rose|orchid|slate|theme)$"))
    elif $t == "folders" then type == "object" and all(to_entries[];
        (.key | length >= 1 and length <= 40 and (test("[[:cntrl:]]") | not))
        and (.value | type == "array" and length >= 2 and all(.[]; type == "string" and test("^[A-Za-z0-9._+-]+[.]desktop$"))))
    elif $t == "as" and $a == "launchers" then type == "array" and length <= 32 and (unique | length) == length
        and all(.[]; type == "string" and test("^[A-Za-z0-9._+-]+[.]desktop$"))
    elif $t == "as" and $a == "pen-tools" then type == "array" and length >= 1 and length <= 6 and (unique | length) == length
        and all(.[]; type == "string" and IN("scribble", "area", "note", "text", "right-click", "back"))
    elif $t == "s" then type == "string" and IN($a[])
    else false end;
def wanted($spec): $spec as [$t, $a, $b] |
    if $t == "b" then "true or false"
    elif $t == "s" then "one of \($a | join(", "))"
    elif $t == "i" then "a whole number from \($a) to \($b)"
    elif $t == "d" then "a number from \($a) to \($b)"
    elif $a == "steps" then "a list of numbers above 0"
    elif $a == "stacks" then "a list of twelve folders at most, each xdg:NAME or ~/PATH"
    elif $a == "times" then "a list of one to six different times, each HH:MM"
    elif $a == "ids" then "a list of different tiles' names, each lower-case letters, digits and hyphens"
    elif $a == "breaks" then "a list of eyesight and movement, each once"
    elif $a == "launchers" then "a list of 32 different launcher IDs at most, each NAME.desktop"
    elif $a == "pen-tools" then "a list of one to six of scribble, area, note, text, right-click and back, each once"
    elif $a == "accents" then "a list of one to 36 accents, each theme or one of the twelve accents' names"
    elif $t == "folders" then "folders by name (1 to 40 characters), each with two launcher IDs or more"
    elif $t == "ad" then "a list of numbers"
    else "a list of colours, each \"\" or one such as \"#314e6c\"" end;
# A file from before the tiling replaced PaperWM: its gaps are the tiling's, unless the file has a tiling of its
# own, and one the tiling cannot take (PaperWM took up to 1000 pixels) is left out rather than the file refused
def from_paperwm:
    if (.settings | type) == "object" and (.settings | has("tiling") | not) and (.settings.paperwm | type) == "object" then
        (.settings.paperwm | with_entries(select(.key | IN("window-gap", "horizontal-margin", "vertical-margin",
            "vertical-margin-bottom")) | select($tiling[.key] as $spec | .value | valid($spec)))) as $gaps
        | if $gaps == {} then . else .settings.tiling = $gaps end
    else . end;
EOF
)"

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    sed -n 's/^#   amethystora-setup /ame setup /p' "$0"
}

interactive() { [[ -t 0 && -t 1 ]]; }

# gum asks, as it does everywhere in the image; read is what is there if it is not
confirm() {
    local answer
    if command -v gum >/dev/null 2>&1; then
        gum confirm --default="$2" "$1"
        return
    fi
    read -r -p "$1 [y/N] " answer || return 1
    [[ "${answer}" =~ ^[Yy] ]]
}

# --- The format -----------------------------------------------------------------------------------

# Each line it prints is a reason a file is not a setup file. Names are checked as well as keys: a name
# that starts with "-" would be read as an option by the command it is handed to.
CHECK="$(
    cat <<'EOF'
def name: type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+@-]*$");
def accels: type == "array" and all(.[]; type == "string" and test("^(<[A-Za-z0-9_]+>)*[A-Za-z0-9_]*$"));
def at($key; f): if has($key) then .[$key] | f else empty end;
# A $name parameter is also a filter called name, so this one must not be called keys
def only($allowed; $where):
    if type == "object" then (keys - $allowed)[] | "\($where)\(.) is not part of a setup file"
    else "\($where) is not an object" end;
# Each entry of a list that is not what f accepts, named
def each($where; f; $what):
    if type != "array" then "\($where) is not a list" else .[] | select(f | not) | "\($where): \(tojson) is not \($what)" end;
if type != "object" then "it is not a JSON object" else
    only(["version", "image", "flatpaks", "brew", "containers", "extensions", "theme", "settings"]; ""),
    (if .version == 1 then empty else "its version is \(.version | tojson), and this reads version 1" end),
    at("image"; only(["name", "stream"]; "image."),
        (if type == "object" and (.name | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
            and (.stream | type == "string" and test("^[a-z0-9][a-z0-9._-]*$")) then empty
         else "image has a name and a stream, such as amethystora and stable" end)),
    at("flatpaks"; only(["system", "user"]; "flatpaks."),
        (if type == "object" then ("system", "user") as $i | at($i; each("flatpaks.\($i)";
            type == "object" and keys == ["app", "origin"] and (.origin | name)
                and (.app | type == "string" and test("^[A-Za-z][A-Za-z0-9_-]*([.][A-Za-z0-9_-]+)+$"));
            "{\"app\": ID, \"origin\": REMOTE}")) else empty end)),
    at("brew"; only(["taps", "formulae", "casks"]; "brew."),
        (if type == "object" then ("taps", "formulae", "casks") as $k | at($k; each("brew.\($k)";
            type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._+@-]*(/[A-Za-z0-9][A-Za-z0-9._+@-]*){0,2}$");
            "one of Homebrew's names")) else empty end),
        # A formula or cask named with its tap is installed from that repository, Ruby and all, so the tap is
        # listed, and shown with its warning, as every other is
        (if type == "object" then (.taps | if type == "array" then . else [] end) as $taps
            | ("formulae", "casks") as $k | at($k; if type == "array" then .[] | strings
                | select(split("/") | length == 3 and (.[:2] | join("/") | IN($taps[]) | not))
                | "brew.\($k): \(tojson) comes from a tap that brew.taps does not list" else empty end)
         else empty end)),
    at("containers"; if type != "array" then "containers is not a list" else .[] |
        if type != "object" then "containers: \(tojson) is not a container" else
            only(["name", "template", "init", "packages"]; "containers[]."),
            (if (.name | type == "string" and test("^[a-z0-9][a-z0-9_-]{0,31}$")) and (.template | name) then empty
             else "containers: \(tojson) has no name and template" end),
            at("init"; if type == "boolean" then empty else "a container's init is true or false" end),
            at("packages"; each("the packages of a container";
                type == "string" and test("^[A-Za-z0-9@_+][A-Za-z0-9@._+:=~-]*$"); "a package's name"))
        end end),
    at("extensions"; each("extensions"; name; "an extension's id")),
    at("theme"; if type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$") then empty else "theme is not a theme's name" end),
    at("settings"; only(["layout", "favorites", "keybindings", "tiling", "paperwm", "pointer", "glass", "motion", "workspaces",
            "windows", "dock", "pill", "quick", "bars", "today", "breaks", "search", "emoji", "bezel", "sound", "look", "transitions",
            "hints", "appgrid", "focus", "power", "access", "touch", "present",
            "screenshot", "deskwidgets", "shelf", "desks"]; "settings."),
        (if type == "object" then
            at("layout"; if IN("tiling", "classic") then empty else "settings.layout is tiling or classic" end),
            at("favorites"; each("settings.favorites";
                type == "string" and test("^[A-Za-z0-9_][A-Za-z0-9._+@-]*[.]desktop$"); "an app's .desktop file")),
            # PaperWM's keybindings, which a file from before the tiling replaced it may hold, are tolerated: the diff
            # lists them as keys this machine does not have, and the rest of the file applies
            at("keybindings"; only($schemas + ["custom", "org.gnome.shell.extensions.paperwm.keybindings"]; "settings.keybindings."),
                (if type == "object" then to_entries[] | .key as $s | select($s | IN($schemas[], "custom")) | .value |
                    if type != "object" then "settings.keybindings.\($s) is not an object"
                    elif $s == "custom" then to_entries[] |
                        if (.key | test("^custom[0-9]+$")) and (.value | accels and length <= 1) then empty
                        else "settings.keybindings.custom.\(.key) is one of the image's custom keybindings, set to a list of one key or none" end
                    else to_entries[] |
                        if (.key | test("^[a-z0-9][a-z0-9-]*$")) and .key != "custom-keybindings" and (.value | accels)
                            # The windows module's, the search's and the emoji picker's schemas hold one keybinding
                            # each among their settings
                            and ($s != "org.gnome.shell.extensions.amethystora-ui.windows" or .key == "snap-chooser")
                            and ($s != "org.gnome.shell.extensions.amethystora-ui.search" or .key == "open")
                            and ($s != "org.gnome.shell.extensions.amethystora-ui.emoji" or .key == "emoji-picker") then empty
                        else "settings.keybindings.\($s).\(.key) is not a keybinding set to a list of keys" end
                    end else empty end)),
            at("tiling"; only($tiling | keys; "settings.tiling."),
                (if type == "object" then to_entries[] | select(.key | IN($tiling | keys[])) | $tiling[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.tiling.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("pointer"; only($pointer | keys; "settings.pointer."),
                (if type == "object" then to_entries[] | select(.key | IN($pointer | keys[])) | $pointer[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.pointer.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("glass"; only($glass | keys; "settings.glass."),
                (if type == "object" then to_entries[] | select(.key | IN($glass | keys[])) | $glass[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.glass.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("motion"; only($motion | keys; "settings.motion."),
                (if type == "object" then to_entries[] | select(.key | IN($motion | keys[])) | $motion[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.motion.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("workspaces"; only($workspaces | keys; "settings.workspaces."),
                (if type == "object" then to_entries[] | select(.key | IN($workspaces | keys[])) | $workspaces[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.workspaces.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("windows"; only($windows | keys; "settings.windows."),
                (if type == "object" then to_entries[] | select(.key | IN($windows | keys[])) | $windows[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.windows.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("dock"; only($dock | keys; "settings.dock."),
                (if type == "object" then to_entries[] | select(.key | IN($dock | keys[])) | $dock[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.dock.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("pill"; only($pill | keys; "settings.pill."),
                (if type == "object" then to_entries[] | select(.key | IN($pill | keys[])) | $pill[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.pill.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("quick"; only($quick | keys; "settings.quick."),
                (if type == "object" then to_entries[] | select(.key | IN($quick | keys[])) | $quick[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.quick.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("bars"; only($bars | keys; "settings.bars."),
                (if type == "object" then to_entries[] | select(.key | IN($bars | keys[])) | $bars[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.bars.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("today"; only($today | keys; "settings.today."),
                (if type == "object" then to_entries[] | select(.key | IN($today | keys[])) | $today[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.today.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("breaks"; only($breaks | keys; "settings.breaks."),
                (if type == "object" then to_entries[] | select(.key | IN($breaks | keys[])) | $breaks[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.breaks.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("search"; only($search | keys; "settings.search."),
                (if type == "object" then to_entries[] | select(.key | IN($search | keys[])) | $search[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.search.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("emoji"; only($emoji | keys; "settings.emoji."),
                (if type == "object" then to_entries[] | select(.key | IN($emoji | keys[])) | $emoji[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.emoji.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("bezel"; only($bezel | keys; "settings.bezel."),
                (if type == "object" then to_entries[] | select(.key | IN($bezel | keys[])) | $bezel[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.bezel.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("sound"; only($sound | keys; "settings.sound."),
                (if type == "object" then to_entries[] | select(.key | IN($sound | keys[])) | $sound[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.sound.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("look"; only($look | keys; "settings.look."),
                (if type == "object" then to_entries[] | select(.key | IN($look | keys[])) | $look[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.look.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("transitions"; only($transitions | keys; "settings.transitions."),
                (if type == "object" then to_entries[] | select(.key | IN($transitions | keys[])) | $transitions[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.transitions.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("hints"; only($hints | keys; "settings.hints."),
                (if type == "object" then to_entries[] | select(.key | IN($hints | keys[])) | $hints[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.hints.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("appgrid"; only($appgrid | keys; "settings.appgrid."),
                (if type == "object" then to_entries[] | select(.key | IN($appgrid | keys[])) | $appgrid[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.appgrid.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("power"; only($power | keys; "settings.power."),
                (if type == "object" then to_entries[] | select(.key | IN($power | keys[])) | $power[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.power.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("focus"; only($focus | keys; "settings.focus."),
                (if type == "object" then to_entries[] | select(.key | IN($focus | keys[])) | $focus[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.focus.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("access"; only($access | keys; "settings.access."),
                (if type == "object" then to_entries[] | select(.key | IN($access | keys[])) | $access[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.access.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("touch"; only($touch | keys; "settings.touch."),
                (if type == "object" then to_entries[] | select(.key | IN($touch | keys[])) | $touch[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.touch.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("present"; only($present | keys; "settings.present."),
                (if type == "object" then to_entries[] | select(.key | IN($present | keys[])) | $present[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.present.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("screenshot"; only($screenshot | keys; "settings.screenshot."),
                (if type == "object" then to_entries[] | select(.key | IN($screenshot | keys[])) | $screenshot[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.screenshot.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("deskwidgets"; only($deskwidgets | keys; "settings.deskwidgets."),
                (if type == "object" then to_entries[] | select(.key | IN($deskwidgets | keys[])) | $deskwidgets[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.deskwidgets.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("shelf"; only($shelf | keys; "settings.shelf."),
                (if type == "object" then to_entries[] | select(.key | IN($shelf | keys[])) | $shelf[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.shelf.\(.key) is \(wanted($spec))" end
                 else empty end)),
            at("desks"; only($desks | keys; "settings.desks."),
                (if type == "object" then to_entries[] | select(.key | IN($desks | keys[])) | $desks[.key] as $spec
                    | if .value | valid($spec) then empty else "settings.desks.\(.key) is \(wanted($spec))" end
                 else empty end))
        else empty end))
end
EOF
)"

# Exits, saying why, unless the JSON on stdin is a setup file
check() {
    local problems
    problems="$(jq -r --argjson schemas "${KEY_SCHEMAS}" --argjson tiling "${TILING_KEYS}" --argjson pointer "${POINTER_KEYS}" \
        --argjson glass "${GLASS_KEYS}" --argjson windows "${WINDOWS_KEYS}" --argjson dock "${DOCK_KEYS}" \
        --argjson motion "${MOTION_KEYS}" --argjson workspaces "${WORKSPACES_KEYS}" --argjson pill "${PILL_KEYS}" \
        --argjson quick "${QUICK_KEYS}" \
        --argjson bars "${BARS_KEYS}" --argjson today "${TODAY_KEYS}" --argjson breaks "${BREAKS_KEYS}" \
        --argjson search "${SEARCH_KEYS}" --argjson emoji "${EMOJI_KEYS}" \
        --argjson bezel "${BEZEL_KEYS}" --argjson sound "${SOUND_KEYS}" \
        --argjson look "${LOOK_KEYS}" \
        --argjson transitions "${TRANSITIONS_KEYS}" --argjson hints "${HINTS_KEYS}" --argjson appgrid "${APPGRID_KEYS}" \
        --argjson focus "${FOCUS_KEYS}" --argjson power "${POWER_KEYS}" \
        --argjson access "${ACCESS_KEYS}" --argjson touch "${TOUCH_KEYS}" \
        --argjson present "${PRESENT_KEYS}" --argjson screenshot "${SCREENSHOT_KEYS}" \
        --argjson deskwidgets "${DESKWIDGETS_KEYS}" \
        --argjson shelf "${SHELF_KEYS}" --argjson desks "${DESKS_KEYS}" \
        "${TILING_JQ} ${CHECK}" 2>&1)" ||
        die "$1 is not JSON."
    [[ -z "${problems}" ]] ||
        die "$1 is not a setup file this version of Amethystora reads:"$'\n'"$(sed 's/^/  /' <<<"${problems}")"
}

load() {
    [[ -f "$1" ]] || die "There is no setup file at $1 yet: ame setup save writes one."
    check "$1" <"$1"
}

# This machine's setup as the file has it: the manifest's, less the machine, addresses and scripts, with
# every list sorted, so that a file kept in git changes only where the setup does
TO_SETUP="$(
    cat <<'EOF'
{
    version: 1,
    image: {name: .image.name, stream: .image.stream},
    flatpaks: {system: (.flatpaks.system // [] | sort_by(.app)), user: (.flatpaks.user // [] | sort_by(.app))},
    brew: (.brew // {} | {taps: (.taps // []), formulae: (.formulae // []), casks: (.casks // [])}),
    containers: (.containers // [] | map({name, template, init: (.init == true), packages: (.packages // [] | sort)})
        | sort_by(.name)),
    extensions: (.extensions // [] | sort),
    theme: .theme,
    settings: .settings
}
| if .image.name == null or .image.stream == null then del(.image) else . end
| if (.theme // "") == "" then del(.theme) else . end
| if .settings == null then del(.settings) else . end
EOF
)"

machine() {
    /usr/libexec/amethystora-setup-manifest | jq "${TO_SETUP}"
}

# --- What the machine has -----------------------------------------------------------------------

# A value as GSettings prints it, as JSON: lists of strings or numbers, strings, numbers, switches and the dock's
# folders. A string may hold either quote (GSettings then writes it in the other), so text with a quote in it is read
# as GVariant text is written, by python, the types GVariant writes before a value left out. A number is written as
# JSON writes it, 0.15 where GSettings prints 0.14999999999999999.
as_json() {
    local text
    text="$(cat)"
    if [[ "${text}" != *[\'\"]* ]]; then
        sed -E "s/^@[^ ]+ //" <<<"${text}" | jq -c 'walk(if type == "number" then . + 0 else . end)' 2>/dev/null
        return
    fi
    python3 -I -c '
import ast, json, sys
QUOTES, BACKSLASH = (chr(34), chr(39)), chr(92)
TYPES = {"byte", "int16", "uint16", "int32", "uint32", "int64", "uint64", "handle", "double", "objectpath",
         "signature", "string", "boolean"}
WORDS = {"true": "True", "false": "False", "nothing": "None"}
text, out, i = sys.stdin.read().strip(), [], 0
while i < len(text):
    c = text[i]
    if c in QUOTES:
        j = i + 1
        while j < len(text) and text[j] != c:
            j += 2 if text[j] == BACKSLASH else 1
        out.append(text[i:j + 1])
        i = j + 1
    elif c == "@":
        while i < len(text) and not text[i].isspace():
            i += 1
    elif c.isalpha():
        j = i
        while j < len(text) and (text[j].isalnum() or text[j] == "_"):
            j += 1
        word = text[i:j]
        out.append("" if word in TYPES else WORDS.get(word, word))
        i = j
    else:
        out.append(c)
        i += 1
print(json.dumps(ast.literal_eval("".join(out))))
' <<<"${text}" 2>/dev/null | jq -c 'walk(if type == "number" then . + 0 else . end)' 2>/dev/null
}

# A list of names as GSettings takes it: the format keeps quotes out of every one, so @sh quotes each
# the way GVariant does
as_variant() { jq -r 'if length == 0 then "@as []" else "[" + (map(@sh) | join(", ")) + "]" end'; }

# The value each setting the file (its JSON in $1) names has here now, in the file's shape, or null where
# this machine has no such setting. The manifest leaves out a setting that is the image's, so it has to be read.
current() {
    local schema key value
    {
        if jq -e '.settings // {} | has("favorites")' <<<"$1" >/dev/null; then
            value="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null | as_json)"
            jq -nc --argjson v "${value:-null}" '{favorites: $v}'
        fi
        while IFS=$'\t' read -r schema key; do
            value=""
            if [[ "${schema}" == custom ]]; then
                # The image's own only: it sets their command in its dconf database
                if [[ -n "$(dconf read -d "${CUSTOM}/${key}/command" 2>/dev/null)" ]]; then
                    value="$(gsettings get "${RELOCATABLE}:${CUSTOM}/${key}/" binding 2>/dev/null | as_json |
                        jq -c 'if . == "" then [] else [.] end')"
                fi
            elif [[ "$(gsettings range "${schema}" "${key}" 2>/dev/null)" == "type as" ]]; then
                value="$(gsettings get "${schema}" "${key}" 2>/dev/null | as_json)"
            fi
            jq -nc --arg s "${schema}" --arg k "${key}" --argjson v "${value:-null}" '{keybindings: {($s): {($k): $v}}}'
        done < <(jq -r '.settings.keybindings // {} | to_entries[] | .key as $s | .value | keys[] | [$s, .] | @tsv' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${TILING}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{tiling: {($k): $v}}'
        done < <(jq -r '.settings.tiling // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${POINTER}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{pointer: {($k): $v}}'
        done < <(jq -r '.settings.pointer // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${GLASS}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{glass: {($k): $v}}'
        done < <(jq -r '.settings.glass // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${MOTION}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{motion: {($k): $v}}'
        done < <(jq -r '.settings.motion // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${WORKSPACES}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{workspaces: {($k): $v}}'
        done < <(jq -r '.settings.workspaces // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${WINDOWS}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{windows: {($k): $v}}'
        done < <(jq -r '.settings.windows // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${DOCK}" "${key}" 2>/dev/null | as_json)"
            # A stack outside the home folder names this machine: a file never holds one, and never takes it away
            [[ "${key}" == stacks && -n "${value}" ]] && value="$(jq -c 'map(select(test("^(xdg:|~/)")))' <<<"${value}")"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{dock: {($k): $v}}'
        done < <(jq -r '.settings.dock // {} | keys[]' <<<"$1")
        while read -r key; do
            value="$(gsettings get "${PILL}" "${key}" 2>/dev/null | as_json)"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{pill: {($k): $v}}'
        done < <(jq -r '.settings.pill // {} | keys[]' <<<"$1")
        for area in quick bars today breaks search emoji bezel sound transitions hints appgrid focus power access touch \
            present screenshot deskwidgets shelf desks; do
            case "${area}" in
                quick) schema="${QUICK}" ;;
                bars) schema="${BARS}" ;;
                today) schema="${TODAY}" ;;
                breaks) schema="${BREAKS}" ;;
                search) schema="${SEARCH}" ;;
                emoji) schema="${EMOJI}" ;;
                bezel) schema="${BEZEL}" ;;
                sound) schema="${SOUND}" ;;
                transitions) schema="${TRANSITIONS}" ;;
                hints) schema="${HINTS}" ;;
                appgrid) schema="${APPGRID}" ;;
                power) schema="${POWER}" ;;
                focus) schema="${FOCUS}" ;;
                access) schema="${ACCESS}" ;;
                touch) schema="${TOUCH}" ;;
                present) schema="${PRESENT}" ;;
                screenshot) schema="${SCREENSHOT}" ;;
                deskwidgets) schema="${DESKWIDGETS}" ;;
                shelf) schema="${SHELF}" ;;
                desks) schema="${DESKS}" ;;
            esac
            while read -r key; do
                value="$(gsettings get "${schema}" "${key}" 2>/dev/null | as_json)"
                jq -nc --arg a "${area}" --arg k "${key}" --argjson v "${value:-null}" '{($a): {($k): $v}}'
            done < <(jq -r --arg a "${area}" '.settings[$a] // {} | keys[]' <<<"$1")
        done
        # The look: the account's files as the theme reads them (look_value), and the theme module's keys
        while read -r key; do
            value="$(look_value "${key}")"
            jq -nc --arg k "${key}" --argjson v "${value:-null}" '{look: {($k): $v}}'
        done < <(jq -r '.settings.look // {} | keys[]' <<<"$1")
    } | jq -sc 'reduce .[] as $x ({favorites: null, keybindings: {}, tiling: {}, pointer: {}, glass: {}, motion: {},
        workspaces: {}, windows: {}, dock: {}, pill: {}, quick: {}, bars: {}, today: {}, breaks: {}, search: {}, emoji: {},
        bezel: {}, sound: {}, look: {}, transitions: {}, hints: {}, appgrid: {}, focus: {}, power: {}, access: {},
        touch: {}, present: {},
        screenshot: {}, deskwidgets: {}, shelf: {}, desks: {}};
        . * $x)'
}

# A setting of the look as this machine has it, as JSON: the accent (theme for the theme's own), Daylight (on unless the
# account turned it off), colours from the wallpaper (off unless chosen), and the theme module's two keys
look_value() {
    local config="${XDG_CONFIG_HOME:-${HOME}/.config}/amethystora" value
    case "$1" in
        accent)
            # What is in force, as the theme reads it: the account's choice, else its image's
            value="$(source /usr/lib/amethystora/theme/lib.sh && account_accent)"
            jq -nc --arg v "${value}" --argjson ids "${LOOK_ACCENTS}" 'if $v | IN($ids[]) then $v else "theme" end'
            ;;
        daylight)
            if [[ "$(head -n1 "${config}/daylight" 2>/dev/null || true)" == off ]]; then echo '"off"'; else echo '"on"'; fi
            ;;
        colours)
            value="$(source /usr/lib/amethystora/theme/lib.sh && colours_way)"
            jq -nc --arg v "${value}" 'if $v | IN("vivid", "soft", "mono") then $v else "off" end'
            ;;
        accent-per-workspace | workspace-accents) gsettings get "${THEME_UI}" "$1" 2>/dev/null | as_json ;;
    esac
}

# Where this machine can install from, and what it can turn on
abilities() {
    local extensions="${XDG_DATA_HOME:-${HOME}/.local/share}/gnome-shell/extensions"
    jq -nc \
        --argjson system "$(flatpak remotes --system --columns=name 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson user "$(flatpak remotes --user --columns=name 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson templates "$(amethystora-pkg templates list --json 2>/dev/null | jq -c 'map(.name)' 2>/dev/null || echo '[]')" \
        --argjson aur "$(find /usr/share/amethystora/pkg/aur/templates -name '*.json' -printf '%f\n' 2>/dev/null |
            sed 's/\.json$//' | jq -R . | jq -sc .)" \
        --argjson themes "$(amethystora-theme list 2>/dev/null | sed 's/^[*] /  /' | awk '{ print $1 }' | jq -R . | jq -sc .)" \
        --argjson extensions "$(find /usr/share/gnome-shell/extensions "${extensions}" -mindepth 1 -maxdepth 1 \
            -type d -printf '%f\n' 2>/dev/null | jq -R . | jq -sc .)" \
        --argjson brew "$([[ -x "${BREW}" ]] && echo true || echo false)" \
        '{remotes: {system: $system, user: $user}, templates: $templates, aur_templates: $aur, themes: $themes,
          extensions: $extensions, brew: $brew}'
}

# --- What differs ---------------------------------------------------------------------------------

# Every difference between the file and the machine: something to add, something to set as the file
# has it, or something the machine has that the file does not ("remove": uninstall, turn off, or put
# back to the image's), each with ok false and a reason when this machine cannot do it
CHANGES="$(
    cat <<'EOF'
def apps($x): [$x.flatpaks.system[]?, $x.flatpaks.user[]?] | map(.app);
def brew($x; $k): $x.brew[$k] // [];
($file.settings // {}) as $fs
| ($here.settings // {}) as $hs
| ($here.containers // [] | map(.name)) as $have
| ($file.containers // [] | map(.name)) as $want
| [
    ($file.image // empty | select("\(.name):\(.stream)" != "\($here.image.name):\($here.image.stream)")
        | {area: "image", action: "set", name, stream, to: "\(.name):\(.stream)",
           from: "\($here.image.name // "?"):\($here.image.stream // "?")"}),
    # An app installed in either installation counts, whichever the file has it in
    (("system", "user") as $i | $file.flatpaks[$i][]? | select(.app | IN(apps($here)[]) | not)
        | {area: "flatpak", action: "add", installation: $i, app, origin}
        + if .origin | IN($can.remotes[$i][]) then {} else {ok: false, why: "this machine has no \($i) remote called \(.origin)"} end),
    (("system", "user") as $i | $here.flatpaks[$i][]? | select(.app | IN(apps($file)[]) | not)
        | {area: "flatpak", action: "remove", installation: $i, app}),
    ((["tap", "taps"], ["formula", "formulae"], ["cask", "casks"]) as [$area, $k]
        | ((brew($file; $k) - brew($here; $k))[] | {area: $area, action: "add", name: .}
            + if $can.brew then {} else {ok: false, why: "Homebrew is not set up here"} end),
          ((brew($here; $k) - brew($file; $k))[] | {area: $area, action: "remove", name: .})),
    ($file.containers[]? | select(.name | IN($have[]) | not)
        | {area: "container", action: "add", name, template, init: (.init // false), packages: (.packages // [])}
        + if .template | IN($can.templates[]) then {}
          elif .template | IN($can.aur_templates[]) then {ok: false, why: "it is made from the AUR, which is off here: ame apps aur turns it on"}
          else {ok: false, why: "this machine has no template called \(.template)"} end),
    ($here.containers[]? | select(.name | IN($want[]) | not) | {area: "container", action: "remove", name}),
    ($file.containers[]? as $c | $here.containers[]? | select(.name == $c.name)
        | ($c.packages // []) - (.packages // []) | select(length > 0)
        | {area: "packages", action: "add", container: $c.name, packages: .}),
    ((($file.extensions // []) - ($here.extensions // []))[] | {area: "extension", action: "add", uuid: .}
        + if IN($can.extensions[]) then {} else {ok: false, why: "it is not installed here: Extension Manager finds it"} end),
    ((($here.extensions // []) - ($file.extensions // []))[] | {area: "extension", action: "remove", uuid: .}),
    ($file.theme // empty | select(. != $here.theme) | {area: "theme", action: "set", to: ., from: $here.theme}
        + if IN($can.themes[]) then {} else {ok: false, why: "there is no theme called \(.) here"} end),
    ($fs.layout // empty | select(. != $hs.layout) | {area: "layout", action: "set", to: ., from: $hs.layout}),
    (if $fs | has("favorites") then
        select($fs.favorites != $now.favorites) | {area: "favorites", action: "set", to: $fs.favorites, from: $now.favorites}
     elif $hs | has("favorites") then {area: "favorites", action: "remove", from: $hs.favorites}
     else empty end),
    ($fs.keybindings // {} | to_entries[] | .key as $s | .value | to_entries[] | .key as $k | $now.keybindings[$s][$k] as $v
        | select(.value != $v) | {area: "keybinding", action: "set", schema: $s, key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such keybinding"} else {} end),
    ($hs.keybindings // {} | to_entries[] | .key as $s | .value | to_entries[] | .key as $k
        | select($fs.keybindings[$s] // {} | has($k) | not)
        | {area: "keybinding", action: "remove", schema: $s, key: $k, from: .value}),
    ($fs.tiling // {} | to_entries[] | .key as $k | $now.tiling[$k] as $v
        | select(.value != $v) | {area: "tiling", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine's tiling has no such setting"} else {} end),
    ($hs.tiling // {} | to_entries[] | .key as $k | select($fs.tiling // {} | has($k) | not)
        | {area: "tiling", action: "remove", key: $k, from: .value}),
    ($fs.pointer // {} | to_entries[] | .key as $k | $now.pointer[$k] as $v
        | select(.value != $v) | {area: "pointer", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such pointer setting"} else {} end),
    ($hs.pointer // {} | to_entries[] | .key as $k | select($fs.pointer // {} | has($k) | not)
        | {area: "pointer", action: "remove", key: $k, from: .value}),
    ($fs.glass // {} | to_entries[] | .key as $k | $now.glass[$k] as $v
        | select(.value != $v) | {area: "glass", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such glass setting"} else {} end),
    ($hs.glass // {} | to_entries[] | .key as $k | select($fs.glass // {} | has($k) | not)
        | {area: "glass", action: "remove", key: $k, from: .value}),
    ($fs.motion // {} | to_entries[] | .key as $k | $now.motion[$k] as $v
        | select(.value != $v) | {area: "motion", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such motion setting"} else {} end),
    ($hs.motion // {} | to_entries[] | .key as $k | select($fs.motion // {} | has($k) | not)
        | {area: "motion", action: "remove", key: $k, from: .value}),
    ($fs.workspaces // {} | to_entries[] | .key as $k | $now.workspaces[$k] as $v
        | select(.value != $v) | {area: "workspaces", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such workspaces setting"} else {} end),
    ($hs.workspaces // {} | to_entries[] | .key as $k | select($fs.workspaces // {} | has($k) | not)
        | {area: "workspaces", action: "remove", key: $k, from: .value}),
    ($fs.windows // {} | to_entries[] | .key as $k | $now.windows[$k] as $v
        | select(.value != $v) | {area: "windows", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such windows setting"} else {} end),
    ($hs.windows // {} | to_entries[] | .key as $k | select($fs.windows // {} | has($k) | not)
        | {area: "windows", action: "remove", key: $k, from: .value}),
    ($fs.dock // {} | to_entries[] | .key as $k | $now.dock[$k] as $v
        | select(.value != $v) | {area: "dock", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such dock setting"} else {} end),
    ($hs.dock // {} | to_entries[] | .key as $k | select($fs.dock // {} | has($k) | not)
        | {area: "dock", action: "remove", key: $k, from: .value}),
    ($fs.pill // {} | to_entries[] | .key as $k | $now.pill[$k] as $v
        | select(.value != $v) | {area: "pill", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such pill setting"} else {} end),
    ($hs.pill // {} | to_entries[] | .key as $k | select($fs.pill // {} | has($k) | not)
        | {area: "pill", action: "remove", key: $k, from: .value}),
    (("quick", "bars", "today", "breaks", "search", "emoji", "bezel", "sound", "transitions", "hints", "appgrid", "focus", "power",
        "access", "touch", "present",
        "screenshot", "deskwidgets", "shelf", "desks") as $a
    | ($fs[$a] // {} | to_entries[] | .key as $k | $now[$a][$k] as $v
        | select(.value != $v) | {area: $a, action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such \({quick: "quick settings", bezel: "screen corners",
            access: "seeing and reading", touch: "touch and pen"}[$a] // $a) setting"} else {} end),
      ($hs[$a] // {} | to_entries[] | .key as $k | select($fs[$a] // {} | has($k) | not)
        | {area: $a, action: "remove", key: $k, from: .value})),
    ($fs.look // {} | to_entries[] | .key as $k | $now.look[$k] as $v
        | select(.value != $v) | {area: "look", action: "set", key: $k, to: .value, from: $v}
        + if $v == null then {ok: false, why: "this machine has no such look setting"} else {} end),
    ($hs.look // {} | to_entries[] | .key as $k | select($fs.look // {} | has($k) | not)
        | {area: "look", action: "remove", key: $k, from: .value})
  ]
| map({ok: true, why: null} + .)
EOF
)"

changes() {
    local here file
    here="$(machine)" && [[ -n "${here}" ]] || die "This machine's setup could not be read."
    file="$(jq -c --argjson tiling "${TILING_KEYS}" "${TILING_JQ} from_paperwm" "$1")" || die "$1 could not be read."
    jq -nc --argjson file "${file}" --argjson here "${here}" --argjson now "$(current "${file}")" \
        --argjson can "$(abilities)" "${CHANGES}"
}

# One line for each change
DESCRIBE="$(
    cat <<'EOF'
def accels: if length == 0 then "no key" else join(" or ") end;
def text:
    if .area == "image" then "the system: \(.to), in place of \(.from)"
    elif .area == "flatpak" then "the app \(.app)" + if .action == "add" then ", from \(.origin)"
        + if .installation == "user" then ", for you alone" else "" end else "" end
    elif .area == "tap" then "the Homebrew tap \(.name)"
        + if .action == "add" then ", whose formulae anyone can publish and Homebrew does not review" else "" end
    elif .area == "formula" then "the Homebrew formula \(.name)"
    elif .area == "cask" then "the Homebrew cask \(.name)"
    elif .area == "container" then "the container \(.name)" + if .action == "add" then ", from the template \(.template)"
        + if (.packages | length) > 0 then ", with \(.packages | join(", "))" else "" end
        else ", and everything installed in it" end
    elif .area == "packages" then "\(.packages | join(", ")) in the container \(.container)"
    elif .area == "extension" then "the extension \(.uuid)"
    elif .area == "theme" then "the theme: \(.to), in place of \(.from // "none")"
    elif .area == "layout" then "the window layout: \(.to), in place of \(.from)"
    elif .area == "favorites" then if .action == "set" then "the dock's apps: \(.to | join(", "))"
        else "the dock's apps, back to the image's" end
    elif .area == "keybinding" then "the keybinding " + if .schema == "custom" then .key else "\(.schema) \(.key)" end
        + if .action == "set" then ": \(.to | accels)" + if .from == null then "" else ", in place of \(.from | accels)" end
          else ", \(.from | accels) here, back to the image's" end
    elif .area == "tiling" then "the tiling's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "pointer" then "the pointer's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "glass" then "the glass's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "motion" then "the motion's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "workspaces" then "the workspaces' \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "windows" then "the windows' \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "dock" then "the dock's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "pill" then "the live pill's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "quick" or .area == "bars" or .area == "today" or .area == "breaks"
        or .area == "search" or .area == "emoji" or .area == "bezel" or .area == "sound"
        or .area == "transitions" or .area == "hints" or .area == "appgrid" or .area == "focus" or .area == "power"
        or .area == "access" or .area == "touch"
        or .area == "present" or .area == "screenshot" or .area == "deskwidgets"
        or .area == "shelf" or .area == "desks" then
        {quick: "quick settings'", bars: "the top bar's", today: "the calendar's", breaks: "the rest reminders'",
            search: "the search's", emoji: "the emoji picker's", bezel: "the screen's", sound: "the desktop's",
            transitions: "the transitions'", hints: "the tips'", appgrid: "the app grid's",
            focus: "focus profiles'", power: "the power module's",
            access: "seeing and reading's", touch: "touch and pen's",
            present: "Present mode's", screenshot: "the screenshot's", deskwidgets: "the desktop widgets'",
            shelf: "the shelf's", desks: "the desks'"}[.area]
        + " \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    elif .area == "look" then "the look's \(.key)"
        + if .action == "set" then ": \(.to | tojson)" + if .from == null then "" else ", in place of \(.from | tojson)" end
          else ", \(.from | tojson) here, back to the image's" end
    else tojson end;
EOF
)"

# Prints the changes on stdin that the jq condition $3 selects, marked with $2, under the heading $1
section() {
    jq -r --arg title "$1" --arg mark "$2" "${DESCRIBE}"' [.[] | select('"$3"')] | select(length > 0)
        | if $title == "" then empty else $title end,
          (.[] | "  \($mark) " + text + if .ok then "" else ": \(.why)" end),
          if $title == "" then empty else "" end'
}

# --- The commands ---------------------------------------------------------------------------------

save() {
    local target="${1:-${DEFAULT_FILE}}" setup
    [[ $# -le 1 && "${target}" != -?* ]] || die "usage: ame setup save [FILE]"
    setup="$(machine)" && [[ -n "${setup}" ]] || die "This machine's setup could not be read."
    check "This machine's setup" <<<"${setup}"
    if [[ "${target}" == - ]]; then
        printf '%s\n' "${setup}"
        return
    fi
    # Through a link, to where it leads, as a file kept in a folder of dotfiles often is
    target="$(realpath -m -- "${target}")"
    mkdir -p "$(dirname "${target}")" || die "Could not make the folder for ${target}."
    printf '%s\n' "${setup}" >"${target}.new" && mv -f "${target}.new" "${target}" || die "Could not write ${target}."
    echo "Saved this machine's setup to ${target}:"
    jq -r 'def n($count; $what): "\($count) \($what)\(if $count == 1 then "" else "s" end)";
        "\(n(.flatpaks.system + .flatpaks.user | length; "app")), \(.brew.formulae + .brew.casks | length) from Homebrew, "
        + "\(n(.containers | length; "container")), \(n(.extensions | length; "extension")), the theme \(.theme // "none"), "
        + "\(n(.settings.keybindings // {} | map(length) | add // 0; "keybinding")) "
        + "and \(n(.settings.tiling // {} | length; "tiling setting")) of your own."' <<<"${setup}"
    if ! git -C "$(dirname "${target}")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "To keep it in git, see: amethystora-manual setup#keeping-it-in-git"
    fi
}

diff_setup() {
    local json=false file="" changes
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true ;;
            -*) die "usage: ame setup diff [--json] [FILE]" ;;
            *) [[ -z "${file}" ]] || die "usage: ame setup diff [--json] [FILE]"; file="$1" ;;
        esac
        shift
    done
    file="${file:-${DEFAULT_FILE}}"
    load "${file}"
    changes="$(changes "${file}")" || exit 1
    if [[ "${json}" == true ]]; then
        jq . <<<"${changes}"
    elif [[ "${changes}" == "[]" ]]; then
        echo "This machine is as ${file} says."
    else
        section "In the file, not here (ame setup apply adds them):" + '.ok and .action == "add"' <<<"${changes}"
        section "Set differently here (ame setup apply sets them as the file has them):" "~" '.ok and .action == "set"' <<<"${changes}"
        section "Here, not in the file (ame setup apply --remove takes them away, after asking):" - '.action == "remove"' <<<"${changes}"
        section "In the file, but this machine cannot have them:" "!" '.ok | not' <<<"${changes}"
    fi
}

apply() {
    local remove=false yes=false did=false file="" changes todo gone
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remove) remove=true ;;
            --yes | -y) yes=true ;;
            -*) die "usage: ame setup apply [--remove] [--yes] [FILE]" ;;
            *) [[ -z "${file}" ]] || die "usage: ame setup apply [--remove] [--yes] [FILE]"; file="$1" ;;
        esac
        shift
    done
    file="${file:-${DEFAULT_FILE}}"
    load "${file}"
    changes="$(changes "${file}")" || exit 1
    todo="$(jq -c '[.[] | select(.ok and .action != "remove")]' <<<"${changes}")"
    gone="$(jq -c '[.[] | select(.action == "remove")]' <<<"${changes}")"
    section "In the file, but this machine cannot have them, so they are left out:" "!" '.ok | not' <<<"${changes}"

    if [[ "${todo}" == "[]" && ("${remove}" == false || "${gone}" == "[]") ]]; then
        echo "Nothing to do: this machine has everything ${file} names, as it names it."
    fi
    if [[ "${todo}" != "[]" ]]; then
        echo "To make this machine as ${file} says:"
        section "" + '.action == "add"' <<<"${todo}"
        section "" "~" '.action == "set"' <<<"${todo}"
        echo
        if [[ "${yes}" != true ]]; then
            interactive || die "apply asks before it changes anything, which needs a terminal, or --yes."
            confirm "Go ahead?" true || exit 0
        fi
        add_all "${todo}"
        did=true
    fi
    if [[ "${gone}" != "[]" && "${remove}" == true ]]; then
        section "Here, and not in the file:" - 'true' <<<"${gone}"
        interactive || die "--remove asks before it takes anything away, which needs a terminal."
        if confirm "Take these away? Apps keep their data, and a container's home folder stays." false; then
            remove_all "${gone}"
            did=true
        fi
    elif [[ "${gone}" != "[]" ]]; then
        echo "Left as they are: $(jq length <<<"${gone}") here that the file does not name (ame setup diff lists them)."
    fi

    if [[ ${#FAILED[@]} -gt 0 ]]; then
        echo
        echo "Done, except: $(printf '%s, ' "${FAILED[@]}" | sed 's/, $//'). Running it again picks up where it stopped."
        return 1
    fi
    [[ "${did}" == false ]] || echo "Done."
}

# --- Doing it -------------------------------------------------------------------------------------

# Each change is read into an array first, so that what runs keeps the terminal on its stdin and can
# ask its questions there. What fails is named in FAILED.
FAILED=()

# The changes of one area, one JSON object a line
of() { jq -c --arg a "$2" '.[] | select(.area == $a)' <<<"$1"; }

add_all() {
    local todo="$1" change installation origin name template value stream
    local -a changes names args
    mapfile -t changes < <(jq -r '[.[] | select(.area == "flatpak") | [.installation, .origin]] | unique[] | @tsv' <<<"${todo}")
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r installation origin <<<"${change}"
        mapfile -t names < <(jq -r --arg i "${installation}" --arg o "${origin}" \
            '.[] | select(.area == "flatpak" and .installation == $i and .origin == $o) | .app' <<<"${todo}")
        flatpak install "--${installation}" --noninteractive "${origin}" "${names[@]}" || FAILED+=("apps from ${origin}")
    done

    mapfile -t names < <(of "${todo}" tap | jq -r .name)
    for name in "${names[@]}"; do
        "${BREW}" tap "${name}" || FAILED+=("the Homebrew tap ${name}")
    done
    mapfile -t names < <(of "${todo}" formula | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" install --formula "${names[@]}" || FAILED+=("Homebrew formulae")
    mapfile -t names < <(of "${todo}" cask | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" install --cask "${names[@]}" || FAILED+=("Homebrew casks")

    # A package from the AUR is built only once its PKGBUILD has been read, --yes or not
    mapfile -t changes < <(of "${todo}" container)
    for change in "${changes[@]}"; do
        name="$(jq -r .name <<<"${change}")"
        template="$(jq -r .template <<<"${change}")"
        args=(containers new --template "${template}" --name "${name}" --no-prompt --yes)
        [[ "$(jq -r .init <<<"${change}")" == true ]] && args+=(--init)
        amethystora-pkg "${args[@]}" || { FAILED+=("the container ${name}"); continue; }
        mapfile -t names < <(jq -r '.packages[]' <<<"${change}")
        [[ ${#names[@]} -eq 0 ]] || amethystora-pkg "${name}" install --yes "${names[@]}" || FAILED+=("packages in ${name}")
    done
    mapfile -t changes < <(of "${todo}" packages)
    for change in "${changes[@]}"; do
        name="$(jq -r .container <<<"${change}")"
        mapfile -t names < <(jq -r '.packages[]' <<<"${change}")
        amethystora-pkg "${name}" install --yes "${names[@]}" || FAILED+=("packages in ${name}")
    done

    mapfile -t names < <(of "${todo}" extension | jq -r .uuid)
    for name in "${names[@]}"; do
        gnome-extensions enable "${name}" || FAILED+=("the extension ${name}")
    done
    mapfile -t names < <(of "${todo}" theme | jq -r .to)
    for name in "${names[@]}"; do
        amethystora-theme set "${name}" || FAILED+=("the theme")
    done
    mapfile -t names < <(of "${todo}" layout | jq -r .to)
    for name in "${names[@]}"; do
        ame desktop layout "${name}" || FAILED+=("the window layout")
    done

    mapfile -t changes < <(of "${todo}" favorites)
    for change in "${changes[@]}"; do
        gsettings set org.gnome.shell favorite-apps "$(jq -c .to <<<"${change}" | as_variant)" || FAILED+=("the dock's apps")
    done
    mapfile -t changes < <(of "${todo}" keybinding)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        if [[ "$(jq -r .schema <<<"${change}")" == custom ]]; then
            gsettings set "${RELOCATABLE}:${CUSTOM}/${name}/" binding "'$(jq -r '.to[0] // ""' <<<"${change}")'"
        else
            gsettings set "$(jq -r .schema <<<"${change}")" "${name}" "$(jq -c .to <<<"${change}" | as_variant)"
        fi || FAILED+=("the keybinding ${name}")
    done
    # The check let through only numbers, switches and lists of numbers or of colours, which GSettings reads
    # as JSON writes them
    mapfile -t changes < <(of "${todo}" tiling)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${TILING}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the tiling's ${name}")
    done
    # A switch, or one of the choices the check let through, which GSettings reads in JSON's double quotes
    mapfile -t changes < <(of "${todo}" pointer)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${POINTER}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the pointer's ${name}")
    done
    mapfile -t changes < <(of "${todo}" glass)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${GLASS}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the glass's ${name}")
    done
    mapfile -t changes < <(of "${todo}" motion)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${MOTION}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the motion's ${name}")
    done
    mapfile -t changes < <(of "${todo}" workspaces)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${WORKSPACES}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the workspaces' ${name}")
    done
    mapfile -t changes < <(of "${todo}" windows)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${WINDOWS}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the windows' ${name}")
    done
    mapfile -t changes < <(of "${todo}" dock)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        value="$(jq -c .to <<<"${change}")"
        # The machine's own stacks outside the home folder stay, after the file's
        if [[ "${name}" == stacks ]]; then
            value="$(jq -c --argjson here "$(gsettings get "${DOCK}" stacks 2>/dev/null | as_json || echo '[]')"                 '. + ($here // [] | map(select(test("^(xdg:|~/)") | not)))' <<<"${value}")"
        fi
        gsettings set "${DOCK}" "${name}" "${value}" || FAILED+=("the dock's ${name}")
    done
    mapfile -t changes < <(of "${todo}" pill)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        gsettings set "${PILL}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("the live pill's ${name}")
    done
    for area in quick bars today breaks search emoji bezel sound transitions hints appgrid focus power access touch \
        present screenshot deskwidgets shelf desks; do
        case "${area}" in
            quick) schema="${QUICK}" label="quick settings'" ;;
            bars) schema="${BARS}" label="the bars setting" ;;
            today) schema="${TODAY}" label="the today setting" ;;
            breaks) schema="${BREAKS}" label="the breaks setting" ;;
            search) schema="${SEARCH}" label="the search's" ;;
            emoji) schema="${EMOJI}" label="the emoji picker's" ;;
            bezel) schema="${BEZEL}" label="the screen's" ;;
            sound) schema="${SOUND}" label="the desktop's" ;;
            transitions) schema="${TRANSITIONS}" label="the transitions'" ;;
            hints) schema="${HINTS}" label="the tips'" ;;
            appgrid) schema="${APPGRID}" label="the app grid's" ;;
            power) schema="${POWER}" label="the power module's" ;;
            focus) schema="${FOCUS}" label="focus profiles'" ;;
            access) schema="${ACCESS}" label="seeing and reading's" ;;
            touch) schema="${TOUCH}" label="touch and pen's" ;;
            present) schema="${PRESENT}" label="Present mode's" ;;
            screenshot) schema="${SCREENSHOT}" label="the screenshot's" ;;
            deskwidgets) schema="${DESKWIDGETS}" label="the desktop widgets'" ;;
            shelf) schema="${SHELF}" label="the shelf's" ;;
            desks) schema="${DESKS}" label="the desks'" ;;
        esac
        mapfile -t changes < <(of "${todo}" "${area}")
        for change in "${changes[@]}"; do
            name="$(jq -r .key <<<"${change}")"
            gsettings set "${schema}" "${name}" "$(jq -c .to <<<"${change}")" || FAILED+=("${label} ${name}")
        done
    done
    # The look through its own commands, which apply the theme again; the workspaces' accents last, rendered once
    mapfile -t changes < <(of "${todo}" look)
    for change in "${changes[@]}"; do
        name="$(jq -r .key <<<"${change}")"
        case "${name}" in
            accent | daylight | colours) ame desktop "${name}" "$(jq -r .to <<<"${change}")" >/dev/null ;;
            accent-per-workspace) ame desktop accent-per-workspace "$(jq -r 'if .to then "on" else "off" end' <<<"${change}")" >/dev/null ;;
            workspace-accents) gsettings set "${THEME_UI}" workspace-accents "$(jq -r "${GVARIANT}"' .to | gv' <<<"${change}")" &&
                amethystora-theme accents ;;
        esac || FAILED+=("the look's ${name}")
    done

    # Last, since it downloads a whole system, which only takes over at the next restart
    mapfile -t changes < <(of "${todo}" image | jq -r '[.name, .stream] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r name stream <<<"${change}"
        if interactive; then
            ame system rebase "${name}" "${stream}" || FAILED+=("the system")
        else
            echo "Switching the system asks its own questions, in a terminal: ame system rebase ${name} ${stream}"
            FAILED+=("the system")
        fi
    done
}

remove_all() {
    local gone="$1" change installation schema name
    local -a changes names
    mapfile -t changes < <(of "${gone}" flatpak | jq -r '[.installation, .app] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r installation name <<<"${change}"
        flatpak uninstall "--${installation}" --noninteractive "${name}" || FAILED+=("the app ${name}")
    done
    mapfile -t names < <(of "${gone}" formula | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" uninstall --formula "${names[@]}" || FAILED+=("Homebrew formulae")
    mapfile -t names < <(of "${gone}" cask | jq -r .name)
    [[ ${#names[@]} -eq 0 ]] || "${BREW}" uninstall --cask "${names[@]}" || FAILED+=("Homebrew casks")
    mapfile -t names < <(of "${gone}" tap | jq -r .name)
    for name in "${names[@]}"; do
        "${BREW}" untap "${name}" || FAILED+=("the Homebrew tap ${name}")
    done
    mapfile -t names < <(of "${gone}" container | jq -r .name)
    for name in "${names[@]}"; do
        amethystora-pkg containers rm "${name}" --force || FAILED+=("the container ${name}")
    done
    mapfile -t names < <(of "${gone}" extension | jq -r .uuid)
    for name in "${names[@]}"; do
        gnome-extensions disable "${name}" || FAILED+=("the extension ${name}")
    done
    if [[ -n "$(of "${gone}" favorites)" ]]; then
        gsettings reset org.gnome.shell favorite-apps || FAILED+=("the dock's apps")
    fi
    mapfile -t changes < <(of "${gone}" keybinding | jq -r '[.schema, .key] | @tsv')
    for change in "${changes[@]}"; do
        IFS=$'\t' read -r schema name <<<"${change}"
        if [[ "${schema}" == custom ]]; then
            gsettings reset "${RELOCATABLE}:${CUSTOM}/${name}/" binding
        else
            gsettings reset "${schema}" "${name}"
        fi || FAILED+=("the keybinding ${name}")
    done
    mapfile -t names < <(of "${gone}" tiling | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${TILING}" "${name}" || FAILED+=("the tiling's ${name}")
    done
    mapfile -t names < <(of "${gone}" pointer | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${POINTER}" "${name}" || FAILED+=("the pointer's ${name}")
    done
    mapfile -t names < <(of "${gone}" glass | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${GLASS}" "${name}" || FAILED+=("the glass's ${name}")
    done
    mapfile -t names < <(of "${gone}" motion | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${MOTION}" "${name}" || FAILED+=("the motion's ${name}")
    done
    mapfile -t names < <(of "${gone}" workspaces | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${WORKSPACES}" "${name}" || FAILED+=("the workspaces' ${name}")
    done
    mapfile -t names < <(of "${gone}" windows | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${WINDOWS}" "${name}" || FAILED+=("the windows' ${name}")
    done
    mapfile -t names < <(of "${gone}" dock | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${DOCK}" "${name}" || FAILED+=("the dock's ${name}")
    done
    mapfile -t names < <(of "${gone}" pill | jq -r .key)
    for name in "${names[@]}"; do
        gsettings reset "${PILL}" "${name}" || FAILED+=("the live pill's ${name}")
    done
    for area in quick bars today breaks search emoji bezel sound transitions hints appgrid focus power access touch \
        present screenshot deskwidgets shelf desks; do
        case "${area}" in
            quick) schema="${QUICK}" label="quick settings'" ;;
            bars) schema="${BARS}" label="the bars setting" ;;
            today) schema="${TODAY}" label="the today setting" ;;
            breaks) schema="${BREAKS}" label="the breaks setting" ;;
            search) schema="${SEARCH}" label="the search's" ;;
            emoji) schema="${EMOJI}" label="the emoji picker's" ;;
            bezel) schema="${BEZEL}" label="the screen's" ;;
            sound) schema="${SOUND}" label="the desktop's" ;;
            transitions) schema="${TRANSITIONS}" label="the transitions'" ;;
            hints) schema="${HINTS}" label="the tips'" ;;
            appgrid) schema="${APPGRID}" label="the app grid's" ;;
            power) schema="${POWER}" label="the power module's" ;;
            focus) schema="${FOCUS}" label="focus profiles'" ;;
            access) schema="${ACCESS}" label="seeing and reading's" ;;
            touch) schema="${TOUCH}" label="touch and pen's" ;;
            present) schema="${PRESENT}" label="Present mode's" ;;
            screenshot) schema="${SCREENSHOT}" label="the screenshot's" ;;
            deskwidgets) schema="${DESKWIDGETS}" label="the desktop widgets'" ;;
            shelf) schema="${SHELF}" label="the shelf's" ;;
            desks) schema="${DESKS}" label="the desks'" ;;
        esac
        mapfile -t names < <(of "${gone}" "${area}" | jq -r .key)
        for name in "${names[@]}"; do
            gsettings reset "${schema}" "${name}" || FAILED+=("${label} ${name}")
        done
    done
    mapfile -t names < <(of "${gone}" look | jq -r .key)
    for name in "${names[@]}"; do
        case "${name}" in
            accent) ame desktop accent theme >/dev/null ;;
            daylight) ame desktop daylight on >/dev/null ;;
            colours) ame desktop colours off >/dev/null ;;
            accent-per-workspace) ame desktop accent-per-workspace off >/dev/null ;;
            workspace-accents) gsettings reset "${THEME_UI}" workspace-accents && amethystora-theme accents ;;
        esac || FAILED+=("the look's ${name}")
    done
}

# --- An image's defaults ---------------------------------------------------------------------------

# GVariant text of a JSON value the check let through: names, keys and colours hold no quote or backslash
GVARIANT='def gv: if type == "array" then "[" + (map(gv) | join(", ")) + "]"
    elif type == "string" then ([39] | implode) as $q | $q + . + $q else tojson end;'

bake() {
    local file="" root=/ setup out problems schemas ids defaults uuid id key
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root) [[ $# -ge 2 ]] || die "usage: amethystora-setup bake FILE [--root DIR]"; root="$2"; shift ;;
            -*) die "usage: amethystora-setup bake FILE [--root DIR]" ;;
            *) [[ -z "${file}" ]] || die "usage: amethystora-setup bake FILE [--root DIR]"; file="$1" ;;
        esac
        shift
    done
    [[ -n "${file}" ]] || die "usage: amethystora-setup bake FILE [--root DIR]"
    load "${file}"
    setup="$(jq -c --argjson tiling "${TILING_KEYS}" "${TILING_JQ} from_paperwm" "${file}")" || die "${file} could not be read."
    root="${root%/}"
    schemas="${root}/usr/share/glib-2.0/schemas"
    out="${root}/usr/share/amethystora/image-setup"
    [[ -d "${schemas}" ]] || die "${root:-/} has no ${schemas#"${root}"}: bake runs on an Amethystora image."

    # What the image cannot have stops the build, every reason at once
    problems="$(
        # Flathub, or a remote the image declares (amethystora-image-policy's flatpak-remotes, added before this)
        jq -r '.flatpaks // {} | (.system // []) + (.user // []) | .[] | select(.origin != "flathub") | [.app, .origin] | @tsv' \
            <<<"${setup}" | while IFS=$'\t' read -r id key; do
            [[ -f "${root}/etc/flatpak/remotes.d/${key}.flatpakrepo" ]] ||
                echo "the app ${id} comes from ${key}, which the image has no remote for: Flathub, or one of policy/flatpak-remotes"
        done
        for uuid in $(jq -r '.extensions // [] | .[]' <<<"${setup}"); do
            [[ -d "${root}/usr/share/gnome-shell/extensions/${uuid}" ]] ||
                echo "the extension ${uuid} is not installed in the image: build.sh installs it first"
        done
        id="$(jq -r '.theme // empty' <<<"${setup}")"
        [[ -z "${id}" || -d "${root}/usr/share/amethystora/themes/${id}" ]] || echo "the image has no theme called ${id}"
        for id in $(jq -r '.settings.keybindings.custom // {} | keys[]' <<<"${setup}"); do
            grep -qsxF "[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/${id}]" \
                "${root}"/etc/dconf/db/distro.d/* || echo "the image has no custom keybinding ${id}"
        done
        # PaperWM's, which a file from before the tiling may hold, belong to no extension the image runs
        jq -r '.settings.keybindings // {} | keys[] | select(. == "org.gnome.shell.extensions.paperwm.keybindings")
            | "\(.) belong to PaperWM, which the image no longer has"' <<<"${setup}"
        # A key the image's schemas do not have would be dropped by glib-compile-schemas without a word
        while IFS=$'\t' read -r id key; do
            GSETTINGS_SCHEMA_DIR="${schemas}" GSETTINGS_BACKEND=memory /usr/bin/gsettings range "${id}" "${key}" >/dev/null 2>&1 ||
                echo "the image has no keybinding ${key} in ${id}"
        done < <(jq -r '.settings.keybindings // {} | to_entries[] | select(.key != "custom") | .key as $s | .value | keys[]
            | [$s, .] | @tsv' <<<"${setup}")
    )"
    [[ -z "${problems}" ]] || die "${file} cannot be baked into this image:"$'\n'"$(sed 's/^/  /' <<<"${problems}")"

    mkdir -p "${out}" "${root}/usr/share/flatpak/preinstall.d" "${root}/etc/dconf/db/distro.d" || die "Could not write into ${root:-/}."
    install -m0644 "${file}" "${out}/setup.json"

    # Every app, the account's own as well: an image has one installation for every account
    jq -r '[.flatpaks // {} | (.system // []) + (.user // []) | .[].app] | unique
        | "# The apps of this image'"'"'s setup.json (amethystora-setup bake), from Flathub or the image'"'"'s own remotes on the first boot with a network",
          (.[] | "", "[Flatpak Preinstall \(.)]", "Branch=stable", "IsRuntime=false")' <<<"${setup}" \
        >"${root}/usr/share/flatpak/preinstall.d/image-setup.preinstall"

    # The image's extensions stay on whatever the file says: they are what the desktop is made of
    defaults="$(GSETTINGS_SCHEMA_DIR="${schemas}" GSETTINGS_BACKEND=memory /usr/bin/gsettings get org.gnome.shell \
        enabled-extensions | sed "s/^@as //; s/'/\"/g")" || die "Could not read the image's extensions."
    jq -r --argjson image "${defaults}" --argjson tiling "${TILING_KEYS}" "${GVARIANT}"'
        def section($schema; $values): select($values != {}) | "", "[\($schema)]", ($values | to_entries[] | "\(.key)=\(.value | gv)");
        (.settings // {}) as $s
        | "# This image'"'"'s setup.json (amethystora-setup bake), after the image'"'"'s own zz0 and zz1",
          section("org.gnome.shell"; {}
            + if has("extensions") then {"enabled-extensions": ($image + (.extensions - $image))} else {} end
            + if $s | has("favorites") then {"favorite-apps": $s.favorites} else {} end),
          ($s.keybindings // {} | to_entries[] | select(.key != "custom") | section(.key; .value)),
          section("org.gnome.shell.extensions.amethystora-ui.tiling"; ($s.tiling // {})
            + if $s.layout == null then {} else {enabled: ($s.layout == "tiling")} end),
          section("org.gnome.shell.extensions.amethystora-ui.pointer"; ($s.pointer // {})),
          section("org.gnome.shell.extensions.amethystora-ui.glass"; ($s.glass // {})),
          section("org.gnome.shell.extensions.amethystora-ui.motion"; ($s.motion // {})),
          section("org.gnome.shell.extensions.amethystora-ui.workspaces"; ($s.workspaces // {})),
          section("org.gnome.shell.extensions.amethystora-ui.windows"; ($s.windows // {})),
          section("org.gnome.shell.extensions.amethystora-ui.dock"; ($s.dock // {})),
          section("org.gnome.shell.extensions.amethystora-ui.pill"; ($s.pill // {})),
          section("org.gnome.shell.extensions.amethystora-ui.quick"; ($s.quick // {})),
          section("org.gnome.shell.extensions.amethystora-ui.bars"; ($s.bars // {})),
          section("org.gnome.shell.extensions.amethystora-ui.today"; ($s.today // {})),
          section("org.gnome.desktop.break-reminders"; ($s.breaks // {})),
          section("org.gnome.shell.extensions.amethystora-ui.search"; ($s.search // {})),
          section("org.gnome.shell.extensions.amethystora-ui.emoji"; ($s.emoji // {})),
          section("org.gnome.shell.extensions.amethystora-ui.bezel"; ($s.bezel // {})),
          section("org.gnome.desktop.sound"; ($s.sound // {})),
          section("org.gnome.shell.extensions.amethystora-ui.focus"; ($s.focus // {})),
          section("org.gnome.shell.extensions.amethystora-ui.present"; ($s.present // {})),
          section("org.gnome.shell.extensions.amethystora-ui.screenshot"; ($s.screenshot // {})),
          section("org.gnome.shell.extensions.amethystora-ui.deskwidgets"; ($s.deskwidgets // {})),
          section("org.gnome.shell.extensions.amethystora-ui.shelf"; ($s.shelf // {})),
          section("org.gnome.shell.extensions.amethystora-ui.desks"; ($s.desks // {})),
          section("org.gnome.shell.extensions.amethystora-ui.theme";
            ($s.look // {} | with_entries(select(.key | IN("accent-per-workspace", "workspace-accents"))))),
          section("org.gnome.shell.extensions.amethystora-transitions"; ($s.transitions // {})),
          section("org.gnome.shell.extensions.amethystora-ui.hints"; ($s.hints // {})),
          section("org.gnome.shell.extensions.amethystora-ui.appgrid"; ($s.appgrid // {})),
          section("org.gnome.shell.extensions.amethystora-ui.power"; ($s.power // {}))' <<<"${setup}" \
        >"${schemas}/zz2-image-setup.gschema.override"

    # The image's custom keybindings are relocatable, so their keys are dconf's
    jq -r "${GVARIANT}"'.settings.keybindings.custom // {} | to_entries[]
        | "[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/\(.key)]", "binding=\(.value[0] // "" | gv)", ""' \
        <<<"${setup}" >"${root}/etc/dconf/db/distro.d/zz2-image-setup"
    [[ -s "${root}/etc/dconf/db/distro.d/zz2-image-setup" ]] || rm -f "${root}/etc/dconf/db/distro.d/zz2-image-setup"

    rm -f "${out}/theme" "${out}/Brewfile" "${out}/accent" "${out}/colours"
    jq -r '.theme // empty' <<<"${setup}" | sed '/^$/d' >"${out}/theme"
    [[ -s "${out}/theme" ]] || rm -f "${out}/theme"
    # The accent and colours from the wallpaper, which the theme reads after the account's own (theme/lib.sh)
    jq -r '.settings.look.accent // empty | select(. != "theme")' <<<"${setup}" >"${out}/accent"
    [[ -s "${out}/accent" ]] || rm -f "${out}/accent"
    jq -r '.settings.look.colours // empty | select(. != "off")' <<<"${setup}" >"${out}/colours"
    [[ -s "${out}/colours" ]] || rm -f "${out}/colours"
    # Names only, each in quotes the check keeps out of it: Homebrew reads a Brewfile as Ruby
    jq -r '.brew // {} | (.taps // [] | .[] | "tap \"\(.)\""), (.formulae // [] | .[] | "brew \"\(.)\""),
        (.casks // [] | .[] | "cask \"\(.)\"")' <<<"${setup}" >"${out}/Brewfile"
    [[ -s "${out}/Brewfile" ]] || rm -f "${out}/Brewfile"

    # Compiled where GNOME reads them: the system's schemas, and each extension's own, which GNOME Shell reads
    # first (build-gnome-extensions.sh), with its sections of every override
    for id in "${root}"/usr/share/gnome-shell/extensions/*/schemas; do
        [[ -d "${id}" ]] || continue
        ids="$(cat "${id}"/*.gschema.xml | tr -s '[:space:]' ' ' | grep -oE '<schema [^>]*id="[^"]+"' |
            sed -E 's/.*id="([^"]+)".*/\1/' | tr '\n' ' ')"
        awk -v ids="${ids}" 'BEGIN { n = split(ids, list, " "); for (i = 1; i <= n; i++) own["[" list[i] "]"] = 1 }
            /^\[/ { keep = ($0 in own) } keep' "${schemas}"/zz[0-9]-*.gschema.override >"${id}/zz-amethystora-modifications.gschema.override"
        glib-compile-schemas --strict "${id}" || die "The schemas of ${id%/schemas} do not take this setup."
        rm "${id}/zz-amethystora-modifications.gschema.override"
    done
    glib-compile-schemas "${schemas}" || die "The image's schemas do not take this setup."
    # Built anew, locks and all: an image's files all carry one time, so dconf could take the old one for current
    rm -f "${root}/etc/dconf/db/distro"
    dconf update "${root}/etc/dconf/db" || die "dconf could not compile ${root}/etc/dconf/db/distro.d."

    echo "Baked ${file} into the image:"
    jq -r 'def n($count; $what): "\($count) \($what)\(if $count == 1 then "" else "s" end)";
        "  \(n([.flatpaks // {} | (.system // []) + (.user // []) | .[].app] | unique | length; "app")) to preinstall, "
        + "\(n(.brew // {} | (.taps // []) + (.formulae // []) + (.casks // []) | length; "name")) from Homebrew, "
        + "\(n(.extensions // [] | length; "extension")), the theme \(.theme // "of the image")",
        if (.containers // []) != [] then "  Left out: the containers, which each account makes (ame setup apply)" else empty end,
        if .image then "  Left out: image, which is this build itself" else empty end,
        if .settings.look.daylight then "  Left out: the look'"'"'s daylight, which each account turns off itself (ame desktop daylight)" else empty end' <<<"${setup}"
}

case "${1:-}" in
    save) shift; save "$@" ;;
    bake) shift; bake "$@" ;;
    diff) shift; diff_setup "$@" ;;
    apply) shift; apply "$@" ;;
    -h | --help | help) usage ;;
    *) usage >&2; exit 1 ;;
esac
