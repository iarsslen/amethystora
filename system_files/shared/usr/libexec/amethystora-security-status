#!/usr/bin/bash
# What this machine's security settings are actually doing, and what to do about anything that is off.
# Nothing here changes anything, and it asks for no password.
#
#   amethystora-security-status          the report, for a terminal (`ame security status`)
#   amethystora-security-status --json   the same report, for the Security app (amethystora-security)
#
# One set of checks for both, so that the terminal and the window cannot disagree. Each check ends in
#
#   report <group> <id> <state> <title> <text> [<detail>...]
#
# where the state is ok, check, off or info, and for the protections that stay off until someone turns
# them on: on, off or unavailable. COMMAND, set just before the call, is what fixes it or turns it on,
# and a detail ending in a colon is the one that introduces it. The app offers to run that command in a
# terminal, so it has to be one command and nothing more: no pipes, no quotes, no "then restart".
#
# A feature the machine's owner switched off (amethystora-security-config, amethystora-hardening) is info,
# with the command that turns it on: off on purpose is not a fault. Turned off some other way, such as a
# disabled unit, it is still a check, since nobody chose that through its switch.

set -uo pipefail

# The report's words, in the session's language where there is a translation of them (po/, compiled into
# /usr/share/locale by 14-security.sh). A message names its values as shell variables, which eval_gettext
# fills in, so that a translation can put them where its language needs them; a value that is not a plain
# variable is put into one first.
export TEXTDOMAIN=amethystora
# shellcheck source=/dev/null
source gettext.sh

JSON=false
[[ "${1:-}" == "--json" ]] && JSON=true

RECORDS=()
COMMAND=""
PRINTED_GROUP=""

declare -A HEADINGS=(
    [updates]="$(gettext "Updates and boot")"
    [watching]="$(gettext "Watching")"
    [apps]="$(gettext "Apps")"
    [scans]="$(gettext "Scans")"
    [optional]="$(gettext "Off unless you turned it on")"
)

# A check as the terminal shows it: its state, what it says, and what explains it, with the command
# following the detail that introduces it
print_record() {
    local group="$1" state="$2" title="$3" text="$4" line reason
    shift 4
    local -a lines=("$@")
    if [[ "${group}" != "${PRINTED_GROUP}" ]]; then
        PRINTED_GROUP="${group}"
        printf '\n  %s\n' "${HEADINGS[${group}]}"
    fi
    if [[ "${group}" == optional ]]; then
        reason="${lines[0]:-}"
        reason="${reason,}"
        case "${state}" in
            on) printf '   %s\n' "$(eval_gettext "\${title} is on (\${COMMAND})")" ;;
            unavailable) printf '   %s\n' "$(eval_gettext "\${title}: \${COMMAND} (\${reason})")" ;;
            *) printf '   %s: %s\n' "${title}" "${COMMAND}" ;;
        esac
        return
    fi
    local mark="" colour=""
    # Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
    case "${state}" in
        ok) mark="$(gettext "ok")" colour="1;32" ;;
        check) mark="$(gettext "check")" colour="1;33" ;;
        off) mark="$(gettext "off")" colour="1;31" ;;
    esac
    if [[ -n "${mark}" ]]; then
        # Padded by letters, which ${#} counts, rather than by bytes, which printf's own width counts,
        # so that a translation with an accent or another script still lines its text up
        printf '   \033[%sm%s\033[0m%*s%s\n' "${colour}" "${mark}" "$((${#mark} < 7 ? 7 - ${#mark} : 1))" '' "${text}"
    else
        printf '   ---    %s\n' "${text}"
    fi
    if [[ -n "${COMMAND}" ]]; then
        if [[ ${#lines[@]} -gt 0 && "${lines[-1]}" == *: ]]; then
            lines[-1]+=" ${COMMAND}"
        else
            lines+=("${COMMAND}")
        fi
    fi
    for line in "${lines[@]}"; do
        fold -s -w 88 <<<"${line}" | sed 's/ *$//; s/^/          /'
    done
}

report() {
    local group="$1" id="$2" state="$3" title="$4" text="$5" accepted=""
    shift 5
    # A check the machine's owner accepted in this state (ame security allow report) is information from
    # then on, never a warning, until its state changes
    if [[ "${group}" != optional && -n "${ACCEPTED["${id} ${state}"]+set}" ]]; then
        accepted="${state}"
        state=info
    fi
    if [[ "${JSON}" == true ]]; then
        RECORDS+=("$(jq -nc --arg group "${group}" --arg id "${id}" --arg state "${state}" \
            --arg title "${title}" --arg text "${text}" --arg command "${COMMAND}" --arg accepted "${accepted}" \
            --argjson switched "${SWITCHED_OFF:-false}" \
            '{$group, $id, $state, $title, $text, details: $ARGS.positional,
              command: (if $command == "" then null else $command end),
              accepted: (if $accepted == "" then null else $accepted end), switched_off: $switched}' --args "$@")")
    elif [[ -n "${accepted}" ]]; then
        print_record "${group}" "${state}" "${title}" "${text}" "$@" \
            "$(eval_gettext "Accepted on this machine. ame security allow report \${id} remove shows it again.")"
    else
        print_record "${group}" "${state}" "${title}" "${text}" "$@"
    fi
    COMMAND=""
    SWITCHED_OFF=false
}

# A feature its owner switched off is shown as that, with the command that turns it on again, and never as
# something to fix: the report says "turned off" where it would otherwise warn
turned_off() {
    local group="$1" id="$2" title="$3" text="$4"
    shift 4
    SWITCHED_OFF=true
    report "${group}" "${id}" info "${title}" "${text}" "$@" "$(gettext "Turn it back on with:")"
}

NOW="$(date +%s)"
# The machine's own choices (/etc/amethystora/security.conf), through the one reader of that file
declare -A SETTING=()
while IFS='=' read -r key value; do
    SETTING["${key}"]="${value}"
done < <(/usr/libexec/amethystora-security-config --all)
ON_DETECTION="${SETTING[ON_DETECTION]}"
NETWORK="${SETTING[NETWORK]}"
# What the owner turned off of what the image enforces from the start (ame security kernel, firewall...)
hardening_off() { ! /usr/libexec/amethystora-hardening is-on "$@"; }
# The checks the owner accepted, each in the state it was accepted in
declare -A ACCEPTED=()
while IFS= read -r line; do
    ACCEPTED["${line}"]=1
done < <(/usr/libexec/amethystora-security-allow list report 2>/dev/null)
# What the security watcher saw that only root can see, written for this report at each of its runs
WATCH_STATUS=/var/lib/amethystora/security/status.json

# When a scan last ran, in seconds: the later of its service finishing, which systemd forgets at every
# boot, and its timer firing, which it keeps
last_run_time() {
    {
        systemctl show --timestamp=unix -p InactiveEnterTimestamp --value "$1.service"
        systemctl show --timestamp=unix -p LastTriggerUSec --value "$1.timer"
    } 2>/dev/null | sed -n 's/^@\([0-9][0-9]*\)$/\1/p' | sort -n | tail -n1
}

# ...and as "Sun 20 Sep, 03:12", in the session's language
last_run() {
    local latest
    latest="$(last_run_time "$1")"
    [[ -n "${latest}" ]] && date -d "@${latest}" '+%a %-d %b, %H:%M'
}

days_since() {
    echo $(((NOW - $1) / 86400))
}

# How long ago, as a sentence goes on: "today", "yesterday", "3 days ago"
days_ago() {
    local DAYS="$1"
    case "${DAYS}" in
        0) gettext "today" ;;
        1) gettext "yesterday" ;;
        *) eval_ngettext "\${DAYS} day ago" "\${DAYS} days ago" "${DAYS}" ;;
    esac
}

# rpm-ostree's list, not bootc's: `bootc status` needs root, and without it this reported every machine
# as running "unknown" with unchecked updates. The image reference is prefixed ostree-image-signed:
# exactly when bootc would report the containerPolicy signature. A sealed image has no rpm-ostree, and
# amethystora-deployments gives its deployments in the same shape.
SEALED=false
[[ -e /usr/share/amethystora/sealed ]] && SEALED=true
STATUS="$(/usr/libexec/amethystora-deployments 2>/dev/null || true)"
ref() { jq -r "[.deployments[] | select(.$1)][0][\"container-image-reference\"] // \"\"" <<<"${STATUS:-null}" 2>/dev/null; }
sig() { [[ "$1" == ostree-image-signed:* ]] && echo containerPolicy || echo none; }
BOOTED_REF="$(ref booted)"
IMAGE="$(sed -E 's|^[^:]+:(docker://)?||' <<<"${BOOTED_REF}")"
IMAGE="${IMAGE:-unknown}"
SIGNED="$(sig "${BOOTED_REF}")"
STAGED="$(sig "$(ref staged)")"
# Packages layered on with rpm-ostree. They decide which command follows a stream below: bootc
# builds the next deployment from the image alone and would drop them, rpm-ostree carries them over.
LAYERED="$(jq -r '[.deployments[] | select(.booted)][0] | ((.packages // []) + (."requested-local-packages" // [])) | length' <<<"${STATUS:-null}" 2>/dev/null)"
LAYERED="${LAYERED:-0}"

if [[ "${JSON}" != true ]]; then
    echo
    echo "  $(eval_gettext "This machine is running \${IMAGE}")"
fi

# --- Updates and boot ---------------------------------------------------------------------------------

if [[ "${SIGNED}" == "containerPolicy" ]]; then
    report updates signed-updates ok "$(gettext "Signed updates")" \
        "$(gettext "Updates are refused unless they carry this image's signature")"
elif [[ "${STAGED}" == "containerPolicy" ]]; then
    report updates signed-updates check "$(gettext "Signed updates")" \
        "$(gettext "Signature checking is staged, and turns on at the next restart")"
elif [[ "${SEALED}" == true ]]; then
    # A sealed machine has no origin to switch: every pull is checked against policy.json itself
    report updates signed-updates off "$(gettext "Signed updates")" "$(gettext "Updates are not signature-checked")" \
        "$(gettext "Anything that can answer for the registry could replace this machine's whole system.")" \
        "$(gettext "/etc/containers/policy.json no longer asks for this image's signature.")"
elif hardening_off signed-updates; then
    COMMAND="ame security signed-updates on"
    turned_off updates signed-updates "$(gettext "Signed updates")" "$(gettext "Signed updates are turned off")" \
        "$(gettext "Updates are not signature-checked, and this machine is not switched back to signed ones at each start. Anything that can answer for the registry could replace its whole system.")"
else
    COMMAND="sudo systemctl start amethystora-signed-updates.service"
    report updates signed-updates off "$(gettext "Signed updates")" "$(gettext "Updates are not signature-checked")" \
        "$(gettext "Anything that can answer for the registry could replace this machine's whole system.")" \
        "$(gettext "Fix it with this, then restart:")"
fi
# A dated tag names one build, not a stream: every update re-pulls that same build, forever. The stream
# can have more than one word (stable-sealed-44.20261004).
TAG="${IMAGE##*:}"
if [[ "${TAG}" =~ ^([a-z]+(-[a-z]+)*)-[0-9]+\.[0-9]{8} ]]; then
    STREAM="${BASH_REMATCH[1]}"
    if [[ "${LAYERED}" != "0" ]]; then
        COMMAND="sudo rpm-ostree rebase ostree-image-signed:docker://${IMAGE%:*}:${STREAM}"
    else
        COMMAND="sudo bootc switch --enforce-container-sigpolicy ${IMAGE%:*}:${STREAM}"
    fi
    report updates single-build check "$(gettext "Updates")" \
        "$(eval_gettext "This machine follows a single build (\${TAG}) and will not receive updates")" \
        "$(eval_gettext "Follow the \${STREAM} stream again with:")"
fi
if [[ "${LAYERED}" != "0" ]]; then
    report updates layered info "$(gettext "Layered packages")" \
        "$(eval_ngettext "\${LAYERED} package is layered on this image with rpm-ostree" "\${LAYERED} packages are layered on this image with rpm-ostree" "${LAYERED}")" \
        "$(gettext "Updates keep them, but each one slows every update; the image is the better place")"
fi

# How old the running system is. A fix to anything in the image reaches this machine only as a newer
# image, so this is, in days, how long it has gone without the fixes made since. The deployment listed
# first is the one the next boot starts, which is an update waiting for a restart when it is newer.
BUILT="$(jq -r '[.deployments[] | select(.booted)][0].timestamp // empty' <<<"${STATUS:-null}" 2>/dev/null)"
NEXT_BUILT="$(jq -r 'if (.deployments[0].booted | not) then .deployments[0].timestamp // empty else empty end' \
    <<<"${STATUS:-null}" 2>/dev/null)"
if [[ "${BUILT}" =~ ^[0-9]+$ ]]; then
    AGE="$(days_since "${BUILT}")"
    if [[ "${AGE}" -le 14 ]]; then
        WHEN="$(days_ago "${AGE}")"
        report updates image-age ok "$(gettext "System image")" "$(eval_gettext "This system image was built \${WHEN}")"
    elif [[ "${NEXT_BUILT}" =~ ^[0-9]+$ && "${NEXT_BUILT}" -gt "${BUILT}" ]]; then
        report updates image-age info "$(gettext "System image")" "$(gettext "A newer system image is waiting for a restart")" \
            "$(eval_ngettext "The one running was built \${AGE} day ago. Restart to use the new one." "The one running was built \${AGE} days ago. Restart to use the new one." "${AGE}")"
    else
        COMMAND="ame update"
        SINCE="$(date -d "@${BUILT}" '+%-d %B')"
        report updates image-age check "$(gettext "System image")" \
            "$(eval_ngettext "This system image is \${AGE} day old" "This system image is \${AGE} days old" "${AGE}")" \
            "$(eval_gettext "Security fixes reach this machine as new images, and none has arrived since \${SINCE}.")" \
            "$(gettext "Update now with:")"
    fi
fi

if [[ "$(systemctl is-enabled uupd.timer 2>/dev/null)" != "enabled" ]]; then
    COMMAND="sudo systemctl enable --now uupd.timer"
    report updates automatic-updates check "$(gettext "Automatic updates")" "$(gettext "Automatic updates are off")" \
        "$(gettext "Turn them back on with:")"
else
    # uupd's own last word on a run, from the journal, which Fedora opens to the members of wheel
    FINISHED="$(journalctl -q -r -n1 -o short-unix -u uupd.service -u uupd-manual.service \
        -g 'Updates Completed Successfully' 2>/dev/null | grep -o '^[0-9]*' | head -n1)"
    if [[ ! "${FINISHED}" =~ ^[0-9]+$ ]]; then
        report updates automatic-updates ok "$(gettext "Automatic updates")" "$(gettext "Updates install by themselves")"
    elif [[ "$(days_since "${FINISHED}")" -gt 14 ]]; then
        COMMAND="ame update"
        DAYS="$(days_since "${FINISHED}")"
        report updates automatic-updates check "$(gettext "Automatic updates")" \
            "$(eval_ngettext "The last update that finished was \${DAYS} day ago" "The last update that finished was \${DAYS} days ago" "${DAYS}")" \
            "$(gettext "Updates start, but do not get to the end. System Updates shows why, or run one here:")"
    else
        WHEN="$(days_ago "$(days_since "${FINISHED}")")"
        report updates automatic-updates ok "$(gettext "Automatic updates")" \
            "$(eval_gettext "Updates install by themselves. The last one finished \${WHEN}")"
    fi
fi

# The containers amethystora-pkg manages, which a timer of the account's own upgrades every day
# (amethystora-pkg-upgrade.timer). One left alone for two weeks runs without the fixes its distribution
# has published since. They are each account's own: run as root by the security watcher, this sees none.
if [[ -d "${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/amethystora/pkg/containers" ]] &&
    command -v amethystora-pkg >/dev/null; then
    STALE=()
    COUNT=0
    while IFS=$'\t' read -r name since; do
        COUNT=$((COUNT + 1))
        if [[ "${since}" == 0 ]]; then
            STALE+=("$(eval_gettext "\${name}, never upgraded")")
        elif [[ "$(days_since "${since}")" -ge 14 ]]; then
            WHEN="$(days_ago "$(days_since "${since}")")"
            STALE+=("$(eval_gettext "\${name}, last upgraded \${WHEN}")")
        fi
    done < <(timeout 60 amethystora-pkg containers list --json 2>/dev/null |
        jq -r '.[] | [.name, (.last_upgrade // .created // 0 | tostring)] | @tsv' 2>/dev/null)
    if [[ ${#STALE[@]} -gt 0 ]]; then
        COMMAND="amethystora-pkg upgrade-all"
        N="${#STALE[@]}"
        report updates containers check "$(gettext "Containers")" \
            "$(eval_ngettext "\${N} container has not been upgraded for two weeks" "\${N} containers have not been upgraded for two weeks" "${N}")" \
            "${STALE[@]}" \
            "$(gettext "What runs in a container goes without the fixes its distribution has published since. Upgrade them now with:")"
    elif [[ "${COUNT}" -eq 1 ]]; then
        report updates containers ok "$(gettext "Containers")" \
            "$(gettext "The container amethystora-pkg manages is upgraded every day")"
    elif [[ "${COUNT}" -gt 1 ]]; then
        report updates containers ok "$(gettext "Containers")" \
            "$(eval_ngettext "The \${COUNT} container amethystora-pkg manages is upgraded every day" "The \${COUNT} containers amethystora-pkg manages are upgraded every day" "${COUNT}")"
    fi
fi

# What the signature buys is a trusted image at the moment it is pulled. Whether /usr is still
# checked afterwards is composefs's job, and that comes from the base image rather than from
# anything set here, so this reports what is actually mounted rather than what was intended. A sealed
# image boots with the digest of all its files on the signed kernel's command line, and its root is
# mounted only with fs-verity required.
if grep -Eq '(^| )composefs=[0-9a-f]+( |$)' /proc/cmdline 2>/dev/null &&
    findmnt -no OPTIONS / 2>/dev/null | grep -q 'verity=require'; then
    report updates composefs ok "$(gettext "Verified system files")" \
        "$(gettext "The system is sealed: every file of it is checked, as it is read, against the digest its signed kernel carries")"
elif grep -q composefs /proc/mounts 2>/dev/null; then
    report updates composefs ok "$(gettext "Verified system files")" \
        "$(gettext "The running system is on composefs: /usr is verified as it is read, not only when pulled")"
else
    report updates composefs info "$(gettext "Verified system files")" \
        "$(gettext "/usr is read-only and replaced whole by each update, but is not re-verified as it is read")"
fi

SB="$(mokutil --sb-state 2>/dev/null || true)"
if grep -qi "enabled" <<<"${SB}"; then
    report updates secure-boot ok "$(gettext "Secure Boot")" \
        "$(gettext "Secure Boot is on: this machine boots only a kernel it has checked")"
elif grep -qi "disabled" <<<"${SB}"; then
    COMMAND="ame security secure-boot"
    report updates secure-boot check "$(gettext "Secure Boot")" "$(gettext "Secure Boot is off")" \
        "$(gettext "The kernel protections below rest on it. Without it, anything that reaches root can boot a different kernel and step around them.")" \
        "$(gettext "Turn Secure Boot on in this machine's firmware, then run:")"
else
    report updates secure-boot check "$(gettext "Secure Boot")" \
        "$(gettext "Secure Boot state unknown (no EFI on this machine, or its firmware will not say)")"
fi

# The same check `ame security secure-boot` uses, so the two can no longer disagree
MOK="$(/usr/libexec/amethystora-mok-status)"
if ! grep -qv "^enrolled " <<<"${MOK}"; then
    report updates signing-keys ok "$(gettext "Signing keys")" "$(gettext "This image's signing keys are enrolled")"
elif grep -qi "enabled" <<<"${SB}"; then
    while read -r state cert rest; do
        CERT="${cert##*/}"
        case "${state}" in
            not-enrolled)
                COMMAND="ame security secure-boot"
                report updates "key-${CERT}" check "$(gettext "Signing keys")" "$(eval_gettext "Not enrolled: \${CERT}")" \
                    "$(gettext "What it signs, such as evdi for DisplayLink docks, will not load.")" \
                    "$(gettext "Enroll it with:")" ;;
            pending)
                report updates "key-${CERT}" check "$(gettext "Signing keys")" \
                    "$(eval_gettext "Enrollment of \${CERT} is waiting for the next restart")" \
                    "$(gettext "Finish it in the blue MOK manager screen that appears during boot.")" ;;
            missing)
                report updates "key-${CERT}" check "$(gettext "Signing keys")" "$(eval_gettext "\${cert} is not on this machine")" \
                    "$(gettext "Whether its key is enrolled cannot be checked without it.")" ;;
            unknown)
                report updates "key-${CERT}" check "$(gettext "Signing keys")" \
                    "$(eval_gettext "Could not tell whether \${CERT} is enrolled")" "$(eval_gettext "mokutil said: \${rest}")" ;;
        esac
    done <<<"${MOK}"
fi

LOCKDOWN=""
[[ -r /sys/kernel/security/lockdown ]] &&
    LOCKDOWN="$(sed -n 's/.*\[\([a-z]*\)\].*/\1/p' /sys/kernel/security/lockdown 2>/dev/null)"
[[ -n "${LOCKDOWN}" ]] || { grep -qw "lockdown=integrity" /proc/cmdline && LOCKDOWN=integrity; }
case "${LOCKDOWN}" in
    integrity | confidentiality)
        report updates lockdown ok "$(gettext "Kernel lockdown")" \
            "$(eval_gettext "Kernel lockdown is on (\${LOCKDOWN}): root cannot rewrite the running kernel")" ;;
    *)
        # Fedora's kernel locks itself down whenever it starts with Secure Boot, so this is a machine
        # without, where only the argument (ame security lockdown) turns it on. Nothing to do about the
        # NVIDIA images' choice, so that is information rather than something to check.
        if [[ "${IMAGE}" == *nvidia* ]]; then
            report updates lockdown info "$(gettext "Kernel lockdown")" \
                "$(gettext "Kernel lockdown is off, as it is on every NVIDIA image without Secure Boot")" \
                "$(gettext "The NVIDIA driver is a module signed with this machine's own key, which only Secure Boot makes the kernel trust: lockdown without it would leave the machine with no graphics driver at all.")"
        elif [[ "${SEALED}" == true ]]; then
            # Its kernel arguments are inside the signed UKI, which carries lockdown=integrity
            report updates lockdown check "$(gettext "Kernel lockdown")" "$(gettext "Kernel lockdown is off")" \
                "$(gettext "This sealed image's kernel asks for it, so something is overriding it: report it as a bug.")"
        else
            COMMAND="ame security lockdown on"
            report updates lockdown check "$(gettext "Kernel lockdown")" "$(gettext "Kernel lockdown is off")" \
                "$(gettext "Secure Boot is off, and this machine's kernel arguments leave out lockdown=integrity, which the image asks for. Root can then rewrite the running kernel.")" \
                "$(gettext "Turn it back on with:")"
        fi ;;
esac

# fwupd's rating of what the firmware protects, the Host Security ID: HSI:0 to HSI:5, with a "!" when
# something running weakens it, such as Secure Boot off or a kernel tainted by a module from outside it.
# How well a machine's firmware protects it is mostly its maker's doing, so this is said rather than
# flagged. Asking fwupd needs no password.
HSI="$(busctl get-property org.freedesktop.fwupd / org.freedesktop.fwupd HostSecurityId 2>/dev/null |
    sed -n 's/^s "\(HSI:[0-9]!\{0,1\}\).*"$/\1/p')"
if [[ "${HSI}" =~ ^HSI:([0-9])(!?)$ ]]; then
    LEVEL="${BASH_REMATCH[1]}"
    FLAGGED="${BASH_REMATCH[2]}"
    ATTRIBUTES="$(timeout 30 fwupdmgr security --json 2>/dev/null || true)"
    # A platform key that is a test key whose private half was published (PKfail, 2024): anyone can then
    # sign what Secure Boot starts. fwupd's uefi-pk plugin rates it not-valid.
    if jq -e '.SecurityAttributes[]? | select(.AppstreamId == "org.fwupd.hsi.Uefi.Pk" and .HsiResult == "not-valid")' \
        <<<"${ATTRIBUTES}" >/dev/null 2>&1; then
        report updates firmware-pk check "$(gettext "Platform key")" \
            "$(gettext "The firmware's platform key is a test key that anyone can sign with")" \
            "$(gettext "Its maker shipped a key whose private half is published (PKfail), so anything signed with it starts with Secure Boot on. Only the maker can replace it: look for a firmware update, or ask them.")"
    fi
    COMMAND="fwupdmgr security"
    if [[ -n "${FLAGGED}" ]]; then
        mapfile -t WEAKENED < <(jq -r '.SecurityAttributes[]? |
            select(any(.Flags[]?; . == "runtime-issue") and (any(.Flags[]?; . == "success") | not)) | .Name // .AppstreamId' \
            <<<"${ATTRIBUTES}" 2>/dev/null)
        report updates firmware-security info "$(gettext "Firmware security")" \
            "$(eval_gettext "fwupd rates this machine's firmware protections \${LEVEL} of 5, and something running weakens them")" \
            "${WEAKENED[@]}" "$(gettext "Every protection fwupd looks at, with what each is:")"
    else
        report updates firmware-security info "$(gettext "Firmware security")" \
            "$(eval_gettext "fwupd rates this machine's firmware protections \${LEVEL} of 5")" \
            "$(gettext "That is mostly up to the machine's maker. Every protection fwupd looks at, with what each is:")"
    fi
fi

# A newer list of the boot programs Secure Boot must refuse (the UEFI dbx) than the firmware holds, from
# the LVFS metadata fwupd-refresh.timer fetches. Asking needs no password, and with --json fwupdmgr asks
# nothing; it says {"Devices":[]} when there is nothing to install.
FIRMWARE_UPDATES="$(timeout 30 fwupdmgr get-updates --json 2>/dev/null || true)"
if jq -e '.Devices[]? | select(.Plugin == "uefi_dbx" and ((.Releases // []) | length > 0))' \
    <<<"${FIRMWARE_UPDATES}" >/dev/null 2>&1; then
    COMMAND="fwupdmgr update"
    report updates firmware-dbx check "$(gettext "Revoked boot programs")" \
        "$(gettext "The firmware's list of boot programs to refuse is out of date")" \
        "$(gettext "Until the newer list is installed, Secure Boot still starts boot programs known to let an attacker past it. fwupd refuses to install it while a boot program on this machine is one the list refuses.")" \
        "$(gettext "Install it with:")"
fi

# --- Watching -----------------------------------------------------------------------------------------

if [[ "${SETTING[AUDIT_LOG]}" == off ]]; then
    COMMAND="ame security settings audit-log on"
    turned_off watching audit-log "$(gettext "Audit log")" "$(gettext "The audit log is turned off")" \
        "$(gettext "Nothing records changes to accounts, sudo, what starts by itself or the security settings, from the restart after it was turned off. Back on, it records from the next restart.")"
elif [[ "$(systemctl is-active auditd.service 2>/dev/null)" == "active" ]]; then
    report watching audit-log ok "$(gettext "Audit log")" "$(gettext "The audit log is recording")"
else
    COMMAND="sudo systemctl start auditd.service"
    report watching audit-log off "$(gettext "Audit log")" "$(gettext "The audit log is not recording")" "$(gettext "Start it with:")"
fi
if [[ "${SETTING[AUDIT_LOG]}" != off && -f /etc/audit/rules.d/99-amethystora-finalize.rules ]]; then
    # The keys switched off load no rule from the next restart (amethystora-audit-home-rules)
    KEYS_OFF=()
    for key in IDENTITY PRIVILEGE PERSISTENCE HARDENING MODULES INPUT_CAPTURE USER_PROGRAMS; do
        [[ "${SETTING[${key}]}" == off ]] && KEYS_OFF+=("$(tr 'A-Z_' 'a-z-' <<<"${key}")")
    done
    # The events the kernel dropped in the last week, which only the watcher, as root, can count
    DROPPED="$(jq -r '[.audit.drops // [] | .[] | .count] | add // 0' "${WATCH_STATUS}" 2>/dev/null)"
    ENABLED="$(jq -r '.audit.enabled // empty' "${WATCH_STATUS}" 2>/dev/null)"
    if [[ "${DROPPED}" =~ ^[1-9][0-9]*$ ]]; then
        report watching audit-rules check "$(gettext "Audit rules")" \
            "$(eval_ngettext "The audit log dropped \${DROPPED} event in the last week" "The audit log dropped \${DROPPED} events in the last week" "${DROPPED}")" \
            "$(gettext "The kernel drops an event rather than make anything wait when too many come at once, and what happened then was not recorded. Many at once can also be someone hiding a change in the noise.")"
    elif [[ "${ENABLED}" =~ ^[01]$ ]]; then
        report watching audit-rules check "$(gettext "Audit rules")" "$(gettext "The audit rules are not locked")" \
            "$(gettext "Anything that reaches root can take them away without a restart. They lock at boot; something unlocked them, or they did not load to the end.")"
    elif [[ ${#KEYS_OFF[@]} -gt 0 ]]; then
        COMMAND="ame security settings"
        KEYS="$(IFS=,; echo "${KEYS_OFF[*]}" | sed 's/,/, /g')"
        report watching audit-rules info "$(gettext "Audit rules")" "$(gettext "Audit rules are immutable until the next reboot")" \
            "$(eval_gettext "Turned off, and not recorded from the next restart: \${KEYS}.")" \
            "$(gettext "Turn them back on with:")"
    else
        report watching audit-rules ok "$(gettext "Audit rules")" "$(gettext "Audit rules are immutable until the next reboot")"
    fi
fi
# SELinux confines the system's services: one that is broken into reaches only what its policy allows. An
# enforcing=0 kernel argument or `setenforce 0` would turn that off silently, so it is said.
SELINUX_ENFORCE="$(cat /sys/fs/selinux/enforce 2>/dev/null || true)"
if [[ "${SELINUX_ENFORCE}" == 1 ]]; then
    report watching selinux ok "$(gettext "SELinux")" "$(gettext "SELinux is enforcing: each system service reaches only what its policy allows")"
elif [[ "${SELINUX_ENFORCE}" == 0 ]]; then
    COMMAND="sudo setenforce 1"
    report watching selinux check "$(gettext "SELinux")" "$(gettext "SELinux is permissive")" \
        "$(gettext "It records what it would refuse and refuses nothing. If you did not turn it off to find a problem, something else did. An enforcing=0 kernel argument does it at every start. Enforce it again until the next restart with:")"
else
    report watching selinux off "$(gettext "SELinux")" "$(gettext "SELinux is off")" \
        "$(gettext "No system service is confined. Fedora keeps it on; something turned it off with selinux=0 or in /etc/selinux/config.")"
fi
if hardening_off failed-logins; then
    COMMAND="ame security failed-logins on"
    turned_off watching fail2ban "$(gettext "Failed logins")" "$(gettext "Blocking addresses after failed logins is turned off")" \
        "$(gettext "An address that keeps guessing SSH passwords is not blocked.")"
elif [[ "$(systemctl is-active fail2ban.service 2>/dev/null)" == "active" ]]; then
    report watching fail2ban ok "$(gettext "Failed logins")" \
        "$(gettext "Repeated failed logins get the address blocked (ame security addresses)")"
else
    COMMAND="sudo systemctl start fail2ban.service"
    report watching fail2ban check "$(gettext "Failed logins")" "$(gettext "fail2ban is not running")" "$(gettext "Start it with:")"
fi
if hardening_off lockout; then
    COMMAND="ame security lockout on"
    turned_off watching lockout "$(gettext "Account lockout")" "$(gettext "Account lockout is turned off")" \
        "$(gettext "No account is locked however many wrong passwords are typed, at the login and lock screens, sudo or an administrator prompt.")"
fi
if hardening_off ssh-settings; then
    COMMAND="ame security ssh-settings on"
    turned_off watching ssh-settings "$(gettext "SSH server settings")" "$(gettext "The image's SSH server settings are turned off")" \
        "$(gettext "If the SSH server is on, root may log in with a key, six tries a connection are allowed, and X11 is forwarded.")"
fi
ZONE="$(firewall-cmd --get-default-zone 2>/dev/null || echo unknown)"
if hardening_off firewall; then
    COMMAND="ame security firewall on"
    turned_off watching firewall "$(gettext "Firewall")" "$(eval_gettext "The Amethystora zone is turned off: the firewall's default zone is \${ZONE}")" \
        "$(gettext "Fedora Workstation's zone lets in every port from 1025 up, from every network.")"
elif [[ "${ZONE}" == "amethystora" ]]; then
    report watching firewall ok "$(gettext "Firewall")" \
        "$(gettext "Firewall is on the amethystora zone: nothing incoming that a desktop does not need")"
else
    COMMAND="sudo firewall-cmd --set-default-zone=amethystora"
    report watching firewall check "$(gettext "Firewall")" "$(eval_gettext "Firewall default zone is \${ZONE}, not amethystora")" \
        "$(gettext "Put it back with:")"
fi

# Network protection is a setting, so when it is on, Suricata is expected to be running, to have the
# kernel's queue to read from, and to have rules to read it with. Whether the table is there and how old
# the rules are only root can see, so the watcher writes them into status.json at each of its runs.
if [[ "${NETWORK}" != off ]]; then
    RULES_TIME="$(jq -r '.network.rules // empty' "${WATCH_STATUS}" 2>/dev/null)"
    TABLE="$(jq -r '.network.table // empty' "${WATCH_STATUS}" 2>/dev/null)"
    BLOCKED="$(jq -r '.network.blocked // 0' "${WATCH_STATUS}" 2>/dev/null)"
    if [[ "${NETWORK}" == block ]]; then
        NETWORK_TEXT="$(gettext "Suricata blocks connections to known malware, command servers and exploits")"
    else
        NETWORK_TEXT="$(gettext "Suricata inspects every connection and says what it recognises, without blocking")"
    fi
    if ! systemctl is-active --quiet amethystora-ips.service 2>/dev/null; then
        COMMAND="sudo systemctl restart amethystora-ips.service"
        report watching network check "$(gettext "Network protection")" "$(gettext "Network protection is on, but not running")" \
            "$(gettext "Connections pass without being inspected until it runs again. Start it with:")"
    elif [[ "${TABLE}" == false ]]; then
        COMMAND="sudo systemctl restart amethystora-ips.service"
        report watching network check "$(gettext "Network protection")" "$(gettext "Network protection is running, but no traffic reaches it")" \
            "$(gettext "Its nftables table (inet amethystora-ips) is gone, so connections pass without being inspected. Put it back with:")"
    elif [[ ! "${RULES_TIME}" =~ ^[0-9]+$ ]]; then
        COMMAND="sudo systemctl start amethystora-ips-rules.service"
        report watching network check "$(gettext "Network protection")" "$(gettext "Network protection has no rules yet")" \
            "$(gettext "Nothing is recognised until the rules have downloaded once. Download them now with:")"
    elif [[ "$(days_since "${RULES_TIME}")" -gt 7 ]]; then
        COMMAND="sudo systemctl start amethystora-ips-rules.service"
        DAYS="$(days_since "${RULES_TIME}")"
        report watching network check "$(gettext "Network protection")" \
            "$(eval_ngettext "The network protection rules are \${DAYS} day old" "The network protection rules are \${DAYS} days old" "${DAYS}")" \
            "$(gettext "They download every day, and newer attacks are not recognised until they do. Check this machine's network, or try now with:")"
    elif [[ "${BLOCKED}" =~ ^[1-9][0-9]*$ ]]; then
        COMMAND="ame security connections"
        report watching network ok "$(gettext "Network protection")" "${NETWORK_TEXT}" \
            "$(eval_ngettext "It blocked \${BLOCKED} connection in the last 7 days. See it with:" "It blocked \${BLOCKED} connections in the last 7 days. See them with:" "${BLOCKED}")"
    else
        report watching network ok "$(gettext "Network protection")" "${NETWORK_TEXT}"
    fi
fi

# A pause of encrypted DNS, for a network's login page, ends by itself within ten minutes
if /usr/libexec/amethystora-dns paused; then
    COMMAND="ame security dns resume"
    report watching encrypted-dns-paused check "$(gettext "Encrypted DNS")" "$(gettext "Encrypted DNS is paused")" \
        "$(gettext "The network's own DNS servers answer in plain text until the pause ends by itself, ten minutes after it began. End it now with:")"
fi

# The security watcher (/usr/libexec/amethystora-security-watch). What it noticed and nobody has looked
# at yet is in a root-only file, whose size shows through /var/log, as the virus scan's findings do.
if [[ -s /var/log/amethystora-security-events.new ]]; then
    COMMAND="ame security events"
    report watching security-watcher off "$(gettext "Security watcher")" "$(gettext "The security watcher noticed something")" \
        "$(gettext "A change to accounts, to what starts by itself or to a security setting, or a program reading the keyboard directly. See it with:")"
elif [[ "${SETTING[WATCHER]}" == off ]]; then
    COMMAND="ame security settings watcher on"
    turned_off watching security-watcher "$(gettext "Security watcher")" "$(gettext "The security watcher is turned off")" \
        "$(gettext "Nothing reads the audit log or the journal, compares the settings with the image's, or says what changed.")"
elif [[ "$(systemctl is-enabled amethystora-security-watch.timer 2>/dev/null)" != "enabled" ]]; then
    COMMAND="sudo systemctl enable --now amethystora-security-watch.timer"
    report watching security-watcher check "$(gettext "Security watcher")" "$(gettext "The security watcher is off")" \
        "$(gettext "Turn it back on with:")"
elif [[ "$(systemctl show -p Result --value amethystora-security-watch.service 2>/dev/null)" =~ ^(exit-code|signal|core-dump|timeout)$ ]]; then
    COMMAND="journalctl -u amethystora-security-watch.service -n 40"
    report watching security-watcher check "$(gettext "Security watcher")" "$(gettext "The security watcher's last run failed")" \
        "$(gettext "See why with:")"
elif CHECKED="$(jq -r '.checked // empty' "${WATCH_STATUS}" 2>/dev/null)" && [[ "${CHECKED}" =~ ^[0-9]+$ ]] &&
    [[ $((NOW - CHECKED)) -gt 3600 && "$(cut -d' ' -f1 /proc/uptime 2>/dev/null | cut -d. -f1)" -gt 3600 ]]; then
    # It runs every 15 minutes; one that has not finished for an hour is stuck or kept from running
    COMMAND="journalctl -u amethystora-security-watch.service -n 40"
    HOURS="$(((NOW - CHECKED) / 3600))"
    report watching security-watcher check "$(gettext "Security watcher")" \
        "$(eval_ngettext "The security watcher has not finished a run for \${HOURS} hour" "The security watcher has not finished a run for \${HOURS} hours" "${HOURS}")" \
        "$(gettext "Nothing is read or said until it does. See why with:")"
elif [[ "${SETTING[REALTIME_WATCH]}" == on && "${SETTING[AUDIT_LOG]}" != off ]]; then
    report watching security-watcher ok "$(gettext "Security watcher")" \
        "$(gettext "The security watcher reads the audit log and checks the settings as they happen")"
else
    report watching security-watcher ok "$(gettext "Security watcher")" \
        "$(gettext "The security watcher reads the audit log and checks the settings every 15 minutes")"
fi

# Real-time watching and scanning are settings, so when one is on, what does it is expected to be running
REALTIME_UNITS=()
[[ "${SETTING[REALTIME_WATCH]}" == on && "${SETTING[WATCHER]}" != off && "${SETTING[AUDIT_LOG]}" != off ]] &&
    REALTIME_UNITS+=(amethystora-security-realtime)
[[ "${SETTING[REALTIME_SCAN]}" == on && "${SETTING[VIRUS_SCAN]}" != off ]] && REALTIME_UNITS+=(amethystora-clamav-onaccess)
if [[ ${#REALTIME_UNITS[@]} -gt 0 ]]; then
    STOPPED=()
    for unit in "${REALTIME_UNITS[@]}"; do
        systemctl is-active --quiet "${unit}.service" 2>/dev/null || STOPPED+=("${unit}.service")
    done
    # Not "realtime": that is the setting's tile below, and the app finds a check's command by its id
    if [[ ${#STOPPED[@]} -eq 0 && ${#REALTIME_UNITS[@]} -eq 2 ]]; then
        report watching realtime-running ok "$(gettext "Real-time watching")" \
            "$(gettext "Real-time watching is on: changes are read as they happen, and files scanned as they are written")"
    elif [[ ${#STOPPED[@]} -eq 0 && "${REALTIME_UNITS[0]}" == amethystora-security-realtime ]]; then
        report watching realtime-running ok "$(gettext "Real-time watching")" \
            "$(gettext "Real-time watching is on: changes are read as they happen")"
    elif [[ ${#STOPPED[@]} -eq 0 ]]; then
        report watching realtime-running ok "$(gettext "Real-time watching")" \
            "$(gettext "Real-time scanning is on: files are scanned as they are written")"
    else
        COMMAND="sudo systemctl restart ${STOPPED[*]}"
        UNITS="${STOPPED[*]}"
        report watching realtime-running check "$(gettext "Real-time watching")" "$(gettext "Real-time watching is on, but not running")" \
            "$(eval_gettext "Not running: \${UNITS}. Real-time scanning waits for the first virus signatures.")" \
            "$(gettext "Start it with:")"
    fi
fi

# Ransomware protection is a timer, so when it is on, the latest snapshot is expected to be at most an
# hour or two old. Each is named for when it was taken, and /var/home/.snapshots is readable by anyone.
SNAPSHOT_TIMER=false
systemctl is-enabled --quiet amethystora-home-snapshot.timer 2>/dev/null && SNAPSHOT_TIMER=true
if [[ "${SNAPSHOT_TIMER}" == true ]]; then
    LATEST=""
    for dir in /var/home/.snapshots/*; do
        [[ "${dir##*/}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$ ]] && LATEST="${dir##*/}"
    done
    TAKEN=""
    [[ -n "${LATEST}" ]] && TAKEN="$(date -d "${LATEST:0:10} ${LATEST:11:2}:${LATEST:13:2}" +%s 2>/dev/null)"
    # Not "ransomware-protection": that is the tile below, and the app finds a check's command by its id
    if [[ ! "${TAKEN}" =~ ^[0-9]+$ ]]; then
        COMMAND="journalctl -u amethystora-home-snapshot.service -n 40"
        report watching home-snapshots check "$(gettext "Ransomware protection")" \
            "$(gettext "Ransomware protection is on, but no snapshot has been taken")" "$(gettext "See why with:")"
    elif [[ $((NOW - TAKEN)) -gt 10800 ]]; then
        COMMAND="journalctl -u amethystora-home-snapshot.service -n 40"
        HOURS="$(((NOW - TAKEN) / 3600))"
        report watching home-snapshots check "$(gettext "Ransomware protection")" \
            "$(eval_ngettext "The latest snapshot of the home folders is \${HOURS} hour old" "The latest snapshot of the home folders is \${HOURS} hours old" "${HOURS}")" \
            "$(gettext "They are taken every hour. See why the last ones were not with:")"
    else
        AT="$(date -d "@${TAKEN}" '+%H:%M')"
        report watching home-snapshots ok "$(gettext "Ransomware protection")" \
            "$(eval_gettext "The home folders are snapshotted every hour. The latest is from \${AT}")"
    fi
fi

# The daily backup, while it is on, is expected to have succeeded within the week, when Time Machine warns
# too. amethystora-restore says when it last did and whether that is too long ago, as the Backups window
# shows it. As root, which is how the security watcher runs this, there is no backup to see.
BACKUP_STATUS="$(/usr/libexec/amethystora-restore status --json 2>/dev/null || true)"
if [[ "$(jq -r '.backup.daily // false' <<<"${BACKUP_STATUS}" 2>/dev/null)" == true ]]; then
    LAST="$(jq -r '.backup.last_success // empty' <<<"${BACKUP_STATUS}")"
    # Not "backups": that is the tile below, and the app finds a check's command by its id
    if [[ "$(jq -r '.backup.stale' <<<"${BACKUP_STATUS}")" == true ]]; then
        COMMAND="journalctl --user -u amethystora-backup.service -n 40"
        if [[ -n "${LAST}" ]]; then
            DAYS="$(days_since "${LAST}")"
            report watching backup-runs check "$(gettext "Backups")" \
                "$(eval_ngettext "No backup has succeeded for \${DAYS} day" "No backup has succeeded for \${DAYS} days" "${DAYS}")" \
                "$(gettext "It runs once a day. See why the last ones failed with:")"
        else
            report watching backup-runs check "$(gettext "Backups")" \
                "$(gettext "The daily backup is on, but none has succeeded yet")" "$(gettext "See why with:")"
        fi
    elif [[ -n "${LAST}" ]]; then
        WHEN="$(days_ago "$(days_since "${LAST}")")"
        report watching backup-runs ok "$(gettext "Backups")" \
            "$(eval_gettext "Your home folder is backed up every day. The last backup succeeded \${WHEN}")"
    fi
fi

# The image's security settings as this machine actually has them. The kernel settings and arguments and
# the blocked modules are read live: a file in /etc/sysctl.d or /etc/modprobe.d undoes them without
# touching /usr. What only root can compare, /etc against the image's own copy in /usr/etc, comes from
# the watcher.
DIFFERS=()
ADDED=()
# What the owner turned off with its switch is said as that (below), and not counted as a difference
if hardening_off kernel; then
    COMMAND="ame security kernel on"
    turned_off updates kernel "$(gettext "Kernel settings")" "$(gettext "The image's kernel settings are turned off")" \
        "$(gettext "From the restart after it was turned off, programs can read each other's memory, kernel addresses and messages show without sudo, and unprivileged BPF is allowed.")"
else
    while IFS='=' read -r key value; do
        key="${key//[[:space:]]/}"
        value="${value//[[:space:]]/}"
        [[ -n "${key}" && "${key}" != \#* ]] || continue
        live="$(cat "/proc/sys/${key//.//}" 2>/dev/null)" || continue
        [[ "${live//[[:space:]]/}" == "${value}" ]] ||
            DIFFERS+=("$(eval_gettext "The kernel setting \${key} is \${live}, not \${value}")")
    done </usr/lib/sysctl.d/60-amethystora-hardening.conf
fi
CMDLINE=" $(cat /proc/cmdline 2>/dev/null) "
KARGS_OFF=()
for karg in $(sed -n 's/^kargs *= *\[\(.*\)\]/\1/p' /usr/lib/bootc/kargs.d/10-amethystora-hardening.toml | tr -d '",'); do
    if hardening_off kernel-args "${karg}"; then
        KARGS_OFF+=("${karg}")
    elif [[ "${CMDLINE}" != *" ${karg} "* ]]; then
        DIFFERS+=("$(eval_gettext "The kernel argument \${karg} is missing")")
    fi
done
if [[ ${#KARGS_OFF[@]} -gt 0 ]]; then
    COMMAND="ame security kernel-args"
    KARGS="${KARGS_OFF[*]}"
    turned_off updates kernel-args "$(gettext "Kernel arguments")" "$(eval_gettext "Turned off, from the next restart: \${KARGS}")" \
        "$(gettext "Each one can be turned back on alone.")"
fi
if hardening_off blocked-modules; then
    COMMAND="ame security blocked-modules on"
    turned_off updates blocked-modules "$(gettext "Blocked kernel modules")" "$(gettext "Rarely used kernel modules are no longer blocked")" \
        "$(gettext "Old network protocols and filesystems, FireWire and test drivers can load, and a flaw in one of them can be reached.")"
else
    SHOWCONFIG="$(modprobe --showconfig 2>/dev/null)"
    if [[ -n "${SHOWCONFIG}" ]]; then
        while read -r _ module _; do
            grep -qxF "install ${module//-/_} /usr/bin/false" <<<"${SHOWCONFIG}" ||
                DIFFERS+=("$(eval_gettext "The kernel module \${module} is no longer blocked")")
        done < <(grep '^install ' /usr/lib/modprobe.d/60-amethystora-hardening.conf)
    fi
fi
while IFS=$'\t' read -r change path detail; do
    case "${change}" in
        changed) DIFFERS+=("$(eval_gettext "\${path} is changed on this machine")") ;;
        removed) DIFFERS+=("$(eval_gettext "\${path}, which the image ships, is gone")") ;;
        replaces) DIFFERS+=("$(eval_gettext "\${path} replaces the image's \${detail}")") ;;
        overrides) DIFFERS+=("$(eval_gettext "\${path} changes how \${detail} runs")") ;;
        masks) DIFFERS+=("$(eval_gettext "\${path} stops \${detail} from ever starting")") ;;
        added) ADDED+=("${path}") ;;
    esac
done < <(jq -r '.drift // [] | .[] | [.change, .path, .detail] | @tsv' "${WATCH_STATUS}" 2>/dev/null)
if [[ "${SETTING[IMAGE_DRIFT]}" == off ]]; then
    COMMAND="ame security settings image-drift on"
    turned_off watching image-settings "$(gettext "Image settings")" "$(gettext "Comparing the settings with the image's is turned off")" \
        "$(gettext "A security setting changed in /etc, or a kernel setting changed while the machine runs, is not noticed.")"
elif [[ ${#DIFFERS[@]} -gt 0 ]]; then
    N="${#DIFFERS[@]}"
    report watching image-settings check "$(gettext "Image settings")" \
        "$(eval_ngettext "\${N} security setting differs from the image" "\${N} security settings differ from the image" "${N}")" \
        "${DIFFERS[@]}" \
        "$(gettext "If you did not change these, find out what did. The image's own copy of anything in /etc is in /usr/etc, to compare or copy back.")"
elif [[ ${#ADDED[@]} -gt 0 ]]; then
    PATHS="${ADDED[*]}"
    report watching image-settings ok "$(gettext "Image settings")" "$(gettext "The image's security settings are as it ships them")" \
        "$(eval_gettext "Added on this machine: \${PATHS}")"
else
    report watching image-settings ok "$(gettext "Image settings")" "$(gettext "The image's security settings are as it ships them")"
fi

# Groups whose members become root without the sudo password: Docker's socket starts a container that
# mounts /, incus-admin makes privileged containers, and libvirt's qemu:///system attaches any disk.
# Developer mode offers them (ame system dx-group) and joins nobody by itself. A member chose it, or was
# put there by an older image, which joined every administrator: it is said either way.
ROOT_GROUPS=()
while read -r group root _; do
    [[ "${root}" == root ]] || continue
    members="$(getent group "${group}" 2>/dev/null | cut -d: -f4)"
    [[ -n "${members}" ]] && ROOT_GROUPS+=("${group}: ${members//,/, }")
done < <(grep -v '^#' /usr/share/amethystora/developer-groups 2>/dev/null)
if [[ ${#ROOT_GROUPS[@]} -gt 0 ]]; then
    COMMAND="ame system dx-group"
    report watching root-groups info "$(gettext "Groups that amount to root")" \
        "$(gettext "Some accounts can become root without the sudo password")" \
        "${ROOT_GROUPS[@]}" \
        "$(gettext "Any program running as one of them can take over the machine without asking. Choose your own account's groups with:")"
fi

# A domain this machine joined (realmd: Settings' Enterprise Login, or `realm join`), whose accounts can
# then log in here as well as this machine's own. Every join writes the machine's Kerberos keytab, so
# realmd is not started to ask on a machine without one.
DOMAINS=""
[[ -e /etc/krb5.keytab ]] &&
    DOMAINS="$(timeout 10 realm list --name-only 2>/dev/null | paste -sd, - | sed 's/,/, /g')"
if [[ -n "${DOMAINS}" ]]; then
    report watching domain-login info "$(gettext "Domain login")" \
        "$(eval_gettext "Accounts from \${DOMAINS} can log in to this machine")" \
        "$(gettext "Anyone the domain's administrators allow can log in here, as well as this machine's own accounts.")"
fi

# What a rootkit leaves behind, reduced to what cannot happen on an image-based system by accident:
# every setuid program and kernel module the image has is under /usr, and nothing there changes.
SIGNS=()
[[ -e /etc/ld.so.preload ]] &&
    SIGNS+=("$(gettext "/etc/ld.so.preload exists: it loads a library into every program that starts")")
while IFS= read -r file; do
    [[ -n "${file}" ]] && SIGNS+=("$(eval_gettext "A setuid program outside the image: \${file}")")
done < <(jq -r '.setuid // [] | .[]' "${WATCH_STATUS}" 2>/dev/null)
while IFS= read -r file; do
    SIGNS+=("$(eval_gettext "A plain file in /dev, where only devices belong: \${file}")")
done < <(find /dev -xdev -type f 2>/dev/null)
# The system's files belong to root or to a service. One owned by a login account lets that account change
# what root runs, as an earlier amethystora-audit-home-rules could be led to arrange (20-tests.sh checks
# that the image ships none, so any is the machine's own)
while IFS= read -r file; do
    SIGNS+=("$(eval_gettext "Owned by a login account, which can change what root runs: \${file}")")
done < <(find /etc /var/usrlocal -xdev -uid +999 ! -uid 65534 2>/dev/null | head -n 20)
MODULES_DIR="/usr/lib/modules/$(uname -r)"
if [[ -r "${MODULES_DIR}/modules.dep" && -r /proc/modules ]]; then
    # "extra" for the modules built with the image (akmods, evdi), "tree" for the kernel's own
    declare -A IMAGE_MODULES=()
    while read -r kind name; do
        IMAGE_MODULES["${name}"]="${kind}"
    done < <(awk -F: '{
        kind = ($1 ~ /^(extra|updates)\//) ? "extra" : "tree"
        name = $1; sub(/.*\//, "", name); sub(/\.ko(\.[a-z0-9]+)?$/, "", name); gsub(/-/, "_", name)
        print kind, name
    }' "${MODULES_DIR}/modules.dep")
    while read -r name _; do
        if [[ -z "${IMAGE_MODULES[${name}]+set}" ]]; then
            SIGNS+=("$(eval_gettext "The kernel module \${name} did not come with this image")")
        elif [[ "$(cat "/sys/module/${name}/taint" 2>/dev/null)" == *E* && "${IMAGE_MODULES[${name}]}" != extra ]]; then
            SIGNS+=("$(eval_gettext "The kernel module \${name} is not signed")")
        fi
    done </proc/modules
fi
for interface in /sys/class/net/*; do
    name="${interface##*/}"
    # Bridges' ports see every packet by design: that is how containers and virtual machines connect
    [[ "${name}" =~ ^(lo|veth|virbr|vnet|docker|br-|podman|cni|tap) ]] && continue
    flags="$(cat "${interface}/flags" 2>/dev/null)" || continue
    [[ "${flags}" =~ ^0x[0-9a-fA-F]+$ ]] && ((flags & 0x100)) &&
        SIGNS+=("$(eval_gettext "The network interface \${name} reads every packet on its network (promiscuous mode)")")
done
if [[ ${#SIGNS[@]} -gt 0 ]]; then
    N="${#SIGNS[@]}"
    report watching rootkit off "$(gettext "Rootkit checks")" \
        "$(eval_ngettext "\${N} thing where nothing should be" "\${N} things where nothing should be" "${N}")" "${SIGNS[@]}" \
        "$(gettext "Each is either something you set up yourself, or something to look into now.")"
else
    report watching rootkit ok "$(gettext "Rootkit checks")" \
        "$(gettext "Nothing where it should not be: no preloaded library, no setuid programs outside the image, no unknown kernel modules")"
fi
if [[ "${SETTING[SETUID_SWEEP]}" == off ]]; then
    COMMAND="ame security settings setuid-sweep on"
    turned_off watching setuid-sweep "$(gettext "Setuid sweep")" "$(gettext "The daily search for setuid programs is turned off")" \
        "$(gettext "A setuid program put outside the image, which runs as root whoever starts it, is not found.")"
fi

# The parts of the watcher with no check of their own, each said here when its owner turned it down
QUIETER=()
[[ "${SETTING[JOURNAL]}" == off ]] &&
    QUIETER+=("$(gettext "Locked accounts, wrong passwords and blocked USB devices are not read from the journal.")")
[[ "${SETTING[USER_PATHS]}" == off ]] &&
    QUIETER+=("$(gettext "Commands named like the system's and launchers no container made are not looked for in home folders.")")
[[ "${SETTING[REPORT_ALERTS]}" == off ]] &&
    QUIETER+=("$(gettext "A check of this report that turns bad is not said.")")
case "${SETTING[NOTIFY]}" in
    critical) QUIETER+=("$(gettext "Only critical findings are notifications; the rest wait here and in ame security events.")") ;;
    none) QUIETER+=("$(gettext "Nothing is a notification; every finding waits here and in ame security events.")") ;;
esac
if [[ ${#QUIETER[@]} -gt 0 && "${SETTING[WATCHER]}" != off ]]; then
    COMMAND="ame security settings"
    report watching watcher-switches info "$(gettext "Security watcher")" "$(gettext "Parts of the watcher are turned down")" \
        "${QUIETER[@]}" "$(gettext "Turn them back on with:")"
fi

# What accepts connections from other machines, with the program's name, which only root can see. The
# firewall lets in only what a desktop needs from the local network, but the tailnet is trusted.
if [[ "${SETTING[LISTENERS]}" == off ]]; then
    COMMAND="ame security settings listeners on"
    turned_off watching listeners "$(gettext "Open to the network")" "$(gettext "Watching for programs that accept connections is turned off")" \
        "$(gettext "A program that starts listening for other machines is not noticed.")"
elif [[ -r "${WATCH_STATUS}" ]]; then
    LISTENING=()
    while IFS=$'\t' read -r program port; do
        LISTENING+=("$(eval_gettext "\${program}, on port \${port}")")
    done < <(jq -r '.listeners // [] | .[] | [.program, (.port | tostring)] | @tsv' "${WATCH_STATUS}" 2>/dev/null)
    if [[ ${#LISTENING[@]} -gt 0 ]]; then
        N="${#LISTENING[@]}"
        report watching listeners info "$(gettext "Open to the network")" \
            "$(eval_ngettext "\${N} program accepts connections from other machines" "\${N} programs accept connections from other machines" "${N}")" \
            "${LISTENING[@]}" \
            "$(gettext "The firewall lets in only what a desktop needs from the local network, but every device on your tailnet can reach these.")"
    else
        report watching listeners ok "$(gettext "Open to the network")" "$(gettext "No program accepts connections from other machines")"
    fi
fi

# --- Apps ---------------------------------------------------------------------------------------------

if hardening_off virtual-input; then
    COMMAND="ame security virtual-input on"
    turned_off apps virtual-input "$(gettext "Virtual keyboards")" "$(gettext "Apps can make a virtual keyboard")" \
        "$(gettext "Whoever sits at the machine, and every app that may reach all of /dev, can type into any window through /dev/uinput. Steam Input and OpenTabletDriver need it.")"
fi
if hardening_off app-sandbox; then
    COMMAND="ame security app-sandbox on"
    turned_off apps app-sandbox "$(gettext "App sandbox override")" "$(gettext "The image's override of every app's sandbox is turned off")" \
        "$(gettext "Each Flatpak app has what its own manifest asks for, X11, the input devices and the Flatpak service included, from its next start.")"
fi

# What each Flatpak can reach beyond its sandbox (/usr/libexec/amethystora-app-permissions, whose words
# are translated as these are). One that can leave it, through a whole bus, the Flatpak service, systemd
# or a place programs start from at login, is worth a look whoever granted it; X11 and the input devices,
# which the image takes from every app, only when granted back. Overrides are each account's own, so run
# as root by the security watcher this says nothing, as it does for the containers.
if [[ ${EUID} -ne 0 ]] && command -v flatpak >/dev/null; then
    PERMISSIONS="$(timeout 120 /usr/libexec/amethystora-app-permissions --json 2>/dev/null)"
    COUNT="$(jq -r 'length' <<<"${PERMISSIONS:-[]}" 2>/dev/null || echo 0)"
    mapfile -t ESCAPES < <(jq -r '.[] | . as $app | [.reaches[] | select(.id | IN("session-bus", "system-bus", "flatpak", "systemd", "autostart")) | .text] |
        select(length > 0) | "\($app.name): \(join("; "))"' <<<"${PERMISSIONS:-[]}" 2>/dev/null)
    mapfile -t TYPING < <(jq -r '.[] | . as $app | [.reaches[] | select(.id | IN("x11", "input")) | .text] |
        select(length > 0) | "\($app.name): \(join("; "))"' <<<"${PERMISSIONS:-[]}" 2>/dev/null)
    if [[ ${#ESCAPES[@]} -gt 0 ]]; then
        COMMAND="ame security apps"
        N="${#ESCAPES[@]}"
        report apps app-permissions check "$(gettext "App permissions")" \
            "$(eval_ngettext "\${N} app can leave its sandbox" "\${N} apps can leave their sandbox" "${N}")" \
            "${ESCAPES[@]}" \
            "$(gettext "Whatever runs in it can then do anything you can. If you did not mean it to, take it back in Flatseal, or see every app's permissions with:")"
    elif [[ ${#TYPING[@]} -gt 0 ]]; then
        COMMAND="ame security apps"
        N="${#TYPING[@]}"
        report apps app-permissions info "$(gettext "App permissions")" \
            "$(eval_ngettext "\${N} app was given back what the image takes from every app" "\${N} apps were given back what the image takes from every app" "${N}")" \
            "${TYPING[@]}" \
            "$(gettext "See every app's permissions with:")"
    elif [[ "${COUNT}" =~ ^[1-9][0-9]*$ ]]; then
        report apps app-permissions ok "$(gettext "App permissions")" \
            "$(eval_ngettext "No app can leave its sandbox or read what you type into another (\${COUNT} app checked)" "No app can leave its sandbox or read what you type into another (\${COUNT} apps checked)" "${COUNT}")"
    fi
fi

# --- Scans --------------------------------------------------------------------------------------------

# /var/log is traversable, so the size of the root-owned 0600 findings file is visible here even
# though its contents are not, and this never asks for a password
VIRUS_SCAN="${SETTING[VIRUS_SCAN]}"
if [[ -s /var/log/amethystora-clamav-findings.log ]]; then
    COMMAND="ame security scan"
    case "${ON_DETECTION}" in
        quarantine) DETECTED="$(gettext "Files it finds are moved to quarantine. See what it found with:")" ;;
        delete) DETECTED="$(gettext "Files it finds are deleted. See what it found with:")" ;;
        *) DETECTED="$(gettext "Files it finds are left where they are. See what it found with:")" ;;
    esac
    report scans virus-scan off "$(gettext "Weekly virus scan")" "$(gettext "The last virus scan found something")" \
        "${DETECTED}"
elif [[ "${VIRUS_SCAN}" == off ]]; then
    COMMAND="ame security settings virus-scan weekly"
    turned_off scans virus-scan "$(gettext "Virus scanner")" "$(gettext "The virus scanner is turned off")" \
        "$(gettext "Nothing is scanned, and no virus signatures are kept in memory or downloaded.")"
elif [[ "${VIRUS_SCAN}" == manual ]]; then
    COMMAND="ame security settings virus-scan weekly"
    LAST="$(last_run amethystora-clamav-scan || gettext "not yet")"
    report scans virus-scan info "$(gettext "Weekly virus scan")" \
        "$(eval_gettext "Scans run when you start one, and not every week. Last run: \${LAST}")" \
        "$(gettext "Scan every Sunday again with:")"
else
    LAST="$(last_run amethystora-clamav-scan || gettext "not yet")"
    report scans virus-scan ok "$(gettext "Weekly virus scan")" \
        "$(eval_gettext "Weekly virus scan, Sundays. Last run: \${LAST}")"
fi
# A scan that stopped running looks exactly like a machine with nothing to find, unless it is asked
if [[ "${VIRUS_SCAN}" != weekly ]]; then
    :
elif [[ "$(systemctl is-enabled amethystora-clamav-scan.timer 2>/dev/null)" != "enabled" ]]; then
    COMMAND="sudo systemctl enable --now amethystora-clamav-scan.timer"
    report scans virus-scan-schedule check "$(gettext "Weekly virus scan")" "$(gettext "The weekly virus scan is off")" \
        "$(gettext "Turn it back on with:")"
else
    RAN="$(last_run_time amethystora-clamav-scan)"
    if [[ -n "${RAN}" && "$(days_since "${RAN}")" -gt 8 ]]; then
        COMMAND="ame security scan now"
        DAYS="$(days_since "${RAN}")"
        report scans virus-scan-schedule check "$(gettext "Weekly virus scan")" \
            "$(eval_ngettext "The weekly virus scan last ran \${DAYS} day ago" "The weekly virus scan last ran \${DAYS} days ago" "${DAYS}")" \
            "$(gettext "It runs on Sundays, or at the next start after a Sunday the machine was off. Run it now with:")"
    fi
fi
AGE="$(/usr/libexec/amethystora-clamav-signature-age)" && SIG=0 || SIG=$?
# With the scanner off nothing downloads them, and their age says nothing
[[ "${VIRUS_SCAN}" == off ]] && SIG=off
case "${SIG}" in
    off) ;;
    0)
        WHEN="$(days_ago "${AGE}")"
        report scans signatures ok "$(gettext "Virus signatures")" "$(eval_gettext "Virus signatures updated \${WHEN}")" ;;
    2)
        report scans signatures check "$(gettext "Virus signatures")" \
            "$(eval_ngettext "Virus signatures are \${AGE} day old" "Virus signatures are \${AGE} days old" "${AGE}")" \
            "$(gettext "A clean scan proves little with signatures this old. Check this machine's network.")" ;;
    *)
        report scans signatures check "$(gettext "Virus signatures")" "$(gettext "No virus signatures yet")" \
            "$(gettext "clamav-freshclam.service has not finished its first download.")" ;;
esac
RAN="$(last_run_time amethystora-lynis-audit)"
if [[ "${SETTING[SETTINGS_AUDIT]}" == off ]]; then
    COMMAND="ame security settings settings-audit on"
    turned_off scans settings-audit "$(gettext "Settings audit")" "$(gettext "The monthly settings audit is turned off")" \
        "$(gettext "Lynis does not look for what changed since the last audit. ame security audit runs one when you ask.")"
elif [[ "$(systemctl is-enabled amethystora-lynis-audit.timer 2>/dev/null)" != "enabled" ]]; then
    COMMAND="sudo systemctl enable --now amethystora-lynis-audit.timer"
    report scans settings-audit check "$(gettext "Settings audit")" "$(gettext "The monthly settings audit is off")" \
        "$(gettext "Turn it back on with:")"
elif [[ -n "${RAN}" && "$(days_since "${RAN}")" -gt 35 ]]; then
    COMMAND="ame security audit"
    DAYS="$(days_since "${RAN}")"
    report scans settings-audit check "$(gettext "Settings audit")" \
        "$(eval_ngettext "The settings audit last ran \${DAYS} day ago" "The settings audit last ran \${DAYS} days ago" "${DAYS}")" \
        "$(gettext "Run it now with:")"
else
    COMMAND="ame security audit"
    LAST="$(last_run amethystora-lynis-audit || gettext "not yet")"
    report scans settings-audit ok "$(gettext "Settings audit")" \
        "$(eval_gettext "Monthly settings audit. Last run: \${LAST}")" \
        "$(gettext "Run it now with:")"
fi

# --- Off unless you turned it on ----------------------------------------------------------------------

# setup-security-key keeps one line per account in this file: the name, then each key
if awk -F: -v user="${USER:-$(id -un)}" '$1 == user && NF > 1 { found = 1 } END { exit !found }' \
    "${HOME:-/nonexistent}/.config/Yubico/u2f_keys" 2>/dev/null; then
    KEY=on
else
    KEY=off
fi
COMMAND="ame security key"
report optional security-key "${KEY}" "$(gettext "Security key")" \
    "$(gettext "Sign in, unlock the screen and approve sudo with a FIDO2 key instead of your password")"

# The image lets a finger in wherever the password is (authselect's with-fingerprint), so what is left
# to turn on is a finger enrolled with fprintd, which says "No devices available" without a reader
FINGERS="$(timeout 10 fprintd-list "${USER:-$(id -un)}" 2>&1)"
COMMAND="ame security fingerprint"
FINGERPRINT_TEXT="$(gettext "Sign in, unlock the screen and approve sudo with a finger instead of your password")"
if [[ -z "${FINGERS}" ]] || grep -qi "no devices" <<<"${FINGERS}"; then
    report optional fingerprint unavailable "$(gettext "Fingerprint")" "${FINGERPRINT_TEXT}" \
        "$(gettext "This machine has no fingerprint reader")"
elif grep -q '^ *- #' <<<"${FINGERS}"; then
    report optional fingerprint on "$(gettext "Fingerprint")" "${FINGERPRINT_TEXT}"
else
    report optional fingerprint off "$(gettext "Fingerprint")" "${FINGERPRINT_TEXT}"
fi

COMMAND="ame security ssh-codes"
report optional ssh-codes "$(/usr/libexec/amethystora-ssh-codes status)" "$(gettext "One-time codes for SSH")" \
    "$(gettext "A password login over SSH also asks for a code from an app on your phone, and a key logs in as before")"

if systemctl --user is-enabled --quiet amethystora-backup.timer 2>/dev/null; then BACKUP=on; else BACKUP=off; fi
COMMAND="ame backup"
report optional backups "${BACKUP}" "$(gettext "Backups")" \
    "$(gettext "A daily restic backup to a repository that ransomware on this machine cannot delete from")"

# Snapshots need the home folders on a btrfs subvolume of their own, whose root is always inode 256
COMMAND="ame security ransomware"
RANSOMWARE_TEXT="$(gettext "Hourly read-only snapshots of the home folders, which ransomware running as you cannot change or delete")"
if [[ "${SNAPSHOT_TIMER}" == true ]]; then
    report optional ransomware-protection on "$(gettext "Ransomware protection")" "${RANSOMWARE_TEXT}"
elif [[ "$(stat -f -c %T /var/home 2>/dev/null)" != btrfs || "$(stat -c %i /var/home 2>/dev/null)" != 256 ]]; then
    report optional ransomware-protection unavailable "$(gettext "Ransomware protection")" "${RANSOMWARE_TEXT}" \
        "$(gettext "Needs the home folders on a btrfs subvolume")"
else
    report optional ransomware-protection off "$(gettext "Ransomware protection")" "${RANSOMWARE_TEXT}"
fi

# Whether the TPM holds a key takes root to read off the disk. The kernel argument setup-disk-unlock
# adds with it does not, and without that argument the key is never used anyway.
COMMAND="ame security disk-unlock"
DISK_UNLOCK_TITLE="$(gettext "Unlock the disk with the TPM")"
DISK_UNLOCK_TEXT="$(gettext "The TPM hands over the disk key at boot, so you stop typing the passphrase")"
if grep -q "tpm2-device=auto" /proc/cmdline 2>/dev/null; then
    report optional disk-unlock on "${DISK_UNLOCK_TITLE}" "${DISK_UNLOCK_TEXT}"
elif [[ -z "$(/usr/libexec/amethystora-raid root-luks 2>/dev/null)" ]]; then
    # The system's own, not a pool's or any other encrypted disk's: those open with key files of their own
    report optional disk-unlock unavailable "${DISK_UNLOCK_TITLE}" "${DISK_UNLOCK_TEXT}" \
        "$(gettext "The system's disk is not encrypted")"
elif [[ ! -e /dev/tpmrm0 ]]; then
    report optional disk-unlock unavailable "${DISK_UNLOCK_TITLE}" "${DISK_UNLOCK_TEXT}" \
        "$(gettext "This machine has no usable TPM")"
elif ! grep -qi "enabled" <<<"${SB}"; then
    # Binding to Secure Boot is the whole of what it protects
    report optional disk-unlock unavailable "${DISK_UNLOCK_TITLE}" "${DISK_UNLOCK_TEXT}" \
        "$(gettext "Needs Secure Boot on")"
else
    report optional disk-unlock off "${DISK_UNLOCK_TITLE}" "${DISK_UNLOCK_TEXT}"
fi
# Whether the TPM's key asks for a PIN is in the LUKS header, which the watcher reads as root. Without a
# PIN, an image that is not sealed hands the key to whoever starts the machine their own way: its boot
# menu and initramfs are plain files, and changing them changes neither PCR the key is bound to.
TPM_PIN="$(jq -r 'if .disk_unlock.tpm == true then .disk_unlock.pin else empty end' "${WATCH_STATUS}" 2>/dev/null)"
if [[ "${TPM_PIN}" == true ]]; then
    report updates disk-unlock-pin ok "$(gettext "Disk unlock")" "$(gettext "The TPM opens the disk only with a PIN")"
elif [[ "${TPM_PIN}" == false && "${SEALED}" == true ]]; then
    report updates disk-unlock-pin info "$(gettext "Disk unlock")" "$(gettext "The TPM opens the disk without a PIN")" \
        "$(gettext "This sealed image's boot menu and initramfs are inside the signed UKI, so the key comes only to the system it was enrolled for. A PIN also keeps it from someone who takes the machine.")"
elif [[ "${TPM_PIN}" == false ]]; then
    COMMAND="ame security disk-unlock on-pin"
    report updates disk-unlock-pin check "$(gettext "Disk unlock")" "$(gettext "The TPM opens the disk without a PIN")" \
        "$(gettext "Anyone who takes this machine can start it their own way and be handed the key: into a shell from the boot menu, or with a disk of theirs made to look like this one. Neither changes what the key is bound to.")" \
        "$(gettext "Set it up again with a PIN:")"
fi

if systemctl is-enabled --quiet usbguard.service 2>/dev/null; then USB=on; else USB=off; fi
COMMAND="ame security usb"
report optional usb-protection "${USB}" "$(gettext "USB protection")" \
    "$(gettext "Allows what is plugged in now, and blocks any new USB device until you allow it")"

COMMAND="ame security browser"
report optional browser-protection "$(/usr/libexec/amethystora-browser-policy status)" "$(gettext "Browser protection")" \
    "$(gettext "Browsers install only the extensions on a list, and web pages cannot reach USB, serial, HID or Bluetooth devices")"

# Encrypted DNS and a different address on each network, each switched by the files its helper writes
DNS_STATE="$(/usr/libexec/amethystora-dns status)"
if [[ "${DNS_STATE}" == on ]]; then
    RESOLVER="$(/usr/libexec/amethystora-dns name)"
    DNS_TEXT="$(eval_gettext "Names are looked up over DNS-over-TLS with \${RESOLVER}, so the network cannot see them or answer in its place")"
else
    DNS_TEXT="$(gettext "Look up names over DNS-over-TLS with a resolver you choose, so the network cannot see them or answer in its place")"
fi
COMMAND="ame security dns"
report optional encrypted-dns "${DNS_STATE}" "$(gettext "Encrypted DNS")" "${DNS_TEXT}"

COMMAND="ame security mac"
report optional network-address "$(/usr/libexec/amethystora-mac status)" "$(gettext "A different address on each network")" \
    "$(gettext "Each network sees an address of its own for this machine and is not told its name, so networks cannot recognise it wherever it goes")"

if systemctl is-enabled --quiet input-remapper.service 2>/dev/null; then REMAP=on; else REMAP=off; fi
COMMAND="ame security input-remapper"
report optional key-remapping "${REMAP}" "$(gettext "Key remapping")" \
    "$(gettext "Input Remapper reads every key typed, so it stays off until you need it")"

# The two settings in /etc/amethystora/security.conf
case "${ON_DETECTION}" in
    quarantine) DETECTION=on DETECTION_TEXT="$(gettext "Files a virus scan finds are moved to quarantine, where nothing can open them")" ;;
    delete) DETECTION=on DETECTION_TEXT="$(gettext "Files a virus scan finds are deleted")" ;;
    *) DETECTION=off DETECTION_TEXT="$(gettext "Move what a virus scan finds to quarantine, or delete it, instead of only saying so")" ;;
esac
COMMAND="ame security settings on-detection"
report optional on-detection "${DETECTION}" "$(gettext "Act on what scans find")" "${DETECTION_TEXT}"

# Either half on is on; `ame security settings` sets each alone
REALTIME_STATE=off
[[ "${SETTING[REALTIME_WATCH]}" == on || "${SETTING[REALTIME_SCAN]}" == on ]] && REALTIME_STATE=on
COMMAND="ame security settings realtime"
report optional realtime "${REALTIME_STATE}" "$(gettext "Real-time watching")" \
    "$(gettext "Read each change as it happens and scan every file as it is written, instead of every 15 minutes and every week")"

# ...and network protection, which /usr/libexec/amethystora-ips runs
case "${NETWORK}" in
    block) NETWORK_STATE=on NETWORK_TILE="$(gettext "Suricata blocks connections to known malware, command servers and exploits")" ;;
    watch) NETWORK_STATE=on NETWORK_TILE="$(gettext "Suricata inspects every connection and says what it recognises, without blocking yet")" ;;
    *) NETWORK_STATE=off NETWORK_TILE="$(gettext "Inspect every connection with Suricata, and block the ones to known malware, command servers and exploits")" ;;
esac
COMMAND="ame security settings network"
report optional network-protection "${NETWORK_STATE}" "$(gettext "Network protection")" "${NETWORK_TILE}"

if [[ "${JSON}" == true ]]; then
    printf '%s\n' "${RECORDS[@]}" | jq -s --arg image "${IMAGE}" --arg detection "${ON_DETECTION}" \
        --arg realtime "${REALTIME_STATE}" --arg network "${NETWORK}" --arg virus "${VIRUS_SCAN}" \
        --arg profile "$(/usr/libexec/amethystora-security-config --profile)" \
        '{$image, settings: {on_detection: $detection, $realtime, $network, virus_scan: $virus, $profile}, checks: .}'
else
    echo
fi
