#!/usr/bin/bash
# Pools of disks: btrfs's own RAID on spare disks, made with one command, watched, and repaired.
# `ame system raid` runs this as the user, and it asks sudo for each step that needs root, as the
# recipes do; its two services run it as root. Amethystora Control shows what `status --json` says.
#
#   amethystora-raid                                 the status, then a menu of what fits
#   amethystora-raid create [--name NAME] [DISK...]  a new pool from spare disks, at /var/mnt/NAME
#   amethystora-raid replace [NAME]                  a new disk in place of a missing or failing one
#   amethystora-raid add NAME [DISK]                 one more disk in a pool
#   amethystora-raid mount NAME                      open a pool that lost a disk, until it is replaced
#   amethystora-raid forget NAME                     stop mounting a pool, leaving its files on its disks
#   amethystora-raid mirror [DISK]                   the system on each of its disks, or onto a new one
#   amethystora-raid scrub [now|on|off]              read every copy now and repair, or switch the monthly scrub
#   amethystora-raid status [--json]                 what there is and how it is doing, changing nothing
#
# For the image's own use:
#
#   amethystora-raid root-luks           the LUKS partitions the system runs from, one a line
#   amethystora-raid layouts SIZE...     the layouts that fit disks of these sizes in bytes, as JSON
#   amethystora-raid present             exit 0 when there is a RAID to watch (the units' ExecCondition=)
#   amethystora-raid check               amethystora-raid-check.service: read SMART, say what changed
#   amethystora-raid notify SUMMARY BODY the check's notification, whose button opens Control
#   amethystora-raid scrub-all           amethystora-raid-scrub.service
#   amethystora-raid boot-mirror         amethystora-raid-mirror.service: before /boot is mounted, at the restart
#                                        from a mirror's new disk, the first disk's /boot joins the mirror
#   amethystora-raid boot                amethystora-raid-boot.service: finish that mirror (SELinux's labels),
#                                        and keep the boot menu's entry that starts a system over several
#                                        disks with one of them missing
#   amethystora-raid boot-entry          that entry alone, as the same service writes it at shutdown
# The system's own disks: `mirror` with no disk keeps a copy of each file on each disk of a system the
# installer spread over several (2a); `mirror DISK` copies a system on one disk, laid out as the installer
# does it (an ESP, an ext4 /boot and btrfs, on LUKS or not), onto a new disk: its own ESP, /boot made a RAID1
# of both (md-boot, metadata 1.0, so each half reads as plain ext4) and btrfs raid1, then one restart from the
# new disk before the first disk's /boot joins (2b). Either way the boot menu gains "Start with a disk
# missing", whose rootflags=...,degraded the initramfs honours (dracut module amethystora-degraded); `replace
# system` puts a new disk in place of a dead one.
# Nothing offers a disk that is in use (mounted, swap, held by LUKS, md or LVM, a member of a mounted
# btrfs or of a pool that did not mount, zram, read-only), and nothing erases one without a terminal in
# which the disk was shown and ERASE typed: there is no --yes. A pool is one btrfs over a GPT partition
# on each disk, with LUKS2 under it unless the user said no, its key in /etc/cryptsetup-keys.d and one
# recovery key in every disk's second slot. Its lines in /etc/crypttab and /etc/fstab carry nofail, so
# that a missing disk never holds up the boot, and the fstab line carries x-amethystora-raid, so that a
# pool that did not mount is still known. A pool that lost a disk is mounted degraded only when asked.

set -uo pipefail

# Marks a message for po/amethystora.pot; amethystora-notify-users translates the buttons for each account
N_() { printf '%s' "$1"; }

# A stand-in tree for build_files/shared/test-raid.sh; empty, and so the machine's own, everywhere else
R="${AMETHYSTORA_RAID_ROOT:-}"
SYS="${R}/sys"
FSTAB="${R}/etc/fstab"
CRYPTTAB="${R}/etc/crypttab"
KEYS="${R}/etc/cryptsetup-keys.d"
STATE="${R}/var/lib/amethystora/raid"
MNT=/var/mnt
NAME_RULE='^[a-z0-9][a-z0-9-]{0,30}$'
# GPT partition types: Linux LUKS, and Linux filesystem
LUKS_TYPE=CA7D7CCB-63ED-4C53-861C-1742536059CC
LINUX_TYPE=0FC63DAF-8483-4772-8E79-3D69D8477DE4
GIB=1073741824
# What the partition table, and LUKS2's header, take from a disk at most: what a replacement needs over
# the size of the device it replaces
PLAIN_OVERHEAD=$((2 * 1048576))
LUKS_OVERHEAD=$((18 * 1048576))
# Both of a pool's keys are random and long, so neither needs a slow key derivation, which would cost a
# second and a gigabyte of memory per disk at every boot: the minimal PBKDF2 that systemd-cryptenroll
# gives its own high-entropy keys
LUKS_PBKDF=(--pbkdf pbkdf2 --pbkdf-force-iterations 1000)
LSBLK_COLUMNS=NAME,KNAME,PATH,TYPE,SIZE,MODEL,SERIAL,TRAN,RO,FSTYPE,LABEL,UUID,PARTLABEL,PARTTYPE,PARTUUID,MOUNTPOINTS
# Every btrfs mount, "uuid target options" a line, which status_json() reads once
TARGETS=""
# The system's disks: the GPT types of an ESP and of a Linux RAID member, and what says how far a mirror is
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
RAID_TYPE=a19d880f-05fc-4d3b-a006-743f0f84911e
SEALED="${R}/usr/share/amethystora/sealed"
BOOT="${R}/boot"
BOOT_MD=/dev/md/md-boot
# A mirror waiting for its restart from the new disk; the disks seen missing, for telling one that came back
MIRROR_STATE="${STATE}/mirror.json"
MISSING_STATE="${STATE}/missing.json"
# What updates the system, held while its boot files are copied
UPDATE_TIMERS=(uupd.timer rpm-ostreed-automatic.timer bootc-fetch-apply-updates.timer)
UPDATE_SERVICES=(uupd.service uupd-manual.service rpm-ostreed-automatic.service bootc-fetch-apply-updates.service)

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    sed -n 's/^#   amethystora-raid /ame system raid /p' "$0" | head -n 9
    echo "ame system raid replace system    a new disk in place of a dead one of the system's"
}

interactive() { [[ -t 0 && -t 1 ]]; }

# Whatever asks which disk, or erases one, runs only where somebody can see the disks and answer
need_terminal() {
    interactive || die "ame system raid $1 asks which disks to use and erases them, so it runs only in a terminal."
}

as_root() {
    if [[ ${EUID} -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

# The same, never asking for a password, and with no terminal for sudo to take over: for reading how far a
# long operation is, from the background
as_root_quietly() {
    if [[ ${EUID} -eq 0 ]]; then "$@"; else sudo -n "$@"; fi </dev/null 2>/dev/null
}

box() { gum style --border rounded --padding "0 1" --width 80 "$@"; }

# Sizes as disk makers give them: 1.0 TB is 10^12 bytes
human() {
    awk -v b="${1:-0}" 'BEGIN { split("B kB MB GB TB PB", u, " "); i = 1
        while (b >= 1000 && i < 6) { b /= 1000; i++ }
        s = sprintf(i == 1 ? "%d" : "%.1f", b); sub(/\.0$/, "", s); print s, u[i] }'
}
HUMAN_JQ='def human: if . == null then "?" else . as $b
    | [["PB", 1e15], ["TB", 1e12], ["GB", 1e9], ["MB", 1e6], ["kB", 1e3]] | map(select($b >= .[1])) | first
    | if . == null then "\($b) B" else "\(($b / .[1] * 10 | round) / 10) \(.[0])" end end;'

mount_unit() { systemd-escape --path --suffix=mount "${MNT}/$1"; }
crypt_unit() { printf 'systemd-cryptsetup@%s.service\n' "$(systemd-escape "$1")"; }

# --- Layouts ---------------------------------------------------------------------------------------

# The layouts, in the order offered: btrfs's data profile, what it is called, from how many disks it is
# offered (where it starts to differ from two copies, not btrfs's own minimum), how many dead disks it
# survives, and what to know before choosing it. Metadata is raid1 on two disks and raid1c3 from three,
# never parity, as btrfs(5) asks, and a combined pool stays mountable after a disk dies that way.
PARITY_WARNING="btrfs says of it: should not be used in production, only for evaluation or testing. A power cut can damage what was being written: check every copy after one (ame system raid scrub now)."
LAYOUTS="$(jq -nc --arg parity "${PARITY_WARNING}" '[
    {id: "raid1", title: "Two copies", min: 2, survives: 1, note: null, warning: null},
    {id: "raid1c3", title: "Three copies", min: 3, survives: 2, note: null, warning: null},
    {id: "raid10", title: "Striped two copies", min: 4, survives: 1,
     note: "Faster for large files, and it protects as two copies do.", warning: null},
    {id: "raid5", title: "Parity", min: 3, survives: 1, note: null, warning: $parity},
    {id: "raid6", title: "Double parity", min: 4, survives: 2, note: null, warning: $parity},
    {id: "single", title: "Combined", min: 2, survives: 0, note: null,
     warning: "No copies. This joins the disks; it does not protect anything: a dead disk takes its files with it."}]')"

# How much each layout holds on disks of these sizes: btrfs's allocator, simulated in 1 GiB steps. Copies
# go on the disks with the most room left; a stripe spans every disk that still has room, an even number
# of them for raid10.
usable() {
    awk -v gib="${GIB}" '
        function reset(   i) { for (i = 1; i <= n; i++) free[i] = size[i] }
        # The k disks with the most room left, in pick[1..k]; 0 when fewer than k have any
        function most(k,   i, j, best, taken) {
            split("", taken)
            for (j = 1; j <= k; j++) {
                best = 0
                for (i = 1; i <= n; i++)
                    if (!(i in taken) && free[i] > 0 && (best == 0 || free[i] > free[best])) best = i
                if (best == 0) return 0
                taken[best] = 1
                pick[j] = best
            }
            return 1
        }
        function copies(c,   total, j) {
            reset(); total = 0
            while (most(c)) { for (j = 1; j <= c; j++) free[pick[j]]--; total++ }
            return total
        }
        function stripes(minimum, parity, pairs,   total, i, j, k) {
            reset(); total = 0
            while (1) {
                k = 0
                for (i = 1; i <= n; i++) if (free[i] > 0) k++
                if (pairs) k -= k % 2
                if (k < minimum || !most(k)) return total
                for (j = 1; j <= k; j++) free[pick[j]]--
                total += pairs ? k / 2 : k - parity
            }
        }
        BEGIN {
            n = ARGC - 1
            for (i = 1; i <= n; i++) { size[i] = int(ARGV[i] / gib); sum += size[i] }
            ARGC = 1
            printf "raid1 %d\nraid1c3 %d\nraid10 %d\nraid5 %d\nraid6 %d\nsingle %d\n", copies(2) * gib, copies(3) * gib,
                stripes(2, 0, 1) * gib, stripes(2, 1, 0) * gib, stripes(3, 2, 0) * gib, sum * gib
        }' "$@"
}

# The layouts that fit this many disks of these sizes, each with what it holds and what it costs
layouts() {
    [[ $# -gt 0 ]] || die "usage: amethystora-raid layouts SIZE..."
    usable "$@" | jq -cRn --argjson layouts "${LAYOUTS}" --argjson count "$#" '
        ([inputs | split(" ") | {key: .[0], value: (.[1] | tonumber)}] | from_entries) as $usable
        | [$layouts[] | select($count >= .min)
           | . + {usable: $usable[.id], metadata: (if $count == 2 then "raid1" else "raid1c3" end)}]'
}

# --- What there is ---------------------------------------------------------------------------------

read_lsblk() {
    local out
    if out="$(lsblk -J -b -o "${LSBLK_COLUMNS}" 2>/dev/null)" && jq -e '.blockdevices' <<<"${out}" >/dev/null 2>&1; then
        printf '%s\n' "${out}"
    else
        echo '{"blockdevices": []}'
    fi
}

# Disks and partitions something holds open (a LUKS mapping, an md array, LVM), by kernel name
held() {
    local dir
    for dir in "${SYS}"/block/*/holders "${SYS}"/block/*/*/holders; do
        [[ -n "$(ls -A "${dir}" 2>/dev/null)" ]] || continue
        dir="${dir%/holders}"
        printf '%s\n' "${dir##*/}"
    done
}

# The pools this machine expects, from /etc/fstab: "uuid mountpoint" a line
expected() {
    awk '!/^[[:space:]]*#/ && $1 ~ /^UUID=/ && $4 ~ /(^|,)x-amethystora-raid(,|$)/ { print substr($1, 6), $2 }' \
        "${FSTAB}" 2>/dev/null
}

# A pool's disks' lines in a crypttab read from stdin (root's alone to read), "name uuid" a line: the
# mapping of each is raid-POOL-N, as its partition is named
crypt_lines_of() {
    awk -v pool="$1" '!/^[[:space:]]*#/ && $2 ~ /^UUID=/ && index($1, "raid-" pool "-") == 1 &&
        substr($1, length(pool) + 7) ~ /^[0-9]+$/ { print $1, substr($2, 6) }'
}

# The filesystem the system runs from, "fstype source uuid": /sysroot on this image, the physical root
# under ostree's, and / anywhere else
root_fs() {
    local line
    line="$(findmnt -rn -o FSTYPE,SOURCE,UUID --mountpoint /sysroot 2>/dev/null)" ||
        line="$(findmnt -rn -o FSTYPE,SOURCE,UUID --mountpoint / 2>/dev/null)"
    printf '%s\n' "${line%%$'\n'*}"
}

# Every LUKS partition under a kernel device: what a LUKS mapping stands on, or what the mappings under a
# mapping stand on (LVM on LUKS)
luks_under() {
    local dev="${SYS}/class/block/$1" slave
    [[ -d "${dev}/dm" ]] || return 0
    for slave in "${dev}"/slaves/*; do
        [[ -e "${slave}" ]] || continue
        if [[ "$(cat "${dev}/dm/uuid" 2>/dev/null)" == CRYPT-LUKS* ]]; then
            printf '/dev/%s\n' "${slave##*/}"
        else
            luks_under "${slave##*/}"
        fi
    done
}

# The LUKS partitions under the system's own filesystem, every one of its devices for a btrfs over
# several disks, and never a pool's: what TPM unlocking enrols, and what makes the system encrypted
root_luks() {
    local fstype source uuid dev
    read -r fstype source uuid <<<"$(root_fs)"
    if [[ "${fstype}" == btrfs && -n "${uuid}" && -d "${SYS}/fs/btrfs/${uuid}/devices" ]]; then
        for dev in "${SYS}/fs/btrfs/${uuid}/devices"/*; do
            [[ -e "${dev}" || -L "${dev}" ]] && luks_under "${dev##*/}"
        done
    elif [[ -n "${source}" ]]; then
        source="$(readlink -f -- "${source%%\[*}")"
        luks_under "${source##*/}"
    fi | sort -u
}

# Where a btrfs is mounted so that it can be written through, which a balance, a replace and a scrub need:
# /sysroot is read-only on this image and /var is not. A pool's own folder first.
pick_target() {
    awk -v uuid="$1" '$1 == uuid && $3 ~ /^rw(,|$)/ {
        score = ($2 ~ /^\/var\/mnt\//) ? 3 : ($2 == "/var" ? 2 : 1)
        if (score > best) { best = score; target = $2 } } END { if (target != "") print target }' <<<"${TARGETS}"
}

# btrfs filesystem show's devices, "devid size kernel-name", with "-" for one that is missing. Run on a
# mounted filesystem it needs no root to say which device has which devid, which it asks the kernel. Without
# root it cannot open the devices, and calls every one MISSING with size 0: --unopened takes the device the
# kernel names all the same (the status, which reads sysfs for what is missing).
show_lines() {  # [--unopened]
    local devid size path
    awk -v unopened="${1:-}" '$1 == "devid" { path = "-"
        for (i = 5; i < NF; i++) if ($i == "path" && $(i + 1) ~ /^\//) path = $(i + 1)
        if ($0 ~ /MISSING/ && unopened == "") path = "-"
        print $2, $4, path }' |
        while read -r devid size path; do
            [[ "${path}" == - ]] || path="$(readlink -f -- "${path}")"
            printf '%s %s %s\n' "${devid}" "${size}" "${path##*/}"
        done
}

# A device's size in its filesystem, which btrfs filesystem show gives a missing one as 0: then its item in the
# chunk tree, read from a device that is there. Nothing when neither knows it.
devid_size() {  # TARGET DEVID SHOWN-SIZE
    local there
    [[ "${3:-0}" -gt 0 ]] && { printf '%s\n' "$3"; return; }
    there="$(as_root btrfs filesystem show --raw "$1" | show_lines | awk '$3 != "-" { print $3; exit }')"
    [[ -n "${there}" ]] || return 0
    as_root btrfs inspect-internal dump-tree -t chunk "/dev/${there}" 2>/dev/null |
        awk -v devid="$2" '$1 == "devid" && $2 == devid && $3 == "total_bytes" { print $4; exit }'
}

# Devices of a mounted btrfs whose disk is gone from under them: a LUKS mapping, still open, over a disk the
# kernel dropped when it was pulled out. btrfs goes on with the others and counts errors for it; it is missing.
gone_devices() {  # FS-SYSFS-DIR
    local dev slave live
    for dev in "$1"/devices/*; do
        dev="${dev##*/}"
        [[ -d "${SYS}/class/block/${dev}/dm" ]] || continue
        live=false
        for slave in "${SYS}/class/block/${dev}/slaves"/*; do
            [[ -e "${slave}" ]] && live=true
        done
        [[ "${live}" == true ]] || printf '%s\n' "${dev}"
    done
}

# A mounted btrfs, from sysfs, which anyone may read, a fact a line; FS_JQ makes JSON of it
fs_facts() {
    local fs="$1" dir kind
    printf 'uuid %s\n' "${fs##*/}"
    printf 'label %s\n' "$(cat "${fs}/label" 2>/dev/null)"
    printf 'operation %s\n' "$(cat "${fs}/exclusive_operation" 2>/dev/null)"
    for dir in "${fs}"/devices/*; do
        [[ -e "${dir}" || -L "${dir}" ]] && printf 'device %s\n' "${dir##*/}"
    done
    gone_devices "${fs}" | sed 's/^/gone /'
    for dir in "${fs}"/devinfo/*; do
        [[ -d "${dir}" ]] || continue
        printf 'devid %s %s\n' "${dir##*/}" "$(cat "${dir}/missing" 2>/dev/null || echo 0)"
        # write_errs, read_errs, flush_errs, corruption_errs and generation_errs
        awk -v devid="${dir##*/}" 'NF == 2 { print "error", devid, $1, $2 }' "${dir}/error_stats" 2>/dev/null
    done
    # The kernel calls the folder allocation, whatever btrfs's documentation says. A profile a convert
    # emptied keeps its folder until the next unmount, so it is the bytes that count.
    for kind in data metadata; do
        printf 'used %s %s\n' "${kind}" "$(cat "${fs}/allocation/${kind}/bytes_used" 2>/dev/null || echo 0)"
        for dir in "${fs}/allocation/${kind}"/*/; do
            [[ -f "${dir}total_bytes" ]] || continue
            dir="${dir%/}"
            printf 'profile %s %s %s\n' "${kind}" "${dir##*/}" "$(cat "${dir}/total_bytes")"
        done
    done
}

FS_JQ='
[inputs | capture("^(?<k>[a-z]+) ?(?<v>.*)$")] as $l
| def facts($k): [$l[] | select(.k == $k) | .v];
  def fact($k): facts($k) | first // "";
  def number: if . == "" or . == null then null else tonumber end;
  {uuid: fact("uuid"), label: fact("label"),
   operation: (fact("operation") | if . == "" or . == "none" then null else . end),
   devices: facts("device"), gone: facts("gone"),
   devinfo: ([facts("devid")[] | split(" ") | {devid: (.[0] | tonumber), missing: (.[1] == "1")}] | sort_by(.devid)),
   errors: (reduce (facts("error")[] | split(" ")) as $e ({}; .[$e[0]][$e[1] | sub("_errs$"; "")] = ($e[2] | tonumber))),
   profiles: (reduce (facts("profile")[] | split(" ")) as $p ({data: {}, metadata: {}};
       .[$p[0]][$p[1]] = ($p[2] | tonumber))),
   data_used: ([facts("used")[] | split(" ") | select(.[0] == "data") | .[1] | number] | first),
   metadata_used: ([facts("used")[] | split(" ") | select(.[0] == "metadata") | .[1] | number] | first),
   target: (if $target == "" then null else $target end),
   size: ($size | number), used: ($used | number),
   show: [$show | split("\n")[] | select(. != "") | split(" ") | {devid: (.[0] | tonumber), size: (.[1] | tonumber), kname: .[2]}]}'

# The pools, the spare disks and the rest, from what status_json() gathered
STATUS_JQ='
def nodes: $lsblk.blockdevices[]? | recurse(.children[]?);
def trim: (. // "") | gsub("^\\s+|\\s+$"; "");
def disk: {path, model: (.model | trim), serial: (.serial | trim), size, tran};
def disk_of($kname): (first($lsblk.blockdevices[]? | select(.type == "disk" and any(recurse(.children[]?); .kname == $kname)) | disk)) // null;
# The profile the pool was made with: one holding bytes other than single (or dup), since a pool mounted with a
# disk missing writes single and only then, however much it wrote; single only when there is no other
def main(profiles): [(profiles // {}) | to_entries[] | select(.value > 0)] as $all
    | ([$all[] | select(.key != "single" and .key != "dup")] | max_by(.value)) // ($all | max_by(.value))
    | if . == null then null else .key end;
def survives: {"raid1": 1, "raid1c3": 2, "raid1c4": 3, "raid10": 1, "raid5": 1, "raid6": 2}[. // ""] // 0;
def smart($d): if $d == null then null else
    ([$disks.devices[]? | select(if ($d.serial // "") != "" then .serial == $d.serial else .disk == $d.path end) | .smart] | first) end;
def name_of($mountpoint): $mountpoint | split("/") | last;

($fstab | map(.uuid)) as $expected_uuids
| ($fstab | map(name_of(.mountpoint))) as $expected_names
| [$fs[].devices[]] as $members
| def pool_part: (.partlabel // "") as $label | any($expected_names[]; . as $name | $label | test("^raid-" + $name + "-[0-9]+$"));

[ $fs[] as $f
  | ([$fstab[] | select(.uuid == $f.uuid)] | first) as $e
  | select(($f.devinfo | length) >= 2 or $e != null)
  | ($f.uuid == $root) as $system
  | (if $e != null then name_of($e.mountpoint) elif $system then "system"
     elif ($f.label // "") != "" then $f.label else $f.uuid[0:8] end) as $id
  | main($f.profiles.data) as $data
  | main($f.profiles.metadata) as $meta
  | [ $f.devinfo[] as $d
      | ([$f.show[]? | select(.devid == $d.devid and .kname != "-") | .kname] | first) as $shown
      | ([$disks.devices[]? | select(.fsid == $f.uuid and .devid == $d.devid)] | first) as $known
      # Gone from under its open LUKS mapping, which btrfs does not call missing
      | ($shown != null and ($f.gone | index($shown)) != null) as $gone
      | ($d + {missing: ($d.missing or $gone)}) as $d
      | (if $d.missing and ($gone | not) then null
         elif $shown != null then $shown
         elif $known != null and ($f.devices | index($known.kname)) != null then $known.kname
         else null end) as $kname
      | ((if $kname != null then disk_of($kname) else null end)
         // (if $known != null then {path: $known.disk, model: $known.model, serial: $known.serial, size: null, tran: null}
             else null end)) as $disk
      | ($f.errors[$d.devid | tostring] // {}) as $errors
      # A disk that was missing and is back has the old copies of what was written while it was away, which
      # btrfs counts as errors as it finds them: that is no sign of a failing disk
      | (($d.missing | not) and ($seen[$f.uuid][$d.devid | tostring] != null)) as $returned
      | {devid: $d.devid, missing: $d.missing, returned: $returned, kname: $kname,
         size: ([$f.show[]? | select(.devid == $d.devid) | .size] | first),
         errors: $errors, error_count: ([$errors[]] | add // 0),
         disk: $disk, usb: ($disk.tran == "usb"),
         smart: (if $d.missing then null else smart($disk) end)} ] as $devices
  | ($devices | map(select(.missing)) | length) as $missing
  | ($devices | map(select(.returned | not) | .error_count) | add // 0) as $errors
  | ($scrubs[$f.uuid] // null) as $scrub
  | ($meta == null or $meta == "single" or $meta == "dup") as $plain_meta
  | (($data != null and $data != "single" and ($f.profiles.data.single // 0) > 0)
     or (($plain_meta | not) and (($f.profiles.metadata.single // 0) + ($f.profiles.metadata.dup // 0)) > 0)) as $degraded
  | (if $system then ($rootluks | length) > 0
     else any($devices[]; .kname as $k | $k != null and any(nodes; .kname == $k and .type == "crypt")) end) as $encrypted
  # The system /boot mirrored as well (md-boot), and how many of its halves are there
  | (if $system and $sys.md != null then {degraded: ($sys.md.degraded > 0), raid_disks: $sys.md.raid_disks,
       members: ($sys.md.members | length), state: $sys.md.state, mounted: ($sys.boot.source // "" | test("^/dev/md"))}
     else null end) as $boot
  | (if $system then $sys.mirror else null end) as $mirror
  | [ (if $missing > 0 then "missing" else empty end),
      (if any($devices[]; .smart == "failed") then "failing" else empty end),
      (if ($scrub.uncorrectable // 0) > 0 then "scrub" else empty end),
      (if $errors > 0 then "errors" else empty end),
      (if any($devices[]; .returned) then "returned" else empty end),
      (if $degraded then "degraded" else empty end),
      (if $missing == 0 and $boot != null and $boot.degraded and $mirror == null then "boot" else empty end),
      (if $mirror != null then (if $mirror.state == "failed" then "mirror-failed" else "restart" end) else empty end),
      (if $system and $data == "single" then "unprotected" else empty end) ] as $problems
  | {id: $id, name: $id, system: $system, managed: ($e != null), uuid: $f.uuid, label: $f.label,
     mountpoint: (if $e != null then $e.mountpoint elif $system then "/" else $f.target end),
     target: $f.target, mounted: true, encrypted: $encrypted,
     layout: $data, metadata: $meta, survives: ($data | survives),
     size: $f.size, used: $f.used, data_used: $f.data_used, metadata_used: $f.metadata_used,
     devices: $devices, missing: $missing, errors: $errors, degraded: $degraded, operation: $f.operation,
     boot: $boot, mirror: $mirror,
     busy: [$units[] | select(. as $unit | any("replace", "balance", "mirror", "scrub"; $unit == "amethystora-raid-\(.)-\($id).service"))],
     scrub: $scrub, problems: $problems, state: (if $problems == [] then "ok" else "check" end)} ]
+ [ $fstab[] as $e
    | select(any($fs[]; .uuid == $e.uuid) | not)
    | name_of($e.mountpoint) as $id
    | [nodes | select(.type == "part" and ((.partlabel // "") | test("^raid-" + $id + "-[0-9]+$")))] as $parts
    | (if $parts != [] then $parts else [nodes | select(.fstype == "btrfs" and .uuid == $e.uuid)] end) as $present
    | {id: $id, name: $id, system: false, managed: true, uuid: $e.uuid, label: null, mountpoint: $e.mountpoint,
       target: null, mounted: false, encrypted: any($parts[]; .fstype == "crypto_LUKS"),
       layout: null, metadata: null, survives: null, size: null, used: null, data_used: null, metadata_used: null,
       devices: [$present[] | disk_of(.kname) as $disk
           | {devid: null, missing: false, kname, size, errors: {}, error_count: 0, disk: $disk,
              usb: ($disk.tran == "usb"), smart: smart($disk)}],
       missing: null, errors: 0, degraded: false, operation: null, busy: [],
       scrub: ($scrubs[$e.uuid] // null), problems: ["unmounted"], state: "check"} ]
| . as $pools
| [ $lsblk.blockdevices[]? | select(.type == "disk")
    | select((.name // "" | test("^(zram|loop|ram)")) | not)
    | select((.ro == true or .ro == "1" or .ro == 1) | not)
    | select((.size // 0) > 0)
    | select(all(recurse(.children[]?);
        ([.mountpoints[]? | select(. != null)] | length) == 0
        and (.type == "disk" or .type == "part")
        and .fstype != "linux_raid_member"
        and (.kname as $k | ($members | index($k)) == null and ($held | index($k)) == null)
        and ((.uuid // "") as $u | ($expected_uuids | index($u)) == null)
        and (pool_part | not)))
    | disk + {kname, usb: (.tran == "usb"), contents: [recurse(.children[]?) | select(.fstype != null) | {fstype, label}]} ]
| . as $spare
# Mirroring a system on one disk onto a new one (2b): laid out as the installer does it (an ESP, an ext4 /boot
# and the btrfs, on LUKS or not, all on that disk), on UEFI, not sealed, onto a spare disk at least as large.
# The reason it cannot, or null; nothing at all where it does not apply (several disks already).
| def disk_at($path): (first($lsblk.blockdevices[]? | select(.type == "disk" and any(recurse(.children[]?); .path == $path)))) // null;
  (if $sys == null or ($sys.devices | length) != 1 then null else
    disk_at($sys.devices[0].part) as $disk
    | (if $sys.boot != null then disk_at($sys.boot.source) else null end) as $bootdisk
    | ([$disk.children[]? | select((.parttype // "" | ascii_downcase) == $esp_type and .fstype == "vfat")] | length) as $esps
    | [$spare[] | select(.size >= ($disk.size // infinite))] as $fits
    | (if $sys.mirror != null then "pending"
       elif $sys.sealed then "sealed"
       elif ($sys.efi | not) then "no-uefi"
       elif $disk == null or $bootdisk == null or $bootdisk.path != $disk.path or $sys.boot.fstype != "ext4" or $esps != 1 then "layout"
       elif $fits == [] then "no-disk"
       else null end) as $reason
    | {possible: ($reason == null), reason: $reason, disk: $disk.path, size: $disk.size, candidates: [$fits[].path]} end) as $onto
| {version: 1, pools: $pools, spare: $spare,
   system_single: any($pools[]; .system and .layout == "single"),
   mirror_onto: $onto,
   raid: ($pools != []),
   scrub_timer: (if $timer == "" then null else $timer end),
   scrubbing: any($units[]; . == "amethystora-raid-scrub.service" or . == "amethystora-raid-scrub-now.service")}'

scrubs() {
    local file uuid
    for file in "${STATE}"/scrub-*.json; do
        [[ -f "${file}" ]] || continue
        uuid="${file##*/scrub-}"
        jq -c --arg uuid "${uuid%.json}" '{($uuid): .}' "${file}" 2>/dev/null
    done | jq -cs 'add // {}'
}

units() {
    systemctl list-units --plain --no-legend --state=activating,active,deactivating 'amethystora-raid-*' 2>/dev/null |
        awk '$1 ~ /^amethystora-raid-/ { print $1 }'
}

# The md array of the system's /boot, from sysfs: "kname degraded raid_disks array_state member..." with each
# member "kname:state", or nothing
md_boot() {
    local md dev members=()
    md="$(readlink -f "${R}${BOOT_MD}" 2>/dev/null)"
    [[ -n "${md}" && -d "${SYS}/block/${md##*/}/md" ]] || return 0
    md="${md##*/}"
    for dev in "${SYS}/block/${md}/md"/dev-*; do
        [[ -d "${dev}" ]] || continue
        members+=("$(readlink -f "${dev}/block")")
        members[-1]="${members[-1]##*/}:$(tr ',' '+' <"${dev}/state" 2>/dev/null)"
    done
    printf '%s %s %s %s %s\n' "${md}" "$(cat "${SYS}/block/${md}/md/degraded" 2>/dev/null || echo 0)" \
        "$(cat "${SYS}/block/${md}/md/raid_disks" 2>/dev/null || echo 0)" \
        "$(cat "${SYS}/block/${md}/md/array_state" 2>/dev/null || echo inactive)" "${members[*]}"
}

# The system's own disks, without root: each device of its btrfs with the partition under it (a LUKS one when
# it is encrypted), /boot, its md array if it has one, and the rest the status works out from lsblk
system_json() {
    local fstype source uuid dev part devices=() boot md
    read -r fstype source uuid <<<"$(root_fs)"
    if [[ "${fstype}" != btrfs || -z "${uuid}" ]]; then
        echo null
        return
    fi
    for dev in "${SYS}/fs/btrfs/${uuid}/devices"/*; do
        [[ -e "${dev}" || -L "${dev}" ]] || continue
        dev="${dev##*/}"
        part="$(luks_under "${dev}" | head -n 1)"
        devices+=("${dev} ${part:-/dev/${dev}} $([[ -n "${part}" ]] && echo true || echo false)")
    done
    boot="$(findmnt -rn -o SOURCE,FSTYPE,UUID --mountpoint /boot 2>/dev/null | head -n 1)"
    md="$(md_boot)"
    jq -n --arg uuid "${uuid}" --arg boot "${boot}" --arg md "${md}" \
        --argjson sealed "$([[ -e "${SEALED}" ]] && echo true || echo false)" \
        --argjson efi "$([[ -d "${SYS}/firmware/efi" ]] && echo true || echo false)" \
        --argjson mirror "$(jq -c 'select(type == "object")' "${MIRROR_STATE}" 2>/dev/null || echo null)" '
        {uuid: $uuid, sealed: $sealed, efi: $efi, mirror: $mirror,
         devices: [$ARGS.positional[] | split(" ") | {kname: .[0], part: .[1], luks: (.[2] == "true")}],
         boot: ($boot | split(" ") | if length >= 2 then {source: .[0], fstype: .[1], uuid: (.[2] // null)} else null end),
         md: ($md | split(" ") | if length >= 4 then {kname: .[0], degraded: (.[1] | tonumber), raid_disks: (.[2] | tonumber),
              state: .[3], members: [.[4:][] | split(":") | {kname: .[0], state: (.[1] // "")}]} else null end)}' \
        --args "${devices[@]}"
}

# The disks seen missing, which the check and the boot write down for root, so that one that comes back,
# with the old copies of what was written while it was away, is told from one counting errors
missing_seen() {
    jq -c 'select(type == "object")' "${MISSING_STATE}" 2>/dev/null || echo '{}'
}

# Everything there is to say, as JSON, without root: sysfs, lsblk, findmnt and fstab, which anyone may
# read, and what the check and the scrub wrote down for everyone (SMART needs root)
status_json() {
    local lsblk fs uuid target size used show fstype source root disks filesystems=()
    lsblk="$(read_lsblk)"
    TARGETS="$(findmnt -rn -t btrfs -o UUID,TARGET,OPTIONS 2>/dev/null)"
    for fs in "${SYS}"/fs/btrfs/*-*-*-*-*; do
        [[ -d "${fs}/devinfo" ]] || continue
        uuid="${fs##*/}"
        target="$(pick_target "${uuid}")"
        size="" used="" show=""
        if [[ -n "${target}" ]]; then
            read -r size used < <(df -B1 --output=size,used "${target}" 2>/dev/null | tail -n 1)
            show="$(btrfs filesystem show --raw "${target}" 2>/dev/null | show_lines --unopened)"
        fi
        filesystems+=("$(fs_facts "${fs}" | jq -cRn --arg target "${target}" --arg size "${size}" \
            --arg used "${used}" --arg show "${show}" "${FS_JQ}")")
    done
    read -r fstype source root <<<"$(root_fs)"
    [[ "${fstype}" == btrfs ]] || root=""
    disks="$(jq -c 'select(type == "object")' "${STATE}/disks.json" 2>/dev/null)"
    jq -n \
        --argjson fs "$(printf '%s\n' "${filesystems[@]}" | jq -cs .)" \
        --argjson fstab "$(expected | jq -cRn '[inputs | split(" ") | {uuid: .[0], mountpoint: .[1]}]')" \
        --argjson lsblk "${lsblk}" \
        --argjson held "$(held | jq -cRn '[inputs]')" \
        --argjson rootluks "$(root_luks | jq -cRn '[inputs]')" \
        --arg root "${root}" \
        --argjson disks "${disks:-"{}"}" \
        --argjson scrubs "$(scrubs)" \
        --argjson units "$(units | jq -cRn '[inputs]')" \
        --arg timer "$(systemctl is-enabled amethystora-raid-scrub.timer 2>/dev/null)" \
        --argjson sys "$(system_json)" \
        --argjson seen "$(missing_seen)" \
        --arg esp_type "${ESP_TYPE}" \
        "${STATUS_JQ}"
}

# The words for a terminal
TEXT_JQ="${HUMAN_JQ}"'
def words: if .system and .layout == "single" then "One copy" else
    ({"raid1": "Two copies", "raid1c3": "Three copies", "raid1c4": "Four copies", "raid10": "Striped two copies",
      "raid5": "Parity", "raid6": "Double parity", "single": "Combined", "raid0": "Striped, no copies"}[.layout // ""]
     // .layout) end;
def disk: [(if .devid != null then "disk \(.devid)" else empty end),
    (if (.disk.model // "") != "" then .disk.model + (if (.disk.serial // "") != "" then " (\(.disk.serial))" else "" end) else empty end)]
    | join("  ");
def errors: if . == 1 then "1 error" else "\(.) errors" end;
def run($what): if .managed then ": ame system raid \($what) \(.name)" elif .system then ": ame system raid \($what) system" else "" end;
def how:
    if .busy != [] or .operation != null then
        "Busy " + (if any(.busy[]; test("-replace-")) then "replacing a disk." elif any(.busy[]; test("-scrub-")) then "checking every copy."
                   elif .busy != [] then "putting its copies where they belong." else "(\(.operation))." end)
    elif .mirror != null and .mirror.state == "failed" then "Mirroring it onto the new disk stopped: \(.mirror.reason // "journalctl -u amethystora-raid-mirror says why")."
    elif .mirror != null then "Restart to finish: the machine starts once from the new disk, then the boot files of the first disk join it."
    elif .mounted | not then "Not mounted, perhaps because one of its disks is missing. Open it with what is there" + run("mount") + "."
    elif .missing > 0 then
        if .missing <= .survives then "A disk is missing. Every file is still there, with one copy fewer until the disk is replaced" + run("replace") + "."
        else "A disk is missing, and the files that were on it cannot be read until it is back." end
    elif any(.devices[]; .smart == "failed") then "A disk says it is failing. Replace it" + run("replace") + "."
    elif (.scrub.uncorrectable // 0) > 0 then "The last check found damage it could not repair: journalctl -k -g btrfs names the files."
    elif .errors > 0 then "A disk has counted read or write errors" + (if .survives > 0 then ". If the count keeps rising, replace it" + run("replace") + "." else "." end)
    elif any(.devices[]; .returned) then "A disk that was missing is back, with old copies of what was written while it was away. Put the copies back" + run("replace") + "."
    elif .degraded then "Part of it has one copy, written while a disk was missing. Put the copies back" + run("replace") + "."
    elif .boot != null and .boot.degraded then "Its boot files have one copy. Put the copies back" + run("replace") + "."
    elif .system and .layout == "single" then "Either disk failing loses everything: ame system raid mirror keeps a copy on each."
    else "Fine." end;
(if .pools == [] then "No pools of disks." else "Pools of disks" end),
(.pools[] | "",
    "  " + (if .system then "The system" else "\(.name), at \(.mountpoint)" end) + (if .managed or .system then "" else " (made by hand)" end),
    "    " + ([ (if .layout != null then "\(words) on \(.devices | length) disks." else empty end),
               (if .encrypted then "Encrypted." else empty end),
               (if .size != null then "\(.used | human) used of \(.size | human)." else empty end) ] | join(" ")),
    "    " + how,
    (if .layout != null and .layout != "single" then "    " + (if .scrub.time != null
        then "Every copy last checked \(.scrub.time | strflocaltime("%Y-%m-%d"))"
            + (if .scrub.finished == false then ", not to the end." elif (.scrub.corrected // 0) > 0 then ", \(.scrub.corrected) errors repaired."
               else ", nothing to repair." end)
        else "Every copy not checked yet." end) else empty end),
    (if .boot != null then "    Its boot files are on \(.boot.members) of its disks." else empty end),
    (.devices[] | "      " + disk + (if .missing then "  missing" elif .smart == "failed" then "  failing" elif .returned then "  back"
        elif .error_count > 0 then "  \(.error_count | errors)" else "" end) + (if .usb then "  USB" else "" end))),
(if .mirror_onto.possible == true then "", "The system is on one disk: ame system raid mirror DISK copies it onto another at least as large, so that it starts from either."
 else empty end),
"",
(if .spare == [] then "No spare disks." else "Spare disks: " + ([.spare[] | "\(.path) (\(if .model != "" then .model else "disk" end), \(.size | human)\(if .usb then ", USB" else "" end))"] | join(", ")) end),
(if .raid then "The monthly check of every copy is " + (if .scrub_timer == "enabled" then "on" else "off" end) + "."
    + (if .scrubbing then " A check is running now." else "" end) else empty end),
(if .pools == [] and (.spare | length) >= 2 then "ame system raid create makes a pool from them." else empty end)'

cmd_status() {
    local status
    status="$(status_json)" || die "The disks could not be read."
    if [[ "${1:-}" == --json ]]; then
        printf '%s\n' "${status}"
    else
        jq -r "${TEXT_JQ}" <<<"${status}"
    fi
}

# Something to watch: a pool this machine expects, or any btrfs mounted over several disks
present() {
    local devinfo devices
    [[ -n "$(expected)" ]] && return 0
    for devinfo in "${SYS}"/fs/btrfs/*-*-*-*-*/devinfo; do
        devices=("${devinfo}"/*)
        [[ ${#devices[@]} -ge 2 && -e "${devices[1]}" ]] && return 0
    done
    return 1
}

# --- Making and changing pools -----------------------------------------------------------------------

name_free() {
    [[ ! -e "${MNT}/$1" && ! -e "${KEYS}/raid-$1.key" ]] || return 1
    ! expected | awk -v mountpoint="${MNT}/$1" '$2 == mountpoint { found = 1 } END { exit !found }'
}

pool_json() {  # STATUS NAME
    jq -c --arg name "$2" 'first(.pools[] | select((.managed or .system) and .name == $name)) // empty' <<<"$1"
}

# The pool NAME names, or without one the only pool there is, or the one asked for, the ones that need a
# look first. The system is not a pool these commands change.
pick_pool() {  # STATUS NAME
    local names=()
    if [[ -n "$2" ]]; then
        [[ "$2" == system ]] && die "The system's disks are not changed this way: only ame system raid mirror does that."
        [[ -n "$(pool_json "$1" "$2")" ]] || die "There is no pool called $2: ame system raid status lists them."
        printf '%s\n' "$2"
        return
    fi
    mapfile -t names < <(jq -r '[.pools[] | select(.managed)] | sort_by(.state != "check") | .[].name' <<<"$1")
    case ${#names[@]} in
        0) die "There is no pool yet: ame system raid create makes one." ;;
        1) printf '%s\n' "${names[0]}" ;;
        *) gum choose --header "Which pool?" "${names[@]}" ;;
    esac
}

# The disk to use, from the spare ones that fit: DISK when it is one of them, or the one chosen
pick_disk() {  # SPARE-JSON HEADER [DISK]
    local labels=() picked
    if [[ -n "${3:-}" ]]; then
        jq -e --arg path "/dev/${3#/dev/}" 'any(.[]; .path == $path)' <<<"$1" >/dev/null ||
            die "/dev/${3#/dev/} is not a spare disk that fits, or it is in use. ame system raid status lists the spare ones."
        printf '/dev/%s\n' "${3#/dev/}"
        return
    fi
    mapfile -t labels < <(disk_labels <<<"$1")
    [[ ${#labels[@]} -gt 0 ]] || return 1
    picked="$(gum choose --header "$2" "${labels[@]}")" || return 1
    printf '%s\n' "${picked%% *}"
}

# A line for each spare disk, its path first: what gum choose shows, without the commas it splits on
disk_labels() {
    jq -r "${HUMAN_JQ}"' .[] | "\(.path)  \(.size | human)  \(.model)\(if .serial != "" then "  " + .serial else "" end)\(if .usb then "  USB" else "" end)"
        | gsub(","; " ")'
}

# What a disk holds now, so that "ntfs Windows" or BitLocker stands out before it is erased
disk_plan() {  # SPARE-JSON PATH
    jq -r --arg path "$2" "${HUMAN_JQ}"' .[] | select(.path == $path)
        | "\(.path)  \(.model)  \(.serial)  \(.size | human)",
          "    now: " + (if .contents == [] then "nothing anyone can read"
                       else [.contents[] | .fstype + (if (.label // "") != "" then " \"\(.label)\"" else "" end)] | join(", ") end),
          (if .usb then "    on USB: a loose cable takes it out of the pool, so keep it plugged in." else empty end)' <<<"$1"
}

ask_erase() {
    local typed
    typed="$(gum input --placeholder "Type ERASE to erase $1")" || exit 0
    [[ "${typed}" == ERASE ]] || { echo "Nothing was erased."; exit 0; }
}

# Asked again once ERASE is typed, which can be long after the disks were listed: none of them may have
# been mounted or opened since
still_spare() {
    local spare disk
    spare="$(status_json | jq -c .spare)"
    for disk in "$@"; do
        jq -e --arg path "${disk}" 'any(.[]; .path == $path)' <<<"${spare}" >/dev/null ||
            die "${disk} is in use now, so nothing was erased."
    done
}

# A recovery key as systemd-cryptenroll makes one: 32 random bytes in modhex, eight groups of eight, which
# systemd's own password prompt recognises. One for the whole pool, so that one key written down opens
# every disk, which systemd-cryptenroll --recovery-key, making a new key for each disk, cannot do.
new_recovery_key() {
    od -An -vtx1 -N32 /dev/urandom | tr -d ' \n' | tr 0123456789abcdef cbdefghijklnrtuv | sed -E 's/.{8}/&-/g; s/-$//'
}

normalise_key() {
    local key
    key="$(tr -d ' \t' <<<"$1" | tr '[:upper:]' '[:lower:]')"
    [[ "${key}" =~ ^[a-z]{64}$ ]] && key="$(sed -E 's/.{8}/&-/g; s/-$//' <<<"${key}")"
    printf '%s\n' "${key}"
}

# Erases DISK and leaves one GPT partition over all of it, of the type and with the name given (a disk
# without a partition table is one Windows offers to initialise), and prints the partition's path
partition_disk() {  # DISK TYPE PARTNAME
    local nodes=() part
    mapfile -t nodes < <(lsblk -nrpo PATH "$1" 2>/dev/null | tac)
    # Not on standard output, which is the partition's path: wipefs says there, -q or not, that it had the
    # kernel read the partition table again, on any disk that had one
    as_root wipefs -a -q "${nodes[@]}" >&2 || return 1
    printf 'label: gpt\ntype=%s, name="%s"\n' "$2" "$3" |
        as_root sfdisk --quiet --wipe always --wipe-partitions always "$1" >/dev/null || return 1
    as_root udevadm settle
    part="$(lsblk -nrpo PATH,TYPE "$1" | awk '$2 == "part" { print $1; exit }')"
    [[ -n "${part}" ]] || return 1
    printf '%s\n' "${part}"
}

luks_format() {  # PART KEY POOL
    as_root cryptsetup luksFormat --type luks2 --batch-mode "${LUKS_PBKDF[@]}" --label "raid-$3" --key-file "$2" "$1"
}

# The recovery key in slot 1, as the text a person types: no newline
add_recovery() {  # PART KEY RECOVERY
    printf '%s' "$3" | as_root cryptsetup luksAddKey "${LUKS_PBKDF[@]}" --key-file "$2" --new-key-slot 1 "$1" /dev/stdin
}

# A line added to a file of root's, on a line of its own, the file made with MODE if it is not there
append_line() {  # FILE LINE MODE
    as_root test -e "$1" || as_root install -m "$3" /dev/null "$1"
    [[ -n "$(as_root tail -c 1 "$1")" ]] && printf '\n' | as_root tee -a "$1" >/dev/null
    printf '%s\n' "$2" | as_root tee -a "$1" >/dev/null
}

crypttab_line() {  # MAPPING LUKS-UUID POOL
    printf '%s UUID=%s %s/raid-%s.key luks,discard,nofail,x-systemd.device-timeout=30s' "$1" "$2" "${KEYS#"${R}"}" "$3"
}

# The number the next disk of a pool gets, after every one its partitions and crypttab lines name
next_index() {  # POOL
    local highest
    highest="$({
        lsblk -nro PARTLABEL 2>/dev/null
        as_root cat "${CRYPTTAB}" 2>/dev/null | crypt_lines_of "$1" | awk '{ print $1 }'
    } | sed -n "s/^raid-$1-\([0-9]\+\)\$/\1/p" | sort -n | tail -n 1)"
    echo $((${highest:-0} + 1))
}

# The partitions of a pool's disks that are there, encrypted, and none of the ones given
pool_luks_parts() {  # POOL EXCEPT...
    local pool="$1"
    shift
    lsblk -J -o PATH,PARTLABEL,FSTYPE 2>/dev/null | jq -r --arg pool "${pool}" '.. | objects
        | select(.fstype == "crypto_LUKS" and ((.partlabel // "") | test("^raid-" + $pool + "-[0-9]+$"))
            and (.path as $path | $ARGS.positional | index($path) | not)) | .path' --args "$@"
}

# A disk made ready to join a pool: partitioned, and for an encrypted pool formatted with the pool's key,
# given its recovery key, opened and written into /etc/crypttab. Prints the device btrfs is given. The
# disk on its way out of the pool, if one is, gets no new recovery key.
prepare_disk() {  # DISK POOL ENCRYPTED [OUTGOING-PARTITION]
    local disk="$1" name="$2" encrypted="$3" outgoing="${4:-}" index mapping part
    index="$(next_index "${name}")"
    mapping="raid-${name}-${index}"
    echo "Erasing ${disk}…" >&2
    if [[ "${encrypted}" != true ]]; then
        partition_disk "${disk}" "${LINUX_TYPE}" "${mapping}" || die "${disk} could not be partitioned."
        return
    fi
    # What this prints is the device, so whatever the steps say goes to stderr
    part="$(partition_disk "${disk}" "${LUKS_TYPE}" "${mapping}")" || die "${disk} could not be partitioned."
    luks_format "${part}" "${KEYS}/raid-${name}.key" "${name}" >&2 || die "${part} could not be encrypted."
    recovery_for "${name}" "${part}" "${outgoing}" || die "The recovery key could not be added to ${part}."
    as_root cryptsetup open --allow-discards --key-file "${KEYS}/raid-${name}.key" "${part}" "${mapping}" >&2 ||
        die "${part} could not be opened."
    append_line "${CRYPTTAB}" "$(crypttab_line "${mapping}" "$(as_root cryptsetup luksUUID "${part}")" "${name}")" 0600
    printf '/dev/mapper/%s\n' "${mapping}"
}

# Slot 1 of a new disk gets the pool's recovery key, typed in, which also shows that it is still known.
# Left empty, every disk of the pool gets a new one, and the old one stops working.
recovery_for() {  # POOL NEW-PART [OUTGOING-PART]
    local name="$1" part="$2" key="${KEYS}/raid-$1.key" recovery members=() member
    mapfile -t members < <(pool_luks_parts "${name}" "${part}" "${3:-}")
    while [[ ${#members[@]} -gt 0 ]]; do
        recovery="$(gum input --password --width 80 \
            --placeholder "The recovery key of ${name}; leave it empty to make a new one")" || return 1
        recovery="$(normalise_key "${recovery}")"
        [[ -n "${recovery}" ]] || break
        if printf '%s' "${recovery}" |
            as_root cryptsetup open --test-passphrase --key-slot 1 --key-file - "${members[0]}" 2>/dev/null; then
            add_recovery "${part}" "${key}" "${recovery}" >&2 || return 1
            echo "The recovery key opens the new disk too." >&2
            return 0
        fi
        echo "That is not the recovery key of ${name}." >&2
    done
    recovery="$(new_recovery_key)"
    for member in "${members[@]}"; do
        as_root cryptsetup luksKillSlot --batch-mode "${member}" 1 >/dev/null 2>&1
        add_recovery "${member}" "${key}" "${recovery}" >&2 || return 1
    done
    add_recovery "${part}" "${key}" "${recovery}" >&2 || return 1
    box "The new recovery key of ${name}:" "" "    ${recovery}" "" \
        "Write it down: the old one no longer opens the disks of the pool that are here. It opens them on any Linux machine, and without it a pool whose system disk is lost is lost too." >&2
}

# A long operation (a replace, a balance) in a unit of its own, so that closing the terminal does not stop
# it, with sleep held off: since kernel 6.19 a suspend cancels a replace, which then starts again from the
# beginning. It shows how far it is while it runs, and ends as the operation did.
long_run() {  # OP POOL WHY TARGET COMMAND...
    local op="$1" name="$2" why="$3" target="$4" watcher code
    shift 4
    as_root true || return 1
    echo "${why}. It goes on if this window is closed, and ame system raid status says when it has finished."
    (while sleep 5; do progress "${op}" "${target}"; done) &
    watcher=$!
    as_root systemd-run --unit="amethystora-raid-${op}-${name}" --description="${why}" --wait --quiet --collect \
        systemd-inhibit --what=sleep:idle --who=Amethystora --why="${why}" "$@"
    code=$?
    kill "${watcher}" 2>/dev/null
    wait "${watcher}" 2>/dev/null
    printf '\n'
    return "${code}"
}

progress() {  # OP TARGET
    local line=""
    case "$1" in
        replace) line="$(as_root_quietly btrfs replace status -1 "$2")" ;;
        scrub) line="$(as_root_quietly btrfs scrub status "$2" | awk -F": *" '/Bytes scrubbed/ { print "Checked " $2 }')" ;;
        *) line="$(as_root_quietly btrfs balance status "$2" | sed -n 2p)" ;;
    esac
    [[ -n "${line}" ]] && printf '\r\033[K%s' "${line}"
}

# What was written while a disk was missing went to single: back to the pool's own profiles. soft skips
# every chunk already right, so this is quick unless much was written meanwhile.
spread_back() {  # POOL TARGET
    local pool data metadata args=()
    pool="$(pool_json "$(status_json)" "$1")"
    data="$(jq -r '.layout // empty' <<<"${pool}")"
    metadata="$(jq -r '.metadata // empty' <<<"${pool}")"
    [[ -n "${data}" && "${data}" != single ]] && args+=("-dconvert=${data},soft")
    [[ -n "${metadata}" ]] && args+=("-mconvert=${metadata},soft")
    [[ ${#args[@]} -gt 0 ]] || return 0
    long_run balance "$1" "Putting back the copies of $(pool_words "$1")" "$2" btrfs balance start "${args[@]}" "$2"
}

# A pool's name as a sentence says it: the system's own disks are "the system"
pool_words() { if [[ "$1" == system ]]; then echo "the system"; else echo "$1"; fi; }

# The crypttab lines of a pool's disks that are no longer in it, the disk replaced, with their mappings.
# Nothing goes while any disk of the pool is still missing, which may come back, nor without the list of
# what is in the pool, without which nothing can be told apart.
# Whether a pool has room to be rebuilt: btrfs replace sets each part of the pool read-only in turn, which
# takes unallocated space on the disks that are there, and while a disk was missing everything written went
# to them. With less than a gigabyte on one of them it stops (ENOSPC), the new disk already erased. Chunks
# left empty go back first, which a balance of the empty ones alone does in a moment.
room_to_replace() {  # TARGET
    local least
    as_root btrfs balance start -dusage=0 -musage=0 "$1" >/dev/null 2>&1
    least="$(as_root btrfs device usage -b "$1" 2>/dev/null | awk '/^[^[:space:]].*, ID: / { there = ($1 ~ /^\//) }
        there && $1 == "Unallocated:" { print $2 }' | sort -n | head -n 1)"
    [[ -z "${least}" || "${least}" -ge "${GIB}" ]]
}

# A disk prepare_disk made ready that never joined its pool, blank again so that it shows as spare: its mapping
# closed, its crypttab line taken out, every signature on it wiped
unprepare_disk() {  # DISK SOURCE
    local mapping="${2#/dev/mapper/}" nodes=()
    if [[ "$2" == /dev/mapper/* ]]; then
        as_root cryptsetup close "${mapping}" 2>/dev/null
        as_root sed -i "/^${mapping}[[:space:]]/d" "${CRYPTTAB}"
        as_root systemctl daemon-reload
    fi
    mapfile -t nodes < <(lsblk -nrpo PATH "$1" 2>/dev/null | tac)
    as_root wipefs -a -q "${nodes[@]}" >&2
}

retire_lines() {  # POOL TARGET
    local devices members mapping dm
    devices="$(as_root btrfs filesystem show --raw "$2" 2>/dev/null | show_lines)"
    [[ -n "${devices}" ]] || return 0
    awk '$3 == "-" { found = 1 } END { exit !found }' <<<"${devices}" && return 0
    members="$(awk '{ print $3 }' <<<"${devices}")"
    while read -r mapping _; do
        [[ -n "${mapping}" ]] || continue
        dm="$(readlink -f "/dev/mapper/${mapping}" 2>/dev/null)"
        [[ -e "/dev/mapper/${mapping}" ]] && grep -qx "${dm##*/}" <<<"${members}" && continue
        as_root cryptsetup close "${mapping}" 2>/dev/null
        as_root sed -i "/^${mapping}[[:space:]]/d" "${CRYPTTAB}"
        echo "The old disk's line is out of /etc/crypttab."
    done < <(as_root cat "${CRYPTTAB}" 2>/dev/null | crypt_lines_of "$1")
    as_root systemctl daemon-reload
}

cmd_create() {
    need_terminal create
    local name="" chosen=() status spare count labels=() preselect=() picked=() sizes=() options layout="" lines=()
    local data metadata title encrypted=true i disk part mapping recovery="" key uuid devices=() opened=() luks=()
    local key_made=false owner n choice line
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
            --name=*) name="${1#--name=}"; shift ;;
            -*) die "$1 is no option of ame system raid create." ;;
            *) chosen+=("/dev/${1#/dev/}"); shift ;;
        esac
    done
    status="$(status_json)" || die "The disks could not be read."
    spare="$(jq -c .spare <<<"${status}")"
    count="$(jq length <<<"${spare}")"
    if ((count < 2)); then
        die "A pool needs two disks besides the system's, and this machine has ${count} to spare. A disk is not offered while anything on it is mounted or open (swap, an encrypted, md or LVM device), nor is any of the system's own."
    fi

    if [[ -n "${name}" ]]; then
        [[ "${name}" =~ ${NAME_RULE} ]] ||
            die "A pool's name is up to 31 lower case letters, digits and dashes, starting with a letter or a digit."
        [[ "${name}" != system ]] || die "system is what the status calls the system's own disks: choose another name."
        name_free "${name}" || die "There is already a pool, a folder or a key called ${name}: choose another name."
    else
        name=data n=2
        until name_free "${name}"; do name="data${n}" n=$((n + 1)); done
    fi

    if [[ ${#chosen[@]} -eq 0 ]]; then
        mapfile -t labels < <(disk_labels <<<"${spare}")
        # Every disk preselected that is not on USB, unless that leaves fewer than two
        mapfile -t preselect < <(printf '%s\n' "${labels[@]}" | grep -v '  USB$')
        [[ ${#preselect[@]} -ge 2 ]] || preselect=("${labels[@]}")
        mapfile -t picked < <(gum choose --no-limit --header "Which disks? Everything on them is erased." \
            --selected="$(IFS=,; echo "${preselect[*]}")" "${labels[@]}")
        for i in "${picked[@]}"; do chosen+=("${i%% *}"); done
    fi
    [[ ${#chosen[@]} -ge 2 ]] || die "A pool needs at least two disks. Nothing was erased."
    [[ "$(printf '%s\n' "${chosen[@]}" | sort -u | wc -l)" -eq ${#chosen[@]} ]] || die "A disk is named twice."
    for disk in "${chosen[@]}"; do
        jq -e --arg path "${disk}" 'any(.[]; .path == $path)' <<<"${spare}" >/dev/null ||
            die "${disk} is not a spare disk: ame system raid status lists them. Nothing was erased."
        sizes+=("$(jq -r --arg path "${disk}" '.[] | select(.path == $path) | .size' <<<"${spare}")")
    done

    # The layouts that fit that many disks, each with what it holds and survives, two copies first
    options="$(layouts "${sizes[@]}")"
    echo
    jq -r "${HUMAN_JQ}"' .[] | "  \(.title): \(.usable | human), "
        + (if .survives == 0 then "no copies" elif .survives == 1 then "survives one dead disk" else "survives two dead disks" end)
        + (if .note != null then ". \(.note)" else "" end),
        (if .warning != null then "      \(.warning)" else empty end)' <<<"${options}"
    echo
    mapfile -t labels < <(jq -r "${HUMAN_JQ}"' .[] | "\(.title) · \(.usable | human)"' <<<"${options}")
    choice="$(gum choose --header "Which layout?" "${labels[@]}")" || exit 0
    for i in "${!labels[@]}"; do
        [[ "${labels[i]}" == "${choice}" ]] && layout="$(jq -c --argjson i "${i}" '.[$i]' <<<"${options}")"
    done
    [[ -n "${layout}" ]] || exit 0
    data="$(jq -r .id <<<"${layout}")"
    metadata="$(jq -r .metadata <<<"${layout}")"
    title="$(jq -r .title <<<"${layout}")"

    echo
    if [[ -n "$(root_luks)" ]]; then
        echo "Encrypted, the pool's key is kept on the system disk, which is encrypted too: the pool opens with the"
        echo "system, and a pool disk taken out of the machine gives nothing away."
    else
        echo "Encrypted, the pool's key is kept on the system disk, which is not encrypted: anyone with this machine"
        echo "can open the pool, but a pool disk sent back under warranty or thrown away gives nothing away."
    fi
    echo "Not encrypted, anyone holding one of these disks can read what is on it."
    choice="$(gum choose --header "Encrypt the pool?" "Encrypt it" "Do not encrypt it")" || exit 0
    [[ "${choice}" == "Encrypt it" ]] || encrypted=false

    for disk in "${chosen[@]}"; do
        mapfile -t -O "${#lines[@]}" lines < <(disk_plan "${spare}" "${disk}")
    done
    lines+=("" "Layout: ${title} (data ${data}, metadata ${metadata}), about $(human "$(jq -r .usable <<<"${layout}")") to use")
    [[ "$(jq -r '.warning // empty' <<<"${layout}")" ]] && lines+=("$(jq -r .warning <<<"${layout}")")
    lines+=("Encrypted: $([[ "${encrypted}" == true ]] && echo yes || echo no)" "Name: ${name}, at ${MNT}/${name}")
    lines+=("" "Everything on these ${#chosen[@]} disks is erased.")
    box "${lines[@]}"
    ask_erase "these ${#chosen[@]} disks"
    still_spare "${chosen[@]}"

    as_root true || die "Nothing was erased."
    key="${KEYS}/raid-${name}.key"
    as_root test -e "${key}" && die "There is already a key for a pool called ${name}. Nothing was erased."
    as_root cat "${CRYPTTAB}" 2>/dev/null | crypt_lines_of "${name}" | grep -q . &&
        die "/etc/crypttab already has disks of a pool called ${name}. Nothing was erased."

    # From here on a failure leaves the disks erased, but nothing else behind
    failed() {
        local mapping
        printf '%s\n' "$1" >&2
        for mapping in "${opened[@]}"; do as_root cryptsetup close "${mapping}" 2>/dev/null; done
        [[ "${key_made}" == true ]] && as_root rm -f "${key}"
        die "The disks chosen are erased, but no pool was made: nothing was added to /etc/fstab or /etc/crypttab."
    }
    if [[ "${encrypted}" == true ]]; then
        as_root install -d -m 0700 "${KEYS}" || failed "${KEYS} could not be made."
        as_root bash -c 'umask 0377 && head -c 64 /dev/urandom >"$1"' _ "${key}" || failed "The key could not be written."
        key_made=true
        as_root restorecon "${KEYS}" "${key}" 2>/dev/null
        recovery="$(new_recovery_key)"
    fi
    for i in "${!chosen[@]}"; do
        disk="${chosen[i]}"
        mapping="raid-${name}-$((i + 1))"
        echo "Erasing ${disk}…"
        if [[ "${encrypted}" == true ]]; then
            part="$(partition_disk "${disk}" "${LUKS_TYPE}" "${mapping}")" || failed "${disk} could not be partitioned."
            luks_format "${part}" "${key}" "${name}" || failed "${part} could not be encrypted."
            add_recovery "${part}" "${key}" "${recovery}" || failed "The recovery key could not be added to ${part}."
            as_root cryptsetup open --allow-discards --key-file "${key}" "${part}" "${mapping}" ||
                failed "${part} could not be opened."
            opened+=("${mapping}")
            luks+=("$(crypttab_line "${mapping}" "$(as_root cryptsetup luksUUID "${part}")" "${name}")")
            devices+=("/dev/mapper/${mapping}")
        else
            part="$(partition_disk "${disk}" "${LINUX_TYPE}" "${mapping}")" || failed "${disk} could not be partitioned."
            devices+=("${part}")
        fi
    done
    echo "Making the pool…"
    as_root mkfs.btrfs -f -q -L "${name}" -d "${data}" -m "${metadata}" "${devices[@]}" || failed "mkfs.btrfs failed."
    as_root udevadm settle
    as_root btrfs device scan "${devices[@]}" >/dev/null 2>&1
    uuid="$(as_root blkid -p -s UUID -o value "${devices[0]}")"
    [[ -n "${uuid}" ]] || failed "The new filesystem could not be found."

    # Into /etc/crypttab and /etc/fstab, each with nofail, which crypttab(5) says both need for a missing
    # disk not to hold up the boot. compress=zstd:1 is the installer's own; x-systemd.device-bound=no keeps
    # systemd from unmounting the pool when the one disk it was mounted from goes, where the kernel goes on
    # with the others; x-gvfs-show puts the pool in the Files sidebar; x-amethystora-raid tells the status a
    # pool is expected, which systemd ignores.
    for line in "${luks[@]}"; do
        append_line "${CRYPTTAB}" "${line}" 0600
    done
    append_line "${FSTAB}" "UUID=${uuid} ${MNT}/${name} btrfs compress=zstd:1,nofail,x-systemd.device-bound=no,x-systemd.device-timeout=30s,x-gvfs-show,x-amethystora-raid 0 0" 0644

    as_root install -d -m 0755 "${MNT}/${name}"
    as_root systemctl daemon-reload
    as_root systemctl start "$(mount_unit "${name}")" ||
        die "The pool is made and in /etc/fstab, but it did not mount: journalctl -b -k -g btrfs says why."
    owner="${SUDO_UID:-$(id -u)}:${SUDO_GID:-$(id -g)}"
    as_root chown "${owner}" "${MNT}/${name}"
    as_root restorecon "${MNT}/${name}" 2>/dev/null

    echo
    box "The pool ${name} is ready at ${MNT}/${name}, in the Files sidebar, with room for about $(human "$(df -B1 --output=avail "${MNT}/${name}" | tail -n 1)")." \
        "" "A pool is not a backup: a file deleted, or encrypted by ransomware, is gone from every disk at once. ame backup keeps copies elsewhere."
    if [[ -n "${recovery}" ]]; then
        box --border-foreground 3 "Its recovery key, shown only this once:" "" "    ${recovery}" "" \
            "Write it down. It opens these disks on any Linux machine, and without it a pool whose system disk is lost is lost too."
    fi
}

# Opens a pool that did not mount: the ordinary way when all its disks are there, and otherwise with one
# missing, writable while the layout survives what is missing and read-only when it does not, which the
# kernel decides. Never written into /etc/fstab: the next boot tries the ordinary way again.
open_pool() {  # STATUS NAME
    local pool uuid line mapping luks member=""
    pool="$(pool_json "$1" "$2")"
    uuid="$(jq -r .uuid <<<"${pool}")"
    as_root true || return 1
    # Each disk that is there unlocked as at boot, where it was not
    while read -r mapping luks; do
        [[ -n "${mapping}" && ! -e "/dev/mapper/${mapping}" && -e "/dev/disk/by-uuid/${luks}" ]] || continue
        as_root systemctl start "$(crypt_unit "${mapping}")"
    done < <(as_root cat "${CRYPTTAB}" 2>/dev/null | crypt_lines_of "$2")
    as_root btrfs device scan >/dev/null 2>&1
    if as_root timeout 60 systemctl start "$(mount_unit "$2")" 2>/dev/null; then
        echo "All the disks of $2 are there: it is mounted at ${MNT}/$2."
        return 0
    fi
    member="$(lsblk -J -o PATH,FSTYPE,UUID 2>/dev/null |
        jq -r --arg uuid "${uuid}" '[.. | objects | select(.fstype == "btrfs" and .uuid == $uuid) | .path] | first // empty')"
    [[ -n "${member}" ]] || { echo "None of the disks of $2 is there, or none could be unlocked." >&2; return 1; }
    as_root install -d -m 0755 "${MNT}/$2"
    if as_root mount -t btrfs -o degraded,compress=zstd:1 "${member}" "${MNT}/$2"; then
        echo "$2 is open at ${MNT}/$2 with a disk missing. What is written now has one copy until the disk is"
        echo "replaced: ame system raid replace $2."
        return 0
    fi
    if as_root mount -t btrfs -o degraded,ro "${member}" "${MNT}/$2"; then
        echo "$2 is open at ${MNT}/$2, read-only: more disks are missing than its layout survives, so the files"
        echo "that were on them are gone until they are back. Copy off what you need."
        return 2
    fi
    echo "$2 could not be opened even with a disk missing: journalctl -b -k -g btrfs says why." >&2
    return 1
}

cmd_mount() {
    local status name
    status="$(status_json)" || die "The disks could not be read."
    name="$(pick_pool "${status}" "${1:-}")" || exit 1
    [[ "$(jq -r .mounted <<<"$(pool_json "${status}" "${name}")")" == false ]] ||
        die "${name} is already mounted, at ${MNT}/${name}."
    open_pool "${status}" "${name}"
    [[ $? -ne 1 ]]
}

# Copies put back after a disk was missing: the system's /boot halves that are not in its mirror again, every
# copy read and an old one rewritten from a good one (a disk that came back has the old copies of what was
# written while it was away, which btrfs counts as errors as it finds them), what has one copy given its
# second, and the disk that came back no longer counting what it missed
put_back() {  # NAME TARGET POOL-JSON
    local name="$1" target="$2" pool="$3" returned=() line devid kname part code disk what
    what="$(pool_words "${name}")"
    mapfile -t returned < <(jq -r '.devices[] | select(.returned) | "\(.devid) \(.kname)"' <<<"${pool}")
    [[ ${#returned[@]} -gt 0 ]] && echo "A disk of ${what} that was missing is back, with old copies of what was written while it was away."
    jq -e '.degraded' <<<"${pool}" >/dev/null && echo "Part of ${what} has one copy, written while a disk was missing."
    jq -e '.boot.degraded == true' <<<"${pool}" >/dev/null && echo "The boot files of the system have one copy."
    gum confirm "Put the copies back now? It reads everything, so it takes a while on a large disk." || exit 0
    as_root true || exit 1
    if jq -e '.boot.degraded == true' <<<"${pool}" >/dev/null; then
        for disk in $(jq -r '.devices[] | select(.missing | not) | .disk.path // empty' <<<"${pool}" | sort -u); do
            part="$(boot_half_on "${disk}")"
            [[ -n "${part}" ]] || continue
            grep -qw "${part##*/}" /proc/mdstat && continue
            echo "${part} joins the mirror of /boot again."
            as_root mdadm "${BOOT_MD}" --re-add "${part}" >/dev/null 2>&1 ||
                { as_root wipefs -a -q "${part}" && as_root mdadm "${BOOT_MD}" --add "${part}" >/dev/null; } ||
                echo "${part} could not join the mirror of /boot: mdadm --detail ${BOOT_MD} says why." >&2
        done
    fi
    if [[ ${#returned[@]} -gt 0 ]]; then
        long_run scrub "${name}" "Checking every copy of ${what}" "${target}" btrfs scrub start -B "${target}"
        code=$?
        [[ ${code} -eq 3 ]] && die "The check found damage it could not repair from another copy: journalctl -k -g btrfs names the files."
        [[ ${code} -eq 0 ]] || die "The check did not finish: journalctl -u amethystora-raid-scrub-${name} says why."
    fi
    spread_back "${name}" "${target}" || die "That did not finish: journalctl -u amethystora-raid-balance-${name} says why."
    for line in "${returned[@]}"; do
        read -r devid kname <<<"${line}"
        as_root btrfs device stats --reset "/dev/${kname}" >/dev/null
    done
    [[ ${#returned[@]} -gt 0 ]] && forget_missing "$(jq -r .uuid <<<"${pool}")" $(printf '%s\n' "${returned[@]}" | awk '{ print $1 }')
    # A replace whose window was closed before it got this far left the old disk's line behind
    [[ "$(jq -r '.encrypted and .managed' <<<"${pool}")" == true ]] && retire_lines "${name}" "${target}"
    echo "Every file of ${what} has its copies again."
}

# A new disk of the system in place of one that is gone or failing: like the disk that is left, an EFI
# partition, a half of /boot's mirror and the rest for the system when the system was mirrored onto a disk of
# its own (2b), or one partition for the system when the installer spread it (2a), encrypted with the system's
# passphrase when it is. The dead disk's kernel argument, crypttab line and firmware entry go after.
replace_system() {  # STATUS POOL-JSON DEVID OLD-KNAME CHOICE SIZE
    local status="$1" pool="$2" devid="$3" old="$4" choice="$5" size="$6" target encrypted template template_part template_disk
    local mirrored=false candidates disk lines=() passphrase="" outgoing="" esp boot_uuid new_esp new_boot new_root source args=()
    local part uuid entry number need header=0
    target="$(jq -r .target <<<"${pool}")"
    encrypted="$(jq -r .encrypted <<<"${pool}")"
    jq -e '.boot != null' <<<"${pool}" >/dev/null && mirrored=true
    # The disk that stays, which the new one is made like
    template="$(jq -r --argjson devid "${devid}" '[.devices[] | select((.missing | not) and .devid != $devid) | .kname] | first // empty' <<<"${pool}")"
    [[ -n "${template}" ]] || die "No disk of the system is left to copy onto a new one."
    template_part="$(luks_under "${template}" | head -n 1)"
    template_part="${template_part:-/dev/${template}}"
    template_disk="$(disk_of_part "${template_part}")"
    # At least as large as the system's part of the disk that goes, as btrfs replace requires, with LUKS's header,
    # the partition table's first megabyte, and the EFI partition and /boot's half beside it: a disk the same size
    # as the one that goes always is. Checked again exactly once it is partitioned.
    [[ "${encrypted}" == true ]] && header=$((LUKS_OVERHEAD - PLAIN_OVERHEAD))
    need=$((size + header + 1048576))
    if [[ "${mirrored}" == true ]]; then
        esp="$(esp_on "${template_disk}")"
        part="$(boot_half_on "${template_disk}")"
        [[ -n "${esp}" && -n "${part}" ]] || die "The EFI partition or /boot's half on ${template_disk} could not be found."
        need=$((need + $(part_size "${esp}") + $(part_size "${part}")))
    fi
    candidates="$(jq -c --argjson need "${need}" '.spare | map(select(.size >= $need))' <<<"${status}")"
    [[ "$(jq length <<<"${candidates}")" -gt 0 ]] ||
        die "No spare disk is large enough to take its place: the new one needs $(human "${need}") or more. Connect one, then run ame system raid replace system again."
    disk="$(pick_disk "${candidates}" "Which disk takes its place? Everything on it is erased.")" || exit 0
    mapfile -t lines < <(disk_plan "${candidates}" "${disk}")
    box "Disk ${devid} of the system ($(sed -E 's/^disk [0-9]+ +//' <<<"${choice}")) is replaced by:" "" "${lines[@]}" "" \
        "Everything on ${disk} is erased.$([[ "${mirrored}" == true ]] && echo " It gets an EFI partition and a half of /boot of its own, so that the machine starts from it too.")"
    ask_erase "${disk}"
    still_spare "${disk}"
    as_root true || exit 1
    [[ "${encrypted}" == true ]] && passphrase="$(ask_passphrase "${template_part}")"
    hold_updates
    [[ "${old}" != - ]] && outgoing="$(luks_under "${old}" | head -n 1)"

    echo "Erasing ${disk}…"
    mapfile -t lines < <(lsblk -nrpo PATH "${disk}" | tac)
    as_root wipefs -a -q "${lines[@]}" >&2 || die "${disk} could not be erased."
    if [[ "${mirrored}" == true ]]; then
        printf 'label: gpt\nsize=%s, type=%s, name="EFI System Partition"\nsize=%s, type=%s, name="boot"\ntype=%s, name="system"\n' \
            "$(($(part_size "${esp}") / 512))" "${ESP_TYPE}" "$(($(part_size "${part}") / 512))" "${RAID_TYPE}" "$(part_type "${template_part}")" |
            as_root sfdisk --quiet --wipe always --wipe-partitions always "${disk}" >/dev/null || die "${disk} could not be partitioned."
        as_root udevadm settle
        new_esp="$(part_of "${disk}" 1)" new_boot="$(part_of "${disk}" 2)" new_root="$(part_of "${disk}" 3)"
    else
        printf 'label: gpt\ntype=%s, name="system"\n' "$(part_type "${template_part}")" |
            as_root sfdisk --quiet --wipe always --wipe-partitions always "${disk}" >/dev/null || die "${disk} could not be partitioned."
        as_root udevadm settle
        new_root="$(part_of "${disk}" 1)"
    fi
    [[ -n "${new_root}" ]] || die "${disk} could not be partitioned."
    (($(part_size "${new_root}") - header >= size)) ||
        die "${disk} is a little too small to take its place: the system needs $(human "$((size + header))") on it. Nothing but ${disk} was changed."
    if [[ "${encrypted}" == true ]]; then
        source="$(system_luks "${new_root}" "${passphrase}")" || die "${new_root} could not be encrypted."
    else
        source="${new_root}"
    fi
    if [[ "${old}" == - ]]; then args=("${devid}"); else args=(-r "/dev/${old}"); fi
    long_run replace system "Replacing disk ${devid} of the system" "${target}" btrfs replace start -B -f "${args[@]}" "${source}" "${target}" ||
        die "The replace did not finish: journalctl -u amethystora-raid-replace-system says why."
    as_root btrfs filesystem resize "${devid}:max" "${target}" >/dev/null 2>&1
    spread_back system "${target}" || echo "Putting back the copies did not finish: run ame system raid replace system again."
    forget_missing "$(jq -r .uuid <<<"${pool}")" "${devid}"

    if [[ "${mirrored}" == true ]]; then
        echo "The new disk joins /boot's mirror, and gets the EFI partition's files."
        boot_uuid="$(as_root blkid -p -s UUID -o value "${BOOT_MD}")"
        as_root mdadm "${BOOT_MD}" --remove failed >/dev/null 2>&1
        as_root mdadm "${BOOT_MD}" --remove detached >/dev/null 2>&1
        as_root mdadm "${BOOT_MD}" --add "${new_boot}" >/dev/null || echo "${new_boot} could not join /boot's mirror: mdadm --detail ${BOOT_MD} says why." >&2
        copy_esp "${esp}" "${new_esp}" "${boot_uuid}" || echo "The EFI partition could not be copied onto ${new_esp}." >&2
        entry="$(efi_entry "${new_esp}" "Amethystora (${disk##*/})" "${esp}")" || echo "The firmware's boot entry for ${disk} could not be made." >&2
        # The entries made for a disk that is gone, and /boot/efi on one that is
        while read -r number part; do
            [[ -n "${part}" && ! -e "/dev/disk/by-partuuid/${part}" ]] && as_root efibootmgr --quiet --delete-bootnum --bootnum "${number}" >/dev/null
        done < <(as_root efibootmgr -v | awk '/Amethystora \(/ && match(tolower($0), /hd\([0-9]+,gpt,[0-9a-f-]+/) {
            n = $1; sub(/^Boot/, "", n); sub(/\*$/, "", n); split(substr(tolower($0), RSTART, RLENGTH), p, ","); print n, p[3] }')
        uuid="$(awk '!/^[[:space:]]*#/ && $2 == "/boot/efi" { sub(/^UUID=/, "", $1); print $1 }' "${FSTAB}")"
        if [[ -n "${uuid}" && ! -e "/dev/disk/by-uuid/${uuid}" ]]; then
            as_root sed -i -E "s#^UUID=${uuid}([[:space:]]+/boot/efi[[:space:]])#UUID=$(lsblk -ndo UUID "${esp}")\1#" "${FSTAB}"
            as_root systemctl daemon-reload
        fi
    fi
    # The old disk's key: its kernel argument and crypttab line, which would have the next boot wait for it. Only
    # the system's own, which the kernel arguments name: a pool's disk unplugged now keeps its line.
    if [[ "${encrypted}" == true ]]; then
        [[ -n "${outgoing}" ]] && uuid="$(as_root cryptsetup luksUUID "${outgoing}" 2>/dev/null)" && as_root cryptsetup close "luks-${uuid}" 2>/dev/null
        for uuid in $(tr ' ' '\n' </proc/cmdline | sed -n 's/^rd\.luks\.uuid=\(luks-\)\?//p'); do
            if [[ ! -e "/dev/disk/by-uuid/${uuid}" ]] || { [[ -n "${outgoing}" ]] && [[ "$(as_root cryptsetup luksUUID "${outgoing}" 2>/dev/null)" == "${uuid}" ]]; }; then
                kargs_remove "rd.luks.uuid=luks-${uuid}"
                kargs_remove "rd.luks.uuid=${uuid}"
                as_root sed -i "/^[^#[:space:]]*[[:space:]]\+UUID=${uuid}[[:space:]]/d" "${CRYPTTAB}"
            fi
        done
    fi
    system_crypttab_nofail
    write_boot_entry
    release_updates
    echo "Disk ${devid} of the system is replaced."
    if [[ "${encrypted}" == true ]] && as_root cryptsetup luksDump "${template_part}" | grep -q systemd-tpm2; then
        echo
        echo "The TPM opens the system's disks at boot. It needs a key for the new one too:"
        ame security disk-unlock on-pin
    fi
}

cmd_replace() {
    need_terminal replace
    local status name pool target devid old encrypted lines=() candidates choice need size old_line source args=()
    local disk outgoing="" system=false
    status="$(status_json)" || die "The disks could not be read."
    if [[ "${1:-}" == system ]]; then
        system=true name=system
        pool="$(jq -c 'first(.pools[] | select(.system)) // empty' <<<"${status}")"
        [[ -n "${pool}" ]] || die "The system is on one disk: ame system raid mirror DISK copies it onto another."
        jq -e '.mirror == null' <<<"${pool}" >/dev/null || die "The system's mirror is waiting for its restart: restart first."
        jq -e '.layout != "single"' <<<"${pool}" >/dev/null ||
            die "The system keeps one copy of each file, so a dead disk's files cannot be rebuilt: ame system raid mirror keeps a copy on each disk while they are all there."
    else
        name="$(pick_pool "${status}" "${1:-}")" || exit 1
        pool="$(pool_json "${status}" "${name}")"
    fi
    if [[ "$(jq -r .mounted <<<"${pool}")" == false ]]; then
        echo "${name} is not mounted, so it is opened with a disk missing first."
        open_pool "${status}" "${name}"
        case $? in
            0) ;;
            2) die "No disk of ${name} can be replaced: there is nothing left to copy back onto a new one. Copy off what you need from ${MNT}/${name}." ;;
            *) exit 1 ;;
        esac
        status="$(status_json)"
        pool="$(pool_json "${status}" "${name}")"
    fi
    jq -e '.busy == [] and .operation == null' <<<"${pool}" >/dev/null ||
        die "${name} is busy with a long operation: ame system raid status says when it has finished."
    target="$(jq -r .target <<<"${pool}")"
    encrypted="$(jq -r .encrypted <<<"${pool}")"

    # The disk to replace: a missing one, a failing one or one counting errors, or, asked first, any. One that
    # came back counts what it missed, which putting the copies back mends.
    if ! jq -e 'any(.devices[]; .missing or .smart == "failed" or ((.returned | not) and .error_count > 0))' <<<"${pool}" >/dev/null; then
        if jq -e '.degraded or any(.devices[]; .returned) or .boot.degraded == true' <<<"${pool}" >/dev/null; then
            put_back "${name}" "${target}" "${pool}"
            exit 0
        fi
        echo "Every disk of $(pool_words "${name}") is fine."
        gum confirm --default=no "Replace one anyway?" || exit 0
    fi
    room_to_replace "${target}" ||
        die "${name} is too full to be rebuilt: btrfs needs a gigabyte free on each disk that is left. Delete what you can spare$([[ "${system}" == true ]] || echo " from ${MNT}/${name}"), then run ame system raid replace ${name} again. Nothing was erased."
    mapfile -t lines < <(jq -r '.devices | sort_by((.missing or .smart == "failed" or .error_count > 0) | not)[]
        | "disk \(.devid)  " + (if (.disk.model // "") != "" then "\(.disk.model) \(.disk.serial // "")" else "" end)
          + (if .missing then "  missing" elif .smart == "failed" then "  failing" elif .error_count > 0 then "  \(.error_count) errors" else "  fine" end)' <<<"${pool}")
    choice="$(gum choose --header "Which disk of $(pool_words "${name}") goes?" "${lines[@]}")" || exit 0
    devid="$(awk '{ print $2; exit }' <<<"${choice}")"
    as_root true || exit 1
    old_line="$(as_root btrfs filesystem show --raw "${target}" | show_lines | awk -v devid="${devid}" '$1 == devid')"
    size="$(awk '{ print $2 }' <<<"${old_line}")"
    old="$(awk '{ print $3 }' <<<"${old_line}")"
    [[ -n "${size}" ]] || die "btrfs does not know disk ${devid} of ${name}."
    size="$(devid_size "${target}" "${devid}" "${size}")"
    size="${size:-0}"
    if [[ "${old}" == - ]] && jq -e '.survives == 0' <<<"${pool}" >/dev/null; then
        die "${name} keeps no copies, so what was on disk ${devid} cannot be rebuilt: its files are gone until it is back. Copy off the rest from ${MNT}/${name}."
    fi
    if [[ "${system}" == true ]]; then
        replace_system "${status}" "${pool}" "${devid}" "${old}" "${choice}" "${size}"
        return
    fi

    # A replacement at least as large, as btrfs replace requires, with room for its partition table and LUKS
    if [[ "${encrypted}" == true ]]; then need=$((size + LUKS_OVERHEAD)); else need=$((size + PLAIN_OVERHEAD)); fi
    candidates="$(jq -c --argjson need "${need}" '.spare | map(select(.size >= $need))' <<<"${status}")"
    [[ "$(jq length <<<"${candidates}")" -gt 0 ]] ||
        die "No spare disk is large enough: the new one needs $(human "${need}") or more. Connect one, then run ame system raid replace ${name} again."
    disk="$(pick_disk "${candidates}" "Which disk takes its place? Everything on it is erased.")" || exit 0
    mapfile -t lines < <(disk_plan "${candidates}" "${disk}")
    box "Disk ${devid} of ${name} ($(sed -E 's/^disk [0-9]+ +//' <<<"${choice}")) is replaced by:" "" "${lines[@]}" "" \
        "Everything on ${disk} is erased."
    ask_erase "${disk}"
    still_spare "${disk}"

    # A missing disk by its devid; one that is there but failing by its path, with -r, so that each block
    # is read from a good copy where there is one. The LUKS partition under that one keeps its old
    # recovery key: it is leaving.
    if [[ "${old}" == - ]]; then
        args=("${devid}")
    else
        args=(-r "/dev/${old}")
        outgoing="$(find "${SYS}/class/block/${old}/slaves" -mindepth 1 -maxdepth 1 -printf '/dev/%f\n' 2>/dev/null | head -n 1)"
    fi
    source="$(prepare_disk "${disk}" "${name}" "${encrypted}" "${outgoing}")" || exit 1
    if ! long_run replace "${name}" "Replacing disk ${devid} of ${name}" "${target}" \
        btrfs replace start -B -f "${args[@]}" "${source}" "${target}"; then
        unprepare_disk "${disk}" "${source}" &&
            die "The replace did not finish: journalctl -u amethystora-raid-replace-${name} says why. ${disk} is blank again."
        die "The replace did not finish: journalctl -u amethystora-raid-replace-${name} says why."
    fi
    # systemd (262, Fedora 45) takes an encrypted disk with nothing left on it for one not ready, and stops the pool's
    # mount, which requires the disk it was mounted from, when that was the disk replaced: it is mounted again from
    # its fstab line, as the unit would still wait for that disk
    as_root udevadm settle
    for _ in {1..50}; do systemctl list-jobs --no-legend "$(mount_unit "${name}")" 2>/dev/null | grep -q . || break; sleep 0.2; done
    findmnt -rn --mountpoint "${target}" >/dev/null || as_root mount "${target}" ||
        die "The replace finished, but ${name} could not be mounted again: ame system raid mount ${name}."
    # A larger disk gives what it can; and what was written as single while a disk was missing, which a
    # replace leaves as it is, gets its copies back
    as_root btrfs filesystem resize "${devid}:max" "${target}" >/dev/null 2>&1
    spread_back "${name}" "${target}" || echo "Putting back the copies did not finish: run ame system raid replace ${name} again."
    [[ "${encrypted}" == true ]] && retire_lines "${name}" "${target}"
    forget_missing "$(jq -r .uuid <<<"${pool}")" "${devid}"
    echo "Disk ${devid} of ${name} is replaced."
}

cmd_add() {
    need_terminal add
    local status name pool target encrypted disk lines=() source used devices metadata
    status="$(status_json)" || die "The disks could not be read."
    name="$(pick_pool "${status}" "${1:-}")" || exit 1
    pool="$(pool_json "${status}" "${name}")"
    [[ "$(jq -r .mounted <<<"${pool}")" == true ]] || die "${name} is not mounted. Open it first: ame system raid mount ${name}."
    jq -e '.busy == [] and .operation == null' <<<"${pool}" >/dev/null ||
        die "${name} is busy with a long operation: ame system raid status says when it has finished."
    target="$(jq -r .target <<<"${pool}")"
    encrypted="$(jq -r .encrypted <<<"${pool}")"
    [[ "$(jq '.spare | length' <<<"${status}")" -gt 0 ]] || die "There is no spare disk to add."
    disk="$(pick_disk "$(jq -c .spare <<<"${status}")" "Which disk joins ${name}? Everything on it is erased." "${2:-}")" || exit 0
    mapfile -t lines < <(disk_plan "$(jq -c .spare <<<"${status}")" "${disk}")
    box "This disk joins ${name}:" "" "${lines[@]}" "" "Everything on ${disk} is erased."
    ask_erase "${disk}"
    still_spare "${disk}"

    source="$(prepare_disk "${disk}" "${name}" "${encrypted}")" || exit 1
    as_root btrfs device add -f "${source}" "${target}" || die "btrfs could not add ${disk} to ${name}."
    echo "${disk} is in ${name}: new files spread over every disk."

    devices="$(jq '.devices | length + 1' <<<"${pool}")"
    metadata="$(jq -r '.metadata // empty' <<<"${pool}")"
    if [[ "${metadata}" == raid1 && "${devices}" -ge 3 ]]; then
        echo
        echo "With three disks, the metadata, which says where every file is, can have three copies."
        if gum confirm "Keep three copies of it? It takes a minute or so."; then
            long_run balance "${name}" "Keeping three copies of the metadata of ${name}" "${target}" \
                btrfs balance start -mconvert=raid1c3,soft "${target}" || echo "That did not finish."
        fi
    fi
    used="$(human "$(jq -r '.used // 0' <<<"${pool}")")"
    echo
    echo "The ${used} already in ${name} stays where it is unless it is spread over every disk now. On a"
    echo "large pool that takes hours; without it, only what is written from now on uses the new disk."
    if gum confirm --default=no "Spread it now?"; then
        long_run balance "${name}" "Spreading ${name} over every disk" "${target}" \
            btrfs balance start --full-balance "${target}" || die "That did not finish: journalctl -u amethystora-raid-balance-${name} says why."
        echo "Done: ${name} is spread over every disk."
    fi
}

cmd_forget() {
    need_terminal forget
    local status name pool uuid encrypted mapping
    status="$(status_json)" || die "The disks could not be read."
    name="$(pick_pool "${status}" "${1:-}")" || exit 1
    pool="$(pool_json "${status}" "${name}")"
    uuid="$(jq -r .uuid <<<"${pool}")"
    encrypted="$(jq -r .encrypted <<<"${pool}")"
    echo "This stops mounting ${name}. Its files stay on its disks, and nothing is erased: GNOME Disks' Format"
    echo "erases a disk when you want it back."
    if [[ "${encrypted}" == true ]]; then
        echo "Its key file is deleted, so from then on the recovery key is the only way into its disks."
    fi
    gum confirm --default=no "Forget ${name}?" || exit 0
    as_root true || exit 1
    if [[ "$(jq -r .mounted <<<"${pool}")" == true ]]; then
        as_root systemctl stop "$(mount_unit "${name}")" 2>/dev/null || as_root umount "${MNT}/${name}" 2>/dev/null
        if findmnt -rn --mountpoint "${MNT}/${name}" >/dev/null; then
            die "Something still uses ${MNT}/${name}: close the files and apps open there, then try again."
        fi
    fi
    while read -r mapping _; do
        [[ -n "${mapping}" ]] || continue
        as_root systemctl stop "$(crypt_unit "${mapping}")" 2>/dev/null
        [[ -e "/dev/mapper/${mapping}" ]] && as_root cryptsetup close "${mapping}"
    done < <(as_root cat "${CRYPTTAB}" 2>/dev/null | crypt_lines_of "${name}")
    as_root sed -i "\#^UUID=${uuid}[[:space:]]\+${MNT}/${name}[[:space:]].*x-amethystora-raid#d" "${FSTAB}"
    as_root test -e "${CRYPTTAB}" && as_root sed -i "/^raid-${name}-[0-9]\+[[:space:]]/d" "${CRYPTTAB}"
    as_root rm -f "${KEYS}/raid-${name}.key"
    as_root systemctl daemon-reload
    as_root rmdir "${MNT}/${name}" 2>/dev/null
    echo "${name} is forgotten. Its disks show as spare: making a pool of them erases them."
}

# --- The system's own disks ------------------------------------------------------------------------------

BOOT_ENTRY_BEGIN='### BEGIN amethystora-raid ###'
BOOT_ENTRY_END='### END amethystora-raid ###'

# The mount of /boot itself, not the automount systemd may keep over it: "source options"
boot_mount() {
    findmnt -rn -o SOURCE,FSTYPE,OPTIONS --mountpoint /boot 2>/dev/null | awk '$2 != "autofs" { print $1, $3; exit }'
}

# COMMAND... with /boot writable, as ostree makes it for its own changes, and read-only again after when it was.
# On a system whose /boot is a folder of its btrfs, /boot is a bind mount, which is remounted as one.
with_boot_rw() {
    local source options bind="" code
    read -r source options <<<"$(boot_mount)"
    [[ "${source}" == *\[* ]] && bind=bind,
    if [[ ",${options}," == *,ro,* ]]; then
        as_root mount -o "remount,${bind}rw" /boot || return 1
        "$@"
        code=$?
        as_root mount -o "remount,${bind}ro" /boot
        return "${code}"
    fi
    "$@"
}

# A kernel argument added to every deployment's boot entry in place, which is what ostree's in-place edit writes
# and the next deployment takes its own from. Not that edit itself: its --append-if-missing, all it has, skips a
# key that is there already, and a second disk's rd.luks.uuid has the first's beside it.
kargs_add() {  # ARG
    with_boot_rw as_root bash -c 'for entry in "$2"/loader/entries/*.conf; do
        awk -v arg="$1" '\''$1 == "options" { for (i = 2; i <= NF; i++) if ($i == arg) { print; next } print $0 " " arg; next } { print }'\'' \
            "${entry}" >"${entry}.new" && mv -f "${entry}.new" "${entry}" || exit 1; done' _ "$1" "${BOOT}"
}

# One taken away from every deployment's boot entry, the same way
kargs_remove() {  # ARG
    with_boot_rw as_root bash -c 'for entry in "$2"/loader/entries/*.conf; do
        awk -v arg="$1" '\''$1 == "options" { line = "options"; for (i = 2; i <= NF; i++) if ($i != arg) line = line " " $i; print line; next } { print }'\'' \
            "${entry}" >"${entry}.new" && mv -f "${entry}.new" "${entry}"; done' _ "$1" "${BOOT}"
}

# The boot entry's options, made to start the system with a disk missing: btrfs mounted degraded (which the
# initramfs's amethystora-degraded rule lets it be), and every LUKS device nofail, so that the missing one is
# not waited for, keeping options already given to all of them (the TPM's)
degraded_options() {
    awk '{ for (i = 1; i <= NF; i++) {
            if ($i ~ /^rootflags=/) { if ($i !~ /degraded/) $i = $i ",degraded"; flags = 1 }
            else if ($i ~ /^rd\.luks\.options=/ && $i !~ /^rd\.luks\.options=(luks-)?[0-9a-fA-F]{8}-[0-9a-fA-F-]{27}=/) {
                if ($i !~ /nofail/) $i = $i ",nofail"; nofail = 1 }
            else if ($i ~ /^rd\.luks\.uuid=/) luks = 1 }
        line = $0
        if (!flags) line = line " rootflags=degraded"
        if (luks && !nofail) line = line " rd.luks.options=nofail"
        print line }'
}

# The boot menu entry that starts the system with one of its disks missing, for custom.cfg, which bootupd's own
# grub.cfg reads after its entries: the default deployment's entry (ostree titles it "(ostree:0)"), with its
# ostree= path as ostree wrote it, since ostree-prepare-root takes only that /ostree/boot.N link. The next update
# replaces those links, so this is written again at each start and at each shutdown, after ostree has written
# the new entries (amethystora-raid-boot.service). The menu waits 5 s, not 1, to give time to choose it.
degraded_entry() {
    local entry linux initrd options
    entry="$(grep -lsF '(ostree:0)' "${BOOT}"/loader/entries/*.conf | head -n 1)"
    [[ -n "${entry}" ]] || entry="$(find "${BOOT}/loader/entries" -name '*.conf' 2>/dev/null | sort | head -n 1)"
    [[ -n "${entry}" ]] || return 1
    linux="$(awk '$1 == "linux" { print $2; exit }' "${entry}")"
    initrd="$(awk '$1 == "initrd" { $1 = ""; sub(/^ +/, ""); print; exit }' "${entry}")"
    options="$(awk '$1 == "options" { $1 = ""; sub(/^ +/, ""); print; exit }' "${entry}" | degraded_options)"
    [[ -n "${linux}" && -n "${initrd}" && -n "${options}" ]] || return 1
    printf '%s\n' "${BOOT_ENTRY_BEGIN}" \
        "# amethystora-raid boot writes this at every start of a system over several disks: it starts the system" \
        "# with one of its disks missing (ame system raid status, and the manual's hardware.md, say more)" \
        'if [ "${timeout}" = 1 ]; then set timeout=5; fi' \
        "menuentry 'Start with a disk missing' --unrestricted --id amethystora-degraded {" \
        "    load_video" "    set gfxpayload=keep" "    insmod gzio" \
        "    linux ${linux} ${options}" "    initrd ${initrd}" "}" "${BOOT_ENTRY_END}"
}

# Whether the system's btrfs is over several disks
system_spread() {
    local fstype source uuid devices
    read -r fstype source uuid <<<"$(root_fs)"
    [[ "${fstype}" == btrfs && -n "${uuid}" ]] || return 1
    devices=("${SYS}/fs/btrfs/${uuid}/devinfo"/*)
    [[ ${#devices[@]} -ge 2 && -e "${devices[1]}" ]]
}

# custom.cfg with the entry when the system is over several disks, and without it when it is not, the rest of
# what is there kept as it is
write_boot_entry() {
    local cfg="${BOOT}/grub2/custom.cfg" current="" block="" new
    [[ -d "${BOOT}/grub2" ]] || return 0
    [[ -f "${cfg}" ]] && current="$(cat "${cfg}")"
    if system_spread; then
        block="$(degraded_entry)" || { echo "The boot entry for starting with a disk missing could not be written: no boot entry names the running system." >&2; return 1; }
    fi
    new="$(awk -v b="${BOOT_ENTRY_BEGIN}" -v e="${BOOT_ENTRY_END}" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' <<<"${current}")"
    [[ -n "${block}" ]] && new="${new:+${new}$'\n'}${block}"
    [[ "${new}" == "${current}" ]] && return 0
    if [[ -z "${new}" ]]; then
        with_boot_rw as_root rm -f "${cfg}"
    else
        with_boot_rw as_root bash -c 'printf "%s\n" "$2" >"$1.new" && sync "$1.new" && mv -f "$1.new" "$1"' _ "${cfg}" "${new}"
    fi
}

# Every disk of a mounted btrfs that is missing now, written down with when it was first seen so (root's)
note_missing() {
    local fs devid now seen missing gone target path
    seen="$(missing_seen)"
    now="$(date +%s)"
    TARGETS="$(findmnt -rn -t btrfs -o UUID,TARGET,OPTIONS 2>/dev/null)"
    for fs in "${SYS}"/fs/btrfs/*-*-*-*-*; do
        missing=()
        for devid in "${fs}"/devinfo/*; do
            [[ "$(cat "${devid}/missing" 2>/dev/null)" == 1 ]] && missing+=("${devid##*/}")
        done
        # A disk gone from under its LUKS mapping, by its devid, which btrfs names beside its device
        gone=" $(gone_devices "${fs}" | paste -sd ' ') "
        target="$(pick_target "${fs##*/}")"
        if [[ "${gone}" != "  " && -n "${target}" ]]; then
            while read -r path devid; do
                [[ "${gone}" == *" $(basename "$(readlink -f "${path}")") "* ]] && missing+=("${devid}")
            done < <(btrfs device usage -b "${target}" 2>/dev/null | awk -F ', ID: ' 'NF == 2 { sub(/[^0-9].*/, "", $2); print $1, $2 }')
        fi
        for devid in "${missing[@]}"; do
            seen="$(jq -c --arg fs "${fs##*/}" --arg devid "${devid}" --argjson now "${now}" '.[$fs][$devid] //= $now' <<<"${seen}")"
        done
    done
    [[ "${seen}" == "$(missing_seen)" ]] || write_state "${MISSING_STATE}" <<<"${seen}"
}

# A disk of a btrfs no longer remembered as missing: it was replaced, or its copies are back
forget_missing() {  # FSID DEVID...
    local fs="$1" seen
    shift
    seen="$(missing_seen | jq -c --arg fs "${fs}" '.[$fs] |= (. // {} | del(.[$ARGS.positional[]])) | with_entries(select(.value != {}))' --args "$@")"
    as_root bash -c 'install -d -m 0755 "$1" && cat >"$2.new" && chmod 0644 "$2.new" && mv -f "$2.new" "$2"' _ "${STATE}" "${MISSING_STATE}" <<<"${seen}"
}

# The update timers held, and refused while an update runs: nothing may write /boot while it is copied
hold_updates() {
    local unit
    for unit in "${UPDATE_SERVICES[@]}"; do
        systemctl is-active --quiet "${unit}" 2>/dev/null && die "An update is running (${unit}): try again once it has finished."
    done
    for unit in "${UPDATE_TIMERS[@]}"; do
        as_root systemctl stop "${unit}" 2>/dev/null
    done
}
release_updates() {
    local unit
    for unit in "${UPDATE_TIMERS[@]}"; do
        systemctl is-enabled --quiet "${unit}" 2>/dev/null && as_root systemctl start "${unit}" 2>/dev/null
    done
    return 0
}

# A partition's size in bytes, and its GPT type
part_size() { lsblk -bndo SIZE "$1"; }
part_type() { lsblk -ndo PARTTYPE "$1" | tr '[:upper:]' '[:lower:]'; }
part_of() {  # DISK N: the Nth partition of a disk
    lsblk -nrpo PATH,TYPE "$1" | awk -v n="$2" '$2 == "part" { if (++i == n) { print $1; exit } }'
}
# The disk a partition is on
disk_of_part() { printf '/dev/%s\n' "$(lsblk -ndo PKNAME "$1")"; }
# A disk's half of /boot's mirror, by its md superblock: the first disk's keeps its old partition type when it joins
boot_half_on() {  # DISK
    lsblk -nrpo PATH,TYPE,FSTYPE "$1" | awk '$2 == "part" && $3 == "linux_raid_member" { print $1; exit }'
}
# The ESP on a disk
esp_on() {
    lsblk -nrpo PATH,PARTTYPE,FSTYPE "$1" | awk -v type="${ESP_TYPE}" 'tolower($2) == type && $3 == "vfat" { print $1; exit }'
}

# The partition UUID of the ESP this start came from, which the firmware's BootCurrent entry names (nothing for an
# entry that names no partition)
boot_current_esp() {
    local current
    current="$(efibootmgr 2>/dev/null | sed -n 's/^BootCurrent: //p')"
    [[ -n "${current}" ]] || return 0
    efibootmgr -v 2>/dev/null | awk -v n="Boot${current}" 'index($0, n) == 1 && match(tolower($0), /hd\([0-9]+,gpt,[0-9a-f-]+/) {
        split(substr(tolower($0), RSTART, RLENGTH), p, ","); print p[3]; exit }'
}

# The firmware's entries for an ESP's shim, by the ESP's partition UUID
efi_entries_of() {  # ESP
    local partuuid
    partuuid="$(lsblk -ndo PARTUUID "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    [[ -n "${partuuid}" ]] || return 0
    as_root efibootmgr -v 2>/dev/null | awk -v p="${partuuid}" 'tolower($0) ~ p && tolower($0) ~ /shimx64/ {
        sub(/^Boot/, "", $1); sub(/\*$/, "", $1); print $1 }'
}

# The firmware's boot entry for the shim on an ESP, made if there is none: "Amethystora (DISK)", right after the
# entry of the other disk's ESP in the boot order, so that the firmware tries it as soon as that disk is gone,
# before the entries it makes for each disk by itself (which start shim's fallback). Prints its number.
efi_entry() {  # ESP LABEL OTHER-ESP
    local disk number loader='\EFI\fedora\shimx64.efi' order after
    disk="$(disk_of_part "$1")"
    number="$(efi_entries_of "$1" | head -n 1)"
    if [[ -z "${number}" ]]; then
        as_root efibootmgr --quiet --create-only --disk "${disk}" --part "$(lsblk -ndo PARTN "$1")" --label "$2" --loader "${loader}" >/dev/null || return 1
        number="$(efi_entries_of "$1" | head -n 1)"
        [[ -n "${number}" ]] || return 1
    fi
    after="$(efi_entries_of "$3" | head -n 1)"
    order="$(as_root efibootmgr | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -vx "${number}" | paste -sd ,)"
    order="$(awk -v RS=, -v ORS=, -v after="${after}" -v n="${number}" 'NR == 1 && after == "" { print; print n; next }
        { sub(/\n$/, ""); print } $0 == after { print n }' <<<"${order}" | sed 's/,$//')"
    [[ ",${order}," == *",${number},"* ]] || order="${number}${order:+,${order}}"
    as_root efibootmgr --quiet --bootorder "${order}" >/dev/null || return 1
    printf '%s\n' "${number}"
}

# The boot files of an ESP copied onto a new one, made vfat, with the bootupd's bootuuid.cfg pointing at /boot's
# filesystem (an older installation's Fedora grub.cfg, which searches for it by UUID, changed the same way)
copy_esp() {  # FROM-ESP TO-ESP BOOT-UUID
    local from to mounted code=1
    as_root mkfs.vfat -F 32 -n EFI "$2" >/dev/null || return 1
    # Read where it is mounted, at /boot/efi: a second mount of it, read-only, is refused
    mounted="$(findmnt -rn -o TARGET --source "$1" | head -n 1)"
    from="${mounted:-$(mktemp -d)}" to="$(mktemp -d)"
    if ! { [[ -n "${mounted}" ]] || as_root mount -o ro "$1" "${from}"; }; then
        rmdir "${from}" "${to}"
        return 1
    fi
    if as_root mount "$2" "${to}"; then
        # vfat keeps no owners or modes to copy
        as_root cp -r "${from}/." "${to}/" && point_esp "${to}" "$3" && code=0
        as_root umount "${to}"
    fi
    rmdir "${to}"
    [[ -n "${mounted}" ]] || { as_root umount "${from}"; rmdir "${from}"; }
    return "${code}"
}

point_esp() {  # MOUNTED-ESP BOOT-UUID
    local cfg
    for cfg in "$1"/EFI/*/grub.cfg; do
        [[ -f "${cfg}" ]] || continue
        printf 'set BOOT_UUID="%s"\n' "$2" | as_root tee "${cfg%/grub.cfg}/bootuuid.cfg" >/dev/null
        as_root sed -i -E "s/(--fs-uuid --set=dev )[0-9a-fA-F-]+/\1$2/" "${cfg}"
    done
}

# The same, on an ESP that may be mounted at /boot/efi already
point_esp_at() {  # ESP BOOT-UUID
    local at
    at="$(findmnt -rn -o TARGET --source "$1" | head -n 1)"
    if [[ -n "${at}" ]]; then
        point_esp "${at}" "$2"
        return
    fi
    at="$(mktemp -d)"
    as_root mount "$1" "${at}" || { rmdir "${at}"; return 1; }
    point_esp "${at}" "$2"
    as_root umount "${at}"
    rmdir "${at}"
}

# An fstab line made nofail: the first disk's EFI partition is one of two once the system is mirrored, and the
# system starts without it
fstab_nofail() {  # MOUNTPOINT
    as_root awk -v mp="$1" '!/^[[:space:]]*#/ && $2 == mp && $4 !~ /(^|,)nofail(,|$)/ { $4 = $4 ",nofail" } { print }' "${FSTAB}" |
        as_root bash -c 'cat >"$1.new" && chmod --reference="$1" "$1.new" && mv -f "$1.new" "$1"' _ "${FSTAB}"
    as_root systemctl daemon-reload
}

# The crypttab lines of the system's own LUKS partitions made nofail, as the installer writes them without: with
# one disk dead the system starts from the others, which a line waiting for the dead one would hold up
system_crypttab_nofail() {
    local part uuid
    for part in $(root_luks); do
        uuid="$(as_root cryptsetup luksUUID "${part}" 2>/dev/null)" || continue
        as_root awk -v id="UUID=${uuid}" '!/^[[:space:]]*#/ && $2 == id && $4 !~ /(^|,)nofail(,|$)/ {
            $4 = (NF < 4 || $4 == "") ? "nofail" : $4 ",nofail" } { print }' "${CRYPTTAB}" |
            as_root bash -c 'cat >"$1.new" && chmod 0600 "$1.new" && mv -f "$1.new" "$1"' _ "${CRYPTTAB}"
    done
    as_root restorecon "${CRYPTTAB}" 2>/dev/null
    as_root systemctl daemon-reload
}

# The system's passphrase, typed, and checked against a LUKS partition of the system before anything is erased
ask_passphrase() {  # LUKS-PARTITION
    local passphrase
    for _ in 1 2 3; do
        passphrase="$(gum input --password --width 80 --placeholder "The passphrase of the system's disk")" || exit 0
        if printf '%s' "${passphrase}" | as_root cryptsetup open --test-passphrase --key-file - "$1" 2>/dev/null; then
            printf '%s\n' "${passphrase}"
            return 0
        fi
        echo "That is not the passphrase of the system's disk." >&2
    done
    die "Nothing was erased."
}

# A root partition encrypted with the system's passphrase, opened as luks-UUID, in /etc/crypttab as the
# installer writes its line (nofail: the system mounts the other disk's half degraded when this one is gone),
# and in the kernel command line, which is what opens it at boot. Prints the opened device.
system_luks() {  # PARTITION PASSPHRASE
    local uuid
    printf '%s' "$2" | as_root cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$1" >&2 || return 1
    uuid="$(as_root cryptsetup luksUUID "$1")"
    printf '%s' "$2" | as_root cryptsetup open --allow-discards --key-file - "$1" "luks-${uuid}" >&2 || return 1
    append_line "${CRYPTTAB}" "luks-${uuid} UUID=${uuid} none discard,nofail" 0600
    kargs_add "rd.luks.uuid=luks-${uuid}" >&2 || return 1
    printf '/dev/mapper/luks-%s\n' "${uuid}"
}

mirror_onto() {  # STATUS [DISK]
    local status="$1" onto disk size root_part esp boot_part luks=false passphrase="" lines=()
    local esp_size boot_size root_type new_esp new_boot new_root device md_uuid uuid target entry copy
    onto="$(jq -c .mirror_onto <<<"${status}")"
    case "$(jq -r '.reason // empty' <<<"${onto}")" in
        pending) die "A mirror of the system is waiting for the restart that finishes it: restart the machine." ;;
        sealed) die "A sealed system cannot be mirrored: the signed kernel command line names one disk, and its root partition is found by its type on the disk it started from." ;;
        no-uefi) die "The system's mirror starts each disk through its own EFI partition, and this machine did not start through UEFI." ;;
        layout) die "The system's disk is not laid out as the installer does it (an EFI partition, /boot and the system on one disk), so it is not mirrored this way." ;;
        no-disk) die "No spare disk is at least as large as the system's ($(human "$(jq -r .size <<<"${onto}")")). Connect one, then run ame system raid mirror again." ;;
    esac
    size="$(jq -r .size <<<"${onto}")"
    disk="$(pick_disk "$(jq -c --argjson size "${size}" '[.spare[] | select(.size >= $size)]' <<<"${status}")" \
        "Which disk does the system go onto? Everything on it is erased." "${2:-}")" || exit 0
    root_part="$(jq -r '.devices[0].part' <<<"$(system_json)")"
    [[ "$(jq -r '.devices[0].luks' <<<"$(system_json)")" == true ]] && luks=true
    read -r boot_part _ <<<"$(boot_mount)"
    esp="$(esp_on "$(disk_of_part "${root_part}")")"
    [[ -n "${esp}" && -n "${boot_part}" ]] || die "The system's EFI partition or /boot could not be found."
    /usr/libexec/amethystora-deployments 2>/dev/null | jq -e 'any(.deployments[]; .staged == true)' >/dev/null 2>&1 &&
        die "An update is waiting for the next restart: restart first, then mirror the system."

    mapfile -t lines < <(disk_plan "$(jq -c .spare <<<"${status}")" "${disk}")
    lines=("The system goes onto this disk, as a copy of the one it is on:" "" "${lines[@]}" ""
        "It gets an EFI partition and /boot of its own, and a copy of every file: the machine then starts from either disk, and goes on with one of them dead."
        "" "Everything on ${disk} is erased. The system's disk keeps everything on it. After the copy, the machine restarts once from the new disk; once that start has worked, the first disk's /boot joins the new one's, which erases nothing but its old copy.")
    [[ "${luks}" == true ]] && lines+=("" "The new disk is encrypted with the system's passphrase, which is typed once at each start, as now.")
    box "${lines[@]}"
    ask_erase "${disk}"
    still_spare "${disk}"
    as_root true || exit 1
    [[ "${luks}" == true ]] && passphrase="$(ask_passphrase "${root_part}")"
    hold_updates

    # The same partitions as the system's disk: its ESP's size, its /boot's size as a RAID member, the rest for
    # the system, of its own partition's type
    esp_size="$(part_size "${esp}")" boot_size="$(part_size "${boot_part}")" root_type="$(part_type "${root_part}")"
    echo "Erasing ${disk}…"
    mapfile -t lines < <(lsblk -nrpo PATH "${disk}" | tac)
    as_root wipefs -a -q "${lines[@]}" >&2 || die "${disk} could not be erased."
    printf 'label: gpt\nsize=%s, type=%s, name="EFI System Partition"\nsize=%s, type=%s, name="boot"\ntype=%s, name="system"\n' \
        "$((esp_size / 512))" "${ESP_TYPE}" "$((boot_size / 512))" "${RAID_TYPE}" "${root_type}" |
        as_root sfdisk --quiet --wipe always --wipe-partitions always "${disk}" >/dev/null || die "${disk} could not be partitioned."
    as_root udevadm settle
    new_esp="$(part_of "${disk}" 1)" new_boot="$(part_of "${disk}" 2)" new_root="$(part_of "${disk}" 3)"
    [[ -n "${new_root}" ]] || die "${disk} could not be partitioned."

    # The system first: its kernel argument is in the boot entries before they are copied
    if [[ "${luks}" == true ]]; then
        device="$(system_luks "${new_root}" "${passphrase}")" || die "${new_root} could not be encrypted."
    else
        device="${new_root}"
    fi
    TARGETS="$(findmnt -rn -t btrfs -o UUID,TARGET,OPTIONS 2>/dev/null)"
    read -r _ _ uuid <<<"$(root_fs)"
    target="$(pick_target "${uuid}")"
    as_root btrfs device add -f "${device}" "${target}" || die "btrfs could not add ${device} to the system."

    # /boot: a RAID1 of the old one's partition, which joins after the restart, and the new disk's, with a copy
    # of what is there. Metadata 1.0 at the end leaves each half readable as a plain ext4, as the firmware's GRUB
    # and bootupd's own grub.cfg (which looks for md/md-boot first) need.
    echo "Making /boot a mirror…"
    as_root mdadm --create "${BOOT_MD}" --run --name=md-boot --homehost=any --level=1 --metadata=1.0 \
        --raid-devices=2 missing "${new_boot}" >&2 || die "${new_boot} could not be made a RAID member."
    as_root mkfs.ext4 -q -F "${BOOT_MD}" || die "/boot's mirror could not be made."
    md_uuid="$(as_root blkid -p -s UUID -o value "${BOOT_MD}")"
    copy="$(mktemp -d)"
    as_root mount "${BOOT_MD}" "${copy}" || die "/boot's mirror could not be mounted."
    as_root rsync -aHA --one-file-system /boot/ "${copy}/" || { as_root umount "${copy}"; die "/boot could not be copied."; }
    as_root umount "${copy}"
    rmdir "${copy}"

    echo "Copying the EFI partition…"
    copy_esp "${esp}" "${new_esp}" "${md_uuid}" || die "The EFI partition could not be copied."
    fstab_nofail /boot/efi
    system_crypttab_nofail
    entry="$(efi_entry "${new_esp}" "Amethystora (${disk##*/})" "${esp}")" || die "The firmware's boot entry for ${disk} could not be made."

    # What the restart from the new disk finishes, which amethystora-raid-boot.service does
    jq -n --arg disk "${disk}" --arg entry "${entry}" --arg boot_id "$(cat /proc/sys/kernel/random/boot_id)" \
        --arg old_boot "$(lsblk -ndo PARTUUID "${boot_part}")" --arg old_esp "$(lsblk -ndo PARTUUID "${esp}")" \
        --arg new_esp "$(lsblk -ndo PARTUUID "${new_esp}")" --arg boot_uuid "${md_uuid}" \
        '{state: "pending", time: (now | floor), $disk, $entry, $boot_id, $old_boot, $old_esp, $new_esp, $boot_uuid}' |
        as_root bash -c 'install -d -m 0755 "$1" && cat >"$2.new" && chmod 0644 "$2.new" && mv -f "$2.new" "$2"' _ "${STATE}" "${MIRROR_STATE}"

    long_run mirror system "Copying the system onto ${disk}" "${target}" \
        btrfs balance start -dconvert=raid1 -mconvert=raid1,soft "${target}" ||
        die "The copy did not finish: journalctl -u amethystora-raid-mirror-system says why. Running ame system raid mirror again carries on."
    write_boot_entry
    release_updates

    # The TPM opened the first disk: it gets the new one's key too, with its PIN
    if [[ "${luks}" == true ]] && as_root cryptsetup luksDump "${root_part}" | grep -q systemd-tpm2; then
        echo
        echo "The TPM opens the system's disk at boot. It needs a key for the new disk too:"
        ame security disk-unlock on-pin
    fi
    as_root efibootmgr --quiet --bootnext "${entry}" >/dev/null
    echo
    box "Every file of the system is on both disks now. One restart from the new disk is left: once it works, the first disk's /boot joins the new one's, and the machine starts from either." \
        "" "The next restart is from the new disk, whenever it is: ame system raid status says when it is all done."
    gum confirm "Restart now?" && as_root systemctl reboot
    return 0
}

# At the restart from the new disk, before /boot is mounted (amethystora-raid-mirror.service), while nothing holds
# it: the mirror gets what changed in the first disk's /boot since the copy, fstab mounts the mirror (boot.mount,
# waiting for this, reads it again), the first disk's /boot becomes its other half and its EFI partition points at
# it. A start from anywhere else changes nothing, and is said.
mirror_join() {
    [[ ${EUID} -eq 0 ]] || die "This is amethystora-raid-mirror.service's."
    local state current entry boot_part esp from to started reason="" boot_uuid fsck_unit
    state="$(jq -c 'select(type == "object")' "${MIRROR_STATE}" 2>/dev/null)" || return 0
    [[ "$(jq -r .state <<<"${state}")" == pending ]] || return 0
    [[ "$(jq -r .boot_id <<<"${state}")" != "$(cat /proc/sys/kernel/random/boot_id)" ]] || return 0
    entry="$(jq -r .entry <<<"${state}")" boot_uuid="$(jq -r .boot_uuid <<<"${state}")"
    current="$(efibootmgr 2>/dev/null | sed -n 's/^BootCurrent: //p')"
    # The disks, which udev may still be naming this early in the start
    udevadm settle --timeout=60
    boot_part="$(blkid -t "PARTUUID=$(jq -r .old_boot <<<"${state}")" -o device 2>/dev/null | head -n 1)"
    esp="$(blkid -t "PARTUUID=$(jq -r .old_esp <<<"${state}")" -o device 2>/dev/null | head -n 1)"
    # Started from the new disk: the ESP the firmware's entry names, whichever entry it was, else that entry
    started="$(boot_current_esp)"
    if [[ -n "${started}" && "${started}" != "$(jq -r '.new_esp | ascii_downcase' <<<"${state}")" ]] ||
        [[ -z "${started}" && "${current}" != "${entry}" ]]; then
        reason="the machine started from Boot${current:-?}, not from the new disk's Boot${entry}; ame system raid mirror tries the restart again"
    elif [[ -z "${boot_part}" || -z "${esp}" ]]; then
        reason="the first disk's /boot or EFI partition is not there"
    fi
    if [[ -z "${reason}" ]]; then
        echo "Started from the new disk: the first disk's /boot joins the mirror."
        # Its one half would wait for mdadm's last resort, half a minute into the start
        mdadm -IRs >/dev/null 2>&1
        udevadm settle --timeout=60
        # systemd checks the first disk's /boot, fstab's, before mounting it: not while it is copied or joins
        fsck_unit="systemd-fsck@$(systemd-escape -p "/dev/disk/by-uuid/$(awk '!/^[[:space:]]*#/ && $2 == "/boot" {
            sub(/^UUID=/, "", $1); print $1 }' "${FSTAB}")").service"
        for _ in $(seq 120); do
            systemctl list-jobs --no-legend 2>/dev/null | grep -qF "${fsck_unit}" ||
                [[ "$(systemctl show -p ActiveState --value "${fsck_unit}" 2>/dev/null)" == activating ]] || break
            sleep 0.5
        done
        from="$(mktemp -d)" to="$(mktemp -d)"
        if mount -o ro "${boot_part}" "${from}" && mount "${BOOT_MD}" "${to}" &&
            rsync -aHA --delete --exclude=/lost+found "${from}/" "${to}/"; then
            umount "${from}" "${to}"
            sed -i -E "s#^UUID=[^[:space:]]+([[:space:]]+/boot[[:space:]])#UUID=${boot_uuid}\1#" "${FSTAB}"
            systemctl daemon-reload
            wipefs -a -q "${boot_part}" && mdadm "${BOOT_MD}" --add "${boot_part}" >/dev/null ||
                reason="the first disk's /boot could not join the mirror"
            point_esp_at "${esp}" "${boot_uuid}" || reason="the first disk's EFI partition could not be pointed at the mirror"
        else
            umount "${from}" "${to}" 2>/dev/null
            reason="/boot's mirror could not be brought up to date from the first disk's"
        fi
        rmdir "${from}" "${to}" 2>/dev/null
    fi
    if [[ -n "${reason}" ]]; then
        echo "The mirror of the system did not finish: ${reason}." >&2
        jq -c --arg reason "${reason}" '.state = "failed" | .reason = $reason' <<<"${state}" | write_state "${MIRROR_STATE}"
        return 1
    fi
    jq -c '.state = "joined"' <<<"${state}" | write_state "${MIRROR_STATE}"
}

# Once /boot is mounted from its mirror (amethystora-raid-boot.service): its files labelled as SELinux has them,
# which the copy, made without their labels, left out. bootupd's own update at each start finds both ESPs.
mirror_finish() {
    local state
    state="$(jq -c 'select(type == "object")' "${MIRROR_STATE}" 2>/dev/null)" || return 0
    [[ "$(jq -r .state <<<"${state}")" == joined ]] || return 0
    restorecon -RF /boot
    rm -f "${MIRROR_STATE}"
    echo "The system is on both disks, and starts from either."
}

# Again from the new disk, after a start that did not come from it
mirror_retry() {
    local state
    state="$(jq -c 'select(type == "object")' "${MIRROR_STATE}" 2>/dev/null)"
    echo "Mirroring the system stopped: $(jq -r '.reason // "it did not finish"' <<<"${state}")."
    echo "Every file is on both disks; what is left is one start from the new disk, before the first disk's /boot joins it."
    gum confirm "Restart from the new disk now?" || exit 0
    as_root true || exit 1
    jq -c --arg boot_id "$(cat /proc/sys/kernel/random/boot_id)" '.state = "pending" | .boot_id = $boot_id | del(.reason)' <<<"${state}" |
        as_root bash -c 'cat >"$1.new" && chmod 0644 "$1.new" && mv -f "$1.new" "$1"' _ "${MIRROR_STATE}"
    as_root efibootmgr --quiet --bootnext "$(jq -r .entry <<<"${state}")" >/dev/null
    as_root systemctl reboot
}

# The installer spread the system over several disks with one copy of each file (2a): a copy on each instead
mirror_spread() {  # STATUS
    local pool target count lines sizes=() room need
    pool="$(jq -c 'first(.pools[] | select(.system))' <<<"$1")"
    jq -e '.busy == [] and .operation == null and .missing == 0' <<<"${pool}" >/dev/null ||
        die "The system's disks are busy, or one is missing: ame system raid status says which."
    target="$(jq -r .target <<<"${pool}")"
    count="$(jq '.devices | length' <<<"${pool}")"
    as_root true || exit 1
    lines="$(as_root btrfs filesystem show --raw "${target}" | show_lines)"
    mapfile -t sizes < <(awk '{ print $2 }' <<<"${lines}")
    room="$(usable "${sizes[@]}" | awk '$1 == "raid1" { print $2 }')"
    # Every file twice over, with a gigabyte to spare on each disk for btrfs's own use
    need="$(jq --argjson count "${count}" --argjson gib "${GIB}" '(.data_used // 0) + (.metadata_used // 0) + $count * $gib' <<<"${pool}")"
    ((room >= need)) ||
        die "Two copies of everything need $(human "${need}") on these disks, which give $(human "${room}") that way. Free some space first (ame system clean)."
    box "The system is spread over ${count} disks with one copy of each file: either one failing loses everything." "" \
        "This keeps a copy of each file on each disk instead, erasing nothing. It takes a while, and runs on its own." "" \
        "What it cannot do: the boot files, /boot and the EFI partition, stay on the first disk only. The machine starts only from that disk; with another disk dead, choose Start with a disk missing in the boot menu. With the first disk dead, every file is still on the others, readable from the live USB stick."
    gum confirm "Keep a copy on each disk?" || exit 0
    long_run mirror system "Keeping a copy of the system on each of its disks" "${target}" \
        btrfs balance start -dconvert=raid1 -mconvert=raid1,soft "${target}" ||
        die "That did not finish: journalctl -u amethystora-raid-mirror-system says why. Running it again carries on."
    system_crypttab_nofail
    write_boot_entry
    echo "Done: every file of the system is on each of its disks."
}

cmd_mirror() {
    need_terminal mirror
    local status
    status="$(status_json)" || die "The disks could not be read."
    if jq -e 'any(.pools[]; .system and .mirror.state == "failed")' <<<"${status}" >/dev/null 2>&1; then
        mirror_retry
    elif [[ -n "${1:-}" ]] || jq -e '.mirror_onto != null' <<<"${status}" >/dev/null; then
        jq -e '.mirror_onto != null' <<<"${status}" >/dev/null ||
            die "The system is on several disks already: ame system raid status says how they keep its files."
        mirror_onto "${status}" "${1:-}"
    elif jq -e '.system_single' <<<"${status}" >/dev/null; then
        mirror_spread "${status}"
    else
        die "The system keeps a copy of each file on each of its disks already."
    fi
}

# Where the system's disks were at boot: a mirror finished, the disks seen missing written down, and the boot
# menu's entry that starts the system with a disk missing kept up to date (amethystora-raid-boot.service)
cmd_boot() {
    [[ ${EUID} -eq 0 ]] || die "This is amethystora-raid-boot.service's."
    note_missing
    [[ -f "${MIRROR_STATE}" ]] && mirror_finish
    write_boot_entry
}

# What amethystora-raid-boot.service has to do: the system over several disks, a mirror to finish, or the
# boot entry of one that is not any more to take away
system_present() {
    system_spread || [[ -f "${MIRROR_STATE}" ]] || grep -qsxF "${BOOT_ENTRY_BEGIN}" "${BOOT}/grub2/custom.cfg"
}

cmd_scrub() {
    local status
    case "${1:-}" in
        now)
            status="$(status_json)" || die "The disks could not be read."
            jq -e 'any(.pools[]; .mounted and .layout != null and .layout != "single")' <<<"${status}" >/dev/null ||
                die "There is no pool with copies to check."
            jq -e '.scrubbing | not' <<<"${status}" >/dev/null || die "Every copy is being checked already."
            as_root systemd-run --unit=amethystora-raid-scrub-now --description="Check every copy on the pools of disks" \
                --collect --quiet -p Nice=19 -p IOSchedulingClass=idle /usr/libexec/amethystora-raid scrub-all ||
                die "The check could not be started."
            echo "Checking every copy now, in the background. ame system raid status says when it has finished, and"
            echo "what it found."
            ;;
        on)
            as_root systemctl enable --now amethystora-raid-scrub.timer &&
                echo "Every copy is checked once a month, on mains power, and a damaged one repaired from a good one."
            ;;
        off)
            as_root systemctl disable --now amethystora-raid-scrub.timer &&
                echo "The monthly check is off. A damaged copy is then found only when the file is read."
            ;;
        "")
            if systemctl is-enabled --quiet amethystora-raid-scrub.timer 2>/dev/null; then
                echo "The monthly check of every copy is on."
                interactive && gum confirm --default=no "Turn it off?" && cmd_scrub off
            else
                echo "The monthly check of every copy is off."
                interactive && gum confirm "Turn it on?" && cmd_scrub on
            fi
            ;;
        *) die "usage: ame system raid scrub [now|on|off]" ;;
    esac
}

cmd_menu() {
    local status options=() actions=() choice i
    cmd_status
    interactive || return 0
    status="$(status_json)"
    while IFS=$'\t' read -r title action; do
        options+=("${title}")
        actions+=("${action}")
    done < <(jq -r '(.spare | length) as $spare
        | (.pools[] | select(.system and .layout != "single" and .mirror == null)
            | (if (.missing // 0) > 0 or any(.devices[]; .smart == "failed" or ((.returned | not) and .error_count > 0))
               then ["Replace a disk of the system", "replace system"]
               elif .degraded or any(.devices[]; .returned) or .boot.degraded == true then ["Put back the copies of the system", "replace system"]
               else empty end)),
          (.pools[] | select(.system and .mirror.state == "failed") | ["Restart from the new disk again", "mirror"]),
          (if .mirror_onto.possible == true then ["Mirror the system onto a new disk", "mirror"] else empty end),
          (.pools[] | select(.managed)
            | (if (.missing // 0) > 0 or any(.devices[]; .smart == "failed" or ((.returned | not) and .error_count > 0))
               then ["Replace a disk of \(.name)", "replace \(.name)"]
               elif .degraded or any(.devices[]; .returned) then ["Put back the copies of \(.name)", "replace \(.name)"] else empty end),
              (if .mounted | not then ["Open \(.name) with a disk missing", "mount \(.name)"] else empty end),
              (if .mounted and $spare > 0 then ["Add a disk to \(.name)", "add \(.name)"] else empty end)),
          (if $spare >= 2 then ["Make a pool from spare disks", "create"] else empty end),
          (if .system_single then ["Keep a copy on each of the system disks", "mirror"] else empty end),
          (if .raid then ["Check every copy now", "scrub now"],
              (if .scrub_timer == "enabled" then ["Turn the monthly check off", "scrub off"]
               else ["Turn the monthly check on", "scrub on"] end) else empty end),
          (.pools[] | select(.managed) | ["Forget \(.name)", "forget \(.name)"])
        | @tsv' <<<"${status}")
    [[ ${#options[@]} -gt 0 ]] || return 0
    echo
    choice="$(gum choose --header "What now?" "${options[@]}" "Nothing")" || return 0
    for i in "${!options[@]}"; do
        if [[ "${options[i]}" == "${choice}" ]]; then
            # shellcheck disable=SC2086 # an action is a subcommand and a pool's name, which has no spaces
            exec "$0" ${actions[i]}
        fi
    done
}

# --- The services ----------------------------------------------------------------------------------

smart_of() {  # DISK: passed, failed, or nothing when it cannot say or the disk is asleep
    smartctl -H -j -n standby "$1" 2>/dev/null |
        jq -r 'if .smart_status.passed == true then "passed" elif .smart_status.passed == false then "failed" else empty end' 2>/dev/null
}

write_state() {  # FILE (the JSON on stdin), readable by everyone
    install -d -m 0755 "${STATE}"
    cat >"$1.new" && chmod 0644 "$1.new" && mv -f "$1.new" "$1"
}

# What the check tells, each a fact with a key, and a count that telling again needs to see rise
FACTS_JQ='
def who: if .system then "the system" else "the pool \(.name)" end;
def disk: if (.disk.model // "") != "" then .disk.model + (if (.disk.serial // "") != "" then " (\(.disk.serial))" else "" end)
    elif .devid != null then "Disk \(.devid)" else "A disk" end;
[ .pools[] | . as $p
  | ((.devices[] | select(.missing) | {key: "\($p.uuid)/missing/\(.devid)", count: 1, rank: 1,
        summary: "A disk of \($p | who) is missing",
        body: ("\(disk) stopped answering. " + (if $p.missing <= $p.survives
            then "Every file is still there, with one copy fewer until the disk is replaced."
            else "The files that were on it cannot be read until it is back." end))}),
     (if .mounted | not then {key: "\(.uuid)/unmounted", count: 1, rank: 2,
        summary: "The pool \(.name) did not open",
        body: "It is not mounted, perhaps because one of its disks is missing. Its files are still on its disks."} else empty end),
     (.devices[] | select(.smart == "failed") | {key: "\($p.uuid)/failing/\(.disk.serial // .disk.path)", count: 1, rank: 3,
        summary: "A disk of \($p | who) is failing",
        body: ("\(disk) says it is failing. " + (if $p.survives > 0
            then "Every file is still there: replace the disk before it stops."
            else "The pool keeps no second copy: copy its files off before it stops." end))}),
     (if (.scrub.uncorrectable // 0) > 0 then {key: "\(.uuid)/scrub/\(.scrub.time)", count: 1, rank: 4,
        summary: "The check of \(who) found damage",
        body: "\(.scrub.uncorrectable) errors could not be repaired from another copy. journalctl -k -g btrfs names the files."} else empty end),
     (.devices[] | select(.error_count > 0) | {key: "\($p.uuid)/errors/\(.devid)", count: .error_count, rank: 5,
        summary: "A disk of \($p | who) is counting errors",
        body: ("\(disk) has counted \(.error_count) read or write error\(if .error_count == 1 then "" else "s" end). " + (if $p.survives > 0
            then "btrfs reads a good copy from another disk, so every file is still there. Replace the disk if the count keeps rising."
            else "The pool keeps no second copy, so files on that disk may be damaged." end))}),
     (.devices[] | select(.returned) | {key: "\($p.uuid)/returned/\(.devid)", count: 1, rank: 5,
        summary: "A disk of \($p | who) is back",
        body: "\(disk) was missing and is back, with old copies of what was written while it was away. Put the copies back: ame system raid replace \(if $p.system then "system" else $p.name end)."}),
     (if .degraded then {key: "\(.uuid)/degraded", count: 1, rank: 6,
        summary: "Part of \(who) has one copy",
        body: "What was written while a disk was missing has a single copy until the copies are put back."} else empty end),
     (if .boot != null and .boot.degraded and .missing == 0 and .mirror == null then {key: "\(.uuid)/boot", count: 1, rank: 6,
        summary: "The boot files of the system have one copy",
        body: "The system starts from one of its disks only until they are put back: ame system raid replace system."} else empty end),
     (if .mirror != null and .mirror.state == "failed" then {key: "\(.uuid)/mirror/\(.mirror.time)", count: 1, rank: 2,
        summary: "Mirroring the system did not finish",
        body: "\(.mirror.reason // "journalctl -u amethystora-raid-mirror says why"). Every file is still on the first disk."} else empty end))
]'

cmd_check() {
    [[ ${EUID} -eq 0 ]] || die "This is amethystora-raid-check.service's: ame system raid status says the same without root."
    local status known smart disk facts current last news
    present || exit 0
    note_missing
    status="$(status_json)" || exit 1
    # SMART, which only root can read, for the status to show everyone. A disk asleep keeps what it said
    # last, and one that went missing who it was, for as long as its pool is there.
    known="$(jq -c '.devices // []' "${STATE}/disks.json" 2>/dev/null)"
    smart="$(jq -r '[.pools[] | select(.mounted) | .devices[] | select((.missing | not) and .disk != null) | .disk.path]
            | unique[]' <<<"${status}" |
        while read -r disk; do printf '%s %s\n' "${disk}" "$(smart_of "${disk}")"; done |
        jq -cRn '[inputs | split(" ") | {key: .[0], value: (.[1] // "")}] | from_entries')"
    jq -c --argjson smart "${smart}" --argjson known "${known:-[]}" '
        [.pools[].uuid] as $fsids
        | [.pools[] | select(.mounted) | .uuid as $fsid | .devices[] | select((.missing | not) and .disk != null)
           | {fsid: $fsid, devid, kname, disk: .disk.path, model: .disk.model, serial: .disk.serial} as $d
           | $d + {smart: (if ($smart[$d.disk] // "") != "" then $smart[$d.disk]
                          else ([$known[] | select((.serial != "" and .serial == $d.serial) or .disk == $d.disk) | .smart] | first)
                          end)}] as $now
        | {time: (now | floor), devices: ($now + [$known[] | select(. as $k | ($fsids | index($k.fsid)) != null
              and (any($now[]; .fsid == $k.fsid and .devid == $k.devid) | not))])}' <<<"${status}" |
        write_state "${STATE}/disks.json"
    status="$(status_json)" || exit 1

    facts="$(jq -c "${FACTS_JQ}" <<<"${status}")"
    current="$(jq -c 'map({(.key): .count}) | add // {}' <<<"${facts}")"
    last="$(jq -c 'select(type == "object")' "${STATE}/last.json" 2>/dev/null)"
    news="$(jq -c --argjson last "${last:-"{}"}" 'map(select(.count > ($last[.key] // 0))) | sort_by(.rank)' <<<"${facts}")"
    if [[ "$(jq length <<<"${news}")" -eq 0 ]]; then
        write_state "${STATE}/last.json" <<<"${current}"
        exit 0
    fi
    # Nobody to tell: not written down as told, so the first run after somebody logs in tells them. Only a
    # person's bus counts, as amethystora-notify-users tells only them: the login screen's (gdm) has one too.
    compgen -G '/run/user/[1-9][0-9][0-9][0-9]*/bus' >/dev/null || exit 0
    write_state "${STATE}/last.json" <<<"${current}"
    # The notification waits for its answer in a unit of its own, while the hourly check carries on. It
    # says the worst news in full, and names the rest.
    systemd-run --collect --quiet -p TimeoutStartSec=infinity --description="Tell about the pools of disks" \
        /usr/libexec/amethystora-raid notify "$(jq -r '.[0].summary' <<<"${news}")" \
        "$(jq -r '.[0].body + (if length > 1 then "\nAlso: " + ([.[1:][].summary | (.[0:1] | ascii_downcase) + .[1:]]
            | reduce .[] as $s ([]; if index([$s]) then . else . + [$s] end) | join("; ")) + "." else "" end)' <<<"${news}")"
}

cmd_notify() {
    [[ ${EUID} -eq 0 && $# -eq 2 ]] || die "usage: amethystora-raid notify SUMMARY BODY (as root)"
    local answers user answer uid
    answers="$(/usr/libexec/amethystora-notify-users --action "open=$(N_ 'Open Control')" "$1" "$2" critical)" || exit 0
    while read -r user answer; do
        [[ "${answer}" == open ]] || continue
        # Control on its System page, in that person's session, through the systemd user manager that has
        # the session's display
        uid="$(id -u "${user}")" || continue
        runuser -u "${user}" -- env "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${uid}/bus" \
            "XDG_RUNTIME_DIR=/run/user/${uid}" systemd-run --user --collect --quiet /usr/bin/amethystora-control system || true
    done <<<"${answers}"
}

# Reads every copy on each mounted pool that has copies, and repairs a bad one from a good one. Since
# kernel 6.19 a suspend cancels a scrub: one that did not finish is resumed the next time.
cmd_scrub_all() {
    [[ ${EUID} -eq 0 ]] || die "This is amethystora-raid-scrub.service's: ame system raid scrub now starts it."
    local status uuid target file out code finished damage=0
    status="$(status_json)" || exit 1
    while read -r uuid target; do
        [[ -n "${target}" ]] || continue
        file="${STATE}/scrub-${uuid}.json"
        echo "Checking every copy of ${target}"
        if jq -e '.finished == false' "${file}" >/dev/null 2>&1; then
            out="$(btrfs scrub resume -B -R "${target}" 2>&1)"
            code=$?
            # 2: nothing to resume
            if [[ ${code} -eq 2 ]]; then
                out="$(btrfs scrub start -B -R "${target}" 2>&1)"
                code=$?
            fi
        else
            out="$(btrfs scrub start -B -R "${target}" 2>&1)"
            code=$?
        fi
        printf '%s\n' "${out}"
        # 0: done, 3: done with errors it could not repair
        if [[ ${code} -eq 0 || ${code} -eq 3 ]]; then finished=true; else finished=false; fi
        jq -n --argjson finished "${finished}" \
            --argjson corrected "$(awk '$1 == "corrected_errors:" { n += $2 } END { print n + 0 }' <<<"${out}")" \
            --argjson uncorrectable "$(awk '$1 == "uncorrectable_errors:" { n += $2 } END { print n + 0 }' <<<"${out}")" \
            '{time: (now | floor), $finished, $corrected, $uncorrectable}' | write_state "${file}"
        [[ ${code} -eq 3 ]] && damage=1
    done < <(jq -r '.pools[] | select(.mounted and .target != null and .layout != null and .layout != "single") | "\(.uuid) \(.target)"' <<<"${status}")
    # Damage is told now, not at the next hourly check
    [[ ${damage} -eq 0 ]] || systemctl start --no-block amethystora-raid-check.service
    exit 0
}

case "${1:-}" in
    "") cmd_menu ;;
    create | replace | add | mount | forget | mirror | scrub | status)
        command="$1"
        shift
        "cmd_${command}" "$@"
        ;;
    root-luks) root_luks ;;
    layouts) shift && layouts "$@" ;;
    present) present ;;
    check) cmd_check ;;
    notify) shift && cmd_notify "$@" ;;
    scrub-all) cmd_scrub_all ;;
    boot) cmd_boot ;;
    boot-entry) [[ ${EUID} -eq 0 ]] && write_boot_entry ;;
    boot-mirror) mirror_join ;;
    present-system) system_present ;;
    -h | --help | help) usage ;;
    *)
        usage >&2
        exit 64
        ;;
esac
