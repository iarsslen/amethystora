#!/usr/bin/bash
# What happens to a file a virus scan found, as ON_DETECTION in /etc/amethystora/security.conf says, and
# the quarantine it can go to. The weekly scan, real-time scanning and the Security app's own scans all
# come through here, so there is one answer to "what does this machine do with malware".
#
#   amethystora-quarantine act PATH...           scan each file again, then report, quarantine or delete
#   amethystora-quarantine list                  what is in quarantine: id, date, signature, path
#   amethystora-quarantine restore ID [trust]    put a file back; with trust, ClamAV lets that exact file be
#   amethystora-quarantine delete ID             delete a quarantined file for good
#
# `act` prints one line per file, tab-separated: what happened (reported, quarantined, deleted, clean or
# failed), the signature and the path. Clean means the second scan found nothing, and nothing was done.
#
# Every file is scanned again before anything is done to it, so whoever calls this can only ever have a
# file acted on that ClamAV itself calls malware, whatever path they pass. Root only.
#
# The files are in folders their owners control, and an owner can swap a folder on the way, or the file
# itself, for a link between the scan and the act. So root never acts on a path: it enters the file's own
# folder without following a link, checks that it is the folder that was scanned, and acts on the name in
# it, which no later swap of the path can redirect. What it moved into the store is checked to be a plain
# file before anything else is done to it.

set -uo pipefail

# AMETHYSTORA_QUARANTINE_ROOT is for build_files/shared/test-quarantine.sh: a build must not write /var/lib
ROOT="${AMETHYSTORA_QUARANTINE_ROOT:-}"
STORE="${ROOT}/var/lib/amethystora/quarantine"
# ClamAV's allow list for single files (SHA-256, size, name), read from its database directory
ALLOWED="${ROOT}/var/lib/clamav/amethystora-restored.sfp"

[[ "${EUID}" -eq 0 ]] || { echo "${0##*/} needs root." >&2; exit 77; }

usage() {
    echo "usage: ${0##*/} act PATH... | list | restore ID [trust] | delete ID" >&2
    exit 64
}

# Into the folder PATH names, without following a link anywhere on the way: true only when that is where
# the shell now is. Run in a subshell, so that the caller's own folder is kept.
enter() {
    cd -P -- "$1" 2>/dev/null && [[ "$(pwd -P)" == "$1" ]]
}

# Moves ./NAME of the current folder into the store, and records what it was. NAME was checked to be a
# plain file; it may have been swapped for something else since, which is then thrown out of the store
# rather than having its owner and mode changed through it.
quarantine() {
    local name="$1" path="$2" signature="$3" item
    mkdir -p -m 0700 "${STORE}"
    item="$(mktemp -d "${STORE}/$(date +%Y%m%d-%H%M%S)-XXXX")" || return 1
    mv -T -- "./${name}" "${item}/file" || { rm -rf -- "${item}"; return 1; }
    if [[ -L "${item}/file" || ! -f "${item}/file" ]]; then
        rm -rf -- "${item}"
        return 1
    fi
    jq -n --arg path "${path}" --arg signature "${signature}" \
        --arg owner "$(stat -c '%u:%g' -- "${item}/file")" --arg mode "$(stat -c '%a' -- "${item}/file")" \
        --arg sha256 "$(sha256sum -- "${item}/file" | cut -d' ' -f1)" --arg date "$(date -Is)" \
        '{$path, $signature, $owner, $mode, $sha256, $date}' >"${item}/info.json" || return 1
    # Nothing opens or runs it from here by accident, root included, without first changing that
    chown root:root "${item}/file"
    chmod 0000 "${item}/file"
}

# The act on one file found, from inside its own folder
act_on() {
    local mode="$1" path="$2" signature="$3"
    local parent="${path%/*}" name="${path##*/}"
    (
        enter "${parent:-/}" || exit 1
        [[ -f "./${name}" && ! -L "./${name}" ]] || exit 1
        case "${mode}" in
            quarantine) quarantine "${name}" "${path}" "${signature}" ;;
            delete) rm -f -- "./${name}" ;;
        esac
    )
}

act() {
    local mode path output line file outcome
    local -a files=() errors=()
    local -A found=()
    mode="$(/usr/libexec/amethystora-security-config ON_DETECTION)"
    for path in "$@"; do
        # Regular files only, named by their real path: never through a link, which would otherwise
        # move or delete whatever it points to
        if [[ "${path}" != /* || -L "${path}" || ! -f "${path}" || "$(realpath -e -- "${path}" 2>/dev/null)" != "${path}" ]]; then
            printf 'failed\t-\t%s\n' "${path}"
        else
            files+=("${path}")
        fi
    done
    [[ ${#files[@]} -gt 0 ]] || return 0

    # clamd reads each file through the descriptor passed to it, so it needs no access of its own.
    # The paths are absolute, so none of them can be taken for an option.
    output="$(clamdscan --fdpass --no-summary --infected "${files[@]}" 2>&1)"
    # A signature has no spaces, so a FOUND line splits cleanly. An ERROR line's message can hold ": "
    # itself (lstat() failed: ...), so those are matched against the paths asked about instead.
    while IFS= read -r line; do
        if [[ "${line}" =~ ^(/.*):\ ([^ ]+)\ FOUND$ ]]; then
            found["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        elif [[ "${line}" == *" ERROR" ]]; then
            errors+=("${line}")
        fi
    done <<<"${output}"

    for file in "${files[@]}"; do
        if [[ -z "${found[${file}]+set}" ]]; then
            outcome=clean
            for line in "${errors[@]}"; do
                [[ "${line}" == "${file}: "* ]] && outcome=failed
            done
            printf '%s\t-\t%s\n' "${outcome}" "${file}"
            continue
        fi
        case "${mode}" in
            quarantine) act_on quarantine "${file}" "${found[${file}]}" && line=quarantined || line=failed ;;
            delete) act_on delete "${file}" "${found[${file}]}" && line=deleted || line=failed ;;
            *) line=reported ;;
        esac
        printf '%s\t%s\t%s\n' "${line}" "${found[${file}]}" "${file}"
    done
}

list() {
    local info
    for info in "${STORE}"/*/info.json; do
        [[ -f "${info}" ]] || continue
        jq -r --arg id "$(basename "$(dirname "${info}")")" '[$id, .date, .signature, .path] | @tsv' "${info}"
    done
}

# The directory of a quarantined file, from an id `list` printed
item() {
    [[ "$1" =~ ^[0-9]{8}-[0-9]{6}-[A-Za-z0-9]{4}$ && -f "${STORE}/$1/info.json" ]] || {
        echo "Nothing in quarantine is called ${1}. See what is with: ame security scan quarantine" >&2
        return 1
    }
    echo "${STORE}/$1"
}

# Adds the file to ClamAV's allow list. The list's folder is clamupdate's, so the new list is written to a
# file made there afresh and moved over the old one, and the old one is read only when it is a plain file:
# a link put there would otherwise be written through, or copied into a list anyone can read.
trust() {
    local next
    next="$(mktemp "${ALLOWED%/*}/.amethystora-restored.XXXXXX")" || return 1
    {
        [[ -f "${ALLOWED}" && ! -L "${ALLOWED}" ]] && cat -- "${ALLOWED}"
        sigtool --sha256 "$1"
    } >"${next}" && chmod 0644 "${next}" && mv -T -- "${next}" "${ALLOWED}" || { rm -f -- "${next}"; return 1; }
    restorecon "${ALLOWED}" 2>/dev/null || true
    clamdscan --reload >/dev/null 2>&1 || true
}

restore() {
    local item path owner mode parent name
    item="$(item "$1")" || return 1
    path="$(jq -r .path "${item}/info.json")"
    owner="$(jq -r .owner "${item}/info.json")"
    mode="$(jq -r .mode "${item}/info.json")"
    parent="${path%/*}"
    parent="${parent:-/}"
    name="${path##*/}"
    [[ "${owner}" =~ ^[0-9]+:[0-9]+$ && "${mode}" =~ ^[0-7]{1,4}$ && -n "${name}" ]] || {
        echo "What was recorded about ${path} is not readable." >&2
        return 1
    }
    # Allowed before it is back, or real-time scanning would find it again on its way in
    if [[ "${2:-}" == trust ]]; then
        trust "${item}/file" || return 1
    fi
    # Its owner and mode while it is still in the store, which only root can reach, and then one rename
    # into its folder: nothing is done through the path after that
    chown -- "${owner}" "${item}/file" && chmod -- "${mode}" "${item}/file" || return 1
    if ! (
        # The folder it was in, reached without a link, and its owner's (or a shared one such as /tmp, which
        # root owns and only lets each file's owner remove from)
        if ! enter "${parent}"; then
            echo "The folder it was in, ${parent}, is not there any more, or is not that folder now." >&2
            exit 1
        fi
        if [[ "$(stat -c %u .)" != "${owner%%:*}" && ! ( "$(stat -c %u .)" == 0 && -k . ) ]]; then
            echo "${parent} no longer belongs to the file's owner, so the file is not put back there." >&2
            exit 1
        fi
        if [[ -e "./${name}" || -L "./${name}" ]]; then
            echo "Something is at ${path} again. Move it away first, so that it is not overwritten." >&2
            exit 1
        fi
        mv -T -n -- "${item}/file" "./${name}" && [[ ! -e "${item}/file" ]] || exit 1
        restorecon "./${name}" 2>/dev/null || true
    ); then
        chown root:root "${item}/file" 2>/dev/null
        chmod 0000 "${item}/file" 2>/dev/null
        return 1
    fi
    rm -rf -- "${item}"
    echo "Put back: ${path}"
}

purge() {
    local item path
    item="$(item "$1")" || return 1
    path="$(jq -r .path "${item}/info.json")"
    rm -rf -- "${item}"
    echo "Deleted for good: ${path}"
}

case "${1:-}" in
    act) shift; act "$@" ;;
    list) list ;;
    restore) [[ $# -ge 2 ]] || usage; restore "$2" "${3:-}" ;;
    delete) [[ $# -eq 2 ]] || usage; purge "$2" ;;
    *) usage ;;
esac
