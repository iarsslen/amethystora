#!/usr/bin/bash
# Real-time virus scanning (amethystora-clamav-onaccess.service), which runs only while REALTIME=on in
# /etc/amethystora/security.conf. clamonacc has the kernel (fanotify) report each file closed in a home
# directory and hands it to clamd. This reads what clamonacc logs and does with each find what the weekly
# scan does: ON_DETECTION through amethystora-quarantine, a line in the findings log `ame security scan`
# shows, and a notification to whoever is logged in.
#
# What clamonacc watches is set with the OnAccess settings in /etc/clamd.d/scan.conf (04-packages.sh).
# The caches the weekly scan leaves out are left out here too, as a list of directories written at every
# start: clamonacc takes exact directories, where clamd's ExcludePath takes patterns.

set -uo pipefail
# root's alone from the start: the list names what each account keeps in its home, and the logs what was found
umask 077

LOG=/run/amethystora-clamav-onaccess.log
EXCLUDES=/run/amethystora-clamav-onaccess.exclude
FINDINGS=/var/log/amethystora-clamav-findings.log

{
    for home in /var/home/*/; do
        for dir in "${home}.cache" "${home}.local/share/containers" "${home}".var/app/*/cache; do
            [[ -d "${dir}" ]] && echo "${dir}"
        done
    done
    # Ransomware protection's snapshots: read-only, and a copy of every home folder each
    [[ -d /var/home/.snapshots ]] && echo /var/home/.snapshots
} >"${EXCLUDES}"

: >"${LOG}"
chmod 0600 "${LOG}"

# Marks a message for po/amethystora.pot; amethystora-notify-users --msgid translates it for each account
N_() { printf '%s' "$1"; }

found() {
    local file="$1" signature="$2" mode outcome summary body shown credit name
    mode="$(/usr/libexec/amethystora-security-config ON_DETECTION)"
    outcome=reported
    [[ "${mode}" == report ]] || outcome="$(/usr/libexec/amethystora-quarantine act "${file}" | cut -f1)"
    # The file changed before it could be scanned again, and is clean now
    [[ "${outcome}" == clean ]] && return

    # A file name is whatever somebody called a file: what the journal and the findings log keep, which a
    # terminal shows, is made safe to show; the file acted on is the real one
    shown="$(/usr/libexec/amethystora-security-text --max 1000 "${file}")"
    # A YARA rule's match names the rule's author, as its licence asks (amethystora-yara)
    credit="$(/usr/libexec/amethystora-yara credit "${signature}")"
    signature="$(/usr/libexec/amethystora-security-text --max 400 "${signature}${credit:+ (${credit})}")"
    echo "${signature} in ${shown}: ${outcome}"
    {
        echo "# Real-time scan, $(date -Is). On detection: ${mode}."
        echo "${shown}: ${signature} FOUND"
        [[ "${mode}" == report ]] || printf '# What was done:\n  %s: %s\n' "${outcome}" "${shown}"
    } >>"${FINDINGS}"
    chmod 0600 "${FINDINGS}"

    # amethystora-notify-users puts these values into the messages, in each account's language
    name="${file##*/}"
    export name signature
    case "${outcome}" in
        quarantined)
            summary="$(N_ '${name} was quarantined')"
            body="$(N_ 'It matches ${signature}. Put it back with: ame security scan restore')" ;;
        deleted)
            summary="$(N_ '${name} was deleted')"
            body="$(N_ 'It matched ${signature}. See it with: ame security scan')" ;;
        failed)
            if [[ "${mode}" == delete ]]; then
                summary="$(N_ 'A virus scan found ${name}, and could not delete it')"
            else
                summary="$(N_ 'A virus scan found ${name}, and could not quarantine it')"
            fi
            body="$(N_ 'It matches ${signature}. See it with: ame security scan')" ;;
        *)
            summary="$(N_ 'A virus scan found ${name}')"
            body="$(N_ 'It matches ${signature}, and was left where it is. See it with: ame security scan')" ;;
    esac
    /usr/libexec/amethystora-notify-users --security --msgid "${summary}" "${body}" critical >/dev/null
}

# Reading before clamonacc starts, so that nothing it logs is missed
tail -F -n +1 "${LOG}" 2>/dev/null | while IFS= read -r line; do
    # "<path>: <signature> FOUND", after a timestamp and " -> " when clamd.conf sets LogTime
    [[ "${line}" =~ ^(.*\ -\>\ )?(/.*):\ ([^\ ]+)\ FOUND$ ]] &&
        found "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
done &

# --wait gives clamd time to come up; without signatures it never does, and the service tries again
clamonacc --foreground --fdpass --wait --config-file=/etc/clamd.d/scan.conf \
    --log="${LOG}" --exclude-list="${EXCLUDES}" &

# Either one stopping stops the service, and systemd starts both again
wait -n
exit 1
