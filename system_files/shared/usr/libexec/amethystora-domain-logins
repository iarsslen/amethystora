#!/usr/bin/bash
# Domain logins with the image's own authselect features. realmd runs this for its four login commands
# (/etc/realmd.conf), when Settings' Enterprise Login or `realm join` joins a domain and when `realm leave`
# leaves the last one. Its stock commands run `authselect select sssd with-mkhomedir --force`, which turns
# off account lockout, fingerprint login and security keys without a word.
#
#   amethystora-domain-logins sssd|winbind   the profile realmd joined with, the image's features and
#                                            with-mkhomedir; then oddjobd, which makes a domain account's
#                                            home folder at its first login (root)
#   amethystora-domain-logins image          the image's own profile and features, and pam_winbind's settings
#                                            as it ships them, for `realm leave` (root)
#   amethystora-domain-logins check          whether /etc/authselect is a domain setup made here: sssd or
#                                            winbind with exactly the features a join sets, and every
#                                            file as authselect writes it. The security watcher asks this.
#   amethystora-domain-logins --print MODE   only print the authselect command

set -euo pipefail

# The image's own copy of /etc. In the build, before ostree has moved it there, /etc is the image's.
IMAGE_CONF=/usr/etc/authselect/authselect.conf
[[ -e "${IMAGE_CONF}" ]] || IMAGE_CONF=/etc/authselect/authselect.conf
CONF=/etc/authselect/authselect.conf

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}

# authselect.conf is the profile on its first line and the features after it, in the order they were
# turned on
features() {
    grep -vE '^[[:space:]]*(#|$)' "$1" | tail -n +2
}

# The files authselect writes, each with the option `authselect test` prints it with
GENERATED=(nsswitch.conf:--nsswitch system-auth:--system-auth password-auth:--password-auth
    smartcard-auth:--smartcard-auth fingerprint-auth:--fingerprint-auth switchable-auth:--switchable-auth
    postlogin:--postlogin dconf-db:--dconf-db dconf-locks:--dconf-lock)

# Whether /etc/authselect holds what authselect writes for the profile and features given, and nothing else:
# each file the header they all start with, then its body as `authselect test` prints it after a line naming
# the file. `authselect check` will not do: it calls a file with a line added by hand valid.
as_written() {
    local header entry file
    header="$(head -n 5 "${IMAGE_CONF%/*}/system-auth")"
    [[ "$(find /etc/authselect -mindepth 1 -maxdepth 1 ! -name custom -printf '%f\n' | sort)" == \
        "$(printf '%s\n' authselect.conf "${GENERATED[@]%%:*}" | sort)" ]] || return 1
    for entry in "${GENERATED[@]}"; do
        file="/etc/authselect/${entry%%:*}"
        [[ -f "${file}" && ! -L "${file}" && "$(head -n 5 "${file}")" == "${header}" ]] || return 1
        [[ "$(tail -n +6 "${file}")" == "$(authselect test "$@" "${entry#*:}" 2>/dev/null | tail -n +2)" ]] ||
            return 1
    done
}

PRINT=false
if [[ "${1:-}" == --print ]]; then
    PRINT=true
    shift
fi

mapfile -t FEATURES < <(features "${IMAGE_CONF}")
# The duress finger and password are the owner's switches (amethystora-duress), not the image's: joining or
# leaving keeps them as they were, and the sssd and winbind profiles take them as local does (08-hardening.sh)
grep -qx with-duress-fingerprint "${CONF}" 2>/dev/null && FEATURES+=(with-duress-fingerprint)
grep -qx with-duress-password "${CONF}" 2>/dev/null && FEATURES+=(with-duress-password)
case "${1:-}" in
    sssd | winbind)
        COMMAND=(authselect select "$1" "${FEATURES[@]}")
        [[ " ${FEATURES[*]} " == *" with-mkhomedir "* ]] || COMMAND+=(with-mkhomedir)
        ;;
    image)
        COMMAND=(authselect select "$(grep -vE '^[[:space:]]*(#|$)' "${IMAGE_CONF}" | head -n1)" "${FEATURES[@]}")
        ;;
    check)
        PROFILE="$(grep -vE '^[[:space:]]*(#|$)' "${CONF}" | head -n1)"
        [[ "${PROFILE}" =~ ^(sssd|winbind)$ ]] || exit 1
        # Exactly the features a join turns on: one of the image's turned off, or one more turned on by hand,
        # is not the image's setup for a domain
        mapfile -t CURRENT < <(features "${CONF}")
        [[ " ${FEATURES[*]} " == *" with-mkhomedir "* ]] || FEATURES+=(with-mkhomedir)
        [[ "$(printf '%s\n' "${CURRENT[@]}" | sort)" == "$(printf '%s\n' "${FEATURES[@]}" | sort)" ]] || exit 1
        as_written "${PROFILE}" "${CURRENT[@]}"
        exit
        ;;
    *)
        sed -n '2,15p' "$0" | sed 's/^# \?//' >&2
        exit 64
        ;;
esac
COMMAND+=(--force)

if [[ "${PRINT}" == true ]]; then
    echo "${COMMAND[*]}"
    exit 0
fi
[[ ${EUID} -eq 0 ]] || die "this needs root"
"${COMMAND[@]}"
if [[ "$1" != image ]]; then
    systemctl enable --now oddjobd.service
# A winbind join adds krb5_auth, cached_login and krb5_ccache_type to pam_winbind's settings, and realmd
# leaves them there when it leaves. Nothing reads them without a domain, and the watcher would report them
# from then on. Written over rather than copied, so that the file keeps its mode and label.
elif [[ -f /usr/etc/security/pam_winbind.conf ]] &&
    ! cmp -s /usr/etc/security/pam_winbind.conf /etc/security/pam_winbind.conf; then
    cat /usr/etc/security/pam_winbind.conf >/etc/security/pam_winbind.conf
fi
