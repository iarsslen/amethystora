#!/usr/bin/bash
# OnFailure handler for the scheduled security scans (amethystora-scan-alert@.service).
#
# A scan whose result sits in a log file nobody opens is not a scan. Every way one of these units can
# fail says something the person at the machine needs to act on, so each gets its own wording and the
# action to take, rather than a unit name and a status code.

set -uo pipefail

UNIT="${1:?usage: $0 UNIT}"

# Marks a message for po/amethystora.pot. amethystora-notify-users --msgid translates it, in the language of
# each account it tells, and puts the values (${NAME}, exported) in.
N_() { printf '%s' "$1"; }
export UNIT AGE

case "${UNIT}" in
    amethystora-clamav-scan.service)
        if [[ -s /var/log/amethystora-clamav-findings.log ]]; then
            # The one case worth interrupting someone for. Critical notifications stay on screen in
            # GNOME until they are dismissed, which is right for this and wrong for the others.
            SUMMARY="$(N_ 'Virus scan found something')"
            case "$(/usr/libexec/amethystora-security-config ON_DETECTION)" in
                quarantine) BODY="$(N_ 'It was moved to quarantine. See it, or put it back, with: ame security scan')" ;;
                delete) BODY="$(N_ 'It was deleted. See what it was with: ame security scan')" ;;
                *) BODY="$(N_ 'Nothing was deleted, quarantined or moved. See it with: ame security scan')" ;;
            esac
            URGENCY=critical
        elif AGE="$(/usr/libexec/amethystora-clamav-signature-age)"; then
            SUMMARY="$(N_ 'Virus scan could not run')"
            BODY="$(N_ 'This machine has not been scanned. Try it with: ame security scan')"
            URGENCY=normal
        elif [[ -n "${AGE}" ]]; then
            SUMMARY="$(N_ 'Virus signatures are ${AGE} days old')"
            BODY="$(N_ "A clean scan proves nothing with signatures this old. Check this machine's network connection.")"
            URGENCY=normal
        else
            SUMMARY="$(N_ 'No virus signatures on this machine')"
            BODY="$(N_ 'clamav-freshclam.service has never finished a download, so nothing has been scanned yet.')"
            URGENCY=normal
        fi
        ;;
    amethystora-lynis-audit.service)
        SUMMARY="$(N_ 'Security audit could not run')"
        BODY="$(N_ 'Run it by hand with: ame security audit')"
        URGENCY=normal
        ;;
    amethystora-security-watch.service)
        SUMMARY="$(N_ 'The security watcher could not run')"
        BODY="$(N_ 'Nothing is reading the audit log until it does. See why with: journalctl -u amethystora-security-watch.service')"
        URGENCY=normal
        ;;
    amethystora-ips.service)
        SUMMARY="$(N_ 'Network protection stopped')"
        BODY="$(N_ 'Connections work, but nothing inspects them. See why with: journalctl -u amethystora-ips.service')"
        URGENCY=normal
        ;;
    *)
        SUMMARY="$(N_ '${UNIT} failed')"
        BODY="$(N_ 'See: systemctl status ${UNIT}')"
        URGENCY=normal
        ;;
esac

# An account whose agentic features are on is offered Ask the agent, which opens its agent on the failed unit: the
# unit's name, which systemd gave, never the notice's words. The answer is waited for in that account's own session,
# so this ends at once and the next failure is told again
agent=()
[[ ! "${UNIT}" =~ ^[A-Za-z0-9@_.:-]+\.service$ ]] || agent=(--agent-unit "${UNIT}")
exec /usr/libexec/amethystora-notify-users --security "${agent[@]}" --msgid "${SUMMARY}" "${BODY}" "${URGENCY}"
