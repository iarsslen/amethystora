#!/usr/bin/bash
# Network protection: Suricata inline on this machine's own traffic (amethystora-ips.service), while
# NETWORK in /etc/amethystora/security.conf is watch or block. Its rules are built here and nowhere else,
# so that the daily update, `ame security settings network`, `ame security connections` and the
# Security app's Allow button cannot build them differently.
#
#   amethystora-ips enabled            exit 0 while NETWORK is watch or block (ExecCondition= in the units)
#   amethystora-ips due                exit 0 when the hourly timer should download: hourly feeds, rules a day
#                                      old, or settings changed since the last build; never on a metered
#                                      connection when there are rules already
#   amethystora-ips rules [--offline]  build the rules for the current setting, then reload Suricata (root)
#   amethystora-ips blocked            what it blocked and noticed lately, newest first (root or wheel)
#   amethystora-ips allow RULE         leave that one rule out on this machine (root)
#   amethystora-ips block RULE         put it back (root)
#
# The rules are Emerging Threats Open, which suricata-update downloads for this Suricata's version, less
# the families in /usr/share/amethystora/ips/disable.conf and the rules allowed on this machine
# (/etc/amethystora/ips-allowed, one rule number a line). Only with NETWORK=block do the families in
# drop.conf drop; otherwise every rule alerts, and nothing is blocked. --offline builds from the last
# download, which is what allow and block do, so that neither needs the network.
#
# NETWORK_FEEDS adds abuse.ch's command-server lists, daily or hourly, which reach new campaigns in hours
# where ET Open takes days; NETWORK_HUNTING=record keeps ET's hunting rules, whose alerts the security
# watcher only records. Both are fetched on the machine, as ET Open is.

set -uo pipefail

SHARE=/usr/share/amethystora/ips
ALLOWED=/etc/amethystora/ips-allowed
WORK=/var/lib/amethystora/ips
# What the security watcher keeps of Suricata's alerts (amethystora-security-watch)
EVENTS=/var/lib/amethystora/security/network.json
UNIT=amethystora-ips.service

usage() {
    echo "usage: ${0##*/} enabled | due | rules [--offline] | blocked | allow RULE | block RULE" >&2
    exit 64
}

need_root() {
    [[ "${EUID}" -eq 0 ]] || { echo "${0##*/} $1 needs root." >&2; exit 77; }
}

mode() {
    /usr/libexec/amethystora-security-config NETWORK
}

# abuse.ch's lists, CC0-1.0 in suricata-update's index: Feodo Tracker's botnet servers, SSLBL's certificates
# of command servers, and URLhaus's malware addresses (plain HTTP only). The first two drop under block.
FEEDS=(abuse.ch/feodotracker abuse.ch/sslbl-blacklist abuse.ch/urlhaus)
RULES=/var/lib/suricata/rules/suricata.rules
# What the rules were last built with, so that a changed setting builds them again
BUILT="${WORK}/built-with"

settings() {
    echo "NETWORK=$(mode) NETWORK_FEEDS=$(/usr/libexec/amethystora-security-config NETWORK_FEEDS)" \
        "NETWORK_HUNTING=$(/usr/libexec/amethystora-security-config NETWORK_HUNTING)"
}

# The sources suricata-update downloads: ET Open, and abuse.ch's while NETWORK_FEEDS is on. ET Open is named
# too, since once any source is named only the named ones are used.
sources() {
    local source
    if /usr/libexec/amethystora-security-config --is NETWORK_FEEDS off; then
        for source in "${FEEDS[@]}"; do
            suricata-update --quiet remove-source "${source}" >/dev/null 2>&1
        done
    else
        for source in et/open "${FEEDS[@]}"; do
            suricata-update --quiet enable-source "${source}" >/dev/null 2>&1
        done
    fi
}

# Whether the hourly timer downloads now
due() {
    local age
    [[ -s "${RULES}" ]] || return 0
    [[ "$(cat "${BUILT}" 2>/dev/null)" == "$(settings)" ]] || return 0
    # Not on a connection that costs by the byte, unless asked (`ame security settings` starts it by hand)
    if [[ -n "${TRIGGER_UNIT:-}" ]] &&
        [[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
            org.freedesktop.NetworkManager Metered 2>/dev/null)" =~ ^u\ (1|3)$ ]]; then
        return 1
    fi
    /usr/libexec/amethystora-security-config --is NETWORK_FEEDS hourly && return 0
    age=$(($(date +%s) - $(stat -c %Y "${RULES}")))
    [[ "${age}" -ge $((23 * 3600)) ]]
}

rules() {
    local -a args=(--quiet --no-reload --suricata-conf "${SHARE}/suricata.yaml"
        --disable-conf "${WORK}/disable.conf" --modify-conf "${SHARE}/modify.conf")
    local used
    need_root rules
    install -d -m 0700 "${WORK}"
    used="$(settings)"
    # The image's families, less the hunting rules while they are kept to record, then the rules allowed on
    # this machine
    {
        if /usr/libexec/amethystora-security-config --is NETWORK_HUNTING record; then
            grep -vx 'group:emerging-hunting.rules' "${SHARE}/disable.conf"
        else
            cat "${SHARE}/disable.conf"
        fi
        grep -xE '[0-9]+' "${ALLOWED}" 2>/dev/null
    } >"${WORK}/disable.conf"
    [[ "$(mode)" == block ]] && args+=(--drop-conf "${SHARE}/drop.conf")
    [[ "${1:-}" == --offline ]] && args+=(--offline)
    sources
    # It tests the result with Suricata itself, and keeps the rules it had if that fails
    suricata-update "${args[@]}" || return
    echo "${used}" >"${BUILT}"
    # A running Suricata swaps the new rules in while it goes on inspecting with the old ones
    systemctl try-reload-or-restart "${UNIT}"
}

rule_number() {
    [[ "${1:-}" =~ ^[0-9]{1,10}$ ]] || usage
}

# Rebuilt at once while network protection is on, from the last download; while it is off, the next
# build picks it up
apply() {
    [[ "$(mode)" == off ]] && return 0
    rules --offline && return 0
    echo "The rules could not be rebuilt now. The change applies at the next download of the rules." >&2
    return 1
}

allow() {
    rule_number "$1"
    need_root allow
    if ! grep -qx -- "$1" "${ALLOWED}" 2>/dev/null; then
        echo "$1" >>"${ALLOWED}"
        chmod 0644 "${ALLOWED}"
    fi
    apply || return
    echo "Rule $1 is left out on this machine. Put it back with: ame security connections block $1"
}

block() {
    rule_number "$1"
    need_root block
    [[ -f "${ALLOWED}" ]] && sed -i "/^$1\$/d" "${ALLOWED}"
    apply || return
    echo "Rule $1 is back."
}

blocked() {
    local allowed
    if [[ ! -s "${EVENTS}" ]]; then
        echo "Nothing blocked or noticed yet."
        return 0
    fi
    [[ -r "${EVENTS}" ]] || { echo "Only root and members of wheel can read ${EVENTS}." >&2; exit 77; }
    allowed="$(grep -xE '[0-9]+' "${ALLOWED}" 2>/dev/null | jq -s -c . )"
    jq -r --argjson allowed "${allowed:-[]}" '
        if length == 0 then "Nothing blocked or noticed yet." else .[] |
            "\(.time | strflocaltime("%a %-d %b %H:%M"))  \(if .action == "blocked" then "Blocked" else "Noticed" end)  \(.signature)",
            "    \(.host // "\(.src) and \(.dest)")\(if .port then ", port \(.port)" else "" end)"
                + "\(if .count > 1 then ", \(.count) times" else "" end), rule \(.sid)"
                + "\(if .sid | IN($allowed[]) then " (allowed on this machine)" else "" end)"
        end' "${EVENTS}"
}

case "${1:-}" in
    enabled) [[ "$(mode)" != off ]] ;;
    due) due ;;
    rules) rules "${2:-}" ;;
    blocked) blocked ;;
    allow) allow "${2:-}" ;;
    block) block "${2:-}" ;;
    *) usage ;;
esac
