#!/usr/bin/bash
# The weekly ClamAV scan (amethystora-clamav-scan.timer). Scans the writable, user-controlled parts of
# the system: home directories and the temporary directories. The image itself is not scanned, because
# /usr is read only, is replaced whole by every update, and is only accepted with a valid signature.
#
# A finding is written to the journal and to the log file below, where `ame security scan` shows it.
# What happens to the file itself is ON_DETECTION's to say (/etc/amethystora/security.conf), through
# /usr/libexec/amethystora-quarantine. The default, report, leaves it where it is: a false positive that
# removes a user's file is worse than the malware most of the time.
#
# Every way this can end badly fails the unit, which runs amethystora-scan-alert through OnFailure and
# tells whoever is logged in. Exit 1: infected files. 2: no signatures to scan with. 3: clean, but
# against signatures too old for that to mean anything.

set -uo pipefail

FINDINGS=/var/log/amethystora-clamav-findings.log

# Whether to scan at all (ExecCondition=, --check): never while VIRUS_SCAN=off in
# /etc/amethystora/security.conf, and while it is manual, only when somebody asked rather than the weekly
# timer. systemd names what started the unit in TRIGGER_UNIT.
wanted() {
    case "$(/usr/libexec/amethystora-security-config VIRUS_SCAN)" in
        off) return 1 ;;
        manual) [[ "${TRIGGER_UNIT:-}" != amethystora-clamav-scan.timer ]] ;;
        *) return 0 ;;
    esac
}
if [[ "${1:-}" == --check ]]; then
    wanted
    exit
fi
if ! wanted; then
    echo "Not scanning: VIRUS_SCAN in /etc/amethystora/security.conf says $(/usr/libexec/amethystora-security-config VIRUS_SCAN)."
    exit 0
fi

# A scan is only worth as much as the signatures behind it, and nothing else checks them: freshclam is a
# daemon that stays active whether or not its downloads ever reach the network, so a machine can scan
# with year-old signatures every Sunday and look exactly like a machine that is clean.
SIGNATURE_AGE="$(/usr/libexec/amethystora-clamav-signature-age)"
case $? in
    0)
        STALE_SIGNATURES=0
        ;;
    2)
        STALE_SIGNATURES=1
        echo "Virus signatures are ${SIGNATURE_AGE} days old. Scanning with them anyway, but a clean result"
        echo "proves nothing: check whether this machine can reach the network."
        ;;
    *)
        echo "No virus signatures in /var/lib/clamav: clamav-freshclam.service has never finished a"
        echo "download, so there is nothing to scan with."
        exit 2
        ;;
esac

# clamdscan hands the work to the running clamd, which already has the signatures in memory; scanning
# with clamscan instead would load them again on every run. --fdpass opens each file here, as root, and
# passes the descriptor, because clamd runs as its own user and cannot read into home directories.
# Directories left out of the scan are set as ExcludePath in /etc/clamd.d/scan.conf.
TARGETS=()
for target in /var/home /var/roothome /tmp /var/tmp; do
    [[ -d "${target}" ]] && TARGETS+=("${target}")
done
[[ ${#TARGETS[@]} -gt 0 ]] || exit 0

OUTPUT="$(clamdscan --fdpass --multiscan --infected "${TARGETS[@]}" 2>&1)"
STATUS=$?
# What is written to the journal and the findings log, which `ame security scan` shows in a terminal: a file
# name is whatever somebody called a file, so it is made safe to show first. The paths acted on are the
# real ones, read from OUTPUT itself.
SHOWN="$(/usr/libexec/amethystora-security-text --lines --max 1000 "${OUTPUT}")"

case "${STATUS}" in
    0)
        echo "Scan clean: ${TARGETS[*]}"
        # Keep the last findings file from claiming the machine is still infected after a cleanup
        rm -f "${FINDINGS}"
        # Clean, but measured against signatures too old to mean it: say so rather than reassure
        [[ "${STALE_SIGNATURES}" -eq 0 ]] || exit 3
        ;;
    1)
        # Findings. The journal entry is what shows up in `systemctl status`, the file is what
        # `ame security scan` reads, and both say what was done to each file, if anything was.
        MODE="$(/usr/libexec/amethystora-security-config ON_DETECTION)"
        FOUND=()
        while IFS= read -r line; do
            [[ "${line}" =~ ^(/.*):\ [^\ ]+\ FOUND$ ]] && FOUND+=("${BASH_REMATCH[1]}")
        done <<<"${OUTPUT}"
        DONE=""
        if [[ "${MODE}" != report && ${#FOUND[@]} -gt 0 ]]; then
            DONE="$(/usr/libexec/amethystora-quarantine act "${FOUND[@]}" |
                awk -F'\t' '{ print "  " $1 ": " $3 }' | /usr/libexec/amethystora-security-text --lines --max 1000)"
        fi
        echo "Infected files found. On detection: ${MODE}."
        printf '%s\n' "${SHOWN}"
        [[ -z "${DONE}" ]] || printf 'What was done:\n%s\n' "${DONE}"
        {
            echo "# ClamAV findings, $(date -Is). On detection: ${MODE}."
            printf '%s\n' "${SHOWN}"
            [[ -z "${DONE}" ]] || printf '# What was done:\n%s\n' "${DONE}"
        } >"${FINDINGS}"
        chmod 0600 "${FINDINGS}"
        exit 1
        ;;
    *)
        echo "Scan could not run (clamdscan exit ${STATUS}):"
        printf '%s\n' "${SHOWN}"
        exit "${STATUS}"
        ;;
esac
