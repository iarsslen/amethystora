#!/usr/bin/python3
# Amethystora's duress password: the pam_exec helper that the feature with-duress-password adds to the auth
# stack, after pam_unix, in system-auth and password-auth (build_files/base/08-hardening.sh). When the
# password typed is an account's duress password, it asks the org.amethystora.Duress service to start the
# owner's action; then at the graphical login and the lock screen (gdm-password) it lets the login through,
# and everywhere else (sudo, polkit, the text consoles, SSH) it is refused exactly as a wrong password. It
# reads only /etc/amethystora/duress.d/passwords, root's and readable by nobody else, as pam_fprintd reads
# the duress finger. Nothing about it is ever written where a person could read it: no stdout, no journal.
#
# pam_exec runs it as root in the auth phase, with PAM_USER and PAM_SERVICE in the environment and the typed
# password on stdin (expose_authtok). Exit 0 lets the login through (the pam line is
# [success=done default=ignore]); any other exit is ignored, so the stack carries on to the real password
# check. The action fires on a match whether the login is let through or refused. The line runs only after
# pam_unix has already failed, so an ordinary wrong password passes through it and a correct one never
# reaches it.
#
# Verification is written to give an attacker nothing:
#   - it refuses to run unless it is root, so a process that is not root never even looks at the file, and
#     the folder and the file must be root's and unreadable by anyone else (O_NOFOLLOW, fstat on the fd, no
#     path races) or the file is ignored;
#   - the hash is yescrypt (memory-hard, salted); any other scheme in the file is refused, so a tampered or
#     downgraded hash cannot be verified against;
#   - every call does exactly one crypt and one constant-time compare, whether or not the account has a
#     duress password, so neither the time taken nor the result reveals which accounts have one (and the
#     line runs behind pam_unix's failure and pam_faildelay anyway);
#   - the password is compared in constant time (hmac.compare_digest), never logged, and leaves on no path.
#
#   amethystora-duress-pam         as pam_exec runs it: read the password and act
#   amethystora-duress-pam hash    read a password on stdin and print a yescrypt hash of it, for
#                                  amethystora-duress set-password; never reached from PAM
import ctypes
import hmac
import os
import pwd
import stat
import subprocess
import sys

DIR = os.environ.get("AMETHYSTORA_DURESS_DIR", "/etc/amethystora/duress.d")
# The graphical login and the GNOME lock screen, the only places a duress password unlocks. Everywhere else
# it is refused like a wrong password, so it never hands over a root prompt or a shell.
ALLOW_SERVICES = {"gdm-password"}
SERVICE = "org.amethystora.Duress"
OBJECT = "/org/amethystora/Duress"

_libcrypt = ctypes.CDLL("libcrypt.so.2", use_errno=True)
_libcrypt.crypt.restype = ctypes.c_char_p
_libcrypt.crypt.argtypes = (ctypes.c_char_p, ctypes.c_char_p)
_libcrypt.crypt_gensalt.restype = ctypes.c_char_p
_libcrypt.crypt_gensalt.argtypes = (ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int)


def crypt(word, setting):
    # crypt(3) reads the method and salt from the start of setting; a whole stored hash serves as setting
    return _libcrypt.crypt(word, setting)


def gensalt():
    return _libcrypt.crypt_gensalt(b"$y$", 0, None, 0)


# Every verification hashes against a real yescrypt setting, even when the account has no duress password,
# so the work (and so the time) is the same either way. Computed once, at load, for every invocation alike.
DUMMY_SETTING = gensalt()
# The one scheme a stored hash may use; anything else in the file is treated as no password at all
HASH_PREFIX = b"$y$"


def read_password():
    # pam_exec writes the typed password to stdin with no trailing newline; take it whole
    return sys.stdin.buffer.read().rstrip(b"\x00")


def stored_hash(uid):
    # UID's duress password hash from DIR/passwords, or None. The folder and the file must be root's and
    # unreadable by anyone else, or the file is ignored, exactly as pam_fprintd treats the finger file.
    try:
        dfd = os.open(DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        st = os.fstat(dfd)
        if st.st_uid != 0 or st.st_mode & 0o077:
            return None
        try:
            fd = os.open("passwords", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
        except OSError:
            return None
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        # A small cap: the file holds one short line per account with a duress password, never more
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o077 or st.st_size > (1 << 18):
            return None
        data = os.read(fd, 1 << 18)
    finally:
        os.close(fd)
    prefix = b"%d " % uid
    for line in data.split(b"\n"):
        if line.startswith(prefix):
            value = line[len(prefix):]
            # Only a yescrypt hash is honoured; a downgraded or corrupt one is as good as no password
            return value if value.startswith(HASH_PREFIX) else None
    return None


def fire(uid):
    # Ask the service to start the duress password's own action (RunPassword, not the finger's Run), without
    # waiting and without starting it. Whether anything listens must change neither the timing nor the
    # screen, so every outcome is swallowed.
    try:
        subprocess.run(
            ["/usr/bin/busctl", "call", "--system", "--timeout=2",
             SERVICE, OBJECT, SERVICE, "RunPassword", "u", str(uid)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, check=False)
    except Exception:
        pass


def act():
    password = read_password()
    # Only root may verify a duress password: the file is root's, and a process that is not root must never
    # be trusted to read it or to reach the root-only action service
    if not password or os.geteuid() != 0:
        return 1
    try:
        uid = pwd.getpwnam(os.environ.get("PAM_USER", "")).pw_uid
    except KeyError:
        return 1
    stored = stored_hash(uid)
    # Exactly one crypt and one constant-time compare, against the account's hash or, when it has none, a
    # throwaway setting of the same cost: a wrong password and an account without a duress password take the
    # same time, so neither the time nor the result says which accounts have one.
    setting = stored if stored is not None else DUMMY_SETTING
    try:
        computed = crypt(password, setting) if setting is not None else None
    except Exception:
        computed = None
    ok = computed is not None and hmac.compare_digest(computed, setting)
    if stored is None or not ok:
        return 1
    fire(uid)
    return 0 if os.environ.get("PAM_SERVICE", "") in ALLOW_SERVICES else 1


def hash_password():
    password = read_password()
    if not password:
        print("a duress password cannot be empty", file=sys.stderr)
        return 64
    out = crypt(password, gensalt())
    if out is None or not out.startswith(HASH_PREFIX):
        # Never store anything but a yescrypt hash: that is the only scheme verification will honour
        print("could not hash the password", file=sys.stderr)
        return 1
    sys.stdout.buffer.write(out + b"\n")
    return 0


def main(argv):
    if len(argv) == 1:
        return act()
    if len(argv) == 2 and argv[1] == "hash":
        return hash_password()
    print("usage: %s [hash]" % os.path.basename(argv[0]), file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
