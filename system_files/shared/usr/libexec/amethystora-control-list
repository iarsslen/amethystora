    "${ gettext "As you type in apps, Amethystora watches the last few characters for your shortcuts. It keeps nothing it reads, never looks at password fields, and works in apps that use GNOME's input method."; }" \
    "$([[ "${ said typing; }" == true ]] && echo on || echo off)" desktop#text-shortcuts
if [[ "${ ended shortcuts; }" == 0 ]] && jq -e 'type == "array"' <<<"${ said shortcuts; }" >/dev/null 2>&1; then
    SHORTCUTS="${ said shortcuts; }"
else
    SHORTCUTS='[]'
    REASON="${ gettext "Your text shortcuts could not be read."; }"
fi
EXTRA="$(jq -nc --argjson list "${SHORTCUTS}" '{shortcuts: [$list[] | {abbr, lines}], commands: {
    add: {terminal: false, command: ["ame", "desktop", "text-shortcut", "add", "{abbr}"]},
    remove: {terminal: false, command: ["ame", "desktop", "text-shortcut", "remove", "{abbr}"]},
    show: {terminal: false, command: ["ame", "desktop", "text-shortcut", "show", "{abbr}"]}}}')"
USAGE="ame desktop text-shortcut add ABBR"
