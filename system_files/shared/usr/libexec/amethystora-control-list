# The clipboard goes between this computer and a phone only when chosen, one way at a time: a phone that can paste
# into a password field is a risk the person takes on knowingly
for way in send receive; do
    if [[ "${ ended clipboard-${way}; }" == 0 && "${ said clipboard-${way}; }" == true ]]; then SHARED=on; else SHARED=off; fi
    switch_choices false ame desktop phone clipboard "${way}"
    USAGE="ame desktop phone clipboard ${way} on|off"
    if [[ "${way}" == send ]]; then
        item desktop phone-clipboard-send switch "${ gettext "Send the clipboard to the phone"; }" \
            "${ gettext "What you copy here can be pasted on a phone you paired."; }" "${SHARED}" hardware#phones
    else
        item desktop phone-clipboard-receive switch "${ gettext "Take the phone's clipboard"; }" \
            "${ gettext "What a paired phone copies is put on this computer's clipboard, where any program can paste it."; }" "${SHARED}" hardware#phones
    fi
done

