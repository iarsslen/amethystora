# The dock (org.gnome.shell.extensions.amethystora-ui.dock): how it moves, what it holds and where it lives, each an
# ame desktop dock command. Folders and stacks are made on the dock itself.
DOCK="${ said dock; }"
dock_key() { value_of "${DOCK}" "$1" "'?([^']*)'?\$"; }
dock_onoff() { [[ "${ dock_key "$1"; }" == true ]] && echo on || echo off; }
dock_reason() { [[ "${ ended dock; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"; }
GROUP="${ gettext "Dock"; }"
choice swell "${ gettext "Swell"; }" "${ gettext "The icons grow in a wave under the pointer"; }" false ame desktop dock magnify swell
choice lift "${ gettext "Lift"; }" "${ gettext "Only the icon under the pointer rises"; }" false ame desktop dock magnify lift
choice off "${ gettext "Still"; }" "${ gettext "Nothing grows"; }" false ame desktop dock magnify off
dock_reason
USAGE="ame desktop dock magnify swell|lift|off"
item desktop dock-magnify choice "${ gettext "Growing"; }" "${ gettext "How the icons grow under the pointer."; }" \
    "${ dock_key magnify; }" desktop#how-the-dock-moves
dock_reason
[[ "${ dock_key magnify; }" == swell ]] || DETAIL="${ gettext "Only Swell grows this far."; }"
EXTRA='{"min": 120, "max": 220, "step": 5, "unit": "%", "terminal": false,
    "command": ["ame", "desktop", "dock", "amount", "{value}"]}'
USAGE="ame desktop dock amount 120..220"
item desktop dock-amount range "${ gettext "How far Swell grows"; }" \
    "${ gettext "How large the icon under the pointer becomes, in per cent."; }" \
    "$(awk -v a="${ dock_key magnify-amount; }" 'BEGIN { if (a != "") printf "%.0f", a * 100 }')" desktop#how-the-dock-moves
choice halo "${ gettext "Halo"; }" "${ gettext "A ring runs round the icon"; }" false ame desktop dock launch halo
choice hop "${ gettext "Hop"; }" "${ gettext "The icon hops"; }" false ame desktop dock launch hop
choice breathe "${ gettext "Breathe"; }" "${ gettext "The icon pulses, nothing moves"; }" false ame desktop dock launch breathe
