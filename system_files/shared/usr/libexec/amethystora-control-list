# GRUB keeps its menu in /boot, which a sealed machine, starting with systemd-boot, does not use. Where
# /boot/grub2 is root's alone, only root can tell whether the artwork is there.
BOOT_MENU=""
if [[ "${SEALED}" == true ]]; then
    REASON="${ gettext "A sealed machine starts with systemd-boot, which shows no artwork."; }"
elif [[ ! -d /boot/grub2 ]]; then
    REASON="${ gettext "This machine does not start with GRUB."; }"
elif [[ ! -r /boot/grub2 || ! -x /boot/grub2 ]]; then
    DETAIL="${ gettext "Only an administrator can see whether it is on."; }"
else
    case "${ said grub; }" in
        on:*) BOOT_MENU=on ;;
        *) BOOT_MENU=off ;;
    esac
    grep -q "does not boot with GRUB" <<<"${ said grub; }" && REASON="${ gettext "This machine does not start with GRUB."; }"
fi
switch_choices true ame desktop boot-menu
GROUP="${ gettext "Starting up"; }"
USAGE="ame desktop boot-menu on|off"
item appearance boot-menu switch "${ gettext "Boot menu artwork"; }" \
    "${ gettext "The Amethystora artwork on the menu the machine shows as it starts."; }" "${BOOT_MENU}" themes#the-boot-menu
GROUP=""

# The desktop's own sounds: the Soft set while its theme is chosen and event sounds are on; another sound theme (one
# Settings made for its alert sound) is neither choice
SOUNDS=""
if [[ "$(said sound | awk '$2 == "event-sounds" { print $3 }')" == false ]]; then
    SOUNDS=off
elif [[ "$(said sound | awk '$2 == "theme-name" { print $3 }')" == "'amethystora'" ]]; then
    SOUNDS=soft
fi
[[ "${ ended sound; }" == 0 ]] || REASON="${ gettext "GNOME's sound settings are not installed."; }"
choice soft "${ gettext "Soft"; }" "${ gettext "Lower and rounder, for a quiet room"; }" false ame desktop sounds soft
choice off "${ gettext "Off"; }" "${ gettext "The desktop makes no sound of its own; apps still can"; }" false ame desktop sounds off
GROUP="${ gettext "Sound"; }"
USAGE="ame desktop sounds SET"
item appearance sounds choice "${ gettext "Sounds"; }" \
    "${ gettext "The desktop's own sounds: notifications, screenshots, volume and the rest."; }" "${SOUNDS}" desktop#sounds
GROUP=""

