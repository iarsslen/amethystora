# The windows module: snap layouts, the switcher, the Super card, show desktop, places and dimming, then the hot
# corners and the touchpad gestures under headings of their own. The classic layout's own say when they apply.
WINDOWS="${ said windows; }"
# A key's value as the list printed it, the quotes of a string taken off
win() { value_of "${WINDOWS}" "$1" "'?([^']*)'?\$"; }
onoff() { [[ "${ win "$1"; }" == true ]] && echo on || echo off; }
win_item() {
    local id="$1" key="$2" title="$3" text="$4" manual="$5" classic="$6"
    [[ "${ ended windows; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    [[ "${classic}" == true && "${LAYOUT}" == tiling ]] && DETAIL="${ gettext "They apply once the layout is classic again."; }"
    switch_choices false ame desktop windows "${key}"
    USAGE="ame desktop windows ${key} on|off"
    item desktop "${id}" switch "${title}" "${text}" "${ onoff "${key}"; }" "${manual}"
}
GROUP="${ gettext "Windows"; }"
win_item windows-snap snap "${ gettext "Snap layouts"; }" \
    "${ gettext "Drag a window to the top of the screen, or press Super+Z, and drop it on a layout."; }" \
    desktop#snap-layouts true
win_item windows-switcher switcher "${ gettext "Window switcher you can type into"; }" \
    "${ gettext "Super+Tab and Alt+Tab show every window in a grid; typing keeps the ones whose app or title matches."; }" \
    desktop#switching-windows true
win_item windows-hold-super hold-super "${ gettext "Shortcuts while Super is held"; }" \
    "${ gettext "Hold Super to see the main shortcuts and the dock's numbers."; }" desktop#holding-super false
[[ "${ ended windows; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
EXTRA='{"min": 500, "max": 3000, "step": 100, "unit": "ms", "terminal": false,
    "command": ["ame", "desktop", "windows", "hold-super", "{value}"]}'
USAGE="ame desktop windows hold-super MS"
item desktop windows-hold-super-delay range "${ gettext "How long to hold Super"; }" "${ gettext "In milliseconds."; }" \
    "$(win hold-super-delay | sed 's/^int32 //')" desktop#holding-super
win_item windows-show-desktop show-desktop "${ gettext "Click the wallpaper to show the desktop"; }" \
    "${ gettext "Windows slide to the edges of the screen; a click brings them back."; }" desktop#show-desktop true
win_item windows-places places "${ gettext "Windows remember their places"; }" \
    "${ gettext "For each arrangement of screens, apps' windows open where they were."; }" desktop#places true
COMMAND=(ame desktop windows places forget)
TERMINAL=false
BUTTON="${ gettext "Forget"; }"
USAGE="ame desktop windows places forget"
item desktop windows-places-forget action "${ gettext "Forget the places"; }" "" "" desktop#places
win_item windows-dim dim "${ gettext "Dim the windows not in use"; }" \
    "${ gettext "The windows behind the one you are using are drawn a little darker."; }" desktop#dimming false

# The quick note is offered once the Notes command takes it
NOTE_CAPTURE=false
notes="$(command -v amethystora-notes 2>/dev/null || true)"
[[ -n "${notes}" ]] && grep -q capture "${notes}" 2>/dev/null && NOTE_CAPTURE=true
GROUP="${ gettext "Hot corners"; }"
for where in top-left top-right bottom-left bottom-right; do
    case "${where}" in
        top-left) title="${ gettext "Top left corner"; }" ;;
        top-right) title="${ gettext "Top right corner"; }" ;;
        bottom-left) title="${ gettext "Bottom left corner"; }" ;;
        bottom-right) title="${ gettext "Bottom right corner"; }" ;;
    esac
    choice none "${ gettext "Nothing"; }" "" false ame desktop windows corner "${where}" none
    choice overview "${ gettext "Overview"; }" "" false ame desktop windows corner "${where}" overview
    choice desktop "${ gettext "Show desktop"; }" "" false ame desktop windows corner "${where}" desktop
    choice lock "${ gettext "Lock screen"; }" "" false ame desktop windows corner "${where}" lock
    [[ "${NOTE_CAPTURE}" == true ]] && choice note "${ gettext "Quick note"; }" "" false ame desktop windows corner "${where}" note
    choice notifications "${ gettext "Notifications"; }" "" false ame desktop windows corner "${where}" notifications
    [[ "${ ended windows; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    USAGE="ame desktop windows corner ${where} ACTION"
    item desktop "windows-corner-${where}" choice "${title}" \
        "${ gettext "What pushing the pointer into this corner does."; }" "${ win "corner-${where}"; }" desktop#hot-corners
done

GROUP="${ gettext "Touchpad gestures"; }"
for name in pinch spread down today; do
    case "${name}" in
        pinch) title="${ gettext "Pinch with three fingers for the app grid"; }" ;;
        spread) title="${ gettext "Spread three fingers to show the desktop"; }" ;;
        down) title="${ gettext "Three fingers down for the app's windows"; }" ;;
        today) title="${ gettext "Four fingers left for Today"; }" ;;
    esac
    [[ "${ ended windows; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    [[ "${name}" == spread && "${LAYOUT}" == tiling ]] && DETAIL="${ gettext "They apply once the layout is classic again."; }"
    switch_choices false ame desktop windows gesture "${name}"
    USAGE="ame desktop windows gesture ${name} on|off"
    item desktop "windows-gesture-${name}" switch "${title}" "" "${ onoff "gesture-${name}"; }" desktop#touchpad-gestures
done
