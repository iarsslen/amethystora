#!/usr/bin/bash
# Amethystora's own settings outside security: what each one is now, and the `ame` command that changes
# it. Amethystora Control (amethystora-control) shows this list and runs those commands; `ame control`
# prints it. Nothing here changes anything, and it asks for no password.
#
#   amethystora-control-list          the list, for a terminal (`ame control`)
#   amethystora-control-list --json   the same list, for the window
#
# One list for both, so that the terminal and the window cannot disagree. Every change is an `ame`
# command, so that whatever the window does a terminal can do too; a command that asks something,
# explains a risk or needs a password says "terminal": true, and the window opens it in one. Security's
# settings are not here: they are Amethystora Security's, and `ame security status` lists them.
#
# Each entry is made by item():
#
#   {page, id, kind, group, title, text, state, detail, available, reason, manual, usage, choices, ...}
#
# where kind is switch (its choices are on and off), choice, range, action, link, themes, wallpapers,
# widgets, webapps, shortcuts, trust-image or setup, each of which the window knows how to draw. A choice is
# {value, title, text, terminal, command}, made by choice(). A command is an argument vector, which the
# window runs as it is: the page only ever sends back an entry's id and one of the values listed for it.

set -uo pipefail

# Its words, in the session's language where there is a translation of them (po/, compiled into
# /usr/share/locale by 14-security.sh), as the security report's are. A message names its values as
# shell variables, which eval_gettext fills in.
export TEXTDOMAIN=amethystora
# shellcheck source=/dev/null
source gettext.sh
# Without a process for every message, which made up most of the list's time: bash looks a $"..." string up
# in the same catalog itself. A message with a quote, a dollar, a backquote or a backslash in it, which that
# would not keep as it is, goes to the gettext program. eval_gettext, from gettext.sh, uses this one too.
# Its callers, and those of the other functions here that only print, take what it printed with bash 5.3's
# ${ ...; }, which runs it in this shell: $(...) forked one for each of the seven hundred, which doubled the time.
gettext() {
    if [[ "$1" == *[\"\$\`\\]* ]]; then
        command gettext -- "$1"
        return
    fi
    local text
    eval "text=\$\"$1\""
    printf '%s' "${text}"
}
# theme_list, theme_current, the theme folders and CONFIG_DIR, as amethystora-theme has them
# shellcheck source=../lib/amethystora/theme/lib.sh
source /usr/lib/amethystora/theme/lib.sh

JSON=false
[[ "${1:-}" == "--json" ]] && JSON=true

IMAGE_INFO=/usr/share/amethystora/image-info.json
SEALED=false
[[ -e /usr/share/amethystora/sealed ]] && SEALED=true

ITEMS=()
CHOICES=()
# Set before item() and cleared by it: an action's command, whether it opens in a terminal and the words
# on its button, what else the window needs to draw the entry (a JSON object), why it is not available
# here, a sentence under its state, and the command to type for the same thing in a terminal. GROUP, the
# sub-heading on the page, stays until it is set again.
COMMAND=()
TERMINAL=true
BUTTON=""
EXTRA=""
REASON=""
DETAIL=""
GROUP=""
USAGE=""

# A choice of a setting: its value, its words, whether it opens a terminal, and the command that sets it
choice() {
    local IFS=$'\x1f'
    # One record for item()'s jq to make the object of, its fields apart by the unit separator: a jq of its
    # own for every choice made the list slow
    CHOICES+=("$*")
}

# An entry of the list, with the choices made for it since the last one.
item() {
    local page="$1" id="$2" kind="$3" title="$4" text="$5" state="$6" manual="$7" extra="${EXTRA:-}"
    [[ -n "${extra}" ]] || extra='{}'
    # A record of its fields apart by the record separator, then how many choices, the choices and the
    # command's words, which items_json makes the objects of, with one jq for the whole list
    local IFS=$'\x1e'
    local fields=("${page}" "${id}" "${kind}" "${GROUP}" "${title}" "${text}" "${state}" "${DETAIL}" "${REASON}"
        "${manual}" "${USAGE}" "${BUTTON}" "${TERMINAL}" "${extra}" "${#CHOICES[@]}" "${CHOICES[@]}" "${COMMAND[@]}")
    ITEMS+=("${fields[*]}")
    CHOICES=()
    COMMAND=()
    TERMINAL=true
    BUTTON=""
    EXTRA=""
    REASON=""
    DETAIL=""
    USAGE=""
}

# The two choices of a switch: the command given, with on or off after it
ON="${ gettext "On"; }"
OFF="${ gettext "Off"; }"
switch_choices() {
    local terminal="$1"
    shift
    choice on "${ON}" "" "${terminal}" "$@" on
    choice off "${OFF}" "" "${terminal}" "$@" off
}

# "tokyo-night" as "Tokyo Night": a theme's or a picture's name, which is a name and not translated
pretty() {
    local s="${1//[-_]/ }" out="" c prev=" " i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        [[ "${prev}" == " " && "${c}" == [a-z] ]] && c="${c^}"
        out+="${c}"
        prev="${c}"
    done
    printf '%s\n' "${out}"
}

# The slow reads, all at once: each writes what it said, and how it ended, to a file of its own
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT
read_in_background() {
    local name="$1"
    shift
    { timeout 20 "$@" >"${WORK}/${name}" 2>/dev/null; echo "$?" >"${WORK}/${name}.code"; } &
}
# What each said and how it ended, read by bash itself rather than by cat
said() {
    local text=""
    IFS= read -r -d '' text 2>/dev/null <"${WORK}/$1"
    printf '%s' "${text}"
}
ended() {
    local code=1
    [[ -e "${WORK}/$1.code" ]] && IFS= read -r -d '' code <"${WORK}/$1.code"
    printf '%s' "${code}"
}
# The value of key $2 in what gsettings list-recursively printed ($1), as the extended expression $3 after the
# schema's name and the key takes it (its first group), on a line of its own for every line that matches: what
# sed -n 's/^[^ ]* KEY .../\1/p' printed, without a process. The lines are split by the shell's word splitting (with
# no globbing), which is quick where taking them off one by one is not, and only a line with the key in it is matched.
value_of() {
    local - IFS=$'\n' line expression="^[^ ]* $2 $3"
    set -f
    for line in $1; do
        [[ "${line}" == *" $2 "* && "${line}" =~ ${expression} ]] && printf '%s\n' "${BASH_REMATCH[1]}"
    done
}
# A Flatpak app installed for the machine or the account, as flatpak keeps it: what flatpak info answers,
# without loading every installation, which took a third of a second with many apps
installed() {
    [[ -e "/var/lib/flatpak/app/$1/current/active" || -e "${XDG_DATA_HOME:-${HOME}/.local/share}/flatpak/app/$1/current/active" ]]
}

read_in_background grub amethystora-grub-theme status
read_in_background agent amethystora-agent status
read_in_background agents amethystora-agent list
read_in_background policy amethystora-agent policy --json
read_in_background widgets amethystora-widgets list --json
read_in_background webapps amethystora-webapp list --json
read_in_background image /usr/bin/amethystora-rollback-helper --choices
read_in_background bling amethystora-bling status
read_in_background backgrounds amethystora-theme bg list
read_in_background raid /usr/libexec/amethystora-raid status --json
# The quick ones too, which one after another took a fifth of a second in a VM
read_in_background transitions gsettings list-recursively org.gnome.shell.extensions.amethystora-transitions
read_in_background clipboard gsettings get org.gnome.shell.extensions.amethystora-clipboard keep-history
read_in_background privacy gsettings list-recursively org.gnome.desktop.privacy
read_in_background animations gsettings get org.gnome.desktop.interface enable-animations
# The layout switch, which was read here one process late in the list and took the list over a second with many apps
read_in_background tiling gsettings get org.gnome.shell.extensions.amethystora-ui.tiling enabled
read_in_background windows gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.windows
read_in_background dock gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.dock
read_in_background shake gsettings get org.gnome.shell.extensions.amethystora-ui.pointer shake
read_in_background dense gsettings get org.gnome.shell.extensions.amethystora-ui.pointer dense
read_in_background glass gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.glass
read_in_background motion gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.motion
read_in_background bezel gsettings get org.gnome.shell.extensions.amethystora-ui.bezel round-corners
read_in_background hints gsettings get org.gnome.shell.extensions.amethystora-ui.hints enabled
read_in_background app-grid gsettings get org.gnome.shell.extensions.amethystora-ui.appgrid recent
read_in_background sound gsettings list-recursively org.gnome.desktop.sound
read_in_background space-names gsettings get org.gnome.shell.extensions.amethystora-ui.workspaces auto-names
read_in_background sets gsettings get org.gnome.shell.extensions.amethystora-ui.workspaces sets
read_in_background pill gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.pill
read_in_background quick gsettings get org.gnome.shell.extensions.amethystora-ui.quick tile-hidden
read_in_background bars gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.bars
read_in_background today gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.today
read_in_background focus gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.focus
read_in_background breaks gsettings get org.gnome.desktop.break-reminders selected-breaks
read_in_background search gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.search
read_in_background emoji gsettings get org.gnome.shell.extensions.amethystora-ui.emoji skin-tone
read_in_background typing gsettings get org.gnome.shell.extensions.amethystora-ui.typing expand
read_in_background shortcuts /usr/libexec/amethystora-text-shortcuts list --json
read_in_background night-light gsettings list-recursively org.gnome.settings-daemon.plugins.color
read_in_background look gsettings list-recursively org.gnome.shell.extensions.amethystora-ui.theme
read_in_background daylight amethystora-theme daylight status
read_in_background daylight-now amethystora-theme daylight now
read_in_background a11y gsettings list-recursively org.gnome.desktop.a11y.interface
read_in_background profile busctl --system get-property org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles ActiveProfile
read_in_background phone systemctl --user is-enabled amethystora-connect.service
read_in_background clipboard-send gsettings get org.amethystora.Connect clipboard-send
read_in_background clipboard-receive gsettings get org.amethystora.Connect clipboard-receive
read_in_background phone-photos gsettings get org.amethystora.Connect photo-folder
read_in_background waydroid-enabled systemctl is-enabled waydroid-container.service
read_in_background waydroid-active systemctl is-active waydroid-container.service
read_in_background uupd systemctl is-enabled uupd.timer
read_in_background rpm-ostree systemctl is-enabled rpm-ostreed-automatic.timer
wait

# --- Appearance ------------------------------------------------------------------------------------

THEME="$(theme_current 2>/dev/null || true)"
# The accent the account chose (a file of its own, as the icons are), which the themes' previews are drawn with too
ACCENT_SET="$(account_accent)"
ACCENT_FILL=""
[[ -n "${ACCENT_SET}" ]] && ACCENT_FILL="$(accent_fill "${ACCENT_SET}")"
# Daylight's picture of this moment, for each theme that has its four (the preview shows a theme as it would open)
DAYLIGHT_INDEX=""
if daylight_on; then
    DAYLIGHT_INDEX="$(daylight_index_now 2>/dev/null || true)"
fi
# With the palette the window draws each theme's swatch from, and the picture its preview stands on. One jq for all the
# themes, each a line of its slug, title and light or dark by the record separator, then its picture and its colours: a
# jq of its own for each was the biggest part of the list's time
mapfile -t -O "${#CHOICES[@]}" CHOICES < <(
    while read -r slug; do
        [[ -n "${slug}" ]] || continue
        dir="${SYSTEM_THEMES_DIR}/${slug}"
        [[ -f "${USER_THEMES_DIR}/${slug}/colors.toml" ]] && dir="${USER_THEMES_DIR}/${slug}"
        light=false
        if [[ -f "${SYSTEM_THEMES_DIR}/${slug}/light.mode" || -f "${USER_THEMES_DIR}/${slug}/light.mode" ]]; then
            light=true
        fi
        printf '\x1e%s\x1e%s\x1e%s\n' "${slug}" "${ pretty "${slug}"; }" "${light}"
        picture=""
        list="${SYSTEM_THEMES_DIR}/${slug}/backgrounds.list"
        [[ -f "${USER_THEMES_DIR}/${slug}/backgrounds.list" ]] && list="${USER_THEMES_DIR}/${slug}/backgrounds.list"
        [[ -f "${list}" ]] && picture="$(grep -m1 '^/' "${list}" 2>/dev/null || true)"
        if [[ -n "${DAYLIGHT_INDEX}" ]]; then
            daylight_dir="${SYSTEM_THEMES_DIR}/${slug}"
            [[ -f "${USER_THEMES_DIR}/${slug}/daylight.list" ]] && daylight_dir="${USER_THEMES_DIR}/${slug}"
            mapfile -t times < <(daylight_pictures "${daylight_dir}" 2>/dev/null)
            ((${#times[@]} == 4)) && picture="${times[DAYLIGHT_INDEX]}"
        fi
        [[ -n "${picture}" ]] && printf 'picture %s\n' "${picture}"
        sed -nE 's/^[[:space:]]*([a-z0-9_]+)[[:space:]]*=[[:space:]]*"(#[0-9a-fA-F]{6})".*/\1 \2/p' "${dir}/colors.toml" 2>/dev/null
    done < <(theme_list) |
        jq -Rnc --arg accent "${ACCENT_FILL}" '[inputs] | reduce .[] as $line ([];
                if ($line | startswith("\u001e")) then
                    ($line[1:] | split("\u001e")) as $head
                    | . + [{value: $head[0], title: $head[1], light: ($head[2] == "true"), swatch: []}]
                elif ($line | startswith("picture ")) then .[-1].picture = $line[8:]
                else .[-1].swatch += [$line] end)
            | .[] | {value, title, text: null, terminal: false, command: ["ame", "desktop", "theme", .value], light,
                picture: (.picture // null),
                colors: (.swatch | map(split(" ") | {key: .[0], value: .[1]}) | from_entries
                    | {background, foreground, accent, color1, color2, color3, color4, color5, color6}
                    | if $accent != "" then .accent = $accent else . end)}'
)
USAGE="ame desktop theme NAME"
item appearance theme themes "${ gettext "Theme"; }" \
    "${ gettext "The colours of the desktop, the terminal and the apps that follow it, with the theme's own wallpapers."; }" \
    "${THEME}" themes#switching

# The twelve accents, and the theme's own: each a colour the window draws as a dot. "Follow the theme" is the theme's own
# accent, named after the nearest of the twelve.
OWN_ACCENT="$(colors_get "$(theme_source_dir "${THEME:-${DEFAULT_THEME}}")" accent | tr '[:upper:]' '[:lower:]')"
declare -A ACCENT_NAMES=(
    [amethyst]="${ gettext "Amethyst"; }" [iris]="${ gettext "Iris"; }" [sky]="${ gettext "Sky"; }" [lagoon]="${ gettext "Lagoon"; }"
    [jade]="${ gettext "Jade"; }" [moss]="${ gettext "Moss"; }" [amber]="${ gettext "Amber"; }" [ember]="${ gettext "Ember"; }"
    [coral]="${ gettext "Coral"; }" [rose]="${ gettext "Rose"; }" [orchid]="${ gettext "Orchid"; }" [slate]="${ gettext "Slate"; }"
)
# The nearest of the twelve, by the distance of their red, green and blue
own="$(printf '%s\n' "${ACCENTS[@]}" | awk -v own="${OWN_ACCENT:-#9148f0}" '
    function hex(s, i) { return index("0123456789abcdef", substr(s, i, 1)) * 16 + index("0123456789abcdef", substr(s, i + 1, 1)) - 17 }
    { d = 0; for (i = 2; i <= 6; i += 2) d += (hex($2, i) - hex(own, i)) ^ 2; if (best == "" || d < bd) { best = $1; bd = d } }
    END { print best }')"
own="${ACCENT_NAMES[${own}]:-${OWN_ACCENT}}"
# Follow the theme first, then the twelve in two columns as the boards draw them
mapfile -t -O "${#CHOICES[@]}" CHOICES < <(
    {
        printf '%s\t%s\t%s\t%s\n' theme "${ gettext "Follow the theme"; }" "${OWN_ACCENT:-#9148f0}" "${ eval_gettext "The theme's own: \${own}"; }"
        for entry in "${ACCENTS[@]}"; do
            printf '%s\t%s\t%s\t\n' "${entry%% *}" "${ACCENT_NAMES[${entry%% *}]}" "${entry##* }"
        done
    } | jq -Rc 'split("\t") | {value: .[0], title: .[1], color: .[2], text: (if .[3] == "" then null else .[3] end),
        terminal: false, command: ["ame", "desktop", "accent", .[0]]}'
)
USAGE="ame desktop accent ACCENT"
item appearance accent choice "${ gettext "Accent"; }" \
    "${ gettext "The colour of buttons, switches and selections, in any theme."; }" "${ACCENT_SET:-theme}" themes#accents

# Colours from the wallpaper: off, or one of three ways; a chosen accent stays over the wallpaper's
COLOURS_SET="$(colours_way)"
if [[ -n "${ACCENT_SET}" && -n "${COLOURS_SET}" && "${COLOURS_SET}" != mono ]]; then
    DETAIL="${ gettext "Your accent is kept: choose Follow the theme under Accent to take the wallpaper's."; }"
fi
choice off "${ gettext "Off"; }" "${ gettext "The theme's own colours"; }" false ame desktop colours off
choice vivid "${ gettext "Vivid"; }" "${ gettext "The strongest hue leads"; }" false ame desktop colours vivid
choice soft "${ gettext "Soft"; }" "${ gettext "The same hues, quieter"; }" false ame desktop colours soft
choice mono "${ gettext "Mono"; }" "${ gettext "Tinted greys, colour on controls only"; }" false ame desktop colours mono
USAGE="ame desktop colours vivid|soft|mono|off"
item appearance colours choice "${ gettext "Colours from the wallpaper"; }" \
    "${ gettext "The desktop's ground and accent taken from the wallpaper."; }" "${COLOURS_SET:-off}" themes#colours-from-your-wallpaper

# The theme's own icons, style and font, which "Follow the theme" gives: each of the three is the account's to keep
# whatever the theme, so that any theme, style, font and icons go together. Read from the current theme's files as
# amethystora-theme reads them, without the account's choice. The fonts are the theme's files as they are, not asked of
# fontconfig, whose list of every family cost the list a second in the lab (20-tests.sh holds every theme's to one that
# is installed).
OWN_ICONS="$(CONFIG_DIR=/nonexistent icon_theme)"
OWN_STYLE="$(CONFIG_DIR=/nonexistent desktop_style)"
OWN_FONT="$(theme_file font.theme)"
OWN_FONT="${OWN_FONT:-${DEFAULT_FONT}}"
OWN_MONO="$(theme_file mono.theme)"
OWN_MONO="${OWN_MONO:-${DEFAULT_MONO_FONT}}"
own="${ pretty "${OWN_ICONS#amethystora-}"; }"
ICONS_SET=theme
[[ -r "${CONFIG_DIR}/icons" ]] && { ICONS_SET="$(<"${CONFIG_DIR}/icons")"; ICONS_SET="${ICONS_SET#amethystora-}"; }
choice glass "${ gettext "Glass"; }" "${ gettext "Each icon in its own gradient, with a glass sheen"; }" false ame desktop icons glass
choice glass-light "${ gettext "Glass for light"; }" "${ gettext "Glass with its colours deepened to read on a light desktop"; }" false ame desktop icons glass-light
choice neon "${ gettext "Neon"; }" "${ gettext "Outlines lit in colours of their own, for a dark desktop"; }" false ame desktop icons neon
choice neon-light "${ gettext "Neon for light"; }" "${ gettext "Neon with its colours deepened to read on a light desktop"; }" false ame desktop icons neon-light
choice duotone "${ gettext "Duotone"; }" "${ gettext "Each icon in a gradient, its details in a contrasting one"; }" false ame desktop icons duotone
choice line "${ gettext "Line"; }" "${ gettext "One even outline, in colours that read on every theme"; }" false ame desktop icons line
choice clay "${ gettext "Clay"; }" "${ gettext "Soft matte volumes, a highlight above and a shade below"; }" false ame desktop icons clay
choice muted "${ gettext "Muted"; }" "${ gettext "Glass in quieter colours, for themes of low chroma"; }" false ame desktop icons muted
choice theme "${ gettext "Follow the theme"; }" "${ eval_gettext "The theme's own: \${own}"; }" false ame desktop icons theme
USAGE="ame desktop icons PACK"
item appearance icons choice "${ gettext "Icons"; }" \
    "${ gettext "The pack the apps, folders and files are drawn from. Another maker's app keeps its own icon."; }" "${ICONS_SET}" themes#icons

STYLE_SET=theme
[[ -r "${CONFIG_DIR}/style" ]] && STYLE_SET="$(head -n1 "${CONFIG_DIR}/style")"
choice islands "${ gettext "Islands"; }" "${ gettext "A floating pill for each part of the top bar, soft corners everywhere"; }" false ame desktop style islands
choice floating "${ gettext "Floating"; }" "${ gettext "One rounded top bar held off the edge of the screen"; }" false ame desktop style floating
choice hairline "${ gettext "Hairline"; }" "${ gettext "A thin, solid top bar, crisp corners and fine lines"; }" false ame desktop style hairline
choice capsule "${ gettext "Capsule"; }" "${ gettext "The clock in a dark capsule, and everything else a pill"; }" false ame desktop style capsule
choice terminal "${ gettext "Terminal"; }" "${ gettext "Monospace, square and lined, like a terminal"; }" false ame desktop style terminal
choice segments "${ gettext "Segments"; }" "${ gettext "The top bar in blocks of the theme's colours"; }" false ame desktop style segments
choice neon "${ gettext "Neon"; }" "${ gettext "Dark glass outlined and glowing in the theme's accent"; }" false ame desktop style neon
own="${ pretty "${OWN_STYLE}"; }"
choice theme "${ gettext "Follow the theme"; }" "${ eval_gettext "The theme's own: \${own}"; }" false ame desktop style theme
USAGE="ame desktop style STYLE"
item appearance style choice "${ gettext "Style"; }" \
    "${ gettext "The shape of the top bar, menus, notifications, dialogs, buttons and windows."; }" "${STYLE_SET}" themes#styles

# The glass, and Comfort: Reduce transparency is the glass's own key, Reduce motion and Increase contrast are GNOME's
# accessibility keys, which the apps follow too, and the power saver is the profile power-profiles-daemon has on
GLASS="$(said glass | sed -n "s/^[^ ]* material '\(.*\)'$/\1/p")"
SOLID="$(said glass | sed -n 's/^[^ ]* solid \(true\|false\)$/\1/p')"
CONTRAST="$(said a11y | sed -n 's/^[^ ]* high-contrast \(true\|false\)$/\1/p')"
MOTION="$(said a11y | sed -n "s/^[^ ]* reduced-motion '\(.*\)'$/\1/p")"
SAVER=false
[[ "${ said profile; }" == 's "power-saver"' ]] && SAVER=true
[[ "${ ended glass; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
if [[ "${SOLID}" == true ]]; then
    DETAIL="${ gettext "The glass is drawn solid while Reduce transparency is on."; }"
elif [[ "${CONTRAST}" == true ]]; then
    DETAIL="${ gettext "The glass is drawn solid while High Contrast is on."; }"
elif [[ "${SAVER}" == true ]]; then
    DETAIL="${ gettext "The glass is drawn solid while the power saver is on."; }"
fi
choice frost "${ gettext "Frost"; }" "${ gettext "Thick, milky glass with an even tint"; }" false ame desktop glass frost
choice prism "${ gettext "Prism"; }" "${ gettext "Less tint, more colour, a lit top edge and light along the bottom"; }" false ame desktop glass prism
choice clear "${ gettext "Clear"; }" "${ gettext "The thinnest glass and the brightest rim; it darkens by itself where text needs it"; }" false ame desktop glass clear
USAGE="ame desktop glass frost|prism|clear"
item appearance glass choice "${ gettext "Glass"; }" \
    "${ gettext "What the top bar, the dock, menus and notifications show of the wallpaper behind them."; }" "${GLASS}" themes#glass

GROUP="${ gettext "Comfort"; }"
[[ "${ ended glass; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
[[ "${SAVER}" == true ]] && DETAIL="${ gettext "The power saver makes the glass solid for as long as it is on."; }"
switch_choices false ame desktop comfort reduce-transparency
USAGE="ame desktop comfort reduce-transparency on|off"
item appearance reduce-transparency switch "${ gettext "Reduce transparency"; }" \
    "${ gettext "The glass becomes the theme's solid surfaces. Nothing is blurred, which also saves power."; }" \
    "$([[ "${SOLID}" == true ]] && echo on || echo off)" themes#comfort
[[ "${ said animations; }" == false ]] && DETAIL="${ gettext "Animations are off in Settings, under Accessibility, which is calmer still."; }"
switch_choices false ame desktop comfort reduce-motion
USAGE="ame desktop comfort reduce-motion on|off"
item appearance reduce-motion switch "${ gettext "Reduce motion"; }" \
    "${ gettext "Animations fade in place instead of travelling."; }" \
    "$([[ "${MOTION}" == reduce ]] && echo on || echo off)" themes#comfort
switch_choices false ame desktop comfort increase-contrast
USAGE="ame desktop comfort increase-contrast on|off"
item appearance increase-contrast switch "${ gettext "Increase contrast"; }" \
    "${ gettext "GNOME's High Contrast: stronger outlines, plain text and outlined controls, in the apps as well."; }" \
    "$([[ "${CONTRAST}" == true ]] && echo on || echo off)" themes#comfort
GROUP=""

FONT_SET=theme
[[ -r "${CONFIG_DIR}/font" ]] && FONT_SET="$(head -n1 "${CONFIG_DIR}/font")"
# A family's name is the same in every language, and the window draws it in that font: one jq for them all
mapfile -t -O "${#CHOICES[@]}" CHOICES < <(jq -nc '$ARGS.positional[]
    | {value: ., title: ., text: null, terminal: false, command: ["ame", "desktop", "font", .], font: .}' \
    --args "${UI_FONTS[@]}")
own="${OWN_FONT}"
choice theme "${ gettext "Follow the theme"; }" "${ eval_gettext "The theme's own: \${own}"; }" false ame desktop font theme
USAGE="ame desktop font FAMILY"
item appearance font choice "${ gettext "Font"; }" \
    "${ gettext "The font of the desktop and the applications."; }" "${FONT_SET}" themes#fonts

MONO_SET=theme
[[ -r "${CONFIG_DIR}/mono-font" ]] && MONO_SET="$(head -n1 "${CONFIG_DIR}/mono-font")"
mapfile -t -O "${#CHOICES[@]}" CHOICES < <(jq -nc '$ARGS.positional[]
    | {value: ., title: ., text: null, terminal: false, command: ["ame", "desktop", "mono-font", .], font: .}' \
    --args "${MONO_FONTS[@]}")
own="${OWN_MONO}"
choice theme "${ gettext "Follow the theme"; }" "${ eval_gettext "The theme's own: \${own}"; }" false ame desktop mono-font theme
USAGE="ame desktop mono-font FAMILY"
item appearance mono-font choice "${ gettext "Monospace font"; }" \
    "${ gettext "The font of the terminal, of code and of Text Editor."; }" "${MONO_SET}" themes#fonts

if [[ -z "${THEME}" ]]; then
    REASON="${ gettext "Pick a theme first: each theme has wallpapers of its own."; }"
fi
CURRENT_PICTURE="$(readlink "${CURRENT_BACKGROUND}" 2>/dev/null || true)"
OPENING="$(grep -m1 '^/' "${CURRENT_THEME_DIR}/backgrounds.list" 2>/dev/null || true)"
while read -r picture; do
    [[ -n "${picture}" ]] || continue
    name="${picture##*/}"
    if [[ "${picture}" == "${OPENING}" && "${ said daylight; }" == on && -n "${ said daylight-now; }" ]]; then
        # The opening picture is Daylight's: its tile shows the picture of the hour, and says so
        CHOICES+=("$(jq -nc --arg value "${picture}" --arg title "${ pretty "${name%.*}"; }. ${ gettext "Changes with the time of day"; }" \
            --arg thumbnail "${ said daylight-now; }" \
            '{value: $value, title: $title, text: null, terminal: false, command: ["ame", "desktop", "background", $value], thumbnail: $thumbnail}')")
        continue
    fi
    choice "${picture}" "${ pretty "${name%.*}"; }" "" false ame desktop background "${picture}"
done < <(said backgrounds)
USAGE="ame desktop background"
item appearance wallpaper wallpapers "${ gettext "Wallpaper"; }" \
    "${ gettext "The pictures of the current theme. Super+Ctrl+Space shows the next one."; }" \
    "${CURRENT_PICTURE}" themes#wallpapers

# Daylight, the theme's first wallpaper by the time of day: on unless the account turned it off
DAYLIGHT="${ said daylight; }"
if [[ "${DAYLIGHT}" == none ]]; then
    REASON="${ gettext "This theme has no Daylight pictures."; }"
fi
switch_choices false ame desktop daylight
