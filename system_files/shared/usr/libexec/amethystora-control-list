# What the search finds besides GNOME's own (org.gnome.shell.extensions.amethystora-ui.search), each a switch
SEARCH="${ said search; }"
search_item() {
    local key="$1" title="$2" text="$3"
    [[ "${ ended search; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    switch_choices false ame desktop search "${key}"
    GROUP="${ gettext "Search"; }"
    USAGE="ame desktop search ${key} on|off"
    item desktop "search-${key}" switch "${title}" "${text}" \
        "$([[ "${SEARCH}" == *" ${key} true"* ]] && echo on || echo off)" desktop#finding-things
}
search_item answers "${ gettext "Sums and units"; }" \
    "${ gettext "Answers sums and conversions as you type, in your language's numbers."; }"
search_item settings "${ gettext "Settings from Control"; }" "${ gettext "Finds Control's settings, and changes one with Enter."; }"
search_item manual "${ gettext "The manual"; }" "${ gettext "Finds the pages of this manual that answer what you typed."; }"
search_item windows "${ gettext "Open windows"; }" "${ gettext "Finds an open window by its title, on any workspace."; }"
search_item clipboard "${ gettext "Clipboard history"; }" \
    "${ gettext "Shows what you copied when you type clip: first, and only then."; }"
search_item agent "${ gettext "Ask the agent"; }" \
    "${ gettext "The last row asks the AI agent, while the agentic features are on."; }"
search_item glance "${ gettext "Glance at files"; }" \
    "${ gettext "Space shows a file found by the search without opening it."; }"
GROUP=""

