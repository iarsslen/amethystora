# The live pill, the privacy dots, the glow, quiet and the digest (org.gnome.shell.extensions.amethystora-ui.pill)
PILL="${ said pill; }"
pill_key() { value_of "${PILL}" "$1" "(.*)\$"; }
pill_onoff() { [[ "${ pill_key "$1"; }" == true ]] && echo on || echo off; }
pill_item() {
    local id="$1" title="$2" text="$3" manual="$4"
    shift 4
    [[ "${ ended pill; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    switch_choices false "$@"
    USAGE="$* on|off"
    item desktop "${id}" switch "${title}" "${text}" "${ pill_onoff "${PILLKEY}"; }" "${manual}"
}
GROUP="${ gettext "Top bar"; }"
PILLKEY=live pill_item pill "${ gettext "Live pill"; }" \
    "${ gettext "The clock shows what is happening now: music, a timer, a call, a recording, a link from the phone, an update ready. Click it for its controls."; }" \
    desktop#the-live-pill ame desktop pill
PILLKEY=privacy-dots pill_item privacy-dots "${ gettext "Privacy dots"; }" \
    "${ gettext "A dot in the top bar while the microphone, the camera, the screen or your location is in use. Click it to see which."; }" \
    desktop#privacy-dots ame desktop pill dots
PILLKEY=glow pill_item glow "${ gettext "Recording glow"; }" \
    "${ gettext "A thin red glow round the screen while it is recorded or shared. It shows in a recording of the whole screen."; }" \
    desktop#privacy-dots ame desktop pill glow

# A top bar on every screen, the bar over fullscreen, Today's tasks and the weather
# (org.gnome.shell.extensions.amethystora-ui.bars and .today)
key_of() { value_of "$1" "$2" "(.*)\$"; }
onoff_of() { [[ "${ key_of "$1" "$2"; }" == true ]] && echo on || echo off; }
BARS="${ said bars; }"
TODAY="${ said today; }"
ui_switch() {
    local source="$1" key="$2" id="$3" title="$4" text="$5" manual="$6" terminal="$7"
    shift 7
    [[ "${ ended "${source}"; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
    switch_choices "${terminal}" "$@"
    USAGE="$* on|off"
    local values="${BARS}"
    [[ "${source}" == today ]] && values="${TODAY}"
    item desktop "${id}" switch "${title}" "${text}" "${ onoff_of "${values}" "${key}"; }" "${manual}"
}
GROUP="${ gettext "Top bar"; }"
ui_switch bars every-screen top-bar-screens "${ gettext "A top bar on every screen"; }" \
    "${ gettext "Each screen's own bar shows the workspace on it and the time."; }" \
    desktop#several-monitors false ame desktop top-bar screens
ui_switch bars peek top-bar-peek "${ gettext "The top bar over fullscreen"; }" \
    "${ gettext "Push the pointer against the top edge of a fullscreen window to see the bar."; }" \
    desktop#the-top-bar false ame desktop top-bar peek
ui_switch today tasks today-tasks "${ gettext "Today's tasks in the calendar"; }" \
    "${ gettext "The tasks due today, from Notes while it is open and unlocked."; }" \
    desktop#today false ame desktop today tasks
# It says what it sends before it turns on: in a terminal
ui_switch today weather weather "${ gettext "Weather beside the clock"; }" \
    "${ gettext "Sends the place you chose in Weather to a weather service."; }" \
    desktop#the-weather true ame desktop weather

# GNOME's own rest reminders (org.gnome.desktop.break-reminders)
case "${ said breaks; }" in
    *eyesight*movement* | *movement*eyesight*) BREAKS=both ;;
    *eyesight*) BREAKS=eyesight ;;
    *movement*) BREAKS=movement ;;
    *) BREAKS=off ;;
esac
[[ "${ ended breaks; }" == 0 ]] || REASON="${ gettext "This GNOME has no rest reminders."; }"
GROUP="${ gettext "Rest"; }"
choice off "${ gettext "Off"; }" "" false ame desktop breaks off
choice eyesight "${ gettext "Look away"; }" "" false ame desktop breaks eyesight
choice movement "${ gettext "Stand up"; }" "" false ame desktop breaks movement
choice both "${ gettext "Both"; }" "" false ame desktop breaks both
USAGE="ame desktop breaks on|eyesight|movement|both|off"
