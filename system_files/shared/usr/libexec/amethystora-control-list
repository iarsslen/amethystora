# Motion (org.gnome.shell.extensions.amethystora-ui.motion): how a window goes into the dock and comes back, and how
# workspaces change. Reduce motion is Comfort's, on the Appearance page.
MOTIONS="${ said motion; }"
motion_key() { value_of "${MOTIONS}" "$1" "'(.*)'\$"; }
motion_note() {
    if [[ "${MOTION}" == reduce ]]; then
        DETAIL="${ gettext "Reduce motion is on: windows and workspaces fade instead."; }"
    elif [[ "${ said animations; }" == false ]]; then
        DETAIL="${ gettext "Animations are off in Settings, so nothing moves."; }"
    fi
    [[ "${ ended motion; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
}
GROUP="${ gettext "Motion"; }"
choice droplet "${ gettext "Droplet"; }" "${ gettext "The window gathers into a drop of glass and arcs into its icon"; }" false \
    ame desktop minimize droplet
choice shrink "${ gettext "Shrink"; }" "${ gettext "The window shrinks and fades into its icon"; }" false \
    ame desktop minimize shrink
motion_note
USAGE="ame desktop minimize droplet|shrink"
item desktop minimize choice "${ gettext "Minimize"; }" "${ gettext "How a window goes into the dock and comes back."; }" \
    "${ motion_key minimize; }" desktop#motion
choice depth "${ gettext "Depth"; }" \
    "${ gettext "The wallpaper slides a third as far as the windows, which step back a little on the way"; }" false \
    ame desktop workspace-switch depth
choice slide "${ gettext "Slide"; }" "${ gettext "Each workspace slides in whole, wallpaper and all"; }" false \
    ame desktop workspace-switch slide
motion_note
USAGE="ame desktop workspace-switch depth|slide"
item desktop workspace-switch choice "${ gettext "Changing workspace"; }" \
    "${ gettext "How one workspace gives way to the next."; }" "${ motion_key workspace-switch; }" desktop#motion
GROUP="${ gettext "Workspaces"; }"
switch_choices false ame desktop space-names
[[ "${ ended space-names; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
USAGE="ame desktop space-names on|off"
item desktop space-names switch "${ gettext "Name workspaces after their apps"; }" \
    "${ gettext "A workspace you have not named shows the name of the app with most windows on it."; }" \
    "$([[ "${ said space-names; }" == true ]] && echo on || echo off)" desktop#workspaces
switch_choices false ame desktop sets
[[ "${ ended sets; }" == 0 ]] || REASON="${ gettext "Amethystora UI is not installed."; }"
