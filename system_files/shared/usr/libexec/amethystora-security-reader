#!/usr/bin/bash
# What only an account can see, read as that account for the security watcher (amethystora-security-watch),
# which runs this with setpriv, a clean environment and a timeout, for each account with a session in the last
# day. It keeps nothing: it prints what is there now, one JSON line each, and the watcher, as root, keeps what
# it printed last time and says what is new.
#
#   amethystora-security-reader MODE
#
# Each line is {id, text, level, tactic, allow, within}: id names the thing for as long as it stays the same,
# level is how loud it is when new (critical, normal or quiet), allow is the entry `ame security allow` takes
# for it, and within the id of what it belongs to, so that a thing that arrives with something new is not said
# on its own: an app's permissions come with the app.
#
# What it reads, the account wrote, or something running as the account did: it is parsed and quoted, never
# run, sourced or followed out of the home.
#
#   app-permissions   APP_PERMISSIONS: each Flatpak app, and each way out of its sandbox it has
#                     (amethystora-app-permissions, which the report and the Apps page read too)
#   dev-hooks         DEV_HOOKS: what a developer tool runs by itself, from Python's .pth files, git's
#                     and SSH's settings, npm's, and the editor's extensions
#   agent-config      AGENT_CONFIG: what the AI agents' own settings have them run, start or send to,
#                     and a permission mode that turns their checks off

set -uo pipefail

# The reaches that leave the sandbox (a changed export of the account's own installation runs outside every
# sandbox), those that see what is typed, and code loaded into the app from outside it
LEAVES='["session-bus","system-bus","flatpak","systemd","autostart","installations"]'
TYPING='["x11","input"]'
CODE='["code"]'

app_permissions() {
    /usr/libexec/amethystora-app-permissions --json 2>/dev/null |
        jq -c --argjson leaves "${LEAVES}" --argjson typing "${TYPING}" --argjson code "${CODE}" '
        .[]
        # Flatpak refuses any other id, and only such an id reaches a notification
        | select(.app | test("^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)+$"))
        | . as $app
        | {id: .app, level: "quiet", tactic: "-",
           text: ("The Flatpak app \(.name) (\(.app)) was installed"
                  + (if (.reaches | length) > 0 then ". It can: " + (.reaches | map(.text) | join("; ")) else "" end))},
          (.reaches[] | {id: "\($app.app) \(.id)", within: $app.app, allow: "\($app.app) \(.id)",
           # X11 and the input devices, which the image takes from every app, are said when granted back
           level: (if (.id | IN($leaves[], $code[])) or ((.id | IN($typing[])) and .granted) then "normal" else "quiet" end),
           tactic: (if (.id | IN($leaves[])) then "Privilege Escalation" elif (.id | IN($typing[])) then "Collection"
                    elif (.id | IN($code[])) then "Persistence" else "-" end),
           text: ("\($app.name) (\($app.app)) can now \(.text | .[:1] | ascii_downcase)\(.text | .[1:])"
                  + (if .granted then ", granted on this machine" else ", because the app asks for it" end))})'
}

# One thing found: item ID LEVEL TACTIC TEXT [ALLOW [WITHIN]]
item() {
    jq -nc --arg id "$1" --arg level "$2" --arg tactic "$3" --arg text "$4" --arg allow "${5:-}" --arg within "${6:-}" \
        '{$id, $level, $tactic, $text} + (if $allow != "" then {$allow} else {} end) + (if $within != "" then {$within} else {} end)'
}
# A file of the account's, read no further than its first 64 KiB, and for no longer than five seconds
head_of() { timeout 5 head -c 65536 -- "$1" 2>/dev/null; }
# A path as the account knows it
tilde() { [[ "$1" == "${HOME}"/* ]] && echo "~${1#"${HOME}"}" || echo "$1"; }
short() { sha256sum <<<"$1" | cut -c1-16; }

# Where a developer tool runs code by itself: Python's .pth files, which run each line that starts with
# "import" at every start of Python (how LiteLLM's compromised release stayed); git's settings that run a
# command in every repository; SSH's that run one on connecting; npm's shell for scripts and Node's options;
# and VSCodium's extensions, which update themselves. Virtual environments are everywhere and not walked.
dev_hooks() {
    local file line key value dir name version publisher
    shopt -s nullglob
    for file in "${HOME}"/.local/lib/python3*/site-packages/*.pth /home/linuxbrew/.linuxbrew/lib/python3*/site-packages/*.pth; do
        while IFS= read -r line; do
            [[ "${line}" =~ ^import[[:space:]] ]] || continue
            item "pth:${file}:$(short "${line}")" normal Persistence \
                "$(tilde "${file}") runs code at every start of Python: ${line:0:300}" "${file}"
        done < <(head_of "${file}")
    done
    # git's own settings, includes followed as git follows them; reading them runs nothing
    for file in "${HOME}/.gitconfig" "${HOME}/.config/git/config"; do
        [[ -f "${file}" ]] || continue
        while IFS= read -r line; do
            key="${line%% *}"
            value="${line#* }"
            item "git:${file}:${key}:$(short "${value}")" normal Persistence \
                "$(tilde "${file}") sets ${key} to ${value:0:300}: git runs it in every repository" "${file}"
        done < <(timeout 5 git config --file "${file}" --includes --get-regexp '^core\.(hookspath|fsmonitor|sshcommand)$' 2>/dev/null)
    done
    file="${HOME}/.ssh/config"
    if [[ -f "${file}" ]]; then
        while IFS= read -r line; do
            item "ssh:$(short "${line}")" normal Persistence \
                "$(tilde "${file}") runs a command when SSH connects: ${line:0:300}" "${file}"
        done < <(head_of "${file}" | grep -iE '^[[:space:]]*(ProxyCommand|LocalCommand|KnownHostsCommand|Match[[:space:]].*exec)[[:space:]=]' | sed 's/^[[:space:]]*//')
    fi
    file="${HOME}/.npmrc"
    if [[ -f "${file}" ]]; then
        while IFS= read -r line; do
            item "npm:$(short "${line}")" normal Persistence \
                "$(tilde "${file}") changes what npm and Node run: ${line:0:300}" "${file}"
        done < <(head_of "${file}" | grep -iE '^[[:space:]]*(script-shell|node-options)[[:space:]]*=' | sed 's/^[[:space:]]*//')
    fi
    # An extension is said when it arrives, and its new versions only recorded: they arrive by themselves
    for dir in "${HOME}"/.vscode-oss/extensions/*/ "${HOME}"/.vscode/extensions/*/; do
        [[ -f "${dir}package.json" ]] || continue
        IFS=$'\t' read -r publisher name version < <(head_of "${dir}package.json" |
            jq -r '[.publisher, .name, .version] | map(tostring | gsub("[^A-Za-z0-9._+-]"; "?")) | @tsv' 2>/dev/null)
        [[ -n "${name}" ]] || continue
        item "extension:${publisher}.${name}" normal Persistence \
            "An editor extension was added: ${publisher}.${name} ${version}, in $(tilde "${dir%/}")" "${dir%/}"
        item "extension:${publisher}.${name}:${version}" quiet Persistence \
            "The editor extension ${publisher}.${name} updated itself to ${version}" "${dir%/}" "extension:${publisher}.${name}"
    done
}

# What the account's AI agents are set to run by themselves: their hooks (commands run on each event), their
# MCP servers (commands they start, or addresses they send to), the commands their settings run (a status
# line, a key helper), the plugins and extensions they load, and a permission mode that turns their checks
# off. ChainDrop (August 2026) planted exactly these. Only the user-level files: a repository's own are read
# before opening it with an agent, as the manual says. Python reads them, isolated (-I), so that nothing of
# the account's own Python, its .pth files included, runs inside it; and it parses, never runs, what it reads.
agent_config() {
    timeout 20 python3 -I - <<'PY'
import glob, hashlib, json, os, re, sys

try:
    import tomllib
except ImportError:
    tomllib = None

HOME = os.environ["HOME"]


def tilde(path):
    return "~" + path[len(HOME):] if path.startswith(HOME + "/") else path


def read(path, limit=1 << 20):
    try:
        with open(path, "rb") as handle:
            data = handle.read(limit + 1)
    except OSError:
        return None
    return None if len(data) > limit else data.decode("utf-8", "replace")


def jsonc(text):
    # Comments and trailing commas out, outside strings, as Opencode's JSONC allows them
    out, i, quoted = [], 0, False
    while i < len(text):
        c = text[i]
        if quoted:
            out.append(c)
            if c == "\\" and i + 1 < len(text):
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                quoted = False
        elif c == '"':
            quoted = True
            out.append(c)
        elif text.startswith("//", i):
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            i = len(text) if end < 0 else end + 2
            continue
        else:
            out.append(c)
        i += 1
    return re.sub(r",(\s*[}\]])", r"\1", "".join(out))


def load(path, kind="json", limit=1 << 20):
    text = read(path, limit)
    if text is None:
        return None
    try:
        if kind == "toml":
            return tomllib.loads(text) if tomllib else None
        return json.loads(jsonc(text) if kind == "jsonc" else text)
    except (ValueError, TypeError):
        return None


def words(value):
    if isinstance(value, list):
        return " ".join(str(part) for part in value)
    return "" if value is None else str(value)


def emit(path, what, detail, level="normal", tactic="Persistence"):
    detail = " ".join(str(detail).split())[:300]
    digest = hashlib.sha256(f"{what}\0{detail}".encode()).hexdigest()[:16]
    print(json.dumps({"id": f"{path}:{digest}", "level": level, "tactic": tactic,
                      "text": f"{tilde(path)} {what}: {detail}", "allow": f"{path} {what}: {detail}"}))


def hooks(path, table):
    # {Event: [{matcher, hooks: [{type: "command", command}]}]}, as Claude Code, Gemini CLI and Cursor write them
    if not isinstance(table, dict):
        return
    for event, entries in table.items():
        for entry in entries if isinstance(entries, list) else [entries]:
            if not isinstance(entry, dict):
                continue
            for hook in entry.get("hooks", [entry]) if isinstance(entry.get("hooks", [entry]), list) else []:
                if isinstance(hook, dict):
                    command = hook.get("command") or hook.get("bash") or hook.get("exec")
                    if command:
                        emit(path, f"runs a command on {event}", words(command))


OWN_TOOLS = "/usr/libexec/amethystora-agent-tools"
READ_TOOLS = {"search", "read", "state", "logs", "history"}


def own(name, server):
    # The one entry amethystora-agent writes for Cursor CLI and Antigravity CLI, which take no launch option for
    # it: exactly it, under its name. Anything more (an environment, an address, a trust flag), or another
    # command under the same name, is somebody else's and is said like any server.
    return (name == "amethystora" and set(server) <= {"command", "args", "type", "disabled"}
            and server.get("command") == OWN_TOOLS and server.get("args") == ["mcp"]
            and server.get("type", "stdio") in ("stdio", "local") and server.get("disabled", False) is False)


def pre_allowed(path, rules, pattern):
    # A rule that has an agent use one of Amethystora's tools without asking: only the read-only ones are the
    # image's own; one that changes something must always ask
    for rule in rules if isinstance(rules, list) else []:
        found = re.fullmatch(pattern, rule) if isinstance(rule, str) else None
        if found and found.group(1) not in READ_TOOLS:
            emit(path, "lets the MCP server amethystora run a tool without asking", rule, tactic="Defense Evasion")


def servers(path, table, key="command"):
    # MCP servers: a command the agent starts, or an address it sends to
    if not isinstance(table, dict):
        return
    for name, server in table.items():
        if not isinstance(server, dict) or own(name, server):
            continue
        command = server.get(key) if key in server else server.get("command")
        if command:
            emit(path, f"starts the MCP server {name}", f"{words(command)} {words(server.get('args'))}")
        address = server.get("url") or server.get("httpUrl") or server.get("serverUrl")
        if address:
            emit(path, f"sends to the MCP server {name}", address, tactic="Command and Control")
        if server.get("trust") is True:
            emit(path, f"lets the MCP server {name} run tools without asking", name, tactic="Defense Evasion")


def off(path, what, detail):
    emit(path, what, detail, tactic="Defense Evasion")


def trusted(path, what, folders):
    for folder in folders if isinstance(folders, list) else []:
        emit(path, what, folder, level="quiet", tactic="-")


# Claude Code
path = f"{HOME}/.claude/settings.json"
data = load(path)
if isinstance(data, dict):
    hooks(path, data.get("hooks"))
    for key in ("apiKeyHelper", "otelHeadersHelper", "awsAuthRefresh", "awsCredentialExport"):
        if data.get(key):
            emit(path, f"runs a command as {key}", words(data[key]))
    for key in ("statusLine", "fileSuggestion"):
        if isinstance(data.get(key), dict) and data[key].get("command"):
            emit(path, f"runs a command as {key}", words(data[key]["command"]))
    if (data.get("permissions") or {}).get("defaultMode") == "bypassPermissions":
        off(path, "turns Claude Code's checks off", "permissions.defaultMode bypassPermissions")
    if data.get("enableAllProjectMcpServers") is True:
        off(path, "starts every project's MCP servers without asking", "enableAllProjectMcpServers")
path = f"{HOME}/.claude.json"
# Claude Code rewrites the rest of this file all the time: only its servers and project permissions count
data = load(path, limit=16 << 20)
if isinstance(data, dict):
    servers(path, data.get("mcpServers"))
    for project, settings in (data.get("projects") or {}).items():
        if isinstance(settings, dict):
            servers(path, settings.get("mcpServers"))
            trusted(path, f"lets Claude Code use tools without asking in {project}", settings.get("allowedTools"))

# Codex
path = f"{HOME}/.codex/config.toml"
data = load(path, "toml")
if isinstance(data, dict):
    if data.get("notify"):
        emit(path, "runs a command when a turn ends", words(data["notify"]))
    servers(path, data.get("mcp_servers"))
    hooks(path, data.get("hooks"))
    if data.get("sandbox_mode") == "danger-full-access" or data.get("default_permissions") == ":danger-full-access":
        off(path, "turns Codex's sandbox off", "danger-full-access")
    if data.get("approval_policy") == "never":
        off(path, "has Codex never ask", "approval_policy never")
    trusted(path, "trusts", [p for p, v in (data.get("projects") or {}).items()
                             if isinstance(v, dict) and v.get("trust_level") == "trusted"])
path = f"{HOME}/.codex/hooks.json"
data = load(path)
if isinstance(data, dict):
    hooks(path, data.get("hooks", data))

# Gemini CLI
path = f"{HOME}/.gemini/settings.json"
data = load(path)
if isinstance(data, dict):
    servers(path, data.get("mcpServers"))
    hooks(path, data.get("hooks"))
    tools = data.get("tools") or {}
    for key in ("discoveryCommand", "callCommand"):
        if isinstance(tools, dict) and tools.get(key):
            emit(path, f"runs a command as tools.{key}", words(tools[key]))
    if isinstance(data.get("mcp"), dict) and data["mcp"].get("serverCommand"):
        emit(path, "runs a command as mcp.serverCommand", words(data["mcp"]["serverCommand"]))
data = load(f"{HOME}/.gemini/trustedFolders.json")
if isinstance(data, dict):
    trusted(f"{HOME}/.gemini/trustedFolders.json", "trusts", [f for f, v in data.items() if v != "DO_NOT_TRUST"])
for path in sorted(glob.glob(f"{HOME}/.gemini/extensions/*/gemini-extension.json")):
    data = load(path)
    if isinstance(data, dict):
        emit(path, "is an extension Gemini CLI loads", data.get("name") or os.path.basename(os.path.dirname(path)))
        servers(path, data.get("mcpServers"))

# Antigravity CLI, which names each group of its hooks: {name: {enabled, Event: [...]}}
path = f"{HOME}/.gemini/antigravity-cli/settings.json"
data = load(path, "jsonc")
if isinstance(data, dict):
    hooks(path, data.get("hooks"))
    for group in (data.get("hooks") or {}).values() if isinstance(data.get("hooks"), dict) else []:
        hooks(path, group)
    for key in ("statusLine", "title"):
        if isinstance(data.get(key), dict) and data[key].get("command"):
            emit(path, f"runs a command as {key}", words(data[key]["command"]))
    if data.get("toolPermission") == "always-proceed":
        off(path, "has Antigravity CLI never ask", "toolPermission always-proceed")
    trusted(path, "trusts", data.get("trustedWorkspaces"))
    if isinstance(data.get("permissions"), dict):
        pre_allowed(path, data["permissions"].get("allow"), r"mcp\(amethystora/([^)]*)\)")
for base in (f"{HOME}/.gemini/config", f"{HOME}/.gemini/antigravity-cli"):
    for path in [f"{base}/hooks.json"] + sorted(glob.glob(f"{base}/plugins/*/hooks.json")):
        data = load(path, "jsonc")
        for group in data.values() if isinstance(data, dict) else []:
            hooks(path, group)
    for path in [f"{base}/mcp_config.json"] + sorted(glob.glob(f"{base}/plugins/*/mcp_config.json")):
        data = load(path, "jsonc")
        if isinstance(data, dict):
            servers(path, data.get("mcpServers"))
    for path in sorted(glob.glob(f"{base}/plugins/*/")):
        emit(path.rstrip("/"), "is a plugin Antigravity CLI loads", os.path.basename(path.rstrip("/")))

# Opencode
for path in (f"{HOME}/.config/opencode/{name}" for name in ("config.json", "opencode.json", "opencode.jsonc")):
    data = load(path, "jsonc")
    if not isinstance(data, dict):
        continue
    for name, server in (data.get("mcp") or {}).items():
        if isinstance(server, dict):
            servers(path, {name: server})
    for plugin in data.get("plugin") or []:
        emit(path, "loads the plugin", plugin)
    permission = data.get("permission")
    if permission == "allow" or (isinstance(permission, dict) and permission.get("*") == "allow"):
        off(path, "has Opencode never ask", "permission allow")
for path in sorted(glob.glob(f"{HOME}/.config/opencode/plugin*/*") + glob.glob(f"{HOME}/.config/opencode/tool*/*")):
    if os.path.isfile(path) and re.search(r"\.(js|ts|mjs)$", path):
        body = read(path) or ""
        emit(path, "is code Opencode loads", hashlib.sha256(body.encode()).hexdigest()[:16])

# Cursor CLI, which reads Claude Code's hooks as well
data = load(f"{HOME}/.cursor/cli-config.json")
if isinstance(data, dict) and data.get("approvalMode") == "unrestricted":
    off(f"{HOME}/.cursor/cli-config.json", "has Cursor run everything without asking", "approvalMode unrestricted")
if isinstance(data, dict) and isinstance(data.get("permissions"), dict):
    pre_allowed(f"{HOME}/.cursor/cli-config.json", data["permissions"].get("allow"), r"Mcp\(amethystora:([^)]*)\)")
data = load(f"{HOME}/.cursor/mcp.json")
if isinstance(data, dict):
    servers(f"{HOME}/.cursor/mcp.json", data.get("mcpServers"))
data = load(f"{HOME}/.cursor/hooks.json")
if isinstance(data, dict):
    hooks(f"{HOME}/.cursor/hooks.json", data.get("hooks"))

# Copilot CLI
data = load(f"{HOME}/.copilot/settings.json")
if isinstance(data, dict):
    hooks(f"{HOME}/.copilot/settings.json", data.get("hooks"))
data = load(f"{HOME}/.copilot/mcp-config.json")
if isinstance(data, dict):
    servers(f"{HOME}/.copilot/mcp-config.json", data.get("mcpServers"))
for path in sorted(glob.glob(f"{HOME}/.copilot/hooks/*.json")):
    data = load(path)
    if isinstance(data, dict):
        hooks(path, data.get("hooks"))
data = load(f"{HOME}/.copilot/config.json")
if isinstance(data, dict):
    trusted(f"{HOME}/.copilot/config.json", "trusts", data.get("trustedFolders") or data.get("trusted_folders"))
PY
}

case "${1:-}" in
    app-permissions) app_permissions ;;
    dev-hooks) dev_hooks ;;
    agent-config) agent_config ;;
    *)
        echo "usage: ${0##*/} app-permissions | dev-hooks | agent-config" >&2
        exit 64
        ;;
esac
