#!/usr/bin/bash
# The monthly Lynis audit (amethystora-lynis-audit.timer), and the comparison that makes it worth
# running unattended.
#
# An audit that writes a report nobody opens tells nobody anything. What matters on a machine whose
# settings ship with the image is not the list of findings, which the image's author already weighed,
# but a finding that was not there last month: something on this machine has changed since.
#
# The first run therefore only records the baseline. Afterwards, anything new is said out loud.

set -uo pipefail

# Marks a message for po/amethystora.pot, as the callers of amethystora-notify-users --msgid do
N_() { printf '%s' "$1"; }
N_n() { printf -v "$1" '%s' "$3"; printf -v "$2" '%s' "$4"; }

REPORT=/var/log/lynis-report.dat
BASELINE=/var/log/amethystora-lynis-baseline.dat

# --cronjob is Lynis's unattended mode: no colours, no prompts, no pager. Findings land in
# /var/log/lynis.log and, one per line, in the report file above.
lynis audit system --cronjob
STATUS=$?

if [[ ! -s "${REPORT}" ]]; then
    echo "Lynis wrote no report (exit ${STATUS}), nothing to compare."
    exit "${STATUS}"
fi

# Lynis appends to the report within a run, so the same warning can appear more than once
warnings() { grep -a '^warning\[\]=' "${1}" 2>/dev/null | sort -u; }

if [[ ! -f "${BASELINE}" ]]; then
    echo "First audit on this machine: recording $(warnings "${REPORT}" | grep -c .) warnings as the"
    echo "baseline. From the next run on, only what is new is reported."
else
    NEW="$(comm -13 <(warnings "${BASELINE}") <(warnings "${REPORT}"))"
    COUNT="$(grep -c . <<<"${NEW}")"
    if [[ "${COUNT}" -gt 0 ]]; then
        echo "${COUNT} warning(s) that were not there at the last audit:"
        printf '%s\n' "${NEW}"
        # Marks the messages for po/amethystora.pot; amethystora-notify-users --msgid translates them
        export COUNT
        N_n SUMMARY PLURAL 'Security audit: ${COUNT} new warning' 'Security audit: ${COUNT} new warnings'
        BODY="$(N_ 'Something on this machine has changed since the last audit. See it with: ame security audit')"
        /usr/libexec/amethystora-notify-users --security --msgid --plural "${PLURAL}" --count "${COUNT}" \
            "${SUMMARY}" "${BODY}" normal
    else
        echo "Nothing new since the last audit."
    fi
fi

cp -f "${REPORT}" "${BASELINE}"
chmod 0600 "${BASELINE}"

exit "${STATUS}"
