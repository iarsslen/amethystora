#!/usr/bin/bash
#
# Amethystora Notes: notes and tasks, kept on this computer only and encrypted with a passphrase.
#
#   amethystora-notes          open it
#   amethystora-notes tasks    open it on the tasks
#
# Nothing is synced and nothing leaves the machine. The notes are in ~/.local/share/amethystora-notes.
# The window is an Electron app in /usr/lib/amethystora-notes (build_files/base/16-notes.sh).

set -euo pipefail

case "${1:-}" in
    -h | --help | help) sed -n '3,9p' "$0" | sed 's/^# \?//' ;;
    *) exec /usr/lib/amethystora-notes/amethystora-notes "$@" ;;
esac
