#!/usr/bin/bash
#
# Web apps: a site in a window of its own, without tabs or toolbar, with a launcher in the app grid.
# They open in the default browser when it is Chromium-based or Firefox-based, which on an unchanged
# Amethystora is Firefox, and otherwise in a browser on the machine that is.
#
#   amethystora-webapp <url> [flags]         open the URL as a web app
#   amethystora-webapp install [name url [icon]]
#                                            add a launcher; without arguments it asks. The icon is
#                                            a URL, a file or an icon name, and without one the
#                                            site's own is fetched
#   amethystora-webapp remove [name]         remove a launcher; without a name it asks
#   amethystora-webapp list [--json]         the web apps installed, each name and address
#
# Adapted from omarchy-launch-webapp, omarchy-webapp-install and omarchy-webapp-remove
# (https://github.com/basecamp/omarchy), MIT licensed; the licence is at the end of this file.

set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
DESKTOP_DIR="${DATA_HOME}/applications"
ICON_DIR="${DATA_HOME}/icons/hicolor/256x256/apps"
# Launchers and icons are named after this, which is how remove tells them from other apps
PREFIX=amethystora-webapp
APP_DIRS=("${DESKTOP_DIR}" "${DATA_HOME}/flatpak/exports/share/applications"
    /var/lib/flatpak/exports/share/applications /usr/share/applications)

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}

# --- Browser ----------------------------------------------------------------------------------

desktop_file() {
    local dir
    for dir in "${APP_DIRS[@]}"; do
        if [[ -f "${dir}/$1" ]]; then
            printf '%s\n' "${dir}/$1"
            return 0
        fi
    done
    return 1
}

# The engine of a browser, from the name of its desktop file. These are the two that can give a site
# a window of its own: Chromium has --app, and Firefox is started on a profile that hides its tabs
# and toolbar. The names are narrow enough to pass over the launchers a Chromium browser writes for
# web apps installed from its own menu (brave-<id>-Default.desktop).
engine() {
    case "${1##*/}" in
        brave-browser* | com.brave.* | google-chrome* | com.google.Chrome* | chromium* | \
            org.chromium.* | io.github.ungoogled_software.* | microsoft-edge* | \
            com.microsoft.Edge* | vivaldi-stable* | vivaldi-snapshot* | com.vivaldi.* | opera*)
            echo chromium
            ;;
        firefox* | org.mozilla.firefox* | librewolf* | io.gitlab.librewolf-community* | \
            zen.desktop | zen-browser* | app.zen_browser.* | floorp* | one.ablaze.floorp* | \
            waterfox* | net.waterfox.*)
            echo firefox
            ;;
    esac
}

# Sets BROWSER, the desktop file of the browser web apps open in, and ENGINE: the default browser
# when it is one engine() knows, or else the first installed that is, Chromium before Firefox. Both
# are left empty when there is none, and the site then opens the way any link does.
find_browser() {
    local dir default
    default="$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null || true)"
    BROWSER="$(desktop_file "${default}" || true)"
    ENGINE="$(engine "${BROWSER}")"
    [[ -z ${ENGINE} ]] || return 0
    for ENGINE in chromium firefox; do
        for dir in "${APP_DIRS[@]}"; do
            for BROWSER in "${dir}"/*.desktop; do
                [[ -f ${BROWSER} && $(engine "${BROWSER}") == "${ENGINE}" ]] && return 0
            done
        done
    done
    BROWSER="" ENGINE=""
}

# The whole Exec line rather than its first word, which for a Flatpak is /usr/bin/flatpak. Field
# codes and Flatpak's @@ file-forwarding markers are dropped, since the URL is passed separately.
browser_command() {
    local word
    local -a words
    read -ra words <<<"$(sed -n 's/^Exec=//p' "${BROWSER}" | head -1)"
    for word in "${words[@]}"; do
        [[ ${word} =~ ^(%[a-zA-Z]|@@[uf]?)$ ]] || printf '%s\n' "${word}"
    done
}

# What a Firefox web app is called, as its window class and as the directory of its profile: the
# address without its scheme and query, so https://app.hey.com/ is amethystora-webapp-app.hey.com_
firefox_name() {
    printf '%s-%s\n' "${PREFIX}" "$(sed -E 's|^[a-z]+://||; s|[?#].*||' <<<"${1,,}")" |
        tr -c 'a-z0-9._\n-' '_'
}

# Firefox has no --app. A web app is a window of a profile of its own, which hides the tabs and the
# toolbar and so does not share the browser's sign-ins. A Flatpak sees no directory but its own.
# Prints the profile's directory, creating it on first use.
firefox_profile() {
    local flatpak dir
    flatpak="$(sed -n 's/^X-Flatpak=//p' "${BROWSER}" | head -1)"
    dir="${flatpak:+${HOME}/.var/app/${flatpak}/data}"
    dir="${dir:-${DATA_HOME}}/${PREFIX}/$1"
    if [[ ! -f ${dir}/user.js ]]; then
        mkdir -p "${dir}/chrome"
        echo '#navigator-toolbox { visibility: collapse !important; }' >"${dir}/chrome/userChrome.css"
        # Read userChrome.css, keep the title bar the toolbar would have held, open a link meant
        # for a new tab in a new window, and skip what a new profile shows on its first start
        cat >"${dir}/user.js" <<'EOF'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.tabs.inTitlebar", 0);
user_pref("browser.link.open_newwindow", 2);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
EOF
    fi
    printf '%s\n' "${dir}"
}

# The window class of a web app, which GNOME matches against StartupWMClass to show the launcher's
# name and icon instead of the browser's. Chromium gives an --app window <program>-<host>_<path>-
# <profile>, with the path's slashes turned into underscores, so https://app.hey.com/ is
# brave-app.hey.com__-Default; the program is chrome for every build that does not rename it.
wm_class() {
    local program host path
    if [[ ${ENGINE} == firefox ]]; then
        firefox_name "$1"
        return 0
    fi
    case "${BROWSER##*/}" in
        google-chrome* | com.google.Chrome* | chromium* | org.chromium.* | \
            io.github.ungoogled_software.*) program=chrome ;;
        microsoft-edge* | com.microsoft.Edge*) program=msedge ;;
        vivaldi* | com.vivaldi.*) program=vivaldi ;;
        opera*) program=opera ;;
        *) program=brave ;;
    esac
    host="$(sed -E 's|^[a-zA-Z]+://([^/?#:]+).*|\1|' <<<"$1")"
    path="$(sed -E 's|^[a-zA-Z]+://[^/?#]+([^?#]*).*|\1|' <<<"$1")"
    printf '%s-%s_%s-Default\n' "${program}" "${host,,}" "${path:-/}" | tr '/' '_'
}

# --- URLs -------------------------------------------------------------------------------------

# --app= runs javascript:, file: and data: as a document, so anything but http(s) is refused.
# Input without a scheme gets https.
normalize_url() {
    local url="$1"
    [[ ${url} =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://${url}"
    [[ ! ${url} =~ [[:space:]] ]] || die "a web app URL cannot contain whitespace"
    [[ ${url,,} =~ ^https?:// ]] || die "a web app URL has to be http or https: ${url}"
    printf '%s\n' "${url}"
}

# --- Desktop entries --------------------------------------------------------------------------

slug() {
    tr '[:upper:]\n' '[:lower:] ' <<<"$1" | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'
}

# A Desktop Entry string value: a raw newline would start a new key and let a name inject an Exec=
desktop_string() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//$'\t'/\\t}
    value=${value//$'\r'/\\r}
    value=${value//$'\n'/\\n}
    [[ ${value} == " "* ]] && value="\\s${value# }"
    printf '%s' "${value}"
}

# One quoted Exec argument, where " ` $ \ take a backslash and % is doubled
desktop_exec_arg() {
    printf '"%s"' "$(sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' \
        -e 's/%/%%/g' <<<"$1")"
}

# The launchers this script made, as "name<TAB>file"
webapps() {
    local file
    for file in "${DESKTOP_DIR}/${PREFIX}"-*.desktop; do
        [[ -f ${file} ]] || continue
        printf '%s\t%s\n' "$(sed -n 's/^Name=//p' "${file}" | head -1)" "${file}"
    done
}

# --- Icons ------------------------------------------------------------------------------------

download_icon() {
    curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
        [[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

# The site's own apple-touch-icon (180px or more), then the well-known path
fetch_site_icon() {
    local origin page icon
    origin="$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$1")"
    page="$(curl -fsSL --max-time 5 "$1" 2>/dev/null | head -c 100000 | tr '\n' ' ' || true)"
    icon="$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"${page}" |
        grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//" || true)"
    case "${icon}" in
        http://* | https://*) ;;
        //*) icon="https:${icon}" ;;
        /*) icon="${origin}${icon}" ;;
        ?*) icon="${origin}/${icon}" ;;
    esac
    { [[ -n ${icon} ]] && download_icon "${icon}" "$2"; } ||
        download_icon "${origin}/apple-touch-icon.png" "$2"
}

# Prints the Icon= value for the reference given: a downloaded or copied file, or an icon name
install_icon() {
    local ref="$1" url="$2" name="$3"
    local dest="${ICON_DIR}/${name}.png"
    mkdir -p "${ICON_DIR}"
    if [[ -z ${ref} ]]; then
        if ! fetch_site_icon "${url}" "${dest}"; then
            echo "Could not fetch the site's icon, using a generic one." >&2
            printf 'web-browser\n'
            return 0
        fi
    elif [[ ${ref} =~ ^https?:// ]]; then
        download_icon "${ref}" "${dest}" || die "could not download the icon: ${ref}"
    elif [[ -f ${ref} ]]; then
        cp "${ref}" "${dest}"
    else
        printf '%s\n' "${ref}"
        return 0
    fi
    gtk-update-icon-cache "${DATA_HOME}/icons/hicolor" &>/dev/null || true
    printf '%s\n' "${name}"
}

# --- Commands ---------------------------------------------------------------------------------

# A launcher carries the window class of the browser it was installed with. Opened by another, its
# StartupWMClass is brought up to date, so that the window still goes by the launcher's name and icon.
update_launcher() {
    local file="${GIO_LAUNCHED_DESKTOP_FILE:-}" line
    [[ ${file} == "${DESKTOP_DIR}/${PREFIX}"-*.desktop && -f ${file} &&
        ${GIO_LAUNCHED_DESKTOP_FILE_PID:-} == "$$" ]] || return 0
    line="StartupWMClass=$(desktop_string "$1")"
    grep -qxF -e "${line}" "${file}" && return 0
    sed -i '/^StartupWMClass=/d' "${file}"
    printf '%s\n' "${line}" >>"${file}"
}

launch_webapp() {
    local url class profile
    local -a command
    url="$(normalize_url "$1")"
    find_browser
    [[ -n ${BROWSER} ]] || exec xdg-open "${url}"
    mapfile -t command < <(browser_command)
    ((${#command[@]})) || die "${BROWSER} has no command to start it with"
    class="$(wm_class "${url}")"
    update_launcher "${class}"
    if [[ ${ENGINE} == firefox ]]; then
        profile="$(firefox_profile "${class}")"
        exec setsid "${command[@]}" --name "${class}" --class "${class}" --profile "${profile}" \
            "${@:2}" "${url}"
    fi
    exec setsid "${command[@]}" --app="${url}" "${@:2}"
}

install_webapp() {
    local name url icon_ref id file icon
    if (($# == 0)); then
        name="$(gum input --prompt "Name> " --placeholder "My favourite web app")"
        url="$(gum input --prompt "URL> " --placeholder "https://example.com")"
        icon_ref="$(gum input --prompt "Icon> " \
            --placeholder "Icon URL, file or name; empty uses the site's own")"
    elif (($# >= 2)); then
        name="$1" url="$2" icon_ref="${3:-}"
    else
        die "usage: ${0##*/} install [name url [icon]]"
    fi
    [[ -n ${name} && -n ${url} ]] || die "a web app needs a name and a URL"
    url="$(normalize_url "${url}")"
    id="$(slug "${name}")"
    [[ -n ${id} ]] || die "the name needs at least one letter or digit: ${name}"
    file="${DESKTOP_DIR}/${PREFIX}-${id}.desktop"
    icon="$(install_icon "${icon_ref}" "${url}" "${PREFIX}-${id}")"
    find_browser

    mkdir -p "${DESKTOP_DIR}"
    cat >"${file}" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_string "${name}")
Comment=$(desktop_string "${url}")
Exec=$(desktop_string "${PREFIX} $(desktop_exec_arg "${url}")")
Icon=$(desktop_string "${icon}")
StartupWMClass=$(desktop_string "$(wm_class "${url}")")
StartupNotify=true
Terminal=false
EOF
    echo "${name} is in the app grid."
}

remove_webapp() {
    local name file profile entry entry_name entry_file
    local -a entries
    mapfile -t entries < <(webapps | sort)
    ((${#entries[@]})) || die "there are no web apps to remove"
    if (($# == 0)); then
        name="$(printf '%s\n' "${entries[@]}" | cut -f1 | gum choose --header "Remove a web app")" ||
            exit 0
    else
        name="$*"
    fi
    for entry in "${entries[@]}"; do
        IFS=$'\t' read -r entry_name entry_file <<<"${entry}"
        [[ ${entry_name} == "${name}" ]] && file="${entry_file}"
    done
    [[ -n ${file:-} ]] || die "no web app called ${name}"
    # The Firefox profile, if it ever opened in one, goes with it; Comment= is the address
    profile="${PREFIX}/$(firefox_name "$(sed -n 's/^Comment=//p' "${file}" | head -1)")"
    rm -rf "${DATA_HOME:?}/${profile}" "${HOME}"/.var/app/*/data/"${profile}"
    rm -f "${file}" "${ICON_DIR}/$(basename "${file%.desktop}").png"
    notify-send --app-name="Web apps" "Web app removed" "${name}" 2>/dev/null || true
    echo "${name} removed."
}

# Each web app's name, as remove takes it, and its address (Comment=); with --json, for Amethystora Control
list_webapps() {
    local name file address
    while IFS=$'\t' read -r name file; do
        address="$(sed -n 's/^Comment=//p' "${file}" | head -1)"
        if [[ ${1:-} == --json ]]; then
            jq -nc --arg name "${name}" --arg address "${address}" '{$name, $address}'
        else
            printf '%s\t%s\n' "${name}" "${address}"
        fi
    done < <(webapps | sort)
}

case "${1:-}" in
    install) install_webapp "${@:2}" ;;
    remove) remove_webapp "${@:2}" ;;
    list)
        if [[ ${2:-} == --json ]]; then
            list_webapps --json | jq -sc .
        else
            list_webapps
        fi
        ;;
    "" | -h | --help | help) sed -n '3,14p' "$0" | sed 's/^# \?//' ;;
    *) launch_webapp "$@" ;;
esac

