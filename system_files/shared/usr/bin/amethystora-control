#!/usr/bin/bash
#
# Amethystora Control: Amethystora's own settings outside security, in a window of their own.
#
#   amethystora-control          open it
#   amethystora-control <page>   open it on appearance, desktop, apps, agent, system or setup
#
# What it lists is /usr/libexec/amethystora-control-list, which `ame control` prints in a terminal, and
# every change it makes is the `ame` command that list names. The window is an Electron app in
# /usr/lib/amethystora-control (build_files/base/16-control.sh).

set -euo pipefail

case "${1:-}" in
    -h | --help | help) sed -n '3,10p' "$0" | sed 's/^# \?//' ;;
    *) exec /usr/lib/amethystora-control/amethystora-control "$@" ;;
esac
