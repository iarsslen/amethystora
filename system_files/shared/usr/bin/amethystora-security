#!/usr/bin/bash
#
# Amethystora Security: the security report and a virus scanner, in a window of their own.
#
#   amethystora-security          open it on the report
#   amethystora-security scan     open it on the virus scanner
#
# The report is /usr/libexec/amethystora-security-status, which `ame security status` prints in a
# terminal. The window is a GTK program, one with the other Amethystora apps (apps/, 13-apps.sh).

set -euo pipefail

case "${1:-}" in
    -h | --help | help) sed -n '3,10p' "$0" | sed 's/^# \?//' ;;
    *) exec /usr/lib/amethystora-security/amethystora-security "$@" ;;
esac
