#!/usr/bin/bash
#
#   amethystora-rollback-helper [IMAGE [STREAM]]   (ame system rebase)
#   amethystora-rollback-helper --choices          the images and streams it offers, and the current
#                                                  ones, as JSON, for Amethystora Control
#
# An IMAGE and STREAM given are the ones the menus open on, which is how the NVIDIA check and
# `ame restore-setup` point at the image they mean. Nothing is switched before the last question.

IMAGE_INFO="/usr/share/amethystora/image-info.json"
IMAGE_NAME="$(jq -r '."image-name"' < "$IMAGE_INFO")"
IMAGE_TAG="$(jq -r '."image-tag"' < "$IMAGE_INFO")"
IMAGE_VENDOR="$(jq -r '."image-vendor"' < "$IMAGE_INFO")"
IMAGE_REGISTRY="ghcr.io/${IMAGE_VENDOR}"

IMAGES=(amethystora amethystora-dx amethystora-nvidia-open amethystora-dx-nvidia-open amethystora-nvidia-lts
  amethystora-dx-nvidia-lts)
if [[ -e /usr/share/amethystora/sealed ]] ; then
  # A sealed machine follows sealed images only: an ostree image cannot start from its disk, and the
  # way back is a reinstall from the ISO (the manual's updates.md, Sealed images)
  CHANNELS=(stable-sealed)
else
  CHANNELS=(stable stable-daily latest)
fi

if [[ "${1:-}" == --choices ]] ; then
  jq -n --arg image "${IMAGE_NAME}" --arg stream "${IMAGE_TAG}" \
    --argjson images "$(printf '%s\n' "${IMAGES[@]}" | jq -R . | jq -sc .)" \
    --argjson streams "$(printf '%s\n' "${CHANNELS[@]}" | jq -R . | jq -sc .)" \
    '{$image, $stream, $images, $streams}'
  exit 0
fi

PRESET_IMAGE="${1:-}"
PRESET_STREAM="${2:-}"

echo -ne "Current image: ${IMAGE_NAME}:${IMAGE_TAG}\n"
IMAGE_NAME="$(gum choose --header="Select your image:" --selected="${PRESET_IMAGE:-${IMAGE_NAME}}" "${IMAGES[@]}" cancel)"
[[ "$IMAGE_NAME" == "cancel" || "$IMAGE_NAME" == "" ]] && exit 0

# With Secure Boot on, the kernel refuses NVIDIA's driver until the key it is signed with is enrolled, and the
# NVIDIA images turn off the drivers that would draw the screen without it: switching first would start the
# machine to a black screen. The key is enrolled at a restart, through the blue MOK manager screen.
if [[ "${IMAGE_NAME}" == *nvidia* ]] && mokutil --sb-state 2>/dev/null | grep -qi enabled &&
  /usr/libexec/amethystora-mok-status | grep -q "^not-enrolled .*/akmods-amethystora\.der$" ; then
  echo "Secure Boot is on, and the key NVIDIA's driver is signed with is not enrolled yet: ${IMAGE_NAME}"
  echo "would start to a black screen. Enroll it first (ame security secure-boot), restart through the blue"
  echo "MOK manager screen, then switch."
  gum confirm "Enroll the keys now?" && ame security secure-boot
  exit 1
fi

base_image="${IMAGE_REGISTRY}/${IMAGE_NAME}"
if [[ -e /usr/share/amethystora/sealed ]] ; then
  echo "This machine is sealed, so it can follow the sealed stream only"
else
  echo "The default selection is stable (weekly builds) and stable-daily (daily builds) are for enthusiasts, and latest is for testers"
fi

channel_choice="$(gum choose --selected="${PRESET_STREAM:-${IMAGE_TAG}}" "${CHANNELS[@]}" cancel)"
[[ "$channel_choice" == "cancel" || "$channel_choice" == "" ]] && exit 0
channel_selected=${channel_choice%% *}

# Always the stream's own tag: a dated one (latest-20261017) names a single build, and a machine
# switched to it would pull that same build at every update, forever
rebase_target="${base_image}:${channel_selected}"

gum confirm "Confirm rebase to ${rebase_target}?" || exit 1

# A sealed image has neither rpm-ostree nor its configuration
if [[ -e /usr/share/amethystora/sealed ]] || grep -q "^LockLayering=true" /etc/rpm-ostreed.conf; then
  pkexec bootc switch --enforce-container-sigpolicy "${rebase_target}"
else
  rpm-ostree rebase ostree-image-signed:docker://"${rebase_target}"
fi
