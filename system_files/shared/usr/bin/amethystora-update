#!/usr/bin/bash
#
# Amethystora Updates: the system, the apps and the command-line tools brought up to date, in a window
# of its own, with a restart offered once a new system is ready.
#
#   amethystora-update     open it
#
# "Update now" runs uupd-manual.service, the updater of the automatic updates, which updates what
# `ujust update` does in a terminal. The window is an Electron app in /usr/lib/amethystora-update
# (build_files/base/15-update.sh).

set -euo pipefail

case "${1:-}" in
    -h | --help | help) sed -n '3,10p' "$0" | sed 's/^# \?//' ;;
    *) exec /usr/lib/amethystora-update/amethystora-update "$@" ;;
esac
