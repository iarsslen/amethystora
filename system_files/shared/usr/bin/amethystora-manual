#!/usr/bin/bash
#
# The Amethystora Manual, in a window of its own (Super+F1).
#
#   amethystora-manual                 open it where you left off
#   amethystora-manual <page>          open a page by its file name: updates, keybindings, ...
#   amethystora-manual <page>#<part>   and go to a section of it: updates#rolling-back
#   amethystora-manual --list          the pages there are
#
# The pages are the Markdown files in /usr/share/amethystora/manual, listed in pages.json. The
# window is a GTK program, one with the other Amethystora apps (apps/, build_files/base/13-apps.sh).

set -euo pipefail

MANUAL=/usr/share/amethystora/manual

case "${1:-}" in
    -h | --help | help) sed -n '3,11p' "$0" | sed 's/^# \?//' ;;
    -l | --list) jq -r '.[].pages[] | sub("^.*/"; "") | sub("\\.md$"; "")' "${MANUAL}/pages.json" ;;
    *) exec /usr/lib/amethystora-manual/amethystora-manual "$@" ;;
esac
