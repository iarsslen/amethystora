#!/usr/bin/env bash

# SCRIPT VERSION
GROUP_SETUP_VER=3
GROUP_SETUP_VER_FILE="/etc/amethystora/dx-groups"
GROUP_SETUP_VER_RAN=$(cat "$GROUP_SETUP_VER_FILE")

# make the directory if it doesn't exist
mkdir -p /etc/amethystora

# Run script if updated
if [[ -f $GROUP_SETUP_VER_FILE && "$GROUP_SETUP_VER" = "$GROUP_SETUP_VER_RAN" ]]; then
  echo "Group setup has already run. Exiting..."
  exit 0
fi

# Function to append a group entry to /etc/group, and its shadow entry to /etc/gshadow
append_group() {
  local group_name="$1"
  if ! grep -q "^$group_name:" /etc/group; then
    echo "Appending $group_name to /etc/group"
    grep "^$group_name:" /usr/lib/group | tee -a /etc/group >/dev/null
  fi
  # A group without its /etc/gshadow line is an error to grpck, and usermod leaves the membership out
  # of that file. Version 3 adds the lines versions 1 and 2 left out; usermod below fills them in.
  if grep -q "^$group_name:" /etc/group && ! grep -q "^$group_name:" /etc/gshadow; then
    echo "Appending $group_name to /etc/gshadow"
    echo "$group_name:!::" >>/etc/gshadow
  fi
}

# Setup Groups
append_group docker
append_group incus-admin
append_group libvirt
append_group wireshark

wheelarray=($(getent group wheel | cut -d ":" -f 4 | tr ',' '\n'))
for user in "${wheelarray[@]}"; do
  usermod -aG docker $user
  usermod -aG incus-admin $user
  usermod -aG libvirt $user
  usermod -aG wireshark $user
done

# Prevent future executions
echo "Writing state file"
echo "$GROUP_SETUP_VER" >"$GROUP_SETUP_VER_FILE"
