*.yml linguist-detectable=true
*.yml linguist-language=YAML

*.yaml linguist-detectable=true
*.yaml linguist-language=YAML

*.just linguist-detectable=true
*.just linguist-documentation=false
*.just linguist-language=Just

*.json linguist-detectable=true
*.json linguist-documentation=false
*.json linguist-language=JSON

*.der binary

# The pointers are Xcursor files (branding/cursors.mjs)
system_files/shared/usr/share/icons/amethystora-pointer-*/cursors/* binary
# ...and their alias table is read by the build line by line, which a carriage return would break
system_files/shared/usr/share/icons/amethystora-pointer-*/aliases text eol=lf

# Patches apply byte for byte, so git leaves their line endings alone
packaging/**/*.patch -text
