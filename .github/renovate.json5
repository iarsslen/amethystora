{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "git-submodules": {
    "enabled": true
  },

  // Renovate cannot touch a branch that has been manually edited, which
  // silently stalls the dependency for months. Keep its own branches current
  // instead of hand-merging main into them.
  "rebaseWhen": "behind-base-branch",

  // extensions.gnome.org's answer for an extension: the upload for the GNOME
  // the image ships (GNOME 50 on Fedora 44; move it with the Fedora version)
  customDatasources: {
    'extensions-gnome-org': {
      defaultRegistryUrlTemplate: 'https://extensions.gnome.org/extension-info/?uuid={{packageName}}&shell_version=50',
      transformTemplates: [
        '{"releases": [{"version": $string(version_tag)}]}',
      ],
    },
  },

    customManagers: [
    // The base images in image-versions.yml, each pinned by digest under its
    // tag. bump-base-images.yml proposes the same updates daily, verified
    // against Universal Blue's key; whichever is merged first, the other
    // finds nothing left to do.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^image-versions\\.yml$/',
      ],
      matchStrings: [
        'image: (?<depName>\\S+)\\s+tag: "?(?<currentValue>[^"\\s]+)"?\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
      depTypeTemplate: 'base-image',
    },
    // The extensions.gnome.org uploads build-gnome-extensions.sh installs,
    // by upload id. Only the calls at the top of the script: Space Bar's
    // are pinned per GNOME, inside a test of the GNOME version, by hand.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/shared/build-gnome-extensions\\.sh$/',
      ],
      matchStrings: [
        '\\ninstall_ego_extension "(?<depName>[^"]+)" \\d+ (?<currentValue>\\d+) ',
      ],
      datasourceTemplate: 'custom.extensions-gnome-org',
      versioningTemplate: 'loose',
      depTypeTemplate: 'gnome-extension-upload',
    },
    // The Syft release reusable-build.yml makes the SBOM with
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/reusable-build\\.yml$/',
      ],
      matchStrings: [
        'syft-version: (?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'anchore/syft',
      datasourceTemplate: 'github-releases',
    },
    // The just release the workflows install (.github/actions/install-just),
    // with the SHA-256 of its tarball, which this datasource works out for the
    // new release
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/actions/install-just/action\\.yml$/',
      ],
      matchStrings: [
        'JUST_VERSION: (?<currentValue>\\S+)\\s+JUST_SHA256: (?<currentDigest>[a-f0-9]{64})',
      ],
      depNameTemplate: 'casey/just',
      datasourceTemplate: 'github-release-attachments',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '(?<justName>.+?)\\s:=\\s"(?<packageName>\\S+):(?<currentValue>\\S+)@(?<currentDigest>sha256:[a-f0-9]+?)"',
      ],
      datasourceTemplate: 'docker',
    },
    // Track GNOME extension submodules that pin to a release tag via the
    // `branch =` field in .gitmodules. Renovate's git-submodules manager
    // alone can't see new tags because tags don't move; this rewrites the
    // `branch =` line and the git-submodules manager then advances the SHA.
    // Uses github-tags (not github-releases) because some upstreams ship
    // git tags without publishing GitHub Releases (e.g. caffeine).
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.gitmodules$/',
      ],
      matchStringsStrategy: 'recursive',
      matchStrings: [
        '\\[submodule "[^"]+"\\][^\\[]*?url\\s*=\\s*https?://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+?)(?:\\.git)?\\s[^\\[]*?branch\\s*=\\s*(?<currentValue>\\S*v\\d+\\S*)',
      ],
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'loose',
      depTypeTemplate: 'gnome-extension',
    },
    // The candy-icons commit 10-icons.sh installs the icon theme from. Upstream
    // publishes no tags or releases, so the pin is a commit on master and
    // git-refs advances it. Not automerged: the script asserts that the icons
    // its aliases point at still exist, and that check runs in the PR build.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/base/10-icons\\.sh$/',
      ],
      matchStrings: [
        'CANDY_COMMIT="(?<currentDigest>[a-f0-9]{40})"',
      ],
      depNameTemplate: 'EliverLara/candy-icons',
      packageNameTemplate: 'https://github.com/EliverLara/candy-icons',
      currentValueTemplate: 'master',
      datasourceTemplate: 'git-refs',
    },
    // The Sweet commit 11-gtk-theme.sh builds the GTK theme from, pinned the same
    // way and for the same reason as candy-icons above. Not automerged either:
    // recolor.py rewrites the stylesheets, and the --check in 20-tests.sh only
    // proves the new ones were recoloured in the PR build.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/base/11-gtk-theme\\.sh$/',
      ],
      matchStrings: [
        'SWEET_COMMIT="(?<currentDigest>[a-f0-9]{40})"',
      ],
      depNameTemplate: 'EliverLara/Sweet',
      packageNameTemplate: 'https://github.com/EliverLara/Sweet',
      currentValueTemplate: 'master',
      datasourceTemplate: 'git-refs',
    },
    // The Electron release and the marked version 13-manual.sh builds the
    // Amethystora Manual from. Not automerged: 20-tests.sh starts the new
    // Electron and checks every page, and that runs in the PR build.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/base/13-manual\\.sh$/',
      ],
      matchStrings: [
        'ELECTRON_VERSION="(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'electron/electron',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/base/13-manual\\.sh$/',
      ],
      matchStrings: [
        'MARKED_VERSION="(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'marked',
      datasourceTemplate: 'npm',
    },
    // The images amethystora-pkg's built-in templates start from, each pinned
    // by digest. The pins ship in the signed image, which is what makes a
    // container made from one start from exactly the image they name, so they
    // follow their tags here rather than on the machine.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^system_files/shared/usr/share/amethystora/pkg/(aur/)?templates/[^/]+\\.json$/',
      ],
      matchStrings: [
        '"base": "(?<depName>[^":@]+):(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: 'docker',
      depTypeTemplate: 'pkg-template',
    },
    // The Starship release 05-override-install.sh installs the shell prompt
    // from, with the SHA-256 of its tarball pinned beside it, which this
    // datasource works out for the new tag, as for OpenTabletDriver below.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^build_files/base/05-override-install\\.sh$/',
      ],
      matchStrings: [
        'STARSHIP_TAG="(?<currentValue>v[^"]+)"\\s+STARSHIP_SHA256="(?<currentDigest>[a-f0-9]{64})"',
      ],
      depNameTemplate: 'starship/starship',
      datasourceTemplate: 'github-release-attachments',
    },
    // The OpenTabletDriver release `ame apps opentabletdriver` takes the udev
    // rules from, on the user's machine, with the SHA-256 of the tarball it
    // downloads: OpenTabletDriver publishes no checksum file, so the digest is
    // the attachment's own, which this datasource works out for the new tag.
    // Not automerged: what the rules let the tablet reach goes into /etc.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^system_files/shared/usr/share/amethystora/just/apps\\.just$/',
      ],
      matchStrings: [
        'OTD_TAG="(?<currentValue>v[^"]+)"\\s+OTD_SHA256="(?<currentDigest>[a-f0-9]{64})"',
      ],
      depNameTemplate: 'OpenTabletDriver/OpenTabletDriver',
      datasourceTemplate: 'github-release-attachments',
    },
    // The Renovate image validate-renovate.yml checks this file with, pinned
    // by digest so that the check runs exactly the release named there.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/validate-renovate\\.yml$/',
      ],
      matchStrings: [
        'RENOVATE_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
    ],

  // Everything Renovate may merge by itself waits three days after its
  // release first, digests included, so that a release pulled for being
  // compromised is pulled before it ships: a merge to main is published by
  // the next scheduled stable build.
  "packageRules": [
    {
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"]
    },
    {
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "matchPackageNames": ["ghcr.io/jasonn3/build-container-installer"],
      "automerge": false
    },
    {
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "matchUpdateTypes": ["digest"],
      "matchDepNames": [
        "ghcr.io/ublue-os/silverblue-main"
      ]
    },
    // image-versions.yml pins one base per Fedora version: an entry follows
    // its tag's digest, and a new Fedora is a new entry, added by hand
    {
      "matchDepTypes": ["base-image"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    // cosign-installer stays on v3. v4 installs cosign v3, which stores
    // signatures as OCI referrers, while every machine checks updates with
    // use-sigstore-attachments (policy.json): they would refuse every update.
    {
      "matchPackageNames": ["sigstore/cosign-installer"],
      "allowedVersions": "<4"
    },
    // candy-icons, Sweet and the extensions.gnome.org uploads are pinned
    // with the SHA-256 of what is downloaded, which Renovate cannot work out
    // for these. Their updates are listed on the Dependency Dashboard rather
    // than opened as pull requests whose build would fail; the pin and its
    // checksum are bumped together on main, by hand, and Renovate then drops
    // the update.
    {
      "matchDepNames": ["EliverLara/candy-icons", "EliverLara/Sweet"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDepTypes": ["gnome-extension-upload"],
      "dependencyDashboardApproval": true
    },
    {
      "matchDepTypes": ["gnome-extension"],
      "matchPackageNames": ["micheleg/dash-to-dock"],
      "versioning": "regex:^extensions\\.gnome\\.org-v(?<major>\\d+)$"
    },
    {
      "matchDepTypes": ["gnome-extension"],
      "groupName": "GNOME extensions"
    },
    // A template follows its tag's digest. Moving it to the next release
    // (Debian 14, Fedora 45) changes what the template is, and its
    // description with it, so that is done by hand.
    {
      "matchDepTypes": ["pkg-template"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "matchDepTypes": ["pkg-template"],
      "groupName": "amethystora-pkg templates"
    }
  ]
}
