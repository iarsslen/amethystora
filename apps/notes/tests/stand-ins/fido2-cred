#!/usr/bin/python3
# A stand-in for libfido2's fido2-cred, for the passkey tests: it checks that Notes makes a credential exactly as
# main.js made one (fido2-cred -M -h -c 3 [-v] DEVICE, credProtect level 3 always, then the client data hash,
# the relying party, the account's name and a user id on stdin, and the PIN when it prompts for one, or -v
# for a fingerprint) and prints what a key would, the credential's id on the fifth line. The credential is
# added to config.json, so that fido2-assert knows it from then on.
import base64
import hashlib
import json
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
path = os.path.join(here, 'config.json')
with open(path) as file:
    config = json.load(file)
args = sys.argv[1:]
with open(os.path.join(here, 'calls.log'), 'a') as log:
    log.write(json.dumps({'tool': 'fido2-cred', 'args': args}) + '\n')


def fail(message):
    sys.stderr.write(message + '\n')
    sys.exit(1)


if args not in (['-M', '-h', '-c', '3', config['device']], ['-M', '-h', '-c', '3', '-v', config['device']]):
    fail('usage: fido2-cred -M [-bdhqruv] [-c cred_protect] [-i input_file] [-o output_file] device [type]')
lines = [sys.stdin.readline() for _ in range(4)]
if not all(line.endswith('\n') for line in lines):
    fail('fido2-cred: input: missing lines')
cdh, rp, user, user_id = (line[:-1] for line in lines)
if len(base64.b64decode(cdh)) != 32 or rp != 'amethystora-notes' or not user or len(base64.b64decode(user_id)) != 16:
    fail('fido2-cred: input: invalid')
if '-v' in args:
    if not config.get('uv'):
        fail('fido2-cred: fido_dev_make_cred: FIDO_ERR_UNSUPPORTED_OPTION')
else:
    sys.stderr.write('Enter PIN for %s: ' % config['device'])
    sys.stderr.flush()
    pin = sys.stdin.readline()
    if pin[:-1] != config['pin']:
        fail('fido2-cred: fido_dev_make_cred: FIDO_ERR_PIN_INVALID')
credential = base64.b64encode(hashlib.sha256(user_id.encode()).digest()).decode()
config['credentials'][credential] = None
config['made'] = {'user': user, 'credential': credential}
with open(path, 'w') as file:
    json.dump(config, file)
print(cdh)
print(rp)
print('packed')
print(base64.b64encode(b'authenticator data').decode())
print(credential)
print(base64.b64encode(b'signature').decode())
print(base64.b64encode(b'certificate').decode())
