msgstr ""
"Project-Id-Version: amethystora\n"
"Report-Msgid-Bugs-To: https://github.com/iarsslen/amethystora/issues\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: usr/libexec/amethystora-security-status
msgid "Updates and boot"
msgstr "Actualizaciones y arranque"

#: usr/libexec/amethystora-security-status
msgid "Watching"
msgstr "Vigilancia"

#: usr/libexec/amethystora-security-status
msgid "Apps"
msgstr "Aplicaciones"

#: usr/libexec/amethystora-security-status
msgid "Scans"
msgstr "Análisis"

#: usr/libexec/amethystora-security-status
msgid "Off unless you turned it on"
msgstr "Desactivado salvo que lo haya activado"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title} is on (${COMMAND})"
msgstr "${title}: activado (${COMMAND})"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${title}: ${COMMAND} (${reason})"
msgstr "${title}: ${COMMAND} (${reason})"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "ok"
msgstr "bien"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "check"
msgstr "aviso"

#. Translators: the state of a check in the terminal, in a column seven letters wide: keep it short
#: usr/libexec/amethystora-security-status
msgid "off"
msgstr "alerta"

#: usr/libexec/amethystora-security-status
msgid "today"
msgstr "hoy"

#: usr/libexec/amethystora-security-status
msgid "yesterday"
msgstr "ayer"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${DAYS} day ago"
msgid_plural "${DAYS} days ago"
msgstr[0] "hace ${DAYS} día"
msgstr[1] "hace ${DAYS} días"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine is running ${IMAGE}"
msgstr "Este equipo ejecuta ${IMAGE}"

#: usr/libexec/amethystora-security-status
msgid "Signed updates"
msgstr "Actualizaciones firmadas"

#: usr/libexec/amethystora-security-status
msgid "Updates are refused unless they carry this image's signature"
msgstr "Se rechaza toda actualización que no lleve la firma de esta imagen"

#: usr/libexec/amethystora-security-status
msgid "Signature checking is staged, and turns on at the next restart"
msgstr "La comprobación de firmas está preparada y se activará en el próximo reinicio"

#: usr/libexec/amethystora-security-status
msgid "Updates are not signature-checked"
msgstr "No se comprueba la firma de las actualizaciones"

#: usr/libexec/amethystora-security-status
msgid "Anything that can answer for the registry could replace this machine's whole system."
msgstr "Cualquiera que pueda responder en nombre del registro de imágenes podría sustituir todo el sistema de este equipo."

#: usr/libexec/amethystora-security-status
msgid "Fix it with this, then restart:"
msgstr "Corríjalo con esto y luego reinicie:"

#: usr/libexec/amethystora-security-status
msgid "Updates"
msgstr "Actualizaciones"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This machine follows a single build (${TAG}) and will not receive updates"
msgstr "Este equipo sigue una sola compilación (${TAG}) y no recibirá actualizaciones"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Follow the ${STREAM} stream again with:"
msgstr "Vuelva a seguir el canal ${STREAM} con:"

#: usr/libexec/amethystora-security-status
msgid "Layered packages"
msgstr "Paquetes superpuestos"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${LAYERED} package is layered on this image with rpm-ostree"
msgid_plural "${LAYERED} packages are layered on this image with rpm-ostree"
msgstr[0] "Hay ${LAYERED} paquete superpuesto a esta imagen con rpm-ostree"
msgstr[1] "Hay ${LAYERED} paquetes superpuestos a esta imagen con rpm-ostree"

#: usr/libexec/amethystora-security-status
msgid "Updates keep them, but each one slows every update; the image is the better place"
msgstr "Las actualizaciones los conservan, pero cada uno ralentiza todas las actualizaciones; el mejor sitio para ellos es la imagen"

#: usr/libexec/amethystora-security-status
msgid "System image"
msgstr "Imagen del sistema"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image was built ${WHEN}"
msgstr "Esta imagen del sistema se compiló ${WHEN}"

#: usr/libexec/amethystora-security-status
msgid "A newer system image is waiting for a restart"
msgstr "Una imagen del sistema más reciente espera a que reinicie"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The one running was built ${AGE} day ago. Restart to use the new one."
msgid_plural "The one running was built ${AGE} days ago. Restart to use the new one."
msgstr[0] "La que está en uso se compiló hace ${AGE} día. Reinicie para usar la nueva."
msgstr[1] "La que está en uso se compiló hace ${AGE} días. Reinicie para usar la nueva."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "This system image is ${AGE} day old"
msgid_plural "This system image is ${AGE} days old"
msgstr[0] "Esta imagen del sistema tiene ${AGE} día de antigüedad"
msgstr[1] "Esta imagen del sistema tiene ${AGE} días de antigüedad"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Security fixes reach this machine as new images, and none has arrived since ${SINCE}."
msgstr "Las correcciones de seguridad llegan a este equipo como imágenes nuevas, y no ha llegado ninguna desde el ${SINCE}."

#: usr/libexec/amethystora-security-status
msgid "Update now with:"
msgstr "Actualice ahora con:"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates"
msgstr "Actualizaciones automáticas"

#: usr/libexec/amethystora-security-status
msgid "Automatic updates are off"
msgstr "Las actualizaciones automáticas están desactivadas"

#: usr/libexec/amethystora-security-status
msgid "Turn them back on with:"
msgstr "Vuelva a activarlas con:"

#: usr/libexec/amethystora-security-status
msgid "Updates install by themselves"
msgstr "Las actualizaciones se instalan solas"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The last update that finished was ${DAYS} day ago"
msgid_plural "The last update that finished was ${DAYS} days ago"
msgstr[0] "La última actualización que terminó fue hace ${DAYS} día"
msgstr[1] "La última actualización que terminó fue hace ${DAYS} días"

#: usr/libexec/amethystora-security-status
msgid "Updates start, but do not get to the end. System Updates shows why, or run one here:"
msgstr "Las actualizaciones empiezan, pero no llegan al final. Actualizaciones del sistema muestra por qué, o ejecute una aquí:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Updates install by themselves. The last one finished ${WHEN}"
msgstr "Las actualizaciones se instalan solas. La última terminó ${WHEN}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, never upgraded"
msgstr "${name}, nunca actualizado"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${name}, last upgraded ${WHEN}"
msgstr "${name}, actualizado por última vez ${WHEN}"

#: usr/libexec/amethystora-security-status
msgid "Containers"
msgstr "Contenedores"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} container has not been upgraded for two weeks"
msgid_plural "${N} containers have not been upgraded for two weeks"
msgstr[0] "${N} contenedor lleva dos semanas sin actualizarse"
msgstr[1] "${N} contenedores llevan dos semanas sin actualizarse"

#: usr/libexec/amethystora-security-status
msgid "What runs in a container goes without the fixes its distribution has published since. Upgrade them now with:"
msgstr "Lo que se ejecuta en un contenedor se queda sin las correcciones que su distribución ha publicado desde entonces. Actualícelos ahora con:"

#: usr/libexec/amethystora-security-status
msgid "The container amethystora-pkg manages is upgraded every day"
msgstr "El contenedor que gestiona amethystora-pkg se actualiza cada día"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The ${COUNT} container amethystora-pkg manages is upgraded every day"
msgid_plural "The ${COUNT} containers amethystora-pkg manages are upgraded every day"
msgstr[0] "${COUNT} contenedor gestionado por amethystora-pkg se actualiza cada día"
msgstr[1] "Los ${COUNT} contenedores que gestiona amethystora-pkg se actualizan cada día"

#: usr/libexec/amethystora-security-status
msgid "Verified system files"
msgstr "Archivos del sistema verificados"

#: usr/libexec/amethystora-security-status
msgid "The running system is on composefs: /usr is verified as it is read, not only when pulled"
msgstr "El sistema en uso está sobre composefs: /usr se verifica a medida que se lee, no solo al descargarse"

#: usr/libexec/amethystora-security-status
msgid "/usr is read-only and replaced whole by each update, but is not re-verified as it is read"
msgstr "/usr es de solo lectura y cada actualización lo sustituye entero, pero no se vuelve a verificar a medida que se lee"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot"
msgstr "Secure Boot"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is on: this machine boots only a kernel it has checked"
msgstr "Secure Boot está activado: este equipo solo arranca un núcleo que ha comprobado"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot is off"
msgstr "Secure Boot está desactivado"

#: usr/libexec/amethystora-security-status
msgid "The kernel protections below rest on it. Without it, anything that reaches root can boot a different kernel and step around them."
msgstr "Las protecciones del núcleo que siguen se apoyan en él. Sin él, cualquier cosa que llegue a root puede arrancar otro núcleo y saltárselas."

#: usr/libexec/amethystora-security-status
msgid "Turn Secure Boot on in this machine's firmware, then run:"
msgstr "Active Secure Boot en el firmware de este equipo y luego ejecute:"

#: usr/libexec/amethystora-security-status
msgid "Secure Boot state unknown (no EFI on this machine, or its firmware will not say)"
msgstr "Estado de Secure Boot desconocido (este equipo no tiene EFI o su firmware no lo indica)"

#: usr/libexec/amethystora-security-status
msgid "Signing keys"
msgstr "Claves de firma"

#: usr/libexec/amethystora-security-status
msgid "This image's signing keys are enrolled"
msgstr "Las claves de firma de esta imagen están registradas"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Not enrolled: ${CERT}"
msgstr "Sin registrar: ${CERT}"

#: usr/libexec/amethystora-security-status
msgid "What it signs, such as evdi for DisplayLink docks, will not load."
msgstr "Lo que firma, como evdi para las bases de conexión DisplayLink, no se cargará."

#: usr/libexec/amethystora-security-status
msgid "Enroll it with:"
msgstr "Regístrelo con:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Enrollment of ${CERT} is waiting for the next restart"
msgstr "El registro de ${CERT} espera al próximo reinicio"

#: usr/libexec/amethystora-security-status
msgid "Finish it in the blue MOK manager screen that appears during boot."
msgstr "Termínelo en la pantalla azul del gestor de MOK que aparece durante el arranque."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${cert} is not on this machine"
msgstr "${cert} no está en este equipo"

#: usr/libexec/amethystora-security-status
msgid "Whether its key is enrolled cannot be checked without it."
msgstr "Sin él no se puede comprobar si su clave está registrada."

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Could not tell whether ${CERT} is enrolled"
msgstr "No se pudo saber si ${CERT} está registrado"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "mokutil said: ${rest}"
msgstr "mokutil dijo: ${rest}"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown"
msgstr "Bloqueo del núcleo"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Kernel lockdown is on (${LOCKDOWN}): root cannot rewrite the running kernel"
msgstr "El bloqueo del núcleo está activado (${LOCKDOWN}): root no puede reescribir el núcleo en ejecución"

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off, as it is on every NVIDIA image"
msgstr "El bloqueo del núcleo está desactivado, como en todas las imágenes NVIDIA"

#: usr/libexec/amethystora-security-status
msgid "The NVIDIA driver is a module signed with this machine's own key, and lockdown would leave a machine without Secure Boot with no graphics driver at all."
msgstr "El controlador de NVIDIA es un módulo firmado con la clave propia de este equipo, y el bloqueo dejaría a un equipo sin Secure Boot sin ningún controlador gráfico."

#: usr/libexec/amethystora-security-status
msgid "Kernel lockdown is off"
msgstr "El bloqueo del núcleo está desactivado"

#: usr/libexec/amethystora-security-status
msgid "Turn it back on with:"
msgstr "Vuelva a activarlo con:"

#: usr/libexec/amethystora-security-status
msgid "Firmware security"
msgstr "Seguridad del firmware"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5, and something running weakens them"
msgstr "fwupd califica las protecciones del firmware de este equipo con un ${LEVEL} de 5, y algo en ejecución las debilita"

#: usr/libexec/amethystora-security-status
msgid "Every protection fwupd looks at, with what each is:"
msgstr "Todas las protecciones que examina fwupd, con lo que es cada una:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "fwupd rates this machine's firmware protections ${LEVEL} of 5"
msgstr "fwupd califica las protecciones del firmware de este equipo con un ${LEVEL} de 5"

#: usr/libexec/amethystora-security-status
msgid "That is mostly up to the machine's maker. Every protection fwupd looks at, with what each is:"
msgstr "Eso depende sobre todo del fabricante del equipo. Todas las protecciones que examina fwupd, con lo que es cada una:"

#: usr/libexec/amethystora-security-status
msgid "Audit log"
msgstr "Registro de auditoría"

#: usr/libexec/amethystora-security-status
msgid "The audit log is recording"
msgstr "El registro de auditoría está grabando"

#: usr/libexec/amethystora-security-status
msgid "The audit log is not recording"
msgstr "El registro de auditoría no está grabando"

#: usr/libexec/amethystora-security-status
msgid "Start it with:"
msgstr "Inícielo con:"

#: usr/libexec/amethystora-security-status
msgid "Audit rules"
msgstr "Reglas de auditoría"

#: usr/libexec/amethystora-security-status
msgid "Audit rules are immutable until the next reboot"
msgstr "Las reglas de auditoría no se pueden cambiar hasta el próximo reinicio"

#: usr/libexec/amethystora-security-status
msgid "Failed logins"
msgstr "Inicios de sesión fallidos"

#: usr/libexec/amethystora-security-status
msgid "Repeated failed logins get the address blocked (ame security addresses)"
msgstr "Los inicios de sesión fallidos repetidos bloquean la dirección (ame security addresses)"

#: usr/libexec/amethystora-security-status
msgid "fail2ban is not running"
msgstr "fail2ban no se está ejecutando"

#: usr/libexec/amethystora-security-status
msgid "Firewall"
msgstr "Cortafuegos"

#: usr/libexec/amethystora-security-status
msgid "Firewall is on the amethystora zone: nothing incoming that a desktop does not need"
msgstr "El cortafuegos está en la zona amethystora: no entra nada que un escritorio no necesite"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Firewall default zone is ${ZONE}, not amethystora"
msgstr "La zona predeterminada del cortafuegos es ${ZONE}, no amethystora"

#: usr/libexec/amethystora-security-status
msgid "Put it back with:"
msgstr "Restáurela con:"

#: usr/libexec/amethystora-security-status
msgid "Suricata blocks connections to known malware, command servers and exploits"
msgstr "Suricata bloquea las conexiones a malware conocido, servidores de mando y exploits"

#: usr/libexec/amethystora-security-status
msgid "Suricata inspects every connection and says what it recognises, without blocking"
msgstr "Suricata inspecciona cada conexión e informa de lo que reconoce, sin bloquear"

#: usr/libexec/amethystora-security-status
msgid "Network protection"
msgstr "Protección de red"

#: usr/libexec/amethystora-security-status
msgid "Network protection is on, but not running"
msgstr "La protección de red está activada, pero no se está ejecutando"

#: usr/libexec/amethystora-security-status
msgid "Connections pass without being inspected until it runs again. Start it with:"
msgstr "Las conexiones pasan sin inspeccionarse hasta que vuelva a ejecutarse. Iníciela con:"

#: usr/libexec/amethystora-security-status
msgid "Network protection is running, but no traffic reaches it"
msgstr "La protección de red se está ejecutando, pero no le llega tráfico"

#: usr/libexec/amethystora-security-status
msgid "Its nftables table (inet amethystora-ips) is gone, so connections pass without being inspected. Put it back with:"
msgstr "Su tabla de nftables (inet amethystora-ips) ha desaparecido, así que las conexiones pasan sin inspeccionarse. Restáurela con:"

#: usr/libexec/amethystora-security-status
msgid "Network protection has no rules yet"
msgstr "La protección de red aún no tiene reglas"

#: usr/libexec/amethystora-security-status
msgid "Nothing is recognised until the rules have downloaded once. Download them now with:"
msgstr "No se reconoce nada hasta que las reglas se hayan descargado una vez. Descárguelas ahora con:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The network protection rules are ${DAYS} day old"
msgid_plural "The network protection rules are ${DAYS} days old"
msgstr[0] "Las reglas de la protección de red tienen ${DAYS} día de antigüedad"
msgstr[1] "Las reglas de la protección de red tienen ${DAYS} días de antigüedad"

#: usr/libexec/amethystora-security-status
msgid "They download every day, and newer attacks are not recognised until they do. Check this machine's network, or try now with:"
msgstr "Se descargan cada día, y los ataques más recientes no se reconocen hasta que lo hacen. Compruebe la red de este equipo, o inténtelo ahora con:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "It blocked ${BLOCKED} connection in the last 7 days. See it with:"
msgid_plural "It blocked ${BLOCKED} connections in the last 7 days. See them with:"
msgstr[0] "Bloqueó ${BLOCKED} conexión en los últimos 7 días. Véala con:"
msgstr[1] "Bloqueó ${BLOCKED} conexiones en los últimos 7 días. Véalas con:"

#: usr/libexec/amethystora-security-status
msgid "Security watcher"
msgstr "Vigilante de seguridad"

#: usr/libexec/amethystora-security-status
msgid "The security watcher noticed something"
msgstr "El vigilante de seguridad detectó algo"

#: usr/libexec/amethystora-security-status
msgid "A change to accounts, to what starts by itself or to a security setting, or a program reading the keyboard directly. See it with:"
msgstr "Un cambio en las cuentas, en lo que se inicia solo o en un ajuste de seguridad, o un programa que lee el teclado directamente. Véalo con:"

#: usr/libexec/amethystora-security-status
msgid "The security watcher is off"
msgstr "El vigilante de seguridad está desactivado"

#: usr/libexec/amethystora-security-status
msgid "The security watcher's last run failed"
msgstr "La última ejecución del vigilante de seguridad falló"

#: usr/libexec/amethystora-security-status
msgid "See why with:"
msgstr "Vea por qué con:"

#: usr/libexec/amethystora-security-status
msgid "The security watcher reads the audit log and checks the settings as they happen"
msgstr "El vigilante de seguridad lee el registro de auditoría y comprueba los ajustes en tiempo real"

#: usr/libexec/amethystora-security-status
msgid "The security watcher reads the audit log and checks the settings every 15 minutes"
msgstr "El vigilante de seguridad lee el registro de auditoría y comprueba los ajustes cada 15 minutos"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching"
msgstr "Vigilancia en tiempo real"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching is on: changes are read as they happen, and files scanned as they are written"
msgstr "La vigilancia en tiempo real está activada: los cambios se leen en cuanto ocurren y los archivos se analizan a medida que se escriben"

#: usr/libexec/amethystora-security-status
msgid "Real-time watching is on, but not running"
msgstr "La vigilancia en tiempo real está activada, pero no se está ejecutando"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Not running: ${UNITS}. Real-time scanning waits for the first virus signatures."
msgstr "Sin ejecutarse: ${UNITS}. El análisis en tiempo real espera a las primeras firmas de virus."

#: usr/libexec/amethystora-security-status
msgid "Ransomware protection"
msgstr "Protección contra ransomware"

#: usr/libexec/amethystora-security-status
msgid "Ransomware protection is on, but no snapshot has been taken"
msgstr "La protección contra ransomware está activada, pero no se ha tomado ninguna instantánea"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The latest snapshot of the home folders is ${HOURS} hour old"
msgid_plural "The latest snapshot of the home folders is ${HOURS} hours old"
msgstr[0] "La última instantánea de las carpetas personales tiene ${HOURS} hora de antigüedad"
msgstr[1] "La última instantánea de las carpetas personales tiene ${HOURS} horas de antigüedad"

#: usr/libexec/amethystora-security-status
msgid "They are taken every hour. See why the last ones were not with:"
msgstr "Se toman cada hora. Vea por qué no se tomaron las últimas con:"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The home folders are snapshotted every hour. The latest is from ${AT}"
msgstr "Se toma una instantánea de las carpetas personales cada hora. La última es de las ${AT}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "No backup has succeeded for ${DAYS} day"
msgid_plural "No backup has succeeded for ${DAYS} days"
msgstr[0] "Ninguna copia de seguridad se ha completado desde hace ${DAYS} día"
msgstr[1] "Ninguna copia de seguridad se ha completado desde hace ${DAYS} días"

#: usr/libexec/amethystora-security-status
msgid "It runs once a day. See why the last ones failed with:"
msgstr "Se hace una vez al día. Vea por qué fallaron las últimas con:"

#: usr/libexec/amethystora-security-status
msgid "The daily backup is on, but none has succeeded yet"
msgstr "La copia de seguridad diaria está activada, pero ninguna se ha completado todavía"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "Your home folder is backed up every day. The last backup succeeded ${WHEN}"
msgstr "Su carpeta personal se copia cada día. La última copia se completó ${WHEN}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel setting ${key} is ${live}, not ${value}"
msgstr "El ajuste del núcleo ${key} vale ${live}, no ${value}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel argument ${karg} is missing"
msgstr "Falta el argumento del núcleo ${karg}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "The kernel module ${module} is no longer blocked"
msgstr "El módulo del núcleo ${module} ya no está bloqueado"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} is changed on this machine"
msgstr "${path} se ha modificado en este equipo"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path}, which the image ships, is gone"
msgstr "${path}, que incluye la imagen, ha desaparecido"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} replaces the image's ${detail}"
msgstr "${path} sustituye a ${detail} de la imagen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} changes how ${detail} runs"
msgstr "${path} cambia cómo se ejecuta ${detail}"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${path} stops ${detail} from ever starting"
msgstr "${path} impide que ${detail} llegue a iniciarse"

#: usr/libexec/amethystora-security-status
msgid "Image settings"
msgstr "Ajustes de la imagen"

#: usr/libexec/amethystora-security-status
#, sh-format
msgid "${N} security setting differs from the image"
msgid_plural "${N} security settings differ from the image"
msgstr[0] "${N} ajuste de seguridad difiere de la imagen"
msgstr[1] "${N} ajustes de seguridad difieren de la imagen"

#: usr/libexec/amethystora-security-status
msgid "If you did not change these, find out what did. The image's own copy of anything in /etc is in /usr/etc, to compare or copy back."
msgstr "Si no los cambió usted, averigüe qué lo hizo. La copia que la imagen trae de todo lo que hay en /etc está en /usr/etc, para compararla o volver a copiarla."

#: usr/libexec/amethystora-security-status
