From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Arsslen Idadi <arsslens021@gmail.com>
Date: Sun, 18 Oct 2026 00:39:22 +0000
Subject: [PATCH 20/20] focaltech_moh: drive 2808:93a9 alone, for Amethystora

Not for upstream. On the 64x80 sensor of 2808:9338 and 2808:9348 the
matcher was measured, on synthetic fingerprints, at one false accept in
39848 usable presses of another finger, a 95% upper bound of 1 in 8400,
with 60% of presses asked for again: short of what signing in and sudo
need. Amethystora leaves them unsupported, as libfprint's releases do,
until their matcher is shown safe, and drives the 96x96 2808:93a9 alone.

The two go back to the list of unsupported devices, and the test recorded
on 2808:9338 goes, the driver no longer claiming it.
---
 data/autosuspend.hwdb                           | 4 ++--
 libfprint/drivers/focaltech_moh/focaltech_moh.c | 5 +++--
 libfprint/fprint-list-udev-hwdb.c               | 2 ++
 tests/meson.build                               | 1 -
 4 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/data/autosuspend.hwdb b/data/autosuspend.hwdb
index 527d17ed..16cebd9d 100644
--- a/data/autosuspend.hwdb
+++ b/data/autosuspend.hwdb
@@ -202,8 +202,6 @@ usb:v2808p6553*
  ID_PERSIST=0
 
 # Supported by libfprint driver focaltech_moh
-usb:v2808p9338*
-usb:v2808p9348*
 usb:v2808p93A9*
  ID_AUTOSUSPEND=1
  ID_PERSIST=0
@@ -546,6 +544,8 @@ usb:v27C6p5F10*
 usb:v27C6p5F91*
 usb:v2808p06FC*
 usb:v2808p6652*
+usb:v2808p9338*
+usb:v2808p9348*
 usb:v2808pA553*
 usb:v2808pA573*
 usb:v2808pA658*
diff --git a/libfprint/drivers/focaltech_moh/focaltech_moh.c b/libfprint/drivers/focaltech_moh/focaltech_moh.c
index 1acc8a98..4ff0e493 100644
--- a/libfprint/drivers/focaltech_moh/focaltech_moh.c
+++ b/libfprint/drivers/focaltech_moh/focaltech_moh.c
@@ -43,9 +43,10 @@
 G_DEFINE_TYPE (FpiDeviceFocaltechMoh, fpi_device_focaltech_moh,
                FP_TYPE_DEVICE)
 
+/* Amethystora leaves 2808:9338 and 2808:9348 out: on their 64x80 sensor the
+ * matcher was measured at about one false accept in 40000 presses of another
+ * finger, short of what signing in and sudo need. */
 static const FpIdEntry id_table[] = {
-  { .vid = FOCALTECH_VID, .pid = 0x9338, .driver_data = FT9201_BRIDGE_NEW_SIU },
-  { .vid = FOCALTECH_VID, .pid = 0x9348, .driver_data = FT9201_BRIDGE_NEW_SIU },
   { .vid = FOCALTECH_VID, .pid = 0x93a9, .driver_data = FT9201_BRIDGE_OLD_SIU },
   { .vid = 0, .pid = 0 },
 };
diff --git a/libfprint/fprint-list-udev-hwdb.c b/libfprint/fprint-list-udev-hwdb.c
index 16637454..29d2ac8d 100644
--- a/libfprint/fprint-list-udev-hwdb.c
+++ b/libfprint/fprint-list-udev-hwdb.c
@@ -188,6 +188,8 @@ static const FpIdEntry allowlist_id_table[] = {
   { .vid = 0x27c6, .pid = 0x5f91 },
   { .vid = 0x2808, .pid = 0x06fc },
   { .vid = 0x2808, .pid = 0x6652 },
+  { .vid = 0x2808, .pid = 0x9338 },
+  { .vid = 0x2808, .pid = 0x9348 },
   { .vid = 0x2808, .pid = 0xa553 },
   { .vid = 0x2808, .pid = 0xa573 },
   { .vid = 0x2808, .pid = 0xa658 },
diff --git a/tests/meson.build b/tests/meson.build
index 8daf3d03..1caf70a9 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -38,7 +38,6 @@ drivers_tests = {
     'elan': {},
     'elan-cobo': {},
     'elanmoc': {},
-    'focaltech_moh': { 'timeout': 60 },
     'focaltech_moh-93a9': { 'timeout': 60 },
     'elanspi': { 'timeout': 30 },
     'synaptics': {},
