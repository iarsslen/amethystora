+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#pragma once
+
+#include <glib.h>
+
+/* Presses up to this size; the correlation runs on this square. */
+#define FT9201_MATCH_FFT 128
+#define FT9201_MATCH_MAX_MINUTIAE 64
+
+typedef struct
+{
+  double x, y;
+  double dir;     /* ridge direction, radians in [0, pi) */
+  int    kind;    /* 1: ridge ending, 3: bifurcation */
+} Ft9201Minutia;
+
+typedef struct _Ft9201Press Ft9201Press;
+
+/* What one enrolled press says about a probe. */
+typedef struct
+{
+  double score;          /* masked NCC at the best pose found */
+  int    angle;          /* degrees the probe was turned */
+  int    dy, dx;         /* probe pixel (y + dy, x + dx) lies on (y, x) */
+  int    overlap;        /* pixels both presses show ridges in, at that pose */
+  int    paired;         /* minutiae paired at that pose */
+  int    lonely_probe;   /* probe minutiae with no partner where one could be seen */
+  int    lonely_tmpl;    /* and the same the other way round */
+} Ft9201Comparison;
+
+/* A press made ready for matching: contrast normalised, masked to where it
+ * shows ridges, and its minutiae found. */
+Ft9201Press *ft9201_press_new (const guint8 *raw,
+                               int           width,
+                               int           height);
+
+/* The same, for an enrolled press whose minutiae were stored with it. */
+Ft9201Press *ft9201_press_new_with_minutiae (const guint8        *raw,
+                                             int                  width,
+                                             int                  height,
+                                             const Ft9201Minutia *minutiae,
+                                             int                  n_minutiae);
+
+void ft9201_press_free (Ft9201Press *press);
+
+const Ft9201Minutia *ft9201_press_get_minutiae (const Ft9201Press *press,
+                                                int               *n_minutiae);
+
+/* Fraction of the frame that shows ridges well enough to match on. */
+double ft9201_press_get_coverage (const Ft9201Press *press);
+
+void ft9201_compare (Ft9201Press      *tmpl,
+                     Ft9201Press      *probe,
+                     Ft9201Comparison *out);
+
+/* Frees what comparing a press as the probe left cached, keeping what it
+ * needs as an enrolled press. */
+void ft9201_press_drop_rotations (Ft9201Press *press);
+
+/* Whether a probe shows enough finger, and enough minutiae, to be matched;
+ * if not, the user should press again. */
+gboolean ft9201_press_is_usable (const Ft9201Press *probe);
+
+/* Whether a press shows enough finger to enrol. */
+gboolean ft9201_press_is_enrollable (const Ft9201Press *press);
+
+/* Whether two presses of one enrolment show the same finger. */
+gboolean ft9201_comparison_links (const Ft9201Comparison *cmp);
+
+/* The evidence that a probe is the finger whose enrolled presses gave these
+ * comparisons, and whether it is enough to accept. */
+int      ft9201_evidence (const Ft9201Comparison *cmps,
+                          int                     n_cmps);
+gboolean ft9201_evidence_accepts (int evidence);
+
+/* A finger is kept as its enrolled presses: each the raw frame and the
+ * minutiae found in it, with the sensor size. The version says which matcher
+ * wrote it; another is not read. */
+#define FT9201_PRINT_VERSION 2
+#define FT9201_PRINT_FORMAT "(yqqa(aya(dddy)))"
+#define FT9201_PRINT_MAX_PRESSES 32
+
+GVariant  *ft9201_print_data_new (Ft9201Press *const *presses,
+                                  int                 n_presses);
+
+/* The presses in the data of a print, or NULL unless it is data of this
+ * format for a sensor of this size. */
+GPtrArray *ft9201_print_data_load (GVariant *data,
+                                   int       width,
+                                   int       height);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (Ft9201Press, ft9201_press_free)
