+/*
+ * A press of this sensor shows a few millimetres of finger, where ridges
+ * mostly run parallel. Parallel ridges carry little identity: two different
+ * fingers line up almost perfectly once their angle, spacing and phase are
+ * matched, which is all a correlation search tunes. What tells fingers apart
+ * here is where ridges end and split, the minutiae.
+ *
+ * So the probe is first aligned with each enrolled press by masked
+ * normalised cross-correlation over rotations and shifts (Padfield, "Masked
+ * object registration in the Fourier domain", IEEE TIP 2012), and only then
+ * asked whether its minutiae land on that press's. The pose is chosen
+ * without looking at minutiae, so a wrong finger pairs them only by chance.
+ */
+
+#include <math.h>
+#include <string.h>
+
+#include "focaltech_moh_match.h"
+
+#define N FT9201_MATCH_FFT
+#define N_LOG2 7
+
+#define RADIUS 24                  /* largest shift searched, pixels */
+#define SPAN (2 * RADIUS + 1)
+#define MIN_OVERLAP_FRACTION 0.54  /* of the frame, for a pose to count */
+
+/* Rotations are searched coarse to fine: every ANGLE_COARSE degrees within
+ * ANGLE_LIMIT, then around the best at ANGLE_COARSE / 2 and / 4 degrees. A
+ * press whose best coarse score stays under COARSE_SKIP is not refined: it
+ * cannot reach ALIGNED, and nearly every press of a wrong finger stops there. */
+#define ANGLE_LIMIT 24             /* degrees */
+#define ANGLE_COARSE 8
+#define ANGLE_REACH (ANGLE_LIMIT + ANGLE_COARSE / 2 + ANGLE_COARSE / 4)
+#define ANGLE_SLOTS (2 * ANGLE_REACH + 1)
+#define COARSE_SKIP 0.35
+
+#define MASK_RATIO 0.35            /* of the median local contrast */
+#define MASK_FLOOR 8.0             /* grey levels of local contrast */
+#define MASK_ERODE 2
+#define DETECT_BORDER 8            /* minutiae only this far inside the mask */
+#define MIN_MINUTIA_DIST 7.0       /* closer pairs are skeleton artefacts */
+#define N_ORIENT 16                /* Gabor filter directions */
+
+#define MATCH_DIST 4.0
+#define MATCH_ANGLE (20.0 * G_PI / 180.0)
+
+/* What a probe needs before it is matched at all. */
+#define COVERAGE_MIN 0.80
+#define MIN_PROBE_MINUTIAE 4
+
+/* The decision: an enrolled press aligned at NCC >= ALIGNED gives as
+ * evidence its paired minutiae less the unpaired ones on both sides, never
+ * less than MARGIN_FLOOR; the two best together must reach ACCEPT_SUM. A
+ * genuine press agrees with several enrolled presses, which cover the same
+ * skin; a wrong finger's chance pairings come from one coincidental
+ * alignment and are not repeated by a second press.
+ *
+ * Measured on synthetic fingerprints that the rule was not tuned on (2200
+ * fingers, ten per person, 15 enrolled presses each): of 246753 usable
+ * presses of another finger, 148086 of them of the same person's, none was
+ * accepted (95% upper bound 1 in 82000); one reached 4. A usable press of
+ * the right finger is accepted 73% of the time; 18% of presses are not
+ * usable and asked for again. */
+#define ALIGNED 0.5
+#define MARGIN_FLOOR -4
+#define ACCEPT_SUM 5
+
+/* Two presses of one enrolment are taken to show the same finger when they
+ * align and pair at least this many more minutiae than they leave unpaired. */
+#define LINK_MARGIN 2
+
+struct _Ft9201Press
+{
+  int           width, height;
+  guint8       *raw; /* the frame as captured */
+  double       *norm; /* contrast normalised */
+  double       *mask; /* 1 where ridges show */
+  double       *detect; /* 1 where a minutia would be found */
+  double        period;
+  Ft9201Minutia minutiae[FT9201_MATCH_MAX_MINUTIAE];
+  int           n_minutiae;
+
+  /* Spectra of the mask, the masked image and its square, per rotation of
+   * the press (probe) or only unrotated (enrolled press). */
+  float  *spectra[ANGLE_SLOTS];
+  double *rot_detect[ANGLE_SLOTS];
+};
+
+/* ------------------------------------------------------------------ */
+/* FFT                                                                 */
+/* ------------------------------------------------------------------ */
+
+static float twiddle_re[N / 2], twiddle_im[N / 2];
+static int bit_reverse[N];
+
+static void
+fft_init (void)
+{
+  static gsize done = 0;
+
+  if (g_once_init_enter (&done))
+    {
+      for (int i = 0; i < N / 2; i++)
+        {
+          twiddle_re[i] = cos (-2.0 * G_PI * i / N);
+          twiddle_im[i] = sin (-2.0 * G_PI * i / N);
+        }
+      for (int i = 0; i < N; i++)
+        {
+          int r = 0;
+
+          for (int b = 0; b < N_LOG2; b++)
+            r |= ((i >> b) & 1) << (N_LOG2 - 1 - b);
+          bit_reverse[i] = r;
+        }
+      g_once_init_leave (&done, 1);
+    }
+}
+
+/* In place, N points spaced by stride. Unscaled in both directions. */
+static void
+fft_1d (float *re, float *im, int stride, gboolean inverse)
+{
+  for (int i = 0; i < N; i++)
+    {
+      int j = bit_reverse[i];
+
+      if (j > i)
+        {
+          float t;
+
+          t = re[i * stride];
+          re[i * stride] = re[j * stride];
+          re[j * stride] = t;
+          t = im[i * stride];
+          im[i * stride] = im[j * stride];
+          im[j * stride] = t;
+        }
+    }
+
+  for (int len = 2; len <= N; len <<= 1)
+    {
+      int half = len / 2, step = N / len;
+
+      for (int start = 0; start < N; start += len)
+        for (int k = 0; k < half; k++)
+          {
+            float wr = twiddle_re[k * step];
+            float wi = inverse ? -twiddle_im[k * step] : twiddle_im[k * step];
+            int a = (start + k) * stride, b = (start + k + half) * stride;
+            float xr = re[b] * wr - im[b] * wi;
+            float xi = re[b] * wi + im[b] * wr;
+
+            re[b] = re[a] - xr;
+            im[b] = im[a] - xi;
+            re[a] += xr;
+            im[a] += xi;
+          }
+    }
+}
+
+/* Transforms every column, copied out to keep the passes in cache. */
+static void
+fft_columns (float *re, float *im, gboolean inverse)
+{
+  float cr[N], ci[N];
+
+  for (int x = 0; x < N; x++)
+    {
+      for (int y = 0; y < N; y++)
+        {
+          cr[y] = re[y * N + x];
+          ci[y] = im[y * N + x];
+        }
+      fft_1d (cr, ci, 1, inverse);
+      for (int y = 0; y < N; y++)
+        {
+          re[y * N + x] = cr[y];
+          im[y * N + x] = ci[y];
+        }
+    }
+}
+
+/* Forward N x N transform of re + i im in place, of which only the first
+ * `rows` rows may be non-zero. */
+static void
+fft_2d_forward (float *re, float *im, int rows)
+{
+  for (int y = 0; y < rows; y++)
+    fft_1d (re + y * N, im + y * N, 1, FALSE);
+  fft_columns (re, im, FALSE);
+}
+
+/* Inverse N x N transform, scaled, in place; only the rows within RADIUS of
+ * row 0 (cyclically) come out right, the shifts the correlation reads. */
+static void
+fft_2d_inverse_near_origin (float *re, float *im)
+{
+  fft_columns (re, im, TRUE);
+  for (int y = 0; y < N; y++)
+    {
+      if (y > RADIUS && y < N - RADIUS)
+        continue;
+      fft_1d (re + y * N, im + y * N, 1, TRUE);
+      for (int x = 0; x < N; x++)
+        {
+          re[y * N + x] /= N * N;
+          im[y * N + x] /= N * N;
+        }
+    }
+}
+
+/* Inverse N x N transform, scaled, in place. */
+static void
+fft_2d_inverse (float *re, float *im)
+{
+  fft_columns (re, im, TRUE);
+  for (int y = 0; y < N; y++)
+    {
+      fft_1d (re + y * N, im + y * N, 1, TRUE);
+      for (int x = 0; x < N; x++)
+        {
+          re[y * N + x] /= N * N;
+          im[y * N + x] /= N * N;
+        }
+    }
+}
+
+/* Spectrum of a real h x w image, zero padded to N x N: N*N re then N*N im. */
+static float *
+spectrum_of (const double *img, int h, int w)
+{
+  float *s = g_new0 (float, 2 * N * N);
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      s[y * N + x] = img[y * w + x];
+  fft_2d_forward (s, s + N * N, h);
+  return s;
+}
+
+/* ------------------------------------------------------------------ */
+/* Image steps                                                         */
+/* ------------------------------------------------------------------ */
+
+static int
+mirror (int i, int n)
+{
+  while (i < 0 || i >= n)
+    i = i < 0 ? -i - 1 : 2 * n - i - 1;
+  return i;
+}
+
+/* Separable Gaussian blur, edges mirrored with the edge pixel repeated. */
+static void
+blur (const double *src, double *dst, int h, int w, double sigma)
+{
+  int radius = (int) (4.0 * sigma + 0.5);
+  int len = 2 * radius + 1;
+  g_autofree double *k = g_new (double, len);
+  g_autofree double *tmp = g_new (double, h * w);
+  double sum = 0;
+
+  for (int i = 0; i < len; i++)
+    {
+      double x = i - radius;
+
+      k[i] = exp (-x * x / (2 * sigma * sigma));
+      sum += k[i];
+    }
+  for (int i = 0; i < len; i++)
+    k[i] /= sum;
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        double acc = 0;
+
+        for (int i = 0; i < len; i++)
+          acc += src[y * w + mirror (x + i - radius, w)] * k[i];
+        tmp[y * w + x] = acc;
+      }
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        double acc = 0;
+
+        for (int i = 0; i < len; i++)
+          acc += tmp[mirror (y + i - radius, h) * w + x] * k[i];
+        dst[y * w + x] = acc;
+      }
+}
+
+/* Binary erosion by the 4-neighbour cross; outside the image counts as 0. */
+static void
+erode (const double *src, double *dst, int h, int w, int iterations)
+{
+  g_autofree guint8 *a = g_new (guint8, h * w);
+  g_autofree guint8 *b = g_new (guint8, h * w);
+
+  for (int i = 0; i < h * w; i++)
+    a[i] = src[i] > 0;
+
+  for (int it = 0; it < iterations; it++)
+    {
+      for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++)
+          b[y * w + x] = a[y * w + x] &&
+                         y > 0 && a[(y - 1) * w + x] &&
+                         y < h - 1 && a[(y + 1) * w + x] &&
+                         x > 0 && a[y * w + x - 1] &&
+                         x < w - 1 && a[y * w + x + 1];
+      memcpy (a, b, h * w);
+    }
+
+  for (int i = 0; i < h * w; i++)
+    dst[i] = a[i];
+}
+
+static int
+compare_doubles (const void *a, const void *b)
+{
+  double x = *(const double *) a, y = *(const double *) b;
+
+  return (x > y) - (x < y);
+}
+
+/* Zero local mean, unit local contrast, clipped; and where ridges show. */
+static void
+normalise (const guint8 *raw, int h, int w, double *norm, double *mask)
+{
+  g_autofree double *x = g_new (double, h * w);
+  g_autofree double *mean = g_new (double, h * w);
+  g_autofree double *d2 = g_new (double, h * w);
+  g_autofree double *s = g_new (double, h * w);
+  g_autofree double *sorted = NULL;
+  g_autofree double *above = g_new (double, h * w);
+  double median;
+  int m = h * w;
+
+  for (int i = 0; i < m; i++)
+    x[i] = raw[i];
+  blur (x, mean, h, w, 4.0);
+  for (int i = 0; i < m; i++)
+    {
+      x[i] -= mean[i];
+      d2[i] = x[i] * x[i];
+    }
+  blur (d2, s, h, w, 6.0);
+  for (int i = 0; i < m; i++)
+    {
+      s[i] = sqrt (s[i]);
+      norm[i] = CLAMP (x[i] / (s[i] + 1e-6), -3.0, 3.0);
+    }
+
+  sorted = g_memdup2 (s, m * sizeof (double));
+  qsort (sorted, m, sizeof (double), compare_doubles);
+  median = 0.5 * (sorted[(m - 1) / 2] + sorted[m / 2]);
+
+  /* On a press that barely touches the sensor the median is the noise's;
+   * the floor keeps the noise from counting as ridges. */
+  for (int i = 0; i < m; i++)
+    above[i] = s[i] > MAX (MASK_RATIO * median, MASK_FLOOR);
+  erode (above, mask, h, w, MASK_ERODE);
+}
+
+/* Turns an image about its centre, bilinear. A pixel whose source falls
+ * outside the image, or on the edge of the mask, is masked out. Either
+ * output may be NULL. */
+static void
+rotate (const double *img, const double *mask, int h, int w, int angle,
+        double *out, double *out_mask)
+{
+  double a = angle * G_PI / 180.0;
+  double ca = cos (a), sa = sin (a);
+  double cy = (h - 1) / 2.0, cx = (w - 1) / 2.0;
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        double ys = cy + ca * (y - cy) - sa * (x - cx);
+        double xs = cx + sa * (y - cy) + ca * (x - cx);
+        gboolean inside = ys >= 0 && ys <= h - 1 && xs >= 0 && xs <= w - 1;
+        int y0 = CLAMP ((int) floor (ys), 0, h - 2);
+        int x0 = CLAMP ((int) floor (xs), 0, w - 2);
+        double fy = ys - y0, fx = xs - x0;
+        int i = y0 * w + x0;
+
+#define SAMPLE(p) \
+  ((1 - fy) * ((1 - fx) * (p)[i] + fx * (p)[i + 1]) + \
+   fy * ((1 - fx) * (p)[i + w] + fx * (p)[i + w + 1]))
+        if (out)
+          out[y * w + x] = inside ? SAMPLE (img) : 0.0;
+        if (out_mask)
+          out_mask[y * w + x] = inside && SAMPLE (mask) >= 0.999 ? 1.0 : 0.0;
+#undef SAMPLE
+      }
+}
+
+/* Ridge direction per pixel, radians in [0, pi), from smoothed gradients. */
+static void
+orientation (const double *n, int h, int w, double *theta)
+{
+  g_autofree double *gxx = g_new0 (double, h * w);
+  g_autofree double *gyy = g_new0 (double, h * w);
+  g_autofree double *gxy = g_new0 (double, h * w);
+  g_autofree double *sxx = g_new (double, h * w);
+  g_autofree double *syy = g_new (double, h * w);
+  g_autofree double *sxy = g_new (double, h * w);
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        double gy = (y > 0 && y < h - 1) ? (n[(y + 1) * w + x] - n[(y - 1) * w + x]) / 2 : 0;
+        double gx = (x > 0 && x < w - 1) ? (n[y * w + x + 1] - n[y * w + x - 1]) / 2 : 0;
+
+        gxx[y * w + x] = gx * gx;
+        gyy[y * w + x] = gy * gy;
+        gxy[y * w + x] = gx * gy;
+      }
+  blur (gxx, sxx, h, w, 5.0);
+  blur (gyy, syy, h, w, 5.0);
+  blur (gxy, sxy, h, w, 5.0);
+
+  for (int i = 0; i < h * w; i++)
+    {
+      double t = 0.5 * atan2 (2 * sxy[i], sxx[i] - syy[i]) + G_PI / 2;
+
+      t = fmod (t, G_PI);
+      if (t < 0)
+        t += G_PI;
+      theta[i] = t;
+    }
+}
+
+/* Average ridge period from the peak of the radial power spectrum, between 6
+ * and 12 pixels. A press with no ridges has no peak and gets the longest
+ * period of the band: the Gabor kernels it sizes must stay well inside the
+ * FFT whatever the press. */
+static double
+ridge_period (const double *n, const double *mask, int h, int w)
+{
+  g_autofree double *masked = g_new (double, h * w);
+  g_autofree float *s = NULL;
+  double power[N / 2 + 1] = { 0 };
+  int lowest = (int) ceil (N / 12.0);
+  int best = lowest;
+
+  for (int i = 0; i < h * w; i++)
+    masked[i] = n[i] * mask[i];
+  s = spectrum_of (masked, h, w);
+
+  for (int y = 0; y < N; y++)
+    for (int x = 0; x < N; x++)
+      {
+        int ky = y < N / 2 ? y : y - N;
+        int kx = x < N / 2 ? x : x - N;
+        double r = sqrt ((double) (ky * ky + kx * kx));
+        double re = s[y * N + x], im = s[N * N + y * N + x];
+
+        /* Periods of 6 to 12 pixels. */
+        if (r >= N / 12.0 && r <= N / 6.0)
+          power[(int) rint (r)] += re * re + im * im;
+      }
+
+  for (int k = lowest; k <= (int) floor (N / 6.0); k++)
+    if (power[k] > power[best])
+      best = k;
+
+  return (double) N / best;
+}
+
+/* Contextual Gabor filtering: each pixel filtered along its own ridges. */
+static void
+enhance (const double *n, const double *mask, const double *theta, double period,
+         int h, int w, double *out)
+{
+  g_autofree double *masked = g_new (double, h * w);
+  g_autofree float *image = NULL;
+  g_autofree double *resp = g_new (double, N_ORIENT * h * w);
+  g_autofree float *kern = g_new (float, 2 * N * N);
+  g_autofree float *prod = g_new (float, 2 * N * N);
+  double sigma = 0.5 * period;
+  int half = (int) ceil (3 * sigma);
+  int side = 2 * half + 1;
+
+  for (int i = 0; i < h * w; i++)
+    masked[i] = n[i] * mask[i];
+  image = spectrum_of (masked, h, w);
+
+  for (int o = 0; o < N_ORIENT; o++)
+    {
+      double th = o * G_PI / N_ORIENT;
+      double nx = -sin (th), ny = cos (th);
+      double mean = 0;
+
+      memset (kern, 0, 2 * N * N * sizeof (float));
+      for (int yy = -half; yy <= half; yy++)
+        for (int xx = -half; xx <= half; xx++)
+          mean += exp (-(xx * xx + yy * yy) / (2 * sigma * sigma)) *
+                  cos (2 * G_PI * (xx * nx + yy * ny) / period);
+      mean /= side * side;
+      for (int yy = -half; yy <= half; yy++)
+        for (int xx = -half; xx <= half; xx++)
+          kern[((yy + N) % N) * N + (xx + N) % N] =
+            exp (-(xx * xx + yy * yy) / (2 * sigma * sigma)) *
+            cos (2 * G_PI * (xx * nx + yy * ny) / period) - mean;
+      fft_2d_forward (kern, kern + N * N, N);
+
+      for (int i = 0; i < N * N; i++)
+        {
+          double ar = image[i], ai = image[N * N + i];
+          double br = kern[i], bi = kern[N * N + i];
+
+          prod[i] = ar * br - ai * bi;
+          prod[N * N + i] = ar * bi + ai * br;
+        }
+      fft_2d_inverse (prod, prod + N * N);
+      for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++)
+          resp[(o * h + y) * w + x] = prod[y * N + x];
+    }
+
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        double ob = theta[y * w + x] / G_PI * N_ORIENT;
+        int o0 = ((int) floor (ob)) % N_ORIENT;
+        int o1 = (o0 + 1) % N_ORIENT;
+        double wo = ob - floor (ob);
+
+        out[y * w + x] = (1 - wo) * resp[(o0 * h + y) * w + x] +
+                         wo * resp[(o1 * h + y) * w + x];
+      }
+}
+
+/* Zhang-Suen thinning; outside the image counts as background. */
+static void
+thin (guint8 *img, int h, int w)
+{
+  g_autofree guint8 *kill = g_new (guint8, h * w);
+  gboolean changed = TRUE;
+
+#define P(yy, xx) ((yy) >= 0 && (yy) < h && (xx) >= 0 && (xx) < w ? img[(yy) * w + (xx)] : 0)
+  while (changed)
+    {
+      changed = FALSE;
+      for (int step = 0; step < 2; step++)
+        {
+          gboolean any = FALSE;
+
+          for (int y = 0; y < h; y++)
+            for (int x = 0; x < w; x++)
+              {
+                int p2 = P (y - 1, x), p3 = P (y - 1, x + 1), p4 = P (y, x + 1);
+                int p5 = P (y + 1, x + 1), p6 = P (y + 1, x), p7 = P (y + 1, x - 1);
+                int p8 = P (y, x - 1), p9 = P (y - 1, x - 1);
+                int seq[9] = { p2, p3, p4, p5, p6, p7, p8, p9, p2 };
+                int b = p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9;
+                int a = 0;
+                gboolean c;
+
+                for (int i = 0; i < 8; i++)
+                  a += seq[i] == 0 && seq[i + 1] == 1;
+                if (step == 0)
+                  c = p2 * p4 * p6 == 0 && p4 * p6 * p8 == 0;
+                else
+                  c = p2 * p4 * p8 == 0 && p2 * p6 * p8 == 0;
+
+                kill[y * w + x] = img[y * w + x] == 1 && b >= 2 && b <= 6 && a == 1 && c;
+                any |= kill[y * w + x];
+              }
+
+          if (any)
+            {
+              for (int i = 0; i < h * w; i++)
+                if (kill[i])
+                  img[i] = 0;
+              changed = TRUE;
+            }
+        }
+    }
+#undef P
+}
+
+/* Ridge endings and bifurcations of the enhanced image, inside detect. */
+static int
+find_minutiae (const double *enh, const double *detect, const double *theta,
+               int h, int w, Ft9201Minutia *out)
+{
+  g_autofree guint8 *sk = g_new (guint8, h * w);
+  Ft9201Minutia found[4 * FT9201_MATCH_MAX_MINUTIAE];
+  gboolean drop[4 * FT9201_MATCH_MAX_MINUTIAE] = { FALSE };
+  int n_found = 0, n_out = 0;
+
+  for (int i = 0; i < h * w; i++)
+    sk[i] = enh[i] > 0;
+  thin (sk, h, w);
+
+#define S(yy, xx) ((yy) >= 0 && (yy) < h && (xx) >= 0 && (xx) < w ? sk[(yy) * w + (xx)] : 0)
+  for (int y = 0; y < h; y++)
+    for (int x = 0; x < w; x++)
+      {
+        int nb[8] = { S (y - 1, x), S (y - 1, x + 1), S (y, x + 1), S (y + 1, x + 1),
+                      S (y + 1, x), S (y + 1, x - 1), S (y, x - 1), S (y - 1, x - 1) };
+        int cn = 0;
+
+        if (!sk[y * w + x] || detect[y * w + x] <= 0)
+          continue;
+        for (int i = 0; i < 8; i++)
+          cn += ABS (nb[i] - nb[(i + 1) % 8]);
+        cn /= 2;
+        if ((cn == 1 || cn == 3) && n_found < (int) G_N_ELEMENTS (found))
+          found[n_found++] = (Ft9201Minutia){ x, y, theta[y * w + x], cn };
+      }
+#undef S
+
+  /* Minutiae this close come in pairs from breaks, spurs and bridges in
+   * the skeleton: drop both. */
+  for (int i = 0; i < n_found; i++)
+    for (int j = i + 1; j < n_found; j++)
+      if (hypot (found[i].x - found[j].x, found[i].y - found[j].y) < MIN_MINUTIA_DIST)
+        drop[i] = drop[j] = TRUE;
+
+  for (int i = 0; i < n_found && n_out < FT9201_MATCH_MAX_MINUTIAE; i++)
+    if (!drop[i])
+      out[n_out++] = found[i];
+
+  return n_out;
+}
+
+/* ------------------------------------------------------------------ */
+/* Presses                                                             */
+/* ------------------------------------------------------------------ */
+
+static Ft9201Press *
+press_prepare (const guint8 *raw, int width, int height)
+{
+  Ft9201Press *p;
+
+  g_return_val_if_fail (width > 2 * DETECT_BORDER && width <= N, NULL);
+  g_return_val_if_fail (height > 2 * DETECT_BORDER && height <= N, NULL);
+
+  fft_init ();
+  p = g_new0 (Ft9201Press, 1);
+  p->width = width;
+  p->height = height;
+  p->raw = g_memdup2 (raw, width * height);
+  p->norm = g_new (double, width * height);
+  p->mask = g_new (double, width * height);
+  p->detect = g_new (double, width * height);
+  normalise (raw, height, width, p->norm, p->mask);
+  erode (p->mask, p->detect, height, width, DETECT_BORDER);
+  return p;
+}
+
+Ft9201Press *
+ft9201_press_new (const guint8 *raw, int width, int height)
+{
+  Ft9201Press *p = press_prepare (raw, width, height);
+  g_autofree double *theta = NULL;
+  g_autofree double *enh = NULL;
+
+  if (!p)
+    return NULL;
+
+  theta = g_new (double, width * height);
+  enh = g_new (double, width * height);
+  orientation (p->norm, height, width, theta);
+  p->period = ridge_period (p->norm, p->mask, height, width);
+  enhance (p->norm, p->mask, theta, p->period, height, width, enh);
+  p->n_minutiae = find_minutiae (enh, p->detect, theta, height, width, p->minutiae);
+  return p;
+}
+
+Ft9201Press *
+ft9201_press_new_with_minutiae (const guint8        *raw,
+                                int                  width,
+                                int                  height,
+                                const Ft9201Minutia *minutiae,
+                                int                  n_minutiae)
+{
+  Ft9201Press *p;
+
+  g_return_val_if_fail (n_minutiae >= 0 && n_minutiae <= FT9201_MATCH_MAX_MINUTIAE, NULL);
+
+  p = press_prepare (raw, width, height);
+  if (!p)
+    return NULL;
+  memcpy (p->minutiae, minutiae, n_minutiae * sizeof (Ft9201Minutia));
+  p->n_minutiae = n_minutiae;
+  return p;
+}
+
+void
+ft9201_press_free (Ft9201Press *press)
+{
+  if (!press)
+    return;
+  for (int i = 0; i < ANGLE_SLOTS; i++)
+    {
+      g_free (press->spectra[i]);
+      g_free (press->rot_detect[i]);
+    }
+  g_free (press->raw);
+  g_free (press->norm);
+  g_free (press->mask);
+  g_free (press->detect);
+  g_free (press);
+}
+
+const Ft9201Minutia *
+ft9201_press_get_minutiae (const Ft9201Press *press, int *n_minutiae)
+{
+  *n_minutiae = press->n_minutiae;
+  return press->minutiae;
+}
+
+double
+ft9201_press_get_coverage (const Ft9201Press *press)
+{
+  double sum = 0;
+
+  for (int i = 0; i < press->width * press->height; i++)
+    sum += press->mask[i];
+  return sum / (press->width * press->height);
+}
+
+/* Spectra of mask, image * mask and image^2 * mask, of the press turned by
+ * angle; 6 * N * N floats, made once per angle and kept. */
+static const float *
+press_spectra (Ft9201Press *p, int angle)
+{
+  int slot = angle + ANGLE_REACH;
+  int h = p->height, w = p->width;
+
+  g_assert (slot >= 0 && slot < ANGLE_SLOTS);
+  if (!p->spectra[slot])
+    {
+      g_autofree double *img = g_new (double, h * w);
+      g_autofree double *mask = g_new (double, h * w);
+      g_autofree double *term = g_new (double, h * w);
+      float *s = g_new (float, 6 * N * N);
+      g_autofree float *m = NULL;
+      g_autofree float *i1 = NULL;
+      g_autofree float *i2 = NULL;
+
+      if (angle == 0)
+        {
+          memcpy (img, p->norm, h * w * sizeof (double));
+          memcpy (mask, p->mask, h * w * sizeof (double));
+        }
+      else
+        {
+          rotate (p->norm, p->mask, h, w, angle, img, mask);
+        }
+
+      m = spectrum_of (mask, h, w);
+      for (int i = 0; i < h * w; i++)
+        term[i] = img[i] * mask[i];
+      i1 = spectrum_of (term, h, w);
+      for (int i = 0; i < h * w; i++)
+        term[i] = img[i] * img[i] * mask[i];
+      i2 = spectrum_of (term, h, w);
+      memcpy (s, m, 2 * N * N * sizeof (float));
+      memcpy (s + 2 * N * N, i1, 2 * N * N * sizeof (float));
+      memcpy (s + 4 * N * N, i2, 2 * N * N * sizeof (float));
+      p->spectra[slot] = s;
+    }
+  return p->spectra[slot];
+}
+
+static const double *
+press_rotated_detect (Ft9201Press *p, int angle)
+{
+  int slot = angle + ANGLE_REACH;
+
+  g_assert (slot >= 0 && slot < ANGLE_SLOTS);
+  if (!p->rot_detect[slot])
+    {
+      double *d = g_new (double, p->height * p->width);
+
+      if (angle == 0)
+        memcpy (d, p->detect, p->height * p->width * sizeof (double));
+      else
+        rotate (p->detect, p->detect, p->height, p->width, angle, NULL, d);
+      p->rot_detect[slot] = d;
+    }
+  return p->rot_detect[slot];
+}
+
+/* ------------------------------------------------------------------ */
+/* Comparison                                                          */
+/* ------------------------------------------------------------------ */
+
+/* conj(a) * b + i conj(c) * d, as re and im planes; its inverse transform
+ * is corr(a, b) + i corr(c, d), both real. */
+static void
+packed_product (const float *a, const float *b, const float *c, const float *d,
+                float *re, float *im)
+{
+  const int nn = N * N;
+
+  for (int i = 0; i < nn; i++)
+    {
+      float p_re = a[i] * b[i] + a[nn + i] * b[nn + i];
+      float p_im = a[i] * b[nn + i] - a[nn + i] * b[i];
+      float q_re = c[i] * d[i] + c[nn + i] * d[nn + i];
+      float q_im = c[i] * d[nn + i] - c[nn + i] * d[i];
+
+      re[i] = p_re - q_im;
+      im[i] = p_im + q_re;
+    }
+}
+
+/* Best masked NCC over shifts within RADIUS, for the probe at one angle.
+ * scratch holds 6 * N * N floats. */
+static void
+best_shift (const float *t, const float *p, int min_overlap, float *scratch,
+            double *score, int *dy_out, int *dx_out, int *overlap)
+{
+  const int nn = N * N;
+  float *n = scratch, *st = scratch + nn;
+  float *sp = scratch + 2 * nn, *sp2 = scratch + 3 * nn;
+  float *st2 = scratch + 4 * nn, *stp = scratch + 5 * nn;
+  const float *tm = t, *ti = t + 2 * nn, *ti2 = t + 4 * nn;
+  const float *pm = p, *pi = p + 2 * nn, *pi2 = p + 4 * nn;
+
+  packed_product (tm, pm, ti, pm, n, st);
+  fft_2d_inverse_near_origin (n, st);
+  packed_product (tm, pi, tm, pi2, sp, sp2);
+  fft_2d_inverse_near_origin (sp, sp2);
+  packed_product (ti2, pm, ti, pi, st2, stp);
+  fft_2d_inverse_near_origin (st2, stp);
+
+  *score = -2.0;
+  for (int dy = -RADIUS; dy <= RADIUS; dy++)
+    for (int dx = -RADIUS; dx <= RADIUS; dx++)
+      {
+        int i = ((dy + N) % N) * N + (dx + N) % N;
+        double cnt = rint (n[i]);
+        double nn_ = MAX (cnt, 1);
+        double num = stp[i] - (double) st[i] * sp[i] / nn_;
+        double den = sqrt (MAX (st2[i] - (double) st[i] * st[i] / nn_, 1e-9) *
+                           MAX (sp2[i] - (double) sp[i] * sp[i] / nn_, 1e-9));
+        double v = cnt >= min_overlap ? num / den : -1.0;
+
+        if (v > *score)
+          {
+            *score = v;
+            *dy_out = dy;
+            *dx_out = dx;
+            *overlap = (int) cnt;
+          }
+      }
+}
+
+static double
+angle_diff (double a, double b)
+{
+  double d = fmod (fabs (a - b), G_PI);
+
+  return MIN (d, G_PI - d);
+}
+
+/* Python's round(): halves go to the even neighbour. */
+static int
+round_half_even (double v)
+{
+  return (int) rint (v);
+}
+
+static void
+pair_minutiae (const Ft9201Press *tmpl, const Ft9201Press *probe, int angle,
+               const double *probe_detect, int dy, int dx, Ft9201Comparison *out)
+{
+  int h = tmpl->height, w = tmpl->width;
+  double a = angle * G_PI / 180.0;
+  double ca = cos (a), sa = sin (a);
+  double cy = (h - 1) / 2.0, cx = (w - 1) / 2.0;
+  gboolean used[FT9201_MATCH_MAX_MINUTIAE] = { FALSE };
+
+  out->paired = out->lonely_probe = out->lonely_tmpl = 0;
+
+  for (int i = 0; i < probe->n_minutiae; i++)
+    {
+      const Ft9201Minutia *m = &probe->minutiae[i];
+      /* Where the minutia lands once the probe is turned, then in the
+       * enrolled press's frame. */
+      double yr = cy + ca * (m->y - cy) + sa * (m->x - cx);
+      double xr = cx - sa * (m->y - cy) + ca * (m->x - cx);
+      double dir = fmod (m->dir + a, G_PI);
+      double x = xr - dx, y = yr - dy;
+      double best = MATCH_DIST;
+      int best_j = -1;
+
+      if (dir < 0)
+        dir += G_PI;
+
+      for (int j = 0; j < tmpl->n_minutiae; j++)
+        {
+          const Ft9201Minutia *t = &tmpl->minutiae[j];
+          double dist;
+
+          if (used[j])
+            continue;
+          dist = hypot (t->x - x, t->y - y);
+          if (dist <= best && angle_diff (t->dir, dir) <= MATCH_ANGLE)
+            {
+              best = dist;
+              best_j = j;
+            }
+        }
+
+      if (best_j >= 0)
+        {
+          used[best_j] = TRUE;
+          out->paired++;
+        }
+      else
+        {
+          int xi = round_half_even (x), yi = round_half_even (y);
+
+          if (xi >= 0 && xi < w && yi >= 0 && yi < h && tmpl->detect[yi * w + xi] > 0)
+            out->lonely_probe++;
+        }
+    }
+
+  for (int j = 0; j < tmpl->n_minutiae; j++)
+    {
+      int xi, yi;
+
+      if (used[j])
+        continue;
+      xi = round_half_even (tmpl->minutiae[j].x + dx);
+      yi = round_half_even (tmpl->minutiae[j].y + dy);
+      if (xi >= 0 && xi < w && yi >= 0 && yi < h && probe_detect[yi * w + xi] > 0)
+        out->lonely_tmpl++;
+    }
+}
+
+typedef struct
+{
+  double score;
+  int    angle, dy, dx, overlap;
+} Pose;
+
+static void
+try_angle (const float *t, Ft9201Press *probe, int angle, int min_overlap,
+           float *scratch, Pose *best)
+{
+  Pose p = { -2.0, angle, 0, 0, 0 };
+
+  best_shift (t, press_spectra (probe, angle), min_overlap, scratch,
+              &p.score, &p.dy, &p.dx, &p.overlap);
+  if (p.score > best->score)
+    *best = p;
+}
+
+void
+ft9201_compare (Ft9201Press *tmpl, Ft9201Press *probe, Ft9201Comparison *out)
+{
+  int min_overlap = (int) ceil (MIN_OVERLAP_FRACTION * tmpl->width * tmpl->height);
+  g_autofree float *scratch = g_new (float, 6 * N * N);
+  const float *t;
+  Pose best = { -2.0, 0, 0, 0, 0 };
+
+  g_return_if_fail (tmpl->width == probe->width && tmpl->height == probe->height);
+
+  t = press_spectra (tmpl, 0);
+
+  for (int angle = -ANGLE_LIMIT; angle <= ANGLE_LIMIT; angle += ANGLE_COARSE)
+    try_angle (t, probe, angle, min_overlap, scratch, &best);
+
+  if (best.score >= COARSE_SKIP)
+    {
+      for (int step = ANGLE_COARSE / 2; step >= ANGLE_COARSE / 4; step /= 2)
+        {
+          int centre = best.angle;
+
+          try_angle (t, probe, centre - step, min_overlap, scratch, &best);
+          try_angle (t, probe, centre + step, min_overlap, scratch, &best);
+        }
+    }
+
+  out->score = best.score;
+  out->angle = best.angle;
+  out->dy = best.dy;
+  out->dx = best.dx;
+  out->overlap = best.overlap;
+
+  if (best.score < COARSE_SKIP)
+    {
+      /* Too far from aligned for its minutiae to count. */
+      out->paired = out->lonely_probe = out->lonely_tmpl = 0;
+      return;
+    }
+  pair_minutiae (tmpl, probe, best.angle, press_rotated_detect (probe, best.angle),
+                 best.dy, best.dx, out);
+}
+
+void
+ft9201_press_drop_rotations (Ft9201Press *press)
+{
+  for (int i = 0; i < ANGLE_SLOTS; i++)
+    {
+      if (i != ANGLE_REACH)
+        g_clear_pointer (&press->spectra[i], g_free);
+      g_clear_pointer (&press->rot_detect[i], g_free);
+    }
+}
+
+gboolean
+ft9201_press_is_enrollable (const Ft9201Press *press)
+{
+  return ft9201_press_get_coverage (press) >= COVERAGE_MIN;
+}
+
+gboolean
+ft9201_comparison_links (const Ft9201Comparison *cmp)
+{
+  return cmp->score >= ALIGNED &&
+         cmp->paired - cmp->lonely_probe - cmp->lonely_tmpl >= LINK_MARGIN;
+}
+
+gboolean
+ft9201_press_is_usable (const Ft9201Press *probe)
+{
+  return ft9201_press_get_coverage (probe) >= COVERAGE_MIN &&
+         probe->n_minutiae >= MIN_PROBE_MINUTIAE;
+}
+
+int
+ft9201_evidence (const Ft9201Comparison *cmps, int n_cmps)
+{
+  int first = MARGIN_FLOOR, second = MARGIN_FLOOR;
+
+  for (int i = 0; i < n_cmps; i++)
+    {
+      int margin;
+
+      if (cmps[i].score < ALIGNED)
+        continue;
+      margin = MAX (cmps[i].paired - cmps[i].lonely_probe - cmps[i].lonely_tmpl, MARGIN_FLOOR);
+      if (margin > first)
+        {
+          second = first;
+          first = margin;
+        }
+      else if (margin > second)
+        {
+          second = margin;
+        }
+    }
+
+  return first + second;
+}
+
+gboolean
+ft9201_evidence_accepts (int evidence)
+{
+  return evidence >= ACCEPT_SUM;
+}
+
+/* ------------------------------------------------------------------ */
+/* Prints                                                              */
+/* ------------------------------------------------------------------ */
+
+GVariant *
+ft9201_print_data_new (Ft9201Press *const *presses, int n_presses)
+{
+  GVariantBuilder builder;
+
+  g_return_val_if_fail (n_presses > 0 && n_presses <= FT9201_PRINT_MAX_PRESSES, NULL);
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("a(aya(dddy))"));
+  for (int i = 0; i < n_presses; i++)
+    {
+      const Ft9201Press *p = presses[i];
+      GVariantBuilder mins;
+
+      g_return_val_if_fail (p->width == presses[0]->width &&
+                            p->height == presses[0]->height, NULL);
+      g_variant_builder_init (&mins, G_VARIANT_TYPE ("a(dddy)"));
+      for (int j = 0; j < p->n_minutiae; j++)
+        g_variant_builder_add (&mins, "(dddy)", p->minutiae[j].x, p->minutiae[j].y,
+                               p->minutiae[j].dir, (guint8) p->minutiae[j].kind);
+      g_variant_builder_add (&builder, "(@aya(dddy))",
+                             g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, p->raw,
+                                                        p->width * p->height, 1),
+                             &mins);
+    }
+
+  return g_variant_new (FT9201_PRINT_FORMAT, (guint8) FT9201_PRINT_VERSION,
+                        (guint16) presses[0]->width, (guint16) presses[0]->height,
+                        &builder);
+}
+
+/* Nothing in a print is trusted: it is read back from disk. */
+GPtrArray *
+ft9201_print_data_load (GVariant *data, int width, int height)
+{
+  g_autoptr(GPtrArray) out = NULL;
+  g_autoptr(GVariant) presses = NULL;
+  guint8 version;
+  guint16 w, h;
+  gsize n;
+
+  if (data == NULL || !g_variant_is_of_type (data, G_VARIANT_TYPE (FT9201_PRINT_FORMAT)))
+    return NULL;
+
+  g_variant_get (data, "(yqq@a(aya(dddy)))", &version, &w, &h, &presses);
+  if (version != FT9201_PRINT_VERSION || w != width || h != height ||
+      w <= 2 * DETECT_BORDER || w > N || h <= 2 * DETECT_BORDER || h > N)
+    return NULL;
+
+  n = g_variant_n_children (presses);
+  if (n == 0 || n > FT9201_PRINT_MAX_PRESSES)
+    return NULL;
+
+  out = g_ptr_array_new_with_free_func ((GDestroyNotify) ft9201_press_free);
+  for (gsize i = 0; i < n; i++)
+    {
+      g_autoptr(GVariant) raw_v = NULL;
+      g_autoptr(GVariant) mins_v = NULL;
+      Ft9201Minutia mins[FT9201_MATCH_MAX_MINUTIAE];
+      Ft9201Press *press;
+      const guint8 *raw;
+      gsize raw_len, n_mins;
+
+      g_variant_get_child (presses, i, "(@ay@a(dddy))", &raw_v, &mins_v);
+      raw = g_variant_get_fixed_array (raw_v, &raw_len, 1);
+      n_mins = g_variant_n_children (mins_v);
+      if (raw_len != (gsize) w * h || n_mins > FT9201_MATCH_MAX_MINUTIAE)
+        return NULL;
+
+      for (gsize j = 0; j < n_mins; j++)
+        {
+          double x, y, dir;
+          guint8 kind;
+
+          g_variant_get_child (mins_v, j, "(dddy)", &x, &y, &dir, &kind);
+          if (!isfinite (x) || !isfinite (y) || !isfinite (dir) ||
+              x < 0 || x >= w || y < 0 || y >= h || dir < 0 || dir > G_PI ||
+              (kind != 1 && kind != 3))
+            return NULL;
+          mins[j] = (Ft9201Minutia){ x, y, dir, kind };
+        }
+
+      press = ft9201_press_new_with_minutiae (raw, w, h, mins, n_mins);
+      if (press == NULL)
+        return NULL;
+      g_ptr_array_add (out, press);
+    }
+
+  return g_steal_pointer (&out);
+}
