diff --git a/tests/test-focaltech-moh-match.c b/tests/test-focaltech-moh-match.c
new file mode 100644
index 00000000..5a300877
--- /dev/null
+++ b/tests/test-focaltech-moh-match.c
@@ -0,0 +1,374 @@
+/*
+ * Unit tests of the focaltech_moh matcher
+ *
+ * Copyright (C) 2026 Arsslen Idadi
+ *
