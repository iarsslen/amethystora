+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <math.h>
+#include <glib.h>
+
+#include "drivers/focaltech_moh/focaltech_moh_match.h"
+
+#define W 96
+#define H 96
+#define FRAME (W * H)
+#define N_ENROLL 15
+#define N_PROBES 6
+#define FIRST_GENUINE N_ENROLL
+#define FIRST_IMPOSTOR (FIRST_GENUINE + N_PROBES)
+#define FIRST_TWIN (FIRST_IMPOSTOR + N_PROBES)
+
+/* Synthetic presses, see focaltech_moh-match/README.md. */
+static GBytes * presses;
+
+static const guint8 *
+frame (int i)
+{
+  gsize size;
+  const guint8 *data = g_bytes_get_data (presses, &size);
+
+  g_assert_cmpuint (size, ==, (FIRST_TWIN + N_PROBES) * FRAME);
+  return data + i * FRAME;
+}
+
+static GPtrArray *
+enrol (void)
+{
+  GPtrArray *out = g_ptr_array_new_with_free_func ((GDestroyNotify) ft9201_press_free);
+
+  for (int i = 0; i < N_ENROLL; i++)
+    g_ptr_array_add (out, ft9201_press_new (frame (i), W, H));
+  return out;
+}
+
+static int
+evidence (GPtrArray *enrolled, Ft9201Press *probe)
+{
+  g_autofree Ft9201Comparison *cmps = g_new (Ft9201Comparison, enrolled->len);
+
+  for (guint i = 0; i < enrolled->len; i++)
+    ft9201_compare (g_ptr_array_index (enrolled, i), probe, &cmps[i]);
+  return ft9201_evidence (cmps, enrolled->len);
+}
+
+static void
+test_genuine (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+
+  for (int i = FIRST_GENUINE; i < FIRST_GENUINE + N_PROBES; i++)
+    {
+      g_autoptr(Ft9201Press) probe = ft9201_press_new (frame (i), W, H);
+
+      g_assert_true (ft9201_press_is_usable (probe));
+      g_assert_true (ft9201_evidence_accepts (evidence (enrolled, probe)));
+    }
+}
+
+static void
+test_impostors (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+
+  for (int i = FIRST_IMPOSTOR; i < FIRST_TWIN + N_PROBES; i++)
+    {
+      g_autoptr(Ft9201Press) probe = ft9201_press_new (frame (i), W, H);
+
+      g_assert_false (ft9201_evidence_accepts (evidence (enrolled, probe)));
+    }
+}
+
+/* Parallel ridges at the finger's own spacing line up with any press of it
+ * once angle, spacing and phase are tuned, which is what a correlation
+ * search does. They carry no minutiae, so they must never be accepted. */
+static void
+test_parallel_ridges (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+
+  for (int k = 0; k < 8; k++)
+    {
+      guint8 grating[FRAME];
+      double angle = k * G_PI / 8, period = 8.0 + 0.5 * k;
+      g_autoptr(Ft9201Press) probe = NULL;
+
+      for (int y = 0; y < H; y++)
+        for (int x = 0; x < W; x++)
+          grating[y * W + x] = 128 + 60 * cos (2 * G_PI * (x * cos (angle) + y * sin (angle)) / period);
+      probe = ft9201_press_new (grating, W, H);
+      g_assert_false (ft9201_press_is_usable (probe) &&
+                      ft9201_evidence_accepts (evidence (enrolled, probe)));
+    }
+}
+
+static void
+test_degenerate_frames (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+  guint8 f[FRAME];
+
+  for (int kind = 0; kind < 4; kind++)
+    {
+      g_autoptr(Ft9201Press) probe = NULL;
+
+      for (int i = 0; i < FRAME; i++)
+        f[i] = kind == 0 ? 0 : kind == 1 ? 255 : kind == 2 ? 128 : g_test_rand_int_range (0, 256);
+      probe = ft9201_press_new (f, W, H);
+      g_assert_nonnull (probe);
+      /* A flat frame shows no ridges. Enhanced noise does look like ridges,
+       * with minutiae, so it may be usable; it must still never match. */
+      if (kind < 3)
+        g_assert_false (ft9201_press_is_usable (probe));
+      /* Comparing it anyway must be safe, and find nothing. */
+      g_assert_false (ft9201_evidence_accepts (evidence (enrolled, probe)));
+    }
+}
+
+/* Every enrolled press links to another, and no press of another finger
+ * links to any of them: enrolment groups presses by these links. */
+static void
+test_enrol_links (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+
+  for (int i = 0; i < N_ENROLL; i++)
+    {
+      g_autoptr(Ft9201Press) probe = ft9201_press_new (frame (i), W, H);
+      gboolean linked = FALSE;
+
+      for (int j = 0; j < N_ENROLL && !linked; j++)
+        {
+          Ft9201Comparison cmp;
+
+          if (i == j)
+            continue;
+          ft9201_compare (g_ptr_array_index (enrolled, j), probe, &cmp);
+          linked = ft9201_comparison_links (&cmp);
+        }
+      g_assert_true (linked);
+    }
+
+  for (int i = FIRST_IMPOSTOR; i < FIRST_TWIN + N_PROBES; i++)
+    {
+      g_autoptr(Ft9201Press) probe = ft9201_press_new (frame (i), W, H);
+
+      for (int j = 0; j < N_ENROLL; j++)
+        {
+          Ft9201Comparison cmp;
+
+          ft9201_compare (g_ptr_array_index (enrolled, j), probe, &cmp);
+          g_assert_false (ft9201_comparison_links (&cmp));
+        }
+    }
+}
+
+static GVariant *
+enrolled_print (GPtrArray *enrolled)
+{
+  return g_variant_ref_sink (ft9201_print_data_new ((Ft9201Press *const *) enrolled->pdata,
+                                                    enrolled->len));
+}
+
+static void
+test_print_roundtrip (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+  g_autoptr(GVariant) data = enrolled_print (enrolled);
+  g_autoptr(GPtrArray) loaded = ft9201_print_data_load (data, W, H);
+
+  g_assert_nonnull (loaded);
+  g_assert_cmpuint (loaded->len, ==, enrolled->len);
+  for (guint i = 0; i < loaded->len; i++)
+    {
+      int n_a, n_b;
+      const Ft9201Minutia *a = ft9201_press_get_minutiae (g_ptr_array_index (enrolled, i), &n_a);
+      const Ft9201Minutia *b = ft9201_press_get_minutiae (g_ptr_array_index (loaded, i), &n_b);
+
+      g_assert_cmpint (n_a, ==, n_b);
+      for (int j = 0; j < n_a; j++)
+        {
+          g_assert_cmpfloat (a[j].x, ==, b[j].x);
+          g_assert_cmpfloat (a[j].y, ==, b[j].y);
+          g_assert_cmpfloat (a[j].dir, ==, b[j].dir);
+          g_assert_cmpint (a[j].kind, ==, b[j].kind);
+        }
+    }
+
+  /* The size must be the device's. */
+  g_assert_null (ft9201_print_data_load (data, 64, 80));
+
+  for (int i = FIRST_GENUINE; i < FIRST_GENUINE + N_PROBES; i++)
+    {
+      g_autoptr(Ft9201Press) p1 = ft9201_press_new (frame (i), W, H);
+      g_autoptr(Ft9201Press) p2 = ft9201_press_new (frame (i), W, H);
+
+      g_assert_cmpint (evidence (enrolled, p1), ==, evidence (loaded, p2));
+    }
+}
+
+/* One press of the format, with the given fields. */
+static GVariant *
+crafted_print (guint8 version, guint16 w, guint16 h, int n_presses, gsize raw_len,
+               int n_minutiae, double x, double y, double dir, guint8 kind)
+{
+  GVariantBuilder presses_b;
+  g_autofree guint8 *raw = g_malloc0 (raw_len);
+
+  g_variant_builder_init (&presses_b, G_VARIANT_TYPE ("a(aya(dddy))"));
+  for (int p = 0; p < n_presses; p++)
+    {
+      GVariantBuilder mins;
+
+      g_variant_builder_init (&mins, G_VARIANT_TYPE ("a(dddy)"));
+      for (int m = 0; m < n_minutiae; m++)
+        g_variant_builder_add (&mins, "(dddy)", x, y, dir, kind);
+      g_variant_builder_add (&presses_b, "(@aya(dddy))",
+                             g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, raw, raw_len, 1),
+                             &mins);
+    }
+  return g_variant_ref_sink (g_variant_new (FT9201_PRINT_FORMAT, version, w, h, &presses_b));
+}
+
+static void
+test_print_rejects (void)
+{
+  struct
+  {
+    const char *what;
+    GVariant   *data;
+    gboolean    valid;
+  } cases[] = {
+    { "valid", crafted_print (2, W, H, 1, FRAME, 2, 40, 40, 1, 1), TRUE },
+    { "old version", crafted_print (1, W, H, 1, FRAME, 2, 40, 40, 1, 1), FALSE },
+    { "future version", crafted_print (3, W, H, 1, FRAME, 2, 40, 40, 1, 1), FALSE },
+    { "other size", crafted_print (2, 64, 80, 1, 64 * 80, 2, 40, 40, 1, 1), FALSE },
+    { "no presses", crafted_print (2, W, H, 0, FRAME, 0, 0, 0, 0, 1), FALSE },
+    { "too many presses", crafted_print (2, W, H, FT9201_PRINT_MAX_PRESSES + 1, FRAME, 0, 0, 0, 0, 1), FALSE },
+    { "short frame", crafted_print (2, W, H, 1, FRAME - 1, 0, 0, 0, 0, 1), FALSE },
+    { "long frame", crafted_print (2, W, H, 1, FRAME + 1, 0, 0, 0, 0, 1), FALSE },
+    { "too many minutiae", crafted_print (2, W, H, 1, FRAME, FT9201_MATCH_MAX_MINUTIAE + 1, 40, 40, 1, 1), FALSE },
+    { "minutia NaN", crafted_print (2, W, H, 1, FRAME, 1, NAN, 40, 1, 1), FALSE },
+    { "minutia infinite", crafted_print (2, W, H, 1, FRAME, 1, 40, INFINITY, 1, 1), FALSE },
+    { "minutia left of frame", crafted_print (2, W, H, 1, FRAME, 1, -1, 40, 1, 1), FALSE },
+    { "minutia below frame", crafted_print (2, W, H, 1, FRAME, 1, 40, H, 1, 1), FALSE },
+    { "direction negative", crafted_print (2, W, H, 1, FRAME, 1, 40, 40, -0.1, 1), FALSE },
+    { "direction past pi", crafted_print (2, W, H, 1, FRAME, 1, 40, 40, 3.2, 1), FALSE },
+    { "unknown kind", crafted_print (2, W, H, 1, FRAME, 1, 40, 40, 1, 2), FALSE },
+    { "wrong type", g_variant_ref_sink (g_variant_new ("(ya(ay))", 1, NULL)), FALSE },
+  };
+
+  for (guint i = 0; i < G_N_ELEMENTS (cases); i++)
+    {
+      g_autoptr(GPtrArray) loaded = ft9201_print_data_load (cases[i].data, W, H);
+
+      g_test_message ("%s", cases[i].what);
+      g_assert_true ((loaded != NULL) == cases[i].valid);
+      g_variant_unref (cases[i].data);
+    }
+
+  g_assert_null (ft9201_print_data_load (NULL, W, H));
+}
+
+/* Corrupted copies of a real print: loading must never crash, and whatever
+ * it accepts must be usable. Run under a sanitiser this checks the reader. */
+static void
+test_print_fuzz (void)
+{
+  g_autoptr(GPtrArray) enrolled = enrol ();
+  g_autoptr(GVariant) data = enrolled_print (enrolled);
+  g_autoptr(Ft9201Press) probe = ft9201_press_new (frame (FIRST_GENUINE), W, H);
+  gsize size = g_variant_get_size (data);
+  const guint8 *orig = g_variant_get_data (data);
+
+  for (int round = 0; round < 300; round++)
+    {
+      g_autofree guint8 *copy = g_memdup2 (orig, size);
+      g_autoptr(GBytes) bytes = NULL;
+      g_autoptr(GVariant) bad = NULL;
+      g_autoptr(GPtrArray) loaded = NULL;
+      int flips = g_test_rand_int_range (1, 16);
+      gsize len = size;
+
+      for (int i = 0; i < flips; i++)
+        copy[g_test_rand_int_range (0, size)] = g_test_rand_int_range (0, 256);
+      /* Sometimes cut it short too. */
+      if (g_test_rand_bit ())
+        len = g_test_rand_int_range (0, size);
+
+      bytes = g_bytes_new_take (g_steal_pointer (&copy), len);
+      bad = g_variant_ref_sink (g_variant_new_from_bytes (G_VARIANT_TYPE (FT9201_PRINT_FORMAT),
+                                                          bytes, FALSE));
+      loaded = ft9201_print_data_load (bad, W, H);
+      if (loaded)
+        evidence (loaded, probe);
+    }
+}
+
+/* The presses of 2808:9338 and 2808:9348 are 64x80. */
+static void
+test_small_frames (void)
+{
+  g_autoptr(GPtrArray) enrolled = g_ptr_array_new_with_free_func ((GDestroyNotify) ft9201_press_free);
+  guint8 crop[64 * 80];
+
+  for (int i = 0; i < N_ENROLL + N_PROBES; i++)
+    {
+      for (int y = 0; y < 80; y++)
+        for (int x = 0; x < 64; x++)
+          crop[y * 64 + x] = frame (i)[(y + 8) * W + x + 16];
+
+      if (i < N_ENROLL)
+        {
+          g_ptr_array_add (enrolled, ft9201_press_new (crop, 64, 80));
+        }
+      else
+        {
+          g_autoptr(Ft9201Press) probe = ft9201_press_new (crop, 64, 80);
+
+          evidence (enrolled, probe);
+        }
+    }
+}
+
+int
+main (int argc, char *argv[])
+{
+  g_autofree char *path = NULL;
+
+  g_autoptr(GError) error = NULL;
+  char *contents;
+  gsize len;
+
+  g_test_init (&argc, &argv, NULL);
+
+  path = g_test_build_filename (G_TEST_DIST, "focaltech_moh-match", "presses.raw", NULL);
+  if (!g_file_get_contents (path, &contents, &len, &error))
+    g_error ("%s", error->message);
+  presses = g_bytes_new_take (contents, len);
+
+  g_test_add_func ("/focaltech_moh/match/genuine", test_genuine);
+  g_test_add_func ("/focaltech_moh/match/impostors", test_impostors);
+  g_test_add_func ("/focaltech_moh/match/parallel-ridges", test_parallel_ridges);
+  g_test_add_func ("/focaltech_moh/match/degenerate-frames", test_degenerate_frames);
+  g_test_add_func ("/focaltech_moh/match/enrol-links", test_enrol_links);
+  g_test_add_func ("/focaltech_moh/print/roundtrip", test_print_roundtrip);
+  g_test_add_func ("/focaltech_moh/print/rejects", test_print_rejects);
+  g_test_add_func ("/focaltech_moh/print/fuzz", test_print_fuzz);
+  g_test_add_func ("/focaltech_moh/match/small-frames", test_small_frames);
+
+  return g_test_run ();
+}
