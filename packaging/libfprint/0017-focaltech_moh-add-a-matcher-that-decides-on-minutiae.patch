+++ b/libfprint/drivers/focaltech_moh/focaltech_moh_match.h
@@ -0,0 +1,112 @@
+/*
+ * FocalTech FT9201 matcher: alignment by masked correlation, decision on
+ * minutiae.
+ *
+ * Copyright (C) 2026 Arsslen Idadi
+ *
