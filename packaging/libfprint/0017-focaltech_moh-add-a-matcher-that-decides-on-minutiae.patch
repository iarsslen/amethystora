+        dependencies: [ libfprint_private_dep, mathlib_dep ],
+        c_args: common_cflags,
+        link_with: libfprint_drivers,
+        install: false,
+    )
+    test('focaltech-moh-match',
+        focaltech_moh_match_test,
+        suite: ['unit-tests'],
+        env: envs,
+        timeout: 120,
+    )
+endif
