 /* ------------------------------------------------------------------ */
 /* Enroll state machine                                                */
 /* ------------------------------------------------------------------ */
 
+/* Every usable press is kept, with the earlier presses it links to. The
+ * presses linked together, directly or through others, show one finger;
+ * enrolment is as far along as the largest such group, and ends once it
+ * holds FT9201_NUM_ENROLL_STAGES. A press of another finger never joins
+ * it, nor does a first press that the following ones do not overlap. */
+static int
+ft9201_largest_group (FpiDeviceFocaltechMoh *self, int *members)
+{
+  int group[FT9201_MAX_PRESSES];
+  int best = -1, best_size = 0;
+
+  for (int i = 0; i < self->n_presses; i++)
+    group[i] = -1;
+
+  for (int start = 0; start < self->n_presses; start++)
+    {
+      int stack[FT9201_MAX_PRESSES], top = 0, size = 0;
+
+      if (group[start] >= 0)
+        continue;
+      group[start] = start;
+      stack[top++] = start;
+      while (top > 0)
+        {
+          int i = stack[--top];
+
+          size++;
+          for (int j = 0; j < self->n_presses; j++)
+            if (group[j] < 0 && self->links[i][j])
+              {
+                group[j] = start;
+                stack[top++] = j;
+              }
+        }
+      if (size > best_size)
+        {
+          best = start;
+          best_size = size;
+        }
+    }
+
+  if (members)
+    {
+      int n = 0;
+
+      for (int i = 0; i < self->n_presses; i++)
+        if (group[i] == best)
+          members[n++] = i;
+    }
+
+  return best_size;
+}
