-                sum += ~src[ky * w + kx] & 0xFF;
-                count++;
-              }
-
-          int diff = val - sum / count + 128;
-
-          dst[y * w + x] = (guint8) CLAMP (diff, 0, 255);
-        }
-    }
-}
