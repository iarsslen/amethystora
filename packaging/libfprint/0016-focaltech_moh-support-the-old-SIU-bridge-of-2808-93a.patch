+/* ------------------------------------------------------------------ */
+/* Old SIU bridge (2808:93a9)                                          */
+/* ------------------------------------------------------------------ */
+
+static void
+ft9201_next_state_delayed_cb (FpiUsbTransfer *transfer,
+                              FpDevice       *dev,
+                              gpointer        user_data,
+                              GError         *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  fpi_ssm_next_state_delayed (transfer->ssm, GPOINTER_TO_INT (user_data));
+}
+
+static void
+ft9201_ctrl_out_delayed (FpDevice *dev,
+                         FpiSsm   *ssm,
+                         guint8    request,
+                         guint16   value,
+                         guint16   index,
+                         int       delay_ms)
+{
+  FpiUsbTransfer *transfer = fpi_usb_transfer_new (dev);
+
+  transfer->ssm = ssm;
+  fpi_usb_transfer_fill_control (transfer,
+                                 G_USB_DEVICE_DIRECTION_HOST_TO_DEVICE,
+                                 G_USB_DEVICE_REQUEST_TYPE_VENDOR,
+                                 G_USB_DEVICE_RECIPIENT_DEVICE,
+                                 request, value, index, 0);
+  fpi_usb_transfer_submit (transfer, FT9201_CMD_TIMEOUT,
+                           fpi_device_get_cancellable (dev),
+                           ft9201_next_state_delayed_cb,
+                           GINT_TO_POINTER (delay_ms));
+}
+
+/* Reads an AFE register; the reply carries it and the register after it. */
+static void
+ft9201_afe_read (FpDevice              *dev,
+                 FpiSsm                *ssm,
+                 guint8                 reg,
+                 FpiUsbTransferCallback callback)
+{
+  FpiUsbTransfer *transfer = fpi_usb_transfer_new (dev);
+
+  transfer->ssm = ssm;
+  fpi_usb_transfer_fill_control (transfer,
+                                 G_USB_DEVICE_DIRECTION_DEVICE_TO_HOST,
+                                 G_USB_DEVICE_REQUEST_TYPE_VENDOR,
+                                 G_USB_DEVICE_RECIPIENT_DEVICE,
+                                 FT9201_REQ_AFE_READ, 0, reg, 4);
+  fpi_usb_transfer_submit (transfer, FT9201_CMD_TIMEOUT,
+                           fpi_device_get_cancellable (dev),
+                           callback, NULL);
+}
+
+static gboolean
+ft9201_afe_reply_ok (FpiUsbTransfer *transfer,
+                     GError         *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return FALSE;
+    }
+
+  if (transfer->actual_length < 2)
+    {
+      fpi_ssm_mark_failed (transfer->ssm,
+                           fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                     "Short AFE register reply (%" G_GSSIZE_FORMAT " bytes)",
+                                                     transfer->actual_length));
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static gboolean
+ft9201_mcu_awake (const guint8 *reply)
+{
+  return reply[0] == 0xA5 && reply[1] == 0x5A;
+}
+
+static void
+open_old_reply_cb (FpiUsbTransfer *transfer,
+                   FpDevice       *dev,
+                   gpointer        user_data,
+                   GError         *error)
+{
+  FpiDeviceFocaltechMoh *self = FPI_DEVICE_FOCALTECH_MOH (dev);
+  const guint8 *reply = transfer->buffer;
+
+  if (!ft9201_afe_reply_ok (transfer, error))
+    return;
+
+  switch (fpi_ssm_get_cur_state (transfer->ssm))
+    {
+    case OPEN_OLD_MCU:
+      if (ft9201_mcu_awake (reply))
+        {
+          fpi_ssm_next_state (transfer->ssm);
+        }
+      else if (++self->sleep_polls < FT9201_OPEN_MCU_POLLS)
+        {
+          fpi_ssm_jump_to_state_delayed (transfer->ssm, OPEN_OLD_MCU,
+                                         FT9201_OLD_POLL_INTERVAL);
+        }
+      else
+        {
+          fpi_ssm_mark_failed (transfer->ssm,
+                               fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                                         "Sensor MCU did not wake (%02x %02x)",
+                                                         reply[0], reply[1]));
+        }
+      break;
+
+    case OPEN_OLD_CONFIGURED:
+      /* Set on every sensor seen so far. Setting it up from scratch is not
+       * understood, so refuse rather than guess at register writes. */
+      if (reply[0] != FT9201_CONFIGURED)
+        {
+          fpi_ssm_mark_failed (transfer->ssm,
+                               fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                         "Sensor is not set up (0x%02x)",
+                                                         reply[0]));
+        }
+      else
+        {
+          fpi_ssm_next_state (transfer->ssm);
+        }
+      break;
+
+    case OPEN_OLD_SIZE:
+      if (reply[0] != FT9201_OLD_WIDTH || reply[1] != FT9201_OLD_HEIGHT)
+        {
+          fpi_ssm_mark_failed (transfer->ssm,
+                               fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                                         "Unsupported sensor size %ux%u",
+                                                         reply[0], reply[1]));
+        }
+      else
+        {
+          fpi_ssm_next_state (transfer->ssm);
+        }
+      break;
+
+    case OPEN_OLD_CHIP_ID:
+      self->chip_id = (reply[0] << 8) | reply[1];
+      fp_info ("FT9201 behind the old SIU bridge: %dx%d sensor, AFE chip 0x%04x",
+               self->width, self->height, self->chip_id);
+      fpi_ssm_next_state (transfer->ssm);
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+open_old_ssm_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case OPEN_OLD_WAKE1:
+    case OPEN_OLD_WAKE2:
+      ft9201_ctrl_out_delayed (dev, ssm, FT9201_REQ_WAKE, FT9201_WAKE_ARG,
+                               FT9201_WAKE_ARG, FT9201_WAKE_DELAY);
+      break;
+
+    case OPEN_OLD_MCU:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_MCU, open_old_reply_cb);
+      break;
+
+    case OPEN_OLD_CONFIGURED:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_CONFIGURED, open_old_reply_cb);
+      break;
+
+    case OPEN_OLD_SIZE:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_SIZE, open_old_reply_cb);
+      break;
+
+    case OPEN_OLD_CHIP_ID:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_CHIP_ID, open_old_reply_cb);
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static gboolean
+ft9201_fail_if_cancelled (FpDevice *dev, FpiSsm *ssm)
+{
+  GError *cancelled = NULL;
+
+  if (!fpi_device_action_is_cancelled (dev))
+    return FALSE;
+
+  g_cancellable_set_error_if_cancelled (fpi_device_get_cancellable (dev),
+                                        &cancelled);
+  fpi_ssm_mark_failed (ssm, cancelled);
+  return TRUE;
+}
+
+static void
+capture_old_poll_cb (FpiUsbTransfer *transfer,
+                     FpDevice       *dev,
+                     gpointer        user_data,
+                     GError         *error)
+{
+  FpiDeviceFocaltechMoh *self = FPI_DEVICE_FOCALTECH_MOH (dev);
+  FpiSsm *ssm = transfer->ssm;
+  const guint8 *reply = transfer->buffer;
+
+  if (!ft9201_afe_reply_ok (transfer, error))
+    return;
+
+  /* Waiting for a touch has no end of its own. */
+  if (ft9201_fail_if_cancelled (dev, ssm))
+    return;
+
+  if (fpi_ssm_get_cur_state (ssm) == CAPTURE_OLD_POLL_MCU)
+    {
+      guint16 mcu = (reply[0] << 8) | reply[1];
+
+      if (mcu != self->last_mcu)
+        fp_dbg ("MCU status %04x", mcu);
+      self->last_mcu = mcu;
+
+      if (ft9201_mcu_awake (reply))
+        {
+          self->sleep_polls = 0;
+          fpi_ssm_next_state (ssm);
+          return;
+        }
+
+      /* Asleep, so no frame waits. The bridge answers 00 00 or 01 01 while
+       * the MCU sleeps, and a touch wakes it from either. 01 01 is also how
+       * the sensor is found after another host had it, where it may not
+       * wake by itself, so a long run of it gets a wake request. */
+      self->frame_drained = TRUE;
+      if (reply[0] == 0x01 && reply[1] == 0x01 &&
+          ++self->sleep_polls >= FT9201_DEEP_SLEEP_POLLS)
+        {
+          fp_dbg ("Sensor stays in deep sleep, waking it");
+          self->sleep_polls = 0;
+          fpi_ssm_jump_to_state (ssm, CAPTURE_OLD_WAKE1);
+          return;
+        }
+      if (reply[0] != 0x01 || reply[1] != 0x01)
+        self->sleep_polls = 0;
+
+      fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_OLD_POLL_MCU,
+                                     FT9201_OLD_POLL_INTERVAL);
+      return;
+    }
+
+  /* CAPTURE_OLD_POLL_FRAME, with the MCU awake */
+  if (reply[0] != FT9201_FRAME_WAITING)
+    {
+      self->frame_drained = TRUE;
+      fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_OLD_POLL_MCU,
+                                     FT9201_OLD_POLL_INTERVAL);
+      return;
+    }
+
+  /* A frame captured before this request is never used: it is gone once
+   * the MCU sleeps, and only a touch after that counts. */
+  if (!self->frame_drained)
+    {
+      fpi_ssm_jump_to_state_delayed (ssm, CAPTURE_OLD_POLL_MCU,
+                                     FT9201_OLD_POLL_INTERVAL);
+      return;
+    }
+
+  fp_dbg ("Sensor captured a frame");
+  fpi_device_report_finger_status_changes (dev,
+                                           FP_FINGER_STATUS_PRESENT,
+                                           FP_FINGER_STATUS_NONE);
+  fpi_ssm_jump_to_state (ssm, CAPTURE_OLD_PREP1);
+}
+
+static void
+capture_old_read_cb (FpiUsbTransfer *transfer,
+                     FpDevice       *dev,
+                     gpointer        user_data,
+                     GError         *error)
+{
+  FpiDeviceFocaltechMoh *self = FPI_DEVICE_FOCALTECH_MOH (dev);
+
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  fp_dbg ("Frame header %02x %02x", transfer->buffer[0], transfer->buffer[1]);
+  memcpy (self->image_buf, transfer->buffer + FT9201_OLD_HEADER,
+          self->width * self->height);
+
+  /* This frame stays in the sensor until its MCU sleeps; the next capture
+   * must not take it again. */
+  self->frame_drained = FALSE;
+  fpi_ssm_next_state (transfer->ssm);
+}
+
+static void
+capture_old_woken_cb (FpiUsbTransfer *transfer,
+                      FpDevice       *dev,
+                      gpointer        user_data,
+                      GError         *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  fpi_ssm_jump_to_state_delayed (transfer->ssm, CAPTURE_OLD_POLL_MCU,
+                                 FT9201_WAKE_DELAY);
+}
+
+static void
+capture_old_ssm_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceFocaltechMoh *self = FPI_DEVICE_FOCALTECH_MOH (dev);
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case CAPTURE_OLD_POLL_MCU:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_MCU, capture_old_poll_cb);
+      break;
+
+    case CAPTURE_OLD_POLL_FRAME:
+      ft9201_afe_read (dev, ssm, FT9201_AFE_FRAME, capture_old_poll_cb);
+      break;
+
+    case CAPTURE_OLD_WAKE1:
+      ft9201_ctrl_out_delayed (dev, ssm, FT9201_REQ_WAKE, FT9201_WAKE_ARG,
+                               FT9201_WAKE_ARG, FT9201_WAKE_DELAY);
+      break;
+
+    case CAPTURE_OLD_WAKE2:
+      {
+        FpiUsbTransfer *transfer = fpi_usb_transfer_new (dev);
+
+        /* Back to polling once woken. */
+        transfer->ssm = ssm;
+        fpi_usb_transfer_fill_control (transfer,
+                                       G_USB_DEVICE_DIRECTION_HOST_TO_DEVICE,
+                                       G_USB_DEVICE_REQUEST_TYPE_VENDOR,
+                                       G_USB_DEVICE_RECIPIENT_DEVICE,
+                                       FT9201_REQ_WAKE, FT9201_WAKE_ARG,
+                                       FT9201_WAKE_ARG, 0);
+        fpi_usb_transfer_submit (transfer, FT9201_CMD_TIMEOUT,
+                                 fpi_device_get_cancellable (dev),
+                                 capture_old_woken_cb, NULL);
+      }
+      break;
+
+    case CAPTURE_OLD_PREP1:
+      ft9201_ctrl_out_delayed (dev, ssm, FT9201_REQ_PREPARE, FT9201_PREPARE_INIT,
+                               0, FT9201_PREPARE_DELAY);
+      break;
+
+    case CAPTURE_OLD_PREP2:
+      ft9201_ctrl_out (dev, ssm, FT9201_REQ_PREPARE, FT9201_PREPARE_READ, 0);
+      break;
+
+    case CAPTURE_OLD_CMD:
+      ft9201_ctrl_out (dev, ssm, FT9201_REQ_FRAME_SIZE,
+                       self->width * self->height + FT9201_OLD_HEADER,
+                       FT9201_FRAME_ADDR);
+      break;
+
+    case CAPTURE_OLD_READ:
+      {
+        FpiUsbTransfer *transfer = fpi_usb_transfer_new (dev);
+
+        fpi_usb_transfer_fill_bulk (transfer, FT9201_EP_IN,
+                                    self->width * self->height + FT9201_OLD_HEADER);
+        transfer->short_is_error = TRUE;
+        transfer->ssm = ssm;
+        fpi_usb_transfer_submit (transfer, FT9201_CMD_TIMEOUT,
+                                 fpi_device_get_cancellable (dev),
+                                 capture_old_read_cb, NULL);
+      }
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+/* The capture sub-SSM for this device's bridge. */
+static FpiSsm *
+ft9201_capture_ssm_new (FpDevice *dev)
+{
+  FpiDeviceFocaltechMoh *self = FPI_DEVICE_FOCALTECH_MOH (dev);
+
+  if (self->bridge == FT9201_BRIDGE_OLD_SIU)
+    {
+      self->frame_drained = FALSE;
+      self->sleep_polls = 0;
+      return fpi_ssm_new (dev, capture_old_ssm_handler, CAPTURE_OLD_NUM_STATES);
+    }
+
+  return fpi_ssm_new (dev, capture_ssm_handler, CAPTURE_NUM_STATES);
+}
