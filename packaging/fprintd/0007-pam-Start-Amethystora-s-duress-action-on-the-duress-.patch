diff --git a/tests/pam/test_pam_fprintd.py b/tests/pam/test_pam_fprintd.py
index 54943e4..9b36f5c 100644
--- a/tests/pam/test_pam_fprintd.py
+++ b/tests/pam/test_pam_fprintd.py
@@ -19,6 +19,7 @@ import dbus
 import dbusmock
 import glob
 import os
+import pwd
 import shutil
 import time
 import pypamtest
@@ -349,6 +350,180 @@ class TestPamFprintd(dbusmock.DBusTestCase):
         self.assertEqual(len(res.errors), 0)
         self.assertEqual(len(res.info), 0)
 
+@unittest.skipUnless(os.geteuid() == 0, 'the duress finger is only read from files of root')
+class TestPamFprintdDuress(dbusmock.DBusTestCase):
+    '''Amethystora's duress finger: the account's file names it, the reader
+    identifies, and the mock reports the first enrolled finger as the match'''
+
+    setUpClass = classmethod(TestPamFprintd.setUpClass.__func__)
+    tearDownClass = classmethod(TestPamFprintd.tearDownClass.__func__)
+    start_monitor = classmethod(TestPamFprintd.start_monitor.__func__)
+    stop_monitor = classmethod(TestPamFprintd.stop_monitor.__func__)
+
+    def setUp(self):
+        super().setUp()
+        (self.p_mock, self.obj_fprintd_manager) = self.spawn_server_template(
+            self.template_name, {})
+        self.obj_fprintd_mock = dbus.Interface(self.obj_fprintd_manager, 'net.reactivated.Fprint.Manager.Mock')
+        self.user = pwd.getpwuid(os.getuid()).pw_name
+        self.duress_dir = os.path.join(os.environ['TOPBUILDDIR'], 'tests', 'pam', 'duress.d')
+        self.p_duress = None
+
+    def tearDown(self):
+        shutil.rmtree(self.duress_dir, ignore_errors=True)
+        if self.p_duress:
+            self.p_duress.terminate()
+            self.p_duress.wait()
+        self.p_mock.terminate()
+        self.p_mock.wait()
+        super().tearDown()
+
+    def setup_device(self, identification=True):
+        device_path = self.obj_fprintd_mock.AddDevice('FDO Trigger Finger Laser Reader', 3, 'press', identification)
+        self.device_mock = self.dbus_con.get_object('net.reactivated.Fprint', device_path)
+        self.device_mock.SetEnrolledFingers(self.user, ['right-ring-finger', 'left-index-finger'])
+
+    def setup_duress_service(self):
+        self.p_duress = self.spawn_server('org.amethystora.Duress', '/org/amethystora/Duress',
+                                          'org.amethystora.Duress', system_bus=True,
+                                          stdout=subprocess.DEVNULL)
+        self.duress_mock = dbus.Interface(
+            self.dbus_con.get_object('org.amethystora.Duress', '/org/amethystora/Duress'),
+            dbusmock.MOCK_IFACE)
+        self.duress_mock.AddMethod('org.amethystora.Duress', 'Run', 'u', '', '')
+
+    def write_duress_finger(self, finger, dir_mode=0o700, file_mode=0o600, uid=None):
+        '''The account's line in the fingers file, between two other accounts' lines'''
+        uid = os.getuid() if uid is None else uid
+        os.makedirs(self.duress_dir, exist_ok=True)
+        os.chmod(self.duress_dir, dir_mode)
+        path = os.path.join(self.duress_dir, 'fingers')
+        with open(path, 'w') as f:
+            f.write('%d left-thumb\n' % (os.getuid() + 1000))
+            f.write('%d %s\n' % (uid, finger))
+            f.write('%d left-index-finger\n' % (os.getuid() + 1001))
+        os.chmod(path, file_mode)
+        return path
+
+    def duress_runs(self, wait=2):
+        '''The uid of each Run call, once at least one came or wait ran out'''
+        calls = []
+        deadline = time.time() + wait
+        while time.time() < deadline:
+            calls = self.duress_mock.GetMethodCalls('Run')
+            if calls:
+                break
+            time.sleep(0.1)
+        return [int(args[0]) for (_, args) in calls]
+
+    def authenticate(self, service, expected_rv, tries=1):
+        self.device_mock.SetVerifyScript([( 'verify-match', True, 1 )] * tries)
+        tc = pypamtest.TestCase(pypamtest.PAMTEST_AUTHENTICATE, expected_rv=expected_rv)
+        return pypamtest.run_pamtest(self.user, service, [tc], [ 'unused' ])
+
+    def test_pam_duress_allow(self):
+        self.setup_device()
+        self.setup_duress_service()
+        self.write_duress_finger('right-ring-finger')
+
+        res = self.authenticate('fprintd-pam-test-duress-allow', PAM_SUCCESS)
+        self.assertRegex(res.info[0], r'Place your finger on the fingerprint reader')
+        self.assertEqual(len(res.errors), 0)
+        self.assertEqual(self.duress_runs(), [os.getuid()])
+
+    def test_pam_duress_deny(self):
+        self.setup_device()
+        self.setup_duress_service()
+        self.write_duress_finger('right-ring-finger')
+
+        res = self.authenticate('fprintd-pam-test-duress-deny', PAM_MAXTRIES, tries=3)
+        self.assertEqual(list(res.errors), ['Failed to match fingerprint'] * 3)
+        self.assertEqual(self.duress_runs(), [os.getuid()] * 3)
+
+    def test_pam_duress_other_finger(self):
+        self.setup_device()
+        self.setup_duress_service()
+        self.write_duress_finger('left-index-finger')
+
+        for service in ['fprintd-pam-test-duress-allow', 'fprintd-pam-test-duress-deny']:
+            with self.subTest(service=service):
+                res = self.authenticate(service, PAM_SUCCESS)
+                self.assertEqual(len(res.errors), 0)
+                self.device_mock.VerifyStop()
+                self.device_mock.Release()
+        self.assertEqual(self.duress_runs(wait=0.5), [])
+
+    def test_pam_duress_option_off(self):
+        self.setup_device()
+        self.setup_duress_service()
+        self.write_duress_finger('right-ring-finger')
+
+        res = self.authenticate('fprintd-pam-test-duress-off', PAM_SUCCESS)
+        self.assertEqual(len(res.errors), 0)
+        self.assertEqual(self.duress_runs(wait=0.5), [])
+
+    def test_pam_duress_no_identification(self):
+        # The reader verifies the first enrolled finger only, which is the duress finger
+        self.setup_device(identification=False)
+        self.setup_duress_service()
+        self.write_duress_finger('right-ring-finger')
+
+        res = self.authenticate('fprintd-pam-test-duress-deny', PAM_SUCCESS)
+        self.assertRegex(res.info[0], r'Place your right ring finger on the fingerprint reader')
+        self.assertEqual(len(res.errors), 0)
+        self.assertEqual(self.duress_runs(wait=0.5), [])
+
+    def test_pam_duress_untrusted_file(self):
+        self.setup_device()
+        self.setup_duress_service()
+
+        def symlink():
+            path = self.write_duress_finger('right-ring-finger')
+            os.rename(path, path + '.real')
+            os.symlink(path + '.real', path)
+
+        def other_owner():
+            os.chown(self.write_duress_finger('right-ring-finger'), 65534, 65534)
+
+        def folder_other_owner():
+            self.write_duress_finger('right-ring-finger')
+            os.chown(self.duress_dir, 65534, 65534)
+
+        cases = {
+            'folder readable': lambda: self.write_duress_finger('right-ring-finger', dir_mode=0o755),
+            'file readable': lambda: self.write_duress_finger('right-ring-finger', file_mode=0o644),
