 pam/pam_fprintd.c                             | 209 ++++++++++++++++++
 tests/pam/services/fprintd-pam-test-duress.in |   1 +
 tests/pam/services/meson.build                |  30 ++-
 tests/pam/test_pam_fprintd.py                 | 175 +++++++++++++++
 5 files changed, 429 insertions(+), 7 deletions(-)
